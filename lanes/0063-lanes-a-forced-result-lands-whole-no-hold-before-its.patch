+/// The next forced token off the queue, a forced row of the next commit (no hold before its last), or null.
+pub fn popForce(s: *Stream) ?u32 {
+    if (s.force.items.len == 0) return null;
+    s.forced_out += 1;
+    return s.force.orderedRemove(0);
+}
