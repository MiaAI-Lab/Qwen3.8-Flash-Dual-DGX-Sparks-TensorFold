+}
+
+test "an into chain no unit reads folds its links in order at its end as each link changes" {
+    var c = try tinyCircuit(.chained);
+    defer c.deinit(gpa);
+    const end = c.flow.final[tiny.dims.sum];
+    try std.testing.expectEqual(@as(u32, 3), c.flow.chain_len[end]);
+    var s = try rc.State.init(gpa, &c);
+    defer s.deinit();
+    const seq = [_]u32{ tok(1, 0), tok(2, 0), tok(3, 0), tok(4, 'h'), tok(1, 0), tok(1, 0) };
+    const want = [_]model.Scalar{ 1, 2, 4, 0, 1, 1 };
+    for (seq, want) |t, w| {
+        _ = try eval.step(&s, t);
+        try std.testing.expectEqual(w, s.value(tiny.dims.sum));
+    }
+}
+
+test "an FFN part that is not zero at rest runs on a fresh machine's first step and keeps its value after a forced step" {
+    var c = try tinyCircuit(.resting);
+    defer c.deinit(gpa);
+    var quiet: usize = 0;
+    for (c.flow.units) |u| quiet += @intFromBool(u.quiet);
+    try std.testing.expectEqual(c.flow.ffn_plans.len - 1, quiet);
+    var s = try rc.State.init(gpa, &c);
+    defer s.deinit();
+    for ([_]u32{ c.go, tok(1, 0), tok(2, 1 | 4), tok(1, 0) }, 0..) |t, i| {
+        if (i == 2) try rc.writeWord(&s, 0, 5);
+        _ = try eval.step(&s, t);
+        try std.testing.expectEqual(@as(model.Scalar, 6), s.value(tiny.dims.sum));
+    }
+}
+
+test "banks sharing an address share one selection key per step but keep their own rows, as running every unit does" {
+    var c = try tinyCircuit(.banks);
+    defer c.deinit(gpa);
+    try std.testing.expectEqual(@as(u32, 1), c.flow.groups);
+    var lazy = try rc.State.init(gpa, &c);
+    defer lazy.deinit();
+    var full = try rc.State.init(gpa, &c);
+    defer full.deinit();
+    full.always = true;
+    const rows = [_]u32{ 1, 2, 1, 3, 0, 2, 1, 1, 2, 0, 3, 1, 2, 2, 1 };
+    for (0..3) |_| for (rows, 0..) |r, i| {
+        const t = if (i % 3 == 0) tok(2, r | 4) else tok(3, r);
+        try std.testing.expectEqual(try eval.step(&full, t), try eval.step(&lazy, t));
+        const want = try full.canonical(gpa);
+        defer gpa.free(want);
+        const got = try lazy.canonical(gpa);
+        defer gpa.free(got);
+        try std.testing.expectEqualSlices(u8, want, got);
+    };
+    try std.testing.expect(lazy.groups[0].memo.hits > 0);
+}
+
+test "a bank skipped on a step its group selects nothing still sees that step's inputs one step later" {
+    var c = try tinyCircuit(.banks);
+    defer c.deinit(gpa);
+    var lazy = try rc.State.init(gpa, &c);
+    defer lazy.deinit();
+    var full = try rc.State.init(gpa, &c);
+    defer full.deinit();
+    full.always = true;
+    // An A token selects no row in either bank: from the second cycle the mirror skips it, then a write reads it back.
+    for (0..3) |_| for ([_]u32{ tok(2, 1 | 4), tok(1, 0), tok(2, 2), tok(3, 2), tok(3, 1), tok(1, 0), tok(2, 3), tok(3, 3) }) |t| {
+        try std.testing.expectEqual(try eval.step(&full, t), try eval.step(&lazy, t));
+        const want = try full.canonical(gpa);
+        defer gpa.free(want);
+        const got = try lazy.canonical(gpa);
+        defer gpa.free(got);
+        try std.testing.expectEqualSlices(u8, want, got);
+    };
+}
+
+test "a node that reads a dim written earlier in stored order sees the write" {
+    var c = try tinyCircuit(.good);
+    defer c.deinit(gpa);
+    try std.testing.expectEqual(@as(usize, 3), c.batches.len);
+    var s = try rc.State.init(gpa, &c);
+    defer s.deinit();
+    _ = try eval.step(&s, tok(1, 0));
+    try std.testing.expectEqual(@as(model.Scalar, 1), s.value(tiny.dims.t1));
+    try std.testing.expectEqual(@as(model.Scalar, 1), s.value(tiny.dims.t2));
+}
+
+test "a machine boots the calc input as RAM data and runs to HALT under a step budget and a cancel flag" {
+    var c = try tinyCircuit(.good);
+    defer c.deinit(gpa);
+    var m = try rc.Machine.boot(gpa, &c, .{ .kind = .calc, .bytes = "A" });
+    defer m.deinit(gpa);
+    try std.testing.expectEqual(@as(u32, 'A'), try rc.readWord(&m.state, 64));
+    var out: std.ArrayList(u8) = .empty;
+    defer out.deinit(gpa);
+    var trace: std.ArrayList(u32) = .empty;
+    defer trace.deinit(gpa);
+    var cancel: std.atomic.Value(bool) = .init(false);
+    const first = try m.run(2, &out, &trace, &cancel);
+    try std.testing.expectEqual(api.RunEnd{ .end = .budget, .steps = 2 }, first);
+    const rest = try m.run(100, &out, &trace, &cancel);
+    try std.testing.expectEqual(api.RunEnd{ .end = .halted, .steps = 1 }, rest);
+    try std.testing.expectEqualStrings("hi", out.items);
+    try std.testing.expectEqualSlices(u32, &.{ tok(4, 'h'), tok(4, 'i'), c.halt }, trace.items);
+    try std.testing.expectEqual(api.RunEnd{ .end = .halted, .steps = 0 }, try m.run(100, &out, null, &cancel));
+    var n = try rc.Machine.boot(gpa, &c, .{ .kind = .calc, .bytes = "" });
+    defer n.deinit(gpa);
+    cancel.store(true, .release);
+    try std.testing.expectEqual(api.RunEnd{ .end = .cancelled, .steps = 0 }, try n.run(100, &out, null, &cancel));
+    try std.testing.expectError(error.CircuitInputTooLong, rc.Machine.boot(gpa, &c, .{ .kind = .calc, .bytes = &long_input }));
+    try std.testing.expectError(error.CircuitInputNul, rc.Machine.boot(gpa, &c, .{ .kind = .calc, .bytes = "1\x002" }));
+}
+
+test "the RAM patch round-trips words and an R read sees the booted input" {
+    var c = try tinyCircuit(.good);
+    defer c.deinit(gpa);
+    var m = try rc.Machine.boot(gpa, &c, .{ .kind = .calc, .bytes = "AB" });
+    defer m.deinit(gpa);
+    try std.testing.expectEqual(@as(u32, 'A' | 'B' << 8), try rc.readWord(&m.state, 64));
+    try std.testing.expectEqual(tok(4, '1'), try eval.step(&m.state, tok(3, 2)));
+    var e = try rc.Machine.boot(gpa, &c, .{ .kind = .calc, .bytes = "" });
+    defer e.deinit(gpa);
+    try std.testing.expect(!e.state.rowPresent(c.program.ram_tables[0], 2));
+    try std.testing.expectEqual(tok(4, '0'), try eval.step(&e.state, tok(3, 2)));
+}
+
+test "snapshots are canonical: equal histories give equal bytes, a write or a lag changes them" {
+    var c = try tinyCircuit(.good);
+    defer c.deinit(gpa);
+    var a = try rc.Machine.boot(gpa, &c, .{ .kind = .calc, .bytes = "" });
+    defer a.deinit(gpa);
+    var b = try rc.Machine.boot(gpa, &c, .{ .kind = .calc, .bytes = "" });
+    defer b.deinit(gpa);
+    for ([_]u32{ tok(1, 0), tok(2, 5) }) |t| {
+        _ = try eval.step(&a.state, t);
+        _ = try eval.step(&b.state, t);
+    }
+    const sa = try a.snapshot(gpa);
+    defer gpa.free(sa);
+    const sb = try b.snapshot(gpa);
+    defer gpa.free(sb);
+    try std.testing.expectEqualSlices(u8, sa, sb);
+    _ = try eval.step(&b.state, tok(1, 0));
+    _ = try eval.step(&a.state, tok(4, 'h'));
+    const sa2 = try a.snapshot(gpa);
+    defer gpa.free(sa2);
+    const sb2 = try b.snapshot(gpa);
+    defer gpa.free(sb2);
+    try std.testing.expect(!std.mem.eql(u8, sa2, sb2));
+}
+
+const Seg = struct { typ: u32 = 1, vaddr: u32, data: []const u8, memsz: u32 };
+
+/// A static ELF32 RISC-V executable with the given program headers, data after the header table.
+fn elfImage(entry: u32, segs: []const Seg) ![]u8 {
+    var size: usize = 52 + 32 * segs.len;
+    for (segs) |sg| size += sg.data.len;
+    const b = try gpa.alloc(u8, size);
+    @memset(b, 0);
+    @memcpy(b[0..7], "\x7fELF\x01\x01\x01");
+    const w = std.mem.writeInt;
+    w(u16, b[16..18], 2, .little);
+    w(u16, b[18..20], 243, .little);
+    w(u32, b[24..28], entry, .little);
+    w(u32, b[28..32], 52, .little);
+    w(u16, b[42..44], 32, .little);
+    w(u16, b[44..46], @intCast(segs.len), .little);
+    var off: u32 = @intCast(52 + 32 * segs.len);
+    for (segs, 0..) |sg, i| {
+        const p = b[52 + 32 * i ..][0..32];
+        w(u32, p[0..4], sg.typ, .little);
+        w(u32, p[4..8], off, .little);
+        w(u32, p[8..12], sg.vaddr, .little);
+        w(u32, p[16..20], @intCast(sg.data.len), .little);
+        w(u32, p[20..24], sg.memsz, .little);
+        @memcpy(b[off..][0..sg.data.len], sg.data);
+        off += @intCast(sg.data.len);
+    }
+    return b;
+}
+
+test "an ELF's PT_LOAD segments land in ROM words, DROM and zero-filled RAM; bad images are refused" {
+    const code = [_]u8{ 0x13, 0x05, 0x50, 0x00, 0x73, 0x00, 0x00, 0x00 };
+    const good = try elfImage(0x40004, &.{ .{ .vaddr = 0x40000, .data = &code, .memsz = 8 }, .{ .vaddr = 0x100, .data = "hi", .memsz = 8 }, .{ .vaddr = 0x20000, .data = "ro", .memsz = 2 } });
+    defer gpa.free(good);
+    const img = try elf.parse(gpa, good);
+    defer img.deinit(gpa);
+    try std.testing.expectEqual(@as(u32, 0x00500513), img.rom[0]);
+    try std.testing.expectEqual(@as(u32, 0x73), img.rom[1]);
+    try std.testing.expectEqual(@as(u32, 0), img.rom[2]);
+    try std.testing.expectEqualStrings("hi\x00\x00", img.ram[0x100..0x104]);
+    try std.testing.expectEqualStrings("ro", img.drom[0..2]);
+    try std.testing.expectEqual(@as(u32, 0x40004), img.entry);
+    const Bad = struct { entry: u32, seg: Seg, want: anyerror };
+    for ([_]Bad{
+        .{ .entry = 0x40000, .seg = .{ .typ = 3, .vaddr = 0x40000, .data = &code, .memsz = 8 }, .want = error.ElfDynamic },
+        .{ .entry = 0x40000, .seg = .{ .vaddr = 0x7fff, .data = "ab", .memsz = 2 }, .want = error.ElfSegment },
+        .{ .entry = 0x40002, .seg = .{ .vaddr = 0x40000, .data = &code, .memsz = 8 }, .want = error.ElfEntry },
+        .{ .entry = 0x40000, .seg = .{ .vaddr = 0x40000, .data = &code, .memsz = 4 }, .want = error.ElfSegment },
+    }) |bad| {
+        const bytes = try elfImage(bad.entry, &.{bad.seg});
+        defer gpa.free(bytes);
+        try std.testing.expectError(bad.want, elf.parse(gpa, bytes));
+    }
+}
diff --git a/zig/src/core/runner_circuit_tiny_test.zig b/zig/src/core/runner_circuit_tiny_test.zig
new file mode 100644
index 000000000..36329ec6c
--- /dev/null
+++ b/zig/src/core/runner_circuit_tiny_test.zig
@@ -0,0 +1,211 @@
+//! A hand-built circuit file (store/load RAM, a lagged key, a clear decay, a hazard pair, variants) for host tests.
+const std = @import("std");
+
+const kappa = "0.00000095367431640625";
+pub const a_ref = "16777216.0";
+/// Families: 0 GO, 1 A, 2 W (row bits 0-1, data bit 2), 3 R (row bits 0-1), 4 BYTE, 5 HALT.
+pub const sizes = [_]u32{ 1, 1, 8, 4, 512, 1 };
+pub const dims = struct {
+    pub const is_w = 3;
+    pub const is_r = 4;
+    pub const rd = 13;
+    pub const code = 14;
+    pub const t1 = 33;
+    pub const t2 = 34;
+    pub const lagout = 35;
+    pub const lag3out = 36;
+    pub const sum = 37;
+    pub const count = 38;
+};
+pub const family_bits = 3;
+
+pub fn token(family: u32, payload: u32) u32 {
+    var base: u32 = 0;
+    for (sizes[0..family]) |s| base += s;
+    return base + payload;
+}
+
+/// Variants that break one rule, for negative controls.
+pub const Variant = enum { good, two_hot_key, unmapped_go, beta_gated, halving, chained, resting, banks };
+
+/// The container bytes of the tiny circuit.
+pub fn build(a: std.mem.Allocator, variant: Variant) ![]u8 {
+    var j: std.ArrayList(u8) = .empty;
+    defer j.deinit(a);
+    const w = Writer{ .a = a, .j = &j };
+    try w.s("{\"constants\":{\"a_bit\":128.0,\"a_ref\":" ++ a_ref ++ ",\"head_dim\":128,\"one_dim\":0,\"ref_cols\":[0,1]},\"dims\":[");
+    for (0..dims.count) |i| try w.f("{s}{{\"name\":\"d{d}\"}}", .{ if (i == 0) "" else ",", i });
+    try w.s("],\"features\":[");
+    for (0..6) |f| try w.f("{s}{{\"dim\":{d},\"kind\":\"family\",\"family\":{d}}}", .{ if (f == 0) "" else ",", f + 1, f });
+    const bits = [_][3]u32{ .{ 7, 2, 0 }, .{ 8, 2, 1 }, .{ 9, 2, 2 }, .{ 10, 3, 0 }, .{ 11, 3, 1 }, .{ 12, 4, 0 } };
+    for (bits) |b| try w.f(",{{\"dim\":{d},\"kind\":\"payload_bit\",\"family\":{d},\"bit\":{d}}}", .{ b[0], b[1], b[2] });
+    try w.s("],\"format\":\"tensorfold.runner.p2\",\"nodes\":[");
+    try lagHead(w);
+    try w.s(",");
+    try lag3Head(w);
+    try w.s(",");
+    try ramHead(w, variant);
+    if (variant == .banks) try bankHead(w);
+    try w.s(",{\"kind\":\"ffn\",\"name\":\"h1\",\"out\":33,\"into\":false,\"terms\":[[1.0,[[0,1.0]],[[2,1.0]]]]}");
+    try w.s(",{\"kind\":\"ffn\",\"name\":\"h2\",\"out\":34,\"into\":false,\"terms\":[[1.0,[[33,1.0]],[[0,1.0]]]]}");
+    if (variant == .chained) for ([_][2]u32{ .{ 1, 2 }, .{ 2, 3 }, .{ 4, 4 } }, 0..) |t, i| {
+        try w.f(",{{\"kind\":\"ffn\",\"name\":\"c{d}\",\"out\":{d},\"into\":{s},", .{ i, dims.sum, if (i == 0) "false" else "true" });
+        try w.f("\"terms\":[[{d}.0,[[0,1.0]],[[{d},1.0]]]]}}", .{ t[0], t[1] });
+    };
+    if (variant == .resting) try w.f(",{{\"kind\":\"ffn\",\"name\":\"r\",\"out\":{d},\"into\":false,\"terms\":[[3.0,[[0,1.0]],[[0,2.0]]]]}}", .{dims.sum});
+    try codeNodes(w, variant);
+    try w.s("],\"output\":{\"code_dims\":[");
+    for (0..family_bits + 16) |i| try w.f("{s}{d}", .{ if (i == 0) "" else ",", dims.code + i });
+    try w.f("],\"family_bits\":{d},\"families\":", .{family_bits});
+    try families(w);
+    try w.s(",\"payload_bits\":16},\"program\":{\"input_address\":256,\"input_capacity\":256,\"kind\":\"calc\",\"entry\":262144,");
+    try w.s("\"rom_le_hex\":\"");
+    for (0..1 << 16) |_| try w.s("00000000");
+    try w.s("\",\"drom_hex\":\"\",\"ram_hex\":\"");
+    for (0..1 << 13) |_| try w.s("00000000");
+    try w.s("\"},");
+    try w.f("\"stats\":{{\"dims\":{d}}},\"tokens\":{{\"byte_family\":4,\"families\":", .{dims.count});
+    try families(w);
+    try w.f(",\"go\":0,\"halt\":{d},\"vocab\":{d}}},\"version\":1}}", .{ token(5, 0), token(5, 0) + 1 });
+    return container(a, j.items);
+}
+
+pub fn container(a: std.mem.Allocator, body: []const u8) ![]u8 {
+    const out = try a.alloc(u8, 64 + body.len);
+    @memcpy(out[0..8], "TFIMR001");
+    std.mem.writeInt(u32, out[8..12], 1, .little);
+    std.mem.writeInt(u32, out[12..16], 64, .little);
+    std.mem.writeInt(u64, out[16..24], body.len, .little);
+    @memset(out[24..32], 0);
+    std.crypto.hash.sha2.Sha256.hash(body, out[32..64], .{});
+    @memcpy(out[64..], body);
+    return out;
+}
+
+const Writer = struct {
+    a: std.mem.Allocator,
+    j: *std.ArrayList(u8),
+    fn s(w: Writer, text: []const u8) !void {
+        try w.j.appendSlice(w.a, text);
+    }
+    fn f(w: Writer, comptime fmt: []const u8, args: anytype) !void {
+        const text = try std.fmt.allocPrint(w.a, fmt, args);
+        defer w.a.free(text);
+        try w.j.appendSlice(w.a, text);
+    }
+};
+
+fn families(w: Writer) !void {
+    const names = [_][]const u8{ "GO", "A", "W", "R", "BYTE", "HALT" };
+    try w.s("[");
+    for (names, sizes, 0..) |n, size, i| try w.f("{s}{{\"name\":\"{s}\",\"base\":{d},\"size\":{d}}}", .{ if (i == 0) "" else ",", n, token(@intCast(i), 0), size });
+    try w.s("]");
+}
+
+/// One-hot row select: relu(flag + sum of literals - bits) over the payload bits of a family.
+fn selectChannel(w: Writer, row: u32, flag: u32, bit_dims: [2]u32) !void {
+    return selectAt(w, row, row, flag, bit_dims);
+}
+
+/// Channel `at` fires when the payload bits spell `row`.
+fn selectAt(w: Writer, at: u32, row: u32, flag: u32, bit_dims: [2]u32) !void {
+    var flag_coef: i32 = 1;
+    for (0..2) |b| flag_coef += @intFromBool(row >> @intCast(b) & 1 == 0);
+    try w.f("[{d},{{\"expr\":[[{d},{d}.0]", .{ at, flag, flag_coef });
+    for (bit_dims, 0..) |d, b| try w.f(",[{d},{s}1.0]", .{ d, if (row >> @intCast(b) & 1 == 1) "" else "-" });
+    try w.s(",[0,-2.0]],\"taps\":[1.0,0.0,0.0,0.0]}]");
+}
+
+/// A key from the previous token being W (a lag-1 tap), a read on A, a clear on BYTE; output to lagout.
+fn lagHead(w: Writer) !void {
+    try w.s("{\"kind\":\"head\",\"name\":\"lag\",\"n_cols\":128,\"levels\":\"bit\",\"tiny\":0.0,");
+    try w.s("\"q\":[[0,{\"expr\":[[2,1.0]],\"taps\":[1.0,0.0,0.0,0.0]}]],\"k\":[[0,{\"expr\":[[3,1.0]],\"taps\":[0.0,1.0,0.0,0.0]}]],");
+    try w.s("\"value_heads\":[{\"v\":[[0,{\"expr\":[[0," ++ a_ref ++ "]],\"taps\":[1.0,0.0,0.0,0.0]}],[1,{\"expr\":[[0," ++ a_ref ++ "]],\"taps\":[1.0,0.0,0.0,0.0]}],");
+    try w.s("[2,{\"expr\":[[0,128.0]],\"taps\":[1.0,0.0,0.0,0.0]}]],\"a\":[[5,238.0]],\"beta\":null,\"z\":[[2,[[0,1.0]]]],");
+    try w.s("\"out\":[[2,35,16384.0]],\"into\":false,\"init\":[]}]}");
+}
+
+/// A key from the token three back being W (taps 0,0,0,1), read on A, output to lag3out.
+fn lag3Head(w: Writer) !void {
+    try w.s("{\"kind\":\"head\",\"name\":\"lag3\",\"n_cols\":128,\"levels\":\"bit\",\"tiny\":0.0,");
+    try w.s("\"q\":[[0,{\"expr\":[[2,1.0]],\"taps\":[1.0,0.0,0.0,0.0]}]],\"k\":[[0,{\"expr\":[[3,1.0]],\"taps\":[0.0,0.0,0.0,1.0]}]],");
+    try w.s("\"value_heads\":[{\"v\":[[0,{\"expr\":[[0," ++ a_ref ++ "]],\"taps\":[1.0,0.0,0.0,0.0]}],[1,{\"expr\":[[0," ++ a_ref ++ "]],\"taps\":[1.0,0.0,0.0,0.0]}],");
+    try w.s("[2,{\"expr\":[[0,128.0]],\"taps\":[1.0,0.0,0.0,0.0]}]],\"a\":[],\"beta\":null,\"z\":[[2,[[0,1.0]]]],");
+    try w.s("\"out\":[[2,36,16384.0]],\"into\":false,\"init\":[]}]}");
+}
+
+/// ram0: W writes row (payload bits 0-1), data bit 2 to column 2; R reads to rd; row 3 is 1. halving: A halves table 2.
+fn ramHead(w: Writer, variant: Variant) !void {
+    try w.s("{\"kind\":\"head\",\"name\":\"ram0\",\"n_cols\":128,\"levels\":\"bit\",\"tiny\":0.0,\"q\":[");
+    for (0..4) |r| {
+        if (r > 0) try w.s(",");
+        try selectChannel(w, @intCast(r), dims.is_r, .{ 10, 11 });
+    }
+    try w.s("],\"k\":[");
+    for (0..4) |r| {
+        if (r > 0) try w.s(",");
+        try selectChannel(w, @intCast(r), dims.is_w, .{ 7, 8 });
+    }
+    if (variant == .two_hot_key) try w.s(",[9,{\"expr\":[[3,1.0]],\"taps\":[1.0,0.0,0.0,0.0]}]");
+    const v = "\"v\":[[0,{\"expr\":[[3," ++ a_ref ++ "]],\"taps\":[1.0,0.0,0.0,0.0]}],[1,{\"expr\":[[3," ++ a_ref ++
+        "]],\"taps\":[1.0,0.0,0.0,0.0]}],[2,{\"expr\":[[9,128.0]],\"taps\":[1.0,0.0,0.0,0.0]}]],";
+    const beta = if (variant == .beta_gated) "\"beta\":[[0,1.0],[9,-1.0]]," else "\"beta\":null,";
+    try w.s("],\"value_heads\":[{" ++ v ++ "\"a\":[],");
+    try w.s(beta);
+    try w.s("\"z\":[[2,[[4,1.0]]]],\"out\":[[2,13,16384.0]],\"into\":false,");
+    try w.s("\"init\":[[3,[[0," ++ a_ref ++ "],[1," ++ a_ref ++ "],[2,128.0]]]]},{" ++ v);
+    try w.s(if (variant == .halving) "\"a\":[[2,110.0]]," else "\"a\":[],");
+    try w.s(beta);
+    try w.s("\"z\":[],\"out\":[],\"into\":false,\"init\":[]}]}");
+}
+
+/// mirror for .banks: ram0's inputs, row r at table row r ^ 1, read to dims.sum; its data bit is the previous step's.
+fn bankHead(w: Writer) !void {
+    try w.s(",{\"kind\":\"head\",\"name\":\"mirror\",\"n_cols\":128,\"levels\":\"bit\",\"tiny\":0.0,\"q\":[");
+    for (0..4) |r| {
+        if (r > 0) try w.s(",");
+        try selectAt(w, @intCast(r ^ 1), @intCast(r), dims.is_r, .{ 10, 11 });
+    }
+    try w.s("],\"k\":[");
+    for (0..4) |r| {
+        if (r > 0) try w.s(",");
+        try selectAt(w, @intCast(r ^ 1), @intCast(r), dims.is_w, .{ 7, 8 });
+    }
+    try w.s("],\"value_heads\":[{\"v\":[[0,{\"expr\":[[3," ++ a_ref ++ "]],\"taps\":[1.0,0.0,0.0,0.0]}],[1,{\"expr\":[[3," ++ a_ref);
+    try w.s("]],\"taps\":[1.0,0.0,0.0,0.0]}],[2,{\"expr\":[[9,128.0]],\"taps\":[0.0,1.0,0.0,0.0]}]],\"a\":[],\"beta\":null,");
+    try w.f("\"z\":[[2,[[4,1.0]]]],\"out\":[[2,{d},16384.0]],\"into\":false,\"init\":[]}}]}}", .{dims.sum});
+}
+
+/// One FFN per code dim: GO->BYTE('h'), BYTE even->+1, BYTE odd->HALT, A->A, W->A, R->BYTE('0'+rd), HALT->HALT.
+fn codeNodes(w: Writer, variant: Variant) !void {
+    const Rule = struct { up: []const u8, target: u32 };
+    const rules = [_]Rule{
+        .{ .up = "[[1,1.0]]", .target = token(4, 'h') },
+        .{ .up = "[[2,1.0]]", .target = token(1, 0) },
+        .{ .up = "[[3,1.0]]", .target = token(1, 0) },
+        .{ .up = "[[4,1.0]]", .target = token(4, '0') },
+        .{ .up = "[[5,1.0],[12,-1.0]]", .target = token(4, 'i') },
+        .{ .up = "[[12,1.0]]", .target = token(5, 0) },
+        .{ .up = "[[6,1.0]]", .target = token(5, 0) },
+    };
+    for (0..family_bits + 16) |i| {
+        try w.f(",{{\"kind\":\"ffn\",\"name\":\"code{d}\",\"out\":{d},\"into\":false,\"terms\":[", .{ i, dims.code + i });
+        for (rules, 0..) |r, n| {
+            if (variant == .unmapped_go and n == 0) continue;
+            const code = codeOf(r.target);
+            const sign: []const u8 = if (code >> @intCast(i) & 1 == 1) "" else "-";
+            try w.f("{s}[{s}" ++ kappa ++ ",{s},[[0,1.0]]]", .{ if (n == @intFromBool(variant == .unmapped_go)) "" else ",", sign, r.up });
+        }
+        if (i == family_bits) try w.s(",[0.0000019073486328125,[[13,1.0]],[[4,1.0]]]");
+        try w.s("]}");
+    }
+}
+
+fn codeOf(t: u32) u64 {
+    var base: u32 = 0;
+    for (sizes, 0..) |s, f| {
+        if (t < base + s) return @as(u64, f) | @as(u64, t - base) << family_bits;
+        base += s;
+    }
+    unreachable;
+}
diff --git a/zig/src/core/runner_place.zig b/zig/src/core/runner_place.zig
new file mode 100644
index 000000000..106d25274
--- /dev/null
+++ b/zig/src/core/runner_place.zig
@@ -0,0 +1,214 @@
+//! Where the runner's CPU threads run (not the engine thread's inherited pin): a CPU set and niceness off the engine's.
+const std = @import("std");
+const builtin = @import("builtin");
+const sandbox = @import("compute_sandbox.zig");
+const linux = std.os.linux;
+const log = std.log.scoped(.runner);
+
+/// A CPU mask (1024 CPUs), the layout sched_setaffinity and compute_sandbox.cpuList use.
+pub const Set = [16]u64;
+
+pub const Config = struct {
+    /// <prefix>_CPUS: auto (unset), inherit (the spawning thread's mask, as before), or a list like 0-4,10-14
+    cpus: union(enum) { auto, inherit, list: Set } = .auto,
+    /// <prefix>_NICE: the least niceness a runner thread runs at (never below the engine's own)
+    nice: u8 = 10,
+    /// The CPUs the engine's own threads are pinned to (plan link, RoCE proxy); auto keeps off them. Engine-set.
+    engine: ?*const fn (set: *Set) void = null,
+
+    pub fn parse(get: *const fn ([]const u8) ?[]const u8, comptime prefix: []const u8) error{BadKnob}!Config {
+        var c: Config = .{};
+        const cpus = std.mem.trim(u8, get(prefix ++ "_CPUS") orelse "", " ");
+        if (std.mem.eql(u8, cpus, "inherit")) c.cpus = .inherit else if (cpus.len > 0 and !std.mem.eql(u8, cpus, "auto")) {
+            var set: Set = undefined;
+            if (!sandbox.cpuList(cpus, &set)) return bad(prefix ++ "_CPUS", cpus);
+            c.cpus = .{ .list = set };
+        }
+        const nice = std.mem.trim(u8, get(prefix ++ "_NICE") orelse "", " ");
+        if (nice.len > 0) {
+            c.nice = std.fmt.parseInt(u8, nice, 10) catch return bad(prefix ++ "_NICE", nice);
+            if (c.nice > 19) return bad(prefix ++ "_NICE", nice);
+        }
+        return c;
+    }
+
+    fn bad(name: []const u8, value: []const u8) error{BadKnob} {
+        log.warn("{s}={s} is not a valid value (auto, inherit or a CPU list like 0-4,10-14; nice 0-19)", .{ name, value });
+        return error.BadKnob;
+    }
+};
+
+/// Runner threads call `enter` first; auto resolves at the first one, after the plan link pinned (its first plan).
+pub const Placer = struct {
+    cfg: Config,
+    state: std.atomic.Value(u8) = .init(0), // 0 unresolved, 1 resolving, 2 resolved
+    set: Set = @splat(0), // resolved; empty leaves the inherited mask
+    entered: std.atomic.Value(u32) = .init(0),
+    /// Tests observe the placed thread here.
+    on_enter: ?*const fn (p: *Placer) void = null,
+
+    /// Moves the calling runner thread onto the runner's CPUs at the runner's niceness and names it tf-runner.
+    pub fn enter(p: *Placer) void {
+        if (comptime builtin.os.tag != .linux) return;
+        const set = p.resolved();
+        if (!empty(&set)) _ = linux.syscall3(.sched_setaffinity, 0, @sizeOf(Set), @intFromPtr(&set));
+        // the kernel's getpriority is 20 - nice; raising nice needs no privilege, lowering it does (kept as is)
+        const inherited = 20 - @as(isize, @bitCast(linux.syscall2(.getpriority, 0, 0)));
+        if (inherited < p.cfg.nice) _ = linux.syscall3(.setpriority, 0, 0, p.cfg.nice);
+        _ = linux.prctl(@backingInt(linux.PR.SET_NAME), @intFromPtr("tf-runner"), 0, 0, 0);
+        _ = p.entered.fetchAdd(1, .monotonic);
+        if (p.on_enter) |f| f(p);
+    }
+
+    fn resolved(p: *Placer) Set {
+        while (true) {
+            switch (p.state.cmpxchgStrong(0, 1, .acquire, .acquire) orelse 0) {
+                0 => break,
+                2 => return p.set,
+                else => std.Thread.yield() catch {},
+            }
+        }
+        p.set = p.resolve();
+        p.state.store(2, .release);
+        return p.set;
+    }
+
+    fn resolve(p: *Placer) Set {
+        var text: [256]u8 = undefined;
+        switch (p.cfg.cpus) {
+            .inherit => {
+                log.info("in-model runner threads: inherited CPUs (_CPUS=inherit), nice {d}", .{p.cfg.nice});
+                return @splat(0);
+            },
+            .list => |set| {
+                log.info("in-model runner threads: CPUs {s}, nice {d}", .{ format(&set, &text), p.cfg.nice });
+                return set;
+            },
+            .auto => {
+                var avoid: Set = @splat(0);
+                if (p.cfg.engine) |f| f(&avoid);
+                const allowed = allowedCpus();
+                const set = choose(&allowed, &avoid, capacity);
+                var a: [256]u8 = undefined;
+                var e: [256]u8 = undefined;
+                if (empty(&set)) {
+                    log.warn("in-model runner threads: no CPU left beside the engine's ({s} minus {s}); they inherit the engine thread's", .{ format(&allowed, &a), format(&avoid, &e) });
+                } else log.info("in-model runner threads: CPUs {s} (auto: {s} minus the engine's {s}), nice {d}", .{ format(&set, &text), format(&allowed, &a), format(&avoid, &e), p.cfg.nice });
+                return set;
+            },
+        }
+    }
+};
+
+/// Auto: `allowed` minus `avoid`; with two core sizes (smallest under 80% of largest), only the small cluster.
+pub fn choose(allowed: *const Set, avoid: *const Set, cap: *const fn (cpu: u32) ?u32) Set {
+    var out: Set = @splat(0);
+    for (&out, allowed, avoid) |*o, a, v| o.* = a & ~v;
+    var low: u32 = std.math.maxInt(u32);
+    var high: u32 = 0;
+    var it = cpusOf(&out);
+    while (it.next()) |cpu| if (cap(cpu)) |c| {
+        low = @min(low, c);
+        high = @max(high, c);
+    };
+    // one core type at slightly different clocks (GB10's big cores: 997 and 1017) is one cluster
+    if (high == 0 or @as(u64, low) * 5 >= @as(u64, high) * 4) return out;
+    const mid = low + (high - low) / 2;
+    it = cpusOf(&out);
+    while (it.next()) |cpu| {
+        const c = cap(cpu) orelse std.math.maxInt(u32);
+        if (c >= mid) out[cpu / 64] &= ~(@as(u64, 1) << @intCast(cpu % 64));
+    }
+    return out;
+}
+
+pub fn empty(set: *const Set) bool {
+    for (set) |w| if (w != 0) return false;
+    return true;
+}
+
+pub fn has(set: *const Set, cpu: u32) bool {
+    return cpu < 1024 and set[cpu / 64] >> @intCast(cpu % 64) & 1 == 1;
+}
+
+pub fn add(set: *Set, cpu: u32) void {
+    if (cpu < 1024) set[cpu / 64] |= @as(u64, 1) << @intCast(cpu % 64);
+}
+
+const Cpus = struct {
+    set: *const Set,
+    at: u32 = 0,
+
+    fn next(it: *Cpus) ?u32 {
+        while (it.at < 1024) {
+            const cpu = it.at;
+            it.at += 1;
+            if (has(it.set, cpu)) return cpu;
+        }
+        return null;
+    }
+};
+
+fn cpusOf(set: *const Set) Cpus {
+    return .{ .set = set };
+}
+
+/// `set` as a CPU list (0-4,10-14), cut short to fit `buf`.
+pub fn format(set: *const Set, buf: []u8) []const u8 {
+    var w: std.Io.Writer = .fixed(buf);
+    var cpu: u32 = 0;
+    var first = true;
+    while (cpu < 1024) : (cpu += 1) {
+        if (!has(set, cpu)) continue;
+        var end = cpu;
+        while (end + 1 < 1024 and has(set, end + 1)) end += 1;
+        if (end == cpu) w.print("{s}{d}", .{ if (first) "" else ",", cpu }) catch break else w.print("{s}{d}-{d}", .{ if (first) "" else ",", cpu, end }) catch break;
+        first = false;
+        cpu = end;
+    }
+    if (first) w.writeAll("none") catch {};
+    return w.buffered();
+}
+
+/// The container's CPUs (cgroup cpuset, else online), not the calling thread's mask (a TP rank's single plan CPU).
+pub fn allowedCpus() Set {
+    var set: Set = undefined;
+    var buf: [512]u8 = undefined;
+    var path: [320]u8 = undefined;
+    if (readSmall("/proc/self/cgroup", &buf)) |text| {
+        var lines = std.mem.splitScalar(u8, text, '\n');
+        while (lines.next()) |line| if (std.mem.startsWith(u8, line, "0::")) {
+            // the nearest cgroup that sets a cpuset: a session scope's own file is empty, its slice's is not
+            var dir = std.mem.trimEnd(u8, line[3..], "/");
+            while (true) {
+                const p = std.fmt.bufPrintSentinel(&path, "/sys/fs/cgroup{s}/cpuset.cpus.effective", .{dir}, 0) catch break;
+                var cb: [512]u8 = undefined;
+                if (readSmall(p, &cb)) |cpus| if (sandbox.cpuList(std.mem.trim(u8, cpus, " \n"), &set)) return set;
+                if (dir.len == 0) break;
+                dir = dir[0 .. std.mem.findScalarLast(u8, dir, '/') orelse 0];
+            }
+        };
+    }
+    if (readSmall("/sys/devices/system/cpu/online", &buf)) |cpus| if (sandbox.cpuList(std.mem.trim(u8, cpus, " \n"), &set)) return set;
+    return @splat(0);
+}
+
+/// A core's cpu_capacity (sysfs; null where the kernel does not report one).
+pub fn capacity(cpu: u32) ?u32 {
+    var pb: [64]u8 = undefined;
+    const path = std.fmt.bufPrintSentinel(&pb, "/sys/devices/system/cpu/cpu{d}/cpu_capacity", .{cpu}, 0) catch return null;
+    var b: [16]u8 = undefined;
+    const text = readSmall(path, &b) orelse return null;
+    return std.fmt.parseInt(u32, std.mem.trim(u8, text, " \n"), 10) catch null;
+}
+
+fn readSmall(path: [*:0]const u8, buf: []u8) ?[]const u8 {
+    if (comptime builtin.os.tag != .linux) return null;
+    const rc = linux.open(path, .{ .ACCMODE = .RDONLY, .CLOEXEC = true }, 0);
+    if (linux.errno(rc) != .SUCCESS) return null;
+    const fd: i32 = @intCast(rc);
+    defer _ = linux.close(fd);
+    const n = linux.read(fd, buf.ptr, buf.len);
+    if (linux.errno(n) != .SUCCESS) return null;
+    return buf[0..n];
+}
diff --git a/zig/src/core/runner_place_bench.zig b/zig/src/core/runner_place_bench.zig
new file mode 100644
index 000000000..f760cd0f2
--- /dev/null
+++ b/zig/src/core/runner_place_bench.zig
@@ -0,0 +1,240 @@
+//! runner-place-bench [ENGINE_CPU] [SECONDS] [WORKERS] [ROUNDS]: host-loop stand-ins idle, beside the runner, inherit.
+const std = @import("std");
+const linux = std.os.linux;
+const place = @import("runner_place.zig");
+const backend = @import("runner_circuit_backend.zig");
+const rc = @import("runner_circuit.zig");
+const api = @import("runner_api.zig");
+
+const multiply = "123456789012345678901234567890*987654321098765432109876543210";
+const burst_iters = 150_000; // ~0.2 ms of dependent integer work on a Grace core
+const gap_ns = 500 * std.time.ns_per_us; // the host loop waits on the GPU between bursts
+
+fn nowNs() u64 {
+    var ts: linux.timespec = undefined;
+    _ = linux.clock_gettime(.MONOTONIC, &ts);
+    return @as(u64, @intCast(ts.sec)) * std.time.ns_per_s + @as(u64, @intCast(ts.nsec));
+}
+
+fn nap(ns: u64) void {
+    const ts: linux.timespec = .{ .sec = @intCast(ns / std.time.ns_per_s), .nsec = @intCast(ns % std.time.ns_per_s) };
+    _ = linux.nanosleep(&ts, null);
+}
+
+/// This thread's schedstat: ns on a CPU and ns runnable but waiting for one.
+fn sched() [2]u64 {
+    var buf: [128]u8 = undefined;
+    const opened = linux.open("/proc/thread-self/schedstat", .{ .ACCMODE = .RDONLY, .CLOEXEC = true }, 0);
+    if (linux.errno(opened) != .SUCCESS) return .{ 0, 0 };
+    const fd: i32 = @intCast(opened);
+    defer _ = linux.close(fd);
+    const n = linux.read(fd, &buf, buf.len);
+    if (linux.errno(n) != .SUCCESS) return .{ 0, 0 };
+    var it = std.mem.tokenizeAny(u8, buf[0..n], " \n");
+    const run = std.fmt.parseInt(u64, it.next() orelse "0", 10) catch 0;
+    const wait = std.fmt.parseInt(u64, it.next() orelse "0", 10) catch 0;
+    return .{ run, wait };
+}
+
+fn pin(set: *const place.Set) bool {
+    return linux.errno(linux.syscall3(.sched_setaffinity, 0, @sizeOf(place.Set), @intFromPtr(set))) == .SUCCESS;
+}
+
+fn one(cpu: u32) place.Set {
+    var s: place.Set = @splat(0);
+    place.add(&s, cpu);
+    return s;
+}
+
+/// A host-loop stand-in: bursts of fixed work with GPU-wait gaps; the measure is each period beyond its gap.
+const Proxy = struct {
+    mask: place.Set,
+    stop: *std.atomic.Value(bool),
+    times: std.ArrayList(u64) = .empty,
+    gpa: std.mem.Allocator,
+    sink: u64 = 0,
+    used: [2]u64 = .{ 0, 0 }, // run and wait ns over the phase
+
+    fn run(p: *Proxy) void {
+        _ = pin(&p.mask);
+        const s0 = sched();
+        defer {
+            const s1 = sched();
+            p.used = .{ s1[0] - s0[0], s1[1] - s0[1] };
+        }
+        var x: u64 = 0x9E3779B97F4A7C15;
+        var last = nowNs();
+        while (!p.stop.load(.acquire)) {
+            for (0..burst_iters) |_| x = (x ^ (x >> 13)) *% 0x2545F4914F6CDD1D +% 7;
+            nap(gap_ns);
+            // burst + gap + wake-up delay: a CPU taken from the loop shows here, before and after a burst
+            const now = nowNs();
+            p.times.append(p.gpa, now - last - gap_ns) catch return;
+            last = now;
+        }
+        p.sink = x;
+    }
+};
+
+/// The engine thread's part: on the engine CPU it keeps every runner worker busy, polling as the engine's tick does.
+const Driver = struct {
+    engine: place.Set,
+    b: api.Backend,
+    workers: u8,
+    program: []const u8,
+    stop: *std.atomic.Value(bool),
+    jobs: u64 = 0,
+    steps: u64 = 0,
+    cpu_ns: u64 = 0,
+
+    fn run(d: *Driver) void {
+        _ = pin(&d.engine);
+        const s0 = sched();
+        defer d.cpu_ns = sched()[0] - s0[0];
+        var live: [64]?api.JobId = @splat(null);
+        var stream: u64 = 0;
+        while (!d.stop.load(.acquire)) {
+            for (live[0..d.workers]) |*slot| {
+                if (slot.*) |id| switch (d.b.poll(id)) {
+                    .running => continue,
+                    .done => |r| {
+                        d.jobs += 1;
+                        d.steps += r.steps;
+                        slot.* = null;
+                    },
+                };
+                stream += 1;
+                slot.* = d.b.start(stream, .{ .kind = .calc, .bytes = d.program }, 1 << 30) catch null;
+            }
+            nap(std.time.ns_per_ms);
+        }
+        for (live[0..d.workers]) |slot| if (slot) |id| d.b.cancel(id);
+    }
+};
+
+/// idle: no runner; placed: TF_RUNNER_CPUS=auto; inherit: the control (runner threads keep the engine's CPU).
+const Phase = enum { idle, placed, inherit };
+
+pub fn main(init: std.process.Init) !u8 {
+    const gpa = init.gpa;
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+    const own = place.allowedCpus();
+    var mine: place.Set = @splat(0);
+    _ = linux.syscall3(.sched_getaffinity, 0, @sizeOf(place.Set), @intFromPtr(&mine));
+    // default engine CPU: the biggest core this process may use, as TF_TP_PLAN_PIN=auto picks
+    var engine_cpu: u32 = 0;
+    var best: u32 = 0;
+    for (0..1024) |c| if (place.has(&mine, @intCast(c))) if (place.capacity(@intCast(c))) |cap| if (cap > best) {
+        best = cap;
+        engine_cpu = @intCast(c);
+    };
+    if (args.len > 1) engine_cpu = try std.fmt.parseInt(u32, args[1], 10);
+    const seconds: u64 = if (args.len > 2) try std.fmt.parseInt(u64, args[2], 10) else 10;
+    const workers: u8 = if (args.len > 3) try std.fmt.parseInt(u8, args[3], 10) else 2;
+    const rounds: u64 = if (args.len > 4) try std.fmt.parseInt(u64, args[4], 10) else 3;
+    if (!place.has(&mine, engine_cpu)) {
+        var b: [256]u8 = undefined;
+        std.debug.print("FAIL engine CPU {d} is not in this process's CPUs {s}\n", .{ engine_cpu, place.format(&mine, &b) });
+        return 2;
+    }
+    var circuit: rc.Circuit = undefined;
+    var program: []const u8 = multiply;
+    if (init.environ_map.get("TF_RUNNER_CIRCUIT")) |path| {
+        circuit = try rc.Circuit.load(gpa, path);
+    } else {
+        const bytes = try @import("runner_circuit_tiny_test.zig").build(gpa, .good);
+        defer gpa.free(bytes);
+        circuit = try @import("runner_circuit_load.zig").fromBytes(gpa, bytes);
+        program = "";
+    }
+    defer circuit.deinit(gpa);
+    engine_set = one(engine_cpu);
+    // the engine's unpinned threads: the cores left beside the engine CPU and the runner's auto set
+    const runner_auto = place.choose(&own, &engine_set, place.capacity);
+    var rest: place.Set = undefined;
+    for (&rest, mine, runner_auto, engine_set) |*r, m, a, e| r.* = m & ~a & ~e;
+    const floating = !place.empty(&rest);
+    var b1: [256]u8 = undefined;
+    var b2: [256]u8 = undefined;
+    var b3: [256]u8 = undefined;
+    var b4: [256]u8 = undefined;
+    std.debug.print("engine CPU {d}; process CPUs {s}; container CPUs {s}; runner auto {s}; floating loop {s}; {d} workers; {d} rounds of {d} s a phase\n", .{ engine_cpu, place.format(&mine, &b1), place.format(&own, &b2), place.format(&runner_auto, &b3), if (floating) place.format(&rest, &b4) else "none (no core left)", workers, rounds, seconds });
+    var fixed: [3]std.ArrayList(u64) = @splat(.empty);
+    var float: [3]std.ArrayList(u64) = @splat(.empty);
+    defer for (&fixed, &float) |*a, *c| {
+        a.deinit(gpa);
+        c.deinit(gpa);
+    };
+    var jobs: [3]u64 = @splat(0);
+    var proxy_wait: [3]u64 = @splat(0);
+    var driver_cpu: [3]u64 = @splat(0);
+    var steps: [3]u64 = @splat(0);
+    // phases interleave round by round, so the machine's background load drifts across all three alike
+    for (0..rounds) |_| for ([_]Phase{ .idle, .placed, .inherit }) |phase| {
+        const k = @backingInt(phase);
+        var stop: std.atomic.Value(bool) = .init(false);
+        var fp: Proxy = .{ .mask = engine_set, .stop = &stop, .gpa = gpa, .times = fixed[k] };
+        var lp: Proxy = .{ .mask = rest, .stop = &stop, .gpa = gpa, .times = float[k] };
+        var placer: place.Placer = .{ .cfg = .{ .cpus = if (phase == .inherit) .inherit else .auto, .engine = engineSet } };
+        var b: ?api.Backend = null;
+        var driver: Driver = undefined;
+        var dt: ?std.Thread = null;
+        if (phase != .idle) {
+            b = try backend.placed(gpa, &circuit, workers, &placer);
+            driver = .{ .engine = engine_set, .b = b.?, .workers = workers, .program = program, .stop = &stop };
+            dt = try std.Thread.spawn(.{}, Driver.run, .{&driver});
+        }
+        const ft = try std.Thread.spawn(.{}, Proxy.run, .{&fp});
+        const lt: ?std.Thread = if (floating) try std.Thread.spawn(.{}, Proxy.run, .{&lp}) else null;
+        nap(seconds * std.time.ns_per_s);
+        stop.store(true, .release);
+        ft.join();
+        if (lt) |t| t.join();
+        if (dt) |t| t.join();
+        if (b) |x| backend.destroy(x);
+        fixed[k] = fp.times;
+        proxy_wait[k] += fp.used[1];
+        float[k] = lp.times;
+        if (phase != .idle) {
+            jobs[k] += driver.jobs;
+            driver_cpu[k] += driver.cpu_ns;
+            steps[k] += driver.steps;
+        }
+    };
+    var base: [2]u64 = .{ 1, 1 };
+    var base_n: usize = 1;
+    var verdict_ok = true;
+    for ([_]Phase{ .idle, .placed, .inherit }) |phase| {
+        const k = @backingInt(phase);
+        const f = stats(fixed[k].items);
+        const l = stats(float[k].items);
+        if (phase == .idle) base = .{ @max(f.p50, 1), @max(l.p50, 1) };
+        const rf = @as(f64, @floatFromInt(f.p50)) / @as(f64, @floatFromInt(base[0]));
+        const rl = @as(f64, @floatFromInt(l.p50)) / @as(f64, @floatFromInt(base[1]));
+        if (phase == .idle) base_n = @max(f.n, 1);
+        const rate = @as(f64, @floatFromInt(f.n)) / @as(f64, @floatFromInt(base_n));
+        std.debug.print("RESULT {t}: engine-CPU loop period beyond its gap p50 {d} us p99 {d} us (x{d:.3} of idle), {d} loops (x{d:.3})", .{ phase, f.p50 / 1000, f.p99 / 1000, rf, f.n, rate });
+        if (floating) std.debug.print("; floating loop p50 {d} us p99 {d} us (x{d:.3})", .{ l.p50 / 1000, l.p99 / 1000, rl });
+        const secs = rounds * seconds;
+        std.debug.print("; proxy runnable-waiting {d} ms/s", .{proxy_wait[k] / 1_000_000 / secs});
+        if (phase != .idle) std.debug.print("; driver (engine thread) {d} ms/s CPU; runner {d} jobs, {d} steps/s", .{ driver_cpu[k] / 1_000_000 / secs, jobs[k], steps[k] / secs });
+        std.debug.print("\n", .{});
+        if (phase == .placed and (rf > 1.05 or rate < 0.95 or (floating and rl > 1.05))) verdict_ok = false;
+    }
+    std.debug.print("{s}: the placed runner at full load {s} the engine's loops within 5% of idle (p50 period, loops)\n", .{ if (verdict_ok) "PASS" else "FAIL", if (verdict_ok) "keeps" else "does not keep" });
+    return if (verdict_ok) 0 else 1;
+}
+
+const Stats = struct { n: usize, p50: u64, p99: u64 };
+
+fn stats(t: []u64) Stats {
+    if (t.len == 0) return .{ .n = 0, .p50 = 0, .p99 = 0 };
+    std.mem.sort(u64, t, {}, std.sort.asc(u64));
+    return .{ .n = t.len, .p50 = t[t.len / 2], .p99 = t[t.len * 99 / 100] };
+}
+
+var engine_set: place.Set = @splat(0);
+
+fn engineSet(set: *place.Set) void {
+    for (set, engine_set) |*s, e| s.* |= e;
+}
