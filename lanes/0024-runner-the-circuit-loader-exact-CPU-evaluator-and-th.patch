+}
+
+test "a halving head reruns on unchanged inputs: its table halves every step, as running every unit does" {
+    var c = try tinyCircuit(.halving);
+    defer c.deinit(gpa);
+    var lazy = try rc.State.init(gpa, &c);
+    defer lazy.deinit();
+    var full = try rc.State.init(gpa, &c);
