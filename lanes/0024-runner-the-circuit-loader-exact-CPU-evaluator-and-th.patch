+++ b/zig/src/core/runner_circuit_bench.zig
@@ -0,0 +1,32 @@
+//! CPU steps/s of the circuit evaluator: boots a calc expression (or an .elf file) and runs it to HALT, repeated.
+const std = @import("std");
+const rc = @import("runner_circuit.zig");
+
+pub fn main(init: std.process.Init) !u8 {
+    const gpa = init.gpa;
+    const argv = try init.minimal.args.toSlice(init.arena.allocator());
+    if (argv.len < 3) {
+        std.debug.print("usage: runner-circuit-bench <circuit> <expression | image.elf> [repeats]\n", .{});
+        return 2;
+    }
+    const repeats = if (argv.len > 3) try std.fmt.parseInt(u32, argv[3], 10) else 3;
+    const t_load = rc.nowNs();
+    var c = try rc.Circuit.load(gpa, argv[1]);
+    defer c.deinit(gpa);
+    std.debug.print("loaded {d} dims, {d} nodes, {d} batches, {d} tables, {d} nonzeros in {d} ms\n", .{ c.dims, c.nodes, c.batches.len, c.tables.len, c.nonzeros(), (rc.nowNs() - t_load) / std.time.ns_per_ms });
+    var cancel: std.atomic.Value(bool) = .init(false);
+    const is_elf = std.mem.endsWith(u8, argv[2], ".elf");
+    const bytes = if (is_elf) try std.Io.Dir.cwd().readFileAlloc(init.io, argv[2], init.arena.allocator(), .limited(1 << 26)) else argv[2];
+    for (0..repeats) |_| {
+        const t0 = rc.nowNs();
+        var m = try rc.Machine.boot(gpa, &c, .{ .kind = if (is_elf) .elf else .calc, .bytes = bytes });
+        defer m.deinit(gpa);
+        const t1 = rc.nowNs();
+        var out: std.ArrayList(u8) = .empty;
+        defer out.deinit(gpa);
+        const end = try m.run(10_000_000, &out, null, &cancel);
+        const ns = rc.nowNs() - t1;
+        std.debug.print("{s}: {d} steps, boot {d} us, run {d} ms, {d} steps/s, out {s}", .{ @tagName(end.end), end.steps, (t1 - t0) / 1000, ns / std.time.ns_per_ms, end.steps * std.time.ns_per_s / @max(ns, 1), out.items });
+    }
+    return 0;
+}
diff --git a/zig/src/core/runner_circuit_elf.zig b/zig/src/core/runner_circuit_elf.zig
new file mode 100644
index 000000000..134a08548
--- /dev/null
+++ b/zig/src/core/runner_circuit_elf.zig
@@ -0,0 +1,195 @@
+//! Loads an rv32im_zba ELF into a booted circuit as data (upstream elf.program and core.snapshot), never running it.
+const std = @import("std");
+const model = @import("runner_circuit_model.zig");
+const rom = @import("runner_circuit_rom.zig");
+const State = @import("runner_circuit_state.zig").State;
+
+const hd = model.hd;
+pub const drom_base: u32 = 0x20000;
+pub const drom_bytes: u32 = 4 << 15;
+pub const ram_bytes: u32 = 4 << 13;
+const sp_init: u32 = ram_bytes;
+const n_rom_heads = rom.rom_words >> 11;
+const n_drom_heads = (drom_bytes / 4) >> 11;
+
+/// The pieces of a static ELF the machine holds: ROM words, DROM bytes, RAM bytes and the entry address.
+pub const Image = model.Image;
+
+/// elf.program: PT_LOAD segments (bss zero-filled) into ROM, DROM or RAM; anything else is refused.
+pub fn parse(a: std.mem.Allocator, b: []const u8) !Image {
+    if (b.len < 52 or !std.mem.eql(u8, b[0..7], "\x7fELF\x01\x01\x01")) return error.ElfHeader;
+    const r = std.mem.readInt;
+    if (r(u16, b[16..18], .little) != 2 or r(u16, b[18..20], .little) != 243) return error.ElfMachine;
+    const entry = r(u32, b[24..28], .little);
+    const phoff = r(u32, b[28..32], .little);
+    const phentsize = r(u16, b[42..44], .little);
+    const phnum = r(u16, b[44..46], .little);
+    if (phentsize != 32 or @as(u64, phoff) + @as(u64, phnum) * 32 > b.len) return error.ElfHeader;
+    const words = try a.alloc(u32, rom.rom_words);
+    errdefer a.free(words);
+    @memset(words, 0);
+    const drom = try a.alloc(u8, drom_bytes);
+    errdefer a.free(drom);
+    @memset(drom, 0);
+    const ram = try a.alloc(u8, ram_bytes);
+    errdefer a.free(ram);
+    @memset(ram, 0);
+    var drom_len: usize = 0;
+    for (0..phnum) |i| {
+        const p = b[phoff + 32 * i ..][0..32];
+        const typ = r(u32, p[0..4], .little);
+        if (typ == 2 or typ == 3) return error.ElfDynamic;
+        const off = r(u32, p[4..8], .little);
+        const vaddr = r(u32, p[8..12], .little);
+        const filesz = r(u32, p[16..20], .little);
+        const memsz = r(u32, p[20..24], .little);
+        if (typ != 1 or memsz == 0) continue;
+        if (filesz > memsz or @as(u64, off) + filesz > b.len) return error.ElfSegment;
+        const end = @as(u64, vaddr) + memsz;
+        const data = b[off..][0..filesz];
+        if (vaddr >= rom.rom_base and end <= rom.rom_base + 4 * @as(u64, rom.rom_words)) {
+            const bytes = std.mem.sliceAsBytes(words);
+            @memcpy(bytes[vaddr - rom.rom_base ..][0..filesz], data);
+        } else if (vaddr >= drom_base and end <= drom_base + @as(u64, drom_bytes)) {
+            @memcpy(drom[vaddr - drom_base ..][0..filesz], data);
+            drom_len = @max(drom_len, end - drom_base);
+        } else if (end <= ram_bytes) {
+            @memcpy(ram[vaddr..][0..filesz], data);
+        } else return error.ElfSegment;
+    }
+    for (words) |*w| w.* = std.mem.littleToNative(u32, w.*);
+    if (entry % 4 != 0 or entry < rom.rom_base or entry >= rom.rom_base + 4 * rom.rom_words) return error.ElfEntry;
+    return .{ .rom = words, .drom = drom, .ram = ram, .entry = entry };
+}
+
+pub fn load(s: *State, image_bytes: []const u8) !void {
+    const img = try parse(s.gpa, image_bytes);
+    defer img.deinit(s.gpa);
+    try boot(s, img);
+}
+
+fn named(s: *const State, name: []const u8) !u32 {
+    for (s.circuit.table_names, 0..) |n, i| if (std.mem.eql(u8, n, name)) return @intCast(i);
+    return error.CircuitTableMissing;
+}
+
+fn namedFmt(s: *const State, comptime fmt: []const u8, args: anytype) !u32 {
+    var buf: [32]u8 = undefined;
+    return named(s, try std.fmt.bufPrint(&buf, fmt, args));
+}
+
+const Row = [hd]model.Scalar;
+
+fn ballast(s: *const State) Row {
+    var row: Row = @splat(0);
+    row[0] = s.circuit.program.a_ref;
+    row[1] = s.circuit.program.a_ref;
+    return row;
+}
+
+/// The snapshot replaces a table whole: rows it does not name are absent.
+fn clear(s: *State, t: u32) !void {
+    try s.own(t);
+    @memset(s.tables[t], 0);
+    s.present[t] = 0;
+}
+
+/// core.snapshot: the machine's boot state written into the circuit's tables (the heads' initial states).
+pub fn boot(s: *State, img: Image) !void {
+    s.force = true;
+    const a_bit = s.circuit.program.a_bit;
+    const anchor = (img.entry - rom.rom_base) >> 2;
+    var pc = ballast(s);
+    for (0..16) |i| pc[2 + i] = if (anchor >> @intCast(i) & 1 == 1) a_bit else 0;
+    const pc_t = try named(s, "pc");
+    try clear(s, pc_t);
+    try s.writeRow(pc_t, 0, &pc);
+    for ([_][]const u8{ "count", "j", "vcnt" }) |name| {
+        const t = try named(s, name);
+        try clear(s, t);
+        var r0: Row = @splat(0);
+        r0[2] = a_bit;
+        try s.writeRow(t, 0, &r0);
+        try s.writeRow(t, 1, &ballast(s));
+    }
+    const cols = try regColumns(s, try named(s, "regs.rd"));
+    for ([_][]const u8{ "regs.rs1", "regs.rs2", "regs.rd" }) |name| {
+        const t = try named(s, name);
+        try clear(s, t);
+        for (1..32) |reg| {
+            var row = ballast(s);
+            const value: u32 = if (reg == 2) sp_init else 0;
+            for (cols, 0..) |c, i| if (value >> @intCast(i) & 1 == 1) {
+                row[c] = a_bit;
+            };
+            try s.writeRow(t, @intCast(reg), &row);
+        }
+    }
+    for (0..4) |h| {
+        const t = try namedFmt(s, "quo{d}", .{h});
+        for (0..2) |x| {
+            try clear(s, t + @as(u32, @intCast(x)));
+            try s.writeRow(t + @as(u32, @intCast(x)), 0, &ballast(s));
+        }
+    }
+    const pre = try s.gpa.alloc(u32, rom.rom_words);
+    defer s.gpa.free(pre);
+    for (img.rom, pre, 0..) |w, *p, i| p.* = if (w == 0) 0 else rom.romWord(w, rom.rom_base + 4 * @as(u32, @intCast(i)));
+    try byteRows(s, "rom", n_rom_heads, pre);
+    const drom_words = try s.gpa.alloc(u32, drom_bytes / 4);
+    defer s.gpa.free(drom_words);
+    for (drom_words, 0..) |*w, i| w.* = std.mem.readInt(u32, img.drom[4 * i ..][0..4], .little);
+    try byteRows(s, "drom", n_drom_heads, drom_words);
+    for (1..3) |port| for (0..4) |h| {
+        const t = try namedFmt(s, "bn{d}.{d}", .{ port, h });
+        for (0..2) |x| {
+            try clear(s, t + @as(u32, @intCast(x)));
+            for (0..hd) |r| try s.writeRow(t + @as(u32, @intCast(x)), @intCast(r), &ballast(s));
+        }
+    };
+    const write = @import("runner_circuit.zig").writeWord;
+    for (0..ram_bytes / 4) |wi| try write(s, @intCast(wi), std.mem.readInt(u32, img.ram[4 * wi ..][0..4], .little));
+}
+
+/// core.byte_rows: per head two value heads of 64 row pairs; word wl of a block sits in row (wl >> 4) + 64 * half.
+fn byteRows(s: *State, comptime prefix: []const u8, heads: u32, words: []const u32) !void {
+    const per = words.len / heads;
+    for (0..heads) |h| {
+        const t = try namedFmt(s, prefix ++ "{d}", .{h});
+        for (0..2) |x| {
+            const tt = t + @as(u32, @intCast(x));
+            try clear(s, tt);
+            const blk = words[h * per + x * (per / 2) ..][0 .. per / 2];
+            for (0..hd) |r| try s.writeRow(tt, @intCast(r), &ballast(s));
+            for (blk, 0..) |w, wl| {
+                const half = wl >> 3 & 1;
+                const row = s.row(tt, @intCast((wl >> 4) + 64 * half));
+                for (0..4) |byte| row[2 + 32 * half + 4 * (wl & 7) + byte] = @floatFromInt(w >> @intCast(8 * byte) & 0xff);
+            }
+        }
+    }
+}
+
+/// core.reg_cols: register bit i is the first value column whose output lands in the i-th distinct x.<port> dim.
+fn regColumns(s: *const State, table: u32) ![32]u32 {
+    for (s.circuit.batches) |*b| switch (b.*) {
+        .ffn => {},
+        .heads => |*hs| for (hs.heads) |*head| for (head.value_heads) |*vh| {
+            if (vh.table != table) continue;
+            var cols: [32]u32 = undefined;
+            var dims: [32]u32 = undefined;
+            var n: usize = 0;
+            for (vh.out_cols, 0..) |c, i| {
+                const d = hs.outs[vh.out_first + i].dim;
+                if (std.mem.indexOfScalar(u32, dims[0..n], d) != null) continue;
+                if (n == 32) return error.CircuitRegisterLayout;
+                dims[n] = d;
+                cols[n] = c;
+                n += 1;
+            }
+            if (n != 32) return error.CircuitRegisterLayout;
+            return cols;
+        },
+    };
+    return error.CircuitTableMissing;
+}
diff --git a/zig/src/core/runner_circuit_eval.zig b/zig/src/core/runner_circuit_eval.zig
new file mode 100644
index 000000000..d2b20decf
--- /dev/null
+++ b/zig/src/core/runner_circuit_eval.zig
@@ -0,0 +1,228 @@
+//! Exact CPU evaluation of one circuit step: token features, SwiGLU units, one-hot DeltaNet heads, output code.
+const std = @import("std");
+const model = @import("runner_circuit_model.zig");
+const state = @import("runner_circuit_state.zig");
+const flow = @import("runner_circuit_flow.zig");
+const head = @import("runner_circuit_head.zig");
+const ffn = @import("runner_circuit_ffn.zig");
+const Memo = @import("runner_circuit_memo.zig").Memo;
+const State = state.State;
+
+const Scalar = model.Scalar;
+const hd = model.hd;
+
+/// The token's feature values: a feature dim holds its last nonzero feature, else zero.
+fn embed(s: *State, token: u32, stamp: u64) !void {
+    const c = s.circuit;
+    const fam, const pay = c.split(token) orelse return error.CircuitUnknownToken;
+    for (c.features) |f| {
+        const v = f.value(fam, pay, c.family_bits);
+        if (v != 0) s.x[f.dim] = v;
+    }
+    for (c.flow.feature_dims, c.flow.feature_slots) |d, slot| {
+        set(s, slot, s.x[d], stamp);
+        s.x[d] = 0;
+    }
+}
+
+/// One token through the circuit in node order; only units marked active run or finish, the rest keep their outputs.
+pub fn step(s: *State, token: u32) !u32 {
+    const c = s.circuit;
+    const stamp = s.steps + 1;
+    // Only heads read tables; an FFN part matches its inputs once it ran, and from the start if it is quiet.
+    if (s.force or s.always) {
+        @memset(s.dirty, stamp);
+        for (c.flow.units, 0..) |u, i| if (s.always or u.kind == .heads or (s.steps == 0 and !u.quiet)) mark(s.active, i);
+    }
+    s.force = false;
+    try embed(s, token, stamp);
+    for (s.active, 0..) |*word, w| while (word.* != 0) {
+        const bit = @ctz(word.*);
+        const i = w * 64 + bit;
+        const u = &c.flow.units[i];
+        if (s.dirty[i] == stamp) s.changed[i] = stamp;
+        const due = (s.changed[i] != 0 and stamp - s.changed[i] <= u.lag) or s.unstable[i];
+        if (due and !(u.kind == .heads and try head.skips(s, u.plan, i))) {
+            try run(s, u, i, stamp);
+        } else finish(s, u, i, stamp);
+        // A unit's own outputs may re-mark it while it runs; clearing after the run drops that.
+        word.* &= ~(@as(u64, 1) << @intCast(bit));
+        if ((s.changed[i] != 0 and stamp + 1 - s.changed[i] <= u.lag) or s.unstable[i]) mark(s.keep, i);
+    };
+    std.mem.swap([]u64, &s.active, &s.keep);
+    s.steps += 1;
+    return decode(c, s);
+}
+
+fn mark(bits: []u64, i: usize) void {
+    bits[i / 64] |= @as(u64, 1) << @intCast(i % 64);
+}
+
+/// A slot takes a new value; units reading it rerun this step when its bits change and keep their nonzero inputs.
+fn set(s: *State, slot: u32, v: Scalar, stamp: u64) void {
+    if (@as(u32, @bitCast(v)) == @as(u32, @bitCast(s.val[slot]))) return;
+    s.val[slot] = v;
+    const f = &s.circuit.flow;
+    const lo = f.reader_starts[slot];
+    const hi = f.reader_starts[slot + 1];
+    for (f.readers[lo..hi], f.reader_local[lo..hi], f.reader_off[lo..hi]) |r, j, off| {
+        s.dirty[r] = stamp;
+        mark(s.active, r);
+        const was = s.in_vals[off + j] != 0;
+        s.in_vals[off + j] = v;
+        if (was != (v != 0)) s.in_bits[(off + j) / 64] ^= @as(u64, 1) << @intCast((off + j) % 64);
+    }
+    const blo = f.base_starts[slot];
+    const bhi = f.base_starts[slot + 1];
+    for (f.base_readers[blo..bhi], f.base_out[blo..bhi], f.base_first[blo..bhi]) |r, k, first| queue(s, r, first, k, stamp);
+}
+
+/// Queues output k of unit r (first output slot `first`) to be finished this step: its value or base changed.
+fn queue(s: *State, r: u32, first: u32, k: u32, stamp: u64) void {
+    if (s.rb_mark[first + k] == stamp) return;
+    s.rb_mark[first + k] = stamp;
+    mark(s.active, r);
+    if (s.rebase[r] != stamp) {
+        s.rebase[r] = stamp;
+        s.rb_len[r] = 0;
+    }
+    s.rb[first + s.rb_len[r]] = k;
+    s.rb_len[r] += 1;
+}
+
+/// Sets every queued output of unit i: its value plus its base, or for a chain end the fold of its links in order.
+fn finish(s: *State, u: *const flow.Unit, i: usize, stamp: u64) void {
+    if (s.rebase[i] != stamp) return;
+    const f = &s.circuit.flow;
+    const first = u.outs[0];
+    var at: usize = 0;
+    while (at < s.rb_len[i]) : (at += 1) {
+        const k = s.rb[first + at];
+        const sl = first + k;
+        var v: Scalar = undefined;
+        if (f.chain_len[sl] > 0) {
+            v = fold(s, sl);
+        } else {
+            const b = u.base[k];
+            v = if (b == flow.no_slot) s.pre[sl] else s.val[b] + s.pre[sl];
+        }
+        set(s, sl, v, stamp);
+    }
+}
+
+/// base + links in order over links not +0: adding +0 only turns a -0 sum into +0, and -0 is the empty-sum identity.
+fn fold(s: *State, end: u32) Scalar {
+    const f = &s.circuit.flow;
+    const n = f.chain_len[end];
+    const links = f.chain_links[f.chain_start[end]..][0..n];
+    const b = f.chain_base[end];
+    var v: Scalar = if (b == flow.no_slot) -0.0 else s.val[b];
+    var added: usize = 0;
+    for (s.chain_bits[f.chain_bits_at[end]..][0 .. (n + 63) / 64], 0..) |word, w| {
+        var bits = word;
+        while (bits != 0) : (bits &= bits - 1) {
+            v = v + s.pre[links[w * 64 + @ctz(bits)]];
+            added += 1;
+        }
+    }
+    if (added < n and @as(u32, @bitCast(v)) == @as(u32, @bitCast(@as(Scalar, -0.0)))) v = 0;
+    return v;
+}
+
+/// Records whether chain link `sl` now holds something other than +0.
+fn linkBit(s: *State, sl: u32, v: Scalar) void {
+    const f = &s.circuit.flow;
+    const pos = f.chain_pos[sl];
+    if (pos == flow.no_slot) return;
+    const end = if (f.elided[sl]) f.chain_end[sl] else sl;
+    const word = &s.chain_bits[f.chain_bits_at[end] + pos / 64];
+    const bit = @as(u64, 1) << @intCast(pos % 64);
+    if (@as(u32, @bitCast(v)) != 0) word.* |= bit else word.* &= ~bit;
+}
+
+/// Gathers a unit's nonzero inputs, ascending, into s.x, s.nz (dims) and s.local (input indices); returns their count.
+fn nonzeros(s: *State, u: *const flow.Unit) usize {
+    const lo = u.in_off;
+    const hi = lo + u.dims.len;
+    var n: usize = 0;
+    var w = lo / 64;
+    while (w * 64 < hi) : (w += 1) {
+        var bits = s.in_bits[w];
+        if (w * 64 < lo) bits &= ~@as(u64, 0) << @intCast(lo % 64);
+        if ((w + 1) * 64 > hi) bits &= (@as(u64, 1) << @intCast(hi % 64)) - 1;
+        while (bits != 0) : (bits &= bits - 1) {
+            const j: u32 = @intCast(w * 64 + @ctz(bits) - lo);
+            const d = u.dims[j];
+            s.x[d] = s.in_vals[lo + j];
+            s.nz[n] = d;
+            s.local[n] = j;
+            n += 1;
+        }
+    }
+    return n;
+}
+
+fn run(s: *State, u: *const flow.Unit, i: usize, stamp: u64) !void {
+    const n = nonzeros(s, u);
+    const list = s.local[0..n];
+    const nz = s.nz[0..n];
+    defer for (nz) |d| {
+        s.x[d] = 0;
+    };
+    const values = switch (u.kind) {
+        .ffn => try ffnCached(s, u, &s.circuit.flow.ffn_plans[u.plan], i, nz, list),
+        .heads => try head.run(s, u.plan, i, nz, list),
+    };
+    if (u.kind == .heads) s.rest[i] = for (values) |v| {
+        if (@as(u32, @bitCast(v)) != 0) break false;
+    } else true;
+    if (u.outs.len == 0) return;
+    const f = &s.circuit.flow;
+    const first = u.outs[0];
+    const pre = s.pre[first..][0..u.outs.len];
+    if (!std.mem.eql(u32, @ptrCast(pre), @ptrCast(values))) for (values, pre, 0..) |v, *p, k| {
+        if (@as(u32, @bitCast(v)) == @as(u32, @bitCast(p.*))) continue;
+        p.* = v;
+        const sl = first + @as(u32, @intCast(k));
+        linkBit(s, sl, v);
+        if (!f.elided[sl]) {
+            queue(s, @intCast(i), first, @intCast(k), stamp);
+            continue;
+        }
+        const end = f.chain_end[sl];
+        const r = f.slot_unit[end];
+        const end_first = f.units[r].outs[0];
+        queue(s, r, end_first, end - end_first, stamp);
+    };
+    finish(s, u, i, stamp);
+}
+
+/// An FFN part is a pure function of its nonzero inputs: a memo hit returns the outputs it computed for them.
+fn ffnCached(s: *State, u: *const flow.Unit, p: *const ffn.Plan, i: usize, nz: []const u32, local: []const u32) ![]const Scalar {
+    const x, const ids = if (p.f.dims.len > 0) .{ s.in_vals[u.in_off..][0..u.dims.len], local } else .{ s.x, nz };
+    if (s.always or s.memos[i].off() or s.memos[i].cold()) return ffn.run(s, p, x, ids);
+    const key = s.key[0..nz.len];
+    for (key, nz, local) |*k, d, j| k.* = @as(u64, j) << 32 | @as(u32, @bitCast(s.x[d]));
+    const h = Memo.hash(key);
+    if (s.memos[i].find(key, h)) |words| return @ptrCast(words);
+    const y = ffn.run(s, p, x, ids);
+    try s.memos[i].put(s.gpa, key, h, @ptrCast(y));
+    return y;
+}
+
+/// The output code: family bits then 16 payload bits, each the sign of a code dim (+kappa is 1, -kappa is 0).
+pub fn decode(c: *const model.Circuit, s: *const State) !u32 {
+    var code: u64 = 0;
+    for (c.flow.code, 0..) |slot, i| {
+        const v = s.val[slot];
+        if (v == 0 or !std.math.isFinite(v)) return error.CircuitOutputCode;
+        code |= @as(u64, @intFromBool(v > 0)) << @intCast(i);
+    }
+    const mask = (@as(u64, 1) << @intCast(c.family_bits)) - 1;
+    const fam = code & mask;
+    const pay: u32 = @intCast(code >> @intCast(c.family_bits));
+    if (fam >= c.families.len) return error.CircuitOutputFamily;
+    const f = c.families[@intCast(fam)];
+    if (pay >= f.size) return error.CircuitOutputPayload;
+    return f.base + pay;
+}
diff --git a/zig/src/core/runner_circuit_ffn.zig b/zig/src/core/runner_circuit_ffn.zig
new file mode 100644
index 000000000..6c7761c02
--- /dev/null
+++ b/zig/src/core/runner_circuit_ffn.zig
@@ -0,0 +1,72 @@
+//! An FFN batch part on the CPU: every form by scatter, then every firing unit by the sorted walk.
+const std = @import("std");
+const model = @import("runner_circuit_model.zig");
+const State = @import("runner_circuit_state.zig").State;
+
+const Scalar = model.Scalar;
+const none = model.no_form;
+
+pub const Plan = struct {
+    f: *const model.Ffn,
+    /// The part's up and gate forms with dense rows for inputs that reach many forms.
+    up: model.Sparse,
+    gate: model.Sparse,
+    /// Where this part's forms and nodes live in the per-machine arrays.
+    up_off: u32,
+    gate_off: u32,
+    node_off: u32,
+};
+
+pub fn build(a: std.mem.Allocator, f: *const model.Ffn, offs: *[3]u32) !Plan {
+    const p: Plan = .{
+        .f = f,
+        .up = try f.up.forms.densify(a),
+        .gate = try f.gate.forms.densify(a),
+        .up_off = offs[0],
+        .gate_off = offs[1],
+        .node_off = offs[2],
+    };
+    offs[0] += f.up.forms.outputs;
+    offs[1] += f.gate.forms.outputs;
+    offs[2] += @intCast(f.outs.len);
+    return p;
+}
+
+/// The part's outputs for the running inputs (nz sources ascending, values in x); silent units (gate <= 0) add zero.
+pub fn run(s: *State, p: *const Plan, x: []const Scalar, nz: []const u32) []const Scalar {
+    const f = p.f;
+    const up = s.ffn_up[p.up_off..][0..f.up.forms.outputs];
+    const gate = s.ffn_gate[p.gate_off..][0..f.gate.forms.outputs];
+    const y = s.ffn_y[p.node_off..][0..f.outs.len];
+    @memset(y, 0);
+    p.up.apply(x, nz, up);
+    p.gate.apply(x, nz, gate);
+    fire(f, up, gate, y);
+    return y;
+}
+
+/// Whether every output is +0 when every input is zero: a fresh machine's zeroed outputs already match the part.
+pub fn quiet(a: std.mem.Allocator, f: *const model.Ffn) !bool {
+    const up = try a.alloc(Scalar, f.up.forms.outputs + f.gate.forms.outputs + f.outs.len);
+    defer a.free(up);
+    @memset(up, 0);
+    const y = up[up.len - f.outs.len ..];
+    fire(f, up[0..f.up.forms.outputs], up[f.up.forms.outputs..][0..f.gate.forms.outputs], y);
+    for (y) |v| if (@as(u32, @bitCast(v)) != 0) return false;
+    return true;
+}
+
+/// Adds every firing unit's output to y from the forms' values.
+fn fire(f: *const model.Ffn, up: []const Scalar, gate: []const Scalar, y: []Scalar) void {
+    for (gate, f.starts[0 .. f.starts.len - 1], f.starts[1..]) |v, lo, hi| for (f.order[lo..hi]) |t| {
+        const g = f.gate.bias[t] + v;
+        if (!(g > 0)) break;
+        y[f.slot[t]] += f.coef[t] * upValue(f, t, up) * g;
+    };
+    for (f.always) |t| y[f.slot[t]] += f.coef[t] * upValue(f, t, up) * f.gate.bias[t];
+}
+
+fn upValue(f: *const model.Ffn, t: u32, up: []const Scalar) Scalar {
+    const uf = f.up.form[t];
+    return if (uf == none) f.up.bias[t] else f.up.bias[t] + up[uf];
+}
diff --git a/zig/src/core/runner_circuit_flow.zig b/zig/src/core/runner_circuit_flow.zig
new file mode 100644
index 000000000..beda8d3f3
--- /dev/null
+++ b/zig/src/core/runner_circuit_flow.zig
@@ -0,0 +1,323 @@
+//! A step as single-assignment dataflow: every write is a slot that keeps its value across steps, units read slots.
+const std = @import("std");
+const model = @import("runner_circuit_model.zig");
+const head = @import("runner_circuit_head.zig");
+const ffn = @import("runner_circuit_ffn.zig");
+
+/// The slot of a dim nothing has written in the step yet; it never changes.
+pub const zero_slot: u32 = 0;
+pub const no_slot = std.math.maxInt(u32);
+
+/// One recomputable piece of a step: an independent part of an FFN batch or a single head.
+pub const Unit = struct {
+    kind: union(enum) { ffn: *const model.Ffn, heads: *const model.Heads },
+    /// Dims the unit's forms read (ascending) and the slot each one reads.
+    dims: []const u32,
+    ins: []const u32,
+    /// The slot each output writes and, for an `into` output, the slot it adds to.
+    outs: []const u32,
+    base: []const u32,
+    /// Largest conv lag among the unit's channels: a head reruns that many steps after its inputs change.
+    lag: u32,
+    /// The unit's CPU plan (index into Flow.plans for a head, Flow.ffn_plans for an FFN batch).
+    plan: u32 = no_slot,
+    /// Where the unit's inputs start in the per-machine input arrays.
+    in_off: u32 = 0,
+    /// An FFN part whose outputs are all +0 at all-zero inputs: a fresh machine need not run it until an input moves.
+    quiet: bool = false,
+};
+
+pub const Flow = struct {
+    slots: u32,
+    units: []const Unit,
+    plans: []const head.Plan,
+    ffn_plans: []const ffn.Plan,
+    /// Sizes of the per-machine FFN arrays: up forms, gate forms and nodes.
+    ffn_totals: [3]u32,
+    /// Distinct feature dims and their slots; a feature dim's value is its last nonzero feature, else zero.
+    feature_dims: []const u32,
+    feature_slots: []const u32,
+    /// Units reading each slot as an input, and units adding their outputs onto it (CSR by slot).
+    reader_starts: []const u32,
+    readers: []const u32,
+    /// The reading unit's input index of each reader edge, and where that unit's inputs start.
+    reader_local: []const u32,
+    reader_off: []const u32,
+    /// Per base edge: the unit, the output that adds onto the slot, and the unit's first output slot.
+    base_starts: []const u32,
+    base_readers: []const u32,
+    base_out: []const u32,
+    base_first: []const u32,
+    /// The slot holding each dim at the end of a step, and the output code's slots.
+    final: []const u32,
+    code: []const u32,
+    max_dims: u32,
+    total_ins: u32,
+    /// Per slot: the unit writing it; a chain link no unit reads (elided, never stored) and the chain end it feeds.
+    slot_unit: []const u32,
+    elided: []const bool,
+    chain_end: []const u32,
+    /// Per chain end: its links (slots, first to itself) in chain_links and the slot the first link adds onto.
+    chain_start: []const u32,
+    chain_len: []const u32,
+    chain_base: []const u32,
+    chain_links: []const u32,
+    /// Per slot: its link index in its chain, or no_slot; per chain end, where its link bits start (one bit per link).
+    chain_pos: []const u32,
+    chain_bits_at: []const u32,
+    chain_words: u32,
+    /// Per head plan: its group of heads with the same input slots and selecting dims (one key per step), or no_slot.
+    plan_group: []const u32,
+    groups: u32,
+};
+
+/// Dims a set of forms reads: the union of their sources, ascending.
+fn reads(a: std.mem.Allocator, sets: []const *const model.Sparse) ![]u32 {
+    var out: std.ArrayList(u32) = .empty;
+    for (sets) |m| try out.appendSlice(a, m.used);
+    std.mem.sort(u32, out.items, {}, std.sort.asc(u32));
+    var n: usize = 0;
+    for (out.items) |d| {
+        if (n > 0 and out.items[n - 1] == d) continue;
+        out.items[n] = d;
+        n += 1;
+    }
+    return out.items[0..n];
+}
+
+/// Heads reading the same slots through the same selecting dims share one key per step and one input-frame ring.
+fn selectionGroups(a: std.mem.Allocator, units: []const Unit, plans: []head.Plan) !struct { []u32, u32 } {
+    const group = try a.alloc(u32, plans.len);
+    @memset(group, no_slot);
+    var n: u32 = 0;
+    for (units, 0..) |u, i| if (u.kind == .heads and !plans[u.plan].general) {
+        for (units[0..i]) |v| if (v.kind == .heads and !plans[v.plan].general and std.mem.eql(u32, u.ins, v.ins) and
+            std.mem.eql(bool, plans[u.plan].sel_dim, plans[v.plan].sel_dim))
+        {
+            if (group[v.plan] == no_slot) {
+                group[v.plan] = n;
+                n += 1;
+            }
+            group[u.plan] = group[v.plan];
+            plans[u.plan].owner = plans[v.plan].owner;
+            break;
+        };
+    };
+    const size = try a.alloc(u32, n);
+    defer a.free(size);
+    @memset(size, 0);
+    for (plans, group) |*p, g| if (g != no_slot) {
+        p.member = size[g];
+        size[g] += 1;
+    };
+    return .{ group, n };
+}
+
+fn maxLag(h: *const model.Heads) u32 {
+    var lag: u32 = 0;
+    for (h.taps) |t| for (1..model.lags) |k| {
+        if (t[k] != 0) lag = @max(lag, @as(u32, @intCast(k)));
+    };
+    return lag;
+}
+
+pub fn build(a: std.mem.Allocator, c: *const model.Circuit) !Flow {
+    const visible = try a.alloc(u32, c.dims);
+    @memset(visible, zero_slot);
+    var slots: u32 = 1;
+    var feature_dims: std.ArrayList(u32) = .empty;
+    var feature_slots: std.ArrayList(u32) = .empty;
+    for (c.features) |f| if (visible[f.dim] == zero_slot) {
+        visible[f.dim] = slots;
+        try feature_dims.append(a, f.dim);
+        try feature_slots.append(a, slots);
+        slots += 1;
+    };
+    var units: std.ArrayList(Unit) = .empty;
+    var plans: std.ArrayList(head.Plan) = .empty;
+    var ffn_plans: std.ArrayList(ffn.Plan) = .empty;
+    var ffn_totals: [3]u32 = @splat(0);
+    var max_dims: u32 = 0;
+    for (c.batches) |*b| switch (b.*) {
+        .ffn => |*whole| for (whole.split) |*f| {
+            const dims = if (f.dims.len > 0) f.dims else try reads(a, &.{ &f.up.forms, &f.gate.forms });
+            var u = try unit(a, .{ .ffn = f }, dims, f.outs, 0, visible, &slots);
+            u.plan = @intCast(ffn_plans.items.len);
+            u.quiet = try ffn.quiet(a, f);
+            try ffn_plans.append(a, try ffn.build(a, f, &ffn_totals));
+            try units.append(a, u);
+        },
+        .heads => |*hs| for (hs.split) |*h| {
+            var u = try unit(a, .{ .heads = h }, try reads(a, &.{&h.proj.forms}), h.outs, maxLag(h), visible, &slots);
+            u.plan = @intCast(plans.items.len);
+            var plan = try head.build(a, h, u.dims);
+            plan.owner = u.plan;
+            try plans.append(a, plan);
+            try units.append(a, u);
+        },
+    };
+    var total_ins: u32 = 0;
+    for (units.items) |*u| {
+        max_dims = @max(max_dims, @as(u32, @intCast(u.dims.len)));
+        u.in_off = total_ins;
+        total_ins += @intCast(u.dims.len);
+    }
+    const mark = try a.alloc(u32, slots);
+    defer a.free(mark);
+    const code = try a.alloc(u32, c.code_dims.len);
+    for (c.code_dims, code) |d, *s| s.* = visible[d];
+    const ch = try chains(a, units.items, slots, visible);
+    const plan_group, const groups = try selectionGroups(a, units.items, plans.items);
+    const ins_csr = try readersOf(a, units.items, slots, mark, .ins, ch);
+    const base_csr = try readersOf(a, units.items, slots, mark, .base, ch);
+    return .{
+        .slots = slots,
+        .units = units.items,
+        .plans = plans.items,
+        .ffn_plans = ffn_plans.items,
+        .ffn_totals = ffn_totals,
+        .feature_dims = feature_dims.items,
+        .feature_slots = feature_slots.items,
+        .reader_starts = ins_csr[0],
+        .readers = ins_csr[1],
+        .reader_local = ins_csr[2],
+        .reader_off = ins_csr[3],
+        .base_starts = base_csr[0],
+        .base_readers = base_csr[1],
+        .base_out = base_csr[2],
+        .base_first = base_csr[3],
+        .final = visible,
+        .code = code,
+        .max_dims = max_dims,
+        .total_ins = total_ins,
+        .plan_group = plan_group,
+        .groups = groups,
+        .slot_unit = ch.slot_unit,
+        .elided = ch.elided,
+        .chain_end = ch.end,
+        .chain_start = ch.start,
+        .chain_len = ch.len,
+        .chain_base = ch.base,
+        .chain_links = ch.links,
+        .chain_pos = ch.pos,
+        .chain_bits_at = ch.bits_at,
+        .chain_words = ch.words,
+    };
+}
+
+/// Reader edges by slot: units reading it as an input (deduplicated), or each output adding onto it (in-unit too).
+fn readersOf(a: std.mem.Allocator, units: []const Unit, slots: u32, mark: []u32, comptime field: enum { ins, base }, ch: Chains) !struct { []u32, []u32, []u32, []u32 } {
+    @memset(mark, no_slot);
+    var edge_slot: std.ArrayList(u32) = .empty;
+    var edge: [3]std.ArrayList(u32) = @splat(.empty);
+    for (units, 0..) |u, i| {
+        const first_out = if (u.outs.len > 0) u.outs[0] else slots;
+        for (if (field == .ins) u.ins else u.base, 0..) |s, j| {
+            if (s == zero_slot or s == no_slot) continue;
+            if (field == .ins and (s >= first_out or mark[s] == i)) continue;
+            mark[s] = @intCast(i);
+            if (field == .base and ch.elided[s]) continue;
+            var reader: u32 = @intCast(i);
+            var k: u32 = @intCast(j);
+            if (field == .base and ch.elided[u.outs[j]]) {
+                const end = ch.end[u.outs[j]];
+                reader = ch.slot_unit[end];
+                k = end - units[reader].outs[0];
+            }
+            try edge_slot.append(a, s);
+            try edge[0].append(a, reader);
+            try edge[1].append(a, k);
+            try edge[2].append(a, if (field == .ins) u.in_off else units[reader].outs[0]);
+        }
+    }
+    const starts = try a.alloc(u32, slots + 1);
+    @memset(starts, 0);
+    for (edge_slot.items) |s| starts[s + 1] += 1;
+    for (1..starts.len) |s| starts[s] += starts[s - 1];
+    var out: [3][]u32 = undefined;
+    for (&out) |*o| o.* = try a.alloc(u32, edge_slot.items.len);
+    const fill = try a.dupe(u32, starts[0..slots]);
+    defer a.free(fill);
+    for (edge_slot.items, 0..) |s, e| {
+        for (0..3) |k| out[k][fill[s]] = edge[k].items[e];
+        fill[s] += 1;
+    }
+    return .{ starts, out[0], out[1], out[2] };
+}
+
+const Chains = struct { slot_unit: []u32, elided: []bool, end: []u32, start: []u32, len: []u32, base: []u32, links: []u32, pos: []u32, bits_at: []u32, words: u32 };
+
+/// Into-chains: an output slot no unit reads and the step does not end on is elided; its chain end folds the links.
+fn chains(a: std.mem.Allocator, units: []const Unit, slots: u32, visible: []const u32) !Chains {
+    var ch: Chains = undefined;
+    ch.slot_unit = try a.alloc(u32, slots);
+    @memset(ch.slot_unit, no_slot);
+    const base = try a.alloc(u32, slots);
+    const next = try a.alloc(u32, slots);
+    const read = try a.alloc(bool, slots);
+    defer a.free(base);
+    defer a.free(next);
+    defer a.free(read);
+    @memset(base, no_slot);
+    @memset(next, no_slot);
+    @memset(read, false);
+    for (visible) |v| read[v] = true;
+    for (units, 0..) |u, i| {
+        for (u.ins) |sl| read[sl] = true;
+        for (u.outs, u.base) |o, b| {
+            ch.slot_unit[o] = @intCast(i);
+            base[o] = b;
+            if (b != no_slot) next[b] = o;
+        }
+    }
+    ch.elided = try a.alloc(bool, slots);
+    for (ch.elided, 0..) |*e, sl| e.* = ch.slot_unit[sl] != no_slot and !read[sl] and next[sl] != no_slot;
+    ch.end = try a.alloc(u32, slots);
+    ch.start = try a.alloc(u32, slots);
+    ch.len = try a.alloc(u32, slots);
+    @memset(ch.end, no_slot);
+    @memset(ch.len, 0);
+    @memset(ch.start, 0);
+    ch.base = try a.alloc(u32, slots);
+    @memset(ch.base, no_slot);
+    var links: std.ArrayList(u32) = .empty;
+    ch.pos = try a.alloc(u32, slots);
+    @memset(ch.pos, no_slot);
+    ch.bits_at = try a.alloc(u32, slots);
+    @memset(ch.bits_at, no_slot);
+    ch.words = 0;
+    for (0..slots) |sl| {
+        if (ch.slot_unit[sl] == no_slot or ch.elided[sl] or base[sl] == no_slot or !ch.elided[base[sl]]) continue;
+        var first: u32 = @intCast(sl);
+        while (base[first] != no_slot and ch.elided[base[first]]) first = base[first];
+        ch.start[sl] = @intCast(links.items.len);
+        var cur = first;
+        while (true) {
+            try links.append(a, cur);
+            if (cur == sl) break;
+            ch.end[cur] = @intCast(sl);
+            cur = next[cur];
+        }
+        ch.len[sl] = @intCast(links.items.len - ch.start[sl]);
+        ch.base[sl] = base[first];
+        for (links.items[ch.start[sl]..], 0..) |l, k| ch.pos[l] = @intCast(k);
+        ch.bits_at[sl] = ch.words;
+        ch.words += (ch.len[sl] + 63) / 64;
+    }
+    ch.links = links.items;
+    return ch;
+}
+
+fn unit(a: std.mem.Allocator, kind: @FieldType(Unit, "kind"), dims: []const u32, outs: []const model.Out, lag: u32, visible: []u32, slots: *u32) !Unit {
+    const ins = try a.alloc(u32, dims.len);
+    for (dims, ins) |d, *s| s.* = visible[d];
+    const out_slots = try a.alloc(u32, outs.len);
+    const base = try a.alloc(u32, outs.len);
+    for (outs, out_slots, base) |o, *s, *b| {
+        b.* = if (o.into) visible[o.dim] else no_slot;
+        s.* = slots.*;
+        visible[o.dim] = slots.*;
+        slots.* += 1;
+    }
+    return .{ .kind = kind, .dims = dims, .ins = ins, .outs = out_slots, .base = base, .lag = lag };
+}
diff --git a/zig/src/core/runner_circuit_golden_test.zig b/zig/src/core/runner_circuit_golden_test.zig
new file mode 100644
index 000000000..e9238a45c
--- /dev/null
+++ b/zig/src/core/runner_circuit_golden_test.zig
@@ -0,0 +1,240 @@
+//! T1 reference traces vs the CPU circuit: TF_RUNNER_CIRCUIT, _GOLDENS, optional _GOLDEN_LIMIT, _GOLDEN_SHARD=i/n.
+const std = @import("std");
+const rc = @import("runner_circuit.zig");
+
+const gpa = std.testing.allocator;
+
+const Checkpoint = struct { token_count: u64, prefix_sha256: []const u8 };
+const Case = struct {
+    id: []const u8,
+    kind: []const u8,
+    input: struct { bytes_hex: ?[]const u8 = null, elf: ?[]const u8 = null },
+    trace_token_count: u64,
+    generated_steps: u64,
+    token_offset_bytes: u64,
+    trace_sha256: []const u8,
+    final_output_hex: []const u8,
+    checkpoints: []const Checkpoint,
+};
+
+fn env(name: [:0]const u8) ?[]const u8 {
+    const v = std.c.getenv(name) orelse return null;
+    return std.mem.span(v);
+}
+
+fn readFile(dir: []const u8, name: []const u8) ![]u8 {
+    var threaded: std.Io.Threaded = .init_single_threaded;
+    const path = try std.fs.path.join(gpa, &.{ dir, name });
+    defer gpa.free(path);
+    return std.Io.Dir.cwd().readFileAlloc(threaded.io(), path, gpa, .limited(1 << 32));
+}
+
+fn hex(bytes: []const u8) [64]u8 {
+    var d: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(bytes, &d, .{});
+    return std.fmt.bytesToHex(d, .lower);
+}
+
+fn gunzip(bytes: []const u8) ![]u8 {
+    var in: std.Io.Reader = .fixed(bytes);
+    const window = try gpa.alloc(u8, std.compress.flate.max_window_len);
+    defer gpa.free(window);
+    var d: std.compress.flate.Decompress = .init(&in, .gzip, window);
+    return d.reader.allocRemaining(gpa, .unlimited);
+}
+
+/// Every data file's size and SHA-256 must match manifest.json before any row is trusted.
+fn checked(dir: []const u8, manifest: std.json.Value, name: []const u8) ![]u8 {
+    const bytes = try readFile(dir, name);
+    errdefer gpa.free(bytes);
+    const want = manifest.object.get("files").?.object.get(name) orelse return error.GoldenManifest;
+    if (want.object.get("bytes").?.integer != bytes.len) return error.GoldenManifest;
+    if (!std.mem.eql(u8, want.object.get("sha256").?.string, &hex(bytes))) return error.GoldenManifest;
+    return bytes;
+}
+
+test "golden: the CPU circuit reproduces every reference trace token, step count and output byte" {
+    const circuit_path = env("TF_RUNNER_CIRCUIT") orelse {
+        std.debug.print("skip golden: TF_RUNNER_CIRCUIT unset\n", .{});
+        return error.SkipZigTest;
+    };
+    const dir = env("TF_RUNNER_GOLDENS") orelse {
+        std.debug.print("skip golden: TF_RUNNER_GOLDENS unset\n", .{});
+        return error.SkipZigTest;
+    };
+    const limit = if (env("TF_RUNNER_GOLDEN_LIMIT")) |l| try std.fmt.parseInt(u64, l, 10) else std.math.maxInt(u64);
+    var shard: [2]u64 = .{ 0, 1 };
+    if (env("TF_RUNNER_GOLDEN_SHARD")) |sh| {
+        var parts = std.mem.splitScalar(u8, sh, '/');
+        shard[0] = try std.fmt.parseInt(u64, parts.first(), 10);
+        shard[1] = try std.fmt.parseInt(u64, parts.next() orelse return error.GoldenShard, 10);
+        if (shard[0] >= shard[1]) return error.GoldenShard;
+    }
+    var circuit = try rc.Circuit.load(gpa, circuit_path);
+    defer circuit.deinit(gpa);
+    const supplemental = if (env("TF_RUNNER_DROM_GOLDENS")) |value|
+        try gpa.dupe(u8, value)
+    else
+        try std.fmt.allocPrint(gpa, "{s}-drom", .{dir});
+    defer gpa.free(supplemental);
+    var totals: struct { cases: u64 = 0, steps: u64 = 0, ns: u64 = 0, skipped: u64 = 0 } = .{};
+    for ([_][]const u8{ dir, supplemental }, 0..) |corpus_dir, corpus_index| {
+        const is_drom = corpus_index == 1;
+        const manifest_bytes = try readFile(corpus_dir, "manifest.json");
+        defer gpa.free(manifest_bytes);
+        var manifest = try std.json.parseFromSlice(std.json.Value, gpa, manifest_bytes, .{});
+        defer manifest.deinit();
+        if (is_drom) {
+            const object = manifest.value.object;
+            try std.testing.expectEqualStrings("tensorfold-runner-drom-goldens-v1", object.get("format").?.string);
+            try std.testing.expectEqualStrings("bec1a0c9654ac8151b6f36ed0154a19c53141384", object.get("upstream_commit").?.string);
+            try std.testing.expectEqual(@as(i64, 1), object.get("case_count").?.integer);
+            try std.testing.expectEqual(@as(i64, 100000), object.get("step_budget").?.integer);
+        }
+        const cases_gz = try checked(corpus_dir, manifest.value, "cases.jsonl.gz");
+        defer gpa.free(cases_gz);
+        const tokens_gz = try checked(corpus_dir, manifest.value, "tokens.leu32.gz");
+        defer gpa.free(tokens_gz);
+        const lines = try gunzip(cases_gz);
+        defer gpa.free(lines);
+        const blob = try gunzip(tokens_gz);
+        defer gpa.free(blob);
+        var supplemental_seen: u64 = 0;
+        var it = std.mem.tokenizeScalar(u8, lines, '\n');
+        var calc_seen: u64 = 0;
+        var index: u64 = 0;
+        while (it.next()) |line| : (index += 1) {
+            if (!is_drom and index % shard[1] != shard[0]) continue;
+            var parsed = try std.json.parseFromSlice(Case, gpa, line, .{ .ignore_unknown_fields = true });
+            defer parsed.deinit();
+            const case = parsed.value;
+            const is_calc = std.mem.eql(u8, case.kind, "calc");
+            if (is_drom) {
+                try std.testing.expectEqualStrings("drom-byte-string", case.id);
+                try std.testing.expectEqualStrings("elf", case.kind);
+                try std.testing.expectEqualStrings("drom.elf", case.input.elf.?);
+                try std.testing.expect(case.generated_steps <= 100000);
+                supplemental_seen += 1;
+            }
+            if (is_calc and std.mem.startsWith(u8, case.id, "calc-")) {
+                calc_seen += 1;
+                if (calc_seen > limit) continue;
+            }
+            const want = blob[case.token_offset_bytes..][0 .. 4 * case.trace_token_count];
+            try std.testing.expectEqualStrings(case.trace_sha256, &hex(want));
+            var input: []u8 = undefined;
+            if (is_calc) {
+                const h = case.input.bytes_hex.?;
+                input = try gpa.alloc(u8, h.len / 2);
+                _ = try std.fmt.hexToBytes(input, h);
+                input = input[0 .. input.len - 1];
+            } else input = if (is_drom)
+                try checked(corpus_dir, manifest.value, case.input.elf.?)
+            else
+                try readFile(corpus_dir, case.input.elf.?);
+            defer gpa.free(input.ptr[0 .. input.len + @intFromBool(is_calc)]);
+            var m = rc.Machine.boot(gpa, &circuit, .{ .kind = if (is_calc) .calc else .elf, .bytes = input }) catch |e| {
+                if (is_drom or e != error.CircuitElfUnsupported) return e;
+                std.debug.print("golden {s}: skipped, ELF boot not built yet\n", .{case.id});
+                totals.skipped += 1;
+                continue;
+            };
+            defer m.deinit(gpa);
+            var out: std.ArrayList(u8) = .empty;
+            defer out.deinit(gpa);
+            var trace: std.ArrayList(u32) = .empty;
+            defer trace.deinit(gpa);
+            try trace.append(gpa, circuit.go);
+            var cancel: std.atomic.Value(bool) = .init(false);
+            const t0 = rc.nowNs();
+            const budget = if (is_drom) @min(case.generated_steps + 1, 100000) else case.generated_steps + 1;
+            const end = m.run(budget, &out, &trace, &cancel) catch |e| {
+                std.debug.print("golden {s}: {s} at step {d}\n", .{ case.id, @errorName(e), m.state.steps });
+                return e;
+            };
+            totals.ns += rc.nowNs() - t0;
+            for (trace.items, 0..) |t, i| {
+                if (i * 4 >= want.len) return error.GoldenTraceLonger;
+                const w = std.mem.readInt(u32, want[4 * i ..][0..4], .little);
+                if (t != w) {
+                    std.debug.print("golden {s}: token {d} is {d}, reference {d}\n", .{ case.id, i, t, w });
+                    return error.GoldenTokenMismatch;
+                }
+            }
+            try std.testing.expectEqual(case.trace_token_count, trace.items.len);
+            try std.testing.expectEqual(case.generated_steps, end.steps);
+            try std.testing.expect(end.end == .halted);
+            const want_out = try gpa.alloc(u8, case.final_output_hex.len / 2);
+            defer gpa.free(want_out);
+            _ = try std.fmt.hexToBytes(want_out, case.final_output_hex);
+            try std.testing.expectEqualStrings(want_out, out.items);
+            for (case.checkpoints) |cp| {
+                const prefix = std.mem.sliceAsBytes(trace.items[0..cp.token_count]);
+                try std.testing.expectEqualStrings(cp.prefix_sha256, &hex(prefix));
+            }
+            totals.cases += 1;
+            totals.steps += end.steps;
+        }
+        if (is_drom) try std.testing.expectEqual(@as(u64, 1), supplemental_seen);
+    }
+    const rate = if (totals.ns == 0) 0 else totals.steps * std.time.ns_per_s / totals.ns;
+    std.debug.print("golden: {d} cases token-exact, {d} steps, {d} steps/s, {d} skipped\n", .{ totals.cases, totals.steps, rate, totals.skipped });
+    try std.testing.expect(totals.cases > 0);
+}
+
+test "golden: booting the circuit's own program image as an ELF reproduces its exported snapshot" {
+    const circuit_path = env("TF_RUNNER_CIRCUIT") orelse {
+        std.debug.print("skip image boot: TF_RUNNER_CIRCUIT unset\n", .{});
+        return error.SkipZigTest;
+    };
+    var circuit = try rc.Circuit.load(gpa, circuit_path);
+    defer circuit.deinit(gpa);
+    var exported = try rc.State.init(gpa, &circuit);
+    defer exported.deinit();
+    var booted = try rc.State.init(gpa, &circuit);
+    defer booted.deinit();
+    try @import("runner_circuit_elf.zig").boot(&booted, circuit.program.image);
+    const want = try exported.canonical(gpa);
+    defer gpa.free(want);
+    const got = try booted.canonical(gpa);
+    defer gpa.free(got);
+    try std.testing.expectEqual(want.len, got.len);
+    if (std.mem.indexOfDiff(u8, want, got)) |at| {
+        const table = (at - 8) / (8 * 128 * 128);
+        const row = (at - 8) / (8 * 128) % 128;
+        std.debug.print("image boot differs in table {d} ({s}) row {d}\n", .{ table, circuit.table_names[table], row });
+        return error.ImageBootMismatch;
+    }
+}
+
+test "golden: on the real circuit, skipping unchanged units equals running every unit, token and snapshot" {
+    const circuit_path = env("TF_RUNNER_CIRCUIT") orelse {
+        std.debug.print("skip skip-equivalence: TF_RUNNER_CIRCUIT unset\n", .{});
+        return error.SkipZigTest;
+    };
+    var circuit = try rc.Circuit.load(gpa, circuit_path);
+    defer circuit.deinit(gpa);
+    if (circuit.program.kind != .calc) return error.SkipZigTest;
+    const expr = "123456789012345678901234567890*987654321098765432109876543210";
+    var lazy = try rc.Machine.boot(gpa, &circuit, .{ .kind = .calc, .bytes = expr });
+    defer lazy.deinit(gpa);
+    var full = try rc.Machine.boot(gpa, &circuit, .{ .kind = .calc, .bytes = expr });
+    defer full.deinit(gpa);
+    full.state.always = true;
+    var out: std.ArrayList(u8) = .empty;
+    defer out.deinit(gpa);
+    var cancel: std.atomic.Value(bool) = .init(false);
+    var steps: u64 = 0;
+    while (!lazy.halted and steps < 2400) : (steps += 1) {
+        _ = try lazy.run(1, &out, null, &cancel);
+        _ = try full.run(1, &out, null, &cancel);
+        try std.testing.expectEqual(full.next, lazy.next);
+        if (steps % 300 != 7 and !lazy.halted) continue;
+        const want = try full.snapshot(gpa);
+        defer gpa.free(want);
+        const got = try lazy.snapshot(gpa);
+        defer gpa.free(got);
+        try std.testing.expect(std.mem.eql(u8, want, got));
+    }
+    try std.testing.expect(lazy.halted);
+}
diff --git a/zig/src/core/runner_circuit_head.zig b/zig/src/core/runner_circuit_head.zig
new file mode 100644
index 000000000..a23d5fc55
--- /dev/null
+++ b/zig/src/core/runner_circuit_head.zig
@@ -0,0 +1,555 @@
+//! One head on the CPU: a run keeps its inputs as a frame and caches its selecting channels; v and z are lazy.
+const std = @import("std");
+const model = @import("runner_circuit_model.zig");
+const Memo = @import("runner_circuit_memo.zig").Memo;
+const State = @import("runner_circuit_state.zig").State;
+
+const Scalar = model.Scalar;
+const hd = model.hd;
+const none = std.math.maxInt(u32);
+
+/// A query or key channel with at most one nonzero tap: at step t its value is tap * p(t - lag), kept when positive.
+pub const Sel = struct { column: u32, at: u32, tap: Scalar, lag: u32 };
+
+pub const Plan = struct {
+    h: *const model.Heads,
+    /// The selecting columns (queries, keys, then each value head's decay and write gate) as shared forms.
+    sel: model.Shared,
+    /// Per unit input: whether a selecting form reads it (the memo key holds only these).
+    sel_dim: []const bool,
+    q: []const Sel,
+    k: []const Sel,
+    lags_q: u8,
+    lags_k: u8,
+    /// Per value head: its decay and write-gate select columns, or none.
+    a: []const u32,
+    beta: []const u32,
+    /// Every projection form as a row of (dim, weight), dims ascending: the order the scatter adds them in.
+    rows: model.Sparse,
+    /// Per output: its z value's index in zrep, or none; per value head, its distinct z columns zrep[zstart[j]..].
+    zcol: []const u32,
+    zrep: []const u32,
+    zstart: []const u32,
+    /// A query or key with several nonzero taps: selection is computed from the frames, not cached.
+    general: bool,
+    /// Queries and keys read only the running step: an empty selection then depends on nothing older.
+    lag0: bool = false,
+    /// The plan whose frames hold this head's inputs (the first head of its selection group), and its member index.
+    owner: u32 = none,
+    member: u32 = 0,
+
+    fn head(p: *const Plan) *const model.Head {
+        return &p.h.heads[0];
+    }
+};
+
+/// A run's inputs (nonzero dims ascending), stamped with step + 1; heads reading the same slots share one ring.
+pub const Frame = struct {
+    stamp: u64 = 0,
+    dims: std.ArrayList(u32) = .empty,
+    vals: std.ArrayList(Scalar) = .empty,
+
+    pub fn deinit(f: *Frame, gpa: std.mem.Allocator) void {
+        f.dims.deinit(gpa);
+        f.vals.deinit(gpa);
+    }
+};
+
+/// One head's selecting results of a run, stamped with step + 1.
+pub const Picks = struct {
+    stamp: u64 = 0,
+    words: std.ArrayList(u32) = .empty,
+
+    pub fn deinit(f: *Picks, gpa: std.mem.Allocator) void {
+        f.words.deinit(gpa);
+    }
+};
+
+/// A selection group's step key: its first member to run in a step looks it up once and names its generation.
+pub const Group = struct {
+    memo: Memo = .{},
+    stamp: u64 = 0,
+    hash: u64 = 0,
+    gen: u64 = 0,
+    next: u64 = 0,
+    /// Per memo slot, the members whose selection under that slot's generation is empty (bit = member index).
+    slot_gen: [memo_slots]u64 = @splat(0),
+    empty: [memo_slots]u64 = @splat(0),
+};
+
+const memo_slots = @import("runner_circuit_memo.zig").slots_per_unit;
+
+/// The last four runs cover steps t-3..t: a unit runs every step its lag window is open, else its inputs held.
+pub const frames_per_unit = 4;
+
+pub fn build(a: std.mem.Allocator, h: *const model.Heads, dims: []const u32) !Plan {
+    const hd0 = &h.heads[0];
+    var cols: std.ArrayList(u32) = .empty;
+    var general = false;
+    const q = try sels(a, h, hd0.q, &cols, &general);
+    const k = try sels(a, h, hd0.k, &cols, &general);
+    const av = try a.alloc(u32, hd0.value_heads.len);
+    const bv = try a.alloc(u32, hd0.value_heads.len);
+    for (hd0.value_heads, av, bv) |vh, *ai, *bi| {
+        ai.* = none;
+        bi.* = none;
+        if (vh.a) |c| {
+            ai.* = @intCast(cols.items.len);
+            try cols.append(a, c);
+        }
+        if (vh.beta) |c| {
+            bi.* = @intCast(cols.items.len);
+            try cols.append(a, c);
+        }
+    }
+    const forms = &h.proj.forms;
+    const remap = try a.alloc(u32, forms.outputs);
+    defer a.free(remap);
+    @memset(remap, none);
+    var n_forms: u32 = 0;
+    const sel_form = try a.alloc(u32, cols.items.len);
+    const sel_bias = try a.alloc(Scalar, cols.items.len);
+    for (cols.items, sel_form, sel_bias) |c, *f, *b| {
+        b.* = h.proj.bias[c];
+        const old = h.proj.form[c];
+        if (old == model.no_form) {
+            f.* = model.no_form;
+            continue;
+        }
+        if (remap[old] == none) {
+            remap[old] = n_forms;
+            n_forms += 1;
+        }
+        f.* = remap[old];
+    }
+    var src: std.ArrayList(u32) = .empty;
+    var dst: std.ArrayList(u32) = .empty;
+    var w: std.ArrayList(Scalar) = .empty;
+    var row_form: std.ArrayList(u32) = .empty;
+    var row_dim: std.ArrayList(u32) = .empty;
+    var row_w: std.ArrayList(Scalar) = .empty;
+    for (forms.used) |d| for (forms.starts[d]..forms.starts[d + 1]) |e| {
+        try row_form.append(a, forms.dst[e]);
+        try row_dim.append(a, d);
+        try row_w.append(a, forms.w[e]);
+        if (remap[forms.dst[e]] == none) continue;
+        try src.append(a, d);
+        try dst.append(a, remap[forms.dst[e]]);
+        try w.append(a, forms.w[e]);
+    };
+    const sel_forms = try model.sparse(a, forms.sources, n_forms, src.items, dst.items, w.items);
+    const sel_dim = try a.alloc(bool, dims.len);
+    for (dims, sel_dim) |d, *m| m.* = sel_forms.starts[d + 1] > sel_forms.starts[d];
+    var zcol: std.ArrayList(u32) = .empty;
+    var zrep: std.ArrayList(u32) = .empty;
+    const zstart = try a.alloc(u32, hd0.value_heads.len + 1);
+    for (hd0.value_heads, 0..) |vh, j| {
+        zstart[j] = @intCast(zrep.items.len);
+        for (vh.out_cols) |c| {
+            var col: u32 = none;
+            for (vh.z) |z| if (z.at == c) {
+                col = z.column;
+            };
+            try zcol.append(a, if (col == none) none else try distinct(a, h, &zrep, zstart[j], col));
+        }
+    }
+    zstart[hd0.value_heads.len] = @intCast(zrep.items.len);
+    return .{
+        .h = h,
+        .sel = .{ .forms = try sel_forms.densify(a), .form = sel_form, .bias = sel_bias },
+        .sel_dim = sel_dim,
+        .q = q,
+        .k = k,
+        .lags_q = lagMask(q),
+        .lags_k = lagMask(k),
+        .a = av,
+        .beta = bv,
+        .rows = try model.sparse(a, forms.outputs, forms.sources, row_form.items, row_dim.items, row_w.items),
+        .zcol = zcol.items,
+        .zrep = zrep.items,
+        .zstart = zstart,
+        .general = general,
+        .lag0 = !general and for (q) |x| {
+            if (x.lag != 0) break false;
+        } else for (k) |x| {
+            if (x.lag != 0) break false;
+        } else true,
+    };
+}
+
+/// The index of a column with the same form and bias as `col` among reps[from..], appending it when new.
+fn distinct(a: std.mem.Allocator, h: *const model.Heads, reps: *std.ArrayList(u32), from: u32, col: u32) !u32 {
+    for (reps.items[from..], from..) |r, i| {
+        if (h.proj.form[r] == h.proj.form[col] and @as(u32, @bitCast(h.proj.bias[r])) == @as(u32, @bitCast(h.proj.bias[col]))) return @intCast(i);
+    }
+    try reps.append(a, col);
+    return @intCast(reps.items.len - 1);
+}
+
+fn sels(a: std.mem.Allocator, h: *const model.Heads, picks: []const model.Pick, cols: *std.ArrayList(u32), general: *bool) ![]Sel {
+    const out = try a.alloc(Sel, picks.len);
+    for (picks, out) |p, *s| {
+        var taps: u32 = 0;
+        s.* = .{ .column = @intCast(cols.items.len), .at = p.at, .tap = 0, .lag = 0 };
+        for (h.taps[p.column], 0..) |t, lag| if (t != 0) {
+            taps += 1;
+            s.tap = t;
+            s.lag = @intCast(lag);
+        };
+        if (taps > 1) general.* = true;
+        try cols.append(a, p.column);
+    }
+    return out;
+}
+
+fn lagMask(list: []const Sel) u8 {
+    var m: u8 = 0;
+    for (list) |s| m |= @as(u8, 1) << @intCast(s.lag);
+    return m;
+}
+
+/// The run that holds step `step`'s inputs or picks: the latest run at or before it (null before the first step).
+fn frameAt(comptime T: type, frames: []const T, step: i64) ?*const T {
+    if (step < 0) return null;
+    var best: ?*const T = null;
+    for (frames) |*f| {
+        if (f.stamp == 0 or f.stamp - 1 > @as(u64, @intCast(step))) continue;
+        if (best == null or f.stamp > best.?.stamp) best = f;
+    }
+    return best;
+}
+
+fn oldest(comptime T: type, frames: []T) *T {
+    var o = &frames[0];
+    for (frames[1..]) |*f| if (f.stamp < o.stamp) {
+        o = f;
+    };
+    return o;
+}
+
+/// Dense inputs of step t-lag (lag 0 is the running step's own inputs in s.x).
+const Views = struct {
+    s: *State,
+    frames: []const Frame,
+    t: u64,
+    filled: [frames_per_unit]?*const Frame = @splat(null),
+
+    fn dense(v: *Views, lag: u32) ?[]const Scalar {
+        if (lag == 0) return v.s.x;
+        const f = frameAt(Frame, v.frames, @as(i64, @intCast(v.t)) - lag) orelse return null;
+        const x = v.s.past[lag - 1];
+        if (v.filled[lag] != f) {
+            if (v.filled[lag]) |old| for (old.dims.items) |d| {
+                x[d] = 0;
+            };
+            for (f.dims.items, f.vals.items) |d, val| x[d] = val;
+            v.filled[lag] = f;
+        }
+        return x;
+    }
+
+    fn clear(v: *Views) void {
+        for (1..frames_per_unit) |lag| if (v.filled[lag]) |f| for (f.dims.items) |d| {
+            v.s.past[lag - 1][d] = 0;
+        };
+        v.filled = @splat(null);
+    }
+
+    /// The projection of column `col` at step t-lag; zero before the first step, as the history starts.
+    fn proj(v: *Views, p: *const Plan, col: u32, lag: u32) Scalar {
+        const x = v.dense(lag) orelse return 0;
+        const f = p.h.proj.form[col];
+        const bias = p.h.proj.bias[col];
+        if (f == model.no_form) return bias;
+        var sum: Scalar = 0;
+        for (p.rows.starts[f]..p.rows.starts[f + 1]) |e| {
+            const xv = x[p.rows.dst[e]];
+            if (xv != 0) sum += xv * p.rows.w[e];
+        }
+        return bias + sum;
+    }
+
+    /// The conv output of channel `col` at step t, the taps over its last four projections.
+    fn conv(v: *Views, p: *const Plan, col: u32) Scalar {
+        const t = p.h.taps[col];
+        var pr: [model.lags]Scalar = @splat(0);
+        for (0..model.lags) |lag| if (t[lag] != 0) {
+            pr[lag] = v.proj(p, col, @intCast(lag));
+        };
+        return @max(t[0] * pr[0] + t[1] * pr[1] + t[2] * pr[2] + t[3] * pr[3], 0);
+    }
+};
+
+/// Selecting results of the running step: positive queries and keys at their taps, then each decay and write gate.
+fn select(s: *State, p: *const Plan, nz: []const u32) []const u32 {
+    const n_cols = p.sel.columns();
+    const vals = s.work[0..n_cols];
+    p.sel.eval(s.x, nz, s.work[n_cols..][0..p.sel.forms.outputs], vals);
+    const out = s.words[0..];
+    var n: usize = 0;
+    for ([_][]const Sel{ p.q, p.k }) |list| {
+        const count_at = n;
+        n += 1;
+        for (list, 0..) |q, i| {
+            if (p.general) break;
+            const v = q.tap * vals[q.column];
+            if (!(v > 0)) continue;
+            out[n] = @intCast(i);
+            out[n + 1] = @bitCast(v);
+            n += 2;
+        }
+        out[count_at] = @intCast((n - count_at - 1) / 2);
+    }
+    for (p.a, p.beta) |ai, bi| {
+        out[n] = if (ai == none) 0 else @bitCast(vals[ai]);
+        out[n + 1] = if (bi == none) @bitCast(@as(Scalar, 1)) else @bitCast(vals[bi]);
+        n += 2;
+    }
+    return out[0..n];
+}
+
+/// Indices of the positive channels of one list at step t, ascending, from the frames at their lags.
+fn positives(p: *const Plan, frames: []const Picks, t: u64, which: u1, out: []u32) usize {
+    const list = if (which == 0) p.q else p.k;
+    const mask = if (which == 0) p.lags_q else p.lags_k;
+    var n: usize = 0;
+    for (0..frames_per_unit) |lag| {
+        if (mask >> @intCast(lag) & 1 == 0) continue;
+        const f = frameAt(Picks, frames, @as(i64, @intCast(t)) - @as(i64, @intCast(lag))) orelse continue;
+        const w = f.words.items;
+        var at: usize = 0;
+        if (which == 1) at = 1 + 2 * w[0];
+        for (0..w[at]) |j| {
+            const i = w[at + 1 + 2 * j];
+            if (list[i].lag != lag) continue;
+            out[n] = i;
+            n += 1;
+        }
+    }
+    std.mem.sort(u32, out[0..n], {}, std.sort.asc(u32));
+    return n;
+}
+
+/// One head at step s.steps: the frame, selection, then per value head decay, write, read and its outputs.
+pub fn run(s: *State, plan: u32, unit: usize, nz: []const u32, local: []const u32) ![]const Scalar {
+    const p = &s.circuit.flow.plans[plan];
+    const t = s.steps;
+    const frames = s.frames[p.owner][0..];
+    const memo = &s.memos[unit];
+    const gi = s.circuit.flow.plan_group[plan];
+    const words = if (gi != none and !s.always) try grouped(s, p, &s.groups[gi], memo, nz, local) else blk: {
+        const n_key = selKey(s, p, nz, local);
+        const key = s.key[0..n_key];
+        const h = Memo.hash(key);
+        const hit = if (s.always or memo.off() or memo.cold()) null else memo.find(key, h);
+        if (hit) |w| break :blk w;
+        const w = select(s, p, s.nz2[0..n_key]);
+        if (!memo.off()) try memo.put(s.gpa, key, h, w);
+        break :blk w;
+    };
+    var newest: u64 = 0;
+    for (frames) |fr| newest = @max(newest, fr.stamp);
+    if (newest != t + 1) {
+        const in = oldest(Frame, frames);
+        in.stamp = 0;
+        in.dims.clearRetainingCapacity();
+        try in.dims.appendSlice(s.gpa, nz);
+        try in.vals.resize(s.gpa, nz.len);
+        for (nz, in.vals.items) |d, *v| v.* = s.x[d];
+        in.stamp = t + 1;
+    }
+    const picks = s.picks[plan][0..];
+    const f = oldest(Picks, picks);
+    f.stamp = 0;
+    f.words.clearRetainingCapacity();
+    try f.words.appendSlice(s.gpa, words);
+    f.stamp = t + 1;
+    var views: Views = .{ .s = s, .frames = frames, .t = t };
+    defer views.clear();
+    const hd0 = p.head();
+    var key_row: ?u32 = null;
+    var rows: [hd]u32 = undefined;
+    var n_rows: usize = 0;
+    if (p.general) {
+        for (p.k, hd0.k) |k, pk| if (views.conv(p, pk.column) > 0) {
+            if (key_row != null) return error.CircuitKeyNotOneHot;
+            key_row = k.at;
+        };
+        for (p.q, 0..) |q, i| if (views.conv(p, hd0.q[i].column) > 0) {
+            rows[n_rows] = q.at;
+            n_rows += 1;
+        };
+    } else {
+        var idx: [hd]u32 = undefined;
+        const nk = positives(p, picks, t, 1, &idx);
+        if (nk > 1) return error.CircuitKeyNotOneHot;
+        if (nk == 1) key_row = p.k[idx[0]].at;
+        n_rows = positives(p, picks, t, 0, &idx);
+        for (idx[0..n_rows], rows[0..n_rows]) |i, *r| r.* = p.q[i].at;
+    }
+    const gates = f.words.items[f.words.items.len - 2 * hd0.value_heads.len ..];
+    const values = s.work[0..p.h.outs.len];
+    const v = s.work[values.len..][0..hd];
+    const z_vals = s.work[values.len + hd ..];
+    s.unstable[unit] = false;
+    for (hd0.value_heads, 0..) |*vh, j| {
+        const sel_a: Scalar = @bitCast(gates[2 * j]);
+        if (p.a[j] != none and sel_a != model.keep_selector) {
+            try decay(s, vh.table, sel_a);
+            s.unstable[unit] = true;
+        }
+        if (key_row) |r| if (try writeEnabled(@bitCast(gates[2 * j + 1]))) {
+            @memset(v, 0);
+            for (vh.v) |pk| v[pk.at] = views.conv(p, pk.column);
+            try s.writeRow(vh.table, r, v);
+        };
+        const out = values[vh.out_first..][0..vh.out_cols.len];
+        const norm = try readNorm(s, vh.table, rows[0..n_rows]) orelse {
+            @memset(out, 0);
+            continue;
+        };
+        const zv = z_vals[0 .. p.zstart[j + 1] - p.zstart[j]];
+        for (zv, p.zrep[p.zstart[j]..p.zstart[j + 1]]) |*z, col| z.* = @max(views.proj(p, col, 0), 0);
+        for (vh.out_cols, vh.out_w, out, p.zcol[vh.out_first..][0..out.len]) |col, w, *y, zc| {
+            var o: Scalar = 0;
+            var any = false;
+            for (rows[0..n_rows]) |r| if (s.rowPresent(vh.table, r)) {
+                o = if (any) o + s.row(vh.table, r)[col] else 0 + s.row(vh.table, r)[col];
+                any = true;
+            };
+            const z: Scalar = if (zc == none) 0 else zv[zc - p.zstart[j]];
+            y.* = (o / norm) * z * w;
+        }
+    }
+    return values;
+}
+
+/// The memo key (input index, value bits) and dims of a run's nonzero selecting inputs, in s.key and s.nz2.
+fn selKey(s: *State, p: *const Plan, nz: []const u32, local: []const u32) usize {
+    var n: usize = 0;
+    for (nz, local) |d, j| if (p.sel_dim[j]) {
+        s.key[n] = @as(u64, j) << 32 | @as(u32, @bitCast(s.x[d]));
+        s.nz2[n] = d;
+        n += 1;
+    };
+    return n;
+}
+
+/// A grouped head's selection: a member keeps its words per group generation, so its hit is a one-word compare.
+fn grouped(s: *State, p: *const Plan, g: *Group, memo: *Memo, nz: []const u32, local: []const u32) ![]const u32 {
+    if (g.stamp != s.steps + 1) {
+        g.stamp = s.steps + 1;
+        g.gen = 0;
+        if (!(g.memo.off() or g.memo.cold())) {
+            const key = s.key[0..selKey(s, p, nz, local)];
+            g.hash = Memo.hash(key);
+            if (g.memo.find(key, g.hash)) |w| g.gen = @as(u64, w[1]) << 32 | w[0] else {
+                g.next += 1;
+                try g.memo.put(s.gpa, key, g.hash, &[_]u32{ @truncate(g.next), @intCast(g.next >> 32) });
+                g.gen = g.next;
+            }
+        }
+    }
+    const hit = if (g.gen != 0 and !memo.off()) memo.find(&[_]u64{g.gen}, g.hash) else null;
+    const w = hit orelse select(s, p, s.nz2[0..selKey(s, p, nz, local)]);
+    if (g.gen == 0) return w;
+    if (hit == null and !memo.off()) try memo.put(s.gpa, &[_]u64{g.gen}, g.hash, w);
+    if (p.member < 64 and emptyWords(p, w)) {
+        const slot = g.hash % memo_slots;
+        if (g.slot_gen[slot] != g.gen) {
+            g.slot_gen[slot] = g.gen;
+            g.empty[slot] = 0;
+        }
+        g.empty[slot] |= @as(u64, 1) << @intCast(p.member);
+    }
+    return w;
+}
+
+/// No query, no key and no decay: the run reads and writes nothing, and every output is +0.
+fn emptyWords(p: *const Plan, w: []const u32) bool {
+    if (w[0] != 0 or w[1] != 0) return false;
+    for (p.a, 0..) |ai, j| {
+        const sel_a: Scalar = @bitCast(w[2 + 2 * j]);
+        if (ai != none and sel_a != model.keep_selector) return false;
+    }
+    return true;
+}
+
+/// A grouped head skips a run that changes nothing: outputs all +0, no selection now or reaching now from older runs.
+pub fn skips(s: *State, plan: u32, unit: usize) !bool {
+    const p = &s.circuit.flow.plans[plan];
+    const gi = s.circuit.flow.plan_group[plan];
+    if (gi == none or s.always or p.member >= 64 or s.unstable[unit] or !s.rest[unit]) return false;
+    const g = &s.groups[gi];
+    if (g.stamp != s.steps + 1 or g.gen == 0 or g.slot_gen[g.hash % memo_slots] != g.gen) return false;
+    if (g.empty[g.hash % memo_slots] >> @intCast(p.member) & 1 == 0) return false;
+    if (p.lag0) return true;
+    // A lagged query or key reads an older run's picks: skip only if none reaches this step, and record empty picks.
+    const picks = s.picks[plan][0..];
+    var idx: [hd]u32 = undefined;
+    if (positives(p, picks, s.steps, 0, &idx) + positives(p, picks, s.steps, 1, &idx) > 0) return false;
+    const f = oldest(Picks, picks);
+    f.stamp = 0;
+    f.words.clearRetainingCapacity();
+    try f.words.appendSlice(s.gpa, &.{ 0, 0 });
+    f.stamp = s.steps + 1;
+    return true;
+}
+
+/// beta: absent is 1; 1 writes, an integer <= 0 does not, anything else breaks the circuit's exact range.
+fn writeEnabled(b: Scalar) !bool {
+    if (b == 1) return true;
+    if (b <= 0 and b == @round(b)) return false;
+    return error.CircuitWriteGate;
+}
+
+fn decay(s: *State, table: u32, selector: Scalar) !void {
+    if (!s.writable(table)) return error.CircuitTableReadOnly;
+    if (selector == model.halve_selector) {
+        var live = s.present[table];
+        while (live != 0) : (live &= live - 1) {
+            for (s.row(table, @ctz(live))) |*e| e.* *= 0.5;
+        }
+        return;
+    }
+    if (selector != model.clear_selector) return error.CircuitDecaySelector;
+    @memset(s.tables[table], 0);
+    s.present[table] = 0;
+}
+
+/// The ballast norm sqrt((o0^2 + o1^2) / hd) of the summed query rows; null when no row is present or it is zero.
+fn readNorm(s: *State, table: u32, rows: []const u32) !?Scalar {
+    var o: [2]Scalar = .{ 0, 0 };
+    var any = false;
+    for (rows) |r| if (s.rowPresent(table, r)) {
+        const row = s.row(table, r);
+        o = .{ o[0] + row[0], o[1] + row[1] };
+        any = true;
+    };
+    if (!any) return null;
+    const ref = o[0] * o[0] + o[1] * o[1];
+    if (ref == 0) {
+        for (0..hd) |c| {
+            var sum: Scalar = 0;
+            for (rows) |r| if (s.rowPresent(table, r)) {
+                sum += s.row(table, r)[c];
+            };
+            if (sum != 0) return error.CircuitReadBallast;
+        }
+        return null;
+    }
+    return @sqrt(ref / @as(Scalar, hd));
+}
+
+/// Canonical history of this head's channels at step `t`: projections of steps t-1, t-2, t-3, newest first.
+pub fn history(s: *State, plan: u32, out: []u8, at: *usize) void {
+    const p = &s.circuit.flow.plans[plan];
+    var views: Views = .{ .s = s, .frames = s.frames[p.owner][0..], .t = s.steps };
+    defer views.clear();
+    for (0..p.h.channels) |c| for (1..model.lags) |lag| {
+        const v: Scalar = if (views.dense(@intCast(lag)) == null) 0 else views.proj(p, @intCast(c), @intCast(lag));
+        const w: f64 = v;
+        std.mem.writeInt(u64, out[at.*..][0..8], @bitCast(w + 0), .little);
+        at.* += 8;
+    };
+}
diff --git a/zig/src/core/runner_circuit_load.zig b/zig/src/core/runner_circuit_load.zig
new file mode 100644
index 000000000..842edb1ba
--- /dev/null
+++ b/zig/src/core/runner_circuit_load.zig
@@ -0,0 +1,467 @@
+//! Reads a TFIMR001 circuit container (CIRCUIT-FORMAT.md v1) into batched, hazard-checked runtime form.
+const std = @import("std");
+const model = @import("runner_circuit_model.zig");
+
+const Scalar = model.Scalar;
+const hd = model.hd;
+const header_bytes = 64;
+
+const Term = struct { u32, f64 };
+const Expr = []const Term;
+const Chan = struct { expr: Expr, taps: [model.lags]f64 };
+const ChanAt = struct { u32, Chan };
+const ExprAt = struct { u32, Expr };
+const OutAt = struct { u32, u32, f64 };
+const InitRow = struct { u32, []const Term };
+const JValueHead = struct { v: []const ChanAt, a: Expr, beta: ?Expr, z: []const ExprAt, out: []const OutAt, into: bool, init: []const InitRow };
+const JNode = struct {
+    kind: []const u8,
+    name: []const u8 = "",
+    out: ?u32 = null,
+    into: ?bool = null,
+    terms: ?[]const struct { f64, Expr, Expr } = null,
+    n_cols: ?u32 = null,
+    levels: ?[]const u8 = null,
+    q: ?[]const ChanAt = null,
+    k: ?[]const ChanAt = null,
+    value_heads: ?[]const JValueHead = null,
+};
+const JFeature = struct { dim: u32, kind: []const u8, family: ?u32 = null, bit: ?u32 = null, digit: ?u32 = null, qs_family: ?u32 = null, qd_family: ?u32 = null, family_bits: ?u32 = null, amplitude: ?f64 = null };
+const JFamily = struct { name: []const u8, base: u32, size: u32 };
+const Doc = struct {
+    format: []const u8,
+    version: u32,
+    stats: struct { dims: u32 },
+    constants: struct { one_dim: u32, head_dim: u32, a_ref: f64, a_bit: f64, ref_cols: [2]u32 },
+    dims: []const struct { name: []const u8 },
+    features: []const JFeature,
+    nodes: []const JNode,
+    tokens: struct { vocab: u32, families: []const JFamily, go: u32, halt: u32, byte_family: u32 },
+    output: struct { family_bits: u32, payload_bits: u32, code_dims: []const u32, families: []const JFamily },
+    program: struct { kind: []const u8, input_address: u32, input_capacity: u32, entry: u32, rom_le_hex: []const u8, drom_hex: []const u8, ram_hex: []const u8 },
+};
+
+/// The checked JSON payload of a container: magic, version, sizes, flags and SHA-256 all as the format requires.
+pub fn payload(bytes: []const u8) !struct { []const u8, [32]u8 } {
+    if (bytes.len < header_bytes) return error.CircuitTruncated;
+    if (!std.mem.eql(u8, bytes[0..8], "TFIMR001")) return error.CircuitMagic;
+    const r = std.mem.readInt;
+    if (r(u32, bytes[8..12], .little) != 1 or r(u32, bytes[12..16], .little) != header_bytes) return error.CircuitVersion;
+    if (r(u32, bytes[24..28], .little) != 0 or r(u32, bytes[28..32], .little) != 0) return error.CircuitFlags;
+    if (r(u64, bytes[16..24], .little) != bytes.len - header_bytes) return error.CircuitTruncated;
+    const body = bytes[header_bytes..];
+    var digest: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(body, &digest, .{});
+    if (!std.mem.eql(u8, &digest, bytes[32..64])) return error.CircuitChecksum;
+    return .{ body, digest };
+}
+
+/// Reads a container file; at most 1 GiB.
+pub fn fromPath(gpa: std.mem.Allocator, path: []const u8) !model.Circuit {
+    var threaded: std.Io.Threaded = .init_single_threaded;
+    const io = threaded.io();
+    const bytes = try std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 30));
+    defer gpa.free(bytes);
+    return fromBytes(gpa, bytes);
+}
+
+/// Parses and compiles a whole container; the circuit owns everything through its arena.
+pub fn fromBytes(gpa: std.mem.Allocator, bytes: []const u8) !model.Circuit {
+    const body, const digest = try payload(bytes);
+    var parse_arena = std.heap.ArenaAllocator.init(gpa);
+    defer parse_arena.deinit();
+    const doc = std.json.parseFromSliceLeaky(Doc, parse_arena.allocator(), body, .{ .ignore_unknown_fields = true }) catch
+        return error.CircuitJson;
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    errdefer arena.deinit();
+    var c = try compile(arena.allocator(), parse_arena.allocator(), &doc);
+    c.payload_sha256 = digest;
+    c.arena = arena;
+    return c;
+}
+
+fn exact(v: f64) !Scalar {
+    if (!std.math.isFinite(v)) return error.CircuitNumber;
+    const s: Scalar = @floatCast(v);
+    if (@as(f64, s) != v) return error.CircuitNotExact;
+    return s;
+}
+
+fn compile(a: std.mem.Allocator, tmp: std.mem.Allocator, doc: *const Doc) !model.Circuit {
+    if (!std.mem.eql(u8, doc.format, "tensorfold.runner.p2") or doc.version != 1) return error.CircuitVersion;
+    const dims: u32 = @intCast(doc.dims.len);
+    const k = doc.constants;
+    if (dims == 0 or dims != doc.stats.dims or k.one_dim != 0 or k.head_dim != hd) return error.CircuitDims;
+    if (k.ref_cols[0] != 0 or k.ref_cols[1] != 1) return error.CircuitDims;
+    const families = try a.alloc(model.Family, doc.tokens.families.len);
+    var end: u32 = 0;
+    for (doc.tokens.families, doc.output.families, families) |f, g, *out| {
+        if (f.base != end or f.size == 0 or f.size > 1 << 16 or f.base != g.base or f.size != g.size) return error.CircuitFamilies;
+        out.* = .{ .base = f.base, .size = f.size };
+        end += f.size;
+    }
+    if (doc.tokens.families.len != doc.output.families.len or end != doc.tokens.vocab) return error.CircuitFamilies;
+    const o = doc.output;
+    if (o.family_bits == 0 or o.family_bits > 16 or o.payload_bits != 16 or o.code_dims.len != o.family_bits + 16) return error.CircuitOutputCode;
+    if (@as(usize, 1) << @intCast(o.family_bits) < families.len) return error.CircuitOutputCode;
+    for (o.code_dims) |d| if (d >= dims) return error.CircuitIndex;
+    if (doc.tokens.go >= end or doc.tokens.halt >= end or doc.tokens.byte_family >= families.len) return error.CircuitTokens;
+    var b: Builder = .{ .a = a, .tmp = tmp, .dims = dims };
+    for (doc.nodes) |*n| try b.node(n);
+    try b.flush();
+    var c: model.Circuit = .{
+        .dims = dims,
+        .batches = b.batches.items,
+        .features = try features(a, doc, dims, @intCast(families.len)),
+        .families = families,
+        .family_bits = o.family_bits,
+        .code_dims = try a.dupe(u32, o.code_dims),
+        .go = doc.tokens.go,
+        .halt = doc.tokens.halt,
+        .byte_family = doc.tokens.byte_family,
+        .fault_family = for (doc.tokens.families, 0..) |f, i| {
+            if (std.mem.eql(u8, f.name, "FLT")) break @intCast(i);
+        } else null,
+        .tables = b.tables.items,
+        .table_names = b.names.items,
+        .channels = b.channels,
+        .nodes = @intCast(doc.nodes.len),
+        .program = try program(a, doc, b.names.items, b.tables.items),
+        .flow = undefined,
+        .payload_sha256 = undefined,
+        .arena = undefined,
+    };
+    try @import("runner_circuit_parts.zig").prepare(a, &c);
+    return c;
+}
+
+fn features(a: std.mem.Allocator, doc: *const Doc, dims: u32, n_families: u32) ![]model.Feature {
+    const out = try a.alloc(model.Feature, doc.features.len);
+    for (doc.features, out) |f, *g| {
+        if (f.dim == 0 or f.dim >= dims) return error.CircuitFeatures;
+        const kind = std.meta.stringToEnum(model.Feature.Kind, f.kind) orelse return error.CircuitFeatures;
+        g.* = .{ .dim = f.dim, .kind = kind };
+        switch (kind) {
+            .family, .payload_bit => {
+                g.family = f.family orelse return error.CircuitFeatures;
+                if (kind == .payload_bit) g.bit = f.bit orelse return error.CircuitFeatures;
+                if (g.family >= n_families or g.bit >= 16) return error.CircuitFeatures;
+            },
+            .next_digit => {
+                g.digit = f.digit orelse return error.CircuitFeatures;
+                g.family = f.qs_family orelse return error.CircuitFeatures;
+                g.qd_family = f.qd_family orelse return error.CircuitFeatures;
+                if (g.digit >= 8 or g.family >= n_families or g.qd_family >= n_families) return error.CircuitFeatures;
+            },
+            .code_bit => {
+                g.bit = f.bit orelse return error.CircuitFeatures;
+                g.amplitude = try exact(f.amplitude orelse return error.CircuitFeatures);
+                if (f.family_bits != doc.output.family_bits or g.bit >= doc.output.family_bits + 16) return error.CircuitFeatures;
+            },
+        }
+    }
+    return out;
+}
+
+fn unhex(a: std.mem.Allocator, text: []const u8, len: usize) ![]u8 {
+    if (text.len % 2 != 0 or text.len / 2 > len) return error.CircuitProgram;
+    const out = try a.alloc(u8, len);
+    @memset(out, 0);
+    _ = std.fmt.hexToBytes(out[0 .. text.len / 2], text) catch return error.CircuitProgram;
+    return out;
+}
+
+fn program(a: std.mem.Allocator, doc: *const Doc, names: []const []const u8, tables: []const model.Table) !model.Program {
+    const p = doc.program;
+    const rom_bytes = try unhex(a, p.rom_le_hex, 4 << 16);
+    if (p.rom_le_hex.len != 2 * rom_bytes.len or p.ram_hex.len != 2 * (4 << 13)) return error.CircuitProgram;
+    const rom = try a.alloc(u32, 1 << 16);
+    for (rom, 0..) |*w, i| w.* = std.mem.readInt(u32, rom_bytes[4 * i ..][0..4], .little);
+    a.free(rom_bytes);
+    var out: model.Program = .{
+        .kind = if (std.mem.eql(u8, p.kind, "calc")) .calc else if (std.mem.eql(u8, p.kind, "elf")) .elf else return error.CircuitProgram,
+        .input_address = p.input_address,
+        .input_capacity = p.input_capacity,
+        .ram_tables = @splat(std.math.maxInt(u32)),
+        .a_ref = try exact(doc.constants.a_ref),
+        .a_bit = try exact(doc.constants.a_bit),
+        .image = .{ .rom = rom, .drom = try unhex(a, p.drom_hex, 4 << 15), .ram = try unhex(a, p.ram_hex, 4 << 13), .entry = p.entry },
+    };
+    for (names, 0..) |name, t| {
+        if (!std.mem.startsWith(u8, name, "ram")) continue;
+        const h = std.fmt.parseInt(u5, name[3..], 10) catch continue;
+        if (out.ram_tables[h] == std.math.maxInt(u32)) out.ram_tables[h] = @intCast(t);
+    }
+    for (out.ram_tables) |t| {
+        if (t == std.math.maxInt(u32)) continue;
+        if (t + 1 >= tables.len or !tables[t].writable or !tables[t + 1].writable) return error.CircuitProgram;
+    }
+    return out;
+}
+
+/// Accumulates nodes into batches: a batch ends at a kind change or at a read of a dim the batch already wrote.
+const Builder = struct {
+    a: std.mem.Allocator,
+    tmp: std.mem.Allocator,
+    dims: u32,
+    batches: std.ArrayList(model.Batch) = .empty,
+    tables: std.ArrayList(model.Table) = .empty,
+    names: std.ArrayList([]const u8) = .empty,
+    channels: u32 = 0,
+    pending: std.ArrayList(*const JNode) = .empty,
+    pending_heads: bool = false,
+    written: std.DynamicBitSetUnmanaged = .{},
+
+    fn node(b: *Builder, n: *const JNode) !void {
+        if (b.written.bit_length == 0) b.written = try .initEmpty(b.tmp, b.dims);
+        const is_head = std.mem.eql(u8, n.kind, "head");
+        if (!is_head and !std.mem.eql(u8, n.kind, "ffn")) return error.CircuitNodeKind;
+        var reads: std.ArrayList(u32) = .empty;
+        var writes: std.ArrayList(u32) = .empty;
+        if (is_head) try headDims(b, n, &reads, &writes) else try ffnDims(b, n, &reads, &writes);
+        var hazard = b.pending.items.len > 0 and is_head != b.pending_heads;
+        for (reads.items) |d| hazard = hazard or b.written.isSet(d);
+        if (hazard) try b.flush();
+        b.pending_heads = is_head;
+        try b.pending.append(b.tmp, n);
+        for (writes.items) |d| b.written.set(d);
+    }
+
+    fn check(b: *Builder, e: Expr, reads: *std.ArrayList(u32)) !void {
+        for (e, 0..) |t, i| {
+            if (t[0] >= b.dims) return error.CircuitIndex;
+            for (e[0..i]) |u| if (u[0] == t[0]) return error.CircuitDuplicateDim;
+            _ = try exact(t[1]);
+            try reads.append(b.tmp, t[0]);
+        }
+    }
+
+    fn ffnDims(b: *Builder, n: *const JNode, reads: *std.ArrayList(u32), writes: *std.ArrayList(u32)) !void {
+        const out = n.out orelse return error.CircuitNode;
+        if (out == 0 or out >= b.dims or n.into == null) return error.CircuitIndex;
+        for (n.terms orelse return error.CircuitNode) |t| {
+            _ = try exact(t[0]);
+            try b.check(t[1], reads);
+            try b.check(t[2], reads);
+        }
+        try writes.append(b.tmp, out);
+    }
+
+    fn headDims(b: *Builder, n: *const JNode, reads: *std.ArrayList(u32), writes: *std.ArrayList(u32)) !void {
+        if (n.n_cols != hd) return error.CircuitHeadShape;
+        for ([_]?[]const ChanAt{ n.q, n.k }) |chans| for (chans orelse return error.CircuitNode) |ch| try b.channel(ch, reads);
+        for (n.value_heads orelse return error.CircuitNode) |*vh| {
+            const own = writes.items.len;
+            var mine: std.ArrayList(u32) = .empty;
+            for (vh.v) |ch| try b.channel(ch, &mine);
+            try b.check(vh.a, &mine);
+            if (vh.beta) |e| try b.check(e, &mine);
+            for (vh.z) |z| {
+                if (z[0] >= hd) return error.CircuitIndex;
+                try b.check(z[1], &mine);
+            }
+            for (mine.items) |d| for (writes.items[0..own]) |w| if (d == w) return error.CircuitHazard;
+            try reads.appendSlice(b.tmp, mine.items);
+            for (vh.out) |t| {
+                if (t[0] >= hd or t[1] == 0 or t[1] >= b.dims) return error.CircuitIndex;
+                _ = try exact(t[2]);
+                try writes.append(b.tmp, t[1]);
+            }
+        }
+    }
+
+    fn channel(b: *Builder, ch: ChanAt, reads: *std.ArrayList(u32)) !void {
+        if (ch[0] >= hd) return error.CircuitIndex;
+        try b.check(ch[1].expr, reads);
+        for (ch[1].taps) |t| _ = try exact(t);
+    }
+
+    fn flush(b: *Builder) !void {
+        if (b.pending.items.len == 0) return;
+        const batch: model.Batch = if (b.pending_heads) .{ .heads = try b.headBatch() } else .{ .ffn = try b.ffnBatch(b.pending.items) };
+        try b.batches.append(b.a, batch);
+        b.pending.clearRetainingCapacity();
+        b.written.unsetAll();
+    }
+
+    fn ffnBatch(b: *Builder, nodes: []const *const JNode) !model.Ffn {
+        var up: FormSet = .{};
+        var gate: FormSet = .{};
+        var coef: std.ArrayList(Scalar) = .empty;
+        var slot: std.ArrayList(u32) = .empty;
+        const outs = try b.a.alloc(model.Out, nodes.len);
+        for (nodes, outs, 0..) |n, *out, s| {
+            out.* = .{ .dim = n.out.?, .into = n.into.? };
+            for (n.terms.?) |t| {
+                try coef.append(b.a, try exact(t[0]));
+                try slot.append(b.a, @intCast(s));
+                try up.add(b, t[1]);
+                try gate.add(b, t[2]);
+            }
+        }
+        const g = try gate.finish(b);
+        const starts = try b.a.alloc(u32, gate.forms + 1);
+        @memset(starts, 0);
+        var always: std.ArrayList(u32) = .empty;
+        for (g.form, g.bias, 0..) |f, c, t| {
+            if (f != model.no_form) starts[f + 1] += 1 else if (c > 0) try always.append(b.a, @intCast(t));
+        }
+        for (1..starts.len) |i| starts[i] += starts[i - 1];
+        const order = try b.a.alloc(u32, starts[gate.forms]);
+        const fill = try b.tmp.dupe(u32, starts[0..gate.forms]);
+        for (g.form, 0..) |f, t| if (f != model.no_form) {
+            order[fill[f]] = @intCast(t);
+            fill[f] += 1;
+        };
+        for (0..gate.forms) |f| std.mem.sort(u32, order[starts[f]..starts[f + 1]], g.bias, struct {
+            fn gt(bias: []const Scalar, x: u32, y: u32) bool {
+                return bias[x] > bias[y] or (bias[x] == bias[y] and x < y);
+            }
+        }.gt);
+        return .{ .terms = @intCast(coef.items.len), .up = try up.finish(b), .gate = g, .coef = coef.items, .slot = slot.items, .outs = outs, .order = order, .starts = starts, .always = always.items };
+    }
+
+    /// The batch as one Heads (shared forms, device layout); CPU per-head parts come from runner_circuit_parts.
+    fn headBatch(b: *Builder) !model.Heads {
+        const whole = try b.headsOf(b.pending.items, b.channels, @intCast(b.tables.items.len));
+        b.channels += whole.channels;
+        return whole;
+    }
+
+    fn headsOf(b: *Builder, nodes: []const *const JNode, first_channel: u32, first_table: u32) !model.Heads {
+        var cols: FormSet = .{};
+        var taps: std.ArrayList([model.lags]Scalar) = .empty;
+        for (nodes) |n| {
+            for ([_][]const ChanAt{ n.q.?, n.k.? }) |chans| for (chans) |ch| try b.addChannel(&cols, &taps, ch[1]);
+            for (n.value_heads.?) |vh| for (vh.v) |ch| try b.addChannel(&cols, &taps, ch[1]);
+        }
+        const channels: u32 = @intCast(taps.items.len);
+        var column = channels;
+        var chan: u32 = 0;
+        var table = first_table;
+        var outs: std.ArrayList(model.Out) = .empty;
+        const heads = try b.a.alloc(model.Head, nodes.len);
+        for (nodes, heads) |n, *h| {
+            const q = try b.picks(n.q.?, &chan);
+            const kk = try b.picks(n.k.?, &chan);
+            const vhs = try b.a.alloc(model.ValueHead, n.value_heads.?.len);
+            for (n.value_heads.?, vhs) |*jv, *vh| {
+                try b.tables.append(b.a, try initTable(b.a, jv, kk.len > 0 or jv.a.len > 0));
+                try b.names.append(b.a, try b.a.dupe(u8, n.name));
+                vh.* = .{ .table = table, .v = try b.picks(jv.v, &chan), .a = null, .beta = null, .z = &.{}, .out_first = @intCast(outs.items.len), .out_cols = &.{}, .out_w = &.{} };
+                table += 1;
+                if (jv.a.len > 0) vh.a = try plain(b, &cols, jv.a, &column);
+                if (jv.beta) |e| vh.beta = try plain(b, &cols, e, &column);
+                const z = try b.a.alloc(model.Pick, jv.z.len);
+                for (jv.z, z) |e, *p| p.* = .{ .at = e[0], .column = try plain(b, &cols, e[1], &column) };
+                vh.z = z;
+                const out_cols = try b.a.alloc(u32, jv.out.len);
+                const ws = try b.a.alloc(Scalar, jv.out.len);
+                for (jv.out, out_cols, ws) |t, *c, *x| {
+                    c.* = t[0];
+                    x.* = try exact(t[2]);
+                    try outs.append(b.a, .{ .dim = t[1], .into = jv.into });
+                }
+                vh.out_cols = out_cols;
+                vh.out_w = ws;
+            }
+            h.* = .{ .q = q, .k = kk, .value_heads = vhs };
+        }
+        return .{
+            .proj = try cols.finish(b),
+            .channels = channels,
+            .first_channel = first_channel,
+            .taps = taps.items,
+            .heads = heads,
+            .outs = outs.items,
+        };
+    }
+
+    fn addChannel(b: *Builder, cols: *FormSet, taps: *std.ArrayList([model.lags]Scalar), ch: Chan) !void {
+        try cols.add(b, ch.expr);
+        var t: [model.lags]Scalar = undefined;
+        for (&t, ch.taps) |*x, v| x.* = try exact(v);
+        try taps.append(b.a, t);
+    }
+
+    fn picks(b: *Builder, chans: []const ChanAt, next: *u32) ![]model.Pick {
+        const out = try b.a.alloc(model.Pick, chans.len);
+        for (chans, out, 0..) |ch, *p, i| {
+            for (chans[0..i]) |prev| if (prev[0] == ch[0]) return error.CircuitDuplicateChannel;
+            p.* = .{ .at = ch[0], .column = next.* };
+            next.* += 1;
+        }
+        return out;
+    }
+};
+
+fn plain(b: *Builder, cols: *FormSet, e: Expr, column: *u32) !u32 {
+    try cols.add(b, e);
+    column.* += 1;
+    return column.* - 1;
+}
+
+/// Columns as distinct linear forms (keyed by their sorted non-constant terms) plus each column's constant.
+const FormSet = struct {
+    keys: std.StringHashMapUnmanaged(u32) = .empty,
+    src: std.ArrayList(u32) = .empty,
+    dst: std.ArrayList(u32) = .empty,
+    w: std.ArrayList(Scalar) = .empty,
+    form: std.ArrayList(u32) = .empty,
+    bias: std.ArrayList(Scalar) = .empty,
+    forms: u32 = 0,
+
+    fn add(fs: *FormSet, b: *Builder, e: Expr) !void {
+        const terms = try b.tmp.dupe(Term, e);
+        std.mem.sort(Term, terms, {}, struct {
+            fn lt(_: void, x: Term, y: Term) bool {
+                return x[0] < y[0];
+            }
+        }.lt);
+        var key: std.ArrayList(u8) = .empty;
+        var bias: Scalar = 0;
+        for (terms) |t| {
+            const w = try exact(t[1]);
+            if (t[0] == 0) {
+                bias += w;
+                continue;
+            }
+            try key.appendSlice(b.tmp, std.mem.asBytes(&t[0]));
+            try key.appendSlice(b.tmp, std.mem.asBytes(&w));
+        }
+        try fs.bias.append(b.a, bias);
+        if (key.items.len == 0) return fs.form.append(b.a, model.no_form);
+        const got = try fs.keys.getOrPut(b.tmp, key.items);
+        if (!got.found_existing) {
+            got.value_ptr.* = fs.forms;
+            for (terms) |t| if (t[0] != 0) {
+                try fs.src.append(b.tmp, t[0]);
+                try fs.dst.append(b.tmp, fs.forms);
+                try fs.w.append(b.tmp, try exact(t[1]));
+            };
+            fs.forms += 1;
+        }
+        try fs.form.append(b.a, got.value_ptr.*);
+    }
+
+    fn finish(fs: *FormSet, b: *Builder) !model.Shared {
+        return .{ .forms = try model.sparse(b.a, b.dims, fs.forms, fs.src.items, fs.dst.items, fs.w.items), .form = fs.form.items, .bias = fs.bias.items };
+    }
+};
+
+fn initTable(a: std.mem.Allocator, vh: *const JValueHead, writable: bool) !model.Table {
+    const rows = try a.alloc(Scalar, hd * hd);
+    @memset(rows, 0);
+    var present: u128 = 0;
+    for (vh.init) |r| {
+        if (r[0] >= hd) return error.CircuitIndex;
+        const bit = @as(u128, 1) << @intCast(r[0]);
+        if (present & bit != 0) return error.CircuitDuplicateRow;
+        present |= bit;
+        for (r[1]) |cv| {
+            if (cv[0] >= hd) return error.CircuitIndex;
+            rows[r[0] * hd + cv[0]] = try exact(cv[1]);
+        }
+    }
+    return .{ .present = present, .rows = rows, .writable = writable };
+}
