+//! A unit's results by exact input: a hit returns the words a pure computation produced from the same key before.
+const std = @import("std");
+
+pub const slots_per_unit = 256;
+/// Misses before a unit stores anything: a short-lived machine's one-off runs never pay for slots and copies.
+pub const admit = 4;
+
+/// One entry: its hash beside one block holding the key, then the words (two per u64), so a hit reads two lines.
+const Slot = struct {
+    hash: u64 = 0,
+    data: [*]u64 = undefined,
+    cap: u32 = 0,
+    key_len: u32 = 0,
+    words_len: u32 = 0,
+    used: bool = false,
+};
+
+/// Direct-mapped by key hash; a colliding put replaces the older entry, so a lookup only ever misses, never lies.
+pub const Memo = struct {
+    slots: []Slot = &.{},
+    hits: u64 = 0,
+    misses: u64 = 0,
+
+    pub fn deinit(m: *Memo, gpa: std.mem.Allocator) void {
+        for (m.slots) |e| if (e.cap > 0) gpa.free(e.data[0..e.cap]);
+        gpa.free(m.slots);
+        m.* = .{};
+    }
+
+    /// A unit that almost never repeats an input stops paying for lookups and copies; results are the same.
+    pub fn off(m: *const Memo) bool {
+        return m.misses >= 256 and m.hits * 32 < m.misses;
+    }
+
+    /// Counts a run that skips the lookup while the unit has missed fewer than `admit` times.
+    pub fn cold(m: *Memo) bool {
+        if (m.misses >= admit) return false;
+        m.misses += 1;
+        return true;
+    }
+
+    pub fn hash(key: []const u64) u64 {
+        return std.hash.Wyhash.hash(0, std.mem.sliceAsBytes(key));
+    }
+
+    pub fn find(m: *Memo, key: []const u64, h: u64) ?[]const u32 {
+        if (m.slots.len == 0) {
+            m.misses += 1;
+            return null;
+        }
+        const e = &m.slots[h % m.slots.len];
+        if (!e.used or e.hash != h or e.key_len != key.len or !std.mem.eql(u64, e.data[0..key.len], key)) {
+            m.misses += 1;
+            return null;
+        }
+        m.hits += 1;
+        const words: [*]const u32 = @ptrCast(e.data + key.len);
+        return words[0..e.words_len];
+    }
+
+    pub fn put(m: *Memo, gpa: std.mem.Allocator, key: []const u64, h: u64, words: []const u32) !void {
+        if (m.misses < admit) return;
+        if (m.slots.len == 0) {
+            m.slots = try gpa.alloc(Slot, slots_per_unit);
+            @memset(m.slots, .{});
+        }
+        const e = &m.slots[h % m.slots.len];
+        e.used = false;
+        const need: u32 = @intCast(key.len + (words.len + 1) / 2);
+        if (need > e.cap) {
+            if (e.cap > 0) gpa.free(e.data[0..e.cap]);
+            e.cap = 0;
+            e.data = (try gpa.alloc(u64, need)).ptr;
+            e.cap = need;
+        }
+        @memcpy(e.data[0..key.len], key);
+        const dst: [*]u32 = @ptrCast(e.data + key.len);
+        @memcpy(dst[0..words.len], words);
+        e.key_len = @intCast(key.len);
+        e.words_len = @intCast(words.len);
+        e.hash = h;
+        e.used = true;
+    }
+
+    /// Bytes held by the entries, for admission.
+    pub fn bytes(m: *const Memo) usize {
+        var n = m.slots.len * @sizeOf(Slot);
+        for (m.slots) |e| n += e.cap * 8;
+        return n;
+    }
+};
+
+test "a memo stores nothing before admission, then returns only what was stored under the same key" {
+    const gpa = std.testing.allocator;
+    var m: Memo = .{};
+    defer m.deinit(gpa);
+    const k1 = [_]u64{ 1, 2 };
+    const k2 = [_]u64{ 1, 3 };
+    for (0..admit) |_| try std.testing.expect(m.find(&k1, Memo.hash(&k1)) == null);
+    try std.testing.expect(m.slots.len == 0);
+    try m.put(gpa, &k1, Memo.hash(&k1), &.{ 7, 8, 9 });
+    try std.testing.expectEqualSlices(u32, &.{ 7, 8, 9 }, m.find(&k1, Memo.hash(&k1)).?);
+    try std.testing.expect(m.find(&k2, Memo.hash(&k1)) == null);
+    try std.testing.expect(m.find(&k2, Memo.hash(&k2)) == null);
+    try std.testing.expect(m.find(k1[0..1], Memo.hash(&k1)) == null);
+    try m.put(gpa, &k2, Memo.hash(&k1), &.{4});
+    try std.testing.expectEqualSlices(u32, &.{4}, m.find(&k2, Memo.hash(&k1)).?);
+    try std.testing.expect(m.find(&k1, Memo.hash(&k1)) == null);
+}
diff --git a/zig/src/core/runner_circuit_model.zig b/zig/src/core/runner_circuit_model.zig
new file mode 100644
index 000000000..77cea77f6
--- /dev/null
+++ b/zig/src/core/runner_circuit_model.zig
@@ -0,0 +1,366 @@
+//! A compiled circuit in memory: batched SwiGLU units and one-hot DeltaNet heads in stored node order.
+const std = @import("std");
+
+/// Evaluation precision; the loader refuses any weight or state value this type cannot hold exactly.
+pub const Scalar = f32;
+/// Key/value head width and the rows a one-hot key can address.
+pub const hd: u32 = 128;
+/// Conv taps of a q/k/v channel: projections at t, t-1, t-2, t-3.
+pub const lags: u32 = 4;
+/// Decay selectors (Qwenputer's DECAY with dt_bias -110): keep, halve, clear.
+pub const keep_selector: Scalar = 0;
+pub const halve_selector: Scalar = 110;
+pub const clear_selector: Scalar = 238;
+
+/// y = x * W over the nonzeros, stored by source so zero inputs cost nothing.
+pub const Sparse = struct {
+    sources: u32,
+    outputs: u32,
+    starts: []const u32,
+    dst: []const u32,
+    w: []const Scalar,
+    /// Sources with at least one entry, ascending.
+    used: []const u32,
+    /// Per source: where its dense row (outputs weights, zeros elsewhere) starts in `dense`, or no_row (see densify).
+    dense_at: []const u32 = &.{},
+    dense: []const Scalar = &.{},
+
+    /// y = x * W: zeroes y, then adds the inputs listed in `active` (every other input is zero) in ascending order.
+    pub fn apply(m: *const Sparse, x: []const Scalar, active: []const u32, y: []Scalar) void {
+        @memset(y, 0);
+        for (if (m.used.len < active.len) m.used else active) |i| {
+            const v = x[i];
+            if (v == 0) continue;
+            if (m.dense_at.len > 0 and m.dense_at[i] != no_row and std.math.isFinite(v)) {
+                axpy(y, v, m.dense[m.dense_at[i]..][0..y.len]);
+                continue;
+            }
+            for (m.starts[i]..m.starts[i + 1]) |e| y[m.dst[e]] += v * m.w[e];
+        }
+    }
+
+    /// The same sums with dense rows for sources that reach many outputs; bit-identical (see axpy).
+    pub fn densify(m: *const Sparse, a: std.mem.Allocator) !Sparse {
+        var out = m.*;
+        const at = try a.alloc(u32, m.sources);
+        @memset(at, no_row);
+        var rows: std.ArrayList(Scalar) = .empty;
+        for (m.used) |i| {
+            const fan = m.starts[i + 1] - m.starts[i];
+            if (fan < 8 or fan * 8 < m.outputs) continue;
+            const row = try a.alloc(Scalar, m.outputs);
+            defer a.free(row);
+            @memset(row, 0);
+            var repeated = false;
+            for (m.starts[i]..m.starts[i + 1]) |e| {
+                repeated = repeated or row[m.dst[e]] != 0 or m.w[e] == 0;
+                row[m.dst[e]] = m.w[e];
+            }
+            if (repeated) continue;
+            at[i] = @intCast(rows.items.len);
+            try rows.appendSlice(a, row);
+        }
+        if (rows.items.len == 0) {
+            a.free(at);
+            return out;
+        }
+        out.dense_at = at;
+        out.dense = rows.items;
+        return out;
+    }
+
+    pub fn nonzeros(m: *const Sparse) usize {
+        return m.dst.len;
+    }
+};
+
+/// Where a node's value lands: x[dim] = value, or x[dim] += value when `into`.
+pub const Out = struct { dim: u32, into: bool };
+
+pub const no_form = std.math.maxInt(u32);
+
+/// A batch's expressions as distinct linear forms: column c = bias[c] + forms[form[c]], the constant dim folded out.
+pub const Shared = struct {
+    forms: Sparse,
+    form: []const u32,
+    bias: []const Scalar,
+
+    pub fn columns(s: *const Shared) usize {
+        return s.form.len;
+    }
+
+    /// `scratch` holds forms.outputs values.
+    pub fn eval(s: *const Shared, x: []const Scalar, active: []const u32, scratch: []Scalar, y: []Scalar) void {
+        s.forms.apply(x, active, scratch);
+        for (y, s.form, s.bias) |*o, f, c| o.* = if (f == no_form) c else c + scratch[f];
+    }
+};
+
+/// Consecutive FFN nodes with no read of a dim written earlier in the batch: y = sum c * up * max(gate, 0).
+pub const Ffn = struct {
+    terms: u32,
+    up: Shared,
+    gate: Shared,
+    coef: []const Scalar,
+    slot: []const u32,
+    outs: []const Out,
+    /// Terms grouped by gate form (starts has forms + 1 entries), each group by gate constant, largest first.
+    order: []const u32,
+    starts: []const u32,
+    /// Terms whose gate is a positive constant; terms with a constant gate <= 0 never fire and are dropped.
+    always: []const u32,
+    /// The batch's independent parts in node order (the CPU skips parts whose inputs did not change).
+    split: []const Ffn = &.{},
+    /// A part's forms read local sources: dims[i] is the dim of source i (ascending); empty when sources are dims.
+    dims: []const u32 = &.{},
+};
+
+/// (row or column, projection column) of a channel or expression.
+pub const Pick = struct { at: u32, column: u32 };
+
+pub const ValueHead = struct {
+    table: u32,
+    v: []const Pick,
+    a: ?u32,
+    beta: ?u32,
+    z: []const Pick,
+    out_first: u32,
+    out_cols: []const u32,
+    out_w: []const Scalar,
+};
+
+pub const Head = struct {
+    q: []const Pick,
+    k: []const Pick,
+    value_heads: []const ValueHead,
+};
+
+/// Consecutive head nodes. Projection columns [0, channels) are conv channels with taps; the rest are plain exprs.
+pub const Heads = struct {
+    proj: Shared,
+    channels: u32,
+    first_channel: u32,
+    taps: []const [lags]Scalar,
+    heads: []const Head,
+    outs: []const Out,
+    /// The same heads one per Heads, with their own forms and the batch's channel and table numbers.
+    split: []const Heads = &.{},
+};
+
+pub const Batch = union(enum) { ffn: Ffn, heads: Heads };
+
+/// One input feature: its dim's value is a function of the token's family id and payload.
+pub const Feature = struct {
+    dim: u32,
+    kind: Kind,
+    family: u32 = 0,
+    bit: u32 = 0,
+    digit: u32 = 0,
+    qd_family: u32 = 0,
+    amplitude: Scalar = 0,
+
+    pub const Kind = enum { family, payload_bit, next_digit, code_bit };
+
+    pub fn value(f: Feature, fam: u32, pay: u32, family_bits: u32) Scalar {
+        return switch (f.kind) {
+            .family => @floatFromInt(@intFromBool(fam == f.family)),
+            .payload_bit => if (fam == f.family) @floatFromInt(pay >> @intCast(f.bit) & 1) else 0,
+            .next_digit => @floatFromInt(@intFromBool((fam == f.family and pay == f.digit) or
+                (f.digit > 0 and fam == f.qd_family and pay >> 4 == f.digit - 1))),
+            .code_bit => blk: {
+                const code = @as(u64, fam) | @as(u64, pay) << @intCast(family_bits);
+                break :blk if (code >> @intCast(f.bit) & 1 == 1) f.amplitude else -f.amplitude;
+            },
+        };
+    }
+};
+
+pub const Family = struct { base: u32, size: u32 };
+
+/// A head's initial table: present rows (bit mask) of hd columns each, row-major hd x hd.
+pub const Table = struct {
+    present: u128,
+    rows: []const Scalar,
+    writable: bool,
+};
+
+/// A static program's memory: ROM instruction words, DROM bytes, RAM bytes and the entry address.
+pub const Image = struct {
+    rom: []u32,
+    drom: []u8,
+    ram: []u8,
+    entry: u32,
+
+    pub fn deinit(img: Image, a: std.mem.Allocator) void {
+        a.free(img.rom);
+        a.free(img.drom);
+        a.free(img.ram);
+    }
+};
+
+/// Where the calc firmware takes its expression, the RAM tables (ram<h>) the patch edits, and the boot image.
+pub const Program = struct {
+    kind: enum { calc, elf },
+    input_address: u32,
+    input_capacity: u32,
+    ram_tables: [32]u32,
+    a_ref: Scalar,
+    a_bit: Scalar,
+    image: Image,
+};
+
+pub const Circuit = struct {
+    dims: u32,
+    batches: []const Batch,
+    features: []const Feature,
+    families: []const Family,
+    family_bits: u32,
+    code_dims: []const u32,
+    go: u32,
+    halt: u32,
+    byte_family: u32,
+    fault_family: ?u32,
+    tables: []const Table,
+    table_names: []const []const u8,
+    channels: u32,
+    nodes: u32,
+    program: Program,
+    /// The CPU evaluator's dataflow over the batches.
+    flow: @import("runner_circuit_flow.zig").Flow,
+    payload_sha256: [32]u8,
+    arena: std.heap.ArenaAllocator,
+
+    /// Reads and checks a circuit file (CIRCUIT-FORMAT.md v1).
+    pub fn load(gpa: std.mem.Allocator, path: []const u8) !Circuit {
+        return @import("runner_circuit_load.zig").fromPath(gpa, path);
+    }
+
+    /// The arena owns everything; `gpa` is the allocator `load` was given.
+    pub fn deinit(c: *Circuit, gpa: std.mem.Allocator) void {
+        _ = gpa;
+        c.arena.deinit();
+        c.* = undefined;
+    }
+
+    /// The family id and payload of token t, or null when t is outside the vocabulary.
+    pub fn split(c: *const Circuit, t: u32) ?struct { u32, u32 } {
+        var lo: usize = 0;
+        var hi: usize = c.families.len;
+        while (lo < hi) {
+            const mid = (lo + hi) / 2;
+            const f = c.families[mid];
+            if (t < f.base) hi = mid else if (t - f.base >= f.size) lo = mid + 1 else return .{ @intCast(mid), t - f.base };
+        }
+        return null;
+    }
+
+    /// Weights the evaluator reads per step, for sizing and reports.
+    pub fn nonzeros(c: *const Circuit) usize {
+        var n: usize = 0;
+        for (c.batches) |*b| n += switch (b.*) {
+            .ffn => |*f| f.up.forms.nonzeros() + f.gate.forms.nonzeros(),
+            .heads => |*h| h.proj.forms.nonzeros(),
+        };
+        return n;
+    }
+};
+
+/// Builds a Sparse from (source, output, weight) triples in any order; a source's entries keep their input order.
+pub const no_row = std.math.maxInt(u32);
+
+/// y += v * row; an unreached output adds v * 0 = ±0 to a y that is never -0 (it starts +0), so it is unchanged.
+fn axpy(y: []Scalar, v: Scalar, row: []const Scalar) void {
+    const L = 8;
+    const V = @Vector(L, Scalar);
+    const vv: V = @splat(v);
+    var k: usize = 0;
+    while (k + L <= y.len) : (k += L) {
+        const yv: V = y[k..][0..L].*;
+        const rv: V = row[k..][0..L].*;
+        y[k..][0..L].* = yv + vv * rv;
+    }
+    while (k < y.len) : (k += 1) y[k] += v * row[k];
+}
+
+pub fn sparse(a: std.mem.Allocator, sources: u32, outputs: u32, src: []const u32, dst_in: []const u32, w_in: []const Scalar) !Sparse {
+    if (src.len != dst_in.len or src.len != w_in.len) return error.CircuitSparseShape;
+    const starts = try a.alloc(u32, sources + 1);
+    @memset(starts, 0);
+    for (src) |s| {
+        if (s >= sources) return error.CircuitIndex;
+        starts[s + 1] += 1;
+    }
+    for (1..starts.len) |i| starts[i] += starts[i - 1];
+    const fill = try a.dupe(u32, starts[0..sources]);
+    defer a.free(fill);
+    const dst = try a.alloc(u32, src.len);
+    const w = try a.alloc(Scalar, src.len);
+    for (src, dst_in, w_in) |s, d, v| {
+        if (d >= outputs) return error.CircuitIndex;
+        dst[fill[s]] = d;
+        w[fill[s]] = v;
+        fill[s] += 1;
+    }
+    var used: std.ArrayList(u32) = .empty;
+    for (0..sources) |i| if (starts[i + 1] > starts[i]) try used.append(a, @intCast(i));
+    return .{ .sources = sources, .outputs = outputs, .starts = starts, .dst = dst, .w = w, .used = used.items };
+}
+
+test "sparse apply skips zero inputs and adds repeated entries" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const m = try sparse(arena.allocator(), 3, 2, &.{ 0, 2, 2, 1 }, &.{ 1, 0, 0, 1 }, &.{ 2, 3, 4, 5 });
+    var y = [_]Scalar{ 7, 7 };
+    m.apply(&.{ 1, 0, 2 }, &.{ 0, 1, 2 }, &y);
+    try std.testing.expectEqualSlices(Scalar, &.{ 14, 2 }, &y);
+    m.apply(&.{ 1, 0, 2 }, &.{2}, &y);
+    try std.testing.expectEqualSlices(Scalar, &.{ 14, 0 }, &y);
+    try std.testing.expectError(error.CircuitIndex, sparse(arena.allocator(), 3, 2, &.{3}, &.{0}, &.{1}));
+}
+
+test "dense rows give the scatter's bits: rounding order, signed zeros, repeated entries and non-finite inputs" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var prng = std.Random.DefaultPrng.init(7);
+    const r = prng.random();
+    const outs = 37;
+    var src: std.ArrayList(u32) = .empty;
+    var dst: std.ArrayList(u32) = .empty;
+    var w: std.ArrayList(Scalar) = .empty;
+    for (0..6) |i| for (0..outs) |o| if (i == 5 or r.boolean()) {
+        try src.append(a, @intCast(i));
+        try dst.append(a, @intCast(o));
+        try w.append(a, (r.float(Scalar) - 0.5) * 1e3);
+    };
+    for (0..4) |_| {
+        try src.append(a, 4);
+        try dst.append(a, 3);
+        try w.append(a, 0.1);
+    }
+    const m = try sparse(a, 6, outs, src.items, dst.items, w.items);
+    const d = try m.densify(a);
+    try std.testing.expect(d.dense.len > 0 and d.dense_at[4] == no_row);
+    const xs = [_][6]Scalar{ .{ 1e-3, -7.5, 3.25e5, -0.0, 1.1, 2.0 }, .{ std.math.inf(Scalar), 1, -1, 0.3, 9, -4 }, .{ 0, 0, 0, 0, 0, -1e-30 } };
+    for (xs) |x| {
+        var want: [outs]Scalar = undefined;
+        var got: [outs]Scalar = undefined;
+        m.apply(&x, &.{ 0, 1, 2, 3, 4, 5 }, &want);
+        d.apply(&x, &.{ 0, 1, 2, 3, 4, 5 }, &got);
+        try std.testing.expectEqualSlices(u32, @ptrCast(&want), @ptrCast(&got));
+    }
+}
+
+test "features follow the format's token-bus encodings" {
+    const nd: Feature = .{ .dim = 1, .kind = .next_digit, .family = 9, .qd_family = 10, .digit = 0 };
+    try std.testing.expectEqual(@as(Scalar, 1), nd.value(9, 0, 5));
+    try std.testing.expectEqual(@as(Scalar, 0), nd.value(10, 0xff, 5));
+    const nd3: Feature = .{ .dim = 1, .kind = .next_digit, .family = 9, .qd_family = 10, .digit = 3 };
+    try std.testing.expectEqual(@as(Scalar, 1), nd3.value(10, 2 << 4 | 7, 5));
+    const cb: Feature = .{ .dim = 1, .kind = .code_bit, .bit = 6, .amplitude = 128 };
+    try std.testing.expectEqual(@as(Scalar, 128), cb.value(3, 2, 5));
+    try std.testing.expectEqual(@as(Scalar, -128), cb.value(3, 1, 5));
+    const pb: Feature = .{ .dim = 1, .kind = .payload_bit, .family = 4, .bit = 2 };
+    try std.testing.expectEqual(@as(Scalar, 1), pb.value(4, 4, 5));
+    try std.testing.expectEqual(@as(Scalar, 0), pb.value(5, 4, 5));
+}
diff --git a/zig/src/core/runner_circuit_parts.zig b/zig/src/core/runner_circuit_parts.zig
new file mode 100644
index 000000000..672430bff
--- /dev/null
+++ b/zig/src/core/runner_circuit_parts.zig
@@ -0,0 +1,241 @@
+//! CPU parts of a compiled circuit, derived from its batches alone, so a loaded and a prepared (packed) circuit match.
+const std = @import("std");
+const model = @import("runner_circuit_model.zig");
+const flow = @import("runner_circuit_flow.zig");
+
+const Scalar = model.Scalar;
+const none = model.no_form;
+
+/// Fills every batch's split parts and the circuit's dataflow; the batches keep their device layout.
+pub fn prepare(a: std.mem.Allocator, c: *model.Circuit) !void {
+    const batches = try a.dupe(model.Batch, c.batches);
+    for (batches) |*b| switch (b.*) {
+        .ffn => |*f| f.split = try ffnParts(a, f),
+        .heads => |*h| h.split = try headParts(a, h),
+    };
+    c.batches = batches;
+    c.flow = try flow.build(a, c);
+}
+
+/// The dims each form of a Sparse reads, as CSR by form.
+fn formDims(a: std.mem.Allocator, m: *const model.Sparse) !struct { []u32, []u32 } {
+    const starts = try a.alloc(u32, m.outputs + 1);
+    @memset(starts, 0);
+    for (m.used) |d| for (m.starts[d]..m.starts[d + 1]) |e| {
+        starts[m.dst[e] + 1] += 1;
+    };
+    for (1..starts.len) |i| starts[i] += starts[i - 1];
+    const dims = try a.alloc(u32, starts[m.outputs]);
+    const fill = try a.dupe(u32, starts[0..m.outputs]);
+    defer a.free(fill);
+    for (m.used) |d| for (m.starts[d]..m.starts[d + 1]) |e| {
+        dims[fill[m.dst[e]]] = d;
+        fill[m.dst[e]] += 1;
+    };
+    return .{ starts, dims };
+}
+
+fn find(root: []u32, i: u32) u32 {
+    var r = i;
+    while (root[r] != r) r = root[r];
+    return r;
+}
+
+/// Joins two union-find sets under the smaller root, so a part's root is its first node.
+fn join(root: []u32, i: u32, j: u32) void {
+    const x = find(root, i);
+    const y = find(root, j);
+    root[@max(x, y)] = @min(x, y);
+}
+
+/// An FFN batch's independent parts in node order: nodes sharing no dim read or written fall in different parts.
+fn ffnParts(a: std.mem.Allocator, f: *const model.Ffn) ![]model.Ffn {
+    const n = f.outs.len;
+    const root = try a.alloc(u32, n);
+    defer a.free(root);
+    for (root, 0..) |*r, i| r.* = @intCast(i);
+    var owner: std.AutoHashMapUnmanaged(u32, u32) = .empty;
+    defer owner.deinit(a);
+    const up_starts, const up_dims = try formDims(a, &f.up.forms);
+    const gate_starts, const gate_dims = try formDims(a, &f.gate.forms);
+    defer for ([_][]u32{ up_starts, up_dims, gate_starts, gate_dims }) |s| a.free(s);
+    for (f.outs, 0..) |o, i| try claim(a, &owner, root, o.dim, @intCast(i));
+    for (0..f.terms) |t| {
+        const node = f.slot[t];
+        if (f.up.form[t] != none) for (up_dims[up_starts[f.up.form[t]]..up_starts[f.up.form[t] + 1]]) |d| try claim(a, &owner, root, d, node);
+        if (f.gate.form[t] != none) for (gate_dims[gate_starts[f.gate.form[t]]..gate_starts[f.gate.form[t] + 1]]) |d| try claim(a, &owner, root, d, node);
+    }
+    const local = try a.alloc(u32, f.up.forms.sources);
+    defer a.free(local);
+    const dims: Dims = .{ .up_starts = up_starts, .up_dims = up_dims, .gate_starts = gate_starts, .gate_dims = gate_dims, .local = local };
+    var parts: std.ArrayList(model.Ffn) = .empty;
+    for (0..n) |i| if (find(root, @intCast(i)) == i) try parts.append(a, try ffnPart(a, f, root, @intCast(i), dims));
+    return parts.items;
+}
+
+/// The dims each up and gate form reads, and a dim-indexed scratch for a part's local source numbers.
+const Dims = struct { up_starts: []const u32, up_dims: []const u32, gate_starts: []const u32, gate_dims: []const u32, local: []u32 };
+
+fn claim(a: std.mem.Allocator, owner: *std.AutoHashMapUnmanaged(u32, u32), root: []u32, d: u32, node: u32) !void {
+    const got = try owner.getOrPut(a, d);
+    if (!got.found_existing) got.value_ptr.* = node else join(root, got.value_ptr.*, node);
+}
+
+/// The nodes rooted at `part` in batch order; forms renumbered by first use read the part's dims as ascending sources.
+fn ffnPart(a: std.mem.Allocator, f: *const model.Ffn, root: []u32, part: u32, dims: Dims) !model.Ffn {
+    const local = try a.alloc(u32, f.outs.len);
+    defer a.free(local);
+    var outs: std.ArrayList(model.Out) = .empty;
+    for (f.outs, 0..) |o, i| if (find(root, @intCast(i)) == part) {
+        local[i] = @intCast(outs.items.len);
+        try outs.append(a, o);
+    };
+    var terms: std.ArrayList(u32) = .empty;
+    defer terms.deinit(a);
+    for (0..f.terms) |t| if (find(root, f.slot[t]) == part) try terms.append(a, @intCast(t));
+    const coef = try a.alloc(Scalar, terms.items.len);
+    const slot = try a.alloc(u32, terms.items.len);
+    for (terms.items, coef, slot) |t, *k, *s| {
+        k.* = f.coef[t];
+        s.* = local[f.slot[t]];
+    }
+    var reads: std.ArrayList(u32) = .empty;
+    for (terms.items) |t| {
+        if (f.up.form[t] != none) try reads.appendSlice(a, dims.up_dims[dims.up_starts[f.up.form[t]]..dims.up_starts[f.up.form[t] + 1]]);
+        if (f.gate.form[t] != none) try reads.appendSlice(a, dims.gate_dims[dims.gate_starts[f.gate.form[t]]..dims.gate_starts[f.gate.form[t] + 1]]);
+    }
+    std.mem.sort(u32, reads.items, {}, std.sort.asc(u32));
+    var nd: usize = 0;
+    for (reads.items) |d| if (nd == 0 or reads.items[nd - 1] != d) {
+        reads.items[nd] = d;
+        nd += 1;
+    };
+    const part_dims = reads.items[0..nd];
+    for (part_dims, 0..) |d, i| dims.local[d] = @intCast(i);
+    const up = try sharedPart(a, &f.up, terms.items, dims.local, part_dims.len);
+    const gate = try sharedPart(a, &f.gate, terms.items, dims.local, part_dims.len);
+    const forms = gate.forms.outputs;
+    const starts = try a.alloc(u32, forms + 1);
+    @memset(starts, 0);
+    var always: std.ArrayList(u32) = .empty;
+    for (gate.form, gate.bias, 0..) |g, b, t| {
+        if (g != none) starts[g + 1] += 1 else if (b > 0) try always.append(a, @intCast(t));
+    }
+    for (1..starts.len) |i| starts[i] += starts[i - 1];
+    const order = try a.alloc(u32, starts[forms]);
+    const fill = try a.dupe(u32, starts[0..forms]);
+    defer a.free(fill);
+    for (gate.form, 0..) |g, t| if (g != none) {
+        order[fill[g]] = @intCast(t);
+        fill[g] += 1;
+    };
+    for (0..forms) |g| std.mem.sort(u32, order[starts[g]..starts[g + 1]], gate.bias, struct {
+        fn gt(bias: []const Scalar, x: u32, y: u32) bool {
+            return bias[x] > bias[y] or (bias[x] == bias[y] and x < y);
+        }
+    }.gt);
+    return .{ .terms = @intCast(terms.items.len), .up = up, .gate = gate, .coef = coef, .slot = slot, .outs = outs.items, .order = order, .starts = starts, .always = always.items, .dims = part_dims };
+}
+
+/// Columns `cols` as their own Shared: same biases, forms renumbered by first use, sources by `local` (n) if given.
+fn sharedPart(a: std.mem.Allocator, s: *const model.Shared, cols: []const u32, local: ?[]const u32, n: usize) !model.Shared {
+    const remap = try a.alloc(u32, s.forms.outputs);
+    defer a.free(remap);
+    @memset(remap, none);
+    var forms: u32 = 0;
+    const form = try a.alloc(u32, cols.len);
+    const bias = try a.alloc(Scalar, cols.len);
+    for (cols, form, bias) |c, *fo, *b| {
+        b.* = s.bias[c];
+        const old = s.form[c];
+        if (old == none) {
+            fo.* = none;
+            continue;
+        }
+        if (remap[old] == none) {
+            remap[old] = forms;
+            forms += 1;
+        }
+        fo.* = remap[old];
+    }
+    var src: std.ArrayList(u32) = .empty;
+    var dst: std.ArrayList(u32) = .empty;
+    var w: std.ArrayList(Scalar) = .empty;
+    defer src.deinit(a);
+    defer dst.deinit(a);
+    defer w.deinit(a);
+    const m = &s.forms;
+    for (m.used) |d| for (m.starts[d]..m.starts[d + 1]) |e| if (remap[m.dst[e]] != none) {
+        try src.append(a, if (local) |l| l[d] else d);
+        try dst.append(a, remap[m.dst[e]]);
+        try w.append(a, m.w[e]);
+    };
+    const sources: u32 = if (local != null) @intCast(n) else m.sources;
+    return .{ .forms = try model.sparse(a, sources, forms, src.items, dst.items, w.items), .form = form, .bias = bias };
+}
+
+/// Each head of a batch alone: its channels keep their global numbers and order, its tables and outputs their own.
+fn headParts(a: std.mem.Allocator, h: *const model.Heads) ![]model.Heads {
+    const out = try a.alloc(model.Heads, h.heads.len);
+    var c0: u32 = 0;
+    var p0: u32 = h.channels;
+    var o0: u32 = 0;
+    for (h.heads, out) |*hd, *one| {
+        var nch: u32 = @intCast(hd.q.len + hd.k.len);
+        var nplain: u32 = 0;
+        var nout: u32 = 0;
+        for (hd.value_heads) |vh| {
+            nch += @intCast(vh.v.len);
+            nplain += @intFromBool(vh.a != null) + @intFromBool(vh.beta != null) + @as(u32, @intCast(vh.z.len));
+            nout += @intCast(vh.out_cols.len);
+        }
+        const cols = try a.alloc(u32, nch + nplain);
+        defer a.free(cols);
+        for (cols[0..nch], c0..) |*c, i| c.* = @intCast(i);
+        for (cols[nch..], p0..) |*c, i| c.* = @intCast(i);
+        const map = Remap{ .c0 = c0, .p0 = p0, .channels = h.channels, .nch = nch };
+        const vhs = try a.alloc(model.ValueHead, hd.value_heads.len);
+        for (hd.value_heads, vhs) |vh, *v| v.* = .{
+            .table = vh.table,
+            .v = try map.picks(a, vh.v),
+            .a = if (vh.a) |x| map.col(x) else null,
+            .beta = if (vh.beta) |x| map.col(x) else null,
+            .z = try map.picks(a, vh.z),
+            .out_first = vh.out_first - o0,
+            .out_cols = vh.out_cols,
+            .out_w = vh.out_w,
+        };
+        const heads = try a.alloc(model.Head, 1);
+        heads[0] = .{ .q = try map.picks(a, hd.q), .k = try map.picks(a, hd.k), .value_heads = vhs };
+        one.* = .{
+            .proj = try sharedPart(a, &h.proj, cols, null, 0),
+            .channels = nch,
+            .first_channel = h.first_channel + c0,
+            .taps = h.taps[c0..][0..nch],
+            .heads = heads,
+            .outs = h.outs[o0..][0..nout],
+        };
+        c0 += nch;
+        p0 += nplain;
+        o0 += nout;
+    }
+    return out;
+}
+
+/// A batch column in one head's own numbering: its channels first, then its plain expressions.
+const Remap = struct {
+    c0: u32,
+    p0: u32,
+    channels: u32,
+    nch: u32,
+
+    fn col(r: Remap, c: u32) u32 {
+        return if (c < r.channels) c - r.c0 else r.nch + (c - r.p0);
+    }
+
+    fn picks(r: Remap, a: std.mem.Allocator, ps: []const model.Pick) ![]model.Pick {
+        const out = try a.alloc(model.Pick, ps.len);
+        for (ps, out) |p, *o| o.* = .{ .at = p.at, .column = r.col(p.column) };
+        return out;
+    }
+};
diff --git a/zig/src/core/runner_circuit_rom.zig b/zig/src/core/runner_circuit_rom.zig
new file mode 100644
index 000000000..3206b7eef
--- /dev/null
+++ b/zig/src/core/runner_circuit_rom.zig
@@ -0,0 +1,202 @@
+//! Qwenputer's pre-decoded ROM word (ref.rom_word): the circuit's view of an RV32 instruction, as data.
+const std = @import("std");
+
+pub const rom_base: u32 = 0x40000;
+pub const rom_words: u32 = 1 << 16;
+
+/// Uop numbers of the ROM word's first byte (ref.UOPS, then the custom digit-file ops at 64).
+pub const Op = enum(u8) {
+    illegal,
+    lui,
+    auipc,
+    misa,
+    addi,
+    slti,
+    sltiu,
+    xori,
+    ori,
+    andi,
+    slli,
+    srli,
+    srai,
+    add,
+    sub,
+    sll,
+    slt,
+    sltu,
+    xor,
+    srl,
+    sra,
+    @"or",
+    @"and",
+    lb,
+    lh,
+    lw,
+    lbu,
+    lhu,
+    sb,
+    sh,
+    sw,
+    beq,
+    bne,
+    blt,
+    bge,
+    bltu,
+    bgeu,
+    jal,
+    jalr,
+    ecall,
+    ebreak,
+    fence,
+    mul,
+    mulh,
+    mulhsu,
+    mulhu,
+    div,
+    divu,
+    rem,
+    remu,
+    sh1add,
+    sh2add,
+    sh3add,
+    bmac = 64,
+    bmsb,
+    bld,
+    bget,
+    bprd,
+    bscan,
+    csrrw = 200,
+    csrrs,
+    csrrc,
+    csrrwi,
+    csrrsi,
+    csrrci,
+};
+
+pub const Inst = struct { op: Op, rd: u32 = 0, rs1: u32 = 0, rs2: u32 = 0, imm: i32 = 0, dd: u32 = 0 };
+
+fn sx(v: u32, comptime bits: u5) i32 {
+    const m = v & ((@as(u32, 1) << bits) - 1);
+    return if (m >> (bits - 1) == 1) @as(i32, @intCast(m)) - (@as(i32, 1) << bits) else @intCast(m);
+}
+
+/// ref.decode: one instruction word to its op and fields; anything unknown is illegal.
+pub fn decode(w: u32) Inst {
+    const opc = w & 0x7f;
+    const rd = w >> 7 & 31;
+    const f3 = w >> 12 & 7;
+    const rs1 = w >> 15 & 31;
+    const rs2 = w >> 20 & 31;
+    const f7 = w >> 25;
+    const i_imm = sx(w >> 20, 12);
+    const s_imm = sx((w >> 25) << 5 | (w >> 7 & 31), 12);
+    const b_imm = sx((w >> 31 & 1) << 12 | (w >> 7 & 1) << 11 | (w >> 25 & 63) << 5 | (w >> 8 & 15) << 1, 13);
+    const j_imm = sx((w >> 31 & 1) << 20 | (w >> 12 & 0xff) << 12 | (w >> 20 & 1) << 11 | (w >> 21 & 0x3ff) << 1, 21);
+    const upper: i32 = @bitCast(w & 0xfffff000);
+    switch (opc) {
+        0x37 => return .{ .op = .lui, .rd = rd, .imm = upper },
+        0x17 => return .{ .op = .auipc, .rd = rd, .imm = upper },
+        0x6f => return .{ .op = .jal, .rd = rd, .imm = j_imm },
+        0x67 => if (f3 == 0) return .{ .op = .jalr, .rd = rd, .rs1 = rs1, .imm = i_imm },
+        0x63 => if (f3 != 2 and f3 != 3) return .{ .op = ([_]Op{ .beq, .bne, .illegal, .illegal, .blt, .bge, .bltu, .bgeu })[f3], .rs1 = rs1, .rs2 = rs2, .imm = b_imm },
+        0x03 => if (f3 != 3 and f3 < 6) return .{ .op = ([_]Op{ .lb, .lh, .lw, .illegal, .lbu, .lhu })[f3], .rd = rd, .rs1 = rs1, .imm = i_imm },
+        0x23 => if (f3 < 3) return .{ .op = ([_]Op{ .sb, .sh, .sw })[f3], .rs1 = rs1, .rs2 = rs2, .imm = s_imm },
+        0x13 => {
+            if (f3 == 1 and f7 == 0) return .{ .op = .slli, .rd = rd, .rs1 = rs1, .imm = @intCast(rs2) };
+            if (f3 == 5 and (f7 == 0 or f7 == 0x20)) return .{ .op = if (f7 != 0) .srai else .srli, .rd = rd, .rs1 = rs1, .imm = @intCast(rs2) };
+            if (f3 != 1 and f3 != 5) return .{ .op = ([_]Op{ .addi, .illegal, .slti, .sltiu, .xori, .illegal, .ori, .andi })[f3], .rd = rd, .rs1 = rs1, .imm = i_imm };
+        },
+        0x33 => {
+            if (f7 == 0) return .{ .op = ([_]Op{ .add, .sll, .slt, .sltu, .xor, .srl, .@"or", .@"and" })[f3], .rd = rd, .rs1 = rs1, .rs2 = rs2 };
+            if (f7 == 0x20 and (f3 == 0 or f3 == 5)) return .{ .op = if (f3 == 0) .sub else .sra, .rd = rd, .rs1 = rs1, .rs2 = rs2 };
+            if (f7 == 1) return .{ .op = ([_]Op{ .mul, .mulh, .mulhsu, .mulhu, .div, .divu, .rem, .remu })[f3], .rd = rd, .rs1 = rs1, .rs2 = rs2 };
+            if (f7 == 0x10 and (f3 == 2 or f3 == 4 or f3 == 6)) return .{ .op = ([_]Op{ .sh1add, .sh2add, .sh3add })[f3 / 2 - 1], .rd = rd, .rs1 = rs1, .rs2 = rs2 };
+        },
+        0x0b => if (f3 < 5 and f7 == 0) return .{ .op = ([_]Op{ .bmac, .bmsb, .bld, .bget, .bscan })[f3], .rd = rd, .rs1 = rs1, .rs2 = rs2 },
+        0x2b => if (f3 == 0) return .{ .op = .bprd, .imm = @intCast(w >> 20 & 0x7f), .dd = rd & 7 },
+        else => {},
+    }
+    if (w == 0x00000073) return .{ .op = .ecall };
+    if (opc == 0x73 and f3 != 0 and f3 != 4) return .{ .op = ([_]Op{ .illegal, .csrrw, .csrrs, .csrrc, .illegal, .csrrwi, .csrrsi, .csrrci })[f3], .rd = rd, .rs1 = rs1, .imm = @intCast(w >> 20) };
+    if (w == 0x00100073) return .{ .op = .ebreak };
+    if (opc == 0x0f) return .{ .op = .fence };
+    return .{ .op = .illegal };
+}
+
+/// ref.csr_read: a pure read of a stubbed CSR (cycle, time, instret and high halves, mhartid read 0; misa).
+fn csrRead(ins: Inst) ?u32 {
+    const pure = (ins.op == .csrrs or ins.op == .csrrc or ins.op == .csrrsi or ins.op == .csrrci) and ins.rs1 == 0;
+    if (!pure) return null;
+    return switch (ins.imm) {
+        0xc00, 0xc01, 0xc02, 0xc80, 0xc81, 0xc82, 0xf14 => 0,
+        0x301 => 0x40001100,
+        else => null,
+    };
+}
+
+fn pack(op: Op, rd: u32, rs1: u32, rs2: u32, spare: u32) u32 {
+    const b0 = @backingInt(op) | (spare & 1) << 7;
+    const b1 = rd << 3 | (spare >> 1 & 7);
+    const b2 = rs1 << 3 | (spare >> 4 & 7);
+    const b3 = rs2 << 3 | (spare >> 7 & 7);
+    return b0 | b1 << 8 | b2 << 16 | b3 << 24;
+}
+
+fn inRom(t: u32) bool {
+    return t % 4 == 0 and t >= rom_base and t < rom_base + 4 * rom_words;
+}
+
+/// ref.rom_word: the pre-decoded word of instruction w at pc.
+pub fn romWord(w: u32, pc: u32) u32 {
+    const ins = decode(w);
+    const imm_u: u32 = @bitCast(ins.imm);
+    switch (ins.op) {
+        .csrrw, .csrrs, .csrrc, .csrrwi, .csrrsi, .csrrci => {
+            const v = csrRead(ins) orelse return pack(.illegal, 0, 0, 0, 0);
+            return pack(if (v != 0) .misa else .lui, ins.rd, 0, 0, 0);
+        },
+        .lui, .auipc => {
+            const up = (if (ins.op == .lui) imm_u else pc +% imm_u) >> 12 & 0xfffff;
+            return pack(ins.op, ins.rd, up & 31, up >> 5 & 31, up >> 10);
+        },
+        .addi, .slti, .sltiu, .xori, .ori, .andi, .slli, .srli, .srai, .lb, .lh, .lw, .lbu, .lhu, .jalr => {
+            const i = imm_u & 0xfff;
+            return pack(ins.op, ins.rd, ins.rs1, i & 31, i >> 5);
+        },
+        .sb, .sh, .sw => {
+            const i = imm_u & 0xfff;
+            return pack(ins.op, ins.rs2, ins.rs1, i & 31, i >> 5);
+        },
+        .beq, .bne, .blt, .bge, .bltu, .bgeu => {
+            const off: u32 = @as(u32, @bitCast(ins.imm >> 2)) & 0x7ff;
+            const bad: u32 = @intFromBool(!inRom(pc +% imm_u));
+            return pack(ins.op, off & 31, ins.rs1, ins.rs2, off >> 5 | bad << 6);
+        },
+        .jal => {
+            const t = pc +% imm_u;
+            const wi = (t -% rom_base) >> 2 & 0xffff;
+            return pack(.jal, ins.rd, wi & 31, wi >> 5 & 31, wi >> 10 | @as(u32, @intFromBool(!inRom(t))) << 6);
+        },
+        .ecall => return pack(.ecall, 0, 17, 10, 0),
+        .bprd => return pack(.bprd, 0, 0, imm_u & 31, imm_u >> 5 | ins.dd << 7),
+        .bmac, .bmsb, .bld, .bget, .bscan => return pack(ins.op, ins.rd, ins.rs1, ins.rs2, 0),
+        .ebreak, .fence, .illegal => return pack(ins.op, 0, 0, 0, 0),
+        else => return pack(ins.op, ins.rd, ins.rs1, ins.rs2, 0),
+    }
+}
+
+test "rom words match hand-packed upstream encodings" {
+    // addi a0, zero, 5 at the ROM base: uop ADDI, rd 10, rs1 0, imm 5
+    try std.testing.expectEqual(@as(u32, 4 | 10 << 11 | 0 << 19 | 5 << 27), romWord(0x00500513, rom_base));
+    // ecall: RS1 = a7, RS2 = a0
+    try std.testing.expectEqual(@as(u32, 39 | 17 << 19 | 10 << 27), romWord(0x00000073, rom_base));
+    // jal ra, -4 from the ROM base targets outside the ROM: bad bit S6
+    const jal = romWord(0xffdff0ef, rom_base);
+    try std.testing.expectEqual(@as(u32, 37), jal & 0x7f);
+    try std.testing.expectEqual(@as(u32, 1), jal >> 18 & 1);
+    // csrr a0, misa reads MISA; csrr a0, mcycle (unsupported) is illegal
+    try std.testing.expectEqual(@as(u32, 3 | 10 << 11), romWord(0x30102573, rom_base));
+    try std.testing.expectEqual(@as(u32, 0), romWord(0xb0002573, rom_base));
+    try std.testing.expectEqual(Op.sub, decode(0x40b50533).op);
+    try std.testing.expectEqual(Op.sh2add, decode(0x20b54533).op);
+}
diff --git a/zig/src/core/runner_circuit_state.zig b/zig/src/core/runner_circuit_state.zig
new file mode 100644
index 000000000..1a9cf15ea
--- /dev/null
+++ b/zig/src/core/runner_circuit_state.zig
@@ -0,0 +1,257 @@
+//! Per-machine circuit state: the DeltaNet tables (the RAM op's rows), slot values, head frames and canonical bytes.
+const std = @import("std");
+const model = @import("runner_circuit_model.zig");
+const head = @import("runner_circuit_head.zig");
+const Memo = @import("runner_circuit_memo.zig").Memo;
+
+const Scalar = model.Scalar;
+const hd = model.hd;
+const table_floats = hd * hd;
+const history = model.lags - 1;
+
+/// Read-only tables stay shared with the circuit; tables a key or decay can change are copied per machine.
+pub const State = struct {
+    gpa: std.mem.Allocator,
+    circuit: *const model.Circuit,
+    tables: [][]Scalar,
+    owned: []bool,
+    present: []u128,
+    steps: u64 = 0,
+    /// Each slot's value as of the last step that computed it.
+    val: []Scalar,
+    /// Per unit: the step stamp (step + 1) it was marked dirty, its inputs last changed, an output base changed.
+    dirty: []u64,
+    changed: []u64,
+    rebase: []u64,
+    /// Per output slot: the unit's value before adding its base, so a base change alone just adds again.
+    pre: []Scalar,
+    /// Per unit: the outputs whose base changed this step (stored at the unit's first output slot).
+    rb: []u32,
+    rb_len: []u32,
+    rb_mark: []u64,
+    /// Per unit input (at the unit's in_off): its slot's value and a bit set while the value is nonzero.
+    in_vals: []Scalar,
+    in_bits: []u64,
+    /// Per unit: its last run decayed a table, so the next step must run it again.
+    unstable: []bool,
+    /// Per chain end, one bit per link that holds something other than +0 (every pre starts +0).
+    chain_bits: []u64,
+    /// Units to visit this step and those already due next step (lag window open or unstable), one bit each.
+    active: []u64,
+    keep: []u64,
+    /// Per head (by plan) its last runs' inputs; per unit its results by exact input.
+    frames: [][head.frames_per_unit]head.Frame,
+    picks: [][head.frames_per_unit]head.Picks,
+    /// Per unit: its last outputs were all +0.
+    rest: []bool,
+    memos: []Memo,
+    groups: []head.Group,
+    /// Dense input scratch, zero outside a running unit; the same for steps t-1..t-3 while a head reads them.
+    x: []Scalar,
+    past: [history][]Scalar,
+    /// A running unit's nonzero dims, its memo key, selecting dims and the input index of each nonzero dim.
+    nz: []u32,
+    key: []u64,
+    nz2: []u32,
+    local: []u32,
+    words: []u32,
+    work: []Scalar,
+    /// FFN parts' form values and node outputs of their last compute.
+    ffn_up: []Scalar,
+    ffn_gate: []Scalar,
+    ffn_y: []Scalar,
+    /// Run every unit on the next step (a fresh machine or a host edit of the tables).
+    force: bool = true,
+    /// Run every unit on every step without its memo (the reference the skipping is checked against).
+    always: bool = false,
+
+    pub fn init(gpa: std.mem.Allocator, c: *const model.Circuit) !State {
+        var s: State = .{ .gpa = gpa, .circuit = c, .tables = &.{}, .owned = &.{}, .present = &.{}, .val = &.{}, .dirty = &.{}, .changed = &.{}, .rebase = &.{}, .pre = &.{}, .rb = &.{}, .rb_len = &.{}, .rb_mark = &.{}, .in_vals = &.{}, .in_bits = &.{}, .unstable = &.{}, .chain_bits = &.{}, .active = &.{}, .keep = &.{}, .frames = &.{}, .picks = &.{}, .rest = &.{}, .memos = &.{}, .groups = &.{}, .x = &.{}, .past = @splat(&.{}), .nz = &.{}, .key = &.{}, .nz2 = &.{}, .local = &.{}, .words = &.{}, .work = &.{}, .ffn_up = &.{}, .ffn_gate = &.{}, .ffn_y = &.{} };
+        errdefer s.deinit();
+        const f = &c.flow;
+        const n = f.units.len;
+        s.owned = try zeroed(gpa, bool, c.tables.len);
+        s.tables = try gpa.alloc([]Scalar, c.tables.len);
+        for (c.tables, s.tables) |t, *rows| rows.* = @constCast(t.rows);
+        s.present = try gpa.alloc(u128, c.tables.len);
+        for (c.tables, s.present) |t, *p| p.* = t.present;
+        for (c.tables, 0..) |t, i| if (t.writable) try s.own(@intCast(i));
+        s.val = try zeroed(gpa, Scalar, f.slots);
+        s.dirty = try zeroed(gpa, u64, n);
+        s.changed = try zeroed(gpa, u64, n);
+        s.rebase = try zeroed(gpa, u64, n);
+        s.pre = try zeroed(gpa, Scalar, f.slots);
+        s.rb = try zeroed(gpa, u32, f.slots);
+        s.rb_len = try zeroed(gpa, u32, n);
+        s.rb_mark = try zeroed(gpa, u64, f.slots);
+        s.in_vals = try zeroed(gpa, Scalar, f.total_ins);
+        s.in_bits = try zeroed(gpa, u64, f.total_ins / 64 + 1);
+        s.unstable = try zeroed(gpa, bool, n);
+        s.chain_bits = try zeroed(gpa, u64, f.chain_words);
+        s.active = try zeroed(gpa, u64, n / 64 + 1);
+        s.keep = try zeroed(gpa, u64, n / 64 + 1);
+        s.frames = try gpa.alloc([head.frames_per_unit]head.Frame, f.plans.len);
+        for (s.frames) |*fs| fs.* = @splat(.{});
+        s.picks = try gpa.alloc([head.frames_per_unit]head.Picks, f.plans.len);
+        for (s.picks) |*fs| fs.* = @splat(.{});
+        s.rest = try gpa.alloc(bool, n);
+        @memset(s.rest, true);
+        s.memos = try gpa.alloc(Memo, n);
+        for (s.memos) |*m| m.* = .{};
+        s.groups = try gpa.alloc(head.Group, f.groups);
+        @memset(s.groups, .{});
+        s.x = try zeroed(gpa, Scalar, c.dims);
+        for (&s.past) |*p| p.* = try zeroed(gpa, Scalar, c.dims);
+        s.nz = try gpa.alloc(u32, f.max_dims);
+        s.key = try gpa.alloc(u64, f.max_dims);
+        s.nz2 = try gpa.alloc(u32, f.max_dims);
+        s.local = try gpa.alloc(u32, f.max_dims);
+        s.words = try gpa.alloc(u32, wordsSize(c));
+        s.work = try gpa.alloc(Scalar, workSize(c));
+        s.ffn_up = try zeroed(gpa, Scalar, f.ffn_totals[0]);
+        s.ffn_gate = try zeroed(gpa, Scalar, f.ffn_totals[1]);
+        s.ffn_y = try zeroed(gpa, Scalar, f.ffn_totals[2]);
+        return s;
+    }
+
+    pub fn deinit(s: *State) void {
+        if (s.owned.len == s.tables.len) for (s.owned, s.tables) |o, rows| if (o) s.gpa.free(rows);
+        s.gpa.free(s.tables);
+        s.gpa.free(s.owned);
+        s.gpa.free(s.present);
+        s.gpa.free(s.val);
+        s.gpa.free(s.dirty);
+        s.gpa.free(s.changed);
+        s.gpa.free(s.rebase);
+        s.gpa.free(s.pre);
+        s.gpa.free(s.rb);
+        s.gpa.free(s.rb_len);
+        s.gpa.free(s.rb_mark);
+        s.gpa.free(s.in_vals);
+        s.gpa.free(s.in_bits);
+        s.gpa.free(s.unstable);
+        s.gpa.free(s.chain_bits);
+        s.gpa.free(s.active);
+        s.gpa.free(s.keep);
+        for (s.frames) |*fs| for (fs) |*fr| fr.deinit(s.gpa);
+        s.gpa.free(s.frames);
+        for (s.picks) |*fs| for (fs) |*fr| fr.deinit(s.gpa);
+        s.gpa.free(s.picks);
+        s.gpa.free(s.rest);
+        for (s.memos) |*m| m.deinit(s.gpa);
+        s.gpa.free(s.memos);
+        for (s.groups) |*g| g.memo.deinit(s.gpa);
+        s.gpa.free(s.groups);
+        s.gpa.free(s.x);
+        for (s.past) |p| s.gpa.free(p);
+        s.gpa.free(s.nz);
+        s.gpa.free(s.key);
+        s.gpa.free(s.nz2);
+        s.gpa.free(s.local);
+        s.gpa.free(s.words);
+        s.gpa.free(s.work);
+        s.gpa.free(s.ffn_up);
+        s.gpa.free(s.ffn_gate);
+        s.gpa.free(s.ffn_y);
+        s.* = undefined;
+    }
+
+    /// Dim d's value at the end of the last step (the residual a dense evaluator would hold).
+    pub fn value(s: *const State, d: u32) Scalar {
+        return s.val[s.circuit.flow.final[d]];
+    }
+
+    pub fn writable(s: *const State, table: u32) bool {
+        return s.circuit.tables[table].writable;
+    }
+
+    pub fn row(s: *State, table: u32, r: u32) []Scalar {
+        return s.tables[table][r * hd ..][0..hd];
+    }
+
+    pub fn rowPresent(s: *const State, table: u32, r: u32) bool {
+        return s.present[table] >> @intCast(r) & 1 == 1;
+    }
+
+    /// Copies a shared table into this machine before the host rewrites it (an ELF boot's ROM and DROM).
+    pub fn own(s: *State, table: u32) !void {
+        if (s.owned[table]) return;
+        s.tables[table] = try s.gpa.dupe(Scalar, s.tables[table]);
+        s.owned[table] = true;
+    }
+
+    /// Replaces one row (the RAM op's write) of a table this machine owns.
+    pub fn writeRow(s: *State, table: u32, r: u32, values: []const Scalar) !void {
+        if (!s.owned[table]) return error.CircuitTableReadOnly;
+        if (r >= hd or values.len != hd) return error.CircuitIndex;
+        @memcpy(s.row(table, r), values);
+        s.present[table] |= @as(u128, 1) << @intCast(r);
+    }
+
+    pub fn clearRow(s: *State, table: u32, r: u32) !void {
+        if (!s.owned[table]) return error.CircuitTableReadOnly;
+        if (r >= hd) return error.CircuitIndex;
+        @memset(s.row(table, r), 0);
+        s.present[table] &= ~(@as(u128, 1) << @intCast(r));
+    }
+
+    /// Bytes this machine owns beyond the shared circuit (copied tables, scratch, frames and memos), for admission.
+    pub fn ownedBytes(s: *const State) usize {
+        var n: usize = (s.x.len * (1 + history) + s.work.len + s.val.len) * @sizeOf(Scalar) + s.dirty.len * 17;
+        for (s.owned) |o| n += if (o) table_floats * @sizeOf(Scalar) else 0;
+        for (s.frames) |fs| for (fs) |fr| {
+            n += fr.dims.capacity * 4 + fr.vals.capacity * 4;
+        };
+        for (s.picks) |fs| for (fs) |fr| {
+            n += fr.words.capacity * 4;
+        };
+        for (s.memos) |m| n += m.bytes();
+        for (s.groups) |g| n += g.memo.bytes();
+        return n;
+    }
+
+    /// Canonical bytes: steps, then every table and every channel's last three projections as binary64 LE.
+    pub fn canonical(s: *const State, gpa: std.mem.Allocator) ![]u8 {
+        const c = s.circuit;
+        const n = 8 + (s.tables.len * table_floats + @as(usize, c.channels) * history) * 8;
+        const out = try gpa.alloc(u8, n);
+        std.mem.writeInt(u64, out[0..8], s.steps, .little);
+        var at: usize = 8;
+        for (s.tables, s.present) |t, p| for (0..hd) |r| {
+            const live = p >> @intCast(r) & 1 == 1;
+            for (t[r * hd ..][0..hd]) |v| {
+                const w: f64 = if (live) v else 0;
+                std.mem.writeInt(u64, out[at..][0..8], @bitCast(w + 0), .little);
+                at += 8;
+            }
+        };
+        const scratch: *State = @constCast(s);
+        for (c.flow.units) |u| if (u.kind == .heads) head.history(scratch, u.plan, out, &at);
+        std.debug.assert(at == n);
+        return out;
+    }
+};
+
+fn zeroed(gpa: std.mem.Allocator, comptime T: type, n: usize) ![]T {
+    const out = try gpa.alloc(T, n);
+    @memset(out, std.mem.zeroes(T));
+    return out;
+}
+
+fn wordsSize(c: *const model.Circuit) usize {
+    var n: usize = 0;
+    for (c.flow.units) |u| n = @max(n, switch (u.kind) {
+        .ffn => |f| f.outs.len,
+        .heads => |h| 2 + 2 * (h.heads[0].q.len + h.heads[0].k.len + h.heads[0].value_heads.len),
+    });
+    return n;
+}
+
+fn workSize(c: *const model.Circuit) usize {
+    var n: usize = 0;
+    for (c.flow.units) |u| n = @max(n, switch (u.kind) {
+        .ffn => |f| f.outs.len,
+        .heads => |h| @max(h.outs.len + hd + c.flow.plans[u.plan].zrep.len, c.flow.plans[u.plan].sel.columns() + c.flow.plans[u.plan].sel.forms.outputs),
+    });
+    return n;
+}
