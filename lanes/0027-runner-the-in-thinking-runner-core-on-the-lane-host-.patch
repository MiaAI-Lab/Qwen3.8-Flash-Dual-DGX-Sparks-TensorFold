@@ -0,0 +1,71 @@
+//! Form trace's opt-in check (runner_trace_check): residues after the owned line, refusals, and the line unchanged off.
+const std = @import("std");
+const trace = @import("runner_trace.zig");
+
+const gpa = std.testing.allocator;
+const default = "[exact, computed by the engine: {}]";
+
+/// The owned line with the check on must be the line with it off, then `check` (S2 round 7's Python reference).
+fn expectCheck(display: []const u8, divmod: bool, out: []const u8, check: []const u8) !void {
+    const off = (try trace.owned(gpa, default, display, divmod, out, false)).?;
+    defer gpa.free(off);
+    const on = (try trace.owned(gpa, default, display, divmod, out, true)).?;
+    defer gpa.free(on);
+    const want = try std.mem.concat(gpa, u8, &.{ off[0 .. off.len - 1], check, "\n" });
+    defer gpa.free(want);
+    try std.testing.expectEqualStrings(want, on);
+}
+
+/// No check for this line: on and off are the same bytes.
+fn expectNone(display: []const u8, divmod: bool, out: []const u8) !void {
+    const off = (try trace.owned(gpa, default, display, divmod, out, false)).?;
+    defer gpa.free(off);
+    const on = (try trace.owned(gpa, default, display, divmod, out, true)).?;
+    defer gpa.free(on);
+    try std.testing.expectEqualStrings(off, on);
+}
+
+test "runner trace check: products, sums, powers and brackets show each literal's residue and the value's" {
+    try expectCheck("123456789012*987654321098", false, "121932631136585886175176\n", " check: 3*8 ≡ 6 (mod 9), 012*098 ≡ 176 (mod 1000)");
+    try expectCheck("320255973501901*65536 + 61185", false, "20988295479420645121\n", " check: 7*7 + 3 ≡ 7 (mod 9), 901*536 + 185 ≡ 121 (mod 1000)");
+    try expectCheck("12345678901^2", false, "152415787526596567801\n", " check: 1^2 ≡ 1 (mod 9), 901^2 ≡ 801 (mod 1000)");
+    try expectCheck("61185*(4000000000 + 294967296)", false, "262787574005760\n", " check: 3*(4 + 0) ≡ 3 (mod 9), 185*(000 + 296) ≡ 760 (mod 1000)");
+    try expectCheck("987654 * 137", false, "135308598\n", " check: 3 * 2 ≡ 6 (mod 9), 654 * 137 ≡ 598 (mod 1000)");
+    try expectCheck("(98765 - 4321)*(1000003)", false, "94444283332\n", " check: (8 - 1)*(4) ≡ 1 (mod 9), (765 - 321)*(003) ≡ 332 (mod 1000)");
+    // exponents stay as written
+    try expectCheck("7*11^3 + 2", false, "9319\n", " check: 7*2^3 + 2 ≡ 4 (mod 9), 7*11^3 + 2 ≡ 319 (mod 1000)");
+}
+
+test "runner trace check: divmod shows quotient times divisor plus remainder against the dividend" {
+    try expectCheck("314159265358979323846264338327950288419716939937510 ÷ 271828182845904523536", true, "(1155727349790921717910215407028, 23663814570294126502)\n", " check: 0*3 + 4 ≡ 4 (mod 9), 028*536 + 502 ≡ 510 (mod 1000)");
+    try expectCheck("(123456789 + 1) ÷ 97", true, "(1272750, 40)\n", " check: 6*7 + 4 ≡ 1 (mod 9), 750*97 + 40 ≡ 790 (mod 1000)");
+}
+
+test "runner trace check: hex, mod, named problems, long or wide expressions and negatives take no check" {
+    try expectNone("0xFEDCBA9876543210*2^64 + 0x0123456789ABCDEF", false, "1\n");
+    try expectNone("7^123 mod 1000000007", false, "937329259\n");
+    try expectNone("gcd(12, 18)", false, "6\n");
+    try expectNone("isqrt(99)", false, "9\n");
+    try expectNone("edit_distance(\"ab\", \"a\")", false, "1\n");
+    try expectNone("1*2*3*4*5", false, "120\n"); // five literals
+    try expectNone("12^5", false, "248832\n"); // a power past 4
+    try expectNone("2^10", false, "1024\n");
+    try expectNone("5 - 100", false, "-95\n"); // a negative value
+    try expectNone("-5*3", false, "-15\n"); // unary minus
+    try expectNone("(10^30 - 1) ÷ 97", true, "(10309278350515463917525773195, 84)\n");
+}
+
+test "runner trace check: a value its own residues contradict is not owned with the check, and unchanged without it" {
+    const wrong = "121932631136585886175177\n";
+    try std.testing.expectEqual(null, try trace.owned(gpa, default, "123456789012*987654321098", false, wrong, true));
+    const off = (try trace.owned(gpa, default, "123456789012*987654321098", false, wrong, false)).?;
+    defer gpa.free(off);
+    try std.testing.expectEqualStrings("[exact, computed by the engine: 123456789012*987654321098 = 121932631136585886175177]\n", off);
+    try std.testing.expectEqual(null, try trace.owned(gpa, default, "(123456789 + 1) ÷ 97", true, "(1272750, 41)\n", true));
+}
+
+test "runner trace check: any wording's closing text comes before the check" {
+    const line = (try trace.owned(gpa, "{} (exact)", "987654 * 137", false, "135308598\n", true)).?;
+    defer gpa.free(line);
+    try std.testing.expectEqualStrings("987654 * 137 = 135308598 (exact) check: 3 * 2 ≡ 6 (mod 9), 654 * 137 ≡ 598 (mod 1000)\n", line);
+}
diff --git a/zig/src/core/runner_trace_divmod_test.zig b/zig/src/core/runner_trace_divmod_test.zig
new file mode 100644
index 000000000..8a1ad5cfa
--- /dev/null
+++ b/zig/src/core/runner_trace_divmod_test.zig
@@ -0,0 +1,155 @@
+//! Form trace's `divmod(a, b)` cells (S1 R4) on the bank, run as the engine runs packets and sequences (Dispatch).
+const std = @import("std");
+const api = @import("runner_api.zig");
+const graph = @import("runner_graph.zig");
+const route = @import("runner_graph_route.zig");
+const trace = @import("runner_trace.zig");
+const gpa = std.testing.allocator;
+
+/// The R4 cells the stated audit ran on a bare graph backend, which takes no sequence (all 13 distinct ones).
+const cells = [_][]const u8{
+    "divmod(1010101010101018, 112233445566770)",
+    "divmod(10**24, 97)",
+    "divmod(10**30-1, 97)",
+    "divmod(123456789012345, 8913585)",
+    "divmod(23777868243178464, 41832496)",
+    "divmod(314159265358979323846264, 271828183)",
+    "divmod(314159265358979323846264338327950288419716939937510, 271828182845904523536)",
+    "divmod(32685677580, -4826)",
+    "divmod(33311225865831424, 998244353)",
+    "divmod(40092776, 233)",
+    "divmod(45949729863572161, 1000000007)",
+    "divmod(4852937748780900, 1000000007)",
+    "divmod(987654321098765432109876, 1000003)",
+};
+
+/// The circuit: no divmod cell may reach it.
+const Never = struct {
+    fn backend() api.Backend {
+        return .{ .ctx = undefined, .vtable = &.{ .start = start, .poll = poll, .cancel = cancel, .release = release } };
+    }
+    fn start(_: *anyopaque, _: u64, _: api.Program, _: u64) error{ OutOfMemory, Busy }!api.JobId {
+        return error.Busy;
+    }
+    fn poll(_: *anyopaque, _: api.JobId) api.Poll {
+        unreachable;
+    }
+    fn cancel(_: *anyopaque, _: api.JobId) void {}
+    fn release(_: *anyopaque, _: u64) void {}
+};
+
+fn python(code: []const u8) ![]u8 {
+    const src = try std.fmt.allocPrint(gpa, "print({s})", .{code});
+    defer gpa.free(src);
+    const r = try std.process.run(gpa, std.testing.io, .{ .argv = &.{ "/usr/bin/python3", "-I", "-S", "-c", src }, .stdout_limit = .limited(4096), .stderr_limit = .limited(4096) });
+    defer gpa.free(r.stderr);
+    errdefer gpa.free(r.stdout);
+    try std.testing.expect(r.term.success());
+    return r.stdout;
+}
+
+const Bank = struct {
+    bank: graph.Bank,
+    graph: api.Backend,
+    dispatch: route.Dispatch,
+    job: u64 = 0,
+
+    /// The cell as trace hands it to the runner (a repl line, no prior); it must stay on the graph backend.
+    fn translate(b: *Bank, code: []const u8) ![]const u8 {
+        var routed: route.Routed = .{ .inner = @import("runner_frontend.zig").frontend(), .bank = &b.bank };
+        const f = routed.frontend();
+        const tr = try f.translate(f.ctx, gpa, .{ .form = .repl, .lang = "python", .code = code });
+        if (tr != .program or tr.program.kind != .graph) {
+            std.debug.print("not a bank program: {s}\n", .{code});
+            if (tr == .program) gpa.free(tr.program.bytes);
+            return error.TestExpectedGraph;
+        }
+        return tr.program.bytes;
+    }
+
+    fn run(b: *Bank, bytes: []const u8) ![]u8 {
+        const d = b.dispatch.backend();
+        b.job += 1;
+        const job = try d.start(b.job, .{ .kind = .graph, .bytes = bytes }, 1 << 32);
+        const res = while (true) switch (d.poll(job)) {
+            .running => std.Thread.yield() catch {},
+            .done => |r| break r,
+        };
+        defer d.release(b.job);
+        try std.testing.expectEqual(api.Status.ok, res.status);
+        return gpa.dupe(u8, res.out);
+    }
+};
+
+fn openBank() !?*Bank {
+    const path = std.c.getenv("TF_RUNNER_GRAPH_BANK") orelse return null;
+    const b = try gpa.create(Bank);
+    errdefer gpa.destroy(b);
+    b.* = .{ .bank = try graph.Bank.load(gpa, std.mem.span(path)), .graph = undefined, .dispatch = undefined };
+    b.graph = try graph.backend(gpa, &b.bank, 2);
+    b.dispatch = .{ .gpa = gpa, .circuit = Never.backend(), .graph = b.graph, .bank = &b.bank };
+    return b;
+}
+
+fn closeBank(b: *Bank) void {
+    b.dispatch.deinit();
+    graph.destroy(b.graph);
+    b.bank.deinit();
+    gpa.destroy(b);
+}
+
+/// CPython's `(q, r)` as trace's owned line in the `[exact: {}]` format (pinned: the default wording may change).
+fn ownedLine(code: []const u8, tuple: []const u8) ![]u8 {
+    const v = std.mem.trimEnd(u8, tuple, "\n");
+    const comma = std.mem.indexOf(u8, v, ", ").?;
+    return std.fmt.allocPrint(gpa, "[exact: {s} = {s} remainder {s}]\n", .{ code, v[1..comma], v[comma + 2 .. v.len - 1] });
+}
+
+test "runner proof: trace divmod: each R4 divmod cell runs on the bank and owns CPython's quotient and remainder (TF_RUNNER_GRAPH_BANK)" {
+    const b = try openBank() orelse return error.SkipZigTest;
+    defer closeBank(b);
+    for (cells) |code| {
+        const want = try python(code);
+        defer gpa.free(want);
+        const bytes = try b.translate(code);
+        defer gpa.free(bytes);
+        const out = try b.run(bytes);
+        defer gpa.free(out);
+        if (!std.mem.eql(u8, want, out)) std.debug.print("{s}: '{s}', CPython '{s}'\n", .{ code, out, want });
+        try std.testing.expectEqualStrings(want, out);
+        const line = (try trace.owned(gpa, "[exact: {}]", code, true, out, false)) orelse return error.TestExpectedOwned;
+        defer gpa.free(line);
+        const golden = try ownedLine(code, want);
+        defer gpa.free(golden);
+        try std.testing.expectEqualStrings(golden, line);
+    }
+}
+
+test "runner proof: trace divmod: the circuit owns both halves: a mutated dividend prints CPython's pair (TF_RUNNER_GRAPH_BANK)" {
+    const b = try openBank() orelse return error.SkipZigTest;
+    defer closeBank(b);
+    for ([_][4][]const u8{
+        .{ cells[5], "314159265358979323846264", "314159265358979323846265", "divmod(314159265358979323846265, 271828183)" },
+        .{ cells[7], "32685677580", "32685677581", "divmod(32685677581, -4826)" },
+    }) |m| {
+        const bytes = try b.translate(m[0]);
+        defer gpa.free(bytes);
+        const from = try std.fmt.allocPrint(gpa, "\"{s}\"", .{m[1]});
+        defer gpa.free(from);
+        const to = try std.fmt.allocPrint(gpa, "\"{s}\"", .{m[2]});
+        defer gpa.free(to);
+        // A single divmod packet binds once for both outputs; split sequences may bind it in both pieces.
+        if (std.mem.count(u8, bytes, from) < 1) {
+            std.debug.print("dividend {s} not bound in the graph program: {s}\n", .{ m[1], bytes });
+            return error.TestExpectedInput;
+        }
+        const mutated = try std.mem.replaceOwned(u8, gpa, bytes, from, to);
+        defer gpa.free(mutated);
+        const want = try python(m[3]);
+        defer gpa.free(want);
+        const out = try b.run(mutated);
+        defer gpa.free(out);
+        if (!std.mem.eql(u8, want, out)) std.debug.print("host-owned: {s} -> {s}: '{s}', CPython '{s}'\n", .{ m[1], m[2], out, want });
+        try std.testing.expectEqualStrings(want, out);
+    }
+}
diff --git a/zig/src/core/runner_trace_expr.zig b/zig/src/core/runner_trace_expr.zig
new file mode 100644
index 000000000..8609c2854
--- /dev/null
+++ b/zig/src/core/runner_trace_expr.zig
@@ -0,0 +1,300 @@
+//! The runner's `trace` form: integer expression text to checked Python source, display text and a width bound.
+const std = @import("std");
+const text = @import("runner_trace_text.zig");
+const Allocator = std.mem.Allocator;
+
+pub const inf: u32 = 1 << 20;
+
+pub const Kind = enum { num, name, op };
+pub const Tok = struct { kind: Kind, text: []const u8 };
+
+/// A parsed operand: source, display, digit bound, operators, literal-only; `run` the frontend's source, `pw` a power.
+pub const Expr = struct { source: []u8, display: []u8, bound: u32, ops: u32, constant: bool, run: []u8, pw: ?Pow = null };
+
+pub const Pow = struct { base: []u8, k: []const u8 };
+
+pub const Name = struct { name: []u8, expr: ?Expr };
+
+pub fn sat(x: u32) u32 {
+    return @min(x, inf);
+}
+
+/// Expression text to a checked expression, or null (not a plain integer expression, or an unknown/poisoned name).
+pub fn parse(a: Allocator, names: []const Name, s: []const u8) Allocator.Error!?Expr {
+    var toks = try tokenize(a, s) orelse return null;
+    toks = try expandRun(a, toks) orelse return null;
+    var p: Parser = .{ .names = names, .a = a, .toks = toks };
+    const e = p.sum() catch |err| switch (err) {
+        error.OutOfMemory => return error.OutOfMemory,
+        error.Refused => return null,
+    };
+    if (p.i != toks.len) return null;
+    return e;
+}
+
+/// Numbers (plain, strict comma groups, 0x hex), names, + - * ^ ( ) mod and `...`; null on anything else.
+fn tokenize(a: Allocator, s: []const u8) Allocator.Error!?[]Tok {
+    var out: std.ArrayList(Tok) = .empty;
+    var i: usize = 0;
+    while (i < s.len) {
+        const c = s[i];
+        if (text.isSpace(c)) {
+            i += 1;
+            continue;
+        }
+        if (i > 0 and (std.ascii.isAlphanumeric(s[i - 1]) or s[i - 1] == ',' or s[i - 1] == '.') and std.ascii.isAlphanumeric(c)) return null;
+        if (std.ascii.isDigit(c)) {
+            const n = number(s, i) orelse return null;
+            var digits: std.ArrayList(u8) = .empty;
+            for (s[i..n]) |d| if (d != ',') try digits.append(a, d);
+            if (digits.items.len > 1 and digits.items[0] == '0' and digits.items[1] != 'x') return null;
+            try out.append(a, .{ .kind = .num, .text = digits.items });
+            i = n;
+            continue;
+        }
+        const nl = text.nameLen(s, i);
+        if (nl > 0 and (i + nl == s.len or !text.isWord(s[i + nl]))) {
+            try out.append(a, .{ .kind = .name, .text = s[i .. i + nl] });
+            i += nl;
+            continue;
+        }
+        if (std.mem.startsWith(u8, s[i..], "...") or std.mem.startsWith(u8, s[i..], "…")) {
+            try out.append(a, .{ .kind = .op, .text = "..." });
+            i += 3;
+            continue;
+        }
+        if (std.mem.startsWith(u8, s[i..], "**")) {
+            try out.append(a, .{ .kind = .op, .text = "^" });
+            i += 2;
+            continue;
+        }
+        const op: ?[]const u8, const w: usize = if (std.mem.indexOfScalar(u8, "+-*^()", c) != null)
+            .{ s[i .. i + 1], 1 }
+        else if (std.mem.startsWith(u8, s[i..], "×") or std.mem.startsWith(u8, s[i..], "·"))
+            .{ "*", 2 }
+        else if (std.mem.startsWith(u8, s[i..], "−"))
+            .{ "-", 3 }
+        else if (i + 3 <= s.len and std.ascii.eqlIgnoreCase(s[i .. i + 3], "mod") and (i + 3 == s.len or !std.ascii.isAlphabetic(s[i + 3])))
+            .{ "%", 3 }
+        else
+            .{ null, 0 };
+        try out.append(a, .{ .kind = .op, .text = op orelse return null });
+        i += w;
+    }
+    return out.items;
+}
+
+/// The end of a number token at `i`: 0x hex, strict comma groups or plain digits, not running into a word.
+fn number(s: []const u8, i: usize) ?usize {
+    const stop = struct {
+        fn ok(t: []const u8, j: usize, comma: bool) bool {
+            if (j >= t.len) return true;
+            if (text.isWord(t[j]) or (comma and t[j] == ',')) return false;
+            return !(t[j] == '.' and j + 1 < t.len and std.ascii.isDigit(t[j + 1]));
+        }
+    };
+    if (s[i] == '0' and i + 2 < s.len and s[i + 1] == 'x' and std.ascii.isHex(s[i + 2])) {
+        var j = i + 2;
+        while (j < s.len and std.ascii.isHex(s[j])) j += 1;
+        if (j < s.len and (text.isWord(s[j]) or s[j] == ',' or s[j] == '.')) return null;
+        return j;
+    }
+    if (s[i] != '0') {
+        var j = i;
+        while (j < s.len and j - i < 3 and std.ascii.isDigit(s[j])) j += 1;
+        var groups: usize = 0;
+        while (j + 3 < s.len + 0 and s[j] == ',' and allDigits(s[j + 1 .. j + 4])) : (groups += 1) j += 4;
+        if (groups > 0 and stop.ok(s, j, true)) return j;
+    }
+    var j = i;
+    while (j < s.len and std.ascii.isDigit(s[j])) j += 1;
+    return if (stop.ok(s, j, true)) j else null;
+}
+
+fn allDigits(s: []const u8) bool {
+    for (s) |c| if (!std.ascii.isDigit(c)) return false;
+    return true;
+}
+
+/// `a*b*...*c` with b = a+1 and c - a <= 64 becomes the explicit product; any other `...` refuses.
+fn expandRun(a: Allocator, toks: []Tok) Allocator.Error!?[]Tok {
+    var dots = false;
+    for (toks) |t| dots = dots or std.mem.eql(u8, t.text, "...");
+    if (!dots) return toks;
+    if (toks.len != 7) return null;
+    const shape = [_][]const u8{ "", "*", "", "*", "...", "*", "" };
+    for (toks, shape) |t, want| {
+        if (want.len == 0) {
+            if (t.kind != .num or t.text.len > 6 or std.mem.startsWith(u8, t.text, "0x")) return null;
+        } else if (!std.mem.eql(u8, t.text, want)) return null;
+    }
+    const x = std.fmt.parseInt(u32, toks[0].text, 10) catch return null;
+    const y = std.fmt.parseInt(u32, toks[2].text, 10) catch return null;
+    const z = std.fmt.parseInt(u32, toks[6].text, 10) catch return null;
+    if (y != x + 1 or z <= y or z - x > 64) return null;
+    var out: std.ArrayList(Tok) = .empty;
+    var n = x;
+    while (n <= z) : (n += 1) {
+        if (n != x) try out.append(a, .{ .kind = .op, .text = "*" });
+        try out.append(a, .{ .kind = .num, .text = try std.fmt.allocPrint(a, "{d}", .{n}) });
+    }
+    return out.items;
+}
+
+/// sum := term (+|- term)*; term := factor (*|mod factor)*; factor := -factor | atom [^ factor]; one reading only.
+const Parser = struct {
+    names: []const Name,
+    a: Allocator,
+    toks: []const Tok,
+    i: usize = 0,
+    depth: u32 = 0, // brackets open at the cursor
+    last_mod: bool = false, // the term just parsed ends in `mod`
+
+    const Error = error{ OutOfMemory, Refused };
+
+    fn peek(p: *const Parser, op: []const u8) bool {
+        return p.i < p.toks.len and p.toks[p.i].kind == .op and std.mem.eql(u8, p.toks[p.i].text, op);
+    }
+
+    fn sum(p: *Parser) Error!Expr {
+        var e = try p.term();
+        var terms: u32 = 1;
+        var has_mod = p.last_mod;
+        while (p.peek("+") or p.peek("-")) {
+            const op = p.toks[p.i].text;
+            p.i += 1;
+            const r = try p.term();
+            has_mod = has_mod or p.last_mod;
+            terms += 1;
+            e = .{ .source = try cat(p.a, &.{ e.source, op, r.source }), .display = try cat(p.a, &.{ e.display, " ", op, " ", r.display }), .bound = sat(@max(e.bound, r.bound) + 1), .ops = e.ops + r.ops + 1, .constant = false, .run = try cat(p.a, &.{ e.run, op, r.run }) };
+        }
+        // `A + B mod M` reads two ways: mod only in an expression that is one term
+        if (has_mod and terms > 1) return error.Refused;
+        return e;
+    }
+
+    fn term(p: *Parser) Error!Expr {
+        var e = try p.factor();
+        var moded = false;
+        while (p.peek("*") or p.peek("%")) {
+            const op = p.toks[p.i].text;
+            if (moded or (op[0] == '%' and p.depth > 0)) return error.Refused; // mod last, never in brackets
+            p.i += 1;
+            const start = p.i;
+            const r = try p.factor();
+            if (op[0] == '%') {
+                // the modulus is a plain number, name or power chain (10^18), never a sum or a bracket
+                for (p.toks[start..p.i]) |t| if (t.kind == .op and !std.mem.eql(u8, t.text, "^")) return error.Refused;
+                moded = true;
+                // a lone power mod m (a product carries no `pw`) runs as Python's pow(a, b, m): the same value
+                const run = if (e.pw != null) try cat(p.a, &.{ "pow(", e.pw.?.base, ", ", e.pw.?.k, ", ", try tens(p.a, r.run), ")" }) else try cat(p.a, &.{ e.run, "%", r.run });
+                e = .{ .source = try cat(p.a, &.{ e.source, "%", r.source }), .display = try cat(p.a, &.{ e.display, " mod ", r.display }), .bound = r.bound, .ops = e.ops + r.ops + 1, .constant = false, .run = run };
+            } else {
+                e = .{ .source = try cat(p.a, &.{ e.source, "*", r.source }), .display = try cat(p.a, &.{ e.display, "*", r.display }), .bound = sat(e.bound + r.bound), .ops = e.ops + r.ops + 1, .constant = false, .run = try cat(p.a, &.{ e.run, "*", r.run }) };
+            }
+        }
+        p.last_mod = moded;
+        return e;
+    }
+
+    fn factor(p: *Parser) Error!Expr {
+        if (p.peek("-")) {
+            p.i += 1;
+            const e = try p.factor();
+            return .{ .source = try cat(p.a, &.{ "-", e.source }), .display = try cat(p.a, &.{ "-", e.display }), .bound = e.bound, .ops = e.ops, .constant = false, .run = try cat(p.a, &.{ "-", e.run }) };
+        }
+        const base = try p.atom();
+        if (!p.peek("^")) return base;
+        p.i += 1;
+        if (p.i >= p.toks.len or p.toks[p.i].kind != .num) return error.Refused; // a literal exponent only
+        const k_text = p.toks[p.i].text;
+        p.i += 1;
+        if (p.peek("^")) return error.Refused; // a^b^c
+        const k = std.fmt.parseInt(u32, k_text, 10) catch return error.Refused;
+        const bound: u32 = if (base.constant and k <= 4096) constPowDigits(base.source, k) else sat(@as(u32, @intCast(@min(@as(u64, base.bound) * k, inf))));
+        return .{ .source = try cat(p.a, &.{ base.source, "**", k_text }), .display = try cat(p.a, &.{ base.display, "^", k_text }), .bound = bound, .ops = base.ops + 1, .constant = false, .run = try cat(p.a, &.{ base.run, "**", k_text }), .pw = .{ .base = base.run, .k = k_text } };
+    }
+
+    fn atom(p: *Parser) Error!Expr {
+        if (p.i >= p.toks.len) return error.Refused;
+        const t = p.toks[p.i];
+        p.i += 1;
+        switch (t.kind) {
+            .num => return .{ .source = try p.a.dupe(u8, t.text), .display = try p.a.dupe(u8, t.text), .bound = litDigits(t.text), .ops = 0, .constant = true, .run = try decimal(p.a, t.text) },
+            .name => {
+                const e = lookup(p.names, t.text) orelse return error.Refused;
+                return .{ .source = try cat(p.a, &.{ "(", e.source, ")" }), .display = if (e.ops > 0) try cat(p.a, &.{ "(", e.display, ")" }) else e.display, .bound = e.bound, .ops = e.ops, .constant = e.constant, .run = try cat(p.a, &.{ "(", e.run, ")" }) };
+            },
+            .op => {
+                if (!std.mem.eql(u8, t.text, "(")) return error.Refused;
+                p.depth += 1;
+                const e = try p.sum();
+                if (!p.peek(")")) return error.Refused;
+                p.depth -= 1;
+                p.i += 1;
+                return .{ .source = try cat(p.a, &.{ "(", e.source, ")" }), .display = try cat(p.a, &.{ "(", e.display, ")" }), .bound = e.bound, .ops = e.ops, .constant = e.constant, .run = try cat(p.a, &.{ "(", e.run, ")" }) };
+            },
+        }
+    }
+};
+
+fn cat(a: Allocator, parts: []const []const u8) Allocator.Error![]u8 {
+    return std.mem.concat(a, u8, parts);
+}
+
+/// A modulus `10**k` written out in digits (notation, like hex in decimal); any other modulus as it is.
+fn tens(a: Allocator, run: []const u8) Allocator.Error![]const u8 {
+    if (!std.mem.startsWith(u8, run, "10**") or run.len == 4 or !allDigits(run[4..])) return run;
+    const k = std.fmt.parseInt(u8, run[4..], 10) catch return run;
+    if (k > 128) return run;
+    const out = try a.alloc(u8, @as(usize, k) + 1);
+    out[0] = '1';
+    @memset(out[1..], '0');
+    return out;
+}
+
+/// A literal as the frontend gets it: hex in decimal (text plumbing, the value unchanged), else as written.
+fn decimal(a: Allocator, lit: []const u8) Allocator.Error![]u8 {
+    if (!std.mem.startsWith(u8, lit, "0x")) return a.dupe(u8, lit);
+    var v = try std.math.big.int.Managed.init(a);
+    v.setString(16, lit[2..]) catch |e| switch (e) {
+        error.OutOfMemory => return error.OutOfMemory,
+        else => unreachable, // number() admits hex digits only
+    };
+    return v.toString(a, 10, .lower) catch |e| switch (e) {
+        error.OutOfMemory => return error.OutOfMemory,
+        else => unreachable, // base 10 is valid
+    };
+}
+
+/// Decimal digits of a literal (hex: of its value).
+fn litDigits(lit: []const u8) u32 {
+    if (!std.mem.startsWith(u8, lit, "0x")) return @intCast(@min(lit.len, inf));
+    const h = lit.len - 2;
+    if (h <= 32) {
+        const v = std.fmt.parseInt(u128, lit[2..], 16) catch return inf;
+        var d: u32 = 1;
+        var x = v;
+        while (x >= 10) : (x /= 10) d += 1;
+        return d;
+    }
+    return @intCast(@min(h * 121 / 100 + 1, inf));
+}
+
+/// Digits of a constant base raised to `k`, from logarithms of the literal (its own width, not an answer).
+fn constPowDigits(source: []const u8, k: u32) u32 {
+    var s = source;
+    while (s.len >= 2 and s[0] == '(' and s[s.len - 1] == ')') s = s[1 .. s.len - 1];
+    const v: f64 = if (std.mem.startsWith(u8, s, "0x"))
+        @floatFromInt(std.fmt.parseInt(u128, s[2..], 16) catch return inf)
+    else
+        std.fmt.parseFloat(f64, s) catch return inf;
+    if (v < 2 or k == 0) return 1;
+    const d = @as(f64, @floatFromInt(k)) * std.math.log10(v);
+    return @intFromFloat(@min(@floor(d + 1e-9) + 1, @as(f64, inf)));
+}
+
+fn lookup(names: []const Name, n: []const u8) ?Expr {
+    for (names) |m| if (std.mem.eql(u8, m.name, n)) return m.expr;
+    return null;
+}
diff --git a/zig/src/core/runner_trace_named_test.zig b/zig/src/core/runner_trace_named_test.zig
new file mode 100644
index 000000000..2aca398d4
--- /dev/null
+++ b/zig/src/core/runner_trace_named_test.zig
@@ -0,0 +1,248 @@
+//! TF_DSV41_RUNNER_STATED named problems (S1 R4 d_mirror rank 1b): isqrt and edit distance over literals.
+const std = @import("std");
+const api = @import("runner_api.zig");
+const graph = @import("runner_graph.zig");
+const route = @import("runner_graph_route.zig");
+const ropen = @import("runner_open.zig");
+const trace = @import("runner_trace.zig");
+const gpa = std.testing.allocator;
+
+/// The last line's stated computation as display and run, after every line went through one tracer (null: none).
+fn expect(whole: bool, lines: []const []const u8, want: ?[2][]const u8) !void {
+    var t = trace.Tracer.init(gpa);
+    defer t.deinit();
+    t.whole = whole;
+    var got: ?trace.Found = null;
+    for (lines) |l| got = try t.line(l);
+    if (want) |w| {
+        const f = got orelse {
+            std.debug.print("nothing stated (whole {}): {s}\n", .{ whole, lines[lines.len - 1] });
+            return error.TestExpectedStated;
+        };
+        try std.testing.expectEqualStrings(w[0], f.display);
+        try std.testing.expectEqualStrings(w[1], f.run);
+    } else if (got) |f| {
+        std.debug.print("stated (whole {}): {s} from {s}\n", .{ whole, f.display, lines[lines.len - 1] });
+        return error.TestUnexpectedStated;
+    }
+}
+
+fn edit(comptime x: []const u8, comptime y: []const u8) [2][]const u8 {
+    return .{ "edit_distance(\"" ++ x ++ "\", \"" ++ y ++ "\")", std.fmt.comptimePrint(trace.edit_program, .{ x, y }) };
+}
+
+/// The live rank-1b lines (sqrt-a, sqrt-b, edit, edit-b) and the other spellings of the same statements.
+const live = [_]struct { line: []const u8, want: [2][]const u8 }{
+    .{ .line = "We need answer. Need compute integer sqrt of 98765432109876543210. Need use Python.", .want = .{ "isqrt(98765432109876543210)", "from math import isqrt\nprint(isqrt(98765432109876543210))" } },
+    .{ .line = "We need answer integer sqrt of N=123456789876543210123456. Need compute exactly.", .want = .{ "isqrt(123456789876543210123456)", "from math import isqrt\nprint(isqrt(123456789876543210123456))" } },
+    .{ .line = "We need answer compute Levenshtein distance between \"intention\" and \"execution\". Need be careful.", .want = edit("intention", "execution") },
+    .{ .line = "We need answer compute Levenshtein distance between \"algorithm\" and \"logarithm\". Need return distance.", .want = edit("algorithm", "logarithm") },
+    .{ .line = "Compute the edit distance between 'kitten' and 'sitting'.", .want = edit("kitten", "sitting") },
+    .{ .line = "We need the Levenshtein distance from “flaw” to “lawn” exactly.", .want = edit("flaw", "lawn") },
+    .{ .line = "Need isqrt(1,000,000,007).", .want = .{ "isqrt(1000000007)", "from math import isqrt\nprint(isqrt(1000000007))" } },
+    .{ .line = "We need the floor square root of 10,000,000,000,000,000.", .want = .{ "isqrt(10000000000000000)", "from math import isqrt\nprint(isqrt(10000000000000000))" } },
+};
+
+test "runner trace stated: R4 rank-1b named problems are stated with TF_DSV41_RUNNER_STATED and not without it" {
+    for (live) |c| {
+        try expect(true, &.{c.line}, c.want);
+        try expect(false, &.{c.line}, null);
+    }
+}
+
+test "runner trace stated: near misses of a named problem refuse" {
+    for ([_][]const u8{
+        "The edit distance is roughly 5.",
+        "Need edit distance between 'kitten' and 'sitting' is about 3.",
+        "Need edit distance between 'kitten' and 'sitting' maybe.",
+        "Need edit distance between 'kitten' and 'sitting'?",
+        "We need compute Levenshtein kitten to sitting.", // bare words: g2-edit, not literals
+        "Need Levenshtein algorithm to compute.",
+        "Need edit distance between s and t.",
+        "Need edit distance between 'kitten' and t.",
+        "Need edit distance between 'kit\\ten' and 'sitting'.",
+        "Need edit distance between 'abcdefghijklmnopqrstuvwxyzabcdefg' and 'b'.", // 33 bytes
+        "Need sqrt of 98765432109876543210.", // the real root, maybe: no "integer" or "floor"
+        "Need integer sqrt of N.",
+        "Need integer sqrt of 0123.",
+        "Need integer sqrt of 2^64.",
+        "Need integer sqrt of 98765432109876543210.5.",
+        "Need integer sqrt of 98765432109876543210 roughly.",
+        "Need isqrt(98765432109876543210 + 1).",
+        "Need integer sqrt of 1234567890123456789012345678901234567890123456789012345678901234.", // 64 digits
+    }) |line| try expect(true, &.{line}, null);
+}
+
+fn python(code: []const u8) ![]u8 {
+    const r = try std.process.run(gpa, std.testing.io, .{ .argv = &.{ "/usr/bin/python3", "-I", "-S", "-c", code }, .stdout_limit = .limited(4096), .stderr_limit = .limited(4096) });
+    defer gpa.free(r.stderr);
+    errdefer gpa.free(r.stdout);
+    try std.testing.expect(r.term.success());
+    return r.stdout;
+}
+
+/// The engine's runner (runner_open: Dispatch over the bank and circuit) and a routed frontend beside it.
+const Engine = struct {
+    runner: *ropen.Runner,
+    bank: graph.Bank,
+    context: @import("runner_frontend.zig").Context,
+    job: u64 = 0,
+
+    var one: ?*Engine = null;
+
+    /// One per test binary; null without the circuit, bank and clang (TF_RUNNER_CLANG) this needs.
+    fn open() !?*Engine {
+        if (one) |e| return e;
+        const circuit = std.c.getenv("TF_RUNNER_CIRCUIT") orelse return null;
+        const bank = std.c.getenv("TF_RUNNER_GRAPH_BANK") orelse return null;
+        const clang = std.c.getenv("TF_RUNNER_CLANG") orelse return null;
+        // a runner lives as long as the engine: never freed, as in compute_circuit_proof_test
+        const p = std.heap.page_allocator;
+        const e = try p.create(Engine);
+        e.* = .{
+            .runner = try ropen.open(p, .{ .circuit = std.mem.span(circuit), .backend = .graph, .graph_bank = std.mem.span(bank), .workers = 1 }),
+            .bank = try graph.Bank.load(p, std.mem.span(bank)),
+            .context = .{ .io = std.testing.io, .compiler = .{ .clang = std.mem.span(clang), .linker = if (std.c.getenv("TF_RUNNER_LLD")) |l| std.mem.span(l) else null } },
+        };
+        one = e;
+        return e;
+    }
+
+    /// The trace cell for `run` (a repl cell, no prior) at frontend step `budget`; null: abstained.
+    fn translate(e: *Engine, run: []const u8, budget: usize) !?api.Program {
+        e.context.compiler.step_budget = budget;
+        var routed: route.Routed = .{ .inner = e.context.frontend(), .bank = &e.bank };
+        const f = routed.frontend();
+        const tr = try f.translate(f.ctx, gpa, .{ .form = .repl, .lang = "python", .code = run });
+        return if (tr == .program) tr.program else null;
+    }
+
+    fn exec(e: *Engine, p: api.Program) ![]u8 {
+        const b = e.runner.backend;
+        e.job += 1;
+        const job = try b.start(e.job, p, e.runner.cfg.max_steps);
+        const res = while (true) switch (b.poll(job)) {
+            .running => std.Thread.yield() catch {},
+            .done => |r| break r,
+        };
+        defer b.release(e.job);
+        try std.testing.expectEqual(api.Status.ok, res.status);
+        return gpa.dupe(u8, res.out);
+    }
+};
+
+test "runner proof: trace stated: isqrt runs on the bank's plan and prints CPython's root; a mutated input follows (TF_RUNNER_GRAPH_BANK)" {
+    const e = try Engine.open() orelse return error.SkipZigTest;
+    for ([_][2][]const u8{ .{ live[0].want[1], "98765432109876543211" }, .{ live[1].want[1], "123456789876543210123457" }, .{ live[6].want[1], "" } }) |c| {
+        const p = (try e.translate(c[0], 10522)) orelse return error.TestExpectedGraph;
+        defer gpa.free(p.bytes);
+        try std.testing.expect(p.kind == .graph);
+        const want = try python(c[0]);
+        defer gpa.free(want);
+        const out = try e.exec(p);
+        defer gpa.free(out);
+        try std.testing.expectEqualStrings(want, out);
+        if (c[1].len == 0) continue;
+        // the circuit owns the root: the input changed in the packet prints CPython's root of the changed input
+        const at = std.mem.indexOf(u8, c[0], "isqrt(").? + 6;
+        const n = c[0][at .. c[0].len - 2];
+        const from = try std.fmt.allocPrint(gpa, "\"{s}\"", .{n});
+        defer gpa.free(from);
+        const to = try std.fmt.allocPrint(gpa, "\"{s}\"", .{c[1]});
+        defer gpa.free(to);
+        try std.testing.expectEqual(@as(usize, 1), std.mem.count(u8, p.bytes, from));
+        const mutated = try std.mem.replaceOwned(u8, gpa, p.bytes, from, to);
+        defer gpa.free(mutated);
+        const src = try std.fmt.allocPrint(gpa, "from math import isqrt\nprint(isqrt({s}))", .{c[1]});
+        defer gpa.free(src);
+        const want2 = try python(src);
+        defer gpa.free(want2);
+        const out2 = try e.exec(.{ .kind = .graph, .bytes = mutated });
+        defer gpa.free(out2);
+        try std.testing.expectEqualStrings(want2, out2);
+    }
+}
+
+fn nowNs() u64 {
+    var ts: std.c.timespec = undefined;
+    _ = std.c.clock_gettime(.MONOTONIC, &ts);
+    return @as(u64, @intCast(ts.sec)) * std.time.ns_per_s + @as(u64, @intCast(ts.nsec));
+}
+
+/// Deterministic printable strings (no `"` or `\`) for the larger goldens: a small alphabet plus a few edge bytes.
+fn text(rand: std.Random, buf: []u8) []const u8 {
+    const alphabet = " ~{}'abcdeABC019";
+    for (buf) |*c| c.* = alphabet[rand.intRangeLessThan(usize, 0, alphabet.len)];
+    return buf;
+}
+
+test "runner proof: trace stated: edit distance runs on the bank as a DP packet at the default budget, up to 32x32; a mutated character follows (TF_RUNNER_GRAPH_BANK)" {
+    const e = try Engine.open() orelse return error.SkipZigTest;
+    const packet = @import("runner_graph_packet.zig");
+    const dp = @import("runner_graph_edit.zig");
+    var prng = std.Random.DefaultPrng.init(20261103);
+    const rand = prng.random();
+    var bufs: [7][2][dp.max_len]u8 = undefined;
+    const sizes = [_][2]usize{ .{ 1, 1 }, .{ 1, 32 }, .{ 32, 1 }, .{ 17, 31 }, .{ 25, 32 }, .{ 28, 28 }, .{ 32, 32 } };
+    const pairs = [_][2][]const u8{ .{ "kitten", "sitting" }, .{ "flaw", "lawn" }, .{ "intention", "execution" }, .{ "algorithm", "logarithm" }, .{ "abc", "yabd" } };
+    var cases: [pairs.len + sizes.len][2][]const u8 = undefined;
+    @memcpy(cases[0..pairs.len], &pairs);
+    for (sizes, 0..) |s, k| cases[pairs.len + k] = .{ text(rand, bufs[k][0][0..s[0]]), text(rand, bufs[k][1][0..s[1]]) };
+    // the engine's own frontend (runner_open: routed, default compile budget) and its Dispatch backend
+    const f = e.runner.frontend;
+    for (cases) |c| {
+        const code = try std.fmt.allocPrint(gpa, trace.edit_program, .{ c[0], c[1] });
+        defer gpa.free(code);
+        const want = try python(code);
+        defer gpa.free(want);
+        const t0 = nowNs();
+        const tr = try f.translate(f.ctx, gpa, .{ .form = .repl, .lang = "python", .code = code });
+        const t1 = nowNs();
+        if (c[0].len * c[1].len * dp.ops_per_cell > packet.max_ops) {
+            // past a packet's ops: never the graph (the RV32 frontend keeps the cell, and refuses this size)
+            if (tr == .program) {
+                defer gpa.free(tr.program.bytes);
+                try std.testing.expect(tr.program.kind != .graph);
+            }
+            std.debug.print("EDWALL\t{d}x{d}\tover max_ops {d}: not graph\n", .{ c[0].len, c[1].len, packet.max_ops });
+            continue;
+        }
+        if (tr != .program or tr.program.kind != .graph) {
+            std.debug.print("not a graph program: {d}x{d}\n", .{ c[0].len, c[1].len });
+            return error.TestExpectedGraph;
+        }
+        defer gpa.free(tr.program.bytes);
+        const out = try e.exec(tr.program);
+        defer gpa.free(out);
+        const t2 = nowNs();
+        try std.testing.expectEqualStrings(want, out);
+        std.debug.print("EDWALL\t{d}x{d}\ttranslate_ms={d:.1}\trun_ms={d:.1}\tbytes={d}\tout={s}", .{ c[0].len, c[1].len, @as(f64, @floatFromInt(t1 - t0)) / 1e6, @as(f64, @floatFromInt(t2 - t1)) / 1e6, tr.program.bytes.len, out });
+        const display = try std.fmt.allocPrint(gpa, "edit_distance(\"{s}\", \"{s}\")", .{ c[0], c[1] });
+        defer gpa.free(display);
+        const line = (try trace.owned(gpa, "[exact: {}]", display, false, out, false)) orelse return error.TestExpectedOwned;
+        defer gpa.free(line);
+        const golden = try std.fmt.allocPrint(gpa, "[exact: {s} = {s}]\n", .{ display, std.mem.trimEnd(u8, want, "\n") });
+        defer gpa.free(golden);
+        try std.testing.expectEqualStrings(golden, line);
+        // the circuit compares the characters: the first one changed in the packet prints CPython's distance for it
+        if (c[0].len == 0) continue;
+        const swap: u8 = if (c[0][0] == 'q') 'r' else 'q';
+        const from = try std.fmt.allocPrint(gpa, "\"values\":[\"{d}\"", .{c[0][0]});
+        defer gpa.free(from);
+        const to = try std.fmt.allocPrint(gpa, "\"values\":[\"{d}\"", .{swap});
+        defer gpa.free(to);
+        try std.testing.expectEqual(@as(usize, 1), std.mem.count(u8, tr.program.bytes, from));
+        const mutated = try std.mem.replaceOwned(u8, gpa, tr.program.bytes, from, to);
+        defer gpa.free(mutated);
+        const changed = try gpa.dupe(u8, c[0]);
+        defer gpa.free(changed);
+        changed[0] = swap;
+        const src = try std.fmt.allocPrint(gpa, trace.edit_program, .{ changed, c[1] });
+        defer gpa.free(src);
+        const want2 = try python(src);
+        defer gpa.free(want2);
+        const out2 = try e.exec(.{ .kind = .graph, .bytes = mutated });
+        defer gpa.free(out2);
+        try std.testing.expectEqualStrings(want2, out2);
+    }
+}
