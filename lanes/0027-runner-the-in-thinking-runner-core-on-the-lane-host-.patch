+++ b/zig/src/core/runner_abstain.zig
@@ -0,0 +1,146 @@
+//! Abstain records (PREFIX_ABSTAINS, with CELLS): each abstained cell's source, reason, stage and decision point.
+const std = @import("std");
+const receipt = @import("runner_receipt.zig");
+const Allocator = std.mem.Allocator;
+
+pub const schema = 1;
+
+/// Why a cell abstained, as one stable name; its refusal stage follows from it (`stage`).
+pub const Reason = enum {
+    context, // the reply's own number context (exact inline math in a Python-float reply)
+    language, // a `calc` / `exact` cell with exact cells off
+    unsupported,
+    syntax,
+    name,
+    too_long,
+    too_big, // the frontend's own tags (runner_api.Abstain), as it gave them
+    out_of_memory, // the backend start, or keeping its result
+    backend_abstain,
+    budget,
+    fault, // the run: its own abstain (error_name: its tag), the step budget, a machine fault
+    empty_output,
+    multiline_output, // an inline value that is not one line
+    mark_value_shape, // INLINE_MARK: a blank or multi-line value cannot carry the mark
+    token_cap, // the owned text would pass the token cap
+    trace_shape, // a trace run that did not print one value
+};
+
+pub fn stage(r: Reason) []const u8 {
+    return switch (r) {
+        .context => "context",
+        .language, .unsupported, .syntax, .name, .too_long, .too_big => "frontend",
+        .out_of_memory => "dispatch",
+        .backend_abstain, .budget, .fault => "execute",
+        .empty_output, .multiline_output, .mark_value_shape, .token_cap, .trace_shape => "own",
+    };
+}
+
+/// One abstained cell at its decision; the log fills the reply's coordinates there, as an owned record's.
+pub const Abstain = struct {
+    cell: u32,
+    reason: Reason,
+    error_name: ?[]const u8 = null, // the original tag (static text)
+    held_ms: u64 = 0,
+    steps: u64 = 0,
+    content: bool = false,
+    at: u64 = 0,
+    token: u32 = 0,
+    round: u32 = 0,
+};
+
+/// Where cell `cell`'s source closed: its field and that field's bytes through the closing token.
+pub const Close = struct { cell: u32, content: bool, end: u64 };
+
+/// Why a settled cell abstained, read off its translation and result; `hint`: what only its caller knows.
+pub fn reason(c: anytype, hint: ?Reason) struct { Reason, ?[]const u8 } {
+    if (hint) |h| return .{ h, null };
+    switch (c.translation) {
+        .abstain => |t| switch (t) {
+            inline else => |x| return .{ @field(Reason, @tagName(x)), @tagName(x) },
+        },
+        .program => {},
+    }
+    const res = c.result orelse return .{ .out_of_memory, "OutOfMemory" };
+    return switch (res.status) {
+        .abstain => .{ .backend_abstain, if (res.abstain) |a| @tagName(a) else null },
+        .budget => .{ .budget, "budget" },
+        .fault => .{ .fault, "fault" },
+        .ok => if (res.out.len == 0) .{ .empty_output, null } else if (std.mem.indexOfScalar(u8, std.mem.trimEnd(u8, res.out, "\n"), '\n') != null) .{ .multiline_output, null } else .{ .mark_value_shape, null },
+    };
+}
+
+/// Cell `index` abstains at its decision: told, counted, and recorded when abstain records are on.
+pub fn told(s: anytype, c: anytype, index: u32, held_ms: u64, hint: ?Reason) void {
+    const why = reason(c, hint);
+    c.abstained = true;
+    c.told = .abstained;
+    s.abstained_n += 1;
+    s.rec.abstained(s.r.gpa, .{ .cell = index, .reason = why[0], .error_name = why[1], .held_ms = held_ms, .steps = if (c.result) |r| r.steps else 0 });
+}
+
+/// The receipt's abstain fields after its records: `abstains`, completeness, and the runner config they ran under.
+pub fn write(o: *std.ArrayList(u8), gpa: Allocator, cells: anytype, l: anytype, cfg: anytype) Allocator.Error!void {
+    try o.print(gpa, ",\"abstain_schema\":{d},\"abstains\":[", .{schema});
+    for (l.abstains.items, 0..) |a, i| {
+        if (i > 0) try o.append(gpa, ',');
+        try one(o, gpa, cells, l, a);
+    }
+    // op, op_families, plan width and route attempts: the frontend gives the runner only its abstain tag
+    try o.print(gpa, "],\"abstains_complete\":{},\"abstains_dropped\":{d},\"abstain_frontend_detail\":false", .{ l.dropped == 0 and !l.anchors_lost, l.dropped });
+    if (@TypeOf(cfg) != @TypeOf(null)) try o.print(gpa, ",\"runner_config\":{{\"backend\":\"{t}\",\"exact\":{},\"sync_graph\":{},\"inline_mark\":{},\"settle_us\":{d},\"max_steps\":{d},\"max_tokens\":{d},\"compile_steps\":{d},\"compile\":{},\"inline_math\":{},\"trace\":{}}}", .{ cfg.backend, cfg.exact, cfg.sync_graph, cfg.inline_mark, cfg.settle_us, cfg.max_steps, cfg.max_tokens, cfg.compile_steps, cfg.compile, cfg.scan.inline_math, cfg.scan.trace });
+}
+
+fn one(o: *std.ArrayList(u8), gpa: Allocator, cells: anytype, l: anytype, a: Abstain) Allocator.Error!void {
+    const c = cells[a.cell];
+    const kind: []const u8 = if (c.translation == .program) @tagName(c.translation.program.kind) else "none";
+    const route: []const u8 = if (c.translation != .program) "none" else if (c.translation.program.kind == .graph) "graph" else "circuit";
+    try o.print(gpa, "{{\"cell\":{d},\"form\":\"{s}\",", .{ a.cell, receipt.form_names[if (c.stated != null) 3 else @backingInt(c.form)] });
+    try receipt.text(o, gpa, "lang", c.lang);
+    try receipt.text(o, gpa, "code", c.code);
+    var digest: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(c.code, &digest, .{});
+    try o.print(gpa, "\"span_sha256\":\"{s}\",\"span_len\":{d},\"prior\":[", .{ std.fmt.bytesToHex(digest, .lower), c.code.len });
+    // the notebook its frontend was given: earlier code cells, never inline values or stated computations (open)
+    var n: usize = 0;
+    if (c.stated == null) for (cells[0..a.cell]) |p| if (p.form != .inline_expr and p.stated == null) {
+        if (n > 0) try o.append(gpa, ',');
+        try receipt.quoted(o, gpa, p.code);
+        n += 1;
+    };
+    try o.appendSlice(gpa, "],");
+    if (c.stated) |st| try receipt.text(o, gpa, "display", st.display) else try o.appendSlice(gpa, "\"display\":null,");
+    const src = source(l, a.cell, if (c.stated) |st| st.display else c.code);
+    if (src.close) |cl| {
+        try o.print(gpa, "\"source_field\":\"{s}\",", .{field(cl.content)});
+        if (src.at) |at| try o.print(gpa, "\"source_at\":{d},\"source_end\":{d},", .{ at, src.end }) else try o.appendSlice(gpa, "\"source_at\":null,\"source_end\":null,");
+        try o.print(gpa, "\"source_close_at\":{d},", .{cl.end});
+    } else try o.appendSlice(gpa, "\"source_field\":null,\"source_at\":null,\"source_end\":null,\"source_close_at\":null,");
+    var next = l.tokens;
+    for (l.records.items) |r| if (r.token > a.token and r.token < next) {
+        next = r.token;
+    };
+    for (l.abstains.items) |b| if (b.token > a.token and b.token < next) {
+        next = b.token;
+    };
+    try o.print(gpa, "\"program_kind\":\"{s}\",\"backend_route\":\"{s}\",\"stage\":\"{s}\",\"reason\":\"{t}\",", .{ kind, route, stage(a.reason), a.reason });
+    if (a.error_name) |e| try o.print(gpa, "\"error_name\":\"{s}\",", .{e}) else try o.appendSlice(gpa, "\"error_name\":null,");
+    try o.print(gpa, "\"resume_field\":\"{s}\",\"resume_at\":{d},\"resume_token\":{d},\"round\":{d},\"next_decision_token\":{d},\"reply_tokens\":{d},\"owned_tokens\":0,\"steps\":{d},\"held_ms\":{d}}}", .{ field(a.content), a.at, a.token, a.round, next, l.tokens, a.steps, a.held_ms });
+}
+
+fn field(content: bool) []const u8 {
+    return if (content) "content" else "reasoning";
+}
+
+/// The source's bytes [at, end): its last exact copy before the cell closed (none: normalized, e.g. REPL prompts cut).
+fn source(l: anytype, cell: u32, needle: []const u8) struct { close: ?Close, at: ?u64 = null, end: u64 = 0 } {
+    const cl = for (l.closes.items) |x| {
+        if (x.cell == cell) break x;
+    } else return .{ .close = null };
+    const text = l.text[@intFromBool(cl.content)].items;
+    const hay = text[0..@min(text.len, cl.end)];
+    for ([_][]const u8{ needle, std.mem.trim(u8, needle, " \t\r\n") }) |want| {
+        if (want.len == 0) continue;
+        if (std.mem.lastIndexOf(u8, hay, want)) |at| return .{ .close = cl, .at = at, .end = at + want.len };
+    }
+    return .{ .close = cl };
+}
diff --git a/zig/src/core/runner_abstain_test.zig b/zig/src/core/runner_abstain_test.zig
new file mode 100644
index 000000000..cbc74377d
--- /dev/null
+++ b/zig/src/core/runner_abstain_test.zig
@@ -0,0 +1,260 @@
+//! Abstain records end to end on a lane host (each reason forced, records on/off byte-identical) and on a fake session.
+const std = @import("std");
+const rapi = @import("runner_api.zig");
+const scan = @import("runner_scan.zig");
+const records = @import("runner_receipt.zig");
+const abstain = @import("runner_abstain.zig");
+const rt = @import("runner_test.zig");
+
+const gpa = std.testing.allocator;
+const t = std.testing;
+
+const Ab = struct { cell: u32, form: []const u8, code: []const u8, display: ?[]const u8, prior: []const []const u8, source_field: ?[]const u8, source_at: ?u64, source_end: ?u64, source_close_at: ?u64, program_kind: []const u8, backend_route: []const u8, stage: []const u8, reason: []const u8, error_name: ?[]const u8, resume_field: []const u8, resume_at: u64, resume_token: u32, round: u32, next_decision_token: u32, reply_tokens: u32, owned_tokens: u32, steps: u64, held_ms: u64 };
+const Count = struct { closed: u32, owned: u32, abstained: u32 };
+const Receipt = struct { fence: Count, repl: Count, @"inline": Count, trace: Count, abstain_schema: u32 = 0, abstains: []const Ab = &.{}, abstains_complete: bool = false, abstains_dropped: u32 = 99 };
+
+fn parse(receipt: []const u8) !std.json.Parsed(Receipt) {
+    return std.json.parseFromSlice(Receipt, gpa, receipt, .{ .ignore_unknown_fields = true, .allocate = .alloc_always });
+}
+
+const mul_lead = "Need multiply A=987654 B=137. Need exact product.\nLet's do long multiplication.\n";
+const fence_lead = "```python\nprint(2**100)\n```\nResult:\n";
+
+/// `receipt` with its wall-clock fields (held_ms, resume_ms) zeroed: everything else must match byte for byte.
+fn untimed(receipt: []const u8) ![]u8 {
+    var out: std.ArrayList(u8) = .empty;
+    var i: usize = 0;
+    while (i < receipt.len) {
+        const key = for ([_][]const u8{ "\"held_ms\":", "\"resume_ms\":" }) |k| {
+            if (std.mem.startsWith(u8, receipt[i..], k)) break k;
+        } else null;
+        if (key) |k| {
+            try out.appendSlice(gpa, k);
+            try out.append(gpa, '0');
+            i += k.len;
+            while (i < receipt.len and std.ascii.isDigit(receipt[i])) i += 1;
+        } else {
+            try out.append(gpa, receipt[i]);
+            i += 1;
+        }
+    }
+    return out.toOwnedSlice(gpa);
+}
+
+/// One forced abstain: the reply, the runner's options and the fake run's result; what its record must say.
+const Case = struct { lead: []const u8, guess: []const u8 = "42", o: rt.Opts = .{}, result: ?rapi.Result = null, reason: []const u8, stage: []const u8, error_name: ?[]const u8 = null, kind: []const u8 = "calc", source: ?[]const u8 = null };
+
+const cases = [_]Case{
+    .{ .lead = "```python\nprint(undefined_total)\n```\nResult:\n", .reason = "name", .stage = "frontend", .error_name = "name", .kind = "none", .source = "print(undefined_total)\n" },
+    .{ .lead = "```calc\n2**100\n```\nResult:\n", .reason = "language", .stage = "frontend", .error_name = "language", .kind = "none", .source = "2**100\n" },
+    .{ .lead = "In Python, as a float: 1.5+2.25 =", .o = .{ .inline_math = true }, .reason = "context", .stage = "context", .error_name = "context", .kind = "none", .source = "1.5+2.25" },
+    .{ .lead = "So 99 * 13 =", .o = .{ .inline_math = true }, .reason = "fault", .stage = "execute", .error_name = "fault", .source = "99 * 13" },
+    .{ .lead = "So 47 * 83 =", .o = .{ .inline_math = true }, .result = .{ .status = .budget, .out = "3901" }, .reason = "budget", .stage = "execute", .error_name = "budget" },
+    .{ .lead = "So 47 * 83 =", .o = .{ .inline_math = true }, .result = .{ .status = .abstain, .abstain = .too_big }, .reason = "backend_abstain", .stage = "execute", .error_name = "too_big" },
+    .{ .lead = fence_lead, .result = .{ .status = .ok, .out = "" }, .reason = "empty_output", .stage = "own", .source = "print(2**100)\n" },
+    .{ .lead = "So 47 * 83 =", .o = .{ .inline_math = true }, .result = .{ .status = .ok, .out = "3\n4\n" }, .reason = "multiline_output", .stage = "own" },
+    .{ .lead = "So 47 * 83 =", .o = .{ .inline_math = true, .inline_mark = true }, .result = .{ .status = .ok, .out = " \n" }, .reason = "mark_value_shape", .stage = "own" },
+    .{ .lead = "So 47 * 83 =", .o = .{ .inline_math = true, .inline_mark = true, .result_tokens = 5 }, .reason = "token_cap", .stage = "own" },
+    .{ .lead = mul_lead, .guess = "ok", .o = .{ .trace = true }, .result = .{ .status = .ok, .out = "1\n2\n" }, .reason = "trace_shape", .stage = "own" },
+    .{ .lead = mul_lead, .guess = "ok", .o = .{ .trace = true, .result_tokens = 5 }, .result = .{ .status = .ok, .out = "135308598\n" }, .reason = "token_cap", .stage = "own" },
+};
+
+/// The reply and receipt of `c` with abstain records on or off.
+fn run(c: Case, on: bool) !struct { text: []u8, receipt: []u8 } {
+    var back: rt.Back = .{ .result = c.result };
+    defer back.deinit();
+    var m = [_]rt.Model{.{ .lead = c.lead, .guess = c.guess }};
+    var sums: [1][]u8 = undefined;
+    var o = c.o;
+    o.summaries = &sums;
+    o.abstains = on;
+    const texts = try rt.replies(&m, o, &back);
+    defer gpa.free(texts);
+    return .{ .text = texts[0], .receipt = sums[0] };
+}
+
+test "runner abstain records: each reason forced on a lane host, with its source, stage and decision point" {
+    for (cases) |c| {
+        const on = try run(c, true);
+        defer gpa.free(on.text);
+        defer gpa.free(on.receipt);
+        const p = try parse(on.receipt);
+        defer p.deinit();
+        const r = p.value;
+        errdefer std.debug.print("case {s} / {s}: {s}\n", .{ c.lead, c.reason, on.receipt });
+        // the model's own text stands: its guess right after the decision, nothing owned
+        try t.expect(std.mem.endsWith(u8, on.text, "\nDone."));
+        try t.expectEqualStrings(c.guess, on.text[on.text.len - 6 - c.guess.len ..][0..c.guess.len]);
+        try t.expectEqual(1, r.abstain_schema);
+        try t.expect(r.abstains_complete);
+        try t.expectEqual(0, r.abstains_dropped);
+        try t.expectEqual(1, r.abstains.len);
+        // conservation: one record per abstained cell over every form's counter
+        try t.expectEqual(r.abstains.len, r.fence.abstained + r.repl.abstained + r.@"inline".abstained + r.trace.abstained);
+        const a = r.abstains[0];
+        try t.expectEqualStrings(c.reason, a.reason);
+        try t.expectEqualStrings(c.stage, a.stage);
+        if (c.error_name) |e| try t.expectEqualStrings(e, a.error_name.?);
+        try t.expectEqualStrings(c.kind, a.program_kind);
+        try t.expectEqualStrings(if (std.mem.eql(u8, c.kind, "none")) "none" else "circuit", a.backend_route);
+        try t.expectEqual(0, a.owned_tokens);
+        // one token a character: the decision is the trigger's end, where the model's own continuation begins
+        try t.expectEqualStrings("content", a.resume_field);
+        try t.expectEqual(a.resume_at, a.resume_token);
+        try t.expect(a.resume_at <= c.lead.len and a.resume_at + 2 >= c.lead.len);
+        try t.expectEqualStrings(c.lead[0..a.resume_at], on.text[0..a.resume_at]);
+        try t.expectEqual(on.text.len + 1, a.reply_tokens); // the EOS is a committed token too
+        try t.expectEqual(a.reply_tokens, a.next_decision_token);
+        try t.expectEqualStrings("content", a.source_field.?);
+        try t.expect(a.source_close_at.? <= a.resume_at);
+        if (c.source) |want| {
+            try t.expectEqualStrings(want, on.text[a.source_at.?..a.source_end.?]);
+            try t.expect(std.mem.eql(u8, want, a.code) or std.mem.eql(u8, want, std.mem.trim(u8, a.code, " ")));
+        }
+        if (a.source_at) |at| try t.expectEqualStrings(std.mem.trim(u8, a.code, " \t\r\n"), std.mem.trim(u8, on.text[at..a.source_end.?], " \t\r\n"));
+        if (std.mem.eql(u8, a.form, "trace")) try t.expect(a.display != null) else try t.expect(a.display == null);
+        // records off: the same tokens, and the receipt is the one before abstain records, byte for byte
+        const off = try run(c, false);
+        defer gpa.free(off.text);
+        defer gpa.free(off.receipt);
+        try t.expectEqualStrings(off.text, on.text);
+        try t.expect(std.mem.indexOf(u8, off.receipt, "\"abstains") == null and std.mem.indexOf(u8, off.receipt, "abstain_") == null);
+        const on_u = try untimed(on.receipt);
+        defer gpa.free(on_u);
+        const off_u = try untimed(off.receipt);
+        defer gpa.free(off_u);
+        try t.expect(std.mem.startsWith(u8, on_u, off_u[0 .. off_u.len - 1]));
+        try t.expect(std.mem.startsWith(u8, on_u[off_u.len - 1 ..], ",\"abstain_schema\":1,\"abstains\":["));
+    }
+}
+
+test "runner abstain records: the reason of every frontend tag, a lost start, and the run's own abstain tag" {
+    const Fake = struct { translation: rapi.Translation, result: ?rapi.Result = null };
+    for (std.enums.values(rapi.Abstain)) |tag| {
+        const why = abstain.reason(Fake{ .translation = .{ .abstain = tag } }, null);
+        try t.expectEqualStrings(@tagName(tag), @tagName(why[0]));
+        try t.expectEqualStrings(@tagName(tag), why[1].?);
+        try t.expectEqualStrings(if (tag == .context) "context" else "frontend", abstain.stage(why[0]));
+    }
+    const prog: rapi.Translation = .{ .program = .{ .kind = .graph, .bytes = "" } };
+    const lost = abstain.reason(Fake{ .translation = prog }, null);
+    try t.expectEqual(abstain.Reason.out_of_memory, lost[0]);
+    try t.expectEqualStrings("dispatch", abstain.stage(lost[0]));
+    const bare = abstain.reason(Fake{ .translation = prog, .result = .{ .status = .abstain } }, null);
+    try t.expectEqual(abstain.Reason.backend_abstain, bare[0]);
+    try t.expect(bare[1] == null);
+    try t.expectEqual(abstain.Reason.token_cap, abstain.reason(Fake{ .translation = prog, .result = .{ .status = .ok, .out = "1" } }, .token_cap)[0]);
+}
+
+/// The fields records.write and abstain.told read off a runner.Session and its cells.
+const FakeCell = struct {
+    form: rapi.Form = .fence,
+    stated: ?scan.Stated = null,
+    told: enum { none, owned, abstained } = .none,
+    abstained: bool = false,
+    owned_tokens: u32 = 0,
+    translation: rapi.Translation = .{ .program = .{ .kind = .graph, .bytes = "" } },
+    result: ?rapi.Result = .{ .status = .fault, .steps = 7 },
+    lang: []const u8 = "python",
+    code: []const u8 = "x = 1\n",
+};
+
+const FakeSession = struct {
+    r: struct { gpa: std.mem.Allocator = gpa } = .{},
+    cells: struct { items: []const *FakeCell },
+    held_ms: u64 = 0,
+    resume_ms: u64 = 0,
+    abstained_n: u32 = 0,
+    rec: records.Log = .{ .abstains_on = true },
+    fn feed(s: *FakeSession, text: []const u8) !void {
+        for (text) |c| try s.rec.token(gpa, c, &[_]u8{c}, false);
+    }
+};
+
+test "runner abstain records: mixed decisions, the source's last copy, a normalized source, the next decision, completeness" {
+    var c0: FakeCell = .{ .code = "y = 2\n" };
+    var c1: FakeCell = .{ .form = .repl, .code = "y\nz\n" };
+    var c2: FakeCell = .{ .code = "y = 2\n", .translation = .{ .abstain = .syntax }, .result = null };
+    var s: FakeSession = .{ .cells = .{ .items = &.{ &c0, &c1, &c2 } } };
+    defer s.rec.deinit(gpa);
+    try s.feed("```python\ny = 2\n```\n");
+    s.rec.closed(gpa, 0);
+    try s.feed("Out:");
+    try s.rec.owned(gpa, 0, &.{ 'O', 'K' });
+    c0.told = .owned;
+    try s.feed("OK\n>>> y\n>>> z\n");
+    s.rec.closed(gpa, 1);
+    abstain.told(&s, &c1, 1, 3, null); // fault: the run's own status
+    try s.feed("5\nAgain:\n```python\ny = 2\n```\n");
+    s.rec.closed(gpa, 2);
+    s.rec.rounds = 4;
+    abstain.told(&s, &c2, 2, 0, null);
+    try s.feed("tail");
+    const got = records.write(&s);
+    const p = try parse(got);
+    defer p.deinit();
+    const r = p.value;
+    try t.expectEqual(2, s.abstained_n);
+    try t.expect(c1.told == .abstained and c1.abstained and c2.told == .abstained);
+    try t.expectEqual(2, r.abstains.len);
+    const a1 = r.abstains[0];
+    try t.expectEqualStrings("fault", a1.reason);
+    try t.expectEqual(7, a1.steps);
+    try t.expectEqual(3, a1.held_ms);
+    try t.expect(a1.source_at == null); // a REPL line's code is not its bytes in the reply (the prompt is cut)
+    try t.expectEqual(1, a1.prior.len);
+    try t.expectEqualStrings("y = 2\n", a1.prior[0]);
+    try t.expectEqual(a1.resume_token, a1.resume_at);
+    try t.expectEqual(r.abstains[1].resume_token, a1.next_decision_token); // the next decision: the later abstain
+    const a2 = r.abstains[1];
+    const text = "```python\ny = 2\n```\nOut:OK\n>>> y\n>>> z\n5\nAgain:\n```python\ny = 2\n```\ntail";
+    try t.expectEqualStrings("syntax", a2.reason);
+    try t.expectEqualStrings("none", a2.program_kind);
+    try t.expectEqual(std.mem.lastIndexOf(u8, text[0..a2.source_close_at.?], "y = 2\n").?, a2.source_at.?); // its own copy
+    try t.expect(a2.source_at.? > 10);
+    try t.expectEqual(4, a2.round);
+    try t.expectEqual(text.len, a2.next_decision_token);
+    try t.expectEqual(text.len, a2.reply_tokens);
+    try t.expectEqual(2, a2.prior.len);
+    try t.expect(r.abstains_complete);
+    // a record lost to memory: the receipt says the census is incomplete
+    s.rec.dropped = 1;
+    const lossy = try parse(records.write(&s));
+    defer lossy.deinit();
+    try t.expect(!lossy.value.abstains_complete);
+    try t.expectEqual(1, lossy.value.abstains_dropped);
+    // abstain records off: nothing kept, nothing written, the receipt as before
+    var c3: FakeCell = .{};
+    var off: FakeSession = .{ .cells = .{ .items = &.{&c3} }, .rec = .{} };
+    defer off.rec.deinit(gpa);
+    try off.feed("abc");
+    off.rec.closed(gpa, 0);
+    abstain.told(&off, &c3, 0, 0, null);
+    try t.expectEqual(0, off.rec.text[1].items.len);
+    try t.expectEqual(0, off.rec.abstains.items.len);
+    try t.expectEqual(1, off.abstained_n);
+    try t.expect(std.mem.endsWith(u8, records.write(&off), "\"cells\":[]}"));
+}
+
+test "runner abstain records: PREFIX_ABSTAINS is off unless 1, and a session records abstains only with cells on" {
+    const K = struct {
+        var set: []const [2][]const u8 = &.{};
+        fn get(name: []const u8) ?[]const u8 {
+            for (set) |kv| if (std.mem.eql(u8, kv[0], name)) return kv[1];
+            return null;
+        }
+    };
+    const runner = @import("runner.zig");
+    K.set = &.{ .{ "TF_R", "1" }, .{ "TF_R_CIRCUIT", "/c.bin" } };
+    try t.expect(!(try runner.Config.parse(&K.get, "TF_R")).?.abstains);
+    K.set = &.{ .{ "TF_R", "1" }, .{ "TF_R_CIRCUIT", "/c.bin" }, .{ "TF_R_ABSTAINS", "1" } };
+    try t.expect((try runner.Config.parse(&K.get, "TF_R")).?.abstains);
+    K.set = &.{ .{ "TF_R", "1" }, .{ "TF_R_CIRCUIT", "/c.bin" }, .{ "TF_R_ABSTAINS", "2" } };
+    try t.expectError(error.BadKnob, runner.Config.parse(&K.get, "TF_R"));
+    // cells off: no records of either kind, whatever ABSTAINS says
+    const c: Case = .{ .lead = "```python\nprint(undefined_total)\n```\nResult:\n", .o = .{ .cells = false }, .reason = "name", .stage = "frontend" };
+    const off = try run(c, true);
+    defer gpa.free(off.text);
+    defer gpa.free(off.receipt);
+    try t.expect(std.mem.indexOf(u8, off.receipt, "\"abstains") == null and std.mem.indexOf(u8, off.receipt, "\"cells\"") == null);
+}
diff --git a/zig/src/core/runner_binding.zig b/zig/src/core/runner_binding.zig
new file mode 100644
index 000000000..4aff00824
--- /dev/null
+++ b/zig/src/core/runner_binding.zig
@@ -0,0 +1,64 @@
+//! A family's binding of the in-model runner: the knob prefix it boots from, generic TF_RUNNER* or its own older names.
+const std = @import("std");
+const runner = @import("runner.zig");
+const log = std.log.scoped(.runner);
+
+pub const Binding = struct {
+    prefix: []const u8 = "TF_RUNNER", // PREFIX=1 enables; PREFIX_CIRCUIT, PREFIX_FORMS, ... (runner.Config.parse)
+    alias: ?[]const u8 = null, // the family's own older names for the same knobs: a boot switches one or the other on
+
+    /// The runner's config under the prefix whose switch the boot set; both switches set is error.BadKnob.
+    pub fn parse(comptime b: Binding, get: *const fn ([]const u8) ?[]const u8) error{BadKnob}!?runner.Config {
+        // by the switch alone: TF_RUNNER_CIRCUIT, _CLANG and _LLD also name tools for tests and image checks
+        const old = b.alias orelse return runner.Config.parse(get, b.prefix);
+        if (!set(get(old))) return runner.Config.parse(get, b.prefix);
+        if (set(get(b.prefix))) {
+            log.warn("turn the in-model runner on with {s} or {s}, not both", .{ b.prefix, old });
+            return error.BadKnob;
+        }
+        return runner.Config.parse(get, old);
+    }
+
+    /// The prefix a boot's knobs are read under: the alias when its switch is set, else the generic one.
+    pub fn active(comptime b: Binding, get: *const fn ([]const u8) ?[]const u8) []const u8 {
+        const old = b.alias orelse return b.prefix;
+        return if (set(get(old))) old else b.prefix;
+    }
+};
+
+fn set(v: ?[]const u8) bool {
+    return if (v) |s| s.len > 0 else false;
+}
+
+/// DeepSeek-V4.1: the generic names, or TF_DSV41_RUNNER* as before.
+pub const dsv41: Binding = .{ .alias = "TF_DSV41_RUNNER" };
+/// Qwen3.8 Flash-Next (`qwen4_exp`): the generic names only. Its serve engine does not read it yet.
+pub const flashnext: Binding = .{};
+
+const t = std.testing;
+
+const Env = struct {
+    var pairs: []const [2][]const u8 = &.{};
+    fn get(name: []const u8) ?[]const u8 {
+        for (pairs) |p| if (std.mem.eql(u8, p[0], name)) return p[1];
+        return null;
+    }
+};
+
+test "runner binding: the generic names or the family's alias, never both switches" {
+    Env.pairs = &.{ .{ "TF_DSV41_RUNNER", "1" }, .{ "TF_DSV41_RUNNER_CIRCUIT", "/c.tfpc" }, .{ "TF_RUNNER_CIRCUIT", "/test.tfpc" } };
+    const old = (try dsv41.parse(&Env.get)).?;
+    try t.expectEqualStrings("/c.tfpc", old.circuit);
+    try t.expectEqualStrings("TF_DSV41_RUNNER", dsv41.active(&Env.get));
+    Env.pairs = &.{ .{ "TF_RUNNER", "1" }, .{ "TF_RUNNER_CIRCUIT", "/g.tfpc" }, .{ "TF_RUNNER_FORMS", "inline" } };
+    const generic = (try dsv41.parse(&Env.get)).?;
+    try t.expectEqualStrings("/g.tfpc", generic.circuit);
+    try t.expect(generic.scan.inline_math and !generic.scan.fence);
+    try t.expectEqualStrings("TF_RUNNER", dsv41.active(&Env.get));
+    try t.expectEqualStrings("/g.tfpc", (try flashnext.parse(&Env.get)).?.circuit);
+    Env.pairs = &.{ .{ "TF_RUNNER", "1" }, .{ "TF_DSV41_RUNNER", "1" }, .{ "TF_RUNNER_CIRCUIT", "/g.tfpc" } };
+    try t.expectError(error.BadKnob, dsv41.parse(&Env.get));
+    Env.pairs = &.{.{ "TF_RUNNER_CIRCUIT", "/test.tfpc" }};
+    try t.expect((try dsv41.parse(&Env.get)) == null);
+    try t.expect((try flashnext.parse(&Env.get)) == null);
+}
diff --git a/zig/src/core/runner_commit.zig b/zig/src/core/runner_commit.zig
new file mode 100644
index 000000000..6d78d767a
--- /dev/null
+++ b/zig/src/core/runner_commit.zig
@@ -0,0 +1,423 @@
+//! Answer-commit (PREFIX_COMMIT): an owned value of the task's own expression closes the think and is the answer.
+const std = @import("std");
+const scan = @import("runner_scan.zig");
+const value = @import("runner_output.zig").value;
+const Allocator = std.mem.Allocator;
+const log = std.log.scoped(.runner);
+
+/// A request's commit settings (Request.run_commit); empty `close`: never fires.
+pub const Ask = struct {
+    close: []const u32 = &.{}, // the think close the stream writes (server.think_close)
+    task: []const u8 = "", // the last user message's text
+    eos: ?u32 = null, // the token that ends the reply after the answer
+    max_new: u32 = 0, // the reply's token limit
+    answer_max: u32 = 0, // tokens after the think close at most (0: max_new alone)
+    tools: bool = false, // the request offers tools: the answer may be a call, so never
+};
+
+/// A session's commit state: its ask, the think state of the token fed last, and whether it fired.
+pub const State = struct {
+    ask: Ask = .{},
+    think: bool = false,
+    fired: bool = false,
+};
+
+/// Feed: the token's think state kept for a trigger; true once fired (the scanner sees nothing after the answer).
+pub fn skip(st: *State, think_open: bool) bool {
+    st.think = think_open;
+    return st.fired;
+}
+
+/// The firing's write as it lands: the close, then the value (the answer field's bytes), then the end.
+pub const Record = struct {
+    cell: u32,
+    want: []u32, // close ++ value ++ eos (gpa)
+    close_len: u32,
+    value_len: u32,
+    landed: u32 = 0, // of `want`, committed in order (fewer: another token came, or the reply ended)
+    close_token: u32 = 0, // the reply's tokens before the close
+    token: u32 = 0, // the reply's tokens before the value
+    at: u64 = 0, // the content field's bytes before the value
+    value: std.ArrayList(u8) = .empty,
+    cut: bool = false,
+
+    /// A committed token after the cell's own write; `content_bytes`/`tokens` count those before it.
+    pub fn land(r: *Record, gpa: Allocator, id: u32, bytes: []const u8, content_bytes: u64, tokens: u32) Allocator.Error!void {
+        if (r.cut or r.landed >= r.want.len) return;
+        if (r.want[r.landed] != id) {
+            r.cut = true; // nothing after another token lands
+            return;
+        }
+        if (r.landed == 0) r.close_token = tokens;
+        if (r.landed == r.close_len) {
+            r.token = tokens;
+            r.at = content_bytes;
+        }
+        if (r.landed >= r.close_len and r.landed < r.close_len + r.value_len) try r.value.appendSlice(gpa, bytes);
+        r.landed += 1;
+    }
+
+    pub fn deinit(r: *Record, gpa: Allocator) void {
+        gpa.free(r.want);
+        r.value.deinit(gpa);
+    }
+};
+
+/// The receipt's `"commit"` object: the cell whose span is the task's expression, its answer as landed, where.
+pub fn write(o: *std.ArrayList(u8), gpa: Allocator, cells: anytype, r: Record) Allocator.Error!void {
+    const receipt = @import("runner_receipt.zig");
+    try o.print(gpa, ",\"commit\":{{\"cell\":{d},\"why\":\"whole-task\",", .{r.cell});
+    try receipt.text(o, gpa, "span", cells[r.cell].code);
+    try receipt.text(o, gpa, "value", r.value.items);
+    try o.print(gpa, "\"field\":\"content\",\"at\":{d},\"token\":{d},\"close_token\":{d},\"ids\":{d},\"landed\":{d},\"closed\":{},\"ended\":{}}}", .{ r.at, r.token, r.close_token, r.close_len + r.value_len + 1, r.landed, r.landed >= r.close_len, r.landed == r.close_len + r.value_len + 1 });
+}
+
+/// `ids` (the owned cell's result, already recorded) then the commit's tokens when it fires (`ids` freed or returned).
+pub fn after(s: anytype, cell: anytype, w: scan.Trigger, index: u32, ids: []u32) Allocator.Error![]u32 {
+    const gpa = s.r.gpa;
+    if (!s.r.cfg.commit or s.commit.fired or !try fires(gpa, s, cell, w)) return ids;
+    const tx = s.r.text.?;
+    const ask = s.commit.ask;
+    const v = value(cell.result.?.out);
+    const vid = try tx.encode(tx.ctx, gpa, v);
+    defer gpa.free(vid);
+    // after the think end: at most the close's own tokens, the value and the end
+    if (vid.len > s.r.cfg.max_tokens or (ask.answer_max > 0 and ask.close.len + vid.len + 1 > ask.answer_max)) return ids;
+    // the stream forces at most its room less one: every token must fit, or the answer would be a cut number
+    if (@as(u64, s.rec.tokens) + ids.len + ask.close.len + vid.len + 2 > ask.max_new) return ids;
+    const tail = try std.mem.concat(gpa, u32, &.{ ask.close, vid, &.{ask.eos.?} });
+    errdefer gpa.free(tail);
+    const all = try std.mem.concat(gpa, u32, &.{ ids, tail });
+    errdefer gpa.free(all);
+    s.rec.commit = .{ .cell = index, .want = tail, .close_len = @intCast(ask.close.len), .value_len = @intCast(vid.len) };
+    gpa.free(ids);
+    s.commit.fired = true;
+    if (s.forcing) |*f| f.left += tail.len;
+    log.info("reply {d} cell {d}: commit, the think closes and {d} value tokens are the answer", .{ s.id, index, vid.len });
+    return all;
+}
+
+/// Every guard but the room: only what the oracle checks (the task's one expression as the span, an integer value).
+fn fires(gpa: Allocator, s: anytype, cell: anytype, w: scan.Trigger) Allocator.Error!bool {
+    const ask = s.commit.ask;
+    if (ask.close.len == 0 or ask.eos == null or ask.tools or !s.rec.on) return false;
+    // inside reasoning, after a closed cell: never a trace envelope, an EOS hand-off or an open fence
+    if (!s.commit.think or w.trace or w.terminal or cell.stated != null or s.scan.state == .fence) return false;
+    const res = cell.result orelse return false;
+    if (res.status != .ok or !integer(value(res.out))) return false;
+    const task = try expression(gpa, ask.task) orelse return false;
+    defer gpa.free(task);
+    const span = try spanOf(gpa, cell.code, cell.form) orelse return false;
+    defer gpa.free(span);
+    return same(task, span);
+}
+
+/// A decimal integer as Python prints one: an optional minus, digits, no leading zero.
+pub fn integer(v: []const u8) bool {
+    const d = if (std.mem.startsWith(u8, v, "-")) v[1..] else v;
+    if (d.len == 0 or (d.len > 1 and d[0] == '0') or std.mem.eql(u8, v, "-0")) return false;
+    for (d) |c| if (!std.ascii.isDigit(c)) return false;
+    return true;
+}
+
+/// The one closed literal expression `text` states, normalized, when every digit in `text` is in it; else null.
+pub fn expression(a: Allocator, text: []const u8) Allocator.Error!?[]u8 {
+    const words = try spoken(a, text);
+    defer a.free(words);
+    var found: ?[]u8 = null;
+    errdefer if (found) |f| a.free(f);
+    var i: usize = 0;
+    var digits: usize = 0; // digits outside the expression found
+    while (i < words.len) {
+        if (!inRun(words[i])) {
+            i += 1;
+            continue;
+        }
+        var j = i;
+        while (j < words.len and inRun(words[j])) j += 1;
+        const run = std.mem.trim(u8, words[i..j], " \t\r\n,");
+        i = j;
+        var n: usize = 0;
+        for (run) |c| n += @intFromBool(std.ascii.isDigit(c));
+        if (n == 0) continue;
+        const e = try normalize(a, run, true) orelse {
+            digits += n;
+            continue;
+        };
+        if (found != null or !binary(e)) {
+            a.free(e);
+            digits += n;
+            continue;
+        }
+        found = e;
+    }
+    if (digits > 0) {
+        if (found) |f| a.free(f);
+        return null;
+    }
+    return found;
+}
+
+fn inRun(c: u8) bool {
+    return std.ascii.isDigit(c) or std.mem.indexOfScalar(u8, " \t+-*/%()^,_", c) != null;
+}
+
+/// `text` with the spelled operators as symbols (`divided by` `/`, `mod` `%`, `times` `*`, `×` `*`, `−` `-`, …).
+fn spoken(a: Allocator, text: []const u8) Allocator.Error![]u8 {
+    const subs = [_][2][]const u8{
+        .{ "divided by", "/" },
+        .{ "mod", "%" },
+        .{ "times", "*" },
+        .{ "plus", "+" },
+        .{ "minus", "-" },
+        .{ "\u{00d7}", "*" },
+        .{ "\u{00b7}", "*" },
+        .{ "\u{00f7}", "/" },
+        .{ "\u{2212}", "-" },
+    };
+    var out: std.ArrayList(u8) = .empty;
+    errdefer out.deinit(a);
+    var i: usize = 0;
+    next: while (i < text.len) {
+        for (subs) |sub| if (i + sub[0].len <= text.len and std.ascii.eqlIgnoreCase(text[i .. i + sub[0].len], sub[0])) {
+            const word = std.ascii.isAlphabetic(sub[0][0]);
+            const before = i == 0 or !std.ascii.isAlphanumeric(text[i - 1]);
+            const end = i + sub[0].len;
+            if (!word or (before and (end == text.len or !std.ascii.isAlphanumeric(text[end])))) {
+                try out.appendSlice(a, sub[1]);
+                i = end;
+                continue :next;
+            }
+        };
+        try out.append(a, text[i]);
+        i += 1;
+    }
+    return out.toOwnedSlice(a);
+}
+
+/// A cell's span as the expression it computes: inline as written, else its last `print(<expr>)` over literal names.
+pub fn spanOf(a: Allocator, code: []const u8, form: anytype) Allocator.Error!?[]u8 {
+    if (form == .inline_expr) {
+        const words = try spoken(a, code);
+        defer a.free(words);
+        return normalize(a, words, true);
+    }
+    var names: std.ArrayList([2][]const u8) = .empty;
+    defer names.deinit(a);
+    var last: ?[]const u8 = null;
+    var it = std.mem.splitScalar(u8, std.mem.trim(u8, code, " \t\r\n"), '\n');
+    while (it.next()) |raw| {
+        var line = std.mem.trim(u8, raw, " \t\r");
+        if (std.mem.startsWith(u8, line, ">>> ")) line = line[4..];
+        if (line.len == 0) continue;
+        if (last != null) return null; // the printed expression is the cell's last statement
+        if (assignment(line)) |as| {
+            for (names.items) |n| if (std.mem.eql(u8, n[0], as[0])) return null; // rebound
+            try names.append(a, as);
+            continue;
+        }
+        last = if (std.mem.startsWith(u8, line, "print(") and line[line.len - 1] == ')') line[6 .. line.len - 1] else line;
+    }
+    const e = last orelse return null;
+    var sub: std.ArrayList(u8) = .empty;
+    defer sub.deinit(a);
+    var i: usize = 0;
+    while (i < e.len) {
+        if (std.ascii.isAlphabetic(e[i]) or e[i] == '_') {
+            var j = i;
+            while (j < e.len and (std.ascii.isAlphanumeric(e[j]) or e[j] == '_')) j += 1;
+            const name = e[i..j];
+            const rhs = for (names.items) |n| {
+                if (std.mem.eql(u8, n[0], name)) break n[1];
+            } else return null; // a call or an unknown name
+            try sub.print(a, "({s})", .{rhs});
+            i = j;
+            continue;
+        }
+        try sub.append(a, e[i]);
+        i += 1;
+    }
+    return normalize(a, sub.items, false);
+}
+
+/// `name = <literal right side>` (no other name on the right).
+fn assignment(line: []const u8) ?[2][]const u8 {
+    const eq = std.mem.indexOfScalar(u8, line, '=') orelse return null;
+    if (eq + 1 < line.len and line[eq + 1] == '=') return null;
+    const name = std.mem.trim(u8, line[0..eq], " \t");
+    if (name.len == 0 or !(std.ascii.isAlphabetic(name[0]) or name[0] == '_')) return null;
+    for (name) |c| if (!(std.ascii.isAlphanumeric(c) or c == '_')) return null;
+    const rhs = std.mem.trim(u8, line[eq + 1 ..], " \t");
+    for (rhs) |c| if (std.ascii.isAlphabetic(c)) return null;
+    return .{ name, rhs };
+}
+
+/// A literal-only expression in one spelling (digit groups joined, `**` powers, `(n)` as n); null if not well formed.
+pub fn normalize(a: Allocator, src: []const u8, caret: bool) Allocator.Error!?[]u8 {
+    var out: std.ArrayList(u8) = .empty;
+    errdefer out.deinit(a);
+    var i: usize = 0;
+    while (i < src.len) {
+        const c = src[i];
+        if (c == ' ' or c == '\t') {
+            i += 1;
+        } else if (std.ascii.isDigit(c)) {
+            while (i < src.len) {
+                if (std.ascii.isDigit(src[i])) {
+                    try out.append(a, src[i]);
+                    i += 1;
+                } else if ((src[i] == ',' and group(src, i + 1)) or
+                    (src[i] == '_' and i + 1 < src.len and std.ascii.isDigit(src[i + 1])))
+                {
+                    i += 1;
+                } else break;
+            }
+        } else if (c == '^') {
+            if (!caret) return fail(a, &out);
+            try out.appendSlice(a, "**");
+            i += 1;
+        } else if (std.mem.indexOfScalar(u8, "+-*/%()", c) != null) {
+            try out.append(a, c);
+            i += 1;
+        } else return fail(a, &out);
+    }
+    const s = try out.toOwnedSlice(a);
+    errdefer a.free(s);
+    const plain = try unbracket(a, s);
+    a.free(s);
+    if (!wellFormed(plain)) {
+        a.free(plain);
+        return null;
+    }
+    return plain;
+}
+
+fn fail(a: Allocator, out: *std.ArrayList(u8)) ?[]u8 {
+    out.deinit(a);
+    return null;
+}
+
+/// Three digits at `i`, then no further digit.
+fn group(s: []const u8, i: usize) bool {
+    if (i + 3 > s.len) return false;
+    for (s[i .. i + 3]) |c| if (!std.ascii.isDigit(c)) return false;
+    return i + 3 == s.len or !std.ascii.isDigit(s[i + 3]);
+}
+
+/// `(digits)` as `digits`, again until none is left, and brackets around the whole expression dropped.
+fn unbracket(a: Allocator, s: []const u8) Allocator.Error![]u8 {
+    var cur = try a.dupe(u8, s);
+    while (cur.len >= 2 and cur[0] == '(' and closing(cur) == cur.len - 1) {
+        const inner = try a.dupe(u8, cur[1 .. cur.len - 1]);
+        a.free(cur);
+        cur = inner;
+    }
+    while (true) {
+        var i: usize = 0;
+        const hit = while (i < cur.len) : (i += 1) {
+            if (cur[i] != '(') continue;
+            var j = i + 1;
+            while (j < cur.len and std.ascii.isDigit(cur[j])) j += 1;
+            if (j > i + 1 and j < cur.len and cur[j] == ')') break .{ i, j };
+        } else null;
+        const h = hit orelse return cur;
+        const next = try std.mem.concat(a, u8, &.{ cur[0..h[0]], cur[h[0] + 1 .. h[1]], cur[h[1] + 1 ..] });
+        a.free(cur);
+        cur = next;
+    }
+}
+
+/// The index of the bracket closing the one `e` opens with (null: unbalanced).
+fn closing(e: []const u8) ?usize {
+    var depth: usize = 0;
+    for (e, 0..) |c, i| switch (c) {
+        '(' => depth += 1,
+        ')' => {
+            if (depth == 0) return null;
+            depth -= 1;
+            if (depth == 0) return i;
+        },
+        else => {},
+    };
+    return null;
+}
+
+/// Infix over integers: unary signs, `+ - * / // % **`, balanced brackets.
+fn wellFormed(s: []const u8) bool {
+    var p: Parse = .{ .s = s };
+    return p.expr() and p.i == s.len;
+}
+
+const Parse = struct {
+    s: []const u8,
+    i: usize = 0,
+    depth: u32 = 0,
+
+    fn expr(p: *Parse) bool {
+        if (!p.unary()) return false;
+        while (p.i < p.s.len and std.mem.indexOfScalar(u8, "+-*/%", p.s[p.i]) != null) {
+            p.i += 1;
+            if (p.i < p.s.len and (p.s[p.i] == '*' or p.s[p.i] == '/') and p.s[p.i - 1] == p.s[p.i]) p.i += 1;
+            if (!p.unary()) return false;
+        }
+        return true;
+    }
+
+    fn unary(p: *Parse) bool {
+        while (p.i < p.s.len and (p.s[p.i] == '-' or p.s[p.i] == '+')) p.i += 1;
+        if (p.i >= p.s.len) return false;
+        if (std.ascii.isDigit(p.s[p.i])) {
+            while (p.i < p.s.len and std.ascii.isDigit(p.s[p.i])) p.i += 1;
+            return true;
+        }
+        if (p.s[p.i] != '(' or p.depth > 64) return false;
+        p.i += 1;
+        p.depth += 1;
+        if (!p.expr() or p.i >= p.s.len or p.s[p.i] != ')') return false;
+        p.depth -= 1;
+        p.i += 1;
+        return true;
+    }
+};
+
+/// A binary operator at any depth (not only a signed number).
+fn binary(e: []const u8) bool {
+    for (e, 0..) |c, i| if (i > 0 and std.mem.indexOfScalar(u8, "+-*/%", c) != null and
+        (std.ascii.isDigit(e[i - 1]) or e[i - 1] == ')')) return true;
+    return false;
+}
+
+/// The same expression, or one sum or product of two operands written the other way round.
+pub fn same(task: []const u8, span: []const u8) bool {
+    if (std.mem.eql(u8, task, span)) return true;
+    const x = split(task) orelse return false;
+    const y = split(span) orelse return false;
+    return x.op == y.op and std.mem.eql(u8, x.left, y.right) and std.mem.eql(u8, x.right, y.left);
+}
+
+const Split = struct { left: []const u8, op: u8, right: []const u8 };
+
+/// `left + right` or `left * right` when that is the only binary operator outside brackets.
+fn split(e: []const u8) ?Split {
+    var depth: i32 = 0;
+    var at: ?usize = null;
+    for (e, 0..) |c, i| {
+        switch (c) {
+            '(' => depth += 1,
+            ')' => depth -= 1,
+            '+', '-', '*', '/', '%' => if (depth == 0 and i > 0 and (std.ascii.isDigit(e[i - 1]) or e[i - 1] == ')')) {
+                if (at != null) return null;
+                at = i;
+            },
+            else => {},
+        }
+    }
+    const k = at orelse return null;
+    if (e[k] != '+' and e[k] != '*') return null;
+    if (k + 1 < e.len and (e[k + 1] == '*' or e[k + 1] == '/')) return null; // `**`
+    return .{ .left = e[0..k], .op = e[k], .right = e[k + 1 ..] };
+}
+
+test {
+    _ = @import("runner_commit_test.zig");
+}
