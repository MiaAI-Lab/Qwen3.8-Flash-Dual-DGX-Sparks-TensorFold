+        const hook = s.hook();
+        // a closed fence: its EOS would hand off for the result (the control, before any firing)
+        for ("```python\nprint(2**100)\n```\n") |c| _ = hook.token(hook.ptr, c, true, true, false);
+        try std.testing.expectEqual(@as(usize, 1), s.cells.items.len);
+        s.commit.fired = fired;
+        try std.testing.expectEqual(!fired, hook.eos.?(hook.ptr, true, true));
+    }
+    const s = (try r.session(.{})).?;
+    defer s.destroy();
+    const hook = s.hook();
+    s.commit.fired = true;
+    for ("```python\nprint(2**100)\n```\nResult:\n") |c| try std.testing.expect(!hook.token(hook.ptr, c, true, true, false));
+    try std.testing.expectEqual(@as(usize, 0), s.cells.items.len);
+}
diff --git a/zig/src/core/runner_cost_bench.zig b/zig/src/core/runner_cost_bench.zig
new file mode 100644
index 000000000..e13dba342
--- /dev/null
+++ b/zig/src/core/runner_cost_bench.zig
@@ -0,0 +1,169 @@
+//! Runner host cost on real replies, no GPU: ns/token off/scan/inline/firing and the hold wait (usage: main).
+const std = @import("std");
+const runner = @import("runner.zig");
+const rapi = @import("runner_api.zig");
+const frontend = @import("runner_frontend.zig");
+const dsv41 = @import("dsv41_tokenizer");
+
+pub const Reply = struct { tokens: []u32, think_end: usize };
+
+pub const Table = struct {
+    tok: *dsv41.Tokenizer,
+    pub fn bytes(ctx: ?*anyopaque, token: u32) []const u8 {
+        const t: *Table = @ptrCast(@alignCast(ctx.?));
+        if (token >= t.tok.vocabSize() or t.tok.isSpecial(token)) return "";
+        return t.tok.bytes[t.tok.offsets[token]..t.tok.offsets[token + 1]];
+    }
+    pub fn encode(ctx: ?*anyopaque, a: std.mem.Allocator, text: []const u8) std.mem.Allocator.Error![]u32 {
+        const t: *Table = @ptrCast(@alignCast(ctx.?));
+        const e = try t.tok.acquire();
+        defer t.tok.release(e);
+        var out: std.ArrayList(u32) = .empty;
+        try e.encode(a, text, &out);
+        return out.toOwnedSlice(a);
+    }
+};
+
+/// A backend whose every run is done at its first poll with a one-line value (the circuit's time is not host cost).
+const Instant = struct {
+    fn backend() rapi.Backend {
+        return .{ .ctx = @ptrFromInt(8), .vtable = &.{ .start = start, .poll = poll, .cancel = cancel, .release = release } };
+    }
+    fn start(_: *anyopaque, _: u64, _: rapi.Program, _: u64) error{ OutOfMemory, Busy }!rapi.JobId {
+        return 1;
+    }
+    fn poll(_: *anyopaque, _: rapi.JobId) rapi.Poll {
+        return .{ .done = .{ .status = .ok, .out = "1267650600228229401496703205376\n", .steps = 1 } };
+    }
+    fn cancel(_: *anyopaque, _: rapi.JobId) void {}
+    fn release(_: *anyopaque, _: u64) void {}
+};
+
+fn now() u64 {
+    var ts: std.c.timespec = undefined;
+    _ = std.c.clock_gettime(.MONOTONIC, &ts);
+    return @as(u64, @intCast(ts.sec)) * std.time.ns_per_s + @as(u64, @intCast(ts.nsec));
+}
+
+fn sleepNs(ns: u64) void {
+    var ts: std.c.timespec = .{ .sec = @intCast(ns / std.time.ns_per_s), .nsec = @intCast(ns % std.time.ns_per_s) };
+    _ = std.c.nanosleep(&ts, null);
+}
+
+const Mode = enum { off, scan_cr, scan_inline, fire };
+
+const Totals = struct { tokens: u64 = 0, feed_ns: u64 = 0, fires: u64 = 0, tick_ns: u64 = 0, settle_ns: u64 = 0, sink: u64 = 0, receipt_ns: u64 = 0, receipt_bytes: u64 = 0, replies: u64 = 0 };
+
+/// One pass over every reply; `poll_ns`: the idle wait between ticks while held; `forced`: results fed after holds.
+fn pass(gpa: std.mem.Allocator, r: *runner.Runner, replies: []const Reply, mode: Mode, poll_ns: u64, forced: bool) !Totals {
+    var t: Totals = .{};
+    for (replies) |rep| {
+        if (mode == .off) {
+            const t0 = now();
+            for (rep.tokens) |tok| t.sink +%= r.text.?.bytes(r.text.?.ctx, tok).len;
+            t.feed_ns += now() - t0;
+            t.tokens += rep.tokens.len;
+            continue;
+        }
+        const s = (try r.session(.{})).?;
+        defer s.destroy();
+        const hook = s.hook();
+        for (rep.tokens, 0..) |tok, i| {
+            const t0 = now();
+            const held = hook.token(hook.ptr, tok, i < rep.think_end, mode == .fire, false);
+            t.feed_ns += now() - t0;
+            t.tokens += 1;
+            if (!held) continue;
+            // held: tick as the engine loop does, waiting poll_ns between ticks, until the result is settled
+            const h0 = now();
+            while (true) {
+                const k0 = now();
+                const got = try s.tick();
+                t.tick_ns += now() - k0;
+                if (got) |ids| {
+                    defer gpa.free(ids);
+                    if (forced) for (ids) |f| {
+                        const f0 = now();
+                        _ = hook.token(hook.ptr, f, i < rep.think_end, false, false);
+                        t.feed_ns += now() - f0;
+                        t.tokens += 1;
+                    };
+                    break;
+                }
+                if (poll_ns > 0) sleepNs(poll_ns);
+            }
+            t.settle_ns += now() - h0;
+            t.fires += 1;
+        }
+        const r0 = now();
+        t.receipt_bytes += s.receipt().len;
+        t.receipt_ns += now() - r0;
+        t.replies += 1;
+    }
+    return t;
+}
+
+/// replies.jsonl's lines ({"reasoning": "...", "content": "..."}) as token ids; never freed (a bench's whole run).
+pub fn load(gpa: std.mem.Allocator, io: std.Io, table: *Table, path: []const u8) ![]Reply {
+    const text = try std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 30));
+    var replies: std.ArrayList(Reply) = .empty;
+    var lines = std.mem.splitScalar(u8, text, '\n');
+    var total: usize = 0;
+    while (lines.next()) |line| {
+        if (line.len == 0) continue;
+        const p = try std.json.parseFromSlice(struct { reasoning: []const u8, content: []const u8 }, gpa, line, .{ .ignore_unknown_fields = true });
+        const a = try Table.encode(table, gpa, p.value.reasoning);
+        const b = try Table.encode(table, gpa, p.value.content);
+        const all = try std.mem.concat(gpa, u32, &.{ a, b });
+        try replies.append(gpa, .{ .tokens = all, .think_end = a.len });
+        total += all.len;
+    }
+    std.debug.print("{d} replies, {d} tokens\n", .{ replies.items.len, total });
+    return replies.items;
+}
+
+/// runner-cost-bench <tokenizer.json> <replies.jsonl> [repeats]; a line is {"reasoning": "...", "content": "..."}.
+pub fn main(init: std.process.Init) !u8 {
+    const gpa = std.heap.c_allocator;
+    const argv = try init.minimal.args.toSlice(init.arena.allocator());
+    if (argv.len < 3) {
+        std.debug.print("usage: runner-cost-bench <tokenizer.json> <replies.jsonl> [repeats]\n", .{});
+        return 2;
+    }
+    const repeats = if (argv.len > 3) try std.fmt.parseInt(u32, argv[3], 10) else 3;
+    const tok = try dsv41.Tokenizer.load(gpa, init.io, argv[1]);
+    var table: Table = .{ .tok = tok };
+    const replies = try load(gpa, init.io, &table, argv[2]);
+    var ctx: frontend.Context = .{ .io = init.io };
+    var r: runner.Runner = .{ .gpa = gpa, .cfg = .{ .circuit = "bench" }, .frontend = ctx.frontend(), .backend = Instant.backend(), .text = .{ .ctx = &table, .bytes = Table.bytes, .encode = Table.encode } };
+    const Case = struct { name: []const u8, mode: Mode, inline_math: bool, poll_ns: u64, forced: bool = false, cells: bool = false };
+    const cases = [_]Case{
+        .{ .name = "runner off (byte lookup only)", .mode = .off, .inline_math = false, .poll_ns = 0 },
+        .{ .name = "on, fence/repl scan, no holds", .mode = .scan_cr, .inline_math = false, .poll_ns = 0 },
+        .{ .name = "on, +inline scan, no holds", .mode = .scan_inline, .inline_math = true, .poll_ns = 0 },
+        .{ .name = "on, +inline, firing, tick spin", .mode = .fire, .inline_math = true, .poll_ns = 0 },
+        .{ .name = "on, +inline, firing, 1 ms idle", .mode = .fire, .inline_math = true, .poll_ns = std.time.ns_per_ms },
+        .{ .name = "on, +inline, firing, 20 ms idle", .mode = .fire, .inline_math = true, .poll_ns = 20 * std.time.ns_per_ms },
+        .{ .name = "firing, forced fed, records off", .mode = .fire, .inline_math = true, .poll_ns = 0, .forced = true },
+        .{ .name = "firing, forced fed, records on", .mode = .fire, .inline_math = true, .poll_ns = 0, .forced = true, .cells = true },
+    };
+    for (cases) |c| {
+        r.cfg.scan.inline_math = c.inline_math;
+        r.cfg.cells = c.cells;
+        var best: ?Totals = null;
+        for (0..repeats) |_| {
+            const t = try pass(gpa, &r, replies, c.mode, c.poll_ns, c.forced);
+            if (best == null or t.feed_ns < best.?.feed_ns) best = t;
+        }
+        const t = best.?;
+        const per = @as(f64, @floatFromInt(t.feed_ns)) / @as(f64, @floatFromInt(t.tokens));
+        std.debug.print("{s:34} {d:8.1} ns/token feed", .{ c.name, per });
+        if (t.fires > 0) {
+            const f: f64 = @floatFromInt(t.fires);
+            std.debug.print(", {d} fires: tick {d:.1} us/fire, hold-to-result {d:.2} ms/fire", .{ t.fires, @as(f64, @floatFromInt(t.tick_ns)) / f / 1e3, @as(f64, @floatFromInt(t.settle_ns)) / f / 1e6 });
+        }
+        if (t.replies > 0) std.debug.print(", receipt {d:.2} us/reply ({d} bytes/reply)", .{ @as(f64, @floatFromInt(t.receipt_ns)) / @as(f64, @floatFromInt(t.replies)) / 1e3, t.receipt_bytes / t.replies });
+        std.debug.print("\n", .{});
+    }
+    return 0;
+}
diff --git a/zig/src/core/runner_frontend_boot_main.zig b/zig/src/core/runner_frontend_boot_main.zig
new file mode 100644
index 000000000..facd755f6
--- /dev/null
+++ b/zig/src/core/runner_frontend_boot_main.zig
@@ -0,0 +1,148 @@
+//! Standalone compiler boot probe; enabling the runner requires a working RV32 toolchain.
+const std = @import("std");
+const boot = @import("runner_frontend_boot.zig");
+const usage = "Usage: tf-runner-frontend-check [--require] [--clang PATH] [--linker PATH] [--circuit PATH] [--help]\n";
+
+const Options = struct {
+    config: boot.Config = .{},
+    help: bool = false,
+    circuit: ?[]const u8 = null, // also run the loop probe (core/runner_probe.zig) on this circuit: wrong is exit 1
+};
+
+pub fn main(init: std.process.Init) !u8 {
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+    var buffer: [512]u8 = undefined;
+    var output = std.Io.File.stderr().writerStreaming(init.io, &buffer);
+    defer output.interface.flush() catch {};
+    const options = parseWith(args[1..], environment(init.environ_map)) catch {
+        try output.interface.writeAll(usage);
+        return 2;
+    };
+    if (options.help) {
+        try output.interface.writeAll(usage);
+        return 0;
+    }
+    const available = boot.selfTest(init.gpa, init.io, options.config) catch |err| switch (err) {
+        error.RunnerUnavailable => {
+            try output.interface.writeAll("runner compiler: unavailable (required; clang/lld RV32 ELF check failed)\n");
+            return 1;
+        },
+        else => return err,
+    };
+    try output.interface.writeAll(if (available)
+        "runner compiler: available (rv32im_zba ELF validated)\n"
+    else
+        "runner compiler: unavailable (optional; clang/lld RV32 ELF check failed)\n");
+    if (options.circuit) |path| return probe(init.gpa, init.io, &output.interface, path, options.config.compiler, available);
+    return 0;
+}
+
+/// The image's circuit route: the probe cells compiled here and run on `path` must print what Python or C prints.
+fn probe(gpa: std.mem.Allocator, io: std.Io, out: *std.Io.Writer, path: []const u8, compiler: @import("runner_frontend_program.zig").Config, available: bool) !u8 {
+    if (!available) {
+        try out.print("runner circuit {s}: not probed (no RV32 compiler)\n", .{path});
+        return 1;
+    }
+    var c = @import("runner_circuit.zig").Circuit.load(gpa, path) catch |e| {
+        try out.print("runner circuit {s}: does not load ({t})\n", .{ path, e });
+        return 1;
+    };
+    defer c.deinit(gpa);
+    const backend = @import("runner_circuit_backend.zig");
+    const b = try backend.backend(gpa, &c, 1);
+    defer backend.destroy(b);
+    var ctx: @import("runner_frontend.zig").Context = .{ .io = io, .compiler = compiler };
+    var why: [256]u8 = undefined;
+    const got = try @import("runner_probe.zig").run(gpa, ctx.frontend(), b, true, &why);
+    if (got.wrong) |w| {
+        try out.print("runner circuit {s}: WRONG: {s}\n", .{ path, w });
+        return 1;
+    }
+    try out.print("runner circuit {s}: {d} probe cells print the right output in {d} steps\n", .{ path, got.ran, got.steps });
+    return 0;
+}
+
+fn parse(args: []const [:0]const u8) error{InvalidArguments}!Options {
+    return parseWith(args, .{});
+}
+
+fn environment(env: *const std.process.Environ.Map) Options {
+    var options: Options = .{};
+    if (env.get("TF_RUNNER_CLANG")) |path| options.config.compiler.clang = path;
+    options.config.compiler.linker = env.get("TF_RUNNER_LLD");
+    // fail closed when the image's runner is switched on, under the generic name or a family's (runner_binding.zig)
+    options.config.required = on(env.get("TF_RUNNER")) or on(env.get("TF_DSV41_RUNNER"));
+    return options;
+}
+
+fn on(v: ?[]const u8) bool {
+    const value = v orelse return false;
+    return value.len != 0 and !std.mem.eql(u8, value, "0") and !std.ascii.eqlIgnoreCase(value, "false") and
+        !std.ascii.eqlIgnoreCase(value, "off") and !std.ascii.eqlIgnoreCase(value, "no");
+}
+
+fn parseWith(args: []const [:0]const u8, initial: Options) error{InvalidArguments}!Options {
+    var options = initial;
+    var i: usize = 0;
+    while (i < args.len) : (i += 1) {
+        const arg = args[i];
+        if (std.mem.eql(u8, arg, "--require")) {
+            options.config.required = true;
+        } else if (std.mem.eql(u8, arg, "--help")) {
+            options.help = true;
+        } else if (std.mem.eql(u8, arg, "--clang") or std.mem.eql(u8, arg, "--linker") or std.mem.eql(u8, arg, "--circuit")) {
+            i += 1;
+            if (i == args.len or args[i].len == 0 or std.mem.startsWith(u8, args[i], "--"))
+                return error.InvalidArguments;
+            if (std.mem.eql(u8, arg, "--clang")) {
+                options.config.compiler.clang = args[i];
+            } else if (std.mem.eql(u8, arg, "--circuit")) {
+                options.circuit = args[i];
+            } else {
+                options.config.compiler.linker = args[i];
+            }
+        } else return error.InvalidArguments;
+    }
+    return options;
+}
+
+test "CLI defaults optional and passes explicit toolchain paths to the boot probe" {
+    try std.testing.expect(!(try parse(&.{})).config.required);
+    const options = try parse(&.{ "--require", "--clang", "/missing/clang", "--linker", "/missing/ld.lld" });
+    try std.testing.expect(options.config.required);
+    try std.testing.expectEqualStrings("/missing/clang", options.config.compiler.clang);
+    try std.testing.expectEqualStrings("/missing/ld.lld", options.config.compiler.linker.?);
+    try std.testing.expectEqualStrings("/c.tfpc", (try parse(&.{ "--circuit", "/c.tfpc" })).circuit.?);
+    try std.testing.expectEqual(null, options.circuit);
+}
+
+test "CLI refuses missing toolchain paths and unknown arguments" {
+    try std.testing.expectError(error.InvalidArguments, parse(&.{"--clang"}));
+    try std.testing.expectError(error.InvalidArguments, parse(&.{ "--linker", "--require" }));
+    try std.testing.expectError(error.InvalidArguments, parse(&.{ "--clang", "" }));
+    try std.testing.expectError(error.InvalidArguments, parse(&.{"--unknown"}));
+}
+
+test "environment enables fail closed only for a requested runner" {
+    var env = std.process.Environ.Map.init(std.testing.allocator);
+    defer env.deinit();
+    try std.testing.expect(!environment(&env).config.required);
+    for ([_][]const u8{ "", "0", "false", "off", "no", "FALSE" }) |value| {
+        try env.put("TF_DSV41_RUNNER", value);
+        try std.testing.expect(!environment(&env).config.required);
+    }
+    for ([_][]const u8{ "1", "true", "on", "yes", "invalid" }) |value| {
+        try env.put("TF_DSV41_RUNNER", value);
+        try std.testing.expect(environment(&env).config.required);
+    }
+    try env.put("TF_DSV41_RUNNER", "0");
+    try env.put("TF_RUNNER", "1");
+    try std.testing.expect(environment(&env).config.required);
+    try env.put("TF_RUNNER_CLANG", "/missing/compiler");
+    try env.put("TF_RUNNER_LLD", "/missing/linker");
+    const options = environment(&env);
+    try std.testing.expectEqualStrings("/missing/compiler", options.config.compiler.clang);
+    try std.testing.expectEqualStrings("/missing/linker", options.config.compiler.linker.?);
+    const overridden = try parseWith(&.{ "--clang", "/explicit/compiler" }, options);
+    try std.testing.expectEqualStrings("/explicit/compiler", overridden.config.compiler.clang);
+}
diff --git a/zig/src/core/runner_frontend_inline_regression_test.zig b/zig/src/core/runner_frontend_inline_regression_test.zig
new file mode 100644
index 000000000..462b7f4c1
--- /dev/null
+++ b/zig/src/core/runner_frontend_inline_regression_test.zig
@@ -0,0 +1,140 @@
+const std = @import("std");
+const graph = @import("runner_graph.zig");
+const route = @import("runner_graph_route.zig");
+const frontend = @import("runner_frontend.zig");
+const math = @import("runner_frontend_inline_integer.zig");
+const t = std.testing;
+
+pub const cases = [_][3][]const u8{
+    .{ "7**123%1000000007", "pow(7,123,1000000007)", "937329259\n" },
+    .{ "3**400%10**18", "pow(3,400,10**18)", "192443283334088001\n" },
+    .{ "0xFEDCBA9876543210*2**64+0x0123456789ABCDEF", "0xFEDCBA9876543210*2**64+0x0123456789ABCDEF", "338770000845734292516042252062085074415\n" },
+};
+
+fn bankPath() ![]const u8 {
+    const p = std.c.getenv("TF_RUNNER_GRAPH_BANK") orelse return error.SkipZigTest;
+    return std.mem.span(p);
+}
+
+fn observe(bank: *graph.Bank, source: []const u8, expected: []const u8, form: @import("runner_api.zig").Form) !void {
+    var context: frontend.Context = .{ .io = t.io, .compiler = .{ .clang = "/nonexistent-regression-clang" } };
+    var routed: route.Routed = .{ .inner = context.frontend(), .bank = bank };
+    const f = routed.frontend();
+    const result = try f.translate(f.ctx, t.allocator, .{ .form = form, .lang = "python", .code = source });
+    defer if (result == .program) t.allocator.free(result.program.bytes);
+    if (result == .abstain) std.debug.print("unexpected refusal {t}: {s}\n", .{ form, source });
+    try t.expect(result == .program);
+    try t.expect(result.program.kind == .graph);
+    var machine = try @import("runner_graph_machine.zig").Machine.boot(t.allocator, bank, result.program.bytes);
+    defer machine.deinit();
+    var out: std.ArrayList(u8) = .empty;
+    defer out.deinit(t.allocator);
+    const end = try machine.run(4_000_000, &out, null);
+    try t.expect(end.end == .halted);
+    try t.expectEqualStrings(expected, out.items);
+}
+
+test "runner proof: S2 modular powers and hex inline statements retain ownership without clang" {
+    var bank = try graph.Bank.load(t.allocator, try bankPath());
+    defer bank.deinit();
+    for (cases) |fixture| {
+        const code = try std.fmt.allocPrint(t.allocator, "print({s})", .{fixture[1]});
+        defer t.allocator.free(code);
+        const oracle = try std.process.run(t.allocator, t.io, .{ .argv = &.{ "/usr/bin/python3", "-I", "-S", "-c", code }, .stdout_limit = .limited(4096), .stderr_limit = .limited(4096) });
+        defer t.allocator.free(oracle.stdout);
+        defer t.allocator.free(oracle.stderr);
+        try t.expect(oracle.term.success());
+        try t.expectEqualStrings(fixture[2], oracle.stdout);
+        try observe(&bank, fixture[0], oracle.stdout, .inline_expr);
+        try observe(&bank, fixture[0], oracle.stdout, .repl);
+    }
+    try observe(&bank, "7^123 mod 1000000007", cases[0][2], .inline_expr);
+    try observe(&bank, "3^400 mod 10^18", cases[1][2], .inline_expr);
+    try observe(&bank, "0xFEDCBA9876543210*2^64+0x0123456789ABCDEF", cases[2][2], .inline_expr);
+    for ([_][]const u8{
+        "We need answer compute 7^123 mod 1000000007. Need calculate accurately. Need provide maybe concise. Let's compute carefully. Mod p=1,000,000,007 prime. Need exponentiation.\n",
+        "Need compute 3^400 mod 10^18.\n",
+        "Let A = 0xFEDCBA9876543210, B=0x0123456789ABCDEF. N = A*2^64 + B.\n",
+    }, 0..) |line, i| {
+        var scanner: @import("runner_scan.zig").Scanner = .{ .cfg = .{
+            .trace = true,
+            .inline_math = false,
+            .fence = false,
+            .repl = false,
+        } };
+        defer scanner.deinit(t.allocator);
+        const event = try scanner.feed(t.allocator, line, true);
+        try t.expect(event.closed != null);
+        const cell = event.closed.?;
+        try t.expect(cell.trace != null and cell.form == .repl);
+        try observe(&bank, cell.code, cases[i][2], cell.form);
+    }
+}
+
+test "runner proof: modular notation keeps code XOR floats decimals and malformed expressions abstaining" {
+    var bank = try graph.Bank.load(t.allocator, try bankPath());
+    defer bank.deinit();
+    for ([_][]const u8{
+        "7.0**123%1000000007", "3**400%1e18", "3**400%(10/2)",        "3**400%0",       "3**-1%10",
+        "0x",                  "0xGG",        "0xFEDCBA9876543210,1", "7^123 mod",      "7^123 mod 10=1",
+        "7^123 mod 10=",       "50%+5",       "2*50%3",               "3**400%10**100", "0x1\n+2",
+        "2^",                  "print(2^3)",
+    }) |source| {
+        const bytes = try math.lower(t.allocator, &bank, source, true);
+        defer if (bytes) |b| t.allocator.free(b);
+        try t.expect(bytes == null);
+    }
+    for ([_][]const u8{ "7^123%1000000007", "3^400 mod 10^18" }) |source|
+        try t.expectEqual(@as(?[]u8, null), try math.lower(t.allocator, &bank, source, false));
+    const wrong = (try math.lower(t.allocator, &bank, "7^124 mod 1000000007", true)).?;
+    defer t.allocator.free(wrong);
+    var machine = try @import("runner_graph_machine.zig").Machine.boot(t.allocator, &bank, wrong);
+    defer machine.deinit();
+    var out: std.ArrayList(u8) = .empty;
+    defer out.deinit(t.allocator);
+    _ = try machine.run(4_000_000, &out, null);
+    try t.expect(!std.mem.eql(u8, out.items, cases[0][2]));
+}
+
+test "runner proof: inline integer recovery cannot call notebook-shadowed builtins" {
+    var bank = try graph.Bank.load(t.allocator, try bankPath());
+    defer bank.deinit();
+    for ([_][]const u8{ "pow = lambda *args: 42", "int = lambda *args: 42", "__builtins__ = {}" }) |prior| {
+        try t.expectEqual(@as(?[]u8, null), try @import("runner_graph_program.zig").direct(t.allocator, &bank, .{
+            .form = .inline_expr,
+            .lang = "python",
+            .code = "pow(7,123,1000000007)",
+            .prior = &.{prior},
+        }, .unsupported));
+        try t.expectEqual(@as(?[]u8, null), try @import("runner_graph_program.zig").direct(t.allocator, &bank, .{
+            .form = .repl,
+            .lang = "python",
+            .code = "int('ff',16)",
+            .prior = &.{prior},
+        }, .unsupported));
+    }
+}
+
+test "runner proof: routed code caret and float-context division keep their language semantics" {
+    var bank = try graph.Bank.load(t.allocator, try bankPath());
+    defer bank.deinit();
+    var context: frontend.Context = .{ .io = t.io, .exact_inline = false, .compiler = .{ .clang = "/nonexistent-regression-clang" } };
+    var routed: route.Routed = .{ .inner = context.frontend(), .bank = &bank };
+    const f = routed.frontend();
+    for ([_]@import("runner_api.zig").Cell{
+        .{ .form = .repl, .lang = "python", .code = "2^3" },
+        .{ .form = .repl, .lang = "python", .code = "7^123 mod 1000000007" },
+        .{ .form = .repl, .lang = "python", .code = "1.25*2" },
+        .{ .form = .repl, .lang = "python", .code = "1/3" },
+        .{ .form = .fence, .lang = "python", .code = "print(2^3)" },
+        .{ .form = .fence, .lang = "python", .code = "print(7.0/3)" },
+        .{ .form = .inline_expr, .lang = "python", .code = "0.5+1" },
+        .{ .form = .inline_expr, .lang = "python", .code = "1/3" },
+        .{ .form = .inline_expr, .lang = "python", .code = ">>> 2^3" },
+        .{ .form = .inline_expr, .lang = "python", .code = ">>> 0xff" },
+    }) |cell| {
+        const result = try f.translate(f.ctx, t.allocator, cell);
+        defer if (result == .program) t.allocator.free(result.program.bytes);
+        try t.expect(result == .abstain);
+    }
+}
