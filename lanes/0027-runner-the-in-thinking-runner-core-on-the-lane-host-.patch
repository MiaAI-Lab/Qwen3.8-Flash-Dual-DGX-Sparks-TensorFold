+    .{ "Let's double-check remainder using modular arithmetic. 10^3=1000 mod97=30. 10^6=900 mod97=27? 97*9=873 rem27. 10^12=27^2=729 mod97=50. 10^24=50^2=2500 mod97=", "2500 mod 97", "75" },
