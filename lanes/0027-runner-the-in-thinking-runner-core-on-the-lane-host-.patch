+++ b/zig/src/core/runner_receipt.zig
@@ -0,0 +1,234 @@
+//! A reply's runner receipt (runtime.runner): cell counts, holds and a record per owned cell's span, route and write.
+const std = @import("std");
+const abstain = @import("runner_abstain.zig");
+const answer = @import("runner_commit.zig");
+const Allocator = std.mem.Allocator;
+
+/// A span longer than this is recorded as its sha256 and length: the reply holds it in full.
+const span_max = 512;
+
+/// One owned cell's write as it landed in the reply.
+const Record = struct {
+    cell: u32,
+    content: bool, // its field: content (after the think end), else reasoning
+    at: u64, // the field's bytes before the write
+    token: u32, // the reply's tokens before the write
+    round: u32, // the session's ticks when the cell was owned
+    want: []u32, // the result's tokens (gpa)
+    landed: u32 = 0, // of them, committed in order (fewer: the reply's budget cut them, or another token came)
+    drafted: u32 = 0, // of those, committed in the trigger's own commit: the model's verify agreed (sync, never held)
+    sync: bool = false, // settled at its trigger (sync_graph), else held and forced after the hold
+    value: std.ArrayList(u8) = .empty, // the landed tokens' bytes
+    told: ?u32 = null, // landed when `notes` last gave it to the stream (null: never)
+};
+
+/// A record as it stands, for the stream (`notes`): its field, the field's bytes through its last landed byte, JSON.
+pub const Note = struct { index: u32, content: bool, end: u64, json: []const u8 };
+
+/// The records and the counters they need; every committed token passes through `token` (Session.feed).
+pub const Log = struct {
+    on: bool = true,
+    tokens: u32 = 0,
+    bytes: [2]u64 = .{ 0, 0 }, // per field: reasoning, content
+    content: bool = false, // the last token's field
+    rounds: u32 = 0, // Session.tick calls: one per engine round
+    writing: bool = false, // the last record's tokens are still landing
+    records: std.ArrayList(Record) = .empty,
+    out: std.ArrayList(u8) = .empty, // the receipt JSON (write)
+    live: std.ArrayList(u8) = .empty, // the JSON `notes` gave last
+    notes: std.ArrayList(Note) = .empty,
+    abstains_on: bool = false, // PREFIX_ABSTAINS (records on): abstained cells too, with their sources (runner_abstain.zig)
+    text: [2]std.ArrayList(u8) = .{ .empty, .empty }, // abstain records: per field, the reply's bytes (to find sources)
+    closes: std.ArrayList(abstain.Close) = .empty, // abstain records: where each cell's source closed
+    abstains: std.ArrayList(abstain.Abstain) = .empty,
+    dropped: u32 = 0, // abstain records out of memory
+    anchors_lost: bool = false, // a source anchor out of memory: the records stand, the census is incomplete
+    commit: ?answer.Record = null, // PREFIX_COMMIT fired: its close and answer, landing after its cell's write
+
+    /// A committed token: counted in its field, and matched against a write still landing.
+    pub fn token(l: *Log, gpa: Allocator, id: u32, bytes: []const u8, think_open: bool) Allocator.Error!void {
+        if (!l.on) return;
+        l.content = !think_open;
+        if (l.abstains_on) l.text[@intFromBool(l.content)].appendSlice(gpa, bytes) catch {
+            l.anchors_lost = true;
+        };
+        defer {
+            l.tokens += 1;
+            l.bytes[@intFromBool(l.content)] += bytes.len;
+        }
+        if (!l.writing) return if (l.commit) |*c| c.land(gpa, id, bytes, l.bytes[1], l.tokens);
+        const r = &l.records.items[l.records.items.len - 1];
+        l.writing = r.want[r.landed] == id;
+        if (!l.writing) return;
+        try r.value.appendSlice(gpa, bytes);
+        r.landed += 1;
+        if (r.sync and l.rounds == r.round) r.drafted += 1;
+        l.writing = r.landed < r.want.len;
+    }
+
+    /// Cell `cell` owned with `ids` to force after the token just fed (copied).
+    pub fn owned(l: *Log, gpa: Allocator, cell: u32, ids: []const u32) Allocator.Error!void {
+        if (!l.on) return;
+        l.writing = false;
+        const want = try gpa.dupe(u32, ids);
+        errdefer gpa.free(want);
+        try l.records.append(gpa, .{ .cell = cell, .content = l.content, .at = l.bytes[@intFromBool(l.content)], .token = l.tokens, .round = l.rounds, .want = want });
+        l.writing = ids.len > 0;
+    }
+
+    /// The record just owned settled at its trigger (sync_graph): its tokens in this commit are the model's own drafts.
+    pub fn synced(l: *Log) void {
+        if (l.records.items.len > 0) l.records.items[l.records.items.len - 1].sync = true;
+    }
+
+    /// Cell `cell`'s source closed with the token fed last (abstain records: where to find it).
+    pub fn closed(l: *Log, gpa: Allocator, cell: u32) void {
+        if (!l.on or !l.abstains_on) return;
+        l.closes.append(gpa, .{ .cell = cell, .content = l.content, .end = l.bytes[@intFromBool(l.content)] }) catch {
+            l.anchors_lost = true;
+        };
+    }
+
+    /// Cell `a.cell` abstained here: the reply's field, bytes, tokens and rounds at its decision (abstain records).
+    pub fn abstained(l: *Log, gpa: Allocator, a: abstain.Abstain) void {
+        if (!l.on or !l.abstains_on) return;
+        var x = a;
+        x.content = l.content;
+        x.at = l.bytes[@intFromBool(l.content)];
+        x.token = l.tokens;
+        x.round = l.rounds;
+        l.abstains.append(gpa, x) catch {
+            l.dropped += 1;
+        };
+    }
+
+    pub fn deinit(l: *Log, gpa: Allocator) void {
+        for (l.records.items) |*r| {
+            gpa.free(r.want);
+            r.value.deinit(gpa);
+        }
+        l.records.deinit(gpa);
+        if (l.commit) |*c| c.deinit(gpa);
+        l.out.deinit(gpa);
+        l.live.deinit(gpa);
+        l.notes.deinit(gpa);
+        for (&l.text) |*t| t.deinit(gpa);
+        l.closes.deinit(gpa);
+        l.abstains.deinit(gpa);
+    }
+};
+
+/// Session `s`'s receipt JSON (runner.Session), in its log's buffer until the session is destroyed ("": out of memory).
+pub fn write(s: anytype) []const u8 {
+    const l = &s.rec;
+    l.out.clearRetainingCapacity();
+    const cfg = if (comptime @typeInfo(@TypeOf(s.r)) == .pointer) &s.r.cfg else null;
+    put(s.cells.items, l, s.r.gpa, s.held_ms, s.resume_ms, cfg) catch return "";
+    return l.out.items;
+}
+
+/// Session `s`'s records new or grown since the last call (null: none, or records off), for a stream cut early.
+pub fn notes(s: anytype) ?[]const Note {
+    const l = &s.rec;
+    if (!l.on) return null;
+    fresh(s.cells.items, l, s.r.gpa) catch return null; // out of memory: the next call gives them again
+    return if (l.notes.items.len > 0) l.notes.items else null;
+}
+
+fn fresh(cells: anytype, l: *Log, gpa: Allocator) Allocator.Error!void {
+    l.notes.clearRetainingCapacity();
+    l.live.clearRetainingCapacity();
+    for (l.records.items, 0..) |r, i| if (r.told != r.landed) {
+        const from = l.live.items.len;
+        try record(&l.live, gpa, cells, r);
+        try l.notes.append(gpa, .{ .index = @intCast(i), .content = r.content, .end = r.at + r.value.items.len, .json = l.live.items[from..] });
+    };
+    var from: usize = 0;
+    for (l.notes.items) |*n| {
+        n.json = l.live.items[from..][0..n.json.len]; // the buffer may have moved as it grew
+        from += n.json.len;
+        l.records.items[n.index].told = l.records.items[n.index].landed;
+    }
+}
+
+pub const form_names = [_][]const u8{ "fence", "repl", "inline", "trace" };
+
+fn put(cells: anytype, l: *Log, gpa: Allocator, held_ms: u64, resume_ms: u64, cfg: anytype) Allocator.Error!void {
+    var forms = std.mem.zeroes([4][4]u32);
+    var kinds = std.mem.zeroes([3]u32);
+    for (cells) |c| {
+        const f = &forms[if (c.stated != null) 3 else @backingInt(c.form)];
+        f[0] += 1;
+        switch (c.told) {
+            .none => {},
+            .owned => {
+                f[1] += 1;
+                f[3] += c.owned_tokens;
+                if (c.translation == .program) kinds[@backingInt(c.translation.program.kind)] += 1;
+            },
+            .abstained => f[2] += 1,
+        }
+    }
+    const o = &l.out;
+    try o.append(gpa, '{');
+    for (forms, form_names) |f, name|
+        try o.print(gpa, "\"{s}\":{{\"closed\":{d},\"owned\":{d},\"abstained\":{d},\"owned_tokens\":{d}}},", .{ name, f[0], f[1], f[2], f[3] });
+    try o.print(gpa, "\"owned_by\":{{\"calc\":{d},\"elf\":{d},\"graph\":{d}}},\"held_ms\":{d},\"resume_ms\":{d}", .{ kinds[0], kinds[1], kinds[2], held_ms, resume_ms });
+    if (l.on) {
+        try o.appendSlice(gpa, ",\"cells\":[");
+        for (l.records.items, 0..) |r, i| {
+            if (i > 0) try o.append(gpa, ',');
+            try record(o, gpa, cells, r);
+        }
+        try o.append(gpa, ']');
+        if (l.abstains_on) try abstain.write(o, gpa, cells, l, cfg);
+        if (l.commit) |c| try answer.write(o, gpa, cells, c);
+    }
+    try o.append(gpa, '}');
+}
+
+/// One record's JSON object, as the receipt's `cells` and the stream's notes give it.
+fn record(o: *std.ArrayList(u8), gpa: Allocator, cells: anytype, r: Record) Allocator.Error!void {
+    const c = cells[r.cell];
+    const route = if (c.translation == .program) @tagName(c.translation.program.kind) else "none";
+    const status = if (c.result) |res| @tagName(res.status) else "none";
+    try o.print(gpa, "{{\"cell\":{d},\"form\":\"{s}\",\"route\":\"{s}\",\"status\":\"{s}\",", .{ r.cell, form_names[if (c.stated != null) 3 else @backingInt(c.form)], route, status });
+    try text(o, gpa, "lang", c.lang);
+    if (c.code.len <= span_max) try text(o, gpa, "span", c.code) else {
+        var digest: [32]u8 = undefined;
+        std.crypto.hash.sha2.Sha256.hash(c.code, &digest, .{});
+        try o.print(gpa, "\"span_sha256\":\"{s}\",\"span_len\":{d},", .{ std.fmt.bytesToHex(digest, .lower), c.code.len });
+    }
+    if (c.stated) |st| try text(o, gpa, "display", st.display);
+    try text(o, gpa, "value", r.value.items);
+    try o.print(gpa, "\"field\":\"{s}\",\"at\":{d},\"token\":{d},\"ids\":{d},\"landed\":{d},\"drafted\":{d},\"forced\":{d},\"path\":\"{s}\"}}", .{ if (r.content) "content" else "reasoning", r.at, r.token, r.want.len, r.landed, r.drafted, r.landed - r.drafted, if (r.sync) "sync" else "held" });
+}
+
+/// `"name":"bytes",` as a JSON string; bytes that are not UTF-8 (a cut mid-character) go as `"name_hex"` instead.
+pub fn text(o: *std.ArrayList(u8), gpa: Allocator, name: []const u8, bytes: []const u8) Allocator.Error!void {
+    if (!std.unicode.utf8ValidateSlice(bytes)) {
+        try o.print(gpa, "\"{s}_hex\":\"", .{name});
+        for (bytes) |b| try o.print(gpa, "{x:0>2}", .{b});
+        return o.appendSlice(gpa, "\",");
+    }
+    try o.print(gpa, "\"{s}\":", .{name});
+    try quoted(o, gpa, bytes);
+    try o.append(gpa, ',');
+}
+
+/// `bytes` as one JSON value: a string, or `{"hex":"…"}` when they are not UTF-8.
+pub fn quoted(o: *std.ArrayList(u8), gpa: Allocator, bytes: []const u8) Allocator.Error!void {
+    if (!std.unicode.utf8ValidateSlice(bytes)) {
+        try o.appendSlice(gpa, "{\"hex\":\"");
+        for (bytes) |b| try o.print(gpa, "{x:0>2}", .{b});
+        return o.appendSlice(gpa, "\"}");
+    }
+    try o.append(gpa, '"');
+    for (bytes) |b| switch (b) {
+        '"' => try o.appendSlice(gpa, "\\\""),
+        '\\' => try o.appendSlice(gpa, "\\\\"),
+        0...0x1f, 0x7f => try o.print(gpa, "\\u{x:0>4}", .{b}),
+        else => try o.append(gpa, b),
+    };
+    try o.append(gpa, '"');
+}
diff --git a/zig/src/core/runner_receipt_test.zig b/zig/src/core/runner_receipt_test.zig
new file mode 100644
index 000000000..fb4cf206f
--- /dev/null
+++ b/zig/src/core/runner_receipt_test.zig
@@ -0,0 +1,208 @@
+//! The receipt's per-cell records: end to end on a lane host (held results), and the log's drafted/forced/cut rules.
+const std = @import("std");
+const rapi = @import("runner_api.zig");
+const scan = @import("runner_scan.zig");
+const records = @import("runner_receipt.zig");
+const rt = @import("runner_test.zig");
+
+const gpa = std.testing.allocator;
+
+test {
+    _ = @import("runner_abstain_test.zig");
+}
+
+/// The first record of a receipt, parsed.
+const Rec = struct { cell: u32, form: []const u8, route: []const u8, status: []const u8, lang: []const u8, span: []const u8, value: []const u8, field: []const u8, at: u64, token: u32, ids: u32, landed: u32, drafted: u32, forced: u32, path: []const u8 };
+
+const Receipt = struct { cells: []const Rec };
+
+fn first(receipt: []const u8) !std.json.Parsed(Receipt) {
+    return std.json.parseFromSlice(Receipt, gpa, receipt, .{ .ignore_unknown_fields = true, .allocate = .alloc_always });
+}
+
+test "runner receipt: a held fence result records its span, route and the bytes that landed after the header" {
+    var back: rt.Back = .{};
+    defer back.deinit();
+    var m = [_]rt.Model{.{ .lead = rt.mul_cell }};
+    var sums: [1][]u8 = undefined;
+    const texts = try rt.replies(&m, .{ .summaries = &sums }, &back);
+    defer rt.freeAll(texts);
+    defer gpa.free(sums[0]);
+    const p = try first(sums[0]);
+    defer p.deinit();
+    try std.testing.expectEqual(1, p.value.cells.len);
+    const r = p.value.cells[0];
+    try std.testing.expectEqualStrings("fence", r.form);
+    try std.testing.expectEqualStrings("calc", r.route);
+    try std.testing.expectEqualStrings("ok", r.status);
+    try std.testing.expectEqualStrings("python", r.lang);
+    try std.testing.expectEqualStrings("print(123456789012345678901234567890 * 987654321098765432109876543210)\n", r.span);
+    // one token a character: the write starts at the header's newline (the result's), its bytes are the reply's there
+    try std.testing.expectEqualStrings("content", r.field);
+    try std.testing.expectEqual(rt.mul_cell.len - 1, r.at);
+    try std.testing.expectEqual(rt.mul_cell.len - 1, r.token);
+    try std.testing.expectEqualStrings(texts[0][r.at..][0..r.value.len], r.value);
+    try std.testing.expect(std.mem.startsWith(u8, r.value, "\n" ++ rt.product));
+    try std.testing.expectEqual(r.ids, r.landed);
+    try std.testing.expectEqual(0, r.drafted);
+    try std.testing.expectEqual(r.landed, r.forced);
+    try std.testing.expectEqualStrings("held", r.path);
+}
+
+test "runner receipt: an inline value records the parsed expression and the value after `=`" {
+    var back: rt.Back = .{};
+    defer back.deinit();
+    const lead = "Exact: 1.5+2.25 =";
+    var m = [_]rt.Model{.{ .lead = lead }};
+    var sums: [1][]u8 = undefined;
+    const texts = try rt.replies(&m, .{ .summaries = &sums, .inline_math = true }, &back);
+    defer rt.freeAll(texts);
+    defer gpa.free(sums[0]);
+    const p = try first(sums[0]);
+    defer p.deinit();
+    const r = p.value.cells[0];
+    try std.testing.expectEqualStrings("inline", r.form);
+    try std.testing.expectEqualStrings("1.5+2.25", std.mem.trim(u8, r.span, " "));
+    try std.testing.expectEqualStrings(" 3.75", r.value);
+    try std.testing.expectEqual(lead.len, r.at);
+    try std.testing.expectEqualStrings(" 3.75", texts[0][r.at..][0..r.value.len]);
+}
+
+/// The fields records.write reads off a runner.Session and its cells.
+const FakeCell = struct {
+    form: rapi.Form = .repl,
+    stated: ?scan.Stated = null,
+    told: enum { none, owned, abstained } = .owned,
+    owned_tokens: u32 = 0,
+    translation: rapi.Translation = .{ .program = .{ .kind = .graph, .bytes = "" } },
+    result: ?rapi.Result = .{ .status = .ok },
+    lang: []const u8 = "python",
+    code: []const u8 = "2**8",
+};
+
+const FakeSession = struct {
+    r: struct { gpa: std.mem.Allocator = gpa } = .{},
+    cells: struct { items: []const *FakeCell },
+    held_ms: u64 = 0,
+    resume_ms: u64 = 0,
+    rec: records.Log = .{},
+};
+
+test "runner receipt: a sync write is drafted within its trigger's commit and forced after a round; a cut lands less" {
+    var cell: FakeCell = .{};
+    var s: FakeSession = .{ .cells = .{ .items = &.{&cell} } };
+    defer s.rec.deinit(gpa);
+    try s.rec.token(gpa, 1, "x", true);
+    try s.rec.owned(gpa, 0, &.{ 7, 8, 9 });
+    s.rec.synced();
+    try s.rec.token(gpa, 7, "25", true); // the trigger's commit: the model's verify had the result's token
+    s.rec.rounds += 1;
+    try s.rec.token(gpa, 8, "6", true); // forced in the next round
+    try s.rec.token(gpa, 5, "?", true); // not the result's: the write is cut there
+    try s.rec.token(gpa, 9, "!", true);
+    const p = try first(records.write(&s));
+    defer p.deinit();
+    const r = p.value.cells[0];
+    try std.testing.expectEqualStrings("256", r.value);
+    try std.testing.expectEqual(3, r.ids);
+    try std.testing.expectEqual(2, r.landed);
+    try std.testing.expectEqual(1, r.drafted);
+    try std.testing.expectEqual(1, r.forced);
+    try std.testing.expectEqualStrings("sync", r.path);
+    try std.testing.expectEqualStrings("reasoning", r.field);
+    try std.testing.expectEqual(1, r.at);
+    try std.testing.expectEqual(1, r.token);
+    try std.testing.expectEqualStrings("graph", r.route);
+}
+
+test "runner receipt: escapes, a long span as sha256, bytes cut mid-character as hex, and no records when off" {
+    const long: [600]u8 = @splat('x');
+    var cell: FakeCell = .{ .code = &long };
+    var s: FakeSession = .{ .cells = .{ .items = &.{&cell} } };
+    defer s.rec.deinit(gpa);
+    try s.rec.token(gpa, 0, "", false); // the think end: content from here
+    try s.rec.owned(gpa, 0, &.{ 1, 2 });
+    try s.rec.token(gpa, 1, "\"a\\\n", false);
+    try s.rec.token(gpa, 2, "\xcf", false);
+    const got = records.write(&s);
+    try std.testing.expect(std.mem.indexOf(u8, got, "\"span_len\":600,") != null);
+    try std.testing.expect(std.mem.indexOf(u8, got, "\"value_hex\":\"22615c0acf\",") != null);
+    try std.testing.expect(std.mem.indexOf(u8, got, "\"field\":\"content\",\"at\":0,") != null);
+    cell.code = "say \"hi\"\n";
+    s.rec.records.items[0].value.items.len = 4;
+    const esc = records.write(&s);
+    try std.testing.expect(std.mem.indexOf(u8, esc, "\"span\":\"say \\\"hi\\\"\\u000a\",\"value\":\"\\\"a\\\\\\u000a\",") != null);
+    var off: FakeSession = .{ .cells = .{ .items = &.{&cell} }, .rec = .{ .on = false } };
+    defer off.rec.deinit(gpa);
+    try off.rec.owned(gpa, 0, &.{1});
+    try off.rec.token(gpa, 1, "1", false);
+    try std.testing.expect(std.mem.endsWith(u8, records.write(&off), "\"resume_ms\":0}"));
+}
+
+test "runner receipt: each record reaches the stream as it lands, byte for byte as the finished receipt writes it" {
+    var back: rt.Back = .{};
+    defer back.deinit();
+    var m = [_]rt.Model{ .{ .lead = rt.mul_cell }, .{ .lead = "Exact: 1.5+2.25 =" } };
+    var sums: [2][]u8 = undefined;
+    var live: [2][]u8 = undefined;
+    const texts = try rt.replies(&m, .{ .summaries = &sums, .live = &live, .inline_math = true }, &back);
+    defer rt.freeAll(texts);
+    for (sums, live) |sum, notes| {
+        defer gpa.free(sum);
+        defer gpa.free(notes);
+        try std.testing.expect(notes.len > 0);
+        const cells = try std.mem.concat(gpa, u8, &.{ "\"cells\":[", notes, "]}" });
+        defer gpa.free(cells);
+        try std.testing.expect(std.mem.endsWith(u8, sum, cells));
+    }
+    // records off: no note, and the same tokens
+    var off_sums: [2][]u8 = undefined;
+    var off_live: [2][]u8 = undefined;
+    const off = try rt.replies(&m, .{ .summaries = &off_sums, .live = &off_live, .inline_math = true, .cells = false }, &back);
+    defer rt.freeAll(off);
+    for (off_sums, off_live, texts, off) |sum, notes, on_text, off_text| {
+        defer gpa.free(sum);
+        defer gpa.free(notes);
+        try std.testing.expectEqual(0, notes.len);
+        try std.testing.expect(std.mem.indexOf(u8, sum, "\"cells\"") == null);
+        try std.testing.expectEqualStrings(on_text, off_text);
+    }
+}
+
+test "runner receipt: notes give a record when owned and each time it grows, never twice, none when records are off" {
+    var cell: FakeCell = .{};
+    var s: FakeSession = .{ .cells = .{ .items = &.{&cell} } };
+    defer s.rec.deinit(gpa);
+    try std.testing.expect(records.notes(&s) == null);
+    try s.rec.token(gpa, 1, "ab", true);
+    try s.rec.owned(gpa, 0, &.{ 7, 8 });
+    const owned = records.notes(&s).?;
+    try std.testing.expectEqual(1, owned.len);
+    try std.testing.expectEqual(2, owned[0].end); // nothing landed: it ends where it starts
+    try std.testing.expect(std.mem.indexOf(u8, owned[0].json, "\"value\":\"\",") != null);
+    try std.testing.expect(records.notes(&s) == null);
+    try s.rec.token(gpa, 7, "25", true);
+    const grown = records.notes(&s).?;
+    try std.testing.expectEqual(0, grown[0].index);
+    try std.testing.expectEqual(4, grown[0].end);
+    try std.testing.expect(!grown[0].content);
+    try std.testing.expect(std.mem.indexOf(u8, grown[0].json, "\"value\":\"25\",") != null);
+    try std.testing.expect(std.mem.indexOf(u8, grown[0].json, "\"landed\":1,") != null);
+    try std.testing.expect(records.notes(&s) == null);
+    try s.rec.token(gpa, 3, "!", true); // not the result's: the record stops growing
+    try std.testing.expect(records.notes(&s) == null);
+    try s.rec.owned(gpa, 0, &.{9});
+    try s.rec.token(gpa, 9, "6", true);
+    const second = records.notes(&s).?;
+    try std.testing.expectEqual(1, second.len);
+    try std.testing.expectEqual(1, second[0].index);
+    const receipt = records.write(&s);
+    const tail = try std.mem.concat(gpa, u8, &.{ second[0].json, "]}" });
+    defer gpa.free(tail);
+    try std.testing.expect(std.mem.endsWith(u8, receipt, tail));
+    var off: FakeSession = .{ .cells = .{ .items = &.{&cell} }, .rec = .{ .on = false } };
+    defer off.rec.deinit(gpa);
+    try off.rec.owned(gpa, 0, &.{1});
+    try off.rec.token(gpa, 1, "1", false);
+    try std.testing.expect(records.notes(&off) == null);
+}
diff --git a/zig/src/core/runner_scan.zig b/zig/src/core/runner_scan.zig
new file mode 100644
index 000000000..48a994ba7
--- /dev/null
+++ b/zig/src/core/runner_scan.zig
@@ -0,0 +1,563 @@
+//! The in-model runner's scanner: closed code cells and the model's own result headers, from committed reply bytes.
+const std = @import("std");
+const api = @import("runner_api.zig");
+const trace = @import("runner_trace.zig");
+const header = @import("runner_scan_boundary.zig");
+const inline_scan = @import("runner_scan_inline.zig");
+const Allocator = std.mem.Allocator;
+
+pub const Config = struct {
+    fence: bool = true, // ```lang … ``` blocks
+    repl: bool = true, // `>>> ` lines
+    lookahead: u32 = 64, // tokens after a closed fence in which a result header counts
+    reasoning_only: bool = false, // triggers only while the think block is open
+    inline_math: bool = false, // `A op B =` at a line's end: the value after `=` (exact math semantics)
+    inline_mod: bool = true, // with inline_math: `A mod M =` and `A % M =` on literals, after any earlier `=`
+    inline_arith: bool = true, // with inline_math: thousands commas (`147,000+73`), a whole `gcd(a, b)` or `0xFF`
+    inline_chain: bool = false, // opt-in, T5 decides: the last `<expr> =` after an earlier `=` statement
+    float_window: u32 = 512, // tokens after a Python-float cue in which an inline span with `.` or `/` abstains
+    trace: bool = false, // a computation the reasoning states, owned as `[exact: …]` where its hand trace starts
+    trace_window: u32 = 512, // tokens after a stated computation's line in which a hand-trace cue counts
+    trace_repeat: u8 = 0, // a restated, already owned line is owned again up to this many times
+    trace_whole: bool = false, // opt-in (PREFIX_STATED): trace also takes the whole-statement shapes
+};
+
+/// Trace ownerships per reply, and trace cells (stated computations) a reply may open.
+const trace_owned_max = 16;
+const trace_cells_max = 32;
+
+/// Text after which a reply keeps its own decimals and fractions: Python floats, or a common denominator.
+const float_cues = [_][]const u8{ "float", "Decimal(", "sum(", "round(", "0.1+0.2", "0.1 + 0.2", "lcm", "LCM", "LCD", "denominator" };
+/// Text after which `a + b` may join digits rather than add them (live: `Concatenate: … 1119 + 392 = 1119392`).
+const join_cues = [_][]const u8{ "oncatenat", "join", "Join" };
+/// Lines after a join cue in which a bare `a + b` opening its line keeps the model's own value.
+const join_lines = 2;
+
+/// A closed cell; `lang` and `code` live in the scanner until the next `feed`.
+pub const Closed = struct { index: u32, form: api.Form, lang: []const u8, code: []const u8, own_context: bool = false, trace: ?Stated = null }; // own_context: the reply keeps its value
+
+/// A trace cell's line text: what `[exact: … = value]` shows, and whether the value is a (quotient, remainder) pair.
+pub const Stated = struct { display: []const u8, divmod: bool };
+
+/// Cell `index`'s result begins: `fenced` closes a fence after it; `inline_space` (inline: value only) adds a space.
+pub const Trigger = struct { index: u32, fenced: bool = false, inline_space: ?bool = null, trace: bool = false, newline_before: bool = false, terminal: bool = false }; // trace: `[exact: …]` line
+
+pub const Events = struct { closed: ?Closed = null, trigger: ?Trigger = null };
+
+const State = enum { prose, fence, after };
+
+pub const Scanner = struct {
+    cfg: Config,
+    state: State = .prose,
+    line: std.ArrayList(u8) = .empty,
+    lang: std.ArrayList(u8) = .empty,
+    code: std.ArrayList(u8) = .empty,
+    cells: u32 = 0, // cells closed so far; the next one's index
+    pending: u32 = 0, // the fence or REPL cell a result header refers to
+    since: u32 = 0, // tokens since the pending cell closed (state .after)
+    terminal_ready: bool = false,
+    armed: ?Trigger = null, // a trigger this token set; later non-blank bytes in the same token spoil it
+    tokens: u32 = 0, // tokens fed
+    float_at: ?u32 = null, // the token of the last float cue or closed code cell
+    lines: u32 = 0, // newlines fed
+    join_line: ?u32 = null, // the line of the last join cue
+    tail: [16]u8 = undefined, // the last bytes fed, for cues split across tokens
+    tail_len: usize = 0,
+    think: bool = false, // the think block was open at the last token
+    code_cells: u32 = 0, // fence and REPL cells closed so far
+    tracer: ?trace.Tracer = null, // names and owned statements (form trace; made at the first reasoning line)
+    trace_src: std.ArrayList(u8) = .empty, // the pending statement's Python source
+    trace_disp: std.ArrayList(u8) = .empty,
+    trace_armed: std.ArrayList(u8) = .empty, // the display of the trace cell armed in this token
+    trace_cell: ?u32 = null, // the stated computation waiting for its cue
+    trace_at: u32 = 0, // the token its line ended at
+    trace_cells: u32 = 0,
+    trace_owned: u32 = 0,
+    above: [3]std.ArrayList(u8) = .{ .empty, .empty, .empty }, // with STATED: the last three lines, newest first
+
+    pub fn deinit(s: *Scanner, a: Allocator) void {
+        for (&s.above) |*l| l.deinit(a);
+        s.line.deinit(a);
+        s.lang.deinit(a);
+        s.code.deinit(a);
+        s.trace_src.deinit(a);
+        s.trace_disp.deinit(a);
+        s.trace_armed.deinit(a);
+        if (s.tracer) |*t| t.deinit();
+    }
+
+    /// One committed token's bytes; `think_open`: the think block is open at this token.
+    pub fn feed(s: *Scanner, a: Allocator, bytes: []const u8, think_open: bool) Allocator.Error!Events {
+        var ev: Events = .{};
+        s.armed = null;
+        s.tokens +|= 1;
+        // the think block's end has no bytes of its own, yet the answer starts on a new line
+        if (s.think and !think_open and s.line.items.len > 0) {
+            try s.endLine(a, &ev, true);
+            try s.keepLine(a);
+            s.line.clearRetainingCapacity();
+        }
+        s.think = think_open;
+        if (s.state == .after) {
+            s.since += 1;
+            if (s.since > s.cfg.lookahead) s.state = .prose;
+        }
+        if (s.trace_cell != null and s.tokens - s.trace_at > s.cfg.trace_window) s.trace_cell = null;
+        for (bytes) |b| {
+            s.cue(b);
+            if (s.state == .after and !std.ascii.isWhitespace(b)) s.terminal_ready = false;
+            if (s.armed != null and b != '\n' and b != ' ' and b != '\t' and b != '\r') s.armed = null;
+            if (b != '\n') {
+                try s.line.append(a, b);
+                continue;
+            }
+            s.lines +|= 1;
+            try s.endLine(a, &ev, think_open);
+            try s.keepLine(a);
+            s.line.clearRetainingCapacity();
+        }
+        ev.trigger = s.armed;
+        if (ev.trigger) |t| if (t.trace) try s.traceSpent(t.index);
+        const allowed = think_open or !s.cfg.reasoning_only;
+        if (ev.trigger == null and s.state == .after and allowed and header.ready(s.line.items)) {
+            s.fire(false);
+            ev.trigger = s.armed;
+            ev.trigger.?.newline_before = true;
+        }
+        if (s.cfg.inline_math and allowed and s.state != .fence and ev.closed == null and ev.trigger == null and
+            std.mem.indexOfScalar(u8, bytes, '=') != null)
+        {
+            const floats = s.float_at != null and s.tokens - s.float_at.? <= s.cfg.float_window;
+            // a modular step first: inlineExpr alone would take `10^18` of `3^400 mod 10^18 =` for the whole
+            if (if (s.cfg.inline_mod) inline_scan.inlineMod(s.line.items) else null) |m| {
+                s.lang.clearRetainingCapacity();
+                try s.lang.appendSlice(a, "python");
+                s.code.clearRetainingCapacity();
+                try m.code(a, &s.code);
+                ev.closed = s.close(.inline_expr);
+                // Python reads 1e9 as a float: a reply reasoning in floats keeps its own value
+                ev.closed.?.own_context = floats and std.mem.indexOfScalar(u8, m.modulus, 'e') != null;
+                ev.trigger = .{ .index = ev.closed.?.index, .inline_space = m.space };
+            } else if (inline_scan.inlineExpr(s.line.items, s.cfg.inline_arith, s.cfg.inline_chain)) |x| {
+                s.lang.clearRetainingCapacity();
+                try s.lang.appendSlice(a, "python");
+                s.code.clearRetainingCapacity();
+                // thousands commas go: Python would read `147,000+73` as a tuple
+                if (x.call) {
+                    try s.code.appendSlice(a, x.expr);
+                } else for (x.expr) |c| {
+                    if (c != ',') try s.code.append(a, c);
+                }
+                ev.closed = s.close(.inline_expr);
+                // `1119 + 392 =` opening its line, just after a join cue: the model may be joining digit groups
+                const lead = std.mem.trim(u8, s.line.items[0 .. @intFromPtr(x.expr.ptr) - @intFromPtr(s.line.items.ptr)], " \t");
+                const joined = s.join_line != null and s.lines - s.join_line.? <= join_lines and lead.len == 0 and
+                    inline_scan.twoInts(x.expr);
+                ev.closed.?.own_context = joined or (floats and std.mem.indexOfAny(u8, x.expr, "./") != null);
+                ev.trigger = .{ .index = ev.closed.?.index, .inline_space = x.space };
+            } else if (if (s.cfg.trace_whole) inline_scan.stacked(s.line.items, s.above[2].items, s.above[1].items, s.above[0].items) else null) |c| {
+                // STATED: a stacked column (`264,278,…` / `+771,565,…` / `= ?`), the `=` alone on its line
+                s.lang.clearRetainingCapacity();
+                try s.lang.appendSlice(a, "python");
+                s.code.clearRetainingCapacity();
+                for (c.x) |d| if (d != ',') try s.code.append(a, d);
+                try s.code.append(a, c.op);
+                for (c.y) |d| if (d != ',') try s.code.append(a, d);
+                ev.closed = s.close(.inline_expr);
+                // a join cue just above the column: its two lines may be digit groups to join, as for `1119 + 392 =`
+                ev.closed.?.own_context = c.op == '+' and s.join_line != null and s.lines - s.join_line.? <= join_lines + 2;
+                ev.trigger = .{ .index = ev.closed.?.index, .inline_space = c.space };
+            }
+        }
+        return ev;
+    }
+
+    /// STATED keeps the last three lines for a stacked column; a line too long for one is kept as a non-number.
+    fn keepLine(s: *Scanner, a: Allocator) Allocator.Error!void {
+        if (!s.cfg.trace_whole) return;
+        const oldest = s.above[2];
+        s.above[2] = s.above[1];
+        s.above[1] = s.above[0];
+        s.above[0] = oldest;
+        s.above[0].clearRetainingCapacity();
+        const l = std.mem.trimEnd(u8, s.line.items, "\r");
+        try s.above[0].appendSlice(a, if (l.len > 200) "-" else l);
+    }
+
+    pub fn finishEos(s: *Scanner, a: Allocator, think_open: bool) Allocator.Error!Events {
+        var ev: Events = .{};
+        s.tokens +|= 1;
+        if (s.state == .fence and header.fenceClose(std.mem.trimEnd(u8, s.line.items, "\r"))) {
+            try s.endLine(a, &ev, think_open);
+            s.line.clearRetainingCapacity();
+        }
+        if (s.state == .after and s.terminal_ready and s.since < s.cfg.lookahead and
+            (think_open or !s.cfg.reasoning_only))
+        {
+            s.fire(false);
+            ev.trigger = s.armed;
+            ev.trigger.?.terminal = true;
+        }
+        return ev;
+    }
+
+    fn endLine(s: *Scanner, a: Allocator, ev: *Events, think_open: bool) Allocator.Error!void {
+        const raw = std.mem.trimEnd(u8, s.line.items, "\r");
+        const allowed = think_open or !s.cfg.reasoning_only;
+        switch (s.state) {
+            .fence => {
+                if (header.fenceClose(raw)) {
+                    const prev = s.pending;
+                    const had = s.code_cells > 0;
+                    ev.closed = s.close(.fence);
+                    // `gcc x.c -o x && ./x` runs the cell before it: a header after it names that cell
+                    if (had and runsPrevious(ev.closed.?.lang, ev.closed.?.code)) s.pending = prev;
+                    s.state = .after;
+                    s.since = 0;
+                    s.terminal_ready = true;
+                } else {
+                    try s.code.appendSlice(a, raw);
+                    try s.code.append(a, '\n');
+                }
+            },
+            .prose, .after => {
+                if (s.state == .after and allowed) {
+                    // a header line only: a bare output fence is no handoff (T6 census)
+                    if (header.complete(raw)) return s.fire(false);
+                }
+                if (s.cfg.fence) if (header.fenceOpen(raw)) |lang| {
+                    s.lang.clearRetainingCapacity();
+                    for (lang) |c| try s.lang.append(a, std.ascii.toLower(c));
+                    s.code.clearRetainingCapacity();
+                    s.state = .fence;
+                    return;
+                };
+                if (s.cfg.repl) if (replLine(raw)) |src| {
+                    s.lang.clearRetainingCapacity();
+                    try s.lang.appendSlice(a, "python");
+                    s.code.clearRetainingCapacity();
+                    try s.code.appendSlice(a, src);
+                    ev.closed = s.close(.repl);
+                    s.state = .after;
+                    if (allowed) s.fire(false);
+                    return;
+                };
+                if (s.cfg.trace and allowed) try s.traceLine(a, ev, raw);
+            },
+        }
+    }
+
+    /// A reasoning prose line: a pending statement's cue fires it; the line's own statement opens a trace cell.
+    fn traceLine(s: *Scanner, a: Allocator, ev: *Events, raw: []const u8) Allocator.Error!void {
+        if (s.tracer == null) {
+            s.tracer = trace.Tracer.init(a);
+            s.tracer.?.repeat = s.cfg.trace_repeat;
+            s.tracer.?.whole = s.cfg.trace_whole;
+        }
+        const t = &s.tracer.?;
+        var fired = false;
+        if (s.trace_cell != null and trace.cue(raw)) fired = try s.traceArm(a);
+        const found = try t.line(raw) orelse return;
+        if (s.trace_cell != null and std.mem.eql(u8, found.display, s.trace_disp.items)) return;
+        if (ev.closed != null or s.trace_cells >= trace_cells_max or s.trace_owned >= trace_owned_max) return;
+        s.trace_src.clearRetainingCapacity();
+        try s.trace_src.appendSlice(a, found.run);
+        s.trace_disp.clearRetainingCapacity();
+        try s.trace_disp.appendSlice(a, found.display);
+        ev.closed = .{ .index = s.cells, .form = .repl, .lang = "python", .code = s.trace_src.items, .trace = .{ .display = s.trace_disp.items, .divmod = found.divmod } };
+        s.trace_cell = s.cells;
+        s.trace_at = s.tokens;
+        s.cells += 1;
+        s.trace_cells += 1;
+        if (found.same_line and !fired) _ = try s.traceArm(a);
+    }
+
+    /// Arms the pending trace cell's trigger at this line's end, unless another form's trigger is armed.
+    fn traceArm(s: *Scanner, a: Allocator) Allocator.Error!bool {
+        if (s.armed != null) return false;
+        s.armed = .{ .index = s.trace_cell.?, .trace = true };
+        s.trace_armed.clearRetainingCapacity();
+        try s.trace_armed.appendSlice(a, s.trace_disp.items);
+        return true;
+    }
+
+    /// The armed trace trigger survived its token: that statement is owned once, and no longer pending.
+    fn traceSpent(s: *Scanner, index: u32) Allocator.Error!void {
+        if (s.tracer) |*t| try t.fire(s.trace_armed.items);
+        if (s.trace_cell == index) s.trace_cell = null;
+        s.trace_owned += 1;
+    }
+
+    fn cue(s: *Scanner, b: u8) void {
+        if (s.tail_len == s.tail.len) {
+            std.mem.copyForwards(u8, s.tail[0 .. s.tail.len - 1], s.tail[1..]);
+            s.tail_len -= 1;
+        }
+        s.tail[s.tail_len] = b;
+        s.tail_len += 1;
+        for (float_cues) |c| if (std.mem.endsWith(u8, s.tail[0..s.tail_len], c)) {
+            s.float_at = s.tokens;
+        };
+        for (join_cues) |c| if (std.mem.endsWith(u8, s.tail[0..s.tail_len], c)) {
+            s.join_line = s.lines;
+        };
+    }
+
+    fn close(s: *Scanner, form: api.Form) Closed {
+        const c: Closed = .{ .index = s.cells, .form = form, .lang = s.lang.items, .code = s.code.items };
+        if (form != .inline_expr) {
+            s.pending = s.cells;
+            s.float_at = s.tokens;
+            s.code_cells += 1;
+        }
+        s.cells += 1;
+        return c;
+    }
+
+    fn fire(s: *Scanner, fenced: bool) void {
+        s.armed = .{ .index = s.pending, .fenced = fenced };
+        s.state = .prose;
+        s.terminal_ready = false;
+    }
+};
+
+/// A shell fence whose every command compiles or runs a program (no defines, pipes or redirects).
+fn runsPrevious(lang: []const u8, code: []const u8) bool {
+    const shells = [_][]const u8{ "bash", "sh", "shell", "zsh", "console" };
+    for (shells) |sh| {
+        if (std.mem.eql(u8, lang, sh)) break;
+    } else return false;
+    const tools = [_][]const u8{ "gcc ", "g++ ", "cc ", "clang ", "clang++ ", "tcc ", "./", "python ", "python3 ", "node " };
+    var any = false;
+    var lines = std.mem.splitScalar(u8, code, '\n');
+    while (lines.next()) |raw| {
+        var line = std.mem.trim(u8, raw, " \t\r");
+        if (std.mem.startsWith(u8, line, "$ ")) line = line[2..];
+        if (line.len == 0 or line[0] == '#') continue;
+        if (std.mem.indexOfAny(u8, line, "|<>;`") != null or std.mem.indexOf(u8, line, "-D") != null) return false;
+        var parts = std.mem.splitSequence(u8, line, "&&");
+        while (parts.next()) |part| {
+            const cmd = std.mem.trim(u8, part, " \t");
+            for (tools) |t| {
+                if (std.mem.startsWith(u8, cmd, t)) break;
+            } else return false;
+            any = true;
+        }
+    }
+    return any;
+}
+
+/// ">>> code" (one line, not opening a block): the code, else null.
+fn replLine(line: []const u8) ?[]const u8 {
+    const t = header.indentOk(line) orelse return null;
+    if (!std.mem.startsWith(u8, t, ">>> ")) return null;
+    const src = std.mem.trim(u8, t[4..], " \t");
+    if (src.len == 0 or src[src.len - 1] == ':') return null;
+    return src;
+}
+
+fn run(a: Allocator, s: *Scanner, tokens: []const []const u8, out: *std.ArrayList(Events)) !void {
+    for (tokens) |t| try out.append(a, try s.feed(a, t, true));
+}
