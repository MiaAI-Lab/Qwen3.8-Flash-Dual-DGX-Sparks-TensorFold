+test "runner: inline provenance never tags an empty multiline failed or refused result" {
+    for ([_]rapi.Result{
+        .{ .status = .ok, .out = "\n" },
+        .{ .status = .ok, .out = " \n" },
+        .{ .status = .ok, .out = "3901\n\n" },
+        .{ .status = .ok, .out = "3\n4\n" },
+        .{ .status = .fault, .out = "3901" },
+        .{ .status = .budget, .out = "3901" },
+        .{ .status = .abstain, .out = "3901" },
