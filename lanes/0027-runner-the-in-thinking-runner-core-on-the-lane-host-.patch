index 000000000..fdea41107
--- /dev/null
+++ b/zig/src/core/runner_settle_test.zig
@@ -0,0 +1,194 @@
+//! TF_DSV41_RUNNER_SETTLE_US on reply sessions: the same owned tokens, in one tick a hold instead of one a stage.
+const std = @import("std");
+const rapi = @import("runner_api.zig");
+const runner = @import("runner.zig");
+
+const gpa = std.testing.allocator;
+
+fn bytes(_: ?*anyopaque, token: u32) []const u8 {
+    const all = comptime blk: {
+        var t: [128]u8 = undefined;
+        for (&t, 0..) |*c, i| c.* = i;
+        break :blk t;
+    };
+    return if (token < 128) all[token..][0..1] else "";
+}
+
+fn encode(_: ?*anyopaque, a: std.mem.Allocator, text: []const u8) std.mem.Allocator.Error![]u32 {
+    const out = try a.alloc(u32, text.len);
+    for (text, out) |c, *t| t.* = c;
+    return out;
+}
+
+/// Every cell's code is its graph program.
+fn translate(_: ?*anyopaque, a: std.mem.Allocator, cell: rapi.Cell) std.mem.Allocator.Error!rapi.Translation {
+    return .{ .program = .{ .kind = .graph, .bytes = try a.dupe(u8, std.mem.trim(u8, cell.code, " \n")) } };
+}
+
+/// Answers by program after `delay` polls, or once `gate` opens; a run here ends when its steps fit `quick`.
+const Back = struct {
+    delay: u32 = 0,
+    gate: bool = true,
+    jobs: std.ArrayList(struct { prog: []u8, polls: u32 }) = .empty,
+    started: u32 = 0,
+    here: u32 = 0,
+
+    const answers = [_]struct { []const u8, []const u8, u64 }{
+        .{ "47*83", "3901\n", 900 },
+        .{ "2**100", "1267650600228229401496703205376\n", 30_000 },
+        .{ "7*6", "42\n", 500 },
+        .{ "3**200", "265613988875874769338781322035779626829233452653394495974574961739092490901302182994384699044001\n", 1 << 40 },
+    };
+
+    fn answer(prog: []const u8) rapi.Result {
+        for (answers) |x| if (std.mem.eql(u8, x[0], prog)) return .{ .status = .ok, .out = x[1], .steps = x[2] };
+        return .{ .status = .fault };
+    }
+    fn backend(b: *Back) rapi.Backend {
+        return .{ .ctx = b, .vtable = &.{ .start = start, .poll = poll, .cancel = cancel, .release = release, .now = now } };
+    }
+    fn start(ctx: *anyopaque, _: u64, p: rapi.Program, _: u64) error{ OutOfMemory, Busy }!rapi.JobId {
+        const b: *Back = @ptrCast(@alignCast(ctx));
+        try b.jobs.append(gpa, .{ .prog = try gpa.dupe(u8, p.bytes), .polls = 0 });
+        b.started += 1;
+        return b.jobs.items.len - 1;
+    }
+    fn poll(ctx: *anyopaque, job: rapi.JobId) rapi.Poll {
+        const b: *Back = @ptrCast(@alignCast(ctx));
+        const j = &b.jobs.items[job];
+        j.polls += 1;
+        if (j.polls <= b.delay or !b.gate) return .running;
+        return .{ .done = answer(j.prog) };
+    }
+    fn now(ctx: *anyopaque, p: rapi.Program, budget: u64, quick: u64) ?rapi.Result {
+        const b: *Back = @ptrCast(@alignCast(ctx));
+        const r = answer(p.bytes);
+        if (r.steps > @min(budget, quick)) return null;
+        b.here += 1;
+        return r;
+    }
+    fn cancel(_: *anyopaque, _: rapi.JobId) void {}
+    fn release(_: *anyopaque, _: u64) void {}
+    fn deinit(b: *Back) void {
+        for (b.jobs.items) |j| gpa.free(j.prog);
+        b.jobs.deinit(gpa);
+    }
+};
+
+const reply = "So 47*83 = 3901\nand 2**100 = 1267650600228229401496703205376\n>>> 7*6\n42\nLast 3**200 = 9\n";
+
+/// The owned text of each hold, and the reply's ticks, starts and runs here.
+const Run = struct { owned: []u8, ticks: [4]u32, started: u32, here: u32 };
+
+/// Feeds `reply`; at a hold, waits for the cell's translation (the trigger round's rest), then ticks to its tokens.
+fn run(settle_us: u32, back: *Back, open_gate_at: ?u32) !Run {
+    var r: runner.Runner = .{ .gpa = gpa, .cfg = .{ .settle_us = settle_us }, .frontend = .{ .translate = translate }, .backend = back.backend(), .text = .{ .bytes = bytes, .encode = encode } };
+    r.cfg.scan.inline_math = true;
+    const s = (try r.session(.{})).?;
+    defer s.destroy();
+    const hook = s.hook();
+    var owned: std.ArrayList(u8) = .empty;
+    errdefer owned.deinit(gpa);
+    var ticks: [4]u32 = @splat(0);
+    var holds: usize = 0;
+    for (reply) |ch| {
+        if (!hook.token(hook.ptr, ch, false, true, false)) continue;
+        const cell = s.cells.items[s.waiting.?.index];
+        // settling translates an inline value at its close, on this thread
+        if (settle_us > 0 and cell.form == .inline_expr) try std.testing.expect(cell.thread == null and cell.translated.load(.acquire));
+        while (!cell.translated.load(.acquire)) std.Thread.yield() catch {};
+        var n: u32 = 0;
+        const got = while (true) {
+            n += 1;
+            if (open_gate_at) |at| if (n == at) {
+                back.gate = true;
+            };
+            if (try s.tick()) |x| break x;
+        };
+        defer gpa.free(got);
+        try std.testing.expectEqual(n, s.held_ticks);
+        for (got) |t| try owned.appendSlice(gpa, bytes(null, t));
+        try owned.append(gpa, '|');
+        ticks[holds] = n;
+        holds += 1;
+    }
+    try std.testing.expectEqual(@as(usize, 4), holds);
+    return .{ .owned = try owned.toOwnedSlice(gpa), .ticks = ticks, .started = back.started, .here = back.here };
+}
+
+test "runner settle: the same owned tokens; off ticks a stage a round (the old counts), on one tick a hold" {
+    const want = " 3901| 1267650600228229401496703205376|42\n|" ++ " " ++ Back.answers[3][1][0 .. Back.answers[3][1].len - 1] ++ "|";
+    var b0: Back = .{};
+    defer b0.deinit();
+    const off = try run(0, &b0, null);
+    defer gpa.free(off.owned);
+    var b1: Back = .{};
+    defer b1.deinit();
+    const on = try run(3000, &b1, null);
+    defer gpa.free(on.owned);
+    try std.testing.expectEqualStrings(want, off.owned);
+    try std.testing.expectEqualStrings(off.owned, on.owned);
+    // off (the negative control): a tick to start each run, a tick to take it; every run is a job
+    try std.testing.expectEqual([4]u32{ 2, 2, 2, 2 }, off.ticks);
+    try std.testing.expectEqual(@as(u32, 4), off.started);
+    try std.testing.expectEqual(@as(u32, 0), off.here);
+    // on: runs within 3000 us of steps end here; 3**200 (past them) is a job, waited on in the same tick
+    try std.testing.expectEqual([4]u32{ 1, 1, 1, 1 }, on.ticks);
+    try std.testing.expectEqual(@as(u32, 1), on.started);
+    try std.testing.expectEqual(@as(u32, 3), on.here);
+}
+
+test "runner settle: a job past the wait leaves the hold to a later tick, with the same tokens" {
+    var b0: Back = .{ .delay = 5 };
+    defer b0.deinit();
+    const off = try run(0, &b0, null);
+    defer gpa.free(off.owned);
+    // 200 us of steps (4000) run 47*83 and 7*6 here; 2**100's job waits 200 us a tick until its gate opens at tick 3
+    var b1: Back = .{ .gate = false };
+    defer b1.deinit();
+    const on = try run(200, &b1, 3);
+    defer gpa.free(on.owned);
+    try std.testing.expectEqualStrings(off.owned, on.owned);
+    try std.testing.expectEqual([4]u32{ 7, 7, 7, 7 }, off.ticks);
+    try std.testing.expectEqual([4]u32{ 1, 3, 1, 1 }, on.ticks);
+    try std.testing.expectEqual(@as(u32, 2), on.started);
+    try std.testing.expectEqual(@as(u32, 2), on.here);
+}
+
+test "runner settle: a backend without a run here still settles in one tick when its job ends in the wait" {
+    var b: Back = .{ .delay = 3 };
+    defer b.deinit();
+    var plain = b.backend();
+    const vt: rapi.Backend.VTable = .{ .start = plain.vtable.start, .poll = plain.vtable.poll, .cancel = plain.vtable.cancel, .release = plain.vtable.release };
+    plain.vtable = &vt;
+    try std.testing.expectEqual(null, plain.now(.{ .kind = .graph, .bytes = "7*6" }, 10, 10));
+    var r: runner.Runner = .{ .gpa = gpa, .cfg = .{ .settle_us = 3000 }, .frontend = .{ .translate = translate }, .backend = plain, .text = .{ .bytes = bytes, .encode = encode } };
+    r.cfg.scan.inline_math = true;
+    const s = (try r.session(.{})).?;
+    defer s.destroy();
+    const hook = s.hook();
+    var held = false;
+    for ("So 7*6 =") |ch| held = hook.token(hook.ptr, ch, false, true, false);
+    try std.testing.expect(held);
+    const got = (try s.tick()).?;
+    defer gpa.free(got);
+    try std.testing.expectEqualSlices(u32, &.{ ' ', '4', '2' }, got);
+    try std.testing.expectEqual(@as(u32, 1), s.held_ticks);
+    try std.testing.expectEqual(@as(u32, 1), b.started);
+}
+
+test "runner settle: TF_DSV41_RUNNER_SETTLE_US parses, off (0) unless set" {
+    const K = struct {
+        var v: ?[]const u8 = null;
+        fn get(name: []const u8) ?[]const u8 {
+            if (std.mem.eql(u8, name, "TF_R")) return "1";
+            if (std.mem.eql(u8, name, "TF_R_CIRCUIT")) return "/c.bin";
+            return if (std.mem.eql(u8, name, "TF_R_SETTLE_US")) v else null;
+        }
+    };
+    try std.testing.expectEqual(@as(u32, 0), (try runner.Config.parse(&K.get, "TF_R")).?.settle_us);
+    K.v = "3000";
+    try std.testing.expectEqual(@as(u32, 3000), (try runner.Config.parse(&K.get, "TF_R")).?.settle_us);
+    K.v = "100001";
+    try std.testing.expectError(error.BadKnob, runner.Config.parse(&K.get, "TF_R"));
+}
diff --git a/zig/src/core/runner_sync_test.zig b/zig/src/core/runner_sync_test.zig
new file mode 100644
index 000000000..12f44206b
--- /dev/null
+++ b/zig/src/core/runner_sync_test.zig
@@ -0,0 +1,178 @@
+//! TF_DSV41_RUNNER_SYNC_GRAPH: a graph result settles at its trigger (0 ticks) with a hold's tokens; the rest hold.
+const std = @import("std");
+const rapi = @import("runner_api.zig");
+const runner = @import("runner.zig");
+
+const gpa = std.testing.allocator;
+
+fn bytes(_: ?*anyopaque, token: u32) []const u8 {
+    const all = comptime blk: {
+        var t: [128]u8 = undefined;
+        for (&t, 0..) |*c, i| c.* = i;
+        break :blk t;
+    };
+    return if (token < 128) all[token..][0..1] else "";
+}
+
+fn encode(_: ?*anyopaque, a: std.mem.Allocator, text: []const u8) std.mem.Allocator.Error![]u32 {
+    const out = try a.alloc(u32, text.len);
+    for (text, out) |c, *t| t.* = c;
+    return out;
+}
+
+/// Every cell's code is its graph program, but `7*6` (a calc program) and `5*5` (abstains).
+fn translate(_: ?*anyopaque, a: std.mem.Allocator, cell: rapi.Cell) std.mem.Allocator.Error!rapi.Translation {
+    const code = std.mem.trim(u8, cell.code, " \n");
+    if (std.mem.eql(u8, code, "5*5")) return .{ .abstain = .name };
+    return .{ .program = .{ .kind = if (std.mem.eql(u8, code, "7*6")) .calc else .graph, .bytes = try a.dupe(u8, code) } };
+}
+
+/// Answers by program: as a job after one poll, or here when its steps fit `quick`.
+const Back = struct {
+    jobs: std.ArrayList([]u8) = .empty,
+    started: u32 = 0,
+    here: u32 = 0,
+
+    const answers = [_]struct { []const u8, []const u8, u64 }{
+        .{ "47*83", "3901\n", 900 },
+        .{ "2**100", "1267650600228229401496703205376\n", 30_000 },
+        .{ "7*6", "42\n", 500 },
+        .{ "3**200", "265613988875874769338781322035779626829233452653394495974574961739092490901302182994384699044001\n", 1 << 40 },
+    };
+
+    fn answer(prog: []const u8) rapi.Result {
+        for (answers) |x| if (std.mem.eql(u8, x[0], prog)) return .{ .status = .ok, .out = x[1], .steps = x[2] };
+        return .{ .status = .fault };
+    }
+    fn backend(b: *Back) rapi.Backend {
+        return .{ .ctx = b, .vtable = &.{ .start = start, .poll = poll, .cancel = cancel, .release = release, .now = now } };
+    }
+    fn start(ctx: *anyopaque, _: u64, p: rapi.Program, _: u64) error{ OutOfMemory, Busy }!rapi.JobId {
+        const b: *Back = @ptrCast(@alignCast(ctx));
+        try b.jobs.append(gpa, try gpa.dupe(u8, p.bytes));
+        b.started += 1;
+        return b.jobs.items.len - 1;
+    }
+    fn poll(ctx: *anyopaque, job: rapi.JobId) rapi.Poll {
+        const b: *Back = @ptrCast(@alignCast(ctx));
+        return .{ .done = answer(b.jobs.items[job]) };
+    }
+    fn now(ctx: *anyopaque, p: rapi.Program, budget: u64, quick: u64) ?rapi.Result {
+        const b: *Back = @ptrCast(@alignCast(ctx));
+        if (p.kind != .graph) return null;
+        const r = answer(p.bytes);
+        if (r.steps > @min(budget, quick)) return null;
+        b.here += 1;
+        return r;
+    }
+    fn cancel(_: *anyopaque, _: rapi.JobId) void {}
+    fn release(_: *anyopaque, _: u64) void {}
+    fn deinit(b: *Back) void {
+        for (b.jobs.items) |j| gpa.free(j);
+        b.jobs.deinit(gpa);
+    }
+};
+
+const reply = "So 47*83 = 3901\nand 2**100 = 1267650600228229401496703205376\nthen 7*6 = 42\nLast 3**200 = 9\nand 5*5 = 25\n";
+
+/// Each fire's forced text ('|' after each; "-" for an abstain), and each fire's ticks (0: settled at its trigger).
+const Run = struct { owned: []u8, ticks: [5]u32, started: u32, here: u32 };
+
+/// Feeds `reply` one token at a time as a stream would: a settled fire's tokens are taken at once, a hold ticks.
+fn run(sync: bool, back: *Back) !Run {
+    var r: runner.Runner = .{ .gpa = gpa, .cfg = .{ .backend = .graph, .sync_graph = sync }, .frontend = .{ .translate = translate }, .backend = back.backend(), .text = .{ .bytes = bytes, .encode = encode } };
+    if (sync) r.quick = .{ .translate = translate };
+    r.cfg.scan.inline_math = true;
+    const s = (try r.session(.{})).?;
+    defer s.destroy();
+    const hook = s.hook();
+    try std.testing.expectEqual(sync, hook.settled != null);
+    var owned: std.ArrayList(u8) = .empty;
+    errdefer owned.deinit(gpa);
+    var ticks: [5]u32 = @splat(0);
+    var fires: usize = 0;
+    var abstains_at: usize = 0; // a hold's abstain: the cell's own text
+    for (reply) |ch| {
+        const before = s.abstained_n;
+        if (!hook.token(hook.ptr, ch, false, true, false)) {
+            // settled as an abstain at the trigger: no hold, the model's own text stays
+            if (s.abstained_n > before) {
+                try owned.appendSlice(gpa, "-|");
+                fires += 1;
+            }
+            continue;
+        }
+        if (hook.settled) |f| if (f(hook.ptr)) |ids| {
+            try std.testing.expectEqual(null, s.waiting);
+            for (ids) |t| try owned.appendSlice(gpa, bytes(null, t));
+            try owned.append(gpa, '|');
+            fires += 1;
+            continue;
+        };
+        const cell = s.cells.items[s.waiting.?.index];
+        while (!cell.translated.load(.acquire)) std.Thread.yield() catch {};
+        var n: u32 = 0;
+        const got = while (true) {
+            n += 1;
+            if (try s.tick()) |x| break x;
+        };
+        defer gpa.free(got);
+        try std.testing.expectEqual(n, s.held_ticks);
+        if (got.len == 0) {
+            try owned.appendSlice(gpa, "-|");
+            abstains_at += 1;
+        } else {
+            for (got) |t| try owned.appendSlice(gpa, bytes(null, t));
+            try owned.append(gpa, '|');
+        }
+        ticks[fires] = n;
+        fires += 1;
+    }
+    try std.testing.expectEqual(@as(usize, 5), fires);
+    return .{ .owned = try owned.toOwnedSlice(gpa), .ticks = ticks, .started = back.started, .here = back.here };
+}
+
+test "runner sync graph: a graph result settles at its trigger in 0 ticks with the hold's tokens; the rest hold" {
+    var b0: Back = .{};
+    defer b0.deinit();
+    const off = try run(false, &b0);
+    defer gpa.free(off.owned);
+    var b1: Back = .{};
+    defer b1.deinit();
+    const on = try run(true, &b1);
+    defer gpa.free(on.owned);
+    const big = Back.answers[3][1];
+    const want = " 3901| 1267650600228229401496703205376| 42| " ++ big[0 .. big.len - 1] ++ "|-|";
+    try std.testing.expectEqualStrings(want, off.owned);
+    try std.testing.expectEqualStrings(off.owned, on.owned);
+    // off (the negative control): every fire holds, a tick to start its run and one to take it; all are jobs
+    try std.testing.expectEqual([5]u32{ 2, 2, 2, 2, 1 }, off.ticks);
+    try std.testing.expectEqual(@as(u32, 4), off.started);
+    try std.testing.expectEqual(@as(u32, 0), off.here);
+    // on: 47*83 and 2**100 settle at `=` (run here); calc 7*6 and 3**200 (past the cap) hold; 5*5 abstains at `=`
+    try std.testing.expectEqual([5]u32{ 0, 0, 2, 2, 0 }, on.ticks);
+    try std.testing.expectEqual(@as(u32, 2), on.here);
+    try std.testing.expectEqual(@as(u32, 2), on.started);
+}
+
+test "runner sync graph: TF_DSV41_RUNNER_SYNC_GRAPH parses, off unless set, and only with the graph backend" {
+    const K = struct {
+        var v: ?[]const u8 = null;
+        var backend: ?[]const u8 = "graph";
+        fn get(name: []const u8) ?[]const u8 {
+            if (std.mem.eql(u8, name, "TF_R")) return "1";
+            if (std.mem.eql(u8, name, "TF_R_CIRCUIT")) return "/c.bin";
+            if (std.mem.eql(u8, name, "TF_R_GRAPH_BANK")) return "/b.json";
+            if (std.mem.eql(u8, name, "TF_R_BACKEND")) return backend;
+            return if (std.mem.eql(u8, name, "TF_R_SYNC_GRAPH")) v else null;
+        }
+    };
+    try std.testing.expect(!(try runner.Config.parse(&K.get, "TF_R")).?.sync_graph);
+    K.v = "1";
+    try std.testing.expect((try runner.Config.parse(&K.get, "TF_R")).?.sync_graph);
+    K.v = "2";
+    try std.testing.expectError(error.BadKnob, runner.Config.parse(&K.get, "TF_R"));
+    K.v = "1";
+    K.backend = "circuit";
+    try std.testing.expectError(error.BadKnob, runner.Config.parse(&K.get, "TF_R"));
+}
diff --git a/zig/src/core/runner_teardown_test.zig b/zig/src/core/runner_teardown_test.zig
new file mode 100644
index 000000000..d60cf8bb4
--- /dev/null
+++ b/zig/src/core/runner_teardown_test.zig
@@ -0,0 +1,79 @@
+//! Session.destroy joins every translation before it frees a cell: a later cell's prior borrows earlier code.
+const std = @import("std");
+const rapi = @import("runner_api.zig");
+const runner = @import("runner.zig");
+
+const gpa = std.testing.allocator;
+
+fn bytes(_: ?*anyopaque, token: u32) []const u8 {
+    const all = comptime blk: {
+        var t: [128]u8 = undefined;
+        for (&t, 0..) |*c, i| c.* = i;
+        break :blk t;
+    };
+    return if (token < 128) all[token..][0..1] else "";
+}
+
+fn encode(_: ?*anyopaque, a: std.mem.Allocator, text: []const u8) std.mem.Allocator.Error![]u32 {
+    const out = try a.alloc(u32, text.len);
+    for (text, out) |c, *t| t.* = c;
+    return out;
+}
+
+const first = "x = 12345678901234567890\nprint(x)\n";
+
+/// The later cell's translation is held until destroy has begun, then watches its borrowed prior for a while.
+const Gate = struct {
+    entered: std.atomic.Value(bool) = .init(false),
+    destroying: std.atomic.Value(bool) = .init(false),
+    changed: std.atomic.Value(bool) = .init(false),
+
+    fn translate(ctx: ?*anyopaque, _: std.mem.Allocator, cell: rapi.Cell) std.mem.Allocator.Error!rapi.Translation {
+        const g: *Gate = @ptrCast(@alignCast(ctx.?));
+        if (cell.prior.len == 0) return .{ .abstain = .unsupported };
+        g.entered.store(true, .release);
+        while (!g.destroying.load(.acquire)) std.Thread.yield() catch {};
+        // freed history reads back as the testing allocator's poison: the same bytes for 200 ms mean nothing freed them
+        var i: u32 = 0;
+        while (i < 200) : (i += 1) {
+            if (!std.mem.eql(u8, cell.prior[0], first)) {
+                g.changed.store(true, .release);
+                break;
+            }
+            std.Io.sleep(std.testing.io, .fromMilliseconds(1), .awake) catch {};
+        }
+        return .{ .abstain = .unsupported };
+    }
+};
+
+const Back = struct {
+    fn backend() rapi.Backend {
+        return .{ .ctx = undefined, .vtable = &.{ .start = start, .poll = poll, .cancel = cancel, .release = release, .now = now } };
+    }
+    fn start(_: *anyopaque, _: u64, _: rapi.Program, _: u64) error{ OutOfMemory, Busy }!rapi.JobId {
+        return error.Busy;
+    }
+    fn poll(_: *anyopaque, _: rapi.JobId) rapi.Poll {
+        return .{ .done = .{ .status = .fault } };
+    }
+    fn now(_: *anyopaque, _: rapi.Program, _: u64, _: u64) ?rapi.Result {
+        return null;
+    }
+    fn cancel(_: *anyopaque, _: rapi.JobId) void {}
+    fn release(_: *anyopaque, _: u64) void {}
+};
+
+test "runner: destroy joins a later cell's translation before it frees the earlier cell that translation borrows" {
+    var gate: Gate = .{};
+    var r: runner.Runner = .{ .gpa = gpa, .cfg = .{ .circuit = "test" }, .frontend = .{ .ctx = &gate, .translate = Gate.translate }, .backend = Back.backend(), .text = .{ .bytes = bytes, .encode = encode } };
+    const s = (try r.session(.{})).?;
+    const hook = s.hook();
+    // the second fence closes on the reply's last token: can_hold false (length cap), then the stream ends
+    const reply = "```python\n" ++ first ++ "```\nThen:\n```python\nprint(x + 1)\n```\n";
+    for (reply) |ch| _ = hook.token(hook.ptr, ch, false, false, false);
+    try std.testing.expectEqual(2, s.cells.items.len);
+    while (!gate.entered.load(.acquire)) std.Thread.yield() catch {};
+    gate.destroying.store(true, .release);
+    s.destroy();
+    try std.testing.expect(!gate.changed.load(.acquire));
+}
diff --git a/zig/src/core/runner_test.zig b/zig/src/core/runner_test.zig
new file mode 100644
index 000000000..62a4bf466
--- /dev/null
+++ b/zig/src/core/runner_test.zig
@@ -0,0 +1,583 @@
+//! The in-model runner end to end on a lane host: a scripted model writes a cell and its result header; runs own it.
+const std = @import("std");
+const lanes = @import("lanes");
+const api = @import("engine_api.zig");
+const rapi = @import("runner_api.zig");
+const runner = @import("runner.zig");
+const LaneHost = @import("lane_host.zig").LaneHost;
+const Reason = api.Reason;
+
+const gpa = std.testing.allocator;
+const EOS: u32 = 96;
+const prompt = [_]u32{ 3, 1, 4, 1, 5, 9, 2, 6, 5, 3 };
+pub const product = "121932631137021795226185032733622923332237463801111263526900";
+pub const mul_cell = "Let me check.\n```python\nprint(123456789012345678901234567890 * 987654321098765432109876543210)\n```\nResult:\n";
+
+/// Character tokens: printable ASCII 32..126 are 0..94, newline 95, EOS 96 (the fake's vocab is 97).
+pub fn id(c: u8) u32 {
+    return if (c == '\n') 95 else c - 32;
+}
+
+fn ids(a: std.mem.Allocator, text: []const u8) ![]u32 {
+    const out = try a.alloc(u32, text.len);
+    for (text, out) |c, *t| t.* = id(c);
+    return out;
+}
+
+const table = blk: {
+    var t: [97][]const u8 = undefined;
+    for (0..95) |i| t[i] = &[_]u8{@intCast(i + 32)};
+    t[95] = "\n";
+    t[96] = "";
+    break :blk t;
+};
+
+fn tokenBytes(_: ?*anyopaque, token: u32) []const u8 {
+    return if (token < table.len) table[token] else "";
+}
+
+fn encode(_: ?*anyopaque, a: std.mem.Allocator, text: []const u8) std.mem.Allocator.Error![]u32 {
+    return ids(a, text);
+}
+
+fn decode(a: std.mem.Allocator, tokens: []const u32) ![]u8 {
+    var out: std.ArrayList(u8) = .empty;
+    for (tokens) |t| try out.appendSlice(a, tokenBytes(null, t));
+    return out.toOwnedSlice(a);
+}
+
+/// A model that writes `lead`, then its own guess on one line, then `tail` and EOS, whatever the guess line became.
+pub const Model = struct {
+    lead: []const u8,
+    guess: []const u8 = "42",
+    tail: []const u8 = "Done.",
+    terminal: bool = false,
+
+    fn next(ctx: *anyopaque, history: []const u32) u32 {
+        const m: *Model = @ptrCast(@alignCast(ctx));
+        var buf: [1024]u8 = undefined;
+        const reply = history[prompt.len..];
+        var n: usize = 0;
+        for (reply) |t| for (tokenBytes(null, t)) |c| {
+            buf[n] = c;
+            n += 1;
+        };
+        const r = buf[0..n];
+        if (r.len < m.lead.len) return id(m.lead[r.len]);
+        if (m.terminal) return EOS;
+        var rest = r[m.lead.len..];
+        const nl = std.mem.indexOfScalar(u8, rest, '\n') orelse return if (rest.len < m.guess.len) id(m.guess[rest.len]) else id('\n');
+        rest = rest[nl + 1 ..];
+        if (std.mem.startsWith(u8, rest, "```\n")) rest = rest[4..];
+        return if (rest.len < m.tail.len) id(m.tail[rest.len]) else EOS;
+    }
+};
+
+/// `print(X)` and REPL `X` become calc X; code naming `undefined_` abstains.
+pub fn translate(_: ?*anyopaque, a: std.mem.Allocator, cell: rapi.Cell) std.mem.Allocator.Error!rapi.Translation {
+    if (std.mem.indexOf(u8, cell.code, "undefined_") != null) return .{ .abstain = .name };
+    // like T5's frontend: a cell after earlier code cells abstains
+    if (std.mem.eql(u8, cell.code, "2**99") and cell.prior.len != 0) return .{ .abstain = .unsupported };
+    var code = std.mem.trim(u8, cell.code, " \n");
+    if (std.mem.startsWith(u8, code, "print(") and std.mem.endsWith(u8, code, ")")) code = code[6 .. code.len - 1];
+    return .{ .program = .{ .kind = .calc, .bytes = try a.dupe(u8, code) } };
+}
+
+/// Answers from a table after `delay` polls, or only once `gate` opens.
+pub const Back = struct {
+    delay: u32 = 0,
+    gate: std.atomic.Value(bool) = .init(true),
+    jobs: std.ArrayList(struct { prog: []u8, polls: u32 }) = .empty,
+    started: u32 = 0,
+    result: ?rapi.Result = null,
+
+    const answers = [_][2][]const u8{
+        .{ "123456789012345678901234567890 * 987654321098765432109876543210", product ++ "\n" },
+        .{ "sum(i*i for i in range(10))", "285\n" },
+        .{ "2**100", "1267650600228229401496703205376\n" },
+        .{ "47 * 83", "3901" },
+        .{ "1.5+2.25", "3.75" },
+        .{ "2**99", "633825300114114700748351602688\n" },
+    };
+
+    pub fn backend(b: *Back) rapi.Backend {
+        return .{ .ctx = b, .vtable = &.{ .start = start, .poll = poll, .cancel = cancel, .release = release } };
+    }
+    fn start(ctx: *anyopaque, _: u64, p: rapi.Program, _: u64) error{ OutOfMemory, Busy }!rapi.JobId {
+        const b: *Back = @ptrCast(@alignCast(ctx));
+        try b.jobs.append(gpa, .{ .prog = try gpa.dupe(u8, p.bytes), .polls = 0 });
+        b.started += 1;
+        return b.jobs.items.len - 1;
+    }
+    fn poll(ctx: *anyopaque, job: rapi.JobId) rapi.Poll {
+        const b: *Back = @ptrCast(@alignCast(ctx));
+        const j = &b.jobs.items[job];
+        j.polls += 1;
+        if (j.polls <= b.delay or !b.gate.load(.acquire)) return .running;
+        if (b.result) |result| return .{ .done = result };
+        for (answers) |x| if (std.mem.eql(u8, x[0], j.prog)) return .{ .done = .{ .status = .ok, .out = x[1], .steps = 100 } };
+        return .{ .done = .{ .status = .fault, .out = "" } };
+    }
+    fn cancel(_: *anyopaque, _: rapi.JobId) void {}
+    fn release(_: *anyopaque, _: u64) void {}
+    pub fn deinit(b: *Back) void {
+        for (b.jobs.items) |j| gpa.free(j.prog);
+        b.jobs.deinit(gpa);
+    }
+};
+
+const Box = struct {
+    mutex: std.Io.Mutex = .init,
+    tokens: std.ArrayList(u32) = .empty,
+    done: ?Reason = null,
+    cells: [65536]u8 = undefined, // the finished event's runner receipt
+    cells_len: usize = 0,
+    keep: bool = false, // keep `live` (Opts.live): the caller frees it
+    live: [32][]u8 = @splat(&.{}), // each record's newest Event.cells note (gpa)
+    live_n: usize = 0,
+    fn event(ctx: *anyopaque, _: api.Id, e: *const api.Event) void {
+        const b: *@This() = @ptrCast(@alignCast(ctx));
+        b.mutex.lockUncancelable(std.testing.io);
+        defer b.mutex.unlock(std.testing.io);
+        switch (e.*) {
+            .tokens => |t| b.tokens.appendSlice(gpa, t) catch {},
+            .cells => |notes| for (notes) |n| if (b.keep and n.index < b.live.len) {
+                gpa.free(b.live[n.index]);
+                b.live[n.index] = gpa.dupe(u8, n.json) catch &.{};
+                b.live_n = @max(b.live_n, n.index + 1);
+            },
+            .finished => |f| {
+                @memcpy(b.cells[0..f.runner.len], f.runner);
+                b.cells_len = f.runner.len;
+                b.done = f.reason;
+            },
+            else => {},
+        }
+    }
+    fn finished(b: *@This()) bool {
+        b.mutex.lockUncancelable(std.testing.io);
+        defer b.mutex.unlock(std.testing.io);
+        return b.done != null;
+    }
+    fn wait(b: *@This(), seconds: u32) !Reason {
+        for (0..@as(usize, seconds) * 1000) |_| {
+            if (b.finished()) return b.done.?;
+            std.Io.sleep(std.testing.io, .fromMilliseconds(1), .awake) catch {};
+        }
+        return error.Timeout;
+    }
+};
+
+/// `frontend`/`backend`: real ones in place of the fakes (the proof test).
+pub const Opts = struct { runner: bool = true, run_cells: bool = true, delay: u32 = 0, planner: bool = false, streams: usize = 1, max_tokens: u32 = 400, frontend: ?rapi.Frontend = null, backend: ?rapi.Backend = null, wait_s: u32 = 20, exact: bool = false, inline_mark: bool = false, result_tokens: u32 = 512, inline_math: bool = false, trace: bool = false, trace_ask: runner.TraceAsk = .{}, placer: ?*runner.place.Placer = null, summaries: ?[][]u8 = null, cells: bool = true, live: ?[][]u8 = null, abstains: bool = false, commit: bool = false, commit_ask: @import("runner_commit.zig").Ask = .{}, think_end: ?u32 = null };
+
+/// Runs `models` (one request each, concurrently) on one host; the reply texts.
+pub fn replies(models: []Model, o: Opts, back: *Back) ![][]u8 {
+    var cfg = try lanes.Config.init(gpa, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, 8, 7);
+    defer cfg.deinit(gpa);
+    var target: lanes.fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    var router: Router = .{ .models = models };
+    target.script = .{ .ctx = &router, .next = Router.next };
+    var clock: lanes.fake.FixedClock = .{};
+    var core = lanes.Engine.init(gpa, &cfg, target.backend(), clock.clock());
+    defer core.deinit();
+    var host = LaneHost.init(gpa, std.testing.io, &core, .{ .lanes = 4 });
+    back.delay = o.delay;
+    var run: runner.Runner = .{ .gpa = gpa, .cfg = .{ .circuit = "test", .exact = o.exact, .inline_mark = o.inline_mark, .max_tokens = o.result_tokens, .cells = o.cells, .abstains = o.abstains, .commit = o.commit, .scan = .{ .inline_math = o.inline_math, .trace = o.trace } }, .frontend = o.frontend orelse .{ .translate = translate }, .backend = o.backend orelse back.backend(), .text = .{ .bytes = tokenBytes, .encode = encode }, .placer = o.placer };
+    if (o.runner) host.runner = &run;
+    const boxes = try gpa.alloc(Box, models.len);
+    defer gpa.free(boxes);
+    const prompts = try gpa.alloc([prompt.len + 1]u32, models.len);
+    defer gpa.free(prompts);
+    const requests = try gpa.alloc(api.Request, models.len);
+    defer gpa.free(requests);
+    const e = host.engine();
+    try host.start();
+    defer host.stop();
+    for (models, 0..) |_, i| {
+        boxes[i] = .{ .keep = o.live != null };
+        prompts[i] = prompt ++ [_]u32{@intCast(i)}; // the router tells the streams apart by their last prompt token
+        requests[i] = .{ .prompt = &prompts[i], .max_tokens = o.max_tokens, .eos = &.{EOS}, .run_cells = o.run_cells, .run_trace = o.trace_ask, .think_end = o.think_end, .run_commit = o.commit_ask };
+        try e.submit(@intCast(i + 1), &requests[i], .{ .ctx = &boxes[i], .event = Box.event });
+    }
+    const out = try gpa.alloc([]u8, models.len);
+    for (boxes, out) |*b, *text| {
+        try std.testing.expectEqual(Reason.stop, try b.wait(o.wait_s));
+        text.* = try decode(gpa, b.tokens.items);
+        b.tokens.deinit(gpa);
+    }
+    for (boxes, 0..) |*b, i| {
+        if (o.summaries) |s| s[i] = try gpa.dupe(u8, b.cells[0..b.cells_len]);
+        if (o.live) |s| s[i] = try std.mem.join(gpa, ",", b.live[0..b.live_n]);
+        for (b.live[0..b.live_n]) |n| gpa.free(n);
+    }
+    return out;
+}
+
+/// Each stream's script by the extra prompt token.
+const Router = struct {
+    models: []Model,
+    fn next(ctx: *anyopaque, history: []const u32) u32 {
+        const r: *Router = @ptrCast(@alignCast(ctx));
+        return Model.next(&r.models[history[prompt.len]], history[1..]);
+    }
+};
+
+pub fn freeAll(texts: [][]u8) void {
+    for (texts) |t| gpa.free(t);
+    gpa.free(texts);
+}
+
+pub fn one(lead: []const u8, o: Opts) ![]u8 {
+    var back: Back = .{};
+    defer back.deinit();
+    var m = [_]Model{.{ .lead = lead }};
+    const texts = try replies(&m, o, &back);
+    defer gpa.free(texts);
+    return texts[0];
+}
