diff --git a/zig/src/core/runner_handoff_native_test.zig b/zig/src/core/runner_handoff_native_test.zig
new file mode 100644
index 000000000..f5cb09100
--- /dev/null
+++ b/zig/src/core/runner_handoff_native_test.zig
@@ -0,0 +1,95 @@
+//! Live handoff-rg tokens, including the structural think end and terminal EOS, through the real stream hook.
+const std = @import("std");
+const lanes = @import("lanes");
+const scan = @import("runner_scan.zig");
+const a = std.testing.allocator;
+const t = std.testing;
+const Native = struct {
+    key: []const u8,
+    original_sha256_match: bool,
+    sha256: []const u8,
+    chunks: []const struct { completion_index: usize, token_id: u32, bytes_hex: []const u8, think_open: bool },
+};
+
+const Replay = struct {
+    scanner: scan.Scanner = .{ .cfg = .{} },
+    bytes: []const u8 = "",
+    closed: usize = 0,
+    fired: usize = 0,
+    language: std.ArrayList(u8) = .empty,
+    source: std.ArrayList(u8) = .empty,
+    fn event(r: *@This(), e: scan.Events) !bool {
+        if (e.closed) |c| {
+            r.closed += 1;
+            r.language.clearRetainingCapacity();
+            try r.language.appendSlice(a, c.lang);
+            r.source.clearRetainingCapacity();
+            try r.source.appendSlice(a, c.code);
+        }
+        r.fired += @intFromBool(e.trigger != null);
+        return e.trigger != null;
+    }
+    fn token(ptr: *anyopaque, _: u32, thinking: bool, _: bool, ended: bool) bool {
+        const r: *@This() = @ptrCast(@alignCast(ptr));
+        _ = r.event(r.scanner.feed(a, if (ended) "" else r.bytes, thinking) catch unreachable) catch unreachable;
+        return false;
+    }
+    fn eos(ptr: *anyopaque, thinking: bool, _: bool) bool {
+        const r: *@This() = @ptrCast(@alignCast(ptr));
+        return r.event(r.scanner.finishEos(a, thinking) catch unreachable) catch unreachable;
+    }
+    fn deinit(r: *@This()) void {
+        r.scanner.deinit(a);
+        r.language.deinit(a);
+        r.source.deinit(a);
+    }
+};
+
+test "runner: live content-terminal fences survive an unbudgeted think boundary" {
+    const parsed = try std.json.parseFromSlice([]const Native, a, @embedFile("fixtures/runner/handoff-rg.json"), .{});
+    defer parsed.deinit();
+    try t.expectEqual(@as(usize, 3), parsed.value.len);
+    for (parsed.value, 0..) |row, index| {
+        try t.expect(row.original_sha256_match);
+        var hash = std.crypto.hash.sha2.Sha256.init(.{});
+        var buffer: [16]u8 = undefined;
+        for (row.chunks, 0..) |chunk, i| {
+            if (i > 0) hash.update(",");
+            hash.update(try std.fmt.bufPrint(&buffer, "{d}", .{chunk.token_id}));
+        }
+        var digest: [32]u8 = undefined;
+        hash.final(&digest);
+        try t.expectEqualStrings(row.sha256, &std.fmt.bytesToHex(digest, .lower));
+        for ([_]bool{ false, true }) |marker| {
+            var replay: Replay = .{};
+            defer replay.deinit();
+            var stream = try lanes.Stream.init(a, .{
+                .id = row.key,
+                .prompt = &.{2},
+                .max_new = 32768,
+                .eos = &.{1},
+                .think_end = if (marker) 128822 else -1,
+                .runner = .{ .ptr = &replay, .token = Replay.token, .eos = Replay.eos },
+            });
+            defer stream.deinit(a);
+            for (row.chunks, 0..) |chunk, i| {
+                try t.expectEqual(i, chunk.completion_index);
+                const bytes = try a.alloc(u8, chunk.bytes_hex.len / 2);
+                defer a.free(bytes);
+                _ = try std.fmt.hexToBytes(bytes, chunk.bytes_hex);
+                replay.bytes = bytes;
+                try t.expectEqual(@as(usize, 1), try stream.commit(a, &.{chunk.token_id}, &.{}));
+            }
+            try t.expectEqual(@as(usize, if (marker or index == 2) 1 else 0), replay.closed);
+            try t.expectEqual(@as(usize, if (marker or index == 2) 1 else 0), replay.fired);
+            try t.expectEqualStrings(if (marker) "python" else "", replay.language.items);
+            try t.expectEqual(marker and index < 2, stream.runner_eos_pending);
+            try t.expectEqual(@as(u32, 0), stream.think_budget);
+            try t.expect(!stream.loop_guard);
+            if (marker and index == 0) try t.expectEqualStrings(
+                "a = 282668092539785370248997280888\nb = 816005819957362936377102597457\nprint(a * b)\n",
+                replay.source.items,
+            );
+        }
+    }
+}
diff --git a/zig/src/core/runner_hold_bench.zig b/zig/src/core/runner_hold_bench.zig
new file mode 100644
index 000000000..7339658aa
--- /dev/null
+++ b/zig/src/core/runner_hold_bench.zig
@@ -0,0 +1,282 @@
+//! A runner hold's parts on real replies through the served runner (runner_open, TF_RUNNER* knobs), no GPU.
+const std = @import("std");
+const runner = @import("runner.zig");
+const ropen = @import("runner_open.zig");
+const route = @import("runner_graph_route.zig");
+const graph = @import("runner_graph.zig");
+const cost = @import("runner_cost_bench.zig");
+const dsv41 = @import("dsv41_tokenizer");
+const linux = std.os.linux;
+
+fn now() u64 {
+    var ts: std.c.timespec = undefined;
+    _ = std.c.clock_gettime(.MONOTONIC, &ts);
+    return @as(u64, @intCast(ts.sec)) * std.time.ns_per_s + @as(u64, @intCast(ts.nsec));
+}
+
+fn sleepNs(ns: u64) void {
+    var ts: std.c.timespec = .{ .sec = @intCast(ns / std.time.ns_per_s), .nsec = @intCast(ns % std.time.ns_per_s) };
+    _ = std.c.nanosleep(&ts, null);
+}
+
+/// The engine thread inside a round: busy on its CPU (a CUDA sync spins) until `until`.
+fn spinUntil(until: u64) void {
+    while (now() < until) std.atomic.spinLoopHint();
+}
+
+/// The process environment main was given, for the knob lookup a runner config parses with.
+var environ: ?*const std.process.Environ.Map = null;
+
+fn env(name: []const u8) ?[]const u8 {
+    const v = (environ orelse return null).get(name) orelse return null;
+    return if (v.len == 0) null else v;
+}
+
+/// One owned or abstained hold: its stages' times (ns from the trigger) and what the reply was forced.
+const Fire = struct {
+    owned: bool,
+    graph: bool,
+    feed: u64, // the trigger token's feed: scan, the cell's open, its translation thread's spawn
+    translated: u64,
+    started: u64,
+    done: u64,
+    settled: u64,
+    last_tick: u64, // the tick that returned the tokens: the result's poll and tokenize
+    exec: u64, // the job's own time on its thread (boot and run)
+    translate: u64 = 0, // on this thread, alone: the frontend's translation
+    lower: u64 = 0, // graph route: the calc program to one bank packet
+    bind: u64 = 0, // Machine.boot: the packet's plans bound
+    eval: u64 = 0, // Machine.run
+    step_ps: u64 = 0, // Machine.run's picoseconds per step
+    ticks: u32 = 1,
+};
+
+/// Every reply's tokens through one session per reply; at each hold the engine loop's ticks until the result.
+const Arm = struct {
+    name: []const u8,
+    first_ns: u64, // the trigger round's rest before the loop's first tick (0: ticks spin, no cadence)
+    round_ns: u64,
+    pin: bool, // the engine thread pinned to one CPU and busy between ticks
+    hogs: bool = false, // busy threads on the engine's and the runner's CPUs
+};
+
+fn pass(gpa: std.mem.Allocator, r: *runner.Runner, replies: []const cost.Reply, arm: Arm, fires: *std.ArrayList(Fire), digest: *std.hash.Wyhash) !void {
+    for (replies) |rep| {
+        const s = (try r.session(.{})).?;
+        defer s.destroy();
+        const hook = s.hook();
+        for (rep.tokens, 0..) |tok, i| {
+            const t0 = now();
+            const held = hook.token(hook.ptr, tok, i < rep.think_end, true, false);
+            const t1 = now();
+            if (!held) continue;
+            const cell = s.cells.items[s.waiting.?.index];
+            var f: Fire = .{ .owned = false, .graph = false, .feed = t1 - t0, .translated = 0, .started = 0, .done = 0, .settled = 0, .last_tick = 0, .exec = 0 };
+            const ids = while (true) {
+                if (arm.first_ns == 0) {
+                    if (f.translated == 0 and cell.translated.load(.acquire)) f.translated = now() - t1;
+                } else spinUntil(t1 + arm.first_ns + @as(u64, f.ticks - 1) * arm.round_ns);
+                const k0 = now();
+                const got = try s.tick();
+                const k1 = now();
+                if (f.started == 0 and (cell.job != null or cell.result != null)) f.started = k1 - t1;
+                if (f.done == 0 and (cell.result != null or cell.abstained)) f.done = k1 - t1;
+                if (got) |x| {
+                    f.settled = k1 - t1;
+                    f.last_tick = k1 - k0;
+                    break x;
+                }
+                f.ticks += 1;
+                if (arm.first_ns == 0) sleepNs(20 * std.time.ns_per_us);
+            };
+            defer gpa.free(ids);
+            digest.update(std.mem.sliceAsBytes(ids));
+            digest.update(&.{0xff});
+            f.owned = ids.len > 0;
+            if (cell.result) |res| f.exec = res.exec_ns;
+            if (cell.translation == .program) f.graph = cell.translation.program.kind == .graph;
+            if (arm.first_ns == 0 and f.owned) try direct(gpa, r, cell, &f);
+            try fires.append(gpa, f);
+        }
+    }
+}
+
+/// The owned cell's stages again on this thread alone: frontend, graph lowering, plan bind, evaluation.
+fn direct(gpa: std.mem.Allocator, r: *runner.Runner, cell: anytype, f: *Fire) !void {
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const inner = @import("runner_frontend.zig").frontend();
+    const t0 = now();
+    const t = try inner.translate(inner.ctx, a, .{ .form = cell.form, .lang = cell.lang, .code = cell.code });
+    f.translate = now() - t0;
+    if (!f.graph or t != .program) return;
+    const routed: *route.Routed = @ptrCast(@alignCast(r.frontend.ctx.?));
+    const t1 = now();
+    const bytes = try route.lower(a, routed.bank, t.program.bytes) orelse return;
+    f.lower = now() - t1;
+    const t2 = now();
+    var m = try graph.Machine.boot(a, routed.bank, bytes);
+    defer m.deinit();
+    f.bind = now() - t2;
+    var out: std.ArrayList(u8) = .empty;
+    const t3 = now();
+    const end = try m.run(r.cfg.max_steps, &out, null);
+    f.eval = now() - t3;
+    if (end.steps > 0) f.step_ps = f.eval * 1000 / end.steps;
+}
+
+/// Other threads busy on the engine's CPU and the runner's (server threads, a busy host).
+const Hogs = struct {
+    stop: std.atomic.Value(bool) = .init(false),
+    threads: std.ArrayList(std.Thread) = .empty,
+
+    fn spin(h: *Hogs, cpu: u32) void {
+        pinTo(cpu);
+        while (!h.stop.load(.monotonic)) std.atomic.spinLoopHint();
+    }
+
+    fn start(h: *Hogs, gpa: std.mem.Allocator, cpus: []const u32, per: u32) !void {
+        h.stop.store(false, .release);
+        for (cpus) |cpu| for (0..per) |_| try h.threads.append(gpa, try std.Thread.spawn(.{}, spin, .{ h, cpu }));
+    }
+
+    fn end(h: *Hogs) void {
+        h.stop.store(true, .release);
+        for (h.threads.items) |t| t.join();
+        h.threads.clearRetainingCapacity();
+    }
+};
+
+fn pinTo(cpu: u32) void {
+    var set: [16]u64 = @splat(0);
+    set[cpu / 64] = @as(u64, 1) << @intCast(cpu % 64);
+    _ = linux.syscall3(.sched_setaffinity, 0, @sizeOf(@TypeOf(set)), @intFromPtr(&set));
+}
+
+fn unpin() void {
+    const set: [16]u64 = @splat(std.math.maxInt(u64));
+    _ = linux.syscall3(.sched_setaffinity, 0, @sizeOf(@TypeOf(set)), @intFromPtr(&set));
+}
+
+fn quantiles(gpa: std.mem.Allocator, xs: []u64) ![3]f64 {
+    if (xs.len == 0) return .{ 0, 0, 0 };
+    const v = try gpa.dupe(u64, xs);
+    defer gpa.free(v);
+    std.mem.sort(u64, v, {}, std.sort.asc(u64));
+    const at = struct {
+        fn q(s: []const u64, p: f64) f64 {
+            const i: usize = @intFromFloat(@floor(p * @as(f64, @floatFromInt(s.len - 1)) + 0.5));
+            return @as(f64, @floatFromInt(s[i])) / 1e3;
+        }
+    };
+    return .{ at.q(v, 0.5), at.q(v, 0.9), at.q(v, 1.0) };
+}
+
+/// One stage's line in microseconds over the owned holds: p50, p90, max.
+fn row(gpa: std.mem.Allocator, name: []const u8, fires: []const Fire, comptime field: []const u8, graph_only: bool) !void {
+    var xs: std.ArrayList(u64) = .empty;
+    defer xs.deinit(gpa);
+    for (fires) |f| if (f.owned and (!graph_only or f.graph)) try xs.append(gpa, @field(f, field));
+    const q = try quantiles(gpa, xs.items);
+    std.debug.print("| {s} | {d} | {d:.0} | {d:.0} | {d:.0} |\n", .{ name, xs.items.len, q[0], q[1], q[2] });
+}
+
+/// A stage's span between two marks (ns from the trigger), as a Fire-like field for `row`.
+fn span(gpa: std.mem.Allocator, name: []const u8, fires: []const Fire, comptime from: []const u8, comptime to: []const u8) !void {
+    var xs: std.ArrayList(u64) = .empty;
+    defer xs.deinit(gpa);
+    for (fires) |f| if (f.owned) try xs.append(gpa, @field(f, to) -| @field(f, from));
+    const q = try quantiles(gpa, xs.items);
+    std.debug.print("| {s} | {d} | {d:.0} | {d:.0} | {d:.0} |\n", .{ name, xs.items.len, q[0], q[1], q[2] });
+}
+
+/// runner-hold-bench <tokenizer.json> <replies.jsonl> <engine-cpu> [first-ms round-ms settle-us hog-cpus per-cpu]
+pub fn main(init: std.process.Init) !u8 {
+    const gpa = std.heap.c_allocator;
+    const argv = try init.minimal.args.toSlice(init.arena.allocator());
+    environ = init.environ_map;
+    if (argv.len < 4) {
+        std.debug.print("usage: runner-hold-bench <tokenizer.json> <replies.jsonl> <engine-cpu> [first-ms round-ms settle-us hog-cpus per-cpu] (TF_RUNNER* or TF_DSV41_RUNNER* knobs)\n", .{});
+        return 2;
+    }
+    const cpu = try std.fmt.parseInt(u32, argv[3], 10);
+    const first_ms = if (argv.len > 4) try std.fmt.parseInt(u64, argv[4], 10) else 12;
+    const round_ms = if (argv.len > 5) try std.fmt.parseInt(u64, argv[5], 10) else 50;
+    const settle_us = if (argv.len > 6) try std.fmt.parseInt(u32, argv[6], 10) else 3000;
+    var hog_cpus: std.ArrayList(u32) = .empty;
+    if (argv.len > 7) {
+        var it = std.mem.splitScalar(u8, argv[7], ',');
+        while (it.next()) |x| try hog_cpus.append(gpa, try std.fmt.parseInt(u32, x, 10));
+    }
+    const per = if (argv.len > 8) try std.fmt.parseInt(u32, argv[8], 10) else 2;
+    var hogs: Hogs = .{};
+    const tok = try dsv41.Tokenizer.load(gpa, init.io, argv[1]);
+    var table: cost.Table = .{ .tok = tok };
+    const replies = try cost.load(gpa, init.io, &table, argv[2]);
+    var cfg = (try ropen.bindings.dsv41.parse(&env)) orelse {
+        std.debug.print("TF_RUNNER and TF_DSV41_RUNNER are off\n", .{});
+        return 2;
+    };
+    // the engine thread opens the runner: unplaced job threads inherit its pin, as served
+    pinTo(cpu);
+    cfg.settle_us = 0;
+    const old = try ropen.open(gpa, cfg);
+    cfg.settle_us = settle_us;
+    const new = try ropen.open(gpa, cfg);
+    for ([_]*runner.Runner{ old, new }) |r| r.text = .{ .ctx = &table, .bytes = cost.Table.bytes, .encode = cost.Table.encode };
+    const first = first_ms * std.time.ns_per_ms;
+    const round = round_ms * std.time.ns_per_ms;
+    const Case = struct { arm: Arm, r: *runner.Runner, settle: u32 };
+    const cases = [_]Case{
+        .{ .arm = .{ .name = "stages: ticks spin, engine unpinned (SETTLE_US=0)", .first_ns = 0, .round_ns = 0, .pin = false }, .r = old, .settle = 0 },
+        .{ .arm = .{ .name = "served cadence, pinned engine: SETTLE_US=0 (one stage a tick)", .first_ns = first, .round_ns = round, .pin = true }, .r = old, .settle = 0 },
+        .{ .arm = .{ .name = "served cadence, pinned engine: SETTLE_US", .first_ns = first, .round_ns = round, .pin = true }, .r = new, .settle = settle_us },
+        .{ .arm = .{ .name = "served cadence, pinned engine, busy CPUs: SETTLE_US=0", .first_ns = first, .round_ns = round, .pin = true, .hogs = true }, .r = old, .settle = 0 },
+        .{ .arm = .{ .name = "served cadence, pinned engine, busy CPUs: SETTLE_US", .first_ns = first, .round_ns = round, .pin = true, .hogs = true }, .r = new, .settle = settle_us },
+    };
+    var want: ?u64 = null;
+    for (cases) |c| {
+        if (c.arm.hogs and hog_cpus.items.len == 0) continue;
+        if (c.arm.hogs) try hogs.start(gpa, hog_cpus.items, per);
+        defer if (c.arm.hogs) hogs.end();
+        c.r.cfg.settle_us = c.settle;
+        if (c.arm.pin) pinTo(cpu) else unpin();
+        var fires: std.ArrayList(Fire) = .empty;
+        defer fires.deinit(gpa);
+        var digest = std.hash.Wyhash.init(0);
+        try pass(gpa, c.r, replies, c.arm, &fires, &digest);
+        const d = digest.final();
+        const same = if (want) |w| w == d else blk: {
+            want = d;
+            break :blk true;
+        };
+        var owned: u32 = 0;
+        var on_graph: u32 = 0;
+        var by_ticks: [5]u32 = @splat(0);
+        for (fires.items) |f| if (f.owned) {
+            owned += 1;
+            on_graph += @intFromBool(f.graph);
+            by_ticks[@min(f.ticks, 5) - 1] += 1;
+        };
+        std.debug.print("\n## {s}\n{d} holds, {d} owned ({d} graph), owned tokens digest {x} ({s})\n", .{ c.arm.name, fires.items.len, owned, on_graph, d, if (same) "identical" else "DIFFERS" });
+        std.debug.print("owned holds by ticks 1/2/3/4/5+: {d}/{d}/{d}/{d}/{d}\n", .{ by_ticks[0], by_ticks[1], by_ticks[2], by_ticks[3], by_ticks[4] });
+        std.debug.print("| stage (us, owned holds) | n | p50 | p90 | max |\n|---|---|---|---|---|\n", .{});
+        if (c.arm.first_ns == 0) {
+            try row(gpa, "scan close + cell open (trigger token's feed)", fires.items, "feed", false);
+            try row(gpa, "frontend translate, alone", fires.items, "translate", false);
+            try row(gpa, "graph lower (calc to bank packet), alone", fires.items, "lower", true);
+            try row(gpa, "graph plan bind (Machine.boot), alone", fires.items, "bind", true);
+            try row(gpa, "evaluate (Machine.run), alone", fires.items, "eval", true);
+            try row(gpa, "evaluate ns per step (x1000)", fires.items, "step_ps", true);
+            try row(gpa, "trigger to translated (thread)", fires.items, "translated", false);
+            try span(gpa, "translated to job started (next tick)", fires.items, "translated", "started");
+            try span(gpa, "job started to done (thread)", fires.items, "started", "done");
+            try row(gpa, "job's own time (exec_ns)", fires.items, "exec", false);
+            try row(gpa, "result tokenize (the returning tick)", fires.items, "last_tick", false);
+        }
+        try row(gpa, "held: trigger to tokens", fires.items, "settled", false);
+        if (!same) return 1;
+    }
+    return 0;
+}
diff --git a/zig/src/core/runner_inline_arith_test.zig b/zig/src/core/runner_inline_arith_test.zig
new file mode 100644
index 000000000..e3f7fc44b
--- /dev/null
+++ b/zig/src/core/runner_inline_arith_test.zig
@@ -0,0 +1,188 @@
+//! Inline arithmetic with thousands commas, brackets and a whole `gcd(a, b)`: reply lines, cells, CPython values.
+const std = @import("std");
+const graph = @import("runner_graph.zig");
+const route = @import("runner_graph_route.zig");
+const frontend = @import("runner_frontend.zig");
+const scan = @import("runner_scan.zig");
+const t = std.testing;
+
+/// The line up to the model's `=`, the cell code, and CPython's value of it (`^` read as `**`).
+const Golden = struct { []const u8, []const u8, []const u8 };
+
+/// Live lines (earlier live smoke and window replies, where the model then wrote this value), then variations.
+pub const goldens = [_]Golden{
+    .{ "next: 288,419,716 - 624,605,146 need borrow from previous limb (338,327,950). Borrow 1e9: (1,288,419,716 -624,605,146)=", "(1288419716 -624605146)", "663814570" },
+    .{ "64,800^2 =", "64800^2", "4199040000" },
+    .{ "285,000,000^2 =", "285000000^2", "81225000000000000" },
+    .{ "We had 136,418,000^2 =", "136418000^2", "18609870724000000" },
+    .{ "12,000,000^2=", "12000000^2", "144000000000000" },
+    .{ "Compute 5,764,801^2 =", "5764801^2", "33232930569601" },
+    .{ "We computed 234,567,890*12,345,679 =", "234567890*12345679", "2895899873647310" },
+    .{ "876,543,210*234 =", "876543210*234", "205111111140" },
+    .{ "2*69,663,000*30 =", "2*69663000*30", "4179780000" },
+    .{ "18,364,758,544,493,064,720 *3 =", "18364758544493064720 *3", "55094275633479194160" },
+    .{ "Compute 70,272,836,576 * 200,000,000 =", "70272836576 * 200000000", "14054567315200000000" },
+    .{ "Add to *12,000,000: 2,814,814,680,000,000 + 81,085,193,647,310 =", "2814814680000000 + 81085193647310", "2895899873647310" },
+    .{ "M^2: 789,971,041 + 1,950,922,114 =", "789971041 + 1950922114", "2740893155" },
+    .{ "M^3: 975,461,057 + 2 =", "975461057 + 2", "975461059" },
+    .{ "Add low: 507,835,392 + 985,229,328 =", "507835392 + 985229328", "1493064720" },
+    .{ "We need 3^400 mod 10^18. Since gcd(3,10)=", "gcd(3,10)", "1" },
+    .{ "Output: gcd(462, 1071) =", "gcd(462, 1071)", "21" },
+    // bn-011's bracketed squares, other operators, signs, and gcd edges
+    .{ "(147,000+73)^2=", "(147000+73)^2", "21630467329" },
+    .{ "Square: (179,000+457)^2 = ", "(179000+457)^2", "32204814849" },
+    .{ "2*(1,000+24) =", "2*(1000+24)", "2048" },
+    .{ "(1,000 − 7) × 3 =", "(1000 − 7) × 3", "2979" },
+    .{ "-(2,000+5) =", "-(2000+5)", "-2005" },
+    .{ "49,659 − 29,876 =", "49659 − 29876", "19783" },
+    .{ "1,024 × 1,024 =", "1024 × 1024", "1048576" },
+    .{ "1,234 + 5 =", "1234 + 5", "1239" },
+    .{ "Now subtract 3^67 =", "3^67", "92709463147897837085761925410587" },
+    .{ "(10,000,000,000,000,000,000+123,456,789)^2-10,000,000,000,000,000,000^2 =", "(10000000000000000000+123456789)^2-10000000000000000000^2", "2469135780015241578750190521" },
+    .{ "So gcd(0,0) =", "gcd(0,0)", "0" },
+    .{ "gcd(1234567890, 9876543210) =", "gcd(1234567890, 9876543210)", "90" },
+    .{ "Since: gcd(0, 24) =", "gcd(0, 24)", "24" },
+};
+
+/// Lines no cell may open; the model keeps writing.
+const refused = [_][]const u8{
+    // prose, decimal and list commas
+    "3, 4 and 5 =",
+    "1, 234 + 5 =",
+    "3,5 * 2 =",
+    "12,34 + 5 =",
+    "1,23 + 5 =",
+    "0,500 * 2 =",
+    "1.234,567 * 2 =",
+    "1,2345 + 1 =",
+    "1,234,5678 + 1 =",
+    ",000+5 =",
+    "1,000, +5 =",
+    "1673, +10 =",
+    // floats with commas: CPython's value would be a float
+    "44,253,970,636,272 / 16 =",
+    "1,234.5 * 2 =",
+    "1,000 ÷ 8 =",
+    // tuple, list, set or call context
+    "(1,000, 2,000) =",
+    "[1,000 + 2 =",
+    "{1,000*2 =",
+    "f(1,000+2) =",
+    "print((1,000+2) =",
+    "point (3,141 + 1 =",
+    "max(1,000, 2) =",
+    "x = (1,000+2) =",
+    // calls that are not a whole literal gcd
+    "lcm(4, 6) =",
+    "f(3) + 1 =",
+    "φ(2^18)=",
+    "Since φ(5^18)=",
+    "√(16) =",
+    "gcd(4, 6, 8) =",
+    "gcd(-4, 6) =",
+    "gcd(04, 6) =",
+    "gcd(4,6)^2 =",
+    "2 * gcd(4, 6) =",
+    "math.gcd(4, 6) =",
+    "xgcd(4, 6) =",
+    "\\gcd(4, 6) =",
+    "gcd(1,000, 5) =",
+    "gcd(4 , 6) =",
+    "gcd(a, 6) =",
+    "gcd(4,  6) =",
+    "x mod gcd(4, 6) =",
+    "Add gcd(4, 6) =",
+    "gcd(4, 6) = 2",
+    // unbalanced brackets
+    "(147,000+73 =",
+    "147,000+73) =",
+    "((1,000+2) =",
+    "1,000+2)) =",
+    // the right operand of a TeX or worded operator (SparkDash e89f8d1 reason-09 and arith-27 on the compute default)
+    "- Jamal: \\(4 \\times 49 - 11 =",
+    "1. \\(221 \\bmod 4331 + 1000 =",
+    "9. \\(15314 \\bmod 8563 + 1000 =",
+    "Target floor: \\(4 \\times 3 + 6 =",
+    "\\(68 \\div 2 + 10 =",
+    "\\(0.5^2 \\times 0.06^2 =",
+    "Surface area of cube with side 2: \\(6 \\cdot 2^2 =",
+    "x \\cdot 3 + 4 =",
+    "4 times 49 - 11 =",
+    // a running total the model holds
+    "Add 11,529,600 +1 =",
+    "Minus 2,386,000 +25 =",
+    "subtract: 1,000 - 5 =",
+    "Plus 3 + 4 =",
+};
+
+/// The cell a line closes at its `=` with inline math on, or null.
+fn cellOf(a: std.mem.Allocator, line: []const u8, cfg: scan.Config) !?[]u8 {
+    var s: scan.Scanner = .{ .cfg = cfg };
+    defer s.deinit(a);
+    const e = try s.feed(a, line, true);
+    const c = e.closed orelse return null;
+    if (c.form != .inline_expr or e.trigger == null or e.trigger.?.inline_space == null) return null;
+    return try a.dupe(u8, c.code);
+}
+
+test "runner scan: inline arithmetic with commas, brackets and gcd opens cells with Python-readable code" {
+    for (goldens) |g| {
+        const got = try cellOf(t.allocator, g[0], .{ .inline_math = true }) orelse {
+            std.debug.print("no cell: {s}\n", .{g[0]});
+            return error.TestExpectedInline;
+        };
+        defer t.allocator.free(got);
+        try t.expectEqualStrings(g[1], got);
+    }
+    for (refused) |line| if (try cellOf(t.allocator, line, .{ .inline_math = true })) |got| {
+        defer t.allocator.free(got);
+        std.debug.print("opened, must not: {s} -> {s}\n", .{ line, got });
+        return error.TestUnexpectedInline;
+    };
+}
+
+test "runner scan: inline arithmetic is off with its knob; a plain expression is not" {
+    const a = t.allocator;
+    const off: scan.Config = .{ .inline_math = true, .inline_arith = false };
+    for ([_][]const u8{ "(147,000+73)^2=", "Since gcd(3,10)=", "1,234 + 5 =" }) |line| {
+        try t.expectEqual(@as(?[]u8, null), try cellOf(a, line, off));
+    }
+    const plain = (try cellOf(a, "(147000+73)^2=", off)).?;
+    defer a.free(plain);
+    try t.expectEqualStrings("(147000+73)^2", plain);
+    try t.expectEqual(@as(?[]u8, null), try cellOf(a, "(147,000+73)^2=", .{}));
+}
+
+fn bankPath() ![]const u8 {
+    const p = std.c.getenv("TF_RUNNER_GRAPH_BANK") orelse return error.SkipZigTest;
+    return std.mem.span(p);
+}
+
+test "runner proof: inline arithmetic lines scan to cells that run on the graph bank and print CPython's value (TF_RUNNER_GRAPH_BANK)" {
+    var bank = try graph.Bank.load(t.allocator, try bankPath());
+    defer bank.deinit();
+    var context: frontend.Context = .{ .io = t.io, .compiler = .{ .clang = "/nonexistent-inline-arith-clang" } };
+    var routed: route.Routed = .{ .inner = context.frontend(), .bank = &bank };
+    const f = routed.frontend();
+    for (goldens) |g| {
+        // end to end: the scanner's own cell for the reply line, not the golden's expected code
+        const code = try cellOf(t.allocator, g[0], .{ .inline_math = true }) orelse return error.TestExpectedInline;
+        defer t.allocator.free(code);
+        const result = try f.translate(f.ctx, t.allocator, .{ .form = .inline_expr, .lang = "python", .code = code });
+        defer if (result == .program) t.allocator.free(result.program.bytes);
+        if (result != .program or result.program.kind != .graph) {
+            std.debug.print("not on the graph: {s}: {any}\n", .{ code, result });
+            return error.TestExpectedGraph;
+        }
+        var machine = try @import("runner_graph_machine.zig").Machine.boot(t.allocator, &bank, result.program.bytes);
+        defer machine.deinit();
+        var out: std.ArrayList(u8) = .empty;
+        defer out.deinit(t.allocator);
+        const end = try machine.run(4_000_000, &out, null);
+        try t.expect(end.end == .halted);
+        std.testing.expectEqualStrings(g[2], std.mem.trimEnd(u8, out.items, "\n")) catch |e| {
+            std.debug.print("inline arith value: {s}\n", .{code});
+            return e;
+        };
+    }
+}
diff --git a/zig/src/core/runner_inline_chain_test.zig b/zig/src/core/runner_inline_chain_test.zig
