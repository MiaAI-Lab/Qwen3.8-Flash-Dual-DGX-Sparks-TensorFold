diff --git a/zig/src/core/runner_open.zig b/zig/src/core/runner_open.zig
new file mode 100644
index 000000000..a35b675b3
--- /dev/null
+++ b/zig/src/core/runner_open.zig
@@ -0,0 +1,150 @@
+//! The served in-model runner: knobs to a circuit file, its CPU backend and the frontend, for a family's engine.
+const std = @import("std");
+const runner = @import("runner.zig");
+const circuit = @import("runner_circuit.zig");
+const graph = @import("runner_graph.zig");
+const route = @import("runner_graph_route.zig");
+const frontend_mod = @import("runner_frontend.zig");
+const Allocator = std.mem.Allocator;
+const log = std.log.scoped(.runner);
+
+pub const Config = runner.Config;
+pub const Runner = runner.Runner;
+pub const Text = runner.Text;
+pub const TraceAsk = runner.TraceAsk;
+pub const validTraceFormat = @import("runner_trace.zig").validFormat;
+pub const maxTraceRepeat = @import("runner_trace.zig").max_repeat;
+pub const place = runner.place;
+/// A family's knob prefix for the runner: generic TF_RUNNER* or its own alias (runner_binding.zig).
+pub const bindings = @import("runner_binding.zig");
+pub const Binding = bindings.Binding;
+
+const Opened = struct {
+    runner: Runner,
+    circuit: *const circuit.Circuit, // own_circuit, or the circuit of the runner this one shares with
+    own_circuit: circuit.Circuit = undefined,
+    placer: runner.place.Placer,
+    bank: *const graph.Bank = undefined, // likewise own_bank or a shared bank
+    own_bank: graph.Bank = undefined,
+    has_bank: bool = false,
+    routed: route.Routed = undefined,
+    quick: route.Quick = undefined, // cfg.sync_graph: routed's engine-thread part
+    dispatch: route.Dispatch = undefined,
+    threaded: std.Io.Threaded = undefined, // a configured frontend's engine-lifetime io
+    configured_frontend: frontend_mod.Context = undefined,
+    compiles: bool = true, // the frontend may build an ELF (clang); false under cfg.compile false
+};
+
+var loads: std.atomic.Value(u32) = .init(0);
+
+/// Whether `r`'s frontend may build an ELF (clang), as its Config's compile asked.
+pub fn compiles(r: *Runner) bool {
+    const o: *Opened = @alignCast(@fieldParentPtr("runner", r));
+    return o.compiles;
+}
+
+/// Circuit and graph-bank files this process has loaded (each open that shares nothing adds one or two).
+pub fn loaded() u32 {
+    return loads.load(.monotonic);
+}
+
+/// The runner for `cfg` (from Config.parse); lives as long as the engine. CUDA waits for its backend (DESIGN T4).
+pub fn open(gpa: Allocator, cfg: Config) !*Runner {
+    return openSharing(gpa, cfg, null);
+}
+
+/// open, reusing `with`'s loaded circuit (and bank) when `cfg` names the same files; backend and workers stay its own.
+pub fn openSharing(gpa: Allocator, cfg: Config, with: ?*Runner) !*Runner {
+    if (cfg.device != .cpu) {
+        log.err("{s}_DEVICE=cuda: the CUDA circuit backend is not in this build", .{cfg.prefix});
+        return error.BadKnob;
+    }
+    const w: ?*Opened = if (with) |r| @as(*Opened, @alignCast(@fieldParentPtr("runner", r))) else null;
+    const o = try gpa.create(Opened);
+    errdefer gpa.destroy(o);
+    o.* = .{ .runner = undefined, .circuit = undefined, .placer = .{ .cfg = cfg.place } };
+    if (w != null and std.mem.eql(u8, w.?.runner.cfg.circuit, cfg.circuit)) {
+        o.circuit = w.?.circuit; // loaded and probed once, by the runner it shares with
+    } else {
+        o.own_circuit = circuit.Circuit.load(gpa, cfg.circuit) catch |e| {
+            log.err("{s}_CIRCUIT={s}: {t}", .{ cfg.prefix, cfg.circuit, e });
+            return e;
+        };
+        errdefer o.own_circuit.deinit(gpa);
+        _ = loads.fetchAdd(1, .monotonic);
+        o.circuit = &o.own_circuit;
+        try probe(gpa, o.circuit);
+    }
+    errdefer if (o.circuit == &o.own_circuit) o.own_circuit.deinit(gpa);
+    const back = try @import("runner_circuit_backend.zig").placed(gpa, o.circuit, cfg.workers, &o.placer);
+    var frontend = frontend_mod.frontend();
+    if (!cfg.compile or cfg.compile_steps != 10522) {
+        // Empty scratch root prevents new compiler runs; S3 also refuses cached ELF when disabled.
+        o.threaded = .init(gpa, .{});
+        o.configured_frontend = .{ .io = o.threaded.io() };
+        o.configured_frontend.compiler.step_budget = cfg.compile_steps;
+        if (!cfg.compile) o.configured_frontend.compiler.scratch_root = "";
+        frontend = o.configured_frontend.frontend();
+        o.compiles = cfg.compile;
+    }
+    if (cfg.compile) {
+        // the compiler kept started and the fixed runtime compiled now, so no call pays clang's start or the runtime
+        var warm_io: std.Io.Threaded = .init(gpa, .{});
+        defer warm_io.deinit();
+        try @import("runner_frontend_split.zig").warm(gpa, warm_io.io(), .{});
+    }
+    var backend = back;
+    // backend graph: T1's bank loads once here; pure-integer calc programs run on it, the rest on the circuit
+    if (cfg.backend == .graph) {
+        const t0 = nowNs();
+        if (w != null and w.?.has_bank and std.mem.eql(u8, w.?.runner.cfg.graph_bank, cfg.graph_bank)) {
+            o.bank = w.?.bank;
+        } else {
+            o.own_bank = graph.Bank.load(gpa, cfg.graph_bank) catch |e| {
+                log.err("{s}_GRAPH_BANK={s}: {t}", .{ cfg.prefix, cfg.graph_bank, e });
+                return e;
+            };
+            _ = loads.fetchAdd(1, .monotonic);
+            o.bank = &o.own_bank;
+        }
+        o.has_bank = true;
+        o.routed = .{ .inner = frontend, .bank = o.bank };
+        // settling holds: graph jobs leave the engine thread's CPU as the circuit's do (unplaced, they share its pin)
+        const placer: ?*runner.place.Placer = if (cfg.settle_us > 0) &o.placer else null;
+        o.dispatch = .{ .gpa = gpa, .circuit = back, .graph = try graph.placed(gpa, o.bank, cfg.workers, placer), .bank = o.bank };
+        frontend = o.routed.frontend();
+        backend = o.dispatch.backend();
+        log.info("in-model runner: graph bank {s} {s} in {d} ms", .{ cfg.graph_bank, if (o.bank == &o.own_bank) "loaded" else "shared", (nowNs() - t0) / std.time.ns_per_ms });
+    }
+    o.runner = .{ .gpa = gpa, .cfg = cfg, .frontend = frontend, .backend = backend, .placer = &o.placer };
+    if (cfg.sync_graph) {
+        o.quick = .{ .routed = &o.routed };
+        o.runner.quick = o.quick.frontend();
+    }
+    log.info("in-model runner: circuit {s}{s}, cpu, {d} workers, {d} steps a run, backend {t}, settle {d} us{s}{s}", .{ cfg.circuit, if (o.circuit == &o.own_circuit) "" else " (shared)", cfg.workers, cfg.max_steps, cfg.backend, cfg.settle_us, if (cfg.compile) "" else ", no ELF", if (cfg.sync_graph) ", graph results settle at their trigger" else "" });
+    return &o.runner;
+}
+
+/// The circuit route at boot (served compiler, this circuit, unplaced): a wrong loop value refuses the runner.
+fn probe(gpa: Allocator, c: *const circuit.Circuit) !void {
+    const t0 = nowNs();
+    var threaded = std.Io.Threaded.init(gpa, .{});
+    defer threaded.deinit();
+    const compiler = try @import("runner_frontend_boot.zig").selfTest(gpa, threaded.io(), .{});
+    const back = try @import("runner_circuit_backend.zig").backend(gpa, c, 1);
+    defer @import("runner_circuit_backend.zig").destroy(back);
+    var why: [256]u8 = undefined;
+    const got = try @import("runner_probe.zig").run(gpa, @import("runner_frontend.zig").frontend(), back, compiler, &why);
+    if (got.wrong) |w| {
+        log.err("in-model runner probe: {s}; the runner refuses this circuit and compiler", .{w});
+        return error.RunnerProbe;
+    }
+    if (!compiler) return log.info("in-model runner probe: no RV32 compiler, the circuit route abstains", .{});
+    log.info("in-model runner probe: {d} probe cells print the right output on the circuit in {d} steps ({d} ms)", .{ got.ran, got.steps, (nowNs() - t0) / std.time.ns_per_ms });
+}
+
+fn nowNs() u64 {
+    var ts: std.c.timespec = undefined;
+    _ = std.c.clock_gettime(.MONOTONIC, &ts);
+    return @as(u64, @intCast(ts.sec)) * std.time.ns_per_s + @as(u64, @intCast(ts.nsec));
+}
diff --git a/zig/src/core/runner_output.zig b/zig/src/core/runner_output.zig
new file mode 100644
index 000000000..d035cee5e
--- /dev/null
+++ b/zig/src/core/runner_output.zig
@@ -0,0 +1,73 @@
+//! Encodes a settled run's output for its inline, fence or REPL delivery position.
+const std = @import("std");
+const api = @import("runner_api.zig");
+const scan = @import("runner_scan.zig");
+const Allocator = std.mem.Allocator;
+
+pub const suffix = " @engine";
+pub const Policy = struct { max_tokens: u32, inline_mark: bool = false };
+pub const Text = struct {
+    ctx: ?*anyopaque = null,
+    bytes: *const fn (ctx: ?*anyopaque, token: u32) []const u8,
+    encode: *const fn (ctx: ?*anyopaque, a: Allocator, text: []const u8) Allocator.Error![]u32,
+};
+
+pub fn value(out: []const u8) []const u8 {
+    return if (std.mem.endsWith(u8, out, "\n")) out[0 .. out.len - 1] else out;
+}
+
+pub fn owned(gpa: Allocator, tx: Text, res: api.Result, w: scan.Trigger, policy: Policy) Allocator.Error![]u32 {
+    var body: std.ArrayList(u8) = .empty;
+    defer body.deinit(gpa);
+    const out = value(res.out);
+    if (w.inline_space) |space| {
+        // only the value after `=`; past the cap it is the model's own text again
+        try body.appendSlice(gpa, if (space) " " else "");
+        try body.appendSlice(gpa, out);
+        if (policy.inline_mark) try body.appendSlice(gpa, suffix);
+        const ids = try tx.encode(tx.ctx, gpa, body.items);
+        if (ids.len <= policy.max_tokens) return ids;
+        gpa.free(ids);
+        return try gpa.alloc(u32, 0);
+    }
+    if (w.terminal) try body.appendSlice(gpa, "\nResult:\n") else if (w.newline_before)
+        try body.append(gpa, '\n');
+    try body.appendSlice(gpa, out);
+    switch (res.status) {
+        .ok, .abstain => {},
+        .budget => try body.print(gpa, "\n[stopped after {d} steps]", .{res.steps}),
+        .fault => try body.appendSlice(gpa, "\n[machine fault]"),
+    }
+    const ids = try tx.encode(tx.ctx, gpa, body.items);
+    defer gpa.free(ids);
+    const tail = try tx.encode(tx.ctx, gpa, if (w.fenced) "\n```\n" else "\n");
+    defer gpa.free(tail);
+    const note = if (ids.len > policy.max_tokens) try tx.encode(tx.ctx, gpa, "\n[output cut]") else try gpa.alloc(u32, 0);
+    defer gpa.free(note);
+    const keep = ids[0..@min(ids.len, policy.max_tokens)];
+    return std.mem.concat(gpa, u32, &.{ keep, note, tail });
+}
+
+/// The model sees the suffix; the computation scanner sees only the result's original bytes.
+pub fn scanning(remaining: *?usize, bytes: []const u8) []const u8 {
+    if (remaining.*) |*left| {
+        const keep = @min(left.*, bytes.len);
+        left.* -= keep;
+        return bytes[0..keep];
+    }
+    return bytes;
+}
+test "runner: inline provenance scanner view excludes only forced metadata" {
+    const a = std.testing.allocator;
+    var scanner: scan.Scanner = .{ .cfg = .{ .inline_math = true } };
+    defer scanner.deinit(a);
+    _ = try scanner.feed(a, "47 * 83 =", true);
+    var remaining: ?usize = 5;
+    for ([_][]const u8{ " 39", "01 @", "engine" }) |chunk| {
+        const kept = scanning(&remaining, chunk);
+        if (kept.len > 0) _ = try scanner.feed(a, kept, true);
+    }
+    try std.testing.expectEqualStrings("47 * 83 = 3901", scanner.line.items);
+    var model: ?usize = null;
+    try std.testing.expectEqualStrings(" @engine", scanning(&model, " @engine"));
+}
diff --git a/zig/src/core/runner_place_test.zig b/zig/src/core/runner_place_test.zig
new file mode 100644
index 000000000..229154fbb
--- /dev/null
+++ b/zig/src/core/runner_place_test.zig
@@ -0,0 +1,219 @@
+//! The runner's thread placement: knobs, the auto choice, and real runner threads on their CPUs at their niceness.
+const std = @import("std");
+const builtin = @import("builtin");
+const place = @import("runner_place.zig");
+const runner = @import("runner.zig");
+const rt = @import("runner_test.zig");
+const backend = @import("runner_circuit_backend.zig");
+const linux = std.os.linux;
+
+const gpa = std.testing.allocator;
+
+fn env(pairs: []const [2][]const u8) *const fn ([]const u8) ?[]const u8 {
+    const S = struct {
+        var vars: []const [2][]const u8 = &.{};
+        fn get(name: []const u8) ?[]const u8 {
+            for (vars) |p| if (std.mem.eql(u8, p[0], name)) return p[1];
+            return null;
+        }
+    };
+    S.vars = pairs;
+    return S.get;
+}
+
+fn list(text: []const u8) place.Set {
+    var set: place.Set = undefined;
+    std.debug.assert(@import("compute_sandbox.zig").cpuList(text, &set));
+    return set;
+}
+
+fn show(set: *const place.Set) []const u8 {
+    const S = struct {
+        var buf: [256]u8 = undefined;
+    };
+    return place.format(set, &S.buf);
+}
+
+test "runner placement: knobs parse auto, inherit, a CPU list and a niceness; bad values refuse" {
+    const auto = try runner.Config.parse(env(&.{ .{ "R", "1" }, .{ "R_CIRCUIT", "c" } }), "R");
+    try std.testing.expect(auto.?.place.cpus == .auto);
+    try std.testing.expectEqual(@as(u8, 10), auto.?.place.nice);
+    const inherit = try place.Config.parse(env(&.{.{ "R_CPUS", "inherit" }}), "R");
+    try std.testing.expect(inherit.cpus == .inherit);
+    const pinned = try place.Config.parse(env(&.{ .{ "R_CPUS", "0-4,10-14" }, .{ "R_NICE", "15" } }), "R");
+    try std.testing.expectEqualStrings("0-4,10-14", show(&pinned.cpus.list));
+    try std.testing.expectEqual(@as(u8, 15), pinned.nice);
+    for ([_][2][]const u8{ .{ "R_CPUS", "4-2" }, .{ "R_CPUS", "big" }, .{ "R_NICE", "20" }, .{ "R_NICE", "-1" } }) |kv|
+        try std.testing.expectError(error.BadKnob, place.Config.parse(env(&.{kv}), "R"));
+}
+
+/// GB10's Grace: cores 0-4 and 10-14 small (718, 731), 5-9 and 15-19 big (997-1024), 19 the plan link's auto pin.
+fn gb10(cpu: u32) ?u32 {
+    return switch (cpu) {
+        0...4 => 718,
+        10...14 => 731,
+        5...9 => 997,
+        15...18 => 1017,
+        19 => 1024,
+        else => null,
+    };
+}
+
+fn uniform(_: u32) ?u32 {
+    return 1024;
+}
+
+test "runner placement: auto keeps off the engine's CPUs and, where core sizes differ, off the big cores" {
+    const all = list("0-19");
+    var engine: place.Set = @splat(0);
+    place.add(&engine, 19);
+    try std.testing.expectEqualStrings("0-4,10-14", show(&place.choose(&all, &engine, gb10)));
+    // a container given big cores only: they are all one size, so everything but the engine's
+    try std.testing.expectEqualStrings("5-9,15-18", show(&place.choose(&list("5-9,15-19"), &engine, gb10)));
+    try std.testing.expectEqualStrings("0-18", show(&place.choose(&all, &engine, uniform)));
+    try std.testing.expect(place.empty(&place.choose(&list("19"), &engine, uniform)));
+    // the real machine: never a CPU outside the container's, never the engine's
+    const allowed = place.allowedCpus();
+    var avoid: place.Set = @splat(0);
+    place.add(&avoid, 0);
+    const got = place.choose(&allowed, &avoid, place.capacity);
+    for (0..1024) |c| if (place.has(&got, @intCast(c))) {
+        try std.testing.expect(place.has(&allowed, @intCast(c)) and c != 0);
+    };
+}
+
+/// The calling thread's CPU mask, niceness and name.
+const Seen = struct {
+    mask: place.Set = @splat(0),
+    nice: isize = 0,
+    name: [16]u8 = @splat(0),
+
+    fn now() Seen {
+        var s: Seen = .{};
+        _ = linux.syscall3(.sched_getaffinity, 0, @sizeOf(place.Set), @intFromPtr(&s.mask));
+        s.nice = 20 - @as(isize, @bitCast(linux.syscall2(.getpriority, 0, 0)));
+        _ = linux.prctl(@backingInt(linux.PR.GET_NAME), @intFromPtr(&s.name), 0, 0, 0);
+        return s;
+    }
+
+    fn named(s: *const Seen) []const u8 {
+        return std.mem.sliceTo(&s.name, 0);
+    }
+};
+
+/// Two CPUs this test may use: the engine's stand-in and the runner's; null on a one-CPU machine.
+fn twoCpus() ?[2]u32 {
+    var mask: place.Set = @splat(0);
+    _ = linux.syscall3(.sched_getaffinity, 0, @sizeOf(place.Set), @intFromPtr(&mask));
+    var first: ?u32 = null;
+    var last: u32 = 0;
+    for (0..1024) |c| if (place.has(&mask, @intCast(c))) {
+        if (first == null) first = @intCast(c);
+        last = @intCast(c);
+    };
+    const f = first orelse return null;
+    return if (f == last) null else .{ f, last };
+}
+
+fn pinSelf(cpu: u32) void {
+    var set: place.Set = @splat(0);
+    place.add(&set, cpu);
+    _ = linux.syscall3(.sched_setaffinity, 0, @sizeOf(place.Set), @intFromPtr(&set));
+}
+
+test "runner placement: a thread the pinned engine starts runs on the runner's CPUs at nice 10 or more, not the engine's" {
+    if (builtin.os.tag != .linux) return error.SkipZigTest;
+    const cpus = twoCpus() orelse return error.SkipZigTest;
+    var p: place.Placer = .{ .cfg = .{ .cpus = .{ .list = @splat(0) } } };
+    place.add(&p.cfg.cpus.list, cpus[1]);
+    const Engine = struct {
+        fn child(pl: ?*place.Placer, out: *Seen) void {
+            if (pl) |x| x.enter();
+            out.* = Seen.now();
+        }
+        // the engine thread: pinned (as the plan link pins it), then it starts runner threads
+        fn run(cpu: u32, pl: *place.Placer, placed: *Seen, unplaced: *Seen, own: *Seen) void {
+            pinSelf(cpu);
+            const a = std.Thread.spawn(.{}, child, .{ pl, placed }) catch return;
+            a.join();
+            const b = std.Thread.spawn(.{}, child, .{ null, unplaced }) catch return;
+            b.join();
+            own.* = Seen.now();
+        }
+    };
+    var placed: Seen = .{};
+    var unplaced: Seen = .{};
+    var own: Seen = .{};
+    const t = try std.Thread.spawn(.{}, Engine.run, .{ cpus[0], &p, &placed, &unplaced, &own });
+    t.join();
+    var want: place.Set = @splat(0);
+    place.add(&want, cpus[1]);
+    var engine: place.Set = @splat(0);
+    place.add(&engine, cpus[0]);
+    try std.testing.expectEqualSlices(u64, &want, &placed.mask);
+    try std.testing.expect(placed.nice >= 10);
+    try std.testing.expectEqualStrings("tf-runner", placed.named());
+    // the control: without the placer a runner thread inherits the engine's CPU and niceness
+    try std.testing.expectEqualSlices(u64, &engine, &unplaced.mask);
+    // and the engine thread itself is untouched
+    try std.testing.expectEqualSlices(u64, &engine, &own.mask);
+    try std.testing.expectEqual(own.nice, unplaced.nice);
+    try std.testing.expectEqual(@as(u32, 1), p.entered.load(.acquire));
+}
+
+/// Every placed thread's mask must equal the placer's set: counts the threads that matched and that did not.
+const Watch = struct {
+    var good: std.atomic.Value(u32) = .init(0);
+    var bad: std.atomic.Value(u32) = .init(0);
+
+    fn check(p: *place.Placer) void {
+        const s = Seen.now();
+        const ok = std.mem.eql(u64, &s.mask, &p.cfg.cpus.list) and s.nice >= p.cfg.nice;
+        _ = (if (ok) &good else &bad).fetchAdd(1, .monotonic);
+    }
+
+    fn reset() void {
+        good.store(0, .monotonic);
+        bad.store(0, .monotonic);
+    }
+};
+
+fn placerOn(cpu: u32) place.Placer {
+    var p: place.Placer = .{ .cfg = .{ .cpus = .{ .list = @splat(0) } }, .on_enter = Watch.check };
+    place.add(&p.cfg.cpus.list, cpu);
+    return p;
+}
+
+test "runner placement: the CPU backend's job threads run placed" {
+    if (builtin.os.tag != .linux) return error.SkipZigTest;
+    const cpus = twoCpus() orelse return error.SkipZigTest;
+    Watch.reset();
+    var p = placerOn(cpus[1]);
+    const bytes = try @import("runner_circuit_tiny_test.zig").build(gpa, .good);
+    defer gpa.free(bytes);
+    var circuit = try @import("runner_circuit_load.zig").fromBytes(gpa, bytes);
+    defer circuit.deinit(gpa);
+    const b = try backend.placed(gpa, &circuit, 2, &p);
+    defer backend.destroy(b);
+    for (0..3) |i| {
+        const id = try b.start(i, .{ .kind = .calc, .bytes = "" }, 100);
+        while (b.poll(id) == .running) std.Thread.yield() catch {};
+    }
+    try std.testing.expectEqual(@as(u32, 3), Watch.good.load(.acquire));
+    try std.testing.expectEqual(@as(u32, 0), Watch.bad.load(.acquire));
+}
+
+test "runner placement: a reply's translation runs placed and the reply is unchanged" {
+    if (builtin.os.tag != .linux) return error.SkipZigTest;
+    const cpus = twoCpus() orelse return error.SkipZigTest;
+    Watch.reset();
+    var p = placerOn(cpus[1]);
+    const inherited = try rt.one(rt.mul_cell, .{});
+    defer gpa.free(inherited);
+    const placed = try rt.one(rt.mul_cell, .{ .placer = &p });
+    defer gpa.free(placed);
+    try std.testing.expectEqualStrings(inherited, placed);
+    try std.testing.expect(std.mem.indexOf(u8, placed, rt.product) != null);
+    try std.testing.expect(Watch.good.load(.acquire) >= 1);
+    try std.testing.expectEqual(@as(u32, 0), Watch.bad.load(.acquire));
+}
diff --git a/zig/src/core/runner_probe.zig b/zig/src/core/runner_probe.zig
new file mode 100644
index 000000000..7b16d716d
--- /dev/null
+++ b/zig/src/core/runner_probe.zig
@@ -0,0 +1,144 @@
+//! Boot probe of the circuit route: known cells through the frontend, the compiler and the loaded circuit.
+const std = @import("std");
+const api = @import("runner_api.zig");
+
+/// Loops compiled to RV32 and CPython's (or C's) output: sums, // and %, a product, a string read from ROM bytes.
+pub const cells = [_]struct { lang: []const u8 = "python", code: []const u8, want: []const u8 }{
+    .{ .code = "total = 0\nfor i in range(10):\n    total += i * i\nprint(total)\n", .want = "285\n" },
+    .{ .code = "print(sum(i*i for i in range(10)))\n", .want = "285\n" },
+    .{ .code = "print(sum(1000003//d for d in range(3, 40)))\n", .want = "2753534\n" },
+    .{ .code = "print(sum(1000003%d for d in range(3, 40)))\n", .want = "357\n" },
+    .{ .code = "f = 1\nfor i in range(1, 13):\n    f *= i\nprint(f)\n", .want = "479001600\n" },
+    .{ .lang = "c", .code = "int main(void) { puts(\"circuit route\"); return 0; }\n", .want = "circuit route\n" },
+};
+
+/// Steps a probe run may take (each cell needs far fewer): a circuit that loops is wrong, not slow.
+pub const steps = 100_000;
+
+pub const Outcome = struct {
+    ran: u32 = 0, // cells run and right
+    steps: u64 = 0, // their steps, summed
+    wrong: ?[]const u8 = null, // the first cell that abstained, did not start or printed anything but Python's (in `why`)
+};
+
+/// Every cell when the compiler works (else none), up to the first that is wrong.
+pub fn run(a: std.mem.Allocator, fe: api.Frontend, back: api.Backend, compiler: bool, why: []u8) !Outcome {
+    var o: Outcome = .{};
+    if (!compiler) return o;
+    const stream = std.math.maxInt(u64); // no reply's (sessions count up from 1)
+    defer back.release(stream);
+    for (cells, 0..) |c, i| {
+        var arena = std.heap.ArenaAllocator.init(a);
+        defer arena.deinit();
+        const t = try fe.translate(fe.ctx, arena.allocator(), .{ .form = .fence, .lang = c.lang, .code = c.code });
+        const p = switch (t) {
+            .program => |p| p,
+            .abstain => |no| {
+                o.wrong = std.fmt.bufPrint(why, "probe cell {d} did not translate ({t}) though the compiler works", .{ i, no }) catch why;
+                return o;
+            },
+        };
+        const job = back.start(stream, p, steps) catch |e| {
+            o.wrong = std.fmt.bufPrint(why, "probe cell {d} ({t}) did not start: {t}", .{ i, p.kind, e }) catch why;
+            return o;
+        };
+        const r = wait(back, job);
+        if (r.status != .ok or !std.mem.eql(u8, r.out, c.want)) {
+            o.wrong = std.fmt.bufPrint(why, "probe cell {d} ({t}, {d} bytes) gave {t} '{f}' after {d} steps, not '{f}'", .{ i, p.kind, p.bytes.len, r.status, std.ascii.hexEscape(r.out[0..@min(r.out.len, 64)], .lower), r.steps, std.ascii.hexEscape(c.want, .lower) }) catch why;
+            return o;
+        }
+        o.ran += 1;
+        o.steps += r.steps;
+    }
+    return o;
+}
+
+fn wait(back: api.Backend, job: api.JobId) api.Result {
+    while (true) switch (back.poll(job)) {
+        .running => {
+            var ts: std.c.timespec = .{ .sec = 0, .nsec = std.time.ns_per_ms };
+            _ = std.c.nanosleep(&ts, null);
+        },
+        .done => |r| return r,
+    };
+}
+
+const gpa = std.testing.allocator;
+
+/// Every cell becomes an ELF of its code; the backend prints the cell's own want, or `out` for every cell.
+const Fake = struct {
+    out: ?[]const u8 = null,
+    which: usize = 0,
+    abstain: bool = false,
+    started: u32 = 0,
+    released: u32 = 0,
+
+    fn frontend(f: *Fake) api.Frontend {
+        return .{ .ctx = f, .translate = translate };
+    }
+    fn translate(ctx: ?*anyopaque, a: std.mem.Allocator, cell: api.Cell) std.mem.Allocator.Error!api.Translation {
+        const f: *Fake = @ptrCast(@alignCast(ctx.?));
+        if (f.abstain) return .{ .abstain = .unsupported };
+        return .{ .program = .{ .kind = .elf, .bytes = try a.dupe(u8, cell.code) } };
+    }
+    fn backend(f: *Fake) api.Backend {
+        return .{ .ctx = f, .vtable = &.{ .start = start, .poll = poll, .cancel = cancel, .release = release } };
+    }
+    fn start(ctx: *anyopaque, _: u64, p: api.Program, _: u64) error{ OutOfMemory, Busy }!api.JobId {
+        const f: *Fake = @ptrCast(@alignCast(ctx));
+        for (cells, 0..) |c, i| if (std.mem.eql(u8, c.code, p.bytes)) {
+            f.which = i;
+        };
+        f.started += 1;
+        return f.started;
+    }
+    fn poll(ctx: *anyopaque, _: api.JobId) api.Poll {
+        const f: *Fake = @ptrCast(@alignCast(ctx));
+        return .{ .done = .{ .status = .ok, .out = f.out orelse cells[f.which].want, .steps = 599 } };
+    }
+    fn cancel(_: *anyopaque, _: api.JobId) void {}
+    fn release(ctx: *anyopaque, _: u64) void {
+        const f: *Fake = @ptrCast(@alignCast(ctx));
+        f.released += 1;
+    }
+};
+
+test "runner probe: Python's output passes; a wrong value or a translation that abstains refuses; no compiler skips" {
+    var why: [256]u8 = undefined;
+    var ok: Fake = .{};
+    const got = try run(gpa, ok.frontend(), ok.backend(), true, &why);
+    try std.testing.expect(got.wrong == null and got.ran == cells.len and got.steps == 599 * cells.len);
+    try std.testing.expectEqual(@as(u32, 1), ok.released);
+    // the failure the probe exists for: a circuit (or compiler) that runs the loop to a different value
+    var wrong: Fake = .{ .out = "284\n" };
+    const bad = try run(gpa, wrong.frontend(), wrong.backend(), true, &why);
+    try std.testing.expectEqualStrings("probe cell 0 (elf, 62 bytes) gave ok '284\\x0a' after 599 steps, not '285\\x0a'", bad.wrong.?);
+    var unlinked: Fake = .{ .abstain = true };
+    const no = try run(gpa, unlinked.frontend(), unlinked.backend(), true, &why);
+    try std.testing.expectEqualStrings("probe cell 0 did not translate (unsupported) though the compiler works", no.wrong.?);
+    var none: Fake = .{ .out = "284\n" };
+    const skipped = try run(gpa, none.frontend(), none.backend(), false, &why);
+    try std.testing.expect(skipped.wrong == null and skipped.ran == 0 and none.started == 0);
+}
+
+test "runner probe: the cells on the real frontend and the circuit at TF_RUNNER_CIRCUIT (with TF_RUNNER_LLD)" {
+    const path = std.c.getenv("TF_RUNNER_CIRCUIT") orelse return error.SkipZigTest;
+    const circuit = @import("runner_circuit.zig");
+    const backend = @import("runner_circuit_backend.zig");
+    const frontend = @import("runner_frontend.zig");
+    var c = try circuit.Circuit.load(gpa, std.mem.span(path));
+    defer c.deinit(gpa);
+    const b = try backend.backend(gpa, &c, 1);
+    defer backend.destroy(b);
+    var ctx: frontend.Context = .{ .io = std.testing.io };
+    if (std.c.getenv("TF_RUNNER_LLD")) |l| ctx.compiler.linker = std.mem.span(l);
+    // with TF_RUNNER_CIRCUIT set, a host without the RV32 toolchain fails here by name, not as a missing 285
+    const compiler = try @import("runner_frontend_boot.zig").selfTest(gpa, std.testing.io, .{ .compiler = ctx.compiler });
+    if (!compiler) std.debug.print("runner probe: clang {s} with linker {s} cannot build RV32 ELF\n", .{ ctx.compiler.clang, ctx.compiler.linker orelse "-fuse-ld=lld" });
+    try std.testing.expect(compiler);
+    var why: [256]u8 = undefined;
+    const got = try run(gpa, ctx.frontend(), b, true, &why);
+    if (got.wrong) |w| std.debug.print("runner probe: {s}\n", .{w});
+    std.debug.print("runner probe: {d} probe cells = Python's output in {d} steps on {s}\n", .{ got.ran, got.steps, std.mem.span(path) });
+    try std.testing.expectEqual(@as(u32, cells.len), got.ran);
+}
