+//! Rule depths that a draft head's own stops set: a confidence floor (greedy streams) and opt-in head stops.
+const std = @import("std");
+const depth = @import("depth.zig");
+const Table = @import("table.zig").Table;
+const Rule = depth.Rule;
+const State = depth.State;
+const Who = depth.Who;
+const Probe = depth.Probe;
+
+test "under a confidence floor a greedy stream drafts the most, and a sampled one keeps its rates' depth" {
+    const gpa = std.testing.allocator;
+    const empty: Table = .{};
+    const No = struct {
+        fn copy(_: *anyopaque, _: *const Who) bool {
+            return false;
+        }
+    };
+    var unused: u8 = 0;
+    const probe: Probe = .{ .ptr = &unused, .copy = No.copy };
+    var rule: Rule = .{ .gpa = gpa, .prior = &.{ 0.5, 0.5, 0.5 }, .most_drafts = 3, .family_costs = &empty, .shared_costs = &empty, .mtp_step_ms = 0.5, .plain_guard = false, .node_probabilities = true, .confidence_floor = 0.5, .batch_rows = 8 };
+    defer rule.deinit();
+    var states: [2]?State = .{ null, null };
+    defer for (&states) |*s| if (s.*) |*x| x.deinit(gpa);
+    const greedy: Who = .{ .state = &states[0], .draft_room = 100, .finished = false, .forced = false };
+    const sampled: Who = .{ .state = &states[1], .draft_room = 100, .finished = false, .forced = false, .sampled = true };
+    try std.testing.expectEqual(@as(i64, 3), try rule.headDepth(&greedy, null, probe));
+    try std.testing.expectEqual(@as(i64, 1), try rule.headDepth(&sampled, null, probe)); // a first rate under 0.8: one draft
+}
+
+test "head stops: every ask is the room's most while few streams are live, the rates' depth above that" {
+    const gpa = std.testing.allocator;
+    const empty: Table = .{};
+    const No = struct {
+        fn copy(_: *anyopaque, _: *const Who) bool {
+            return false;
+        }
+    };
+    var unused: u8 = 0;
+    const probe: Probe = .{ .ptr = &unused, .copy = No.copy };
+    var rule: Rule = .{ .gpa = gpa, .prior = &.{ 0.5, 0.5, 0.5 }, .most_drafts = 3, .family_costs = &empty, .shared_costs = &empty, .mtp_step_ms = 0.5, .plain_guard = false, .node_probabilities = false, .head_stops = true, .head_stops_most = 2, .batch_rows = 8 };
+    defer rule.deinit();
+    var states: [2]?State = .{ null, null };
+    defer for (&states) |*s| if (s.*) |*x| x.deinit(gpa);
+    var whos = [_]Who{ .{ .state = &states[0], .draft_room = 100, .finished = false, .forced = false }, .{ .state = &states[1], .draft_room = 3, .finished = false, .forced = false, .sampled = true } };
+    var out: [2]i64 = undefined;
+    rule.live = 2;
+    try std.testing.expect(rule.stopsNow());
+    try std.testing.expectEqual(@as(i64, 3), try rule.depth(whos[0]));
+    try rule.budgets(&whos, probe, true, &out);
+    try std.testing.expectEqualSlices(i64, &.{ 3, 2 }, &out); // the room caps the second: draft_room 3 holds 2 drafts
+    rule.live = 3; // past head_stops_most: the rates' rule (a first rate under 0.8 asks one draft)
+    try std.testing.expect(!rule.stopsNow());
+    try std.testing.expectEqual(@as(i64, 1), try rule.depth(whos[0]));
+    rule.head_stops = false;
+    rule.live = 1;
+    try std.testing.expect(!rule.stopsNow());
+}
diff --git a/zig/src/core/lanes/join_batch.zig b/zig/src/core/lanes/join_batch.zig
new file mode 100644
index 000000000..ce4c78cd5
--- /dev/null
+++ b/zig/src/core/lanes/join_batch.zig
@@ -0,0 +1,86 @@
+//! Config.join_batch (opt-in): a joiner's first token goes out at once, its first drafts with the next step's batch.
+const std = @import("std");
+const Engine = @import("engine.zig").Engine;
+const be = @import("backend.zig");
+const Stream = @import("stream.zig").Stream;
+const ev = @import("events.zig");
+const win = @import("windows.zig");
+const trail = @import("trail.zig");
+const LogRow = @import("logprob.zig").Row;
+const f = ev.f;
+const str = trail.str;
+const int = trail.int;
+
+/// Whether `s` opens this way: join_batch on, and a drafting stream with the family's head.
+pub fn joins(e: *const Engine, s: *const Stream) bool {
+    return e.cfg.join_batch and e.cfg.family_mtp and s.drafts;
+}
+
+/// After the prompt pass: the first token drawn and committed, no drafts yet; the stream joins the rounds.
+pub fn opened(e: *Engine, s: *Stream, hook: ?be.Committed) !void {
+    if (s.isCancelled()) { // cancelled in its last chunk: no first token
+        e.backend.release(s);
+        return error.Cancelled;
+    }
+    try e.live.ensureUnusedCapacity(e.gpa, 1);
+    s.context.shrinkRetainingCapacity(s.prompt_len);
+    s.rows.clearRetainingCapacity();
+    s.pending = null;
+    s.cache_len = s.prompt_len;
+    const position: u64 = s.prompt_len;
+    const drawn = try e.drawFirst(s, position);
+    var feed: be.Feed = .{ .handle = drawn };
+    if (try e.forcedNext(s)) |t| feed = .{ .value = t };
+    const value = try e.readFeed(feed);
+    if (e.log != null) {
+        const actual = if (feed == .handle) value else try e.backend.read(drawn);
+        try trail.event(e, &.{ f("ev", str("first")), f("stream", str(s.id)), f("position", int(position)), f("drawn", int(actual)), f("token", int(value)) });
+    }
+    var row: [1]LogRow = undefined;
+    if (s.logprobs != null) row[0] = (try e.backend.firstRow(s)).forToken(value);
+    _ = try s.commit(e.gpa, &.{value}, if (s.logprobs != null) &row else &.{});
+    s.pending = value;
+    s.dropHeld(e.gpa);
+    if (s.finished) {
+        {
+            defer e.release(s); // the host will not discard a finished stream if tracing fails
+            try trail.resolve(e);
+            try trail.finish(e, s);
+        }
+        if (hook) |h| h.call(h.ptr);
+        return;
+    }
+    try trail.resolve(e);
+    s.join_draft = true; // its first drafts come with the next step's other joiners (`step`)
+    e.live.appendAssumeCapacity(s);
+    if (hook) |h| h.call(h.ptr);
+}
+
+/// A step's start: head stops' live count, then every joiner's first drafts in batches of a head step's streams.
+pub fn step(e: *Engine) !void {
+    e.rule.live = e.live.items.len;
+    if (!e.cfg.join_batch) return;
+    var reqs: std.ArrayList(be.DraftRequest) = .empty;
+    defer reqs.deinit(e.gpa);
+    for (e.live.items) |s| {
+        if (!s.join_draft) continue;
+        s.join_draft = false;
+        if (s.finished or s.paused) continue;
+        const d: u32 = @intCast(try e.rule.depth(win.who(s)));
+        try reqs.append(e.gpa, .{ .stream = s, .follow = &.{}, .first = .{ .value = s.pending.? }, .rows = null, .start = s.prompt_len, .position = s.prompt_len + 1, .depth = d });
+    }
+    if (reqs.items.len == 0) return;
+    const per: usize = @max(1, e.cfg.batch_streams);
+    var at: usize = 0;
+    while (at < reqs.items.len) : (at += per) try e.backend.draft(reqs.items[at..@min(reqs.items.len, at + per)]);
+    for (reqs.items) |r| {
+        const s = r.stream;
+        s.dropHeld(e.gpa);
+        s.next = .{ .count = r.depth };
+        // the drafts the head holds (its stop rule may end the chain short of the ask), as askDrafts reads them
+        if (e.backend.vtable.tree) |tree| if (try tree(e.backend.ptr, s, e.gpa)) |held| {
+            s.next = held;
+        };
+        try trail.event(e, &.{ f("ev", str("draft")), f("stream", str(s.id)), f("depth", int(r.depth)), f("position", int(r.position)), f("follow", .{ .u32s = &.{s.pending.?} }), f("rows", .null) });
+    }
+}
diff --git a/zig/src/core/lanes/join_batch_test.zig b/zig/src/core/lanes/join_batch_test.zig
new file mode 100644
index 000000000..2c5870d9d
--- /dev/null
+++ b/zig/src/core/lanes/join_batch_test.zig
@@ -0,0 +1,45 @@
+//! Config.join_batch: prompts admitted together draft their first drafts in one batch at the next step, same tokens.
+const std = @import("std");
+const Engine = @import("engine.zig").Engine;
+const Config = @import("config.zig").Config;
+const sm = @import("stream.zig");
+const fake = @import("fake.zig");
+const a = std.testing.allocator;
+const prompts = [_][]const u32{ &.{ 3, 1, 4 }, &.{ 1, 5, 9, 2 }, &.{ 6, 5 } };
+
+const Run = struct { tokens: [3][8]u32 = @splat(@splat(0)), at_open: usize = 0, first_batch: usize = 0 };
+
+fn run(join: bool) !Run {
+    var target: fake.Fake = .{ .gpa = a };
+    defer target.deinit();
+    var cfg = try Config.init(a, .{ .exact_width = 8, .hidden_rows = true, .mtp = true, .speculate = true, .drafts = 7, .draft_streams = true, .join_batch = join }, 8, 7);
+    defer cfg.deinit(a);
+    var clock: fake.FixedClock = .{};
+    var e = Engine.init(a, &cfg, target.batched(), clock.clock());
+    defer e.deinit();
+    var ss: [3]sm.Stream = undefined;
+    for (&ss, prompts) |*s, p| s.* = try sm.Stream.init(a, .{ .id = "s", .prompt = p, .max_new = 8 });
+    defer for (&ss) |*s| s.deinit(a);
+    const ptrs = [_]*sm.Stream{ &ss[0], &ss[1], &ss[2] };
+    var errs: [3]?anyerror = undefined;
+    var done: [3]bool = undefined;
+    e.addStreams(&ptrs, &errs, &done);
+    for (errs) |x| if (x) |err| return err;
+    var r: Run = .{ .at_open = target.drafts_calls };
+    for (ss) |s| try std.testing.expectEqual(@as(usize, 1), s.emitted().len); // every first token is out
+    try e.step();
+    r.first_batch = target.drafts_most;
+    var steps: usize = 0;
+    while (e.activeCount() > 0 and steps < 200) : (steps += 1) try e.step();
+    for (&ss, &r.tokens) |*s, *out| @memcpy(out[0..s.emitted().len], s.emitted());
+    return r;
+}
+
+test "join batch: no first drafts at open, then one batch for every joiner; the tokens are unchanged" {
+    const plain = try run(false);
+    const joined = try run(true);
+    try std.testing.expectEqual(@as(usize, 3), plain.at_open); // one head call a stream as it opens
+    try std.testing.expectEqual(@as(usize, 0), joined.at_open);
+    try std.testing.expect(joined.first_batch >= 3); // the three joiners' first drafts in one call
+    for (plain.tokens, joined.tokens) |p, j| try std.testing.expectEqualSlices(u32, &p, &j);
+}
