+    /// moe.router: logits [M, E + 1] fp32 = x [M, D] . rows (the router's E rows, then the shared expert's gate).
+    pub fn router(t: Tri, x: u64, x_stride: usize, rows_w: u64, out: u64, m: usize, d: usize, ne: usize) !void {
