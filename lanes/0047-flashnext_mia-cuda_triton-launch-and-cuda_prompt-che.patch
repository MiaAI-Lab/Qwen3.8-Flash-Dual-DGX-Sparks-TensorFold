-fn fillBuf(gpa: std.mem.Allocator, buf: cuda.DeviceBuffer, count: usize, r: std.Random, fill: Fill) !void {
-    const h = try gpa.alloc(u16, count);
-    defer gpa.free(h);
-    for (h, 0..) |*v, i| v.* = sample(r, fill, i);
-    try buf.upload(0, std.mem.sliceAsBytes(h));
