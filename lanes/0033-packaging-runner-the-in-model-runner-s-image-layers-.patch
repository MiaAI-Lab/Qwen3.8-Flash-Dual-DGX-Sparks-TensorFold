--- /dev/null
+++ b/packaging/runner/assets.Dockerfile
@@ -0,0 +1,10 @@
+# The runner's assets over an image build.sh layered (the circuit frontend: clang-18 / lld-18 and
+# tf-runner-frontend-check), supplied by build-assets.sh: the runner circuit and the graph bank assets.sha256 pins.
+# It adds no engine binary, and the build fails unless the image's circuit route computes the engine's probe cells.
+ARG BASE_IMAGE
+FROM ${BASE_IMAGE}
+COPY runner/calc.tfpc /opt/tensorfold/share/runner/calc.tfpc
+COPY runner/graph-v7-powmod/bank/ /opt/tensorfold/share/runner/graph-v7-powmod/bank/
+COPY runner/graph-v7-powmod/bank/Qwenputer-MIT.txt /opt/tensorfold/licenses/runtime-deps/Qwenputer-MIT.txt
+RUN nice -n 19 /opt/tensorfold/bin/tf-runner-frontend-check --require --circuit /opt/tensorfold/share/runner/calc.tfpc
+LABEL org.tensorfold.runner.circuit="calc.tfpc" org.tensorfold.runner.graph="graph-v7-powmod"
diff --git a/packaging/runner/assets.py b/packaging/runner/assets.py
new file mode 100755
index 000000000..e1ad52489
--- /dev/null
+++ b/packaging/runner/assets.py
@@ -0,0 +1,156 @@
+#!/usr/bin/env python3
+"""The in-model runner's assets: `check DIR` compares a directory with assets.sha256 (exactly the listed files, each at
+its sha256); `fetch DIR` downloads the archive assets.release names into an empty DIR, checks its sha256, unpacks it and
+checks every file. Any failure names the file and the URL."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import os
+from pathlib import Path, PurePosixPath
+import sys
+import tarfile
+import time
+import urllib.error
+import urllib.request
+
+HERE = Path(__file__).resolve().parent
+RELEASE = HERE / 'assets.release'
+MANIFEST = HERE / 'assets.sha256'
+
+
+class AssetError(Exception):
+    pass
+
+
+def release(path=RELEASE):
+    """The archive's `url` and `sha256` (one `key value` per line; # comments)."""
+    fields = {}
+    for line in path.read_text().splitlines():
+        if line.strip() and not line.startswith('#'):
+            key, _, value = line.partition(' ')
+            fields[key] = value.strip()
+    url, digest = fields.get('url', ''), fields.get('sha256', '')
+    if not url.startswith('https://') or len(digest) != 64 or any(c not in '0123456789abcdef' for c in digest):
+        raise AssetError(f'{path.name} must hold an https url and a 64-digit sha256')
+    return url, digest
+
+
+def listed(manifest=MANIFEST):
+    pins = {}
+    for line in manifest.read_text().splitlines():
+        if not line or line.startswith('#'):
+            continue
+        digest, _, name = line.partition('  ')
+        if len(digest) != 64 or not name or name in pins or name.startswith('/') or '..' in PurePosixPath(name).parts:
+            raise ValueError(f'bad manifest line: {line}')
+        pins[name] = digest
+    return pins
+
+
+def sha256(path):
+    with path.open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+
+def found(root):
+    files = {}
+    for path in sorted(root.rglob('*')):
+        if path.is_symlink() or not (path.is_file() or path.is_dir()):
+            raise ValueError(f'not a regular file: {path.relative_to(root)}')
+        if path.is_file():
+            files[path.relative_to(root).as_posix()] = sha256(path)
+    return files
+
+
+def check(root, manifest=MANIFEST):
+    pins, files = listed(manifest), found(root)
+    problems = [f'missing {n}' for n in sorted(pins.keys() - files.keys())]
+    problems += [f'unlisted {n}' for n in sorted(files.keys() - pins.keys())]
+    problems += [f'sha256 differs {n}' for n in sorted(pins.keys() & files.keys()) if pins[n] != files[n]]
+    return problems
+
+
+def download(url, dest, attempts=3, timeout=120):
+    last = None
+    for attempt in range(attempts):
+        try:
+            with urllib.request.urlopen(url, timeout=timeout) as response, dest.open('wb') as out:
+                while chunk := response.read(1 << 20):
+                    out.write(chunk)
+            return
+        except (urllib.error.URLError, OSError) as error:
+            last = error
+            time.sleep(2 * (attempt + 1))
+    raise AssetError(f'cannot download {PurePosixPath(url).name} from {url}: {last}')
+
+
+def keep_dir_mode(member, path):
+    """tarfile's 'data' filter, keeping the archive's directory modes: it leaves them to the umask, and the image layer
+    would then differ between builders."""
+    kept = tarfile.data_filter(member, path)
+    return kept.replace(mode=member.mode & 0o755, deep=False) if member.isdir() else kept
+
+
+def unpack(archive, dest, url):
+    """Only plain files and directories under relative names; anything else stops before a byte is written there."""
+    try:
+        with tarfile.open(archive, 'r:gz') as tar:
+            members = tar.getmembers()
+            for m in members:
+                if not (m.isfile() or m.isdir()) or m.name.startswith('/') or '..' in PurePosixPath(m.name).parts:
+                    raise AssetError(f'{archive.name} from {url} holds an unsafe entry: {m.name}')
+            tar.extractall(dest, members=members, filter=keep_dir_mode)
+    except tarfile.TarError as error:
+        raise AssetError(f'cannot unpack {archive.name} from {url}: {error}') from error
+
+
+def fetch(dest, release_path=RELEASE, manifest=MANIFEST, archive=None):
+    url, digest = release(release_path)
+    url = os.environ.get('RUNNER_ASSETS_URL') or url  # a mirror must serve the same bytes (same sha256)
+    dest.mkdir(parents=True, exist_ok=True)
+    if any(dest.iterdir()):
+        raise AssetError(f'{dest} must be empty')
+    name = PurePosixPath(url).name
+    local = Path(archive) if archive else dest.parent / f'.{dest.name}-{name}'
+    try:
+        if not archive:
+            print(f'runner assets: downloading {name} from {url}')
+            download(url, local)
+        got = sha256(local)
+        if got != digest:
+            raise AssetError(f'sha256 mismatch for {name} from {url}: expected {digest}, got {got}')
+        unpack(local, dest, url)
+    finally:
+        if not archive and local.exists():
+            local.unlink()
+    problems = check(dest, manifest)
+    if problems:
+        raise AssetError('; '.join(problems) + f' (in {name} from {url}; expected by {manifest.name})')
+    print(f'runner assets: {name} sha256 {digest} ok, {len(listed(manifest))} files match {manifest.name}')
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('action', choices=('check', 'fetch'))
+    parser.add_argument('dest', type=Path, help='check: the asset directory; fetch: an empty or new directory')
+    parser.add_argument('--archive', help='fetch: an already downloaded archive (offline); still sha256-checked')
+    args = parser.parse_args(argv)
+    try:
+        if args.action == 'fetch':
+            fetch(args.dest, archive=args.archive)
+            return 0
+        problems = check(args.dest)
+    except (AssetError, OSError, ValueError) as error:
+        print(f'runner assets: {error}', file=sys.stderr)
+        return 2 if args.action == 'check' else 1
+    for problem in problems:
+        print(f'runner assets: {problem}', file=sys.stderr)
+    if problems:
+        return 1
+    print(f'runner assets: {len(listed())} files match {MANIFEST.name}')
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
