     if (room < 1) return error.PromptPastWindow;
     const count = @max(1, @min(max_tokens, @as(usize, @intCast(room))));
@@ -794,7 +794,7 @@ fn gate(gpa: Allocator, io: std.Io, e: *Engine, capture: []const u8, o: Options)
 const MediaCase = struct {
