+pub fn generateMedia(gpa: Allocator, io: std.Io, e: *Engine, prompt: []const u32, max_tokens: usize, sampling: ?lanes.Sampling, drafts: bool, stop_eos: bool, media: ?*const flashnext.media.Media) !Generated {
