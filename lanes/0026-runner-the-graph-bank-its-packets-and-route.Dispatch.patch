+//! Request-owned states retain allocations between template invocations over immutable circuit weights.
+const std = @import("std");
+const State = @import("steps_v1/runner_circuit_state.zig").State;
+const Template = @import("runner_graph_bank.zig").Template;
+
+pub const Cache = struct {
+    entries: std.ArrayList(Entry) = .empty,
+
+    const Entry = struct { template: *const Template, state: State };
+
+    pub fn deinit(c: *Cache, a: std.mem.Allocator) void {
+        for (c.entries.items) |*e| e.state.deinit();
+        c.entries.deinit(a);
+        c.* = .{};
+    }
+
+    /// The returned pointer stays valid until the next get; callers release it with reset on every exit.
+    pub fn get(c: *Cache, a: std.mem.Allocator, t: *const Template) !*State {
+        try t.prepare();
+        for (c.entries.items) |*e| if (e.template == t) return &e.state;
+        try c.entries.ensureUnusedCapacity(a, 1);
+        const state = try State.init(a, &t.circuit);
+        c.entries.appendAssumeCapacity(.{ .template = t, .state = state });
+        return &c.entries.items[c.entries.items.len - 1].state;
+    }
+};
+
+/// Restores all persistent steps-v1 state, including host-owned copies of originally shared tables.
+pub fn reset(s: *State) void {
+    for (s.circuit.tables, s.tables, s.owned, s.present) |table, rows, owned, *present| {
+        if (owned) @memcpy(rows, table.rows);
+        present.* = table.present;
+    }
+    @memset(s.history, 0);
+    @memset(s.x, 0);
+    @memset(s.seen, false);
+    s.active.clearRetainingCapacity();
+    s.steps = 0;
+    @memset(s.work, 0);
+}
diff --git a/zig/src/core/runner_graph_table.zig b/zig/src/core/runner_graph_table.zig
new file mode 100644
index 000000000..051bdbfdd
--- /dev/null
+++ b/zig/src/core/runner_graph_table.zig
@@ -0,0 +1,209 @@
+//! <prefix>_BACKEND=graph: the frontend's checked integer script (its DAG and formatted outputs) as packets.
+const std = @import("std");
+const graph = @import("runner_graph.zig");
+const route = @import("runner_graph_route.zig");
+const prog = @import("runner_graph_program.zig");
+const packet = @import("runner_graph_packet.zig");
+const ast = @import("runner_frontend_integer_ast.zig");
+const integer = @import("runner_frontend_integer.zig");
+const Allocator = std.mem.Allocator;
+
+/// Pieces a sequence may hold (a printed tuple is five: its text and its two values).
+const max_pieces = 40;
+/// Calc input a piece may expand to: the DAG's shared nodes repeat in each print that uses them.
+const max_expr = 8192;
+
+/// A whole Python script the frontend checks (integer, exact Fraction, fixed Decimal) as graph bytes; null: other.
+pub fn translate(a: Allocator, bank: *const graph.Bank, code: []const u8) Allocator.Error!?[]u8 {
+    if (std.mem.indexOfScalar(u8, code, 0) != null) return null;
+    const lowerings = .{ @import("runner_frontend_integer_python.zig"), @import("runner_frontend_decimal.zig"), @import("runner_frontend_fraction.zig") };
+    inline for (lowerings) |l| if (try l.lowerWithCost(a, code, 0)) |lowered| {
+        a.free(lowered.source);
+        return lower(a, bank, &(lowered.table orelse return null));
+    };
+    return null;
+}
+
+/// The outputs in order, each a piece (`I` integer, `B` bool, `F` integral float, `1`..`6` fixed scale, `L` text).
+pub fn lower(a: Allocator, bank: *const graph.Bank, t: *const integer.Table) Allocator.Error!?[]u8 {
+    var arena_state = std.heap.ArenaAllocator.init(a);
+    defer arena_state.deinit();
+    const arena = arena_state.allocator();
+    var e: Emit = .{ .arena = arena, .bank = bank, .t = t };
+    for (t.roots[0..t.outputs], t.endings[0..t.outputs], t.styles[0..t.outputs], t.scales[0..t.outputs], t.brackets[0..t.outputs]) |root, end, style, scale, bracket| {
+        const closes = bracket & 2 != 0;
+        // a printed list: `[` J, each value J with `, ` J between, `]` with the print's own separator
+        const outer: u8 = if (end == ' ') 'S' else if (end == '\n') 'N' else if (end == ',' and !closes) 'J' else return null;
+        const sep: u8 = if (bracket != 0 or end == ',') 'J' else outer;
+        if (root >= t.count or bracket > 3) return null;
+        const n = t.nodes[root];
+        if (bracket != 0 or end == ',') {
+            if (n.op == .divmod or style != 0) return null;
+            if (bracket & 1 != 0) try e.text('J', "[");
+            if (!try e.value(if (boolean(n.op)) 'B' else 'I', 'J', try e.render(root))) return null;
+            if (closes) try e.text(outer, "]") else try e.text('J', ", ");
+            continue;
+        }
+        if (style != 0 and (n.op == .divmod or boolean(n.op))) return null;
+        if (style > 2 or scale > 6) return null;
+        if (n.op == .divmod) {
+            // Python prints the pair as a tuple: (q, r)
+            try e.text('J', "(");
+            if (!try e.value('I', 'J', try e.expr(n.l, n.r, "//"))) return null;
+            try e.text('J', ", ");
+            if (!try e.value('I', 'J', try e.expr(n.l, n.r, "%"))) return null;
+            try e.text(sep, ")");
+            continue;
+        }
+        const kind: u8 = if (style == 2) (if (scale == 0) 'I' else '0' + scale) else if (style == 1) 'F' else if (boolean(n.op)) 'B' else 'I';
+        if (kind == 'I' or kind == 'B') if (try e.algorithm(root)) |p| {
+            try e.piece(kind, sep, p);
+            continue;
+        };
+        if (!try e.value(kind, sep, try e.render(root))) return null;
+    }
+    if (e.n == 1 and e.lone) return try a.dupe(u8, e.last);
+    return try std.mem.concat(a, u8, &.{ prog.seq_magic, e.out.items });
+}
+
+fn boolean(op: ast.Op) bool {
+    return switch (op) {
+        .eq, .ne, .lt, .le, .gt, .ge => true,
+        else => false,
+    };
+}
+
+const Emit = struct {
+    arena: Allocator,
+    bank: *const graph.Bank,
+    t: *const integer.Table,
+    out: std.ArrayList(u8) = .empty,
+    n: usize = 0,
+    lone: bool = false, // the only piece so far is one integer ending its line
+    last: []const u8 = "",
+
+    fn piece(e: *Emit, kind: u8, sep: u8, body: []const u8) Allocator.Error!void {
+        try e.out.print(e.arena, "{c}{c} {s}\n", .{ kind, sep, body });
+        e.lone = e.n == 0 and kind == 'I' and sep == 'N';
+        e.last = body;
+        e.n += 1;
+    }
+
+    fn text(e: *Emit, sep: u8, s: []const u8) Allocator.Error!void {
+        try e.piece('L', sep, s);
+    }
+
+    /// A piece computing `src` on the bank; false when it does not fit a plan (or the sequence is full).
+    fn value(e: *Emit, kind: u8, sep: u8, src: ?[]const u8) Allocator.Error!bool {
+        const s = src orelse return false;
+        if (e.n >= max_pieces) return false;
+        try e.piece(kind, sep, try route.lower(e.arena, e.bank, s) orelse return false);
+        return true;
+    }
+
+    /// One of T1's algorithm plans when the root calls it on literals: gcd, isqrt, factorial, pow(a, b, m).
+    fn algorithm(e: *Emit, root: usize) Allocator.Error!?[]const u8 {
+        const n = e.t.nodes[root];
+        const algo: packet.Algorithm, const args: []const usize = switch (n.op) {
+            .gcd => .{ .gcd, &.{ n.l, n.r } },
+            .isqrt => .{ .isqrt, &.{n.l} },
+            .factorial => .{ .factorial, &.{n.l} },
+            .powmod => .{ .powmod, &.{ n.l, n.r, n.k } },
+            else => return null,
+        };
+        var values: [3][]const u8 = undefined;
+        for (args, 0..) |arg, j| {
+            var i = arg;
+            // gcd ignores signs: gcd(abs(x), y) is gcd(x, y), and abs(x) is the frontend's gcd(x, x)
+            if (algo == .gcd and i < e.t.count and e.t.nodes[i].op == .gcd and e.t.nodes[i].l == e.t.nodes[i].r) i = e.t.nodes[i].l;
+            const v = e.literal(i) orelse return null;
+            // plans take magnitudes: gcd is sign-blind; the others leave a negative operand to the frontend
+            if (v < 0 and algo != .gcd) return null;
+            values[j] = try std.fmt.allocPrint(e.arena, "{d}", .{@abs(v)});
+        }
+        const bytes = graph.Builder.integer(e.arena, algo, values[0..args.len]) catch |err| switch (err) {
+            error.OutOfMemory => return error.OutOfMemory,
+            else => return null,
+        };
+        // only a plan this bank prepared: a missing one would abstain at run time, after the hold began
+        const at = (std.mem.indexOf(u8, bytes, "\"plan\":\"") orelse return null) + "\"plan\":\"".len;
+        const end = std.mem.indexOfScalarPos(u8, bytes, at, '"') orelse return null;
+        return if (e.bank.plan(bytes[at..end]) != null) bytes else null;
+    }
+
+    /// A literal operand, or the negation of one (`-12` is the literal's sign, not a computation).
+    fn literal(e: *Emit, i: usize) ?i512 {
+        if (i >= e.t.count) return null;
+        const n = e.t.nodes[i];
+        if (n.op == .literal) return n.value;
+        if (n.op == .neg and n.l < e.t.count and e.t.nodes[n.l].op == .literal) return -e.t.nodes[n.l].value;
+        return null;
+    }
+
+    fn expr(e: *Emit, l: usize, r: usize, op: []const u8) Allocator.Error!?[]const u8 {
+        const x = try e.render(l) orelse return null;
+        const y = try e.render(r) orelse return null;
+        return try e.join(&.{ "(", x, op, y, ")" });
+    }
+
+    fn join(e: *Emit, parts: []const []const u8) Allocator.Error!?[]const u8 {
+        const s = try std.mem.concat(e.arena, u8, parts);
+        return if (s.len > max_expr) null else s;
+    }
+
+    /// Node `i` as calc input over the script's literals; null for what calc cannot say (a call, a computed exponent).
+    fn render(e: *Emit, i: usize) Allocator.Error!?[]const u8 {
+        if (i >= e.t.count) return null;
+        const n = e.t.nodes[i];
+        return switch (n.op) {
+            // only a literal's value is read: every other node's value is the frontend's proof
+            .literal => try std.fmt.allocPrint(e.arena, "({d})", .{n.value}),
+            .neg => try e.join(&.{ "(-", try e.render(n.l) orelse return null, ")" }),
+            .add => e.expr(n.l, n.r, "+"),
+            .sub => e.expr(n.l, n.r, "-"),
+            .mul => e.expr(n.l, n.r, "*"),
+            .floor => e.expr(n.l, n.r, "//"),
+            .mod => e.expr(n.l, n.r, "%"),
+            .pow => {
+                if (n.r >= e.t.count or e.t.nodes[n.r].op != .literal or e.t.nodes[n.r].value < 0) return null;
+                return try e.join(&.{ "(", try e.render(n.l) orelse return null, ")**", try std.fmt.allocPrint(e.arena, "{d}", .{e.t.nodes[n.r].value}) });
+            },
+            // abs(x) is gcd(x, x): |x| = x * sign(x)
+            .gcd => if (n.l == n.r) e.sign(n.l, n.l, .abs) else null,
+            .eq => e.sign(n.l, n.r, .eq),
+            .ne => e.sign(n.l, n.r, .ne),
+            .lt => e.sign(n.l, n.r, .lt),
+            .le => e.sign(n.l, n.r, .le),
+            .gt => e.sign(n.l, n.r, .gt),
+            .ge => e.sign(n.l, n.r, .ge),
+            .powmod, .digits, .divmod, .isqrt, .factorial, .range_product, .digit_sum => null,
+        };
+    }
+
+    /// l vs r as 0/1 (or |l|): with d = l - r and M = 10^D above |d|, (d+M-1)//M is 1 exactly when d > 0.
+    fn sign(e: *Emit, l: usize, r: usize, how: enum { eq, ne, lt, le, gt, ge, abs }) Allocator.Error!?[]const u8 {
+        const x = try e.render(l) orelse return null;
+        const d = if (how == .abs) x else try e.join(&.{ "(", x, "-", try e.render(r) orelse return null, ")" }) orelse return null;
+        const sh = try route.shape(e.arena, d) orelse return null;
+        const digits = sh.nodes[sh.root].digits;
+        if (digits > 123) return null;
+        const m = try e.arena.alloc(u8, digits + 1);
+        m[0] = '1';
+        @memset(m[1..], '0');
+        if (how == .eq or how == .ne) {
+            // (d+M)%M is 0 only at d = 0 (operands non-negative): d read once, not twice as in pos + neg
+            const nz = try e.join(&.{ "(((", d, "+", m, ")%", m, "+", m, "-1)//", m, ")" }) orelse return null;
+            return if (how == .ne) nz else try e.join(&.{ "(1-", nz, ")" });
+        }
+        const pos = try e.join(&.{ "((", d, "+", m, "-1)//", m, ")" }) orelse return null;
+        const neg = try e.join(&.{ "((-", d, "+", m, "-1)//", m, ")" }) orelse return null;
+        return switch (how) {
+            .gt => pos,
+            .lt => neg,
+            .ge => try e.join(&.{ "(1-", neg, ")" }),
+            .le => try e.join(&.{ "(1-", pos, ")" }),
+            .eq, .ne => unreachable,
+            .abs => try e.join(&.{ "(", d, "*(", pos, "-", neg, "))" }),
+        };
+    }
+};
diff --git a/zig/src/core/runner_graph_table_test.zig b/zig/src/core/runner_graph_table_test.zig
new file mode 100644
index 000000000..3c35a8d69
--- /dev/null
+++ b/zig/src/core/runner_graph_table_test.zig
@@ -0,0 +1,219 @@
+//! A checked whole script on the graph bank (runner_graph_table.zig): Python's output, no compile, the same tokens.
+const std = @import("std");
+const api = @import("runner_api.zig");
+const graph = @import("runner_graph.zig");
+const route = @import("runner_graph_route.zig");
+const table = @import("runner_graph_table.zig");
+const integer_python = @import("runner_frontend_integer_python.zig");
+
+const gpa = std.testing.allocator;
+
+/// A graph backend that prints each packet's own text as its value: `-4` prints -4.
+const Echo = struct {
+    jobs: std.ArrayList([]u8) = .empty,
+    out: [64]u8 = undefined,
+
+    fn backend(e: *Echo) api.Backend {
+        return .{ .ctx = e, .vtable = &.{ .start = start, .poll = poll, .cancel = cancel, .release = release } };
+    }
+    fn start(ctx: *anyopaque, _: u64, p: api.Program, _: u64) error{ OutOfMemory, Busy }!api.JobId {
+        const e: *Echo = @ptrCast(@alignCast(ctx));
+        try e.jobs.append(gpa, try gpa.dupe(u8, p.bytes));
+        return e.jobs.items.len - 1;
+    }
+    fn poll(ctx: *anyopaque, job: api.JobId) api.Poll {
+        const e: *Echo = @ptrCast(@alignCast(ctx));
+        const v = std.fmt.bufPrint(&e.out, "{s}\n", .{e.jobs.items[job]}) catch unreachable;
+        return .{ .done = .{ .status = .ok, .out = v, .steps = 1 } };
+    }
+    fn cancel(_: *anyopaque, _: api.JobId) void {}
+    fn release(_: *anyopaque, _: u64) void {}
+    fn deinit(e: *Echo) void {
+        for (e.jobs.items) |j| gpa.free(j);
+        e.jobs.deinit(gpa);
+    }
+};
+
+/// A backend no test here may start (the circuit, when every program is a graph one).
+const Never = struct {
+    fn backend() api.Backend {
+        return .{ .ctx = undefined, .vtable = &.{ .start = start, .poll = poll, .cancel = cancel, .release = release } };
+    }
+    fn start(_: *anyopaque, _: u64, _: api.Program, _: u64) error{ OutOfMemory, Busy }!api.JobId {
+        return error.Busy;
+    }
+    fn poll(_: *anyopaque, _: api.JobId) api.Poll {
+        unreachable;
+    }
+    fn cancel(_: *anyopaque, _: api.JobId) void {}
+    fn release(_: *anyopaque, _: u64) void {}
+};
+
+/// The sequence's end through Dispatch, its text copied (owned by the caller).
+fn run(d: *route.Dispatch, bytes: []const u8) !struct { status: api.Status, out: []u8 } {
+    const b = d.backend();
+    const job = try b.start(1, .{ .kind = .graph, .bytes = bytes }, 50_000_000);
+    const r = while (true) switch (b.poll(job)) {
+        .running => std.Thread.yield() catch {},
+        .done => |x| break x,
+    };
+    defer b.release(1);
+    return .{ .status = r.status, .out = try gpa.dupe(u8, r.out) };
+}
+
+test "runner graph table: text pieces, integral floats and fixed scales print as the runtime does; bad pieces fault" {
+    var echo: Echo = .{};
+    defer echo.deinit();
+    var d: route.Dispatch = .{ .gpa = gpa, .circuit = Never.backend(), .graph = echo.backend() };
+    defer d.deinit();
+    const ok = try run(&d, "TFGS1\nLJ (\nIJ -4\nLJ , \nIJ 1\nLN )\nFS -21\n3S 5\n3S 123\n2S -1250\n1N -3\nBS 1\nBN 0\n");
+    defer gpa.free(ok.out);
+    try std.testing.expectEqual(api.Status.ok, ok.status);
+    try std.testing.expectEqualStrings("(-4, 1)\n-21.0 0.005 0.123 -12.50 -0.3\nTrue False\n", ok.out);
+    // negative controls: an unknown separator or kind, a bool that is not 0/1, a value that is not a number
+    for ([_][]const u8{ "TFGS1\nIX 7\n", "TFGS1\nQN 7\n", "TFGS1\nBN 7\n", "TFGS1\nFN x\n", "TFGS1\nLQ (\n" }) |bad| {
+        const r = try run(&d, bad);
+        defer gpa.free(r.out);
+        try std.testing.expectEqual(api.Status.fault, r.status);
+    }
+}
+
+test "runner graph table: the frontend's checked table keeps its outputs, endings and styles" {
+    const lowered = (try integer_python.lowerWithCost(gpa, "a=-17\nb=5\nprint(a//b, a%b)\nprint(divmod(a,b))\n", 0)).?;
+    defer gpa.free(lowered.source);
+    const t = lowered.table.?;
+    try std.testing.expectEqual(@as(usize, 3), t.outputs);
+    try std.testing.expectEqualSlices(u8, " \n\n", t.endings[0..3]);
+    try std.testing.expectEqual(.divmod, t.nodes[t.roots[2]].op);
+    for (t.nodes[0..t.count]) |n| try std.testing.expectEqualStrings("", n.text);
+}
+
+/// Whole problems T5 admits (div_big, S1 divmod, mul_big) and edges, with CPython's stdout under the lane prelude.
+const cases = [_][2][]const u8{
+    .{ "a=-23777868243178464\nb=-41832496\nprint(a//b, a%b)\nprint(a/b)\nprint(divmod(a,b))\n", "568406634 0\n568406634.0\n(568406634, 0)\n" },
+    .{ "from fractions import Fraction\nn=44253970636272\nprint(n//48, n%48)\nprint(Fraction(n,-48))\nprint(n/-48)\n", "921957721589 0\n-921957721589\n-921957721589.0\n" },
+    .{ "from fractions import Fraction\nn=-160371104\nd=932\nf=Fraction(n,d)\nprint(f, float(f))\nprint(n//d, n%d)\nimport math\nprint(math.gcd(abs(n),d))\n", "-172072 -172072.0\n-172072 0\n932\n" },
+    .{ "from fractions import Fraction\nn=32685677580\nd=-4826\nf=Fraction(n,d)\nprint(f, f.numerator, f.denominator)\nprint(n/d)\nimport math\nprint(math.gcd(n,4826))\n", "-6772830 -6772830 1\n-6772830.0\n4826\n" },
+    .{ "A = 314159265358979323846264338327950288419716939937510\nB = 271828182845904523536\nprint(divmod(A, B))\n", "(1155727349790921717910215407028, 23663814570294126502)\n" },
+    .{ "from decimal import Decimal\nprint(Decimal('-27.201')*Decimal('4952356'))\n", "-134709035.556\n" },
+    .{ "from decimal import Decimal\nprint(Decimal('562.1') * Decimal('7.691'))\n", "4323.1111\n" },
+    .{ "from decimal import Decimal\nprint(Decimal('0.002')*Decimal('3'))\nprint(Decimal('-0.5')*Decimal('0.25'))\nprint(Decimal('1.50')*Decimal('2'))\n", "0.006\n-0.125\n3.00\n" },
+    .{ "print(divmod(-7, 2))\n", "(-4, 1)\n" },
+    .{ "x=10**20\ny=10**20+1\nprint(x<y, x<=y, x>y, x>=y, x==y, x!=y)\n", "True True False False False True\n" },
+    .{ "x=10**20\ny=10**20+1\nprint(y==x, y!=x, x==x, x!=x, -y==-y, -y!=y)\n", "False True True False True True\n" },
+    .{ "from fractions import Fraction\nprint(float(Fraction(-84, 4)))\n", "-21.0\n" },
+    .{ "a=-17\nb=5\nprint(a//b, a%b, (a<b)+1)\n", "-4 3 2\n" },
+    .{ "import math\nprint(math.gcd(-12, 18), math.gcd(12, -18))\n", "6 6\n" },
+};
+
+/// Scripts the table leaves to the route behind it: a fraction, a computed divisor (T1's binding owns it), a string.
+const refused = [_][]const u8{ "print(7/2)\n", "a=3\nprint(100//(a+1))\n", "print(len(str(2**100)))\n" };
+
+fn openBank() !graph.Bank {
+    const g = std.c.getenv("TF_RUNNER_GRAPH_BANK") orelse return error.SkipZigTest;
+    return graph.Bank.load(gpa, std.mem.span(g));
+}
+
+test "runner graph table: whole problems print CPython's output on the real bank (TF_RUNNER_GRAPH_BANK)" {
+    var bank = try openBank();
+    defer bank.deinit();
+    const g = try graph.backend(gpa, &bank, 2);
+    defer graph.destroy(g);
+    var d: route.Dispatch = .{ .gpa = gpa, .circuit = Never.backend(), .graph = g };
+    defer d.deinit();
+    const has_gcd = bank.plan("gcd-16") != null;
+    for (cases) |c| {
+        // gcd needs T1's algorithm plan; a bank without it leaves the script to the frontend's route
+        if (!has_gcd and std.mem.indexOf(u8, c[0], "gcd") != null) {
+            try std.testing.expectEqual(null, try table.translate(gpa, &bank, c[0]));
+            continue;
+        }
+        const bytes = (try table.translate(gpa, &bank, c[0])) orelse {
+            std.debug.print("not on the bank: {s}\n", .{c[0]});
+            return error.TestExpectedRoute;
+        };
+        defer gpa.free(bytes);
+        const r = try run(&d, bytes);
+        defer gpa.free(r.out);
+        if (r.status != .ok or !std.mem.eql(u8, r.out, c[1])) std.debug.print("{s}: {t} '{s}'\n", .{ c[0], r.status, r.out });
+        try std.testing.expectEqual(api.Status.ok, r.status);
+        try std.testing.expectEqualStrings(c[1], r.out);
+    }
+    for (refused) |code| try std.testing.expectEqual(null, try table.translate(gpa, &bank, code));
+}
+
+test "runner graph table: the bank computes from the literals; the frontend's proof values never reach the output" {
+    var bank = try openBank();
+    defer bank.deinit();
+    const g = try graph.backend(gpa, &bank, 2);
+    defer graph.destroy(g);
+    var d: route.Dispatch = .{ .gpa = gpa, .circuit = Never.backend(), .graph = g };
+    defer d.deinit();
+    const lowered = (try @import("runner_frontend_fraction.zig").lowerWithCost(gpa, cases[1][0], 0)).?;
+    gpa.free(lowered.source);
+    var t = lowered.table.?;
+    // a wrong proof on every computed node: the output must not move
+    for (t.nodes[0..t.count]) |*n| if (n.op != .literal) {
+        n.value = 12345;
+    };
+    const same = (try table.lower(gpa, &bank, &t)).?;
+    defer gpa.free(same);
+    const r = try run(&d, same);
+    defer gpa.free(r.out);
+    try std.testing.expectEqualStrings(cases[1][1], r.out);
+    // a changed literal changes the output (n + 48): the run reads its inputs
+    for (t.nodes[0..t.count]) |*n| if (n.op == .literal and n.value == 44253970636272) {
+        n.value += 48;
+    };
+    const moved = (try table.lower(gpa, &bank, &t)).?;
+    defer gpa.free(moved);
+    const m = try run(&d, moved);
+    defer gpa.free(m.out);
+    try std.testing.expectEqualStrings("921957721590 0\n-921957721590\n-921957721590.0\n", m.out);
+}
+
+/// A frontend that counts its calls and abstains (the compile route a graph script must not reach).
+const Inner = struct {
+    calls: u32 = 0,
+    fn frontend(i: *Inner) api.Frontend {
+        return .{ .ctx = i, .translate = translate };
+    }
+    fn translate(ctx: ?*anyopaque, _: std.mem.Allocator, _: api.Cell) std.mem.Allocator.Error!api.Translation {
+        const i: *Inner = @ptrCast(@alignCast(ctx.?));
+        i.calls += 1;
+        return .{ .abstain = .unsupported };
+    }
+};
+
+test "runner graph table: Routed takes a checked fence script before the compile; earlier cells or refusals go on" {
+    var bank = try openBank();
+    defer bank.deinit();
+    var inner: Inner = .{};
+    var routed: route.Routed = .{ .inner = inner.frontend(), .bank = &bank };
+    const fe = routed.frontend();
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const t = try fe.translate(fe.ctx, a, .{ .form = .fence, .lang = "python", .code = cases[0][0] });
+    try std.testing.expect(t == .program and t.program.kind == .graph);
+    try std.testing.expectEqual(@as(u32, 0), inner.calls);
+    // a computed divisor: T1's direct binding owns it before the compile and prints CPython's 25
+    const owned = try fe.translate(fe.ctx, a, .{ .form = .fence, .lang = "python", .code = refused[1] });
+    try std.testing.expect(owned == .program and owned.program.kind == .graph);
+    try std.testing.expectEqual(@as(u32, 0), inner.calls);
+    const g = try graph.backend(gpa, &bank, 2);
+    defer graph.destroy(g);
+    var d: route.Dispatch = .{ .gpa = gpa, .circuit = Never.backend(), .graph = g };
+    defer d.deinit();
+    const r = try run(&d, owned.program.bytes);
+    defer gpa.free(r.out);
+    try std.testing.expectEqual(api.Status.ok, r.status);
+    try std.testing.expectEqualStrings("25\n", r.out);
+    // a string the bank cannot hold: no route takes it, so the frontend is asked
+    const declined = try fe.translate(fe.ctx, a, .{ .form = .fence, .lang = "python", .code = refused[2] });
+    try std.testing.expect(declined == .abstain);
+    try std.testing.expectEqual(@as(u32, 1), inner.calls);
+    // a later cell could have rebound a name the script uses: the frontend's own checks decide
+    _ = try fe.translate(fe.ctx, a, .{ .form = .fence, .lang = "python", .code = cases[0][0], .prior = &.{"divmod = max\n"} });
+    try std.testing.expectEqual(@as(u32, 2), inner.calls);
+}
