+//! Graph programs to the graph backend (a sequence's pieces side by side), calc and ELF to the circuit, by job id bits.
+const std = @import("std");
+const api = @import("runner_api.zig");
+const prog = @import("runner_graph_program.zig");
+const graph = @import("runner_graph.zig");
+const Allocator = std.mem.Allocator;
+const log = std.log.scoped(.runner_graph);
+
+pub const Dispatch = struct {
+    gpa: Allocator,
+    circuit: api.Backend,
+    graph: api.Backend,
+    /// The bank TFGS2 templates lower on; without one a template piece faults.
+    bank: ?*const graph.Bank = null,
+    seqs: std.ArrayList(*Seq) = .empty,
+    next_seq: api.JobId = 1,
+
+    const tag: api.JobId = 1 << 63;
+    const seq_tag: api.JobId = 1 << 62;
+
+    /// One line of a sequence: a bank packet, a TFGS2 template, or text ('L') printed as written; kind 0 is malformed.
+    const Piece = struct {
+        kind: u8,
+        sep: u8,
+        body: []const u8,
+        template: bool = false,
+        value: [160]u8 = undefined,
+        value_len: ?usize = null, // the run's integer output, for later templates
+        job: ?api.JobId = null,
+        done: ?api.Result = null, // its run's status and counts; the printed value is in `text`
+        text: [160]u8 = undefined,
+        len: ?usize = null, // null: the value is not one `kind` can print
+    };
+
+    const Seq = struct {
+        id: api.JobId,
+        stream: u64,
+        budget: u64,
+        pieces: []Piece,
+        next: usize = 0, // the first piece not yet printed
+        out: std.ArrayList(u8) = .empty,
+        steps: u64 = 0,
+        exec_ns: u64 = 0,
+        end: ?api.Result = null,
+        delivered: bool = false,
+        bytes: []u8,
+
+        /// Appends a piece's text and its separator (S a space, N a newline, J none); false when the run ended here.
+        fn say(q: *Seq, gpa: Allocator, text: []const u8, sep: u8) bool {
+            const end: []const u8 = switch (sep) {
+                'S' => " ",
+                'N' => "\n",
+                'J' => "",
+                else => {
+                    q.end = .{ .status = .fault, .steps = q.steps };
+                    return false;
+                },
+            };
+            q.out.appendSlice(gpa, text) catch {
+                q.end = .{ .status = .abstain, .abstain = .too_big };
+                return false;
+            };
+            q.out.appendSlice(gpa, end) catch {};
+            return true;
+        }
+    };
+
+    pub fn backend(d: *Dispatch) api.Backend {
+        return .{ .ctx = d, .vtable = &.{ .start = start, .poll = poll, .cancel = cancel, .release = release, .now = now } };
+    }
+    pub fn deinit(d: *Dispatch) void {
+        for (d.seqs.items) |q| d.free(q);
+        d.seqs.deinit(d.gpa);
+    }
+    fn stop(d: *Dispatch, q: *Seq) void {
+        for (q.pieces) |*p| if (p.job) |j| {
+            d.graph.cancel(j);
+            p.job = null;
+        };
+    }
+    fn free(d: *Dispatch, q: *Seq) void {
+        d.stop(q);
+        q.out.deinit(d.gpa);
+        d.gpa.free(q.pieces);
+        d.gpa.free(q.bytes);
+        d.gpa.destroy(q);
+    }
+    /// A stream's delivered sequences: their `out` lives until its next call.
+    fn forget(d: *Dispatch, stream: u64, all: bool) void {
+        var i: usize = 0;
+        while (i < d.seqs.items.len) {
+            const q = d.seqs.items[i];
+            if (q.stream == stream and (all or q.delivered)) d.free(d.seqs.swapRemove(i)) else i += 1;
+        }
+    }
+    fn start(ctx: *anyopaque, stream: u64, p: api.Program, budget: u64) error{ OutOfMemory, Busy }!api.JobId {
+        const d: *Dispatch = @ptrCast(@alignCast(ctx));
+        if (p.kind != .graph) return d.circuit.start(stream, p, budget);
+        if (!std.mem.startsWith(u8, p.bytes, "TFGS")) return tag | try d.graph.start(stream, p, budget);
+        const v2 = std.mem.startsWith(u8, p.bytes, prog.seq_magic_v2);
+        const known = v2 or std.mem.startsWith(u8, p.bytes, prog.seq_magic);
+        // a sequence version this runner does not know faults where it would otherwise be read wrong
+        if (!known) log.warn("graph sequence {s}: unknown version, refused", .{p.bytes[0..@min(p.bytes.len, 6)]});
+        d.forget(stream, false);
+        const q = try d.gpa.create(Seq);
+        errdefer d.gpa.destroy(q);
+        const bytes = try d.gpa.dupe(u8, p.bytes);
+        errdefer d.gpa.free(bytes);
+        const pieces = try split(d.gpa, if (known) bytes[prog.seq_magic.len..] else "", v2);
+        errdefer d.gpa.free(pieces);
+        q.* = .{ .id = d.next_seq, .stream = stream, .budget = budget, .pieces = pieces, .bytes = bytes };
+        if (!known) q.end = .{ .status = .fault };
+        try d.seqs.append(d.gpa, q);
+        d.next_seq += 1;
+        d.step(q);
+        return seq_tag | q.id;
+    }
+    /// A sequence's lines (`<kind><sep> <body>\n`); text after the last newline is not a piece.
+    fn split(gpa: Allocator, lines: []const u8, v2: bool) Allocator.Error![]Piece {
+        const n = std.mem.count(u8, lines, "\n");
+        const pieces = try gpa.alloc(Piece, n);
+        var it = std.mem.splitScalar(u8, lines, '\n');
+        for (pieces) |*p| {
+            const line = it.next().?;
+            p.* = if (line.len < 4 or line[2] != ' ') .{ .kind = 0, .sep = 0, .body = "" } else .{ .kind = line[0], .sep = line[1], .body = line[3..] };
+            p.template = v2 and p.kind != 'L' and p.body[0] == '@';
+        }
+        return pieces;
+    }
+    /// Collects, starts what workers allow, prints in order; ends at the last piece or the first (in order) not ok.
+    fn step(d: *Dispatch, q: *Seq) void {
+        d.collect(q);
+        d.launch(q);
+        while (q.end == null) {
+            if (q.next == q.pieces.len) {
+                q.end = .{ .status = .ok, .out = q.out.items, .steps = q.steps, .exec_ns = q.exec_ns };
+                break;
+            }
+            const p = &q.pieces[q.next];
+            if (p.kind == 0) {
+                q.end = .{ .status = .fault, .steps = q.steps };
+                break;
+            }
+            if (p.kind == 'L') {
+                q.next += 1;
+                if (!q.say(d.gpa, p.body, p.sep)) break;
+                continue;
+            }
+            const r = p.done orelse return;
+            q.next += 1;
+            q.steps += r.steps;
+            q.exec_ns += r.exec_ns;
+            // a piece run beside earlier ones had the whole budget; in turn it would have had what they left
+            if (r.status == .ok and q.steps > q.budget) {
+                q.end = .{ .status = .budget, .steps = q.budget, .exec_ns = q.exec_ns };
+                break;
+            }
+            if (r.status != .ok) {
+                q.end = .{ .status = r.status, .abstain = r.abstain, .steps = @min(q.steps, q.budget), .exec_ns = q.exec_ns };
+                break;
+            }
+            const len = p.len orelse {
+                q.end = .{ .status = .fault, .steps = q.steps };
+                break;
+            };
+            if (!q.say(d.gpa, p.text[0..len], p.sep)) break;
+        }
+        d.stop(q);
+    }
+    /// Polls every running piece; a finished piece's value is copied out at once (the backend frees it next call).
+    fn collect(d: *Dispatch, q: *Seq) void {
+        for (q.pieces[q.next..]) |*p| if (p.job) |j| switch (d.graph.poll(j)) {
+            .running => {},
+            .done => |r| {
+                p.job = null;
+                p.done = r;
+                p.done.?.out = "";
+                const v = std.mem.trimEnd(u8, r.out, "\n");
+                if (r.status == .ok) if (format(p.kind, v, &p.text)) |text| {
+                    p.len = text.len;
+                };
+                if (r.status == .ok and p.kind == 'I' and p.len != null and v.len <= p.value.len) {
+                    @memcpy(p.value[0..v.len], v);
+                    p.value_len = v.len;
+                }
+            },
+        };
+    }
+    /// Starts waiting pieces, largest packet first, until the graph backend is busy: the longest runs set the time.
+    fn launch(d: *Dispatch, q: *Seq) void {
+        if (q.end != null) return;
+        while (true) {
+            var best: ?*Piece = null;
+            for (q.pieces[q.next..], q.next..) |*p, i| {
+                if (p.kind == 0 or p.kind == 'L' or p.job != null or p.done != null) continue;
+                if (p.template and !d.ready(q, i)) continue;
+                if (best == null or p.body.len > best.?.body.len) best = p;
+            }
+            const p = best orelse return;
+            if (p.template) switch (d.bind(q, p)) {
+                .started, .ended => {},
+                .busy => return,
+            } else p.job = d.graph.start(q.stream, .{ .kind = .graph, .bytes = p.body }, q.budget) catch return;
+        }
+    }
+    /// Whether every piece template `i` reads has its value (a missing one ends the run before `i` prints).
+    fn ready(_: *Dispatch, q: *Seq, i: usize) bool {
+        var it = std.mem.splitScalar(u8, q.pieces[i].body, '$');
+        _ = it.next();
+        while (it.next()) |rest| {
+            var n: usize = 0;
+            while (n < rest.len and std.ascii.isDigit(rest[n])) n += 1;
+            const k = std.fmt.parseInt(usize, rest[0..n], 10) catch return true;
+            // a reference to itself or a later piece is malformed: bind reports it
+            if (k >= i) return true;
+            if (q.pieces[k].value_len == null) return false;
+        }
+        return true;
+    }
+    /// Lowers a ready template on the bank and starts it; ended: it is done without a job (no bank, or no packet).
+    fn bind(d: *Dispatch, q: *Seq, p: *Piece) enum { started, ended, busy } {
+        const bank = d.bank orelse {
+            log.warn("graph sequence template without a bank", .{});
+            p.done = .{ .status = .fault };
+            return .ended;
+        };
+        var arena_state = std.heap.ArenaAllocator.init(d.gpa);
+        defer arena_state.deinit();
+        const arena = arena_state.allocator();
+        const values = arena.alloc(?[]const u8, q.pieces.len) catch return .busy;
+        for (q.pieces, values) |*o, *v| v.* = if (o != p and o.value_len != null) o.value[0..o.value_len.?] else null;
+        const bytes = (prog.bind(arena, bank, p.body, values) catch return .busy) orelse {
+            p.done = .{ .status = .abstain, .abstain = .unsupported };
+            return .ended;
+        };
+        p.job = d.graph.start(q.stream, .{ .kind = .graph, .bytes = bytes }, q.budget) catch return .busy;
+        return .started;
+    }
+    /// A piece's printed value: I as is, B as Python's bool, F with `.0`, `1`..`6` at that fixed Decimal scale.
+    fn format(kind: u8, v: []const u8, buf: []u8) ?[]const u8 {
+        const digits = v[@intFromBool(v.len > 0 and v[0] == '-')..];
+        if (digits.len == 0 or digits.len + 3 > buf.len) return null;
+        for (digits) |c| if (!std.ascii.isDigit(c)) return null;
+        return switch (kind) {
+            'I' => blk: {
+                @memcpy(buf[0..v.len], v);
+                break :blk buf[0..v.len];
+            },
+            // a comparison's graph prints 1 or 0
+            'B' => if (std.mem.eql(u8, v, "1")) copy(buf, "True") else if (std.mem.eql(u8, v, "0")) copy(buf, "False") else null,
+            'F' => std.fmt.bufPrint(buf, "{s}.0", .{v}) catch null,
+            '1'...'6' => fixed(v, kind - '0', buf),
+            else => null,
+        };
+    }
+    fn copy(buf: []u8, s: []const u8) []const u8 {
+        @memcpy(buf[0..s.len], s);
+        return buf[0..s.len];
+    }
+    /// Decimal's str of coefficient v at `scale` places (the runtime's tf_wfixed): 0.0042, -12.50.
+    fn fixed(v: []const u8, scale: usize, buf: []u8) ?[]const u8 {
+        const neg = v[0] == '-';
+        const digits = v[@intFromBool(neg)..];
+        var w: std.Io.Writer = .fixed(buf);
+        if (neg) w.writeByte('-') catch return null;
+        if (digits.len <= scale) {
+            w.writeAll("0.") catch return null;
+            w.splatByteAll('0', scale - digits.len) catch return null;
+            w.writeAll(digits) catch return null;
+        } else {
+            w.writeAll(digits[0 .. digits.len - scale]) catch return null;
+            w.writeByte('.') catch return null;
+            w.writeAll(digits[digits.len - scale ..]) catch return null;
+        }
+        return w.buffered();
+    }
+    fn find(d: *Dispatch, id: api.JobId) ?*Seq {
+        for (d.seqs.items) |q| if (q.id == id) return q;
+        return null;
+    }
+    fn poll(ctx: *anyopaque, job: api.JobId) api.Poll {
+        const d: *Dispatch = @ptrCast(@alignCast(ctx));
+        if (job & tag != 0) return d.graph.poll(job & ~tag);
+        if (job & seq_tag == 0) return d.circuit.poll(job);
+        const q = d.find(job & ~seq_tag) orelse return .{ .done = .{ .status = .abstain, .abstain = .unsupported } };
+        d.step(q);
+        var r = q.end orelse return .running;
+        r.out = q.out.items;
+        q.delivered = true;
+        return .{ .done = r };
+    }
+    fn cancel(ctx: *anyopaque, job: api.JobId) void {
+        const d: *Dispatch = @ptrCast(@alignCast(ctx));
+        if (job & tag != 0) return d.graph.cancel(job & ~tag);
+        if (job & seq_tag == 0) return d.circuit.cancel(job);
+        for (d.seqs.items, 0..) |q, i| if (q.id == job & ~seq_tag) {
+            d.free(d.seqs.swapRemove(i));
+            return;
+        };
+    }
+    fn release(ctx: *anyopaque, stream: u64) void {
+        const d: *Dispatch = @ptrCast(@alignCast(ctx));
+        d.forget(stream, true);
+        d.graph.release(stream);
+        d.circuit.release(stream);
+    }
+    fn now(ctx: *anyopaque, p: api.Program, budget: u64, quick: u64) ?api.Result {
+        const d: *Dispatch = @ptrCast(@alignCast(ctx));
+        // one packet only: a sequence's pieces run as jobs
+        return if (p.kind == .graph and !std.mem.startsWith(u8, p.bytes, "TFGS")) d.graph.now(p, budget, quick) else null;
+    }
+};
+
+test "runner graph route: graph programs reach the graph backend, the rest the circuit, by job id" {
+    const Fake = struct {
+        name: u8,
+        started: u32 = 0,
+        released: u32 = 0,
+        fn backend(f: *@This()) api.Backend {
+            return .{ .ctx = f, .vtable = &.{ .start = st, .poll = pl, .cancel = cn, .release = rl, .now = nw } };
+        }
+        fn st(ctx: *anyopaque, _: u64, _: api.Program, _: u64) error{ OutOfMemory, Busy }!api.JobId {
+            const f: *@This() = @ptrCast(@alignCast(ctx));
+            f.started += 1;
+            return 7;
+        }
+        fn pl(ctx: *anyopaque, job: api.JobId) api.Poll {
+            const f: *@This() = @ptrCast(@alignCast(ctx));
+            return .{ .done = .{ .status = .ok, .out = if (f.name == 'g') "graph" else "circuit", .steps = job } };
+        }
+        fn cn(_: *anyopaque, _: api.JobId) void {}
+        fn nw(ctx: *anyopaque, _: api.Program, _: u64, _: u64) ?api.Result {
+            const f: *@This() = @ptrCast(@alignCast(ctx));
+            return .{ .status = .ok, .out = if (f.name == 'g') "graph" else "circuit" };
+        }
+        fn rl(ctx: *anyopaque, _: u64) void {
+            const f: *@This() = @ptrCast(@alignCast(ctx));
+            f.released += 1;
+        }
+    };
+    var c: Fake = .{ .name = 'c' };
+    var g: Fake = .{ .name = 'g' };
+    var d: Dispatch = .{ .gpa = std.testing.allocator, .circuit = c.backend(), .graph = g.backend() };
+    const b = d.backend();
+    const gj = try b.start(1, .{ .kind = .graph, .bytes = "{}" }, 10);
+    const cj = try b.start(1, .{ .kind = .calc, .bytes = "2*3" }, 10);
+    try std.testing.expectEqualStrings("graph", b.poll(gj).done.out);
+    try std.testing.expectEqual(@as(u64, 7), b.poll(gj).done.steps);
+    try std.testing.expectEqualStrings("circuit", b.poll(cj).done.out);
+    // a run here (settling holds) is the graph backend's only
+    try std.testing.expectEqualStrings("graph", b.now(.{ .kind = .graph, .bytes = "{}" }, 10, 10).?.out);
+    try std.testing.expectEqual(null, b.now(.{ .kind = .calc, .bytes = "2*3" }, 10, 10));
+    b.release(1);
+    try std.testing.expect(c.started == 1 and g.started == 1 and c.released == 1 and g.released == 1);
+}
+
+/// A graph backend of `workers` slots: packet `v:n` prints v after n polls (`!` a budget end); start order is kept.
+const Slots = struct {
+    workers: u32,
+    jobs: [16]struct { body: []const u8 = "", left: u32 = 0, live: bool = false } = @splat(.{}),
+    started: [16][]const u8 = undefined,
+    n: u32 = 0,
+    most: u32 = 0,
+    cancelled: u32 = 0,
+
+    fn backend(f: *Slots) api.Backend {
+        return .{ .ctx = f, .vtable = &.{ .start = st, .poll = pl, .cancel = cn, .release = rl, .now = nw } };
+    }
+    fn live(f: *Slots) u32 {
+        var k: u32 = 0;
+        for (f.jobs) |j| k += @intFromBool(j.live);
+        return k;
+    }
+    fn st(ctx: *anyopaque, _: u64, p: api.Program, _: u64) error{ OutOfMemory, Busy }!api.JobId {
+        const f: *Slots = @ptrCast(@alignCast(ctx));
+        if (f.live() >= f.workers) return error.Busy;
+        const colon = std.mem.indexOfScalar(u8, p.bytes, ':').?;
+        f.jobs[f.n] = .{ .body = p.bytes[0..colon], .left = std.fmt.parseInt(u32, p.bytes[colon + 1 ..], 10) catch unreachable, .live = true };
+        f.started[f.n] = p.bytes;
+        f.n += 1;
+        f.most = @max(f.most, f.live());
+        return f.n - 1;
+    }
+    fn pl(ctx: *anyopaque, job: api.JobId) api.Poll {
+        const f: *Slots = @ptrCast(@alignCast(ctx));
+        const j = &f.jobs[@intCast(job)];
+        if (j.left > 0) {
+            j.left -= 1;
+            return .running;
+        }
+        j.live = false;
+        if (std.mem.eql(u8, j.body, "!")) return .{ .done = .{ .status = .budget, .steps = 10 } };
+        return .{ .done = .{ .status = .ok, .out = j.body, .steps = 10 } };
+    }
+    fn cn(ctx: *anyopaque, job: api.JobId) void {
+        const f: *Slots = @ptrCast(@alignCast(ctx));
+        f.jobs[@intCast(job)].live = false;
+        f.cancelled += 1;
+    }
+    fn rl(_: *anyopaque, _: u64) void {}
+    fn nw(_: *anyopaque, _: api.Program, _: u64, _: u64) ?api.Result {
+        return null;
+    }
+};
+
+fn finish(b: api.Backend, id: api.JobId) api.Result {
+    while (true) switch (b.poll(id)) {
+        .running => {},
+        .done => |r| return r,
+    };
+}
+
+test "runner graph dispatch: a sequence's pieces run side by side, largest first, and print in order as in turn" {
+    var c: Slots = .{ .workers = 1 };
+    var g: Slots = .{ .workers = 2 };
+    var d: Dispatch = .{ .gpa = std.testing.allocator, .circuit = c.backend(), .graph = g.backend() };
+    defer d.deinit();
+    const b = d.backend();
+    const r = finish(b, try b.start(1, .{ .kind = .graph, .bytes = "TFGS1\nIS 7:1\nLJ (\nIN 1155:6\nBN 1:33\n" }, 100));
+    try std.testing.expectEqual(api.Status.ok, r.status);
+    try std.testing.expectEqualStrings("7 (1155\nTrue\n", r.out);
+    try std.testing.expectEqual(@as(u64, 30), r.steps);
+    try std.testing.expectEqual(@as(u32, 2), g.most);
+    // the two largest packets went first; the smallest waited for a free worker
+    try std.testing.expectEqualStrings("1155:6", g.started[0]);
+    try std.testing.expectEqualStrings("1:33", g.started[1]);
+    try std.testing.expectEqualStrings("7:1", g.started[2]);
+    b.release(1);
+}
+
+test "runner graph dispatch: the first piece in print order that is not ok ends the run; later ones are cancelled" {
+    var c: Slots = .{ .workers = 1 };
+    var g: Slots = .{ .workers = 3 };
+    var d: Dispatch = .{ .gpa = std.testing.allocator, .circuit = c.backend(), .graph = g.backend() };
+    defer d.deinit();
+    const b = d.backend();
+    const r = finish(b, try b.start(1, .{ .kind = .graph, .bytes = "TFGS1\nIS 7:0\nIN !:0\nIN 123456:9\n" }, 100));
+    try std.testing.expectEqual(api.Status.budget, r.status);
+    try std.testing.expectEqualStrings("7 ", r.out);
+    try std.testing.expectEqual(@as(u32, 1), g.cancelled);
+    try std.testing.expectEqual(@as(u32, 0), g.live());
+    // pieces that each fit but together pass the budget end as a budget, as they would have in turn
+    const over = finish(b, try b.start(2, .{ .kind = .graph, .bytes = "TFGS1\nIS 1:0\nIS 2:0\nIN 3:0\n" }, 25));
+    try std.testing.expectEqual(api.Status.budget, over.status);
+    try std.testing.expectEqualStrings("1 2 ", over.out);
+    // a malformed line is a fault where it is reached; the value a kind cannot print is one too
+    try std.testing.expectEqual(api.Status.fault, finish(b, try b.start(3, .{ .kind = .graph, .bytes = "TFGS1\nIS 1:0\nbad\n" }, 100)).status);
+    try std.testing.expectEqual(api.Status.fault, finish(b, try b.start(4, .{ .kind = .graph, .bytes = "TFGS1\nBN 7:0\n" }, 100)).status);
+    b.release(1);
+    b.release(2);
+}
+
+test "runner graph dispatch: a TFGS2 template waits for the piece it reads; no bank or an unknown version faults" {
+    var c: Slots = .{ .workers = 1 };
+    var g: Slots = .{ .workers = 2 };
+    var d: Dispatch = .{ .gpa = std.testing.allocator, .circuit = c.backend(), .graph = g.backend() };
+    defer d.deinit();
+    const b = d.backend();
+    const id = try b.start(1, .{ .kind = .graph, .bytes = "TFGS2\nIS 7:2\nBN @=$0;7\n" }, 100);
+    // two workers, yet only the read piece runs: the template has no value to bind until it ends
+    try std.testing.expect(b.poll(id) == .running);
+    try std.testing.expectEqual(@as(u32, 1), g.n);
+    const r = finish(b, id);
+    try std.testing.expectEqual(api.Status.fault, r.status);
+    try std.testing.expectEqualStrings("7 ", r.out);
+    try std.testing.expectEqual(@as(u32, 1), g.n);
+    // a version this runner does not know is refused, never read as TFGS1 or as one packet
+    const later = finish(b, try b.start(2, .{ .kind = .graph, .bytes = "TFGS3\nIS 7:0\n" }, 100));
+    try std.testing.expectEqual(api.Status.fault, later.status);
+    try std.testing.expectEqualStrings("", later.out);
+    try std.testing.expectEqual(@as(u32, 1), g.n);
+    // in TFGS1 a body starting `@` is a packet like any other: it runs
+    _ = finish(b, try b.start(3, .{ .kind = .graph, .bytes = "TFGS1\nIN @:0\n" }, 100));
+    try std.testing.expectEqualStrings("@:0", g.started[1]);
+    b.release(1);
+    b.release(2);
+    b.release(3);
+}
diff --git a/zig/src/core/runner_graph_edit.zig b/zig/src/core/runner_graph_edit.zig
new file mode 100644
index 000000000..e15d20d22
--- /dev/null
+++ b/zig/src/core/runner_graph_edit.zig
@@ -0,0 +1,128 @@
+//! A literal edit-distance cell as one graph packet: the Levenshtein DP on the bank's compare, min, add and select.
+const std = @import("std");
+const api = @import("runner_api.zig");
+const graph = @import("runner_graph.zig");
+const packet = @import("runner_graph_packet.zig");
+const Allocator = std.mem.Allocator;
+
+/// Levenshtein distance as the trace states it (T5's census program); `{s}` are the two strings, CPython checks it.
+pub const program =
+    \\def edit_distance(a,b):
+    \\    if len(a) > len(b):
+    \\        a,b = b,a
+    \\    m = len(a)
+    \\    dp = list(range(m+1))
+    \\    for i, ch in enumerate(b, 1):
+    \\        prev = dp[0]
+    \\        dp[0] = i
+    \\        for j in range(1, m+1):
+    \\            old = dp[j]
+    \\            cost = 0 if a[j-1] == ch else 1
+    \\            dp[j] = min(old + 1, dp[j-1] + 1, prev + cost)
+    \\            prev = old
+    \\    return dp[m]
+    \\print(edit_distance("{s}", "{s}"))
+;
+
+/// The longest string on either side.
+pub const max_len = 32;
+/// Graph ops per DP cell: the compare, two mins, the +1 and the select.
+pub const ops_per_cell = 5;
+
+const first = std.mem.indexOf(u8, program, "{s}").?;
+const second = std.mem.lastIndexOf(u8, program, "{s}").?;
+const head = program[0..first];
+const middle = program[first + 3 .. second];
+const tail = program[second + 3 ..];
+
+/// The two strings when `code` is `program` over them: each at most max_len printable ASCII bytes, no `"` or `\`.
+pub fn parse(code: []const u8) ?[2][]const u8 {
+    if (code.len < head.len + middle.len + tail.len or !std.mem.startsWith(u8, code, head) or !std.mem.endsWith(u8, code, tail))
+        return null;
+    const inner = code[head.len .. code.len - tail.len];
+    const end = std.mem.indexOfScalar(u8, inner, '"') orelse return null;
+    if (!std.mem.startsWith(u8, inner[end..], middle)) return null;
+    const pair: [2][]const u8 = .{ inner[0..end], inner[end + middle.len ..] };
+    for (pair) |s| {
+        if (s.len > max_len) return null;
+        for (s) |c| if (c < 0x20 or c > 0x7e or c == '"' or c == '\\') return null;
+    }
+    return pair;
+}
+
+/// The DP row by row, each character a packet value so the circuit compares; null: other code or too large.
+pub fn cell(a: Allocator, bank: *const graph.Bank, c: api.Cell) Allocator.Error!?[]u8 {
+    if ((c.form != .repl and c.form != .fence) or c.prior.len != 0 or !std.mem.eql(u8, c.lang, "python")) return null;
+    const pair = parse(std.mem.trim(u8, c.code, "\n")) orelse return null;
+    const x, const y = pair;
+    if (x.len * y.len * ops_per_cell > packet.max_ops) return null;
+    var arena_state = std.heap.ArenaAllocator.init(a);
+    defer arena_state.deinit();
+    const arena = arena_state.allocator();
+    var values: std.ArrayList([]const u8) = .empty;
+    for (x) |ch| try values.append(arena, try std.fmt.allocPrint(arena, "{d}", .{ch}));
+    for (y) |ch| try values.append(arena, try std.fmt.allocPrint(arena, "{d}", .{ch}));
+    // the row and column labels 0..max(len), and 1 for the +1
+    const labels: u32 = @intCast(values.items.len);
+    for (0..@max(x.len, y.len, 1) + 1) |k| try values.append(arena, try std.fmt.allocPrint(arena, "{d}", .{k}));
+    const one = labels + 1;
+    // character codes are below 127 (width 4); a distance and its +1 at most 33 (width 2)
+    const cw = 4;
+    const dw = 2;
+    var ops: std.ArrayList(packet.Op) = .empty;
+    var up: [max_len + 1]u32 = undefined;
+    var row: [max_len + 1]u32 = undefined;
+    for (0..y.len + 1) |j| up[j] = labels + @as(u32, @intCast(j));
+    for (0..x.len) |i| {
+        row[0] = labels + @as(u32, @intCast(i + 1));
+        for (0..y.len) |j| {
+            const at: u32 = @intCast(values.items.len + ops.items.len);
+            try ops.append(arena, .{ .op = "compare", .width = cw, .a = @intCast(i), .b = @intCast(x.len + j), .checked = true });
+            try ops.append(arena, .{ .op = "min", .width = dw, .a = up[j + 1], .b = row[j], .checked = true });
+            try ops.append(arena, .{ .op = "min", .width = dw, .a = at + 1, .b = up[j], .checked = true });
+            try ops.append(arena, .{ .op = "add", .width = dw, .a = at + 2, .b = one, .checked = true });
+            // neighbours differ by at most 1, so equal characters give the diagonal: select's test is compare's digit
+            try ops.append(arena, .{ .op = "select", .width = dw, .args = try arena.dupe(u32, &.{ at + 3, up[j], at }), .checked = true });
+            row[j + 1] = at + 4;
+        }
+        @memcpy(up[0 .. y.len + 1], row[0 .. y.len + 1]);
+    }
+    const result = up[y.len];
+    _ = bank.validate(values.items.len, ops.items, result) catch return null;
+    return packet.Builder.program(a, values.items, ops.items, &.{.{ .ref = result }}) catch |e| return if (e == error.OutOfMemory) error.OutOfMemory else null;
+}
+
+test "runner graph edit: the trace's program over two literals parses; anything else refuses" {
+    var buf: [2048]u8 = undefined;
+    const ok = try std.fmt.bufPrint(&buf, program, .{ "kitten", "sitting" });
+    const got = parse(ok).?;
+    try std.testing.expectEqualStrings("kitten", got[0]);
+    try std.testing.expectEqualStrings("sitting", got[1]);
+    const empty = parse(try std.fmt.bufPrint(&buf, program, .{ "", "abc" })).?;
+    try std.testing.expectEqualStrings("", empty[0]);
+    const long: [max_len]u8 = @splat('z');
+    try std.testing.expect(parse(try std.fmt.bufPrint(&buf, program, .{ &long, &long })) != null);
+    var refuse: std.ArrayList([]const u8) = .empty;
+    defer {
+        for (refuse.items) |r| std.testing.allocator.free(r);
+        refuse.deinit(std.testing.allocator);
+    }
+    const g = std.testing.allocator;
+    const too_long: [max_len + 1]u8 = @splat('z');
+    try refuse.append(g, try std.fmt.allocPrint(g, program, .{ &too_long, "a" }));
+    try refuse.append(g, try std.fmt.allocPrint(g, program, .{ "a\\nb", "a" }));
+    try refuse.append(g, try std.fmt.allocPrint(g, program, .{ "caf\xc3\xa9", "cafe" }));
+    try refuse.append(g, try std.fmt.allocPrint(g, program, .{ "a\tb", "ab" }));
+    try refuse.append(g, try std.fmt.allocPrint(g, program, .{ "a\", \"b", "c" })); // a third argument
+    // the body changed: a substitution costs 2, so this is not Levenshtein
+    const twice = try std.fmt.allocPrint(g, program, .{ "kitten", "sitting" });
+    defer g.free(twice);
+    const at = std.mem.indexOf(u8, twice, "else 1").?;
+    try refuse.append(g, try std.mem.concat(g, u8, &.{ twice[0..at], "else 2", twice[at + 6 ..] }));
+    try refuse.append(g, try std.mem.concat(g, u8, &.{ twice, "\nprint(1)" }));
+    try refuse.append(g, try g.dupe(u8, "print(edit_distance(\"kitten\", \"sitting\"))"));
+    for (refuse.items) |r| if (parse(r)) |p| {
+        std.debug.print("parsed {s} / {s} from:\n{s}\n", .{ p[0], p[1], r });
+        return error.TestUnexpectedParse;
+    };
+}
diff --git a/zig/src/core/runner_graph_exact.zig b/zig/src/core/runner_graph_exact.zig
new file mode 100644
index 000000000..d905ab675
--- /dev/null
+++ b/zig/src/core/runner_graph_exact.zig
@@ -0,0 +1,424 @@
+//! Exact inline arithmetic lowered to existing prepared kernels; operand answers never run on the host.
+const std = @import("std");
+const packet = @import("runner_graph_packet.zig");
+const Bank = @import("runner_graph_bank.zig").Bank;
+const Allocator = std.mem.Allocator;
+const Failure = error{ OutOfMemory, Unsupported };
+const Kind = enum { literal, add, sub, mul, div, neg, pow, computed_pow };
+const Node = struct {
+    kind: Kind,
+    a: u32 = 0,
+    b: u32 = 0,
+    text: []const u8 = "",
+    scale: u8 = 0,
+    exponent: u16 = 0,
+};
+const Bound = struct { ref: u32, digits: usize };
+const Number = struct {
+    n: Bound,
+    d: Bound = .{ .ref = 1, .digits = 1 },
+    scale: ?u8 = 0,
+};
+
+/// INLINE only: the caller owns form/language admission and invokes this after the integer binder refuses.
+pub fn expression(a: Allocator, bank: *const Bank, source: []const u8) Allocator.Error!?[]u8 {
+    if (source.len == 0 or source.len > 4096 or std.mem.indexOfAny(u8, source, "\x00\r\n") != null)
+        return null;
+    var arena_state = std.heap.ArenaAllocator.init(a);
+    defer arena_state.deinit();
+    const arena = arena_state.allocator();
+    return build(a, arena, bank, source) catch |err| switch (err) {
+        error.OutOfMemory => error.OutOfMemory,
+        else => null,
+    };
+}
+
+fn build(a: Allocator, arena: Allocator, bank: *const Bank, source: []const u8) ![]u8 {
+    const normalized = try normalize(arena, source);
+    var p: Parser = .{ .a = arena, .source = normalized };
+    const fraction = p.take("fraction");
+    if (fraction and !p.take("(")) return error.Unsupported;
+    const root = try p.sum();
+    if (fraction and !p.take(")")) return error.Unsupported;
+    p.space();
+    if (p.at != normalized.len) return error.Unsupported;
+    if (!fraction and std.mem.indexOfAny(u8, normalized, "./") == null) {
+        var computed = false;
+        for (p.nodes.items) |node| computed = computed or node.kind == .computed_pow;
+        if (!computed) return error.Unsupported;
+    }
+    var l: Lower = .{ .a = arena, .bank = bank, .nodes = p.nodes.items };
+    try l.initialize();
+    const value = try l.emit(root);
+    const print = try l.finish(value, fraction);
+    const count = try bank.validate(l.values.items.len, l.ops.items, print.ref);
+    try bank.validatePrints(&.{print}, count);
+    return packet.Builder.program(a, l.values.items, l.ops.items, &.{print});
+}
+
+fn normalize(a: Allocator, source: []const u8) Failure![]const u8 {
+    var result: std.ArrayList(u8) = .empty;
+    var at: usize = 0;
+    while (at < source.len) {
+        var found = false;
+        for ([_][]const u8{ "×", "÷", "−" }, [_]u8{ '*', '/', '-' }) |symbol, ascii| {
+            if (!std.mem.startsWith(u8, source[at..], symbol)) continue;
+            try result.append(a, ascii);
+            at += symbol.len;
+            found = true;
+            break;
+        }
+        if (found) continue;
+        if (source[at] >= 128) return error.Unsupported;
+        try result.append(a, source[at]);
+        at += 1;
+    }
+    return result.items;
+}
+
+const Parser = struct {
+    a: Allocator,
+    source: []const u8,
+    at: usize = 0,
+    depth: usize = 0,
+    nodes: std.ArrayList(Node) = .empty,
+    heights: [32]u8 = @splat(0),
+
+    fn space(p: *Parser) void {
+        while (p.at < p.source.len and (p.source[p.at] == ' ' or p.source[p.at] == '\t')) p.at += 1;
+    }
+
+    fn take(p: *Parser, text: []const u8) bool {
+        p.space();
+        if (!std.mem.startsWith(u8, p.source[p.at..], text)) return false;
+        p.at += text.len;
+        return true;
+    }
+
+    fn push(p: *Parser, node: Node) Failure!u32 {
+        if (p.nodes.items.len >= 32) return error.Unsupported;
+        const height: u8 = switch (node.kind) {
+            .literal => 1,
+            .neg, .pow => p.heights[node.a] + 1,
+            else => @max(p.heights[node.a], p.heights[node.b]) + 1,
+        };
+        if (height > 24) return error.Unsupported;
+        p.heights[p.nodes.items.len] = height;
+        try p.nodes.append(p.a, node);
+        return @intCast(p.nodes.items.len - 1);
+    }
+
+    fn sum(p: *Parser) Failure!u32 {
+        var lhs = try p.product();
+        while (true) {
+            const op: Kind = if (p.take("+")) .add else if (p.take("-")) .sub else break;
+            lhs = try p.push(.{ .kind = op, .a = lhs, .b = try p.product() });
+        }
+        return lhs;
+    }
+
+    fn product(p: *Parser) Failure!u32 {
+        var lhs = try p.unary();
+        while (true) {
+            const op: Kind = if (p.take("*")) .mul else if (p.take("/")) .div else break;
+            lhs = try p.push(.{ .kind = op, .a = lhs, .b = try p.unary() });
+        }
+        return lhs;
+    }
+
+    fn unary(p: *Parser) Failure!u32 {
+        if (p.depth >= 24) return error.Unsupported;
+        p.depth += 1;
+        defer p.depth -= 1;
+        if (p.take("+")) return p.unary();
+        if (p.take("-")) return p.push(.{ .kind = .neg, .a = try p.unary() });
+        const lhs = try p.atom();
+        if (!p.take("**") and !p.take("^")) return lhs;
+        p.space();
+        if (p.at < p.source.len and p.source[p.at] == '(')
+            return p.push(.{ .kind = .computed_pow, .a = lhs, .b = try p.atom() });
+        const start = p.at;
+        while (p.at < p.source.len and std.ascii.isDigit(p.source[p.at])) p.at += 1;
+        if (start == p.at or p.at - start > 3) return error.Unsupported;
+        const exponent = std.fmt.parseInt(u16, p.source[start..p.at], 10) catch return error.Unsupported;
+        if (exponent > 999) return error.Unsupported;
+        return p.push(.{ .kind = .pow, .a = lhs, .exponent = exponent });
+    }
+
+    fn atom(p: *Parser) Failure!u32 {
+        if (p.take("(")) {
+            const root = try p.sum();
+            if (!p.take(")")) return error.Unsupported;
+            return root;
+        }
+        p.space();
+        const start = p.at;
+        while (p.at < p.source.len and std.ascii.isDigit(p.source[p.at])) p.at += 1;
+        const whole_end = p.at;
+        var decimal = false;
+        var scale: usize = 0;
+        if (p.at < p.source.len and p.source[p.at] == '.') {
+            decimal = true;
+            p.at += 1;
+            const fraction_start = p.at;
+            while (p.at < p.source.len and std.ascii.isDigit(p.source[p.at])) p.at += 1;
+            scale = p.at - fraction_start;
+            if (scale > 18) return error.Unsupported;
+        }
+        if (whole_end == start and scale == 0) return error.Unsupported;
+        if (whole_end - start + scale > 62) return error.Unsupported;
+        const text = try p.a.alloc(u8, whole_end - start + scale);
+        @memcpy(text[0 .. whole_end - start], p.source[start..whole_end]);
+        if (decimal) @memcpy(text[whole_end - start ..], p.source[whole_end + 1 .. p.at]);
+        var first: usize = 0;
+        while (first + 1 < text.len and text[first] == '0') first += 1;
+        return p.push(.{ .kind = .literal, .text = text[first..], .scale = @intCast(scale) });
+    }
+};
+
+const Lower = struct {
+    a: Allocator,
+    bank: *const Bank,
+    nodes: []const Node,
+    values: std.ArrayList([]const u8) = .empty,
+    ops: std.ArrayList(packet.Op) = .empty,
+    literals: [32]u32 = @splat(0),
+    scales: [19]u32 = undefined,
+    powers: [19]u32 = undefined,
+    exponent_limit: u32 = 0,
+    produced: usize = 0,
+
+    fn constant(l: *Lower, text: []const u8) Failure!u32 {
+        if (l.produced != 0) return error.Unsupported;
+        const ref: u32 = @intCast(l.values.items.len);
+        try l.values.append(l.a, text);
+        return ref;
+    }
+
+    fn initialize(l: *Lower) Failure!void {
+        try l.values.appendSlice(l.a, &.{ "0", "1", "10", "100" });
+        for (0..19) |s| {
+            l.scales[s] = try l.constant(try std.fmt.allocPrint(l.a, "{d}", .{s}));
+            const power = try l.a.alloc(u8, s + 1);
+            @memset(power, '0');
+            power[0] = '1';
+            l.powers[s] = try l.constant(power);
+        }
+        for (l.nodes, 0..) |node, i| if (node.kind == .literal) {
+            l.literals[i] = try l.constant(node.text);
+        };
+        l.exponent_limit = try l.constant("999");
+    }
+
+    fn width(digits: usize) Failure!u16 {
+        for ([_]u16{ 1, 2, 4, 8, 16, 32, 62, 128 }) |w| if (digits <= w) return w;
+        return error.Unsupported;
+    }
+
+    fn operation(l: *Lower, name: []const u8, args: []const u32, digits: usize, outputs: u8) Failure!Bound {
+        const w = try width(@min(digits, 128));
+        if (l.ops.items.len >= 1024 or l.values.items.len + l.produced + outputs > packet.max_values)
+            return error.Unsupported;
+        if (std.mem.eql(u8, name, "fraction") or std.mem.eql(u8, name, "divmod")) {
+            if (args.len != 2 or outputs != 2) return error.Unsupported;
+        } else {
+            const t = l.bank.find(name, w) orelse return error.Unsupported;
+            if (t.inputs != args.len or t.outputs != outputs) return error.Unsupported;
+        }
+        const ref: u32 = @intCast(l.values.items.len + l.produced);
+        try l.ops.append(l.a, .{
+            .op = name,
+            .width = w,
+            .args = try l.a.dupe(u32, args),
+            .outputs = outputs,
+            .checked = true,
+        });
+        l.produced += outputs;
+        return .{ .ref = ref, .digits = @min(digits, 128) };
+    }
+
+    fn binary(l: *Lower, name: []const u8, x: Bound, y: Bound, digits: usize) Failure!Bound {
+        return l.operation(name, &.{ x.ref, y.ref }, @max(digits, @max(x.digits, y.digits)), 1);
+    }
+
+    fn multiply(l: *Lower, x: Bound, y: Bound) Failure!Bound {
+        if (x.ref == 1) return y;
+        if (y.ref == 1) return x;
+        return l.binary("decimal_mul", x, y, x.digits + y.digits);
+    }
+
+    fn scaled(l: *Lower, x: Bound, places: u8) Failure!Bound {
+        var result = x;
+        for (0..places) |_| result = try l.operation("scale10", &.{result.ref}, result.digits + 1, 1);
+        return result;
+    }
+
+    fn ratio(l: *Lower, x: Number) Number {
+        if (x.scale) |s| return .{
+            .n = x.n,
+            .d = .{ .ref = if (s == 0) 1 else l.powers[s], .digits = @as(usize, s) + 1 },
+            .scale = null,
+        };
+        return x;
+    }
+
+    fn combine(l: *Lower, kind: Kind, x: Number, y: Number) Failure!Number {
+        if (kind != .div and x.scale != null and y.scale != null) {
+            const sx = x.scale.?;
+            const sy = y.scale.?;
+            if (kind == .mul) {
+                if (@as(u16, sx) + sy <= 18)
+                    return .{ .n = try l.multiply(x.n, y.n), .scale = sx + sy };
+            } else {
+                const s = @max(sx, sy);
+                const nx = try l.scaled(x.n, s - sx);
+                const ny = try l.scaled(y.n, s - sy);
+                return .{
+                    .n = try l.binary(@tagName(kind), nx, ny, @max(nx.digits, ny.digits) + 1),
+                    .scale = s,
+                };
+            }
+        }
+        const rx = l.ratio(x);
+        const ry = l.ratio(y);
+        if (kind == .div) {
+            const nonzero = try l.binary("compare", ry.n, .{ .ref = 0, .digits = 1 }, ry.n.digits);
+            _ = try l.operation("assert_true", &.{nonzero.ref}, 1, 1);
+        }
+        if (kind == .mul or kind == .div) {
+            const n = if (kind == .div) ry.d else ry.n;
+            const d = if (kind == .div) ry.n else ry.d;
+            const left = try l.reduceNumber(.{ .n = rx.n, .d = d, .scale = null });
+            const right = try l.reduceNumber(.{ .n = n, .d = rx.d, .scale = null });
+            return .{ .n = try l.multiply(left.n, right.n), .d = try l.multiply(left.d, right.d), .scale = null };
+        }
+        const nx = try l.multiply(rx.n, ry.d);
+        const ny = try l.multiply(ry.n, rx.d);
+        return .{
+            .n = try l.binary(@tagName(kind), nx, ny, @max(nx.digits, ny.digits) + 1),
+            .d = try l.multiply(rx.d, ry.d),
+            .scale = null,
+        };
+    }
+
+    fn assertEqual(l: *Lower, x: Bound, y: Bound) Failure!void {
+        const difference = try l.binary("compare", x, y, @max(x.digits, y.digits));
+        const magnitude = try l.binary("decimal_mul", difference, difference, @max(x.digits, y.digits));
+        const equal = try l.binary("sub", .{ .ref = 1, .digits = 1 }, magnitude, @max(x.digits, y.digits));
+        _ = try l.operation("assert_true", &.{equal.ref}, equal.digits, 1);
+    }
+
+    fn reduceNumber(l: *Lower, x: Number) Failure!Number {
+        const ratio_value = l.ratio(x);
+        const pair = try l.operation("fraction", &.{ ratio_value.n.ref, ratio_value.d.ref }, @max(ratio_value.n.digits, ratio_value.d.digits), 2);
+        return .{
+            .n = .{ .ref = pair.ref, .digits = ratio_value.n.digits },
+            .d = .{ .ref = pair.ref + 1, .digits = ratio_value.d.digits },
+            .scale = null,
+        };
+    }
+
+    fn choose(l: *Lower, value: Bound, flag: Bound) Failure!Bound {
+        return l.operation("select", &.{ value.ref, 1, flag.ref }, @max(value.digits, 1), 1);
+    }
+
+    fn powerMultiply(l: *Lower, x: Bound, y: Bound) Failure!Bound {
+        return l.operation("decimal_mul", &.{ x.ref, y.ref }, 62, 1);
+    }
+
+    fn computedPower(l: *Lower, base: Number, exponent: Number) Failure!Number {
+        const e = try l.reduceNumber(exponent);
+        try l.assertEqual(e.d, .{ .ref = 1, .digits = 1 });
+        const negative = try l.binary("min", e.n, .{ .ref = 0, .digits = 1 }, e.n.digits);
+        try l.assertEqual(negative, .{ .ref = 0, .digits = 1 });
+        const limit: Bound = .{ .ref = l.exponent_limit, .digits = 3 };
+        const maximum = try l.binary("max", e.n, limit, @max(e.n.digits, 3));
+        try l.assertEqual(maximum, limit);
+        var remaining: Bound = .{ .ref = e.n.ref, .digits = 3 };
+        var factor = try l.reduceNumber(base);
+        var result: Number = .{ .n = .{ .ref = 1, .digits = 1 }, .scale = null };
+        for (0..10) |_| {
+            const half = try l.operation("divmod", &.{ remaining.ref, l.scales[2] }, 4, 2);
+            const bit: Bound = .{ .ref = half.ref + 1, .digits = 1 };
+            result.n = try l.powerMultiply(result.n, try l.choose(factor.n, bit));
+            result.d = try l.powerMultiply(result.d, try l.choose(factor.d, bit));
+            remaining = .{ .ref = half.ref, .digits = 3 };
+            const active = try l.binary("compare", remaining, .{ .ref = 0, .digits = 1 }, 3);
+            const n = try l.choose(factor.n, active);
+            const d = try l.choose(factor.d, active);
+            factor.n = try l.powerMultiply(n, n);
+            factor.d = try l.powerMultiply(d, d);
+        }
+        return result;
+    }
+
+    fn emit(l: *Lower, index: u32) Failure!Number {
+        const node = l.nodes[index];
+        if (node.kind == .literal) return .{
+            .n = .{ .ref = l.literals[index], .digits = node.text.len },
+            .scale = node.scale,
+        };
+        var lhs = try l.emit(node.a);
+        if (node.kind == .computed_pow) return l.computedPower(lhs, try l.emit(node.b));
+        if (node.kind == .neg) {
+            lhs.n = try l.binary("sub", .{ .ref = 0, .digits = 1 }, lhs.n, lhs.n.digits);
+            return lhs;
+        }
+        if (node.kind == .pow) {
+            var n = node.exponent;
+            var result: Number = .{ .n = .{ .ref = 1, .digits = 1 } };
+            while (n != 0) {
+                if (n & 1 != 0) result = try l.combine(.mul, result, lhs);
+                n >>= 1;
+                if (n != 0) lhs = try l.combine(.mul, lhs, lhs);
+            }
+            return result;
+        }
+        return l.combine(node.kind, lhs, try l.emit(node.b));
+    }
+
+    fn finish(l: *Lower, value: Number, fraction: bool) Failure!packet.Print {
+        if (fraction) {
+            const r = l.ratio(value);
+            const reduced = try l.operation("fraction", &.{ r.n.ref, r.d.ref }, @max(r.n.digits, r.d.digits), 2);
+            return .{ .ref = reduced.ref, .second = reduced.ref + 1, .style = .fraction };
+        }
+        if (value.scale) |s| return l.decimalPrint(value.n, s);
+        const reduced = try l.reduceNumber(value);
+        var found: Bound = .{ .ref = 0, .digits = 1 };
+        var coefficient = reduced.n;
+        var precision: Bound = .{ .ref = l.scales[0], .digits = 2 };
+        for (0..19) |s| {
+            const qr = try l.operation("divmod", &.{ l.powers[s], reduced.d.ref }, @max(s + 1, reduced.d.digits), 2);
+            const unequal = try l.binary("compare", .{ .ref = qr.ref + 1, .digits = qr.digits }, .{ .ref = 0, .digits = 1 }, qr.digits);
+            const equal = try l.binary("sub", .{ .ref = 1, .digits = 1 }, unequal, 1);
+            const take = try l.operation("select", &.{ 0, equal.ref, found.ref }, 1, 1);
+            const multiplier = try l.choose(.{ .ref = qr.ref, .digits = qr.digits }, take);
+            const candidate = try l.multiply(reduced.n, multiplier);
+            coefficient = try l.operation("select", &.{ candidate.ref, coefficient.ref, take.ref }, @max(candidate.digits, coefficient.digits), 1);
+            precision = try l.operation("select", &.{ l.scales[s], precision.ref, take.ref }, 2, 1);
+            found = try l.operation("select", &.{ 1, found.ref, equal.ref }, 1, 1);
+        }
+        _ = try l.operation("assert_true", &.{found.ref}, 1, 1);
+        return l.preparedPrint(coefficient, precision);
+    }
+
+    fn decimalPrint(l: *Lower, coefficient: Bound, scale: u8) Failure!packet.Print {
+        var c = coefficient;
+        var precision: Bound = .{ .ref = l.scales[scale], .digits = 2 };
+        for (0..scale) |_| {
+            const qr = try l.operation("divmod", &.{ c.ref, 2 }, @max(c.digits, 2), 2);
+            const flag = try l.binary("compare", .{ .ref = qr.ref + 1, .digits = qr.digits }, .{ .ref = 0, .digits = 1 }, qr.digits);
+            c = try l.operation("select", &.{ c.ref, qr.ref, flag.ref }, @max(c.digits, 2), 1);
+            const delta = try l.operation("select", &.{ 0, 1, flag.ref }, 1, 1);
+            precision = try l.binary("sub", precision, .{ .ref = delta.ref, .digits = 1 }, 2);
+        }
+        return l.preparedPrint(c, precision);
+    }
+
+    fn preparedPrint(l: *Lower, coefficient: Bound, precision: Bound) Failure!packet.Print {
+        const c = try l.binary("add", coefficient, .{ .ref = 0, .digits = 1 }, coefficient.digits);
+        const control = try l.binary("add", .{ .ref = 3, .digits = 3 }, precision, 3);
+        return .{ .ref = c.ref, .second = control.ref, .style = .prepared };
+    }
+};
diff --git a/zig/src/core/runner_graph_f64.zig b/zig/src/core/runner_graph_f64.zig
new file mode 100644
index 000000000..e2f7e4aec
--- /dev/null
+++ b/zig/src/core/runner_graph_f64.zig
@@ -0,0 +1,63 @@
+//! Checked bounded binary64 orchestration over prepared integer FFNs and circuit-owned decimal formatting.
+const std = @import("std");
+const api = @import("runner_api.zig");
+const packet = @import("runner_graph_packet.zig");
+const context = @import("runner_graph_f64_context.zig");
+const math = @import("runner_graph_f64_math.zig");
+const printing = @import("runner_graph_f64_print.zig");
+const End = @FieldType(api.RunEnd, "end");
+const Cancel = ?*const std.atomic.Value(bool);
+
+pub fn compute(m: anytype, kind: []const u8, width: u16, refs: []const u32, dest: usize, budget: u64, out: *std.ArrayList(u8), cancel: Cancel) !End {
+    if (width != 128 or std.mem.eql(u8, kind, "f64_repr")) return error.GraphAlgorithm;
+    const family = std.meta.stringToEnum(packet.Algorithm, kind) orelse return error.GraphAlgorithm;
+    const outputs = packet.algorithmOutputs(family);
+    if (refs.len != packet.algorithmArity(family) or dest + outputs > m.values.len) return error.GraphSlotArity;
+    const original = m.values;
+    const zero = try packet.literal("0");
+    var scratch: [256]packet.Value = @splat(zero);
+    scratch[1] = try packet.literal("1");
+    for (refs, 0..) |ref, i| {
+        if (ref >= original.len) return error.GraphReference;
+        scratch[2 + i] = original[ref];
+    }
+    m.values = &scratch;
+    defer m.values = original;
+    var c: context.Context(@TypeOf(m)) = .{ .m = m, .budget = budget, .out = out, .cancel = cancel };
+    const result = (if (std.mem.eql(u8, kind, "f64_format")) printing.prepare(&c, 2, 3) else math.calculate(&c, kind)) catch |err| switch (err) {
+        error.GraphAlgorithmStopped => return c.end,
+        else => return err,
+    };
+    const values = [2]packet.Value{ scratch[result[0]], scratch[result[1]] };
+    @memcpy(original[dest .. dest + outputs], values[0..outputs]);
+    return .halted;
+}
+
+pub fn run(m: anytype, kind: []const u8, budget: u64, out: *std.ArrayList(u8), cancel: Cancel) !api.RunEnd {
+    if (std.mem.eql(u8, kind, "f64_repr")) {
+        const original = m.values;
+        const zero = try packet.literal("0");
+        var scratch: [256]packet.Value = @splat(zero);
+        scratch[1] = try packet.literal("1");
+        scratch[2] = original[0];
+        scratch[3] = original[1];
+        m.values = &scratch;
+        defer m.values = original;
+        var c: context.Context(@TypeOf(m)) = .{ .m = m, .budget = budget, .out = out, .cancel = cancel };
+        printing.render(&c, 2, 3) catch |err| switch (err) {
+            error.GraphAlgorithmStopped => return .{ .end = c.end, .steps = m.steps },
+            else => return err,
+        };
+        return .{ .end = .halted, .steps = m.steps };
+    }
+    const family = std.meta.stringToEnum(packet.Algorithm, kind) orelse return error.GraphAlgorithm;
+    const refs = [_]u32{ 0, 1, 2, 3, 4, 5, 6, 7 };
+    const end = try compute(m, kind, m.width, refs[0..packet.algorithmArity(family)], 0, budget, out, cancel);
+    if (end != .halted) return .{ .end = end, .steps = m.steps };
+    const printed = try @import("runner_graph_print.zig").emit(m, .{
+        .ref = 0,
+        .second = if (packet.algorithmOutputs(family) == 2) 1 else null,
+        .style = if (packet.algorithmOutputs(family) == 2) .tuple else .boolean,
+    }, budget, out, cancel);
+    return .{ .end = printed, .steps = m.steps };
+}
diff --git a/zig/src/core/runner_graph_f64_context.zig b/zig/src/core/runner_graph_f64_context.zig
new file mode 100644
index 000000000..fc3bcddd7
--- /dev/null
+++ b/zig/src/core/runner_graph_f64_context.zig
@@ -0,0 +1,143 @@
+//! Request-local FFN dispatch and predicates for the bounded binary64 family.
+const std = @import("std");
+const api = @import("runner_api.zig");
+const packet = @import("runner_graph_packet.zig");
+const End = @FieldType(api.RunEnd, "end");
+
+pub fn Context(comptime M: type) type {
+    return struct {
+        m: M,
+        width: u8 = 128,
+        budget: u64,
+        out: *std.ArrayList(u8),
+        cancel: ?*const std.atomic.Value(bool),
+        end: End = .halted,
+        extended: bool = false,
+
+        const Self = @This();
+
+        pub fn call(c: *Self, name: []const u8, refs: []const u32, dest: usize) !void {
+            var needed: usize = 1;
+            for (refs) |ref| {
+                if (ref >= c.m.values.len) return error.GraphReference;
+                try clean(&c.m.values[ref]);
+                needed = @max(needed, occupiedDigits(&c.m.values[ref]));
+            }
+            if (std.mem.eql(u8, name, "mul") or std.mem.eql(u8, name, "decimal_mul")) {
+                needed = occupiedDigits(&c.m.values[refs[0]]) + occupiedDigits(&c.m.values[refs[1]]);
+            } else if (std.mem.eql(u8, name, "add") or std.mem.eql(u8, name, "sub") or
+                std.mem.eql(u8, name, "scale10") or std.mem.eql(u8, name, "round_div"))
+            {
+                needed += 1;
+            }
+            const raw_meta = std.mem.eql(u8, name, "raw_meta");
+            const selected = if (raw_meta) @max(@as(u8, 8), bucket(@min(needed, c.width))) else bucket(@min(needed, c.width));
+            const t = (if (c.m.adaptive_widths) c.m.bank.find(name, selected) else null) orelse
+                c.m.bank.find(name, c.width) orelse return error.GraphTemplate;
+            if (dest + t.outputs > c.m.values.len) return error.GraphAlgorithmScratch;
+            c.end = try c.m.invoke(t, refs, dest, c.budget, c.out, c.cancel, false);
+            if (c.end != .halted) return error.GraphAlgorithmStopped;
+            for (dest..dest + t.outputs) |i| try clean(&c.m.values[i]);
+        }
+
+        pub fn move(c: *Self, dest: usize, source: usize) void {
+            c.m.values[dest] = c.m.values[source];
+        }
+
+        pub fn literal(c: *Self, dest: usize, text: []const u8) !void {
+            c.m.values[dest] = try packet.literal(text);
+        }
+
+        pub fn meta(c: *Self, a: u32, b: u32) !void {
+            try c.call("raw_meta", &.{ a, b }, 253);
+        }
+
+        pub fn flag(c: *Self, index: usize) !bool {
+            if (index >= 6) return error.GraphPredicate;
+            return predicate(&c.m.values[255], index);
+        }
+
+        pub fn nonzero(c: *Self, ref: u32) !bool {
+            try c.meta(ref, 0);
+            return c.flag(0);
+        }
+
+        pub fn sign(c: *Self, ref: u32) !bool {
+            try c.meta(ref, 0);
+            return c.flag(2);
+        }
+
+        pub fn less(c: *Self, a: u32, b: u32) !bool {
+            try c.call("compare", &.{ a, b }, 252);
+            try c.meta(252, 0);
+            return try c.flag(0) and try c.flag(2);
+        }
+
+        pub fn equal(c: *Self, a: u32, b: u32) !bool {
+            try c.call("compare", &.{ a, b }, 252);
+            return !try c.nonzero(252);
+        }
+
+        /// Unsigned long division consumes occupied decimal lanes; slots 240..246 are private.
+        pub fn divide(c: *Self, a: u32, b: u32, q: usize, r: usize) !void {
+            if ((q >= 240 and q <= 246) or (r >= 240 and r <= 246) or q == r)
+                return error.GraphAlgorithmScratch;
+            const inputs = [2]packet.Value{ c.m.values[a], c.m.values[b] };
+            c.m.values[240] = inputs[0];
+            c.m.values[241] = inputs[1];
+            try c.meta(240, 241);
+            if (try c.flag(2) or try c.flag(3) or !try c.flag(1)) return error.GraphF64Arithmetic;
+            c.move(242, 0);
+            c.move(243, 0);
+            var digit = occupiedDigits(&c.m.values[240]);
+            while (digit > 0) {
+                digit -= 1;
+                c.move(244, 0);
+                packet.copyBits(&c.m.values[244], &c.m.values[240], .{
+                    .ref = 240,
+                    .from = @intCast(digit),
+                    .digits = 1,
+                });
+                try c.call("divstep", &.{ 243, 241, 244 }, 245);
+                c.move(243, 245);
+                packet.copyBits(&c.m.values[242], &c.m.values[246], .{
+                    .ref = 246,
+                    .to = @intCast(digit),
+                    .digits = 1,
+                });
+            }
+            const result = [2]packet.Value{ c.m.values[242], c.m.values[243] };
+            c.m.values[q] = result[0];
+            c.m.values[r] = result[1];
+        }
+    };
+}
+
+pub fn occupiedDigits(value: *const packet.Value) usize {
+    var digits: usize = packet.max_digits;
+    while (digits > 1) : (digits -= 1) {
+        const at = digits - 1;
+        for (value[at / 31][2 + at % 31 * 4 ..][0..4]) |bit| if (bit != 0) return digits;
+    }
+    return digits;
+}
+
+fn bucket(needed: usize) u8 {
+    for ([_]u8{ 1, 2, 4, 8, 16, 32, 62, 128 }) |width| if (needed <= width) return width;
+    unreachable;
+}
+
+fn clean(value: *const packet.Value) !void {
+    const bit = value[0][127];
+    if (bit == packet.bit_scale) return error.GraphF64Arithmetic;
+    if (bit != 0) return error.GraphPredicate;
+}
+
+fn predicate(value: *const packet.Value, digit: usize) !bool {
+    try clean(value);
+    const bits = value[digit / 31][2 + digit % 31 * 4 ..][0..4];
+    for (bits[1..]) |bit| if (bit != 0) return error.GraphPredicate;
+    if (bits[0] == 0) return false;
+    if (bits[0] == packet.bit_scale) return true;
+    return error.GraphPredicate;
+}
diff --git a/zig/src/core/runner_graph_f64_math.zig b/zig/src/core/runner_graph_f64_math.zig
new file mode 100644
index 000000000..581b2fb38
--- /dev/null
+++ b/zig/src/core/runner_graph_f64_math.zig
@@ -0,0 +1,231 @@
+//! Bounded binary64 operations use exact FFN integers and a single nearest-even rounding boundary.
+const std = @import("std");
+const packet = @import("runner_graph_packet.zig");
+const context = @import("runner_graph_f64_context.zig");
+
+pub fn calculate(c: anytype, kind: []const u8) ![2]u32 {
+    if (std.mem.eql(u8, kind, "f64_ratio")) {
+        if (context.occupiedDigits(&c.m.values[2]) > 62 or context.occupiedDigits(&c.m.values[3]) > 62)
+            return error.GraphF64Arithmetic;
+        try ratio(c, 2, 3, 32, 33);
+    } else if (std.mem.eql(u8, kind, "f64_mul")) {
+        try multiply(c, 2, 3, 4, 5, 32, 33);
+    } else if (std.mem.eql(u8, kind, "f64_sub")) {
+        try subtract(c, 2, 3, 4, 5, 32, 33);
+    } else if (std.mem.eql(u8, kind, "f64_isclose")) {
+        try isclose(c);
+    } else return error.GraphAlgorithm;
+    return .{ 32, 33 };
+}
+
+/// The canonical finite domain includes raw signed zero with exponent zero.
+pub fn ensureFloat(c: anytype, m: u32, e: u32) !void {
+    const inputs = [2]packet.Value{ c.m.values[m], c.m.values[e] };
+    c.m.values[110] = inputs[0];
+    c.m.values[111] = inputs[1];
+    try constants(c);
+    if (try c.less(111, 116) or try c.less(117, 111)) return error.GraphF64Arithmetic;
+    try c.meta(110, 113);
+    const nonzero = try c.flag(0);
+    const below = try c.flag(4);
+    if (!nonzero) {
+        if (try c.nonzero(111)) return error.GraphF64Arithmetic;
+        return;
+    }
+    if (below) return error.GraphF64Arithmetic;
+    try c.meta(110, 114);
+    if (!try c.flag(4)) return error.GraphF64Arithmetic;
+}
+
+/// Normalize an exact ratio before the final 53-bit quotient and remainder are rounded together.
+pub fn ratio(c: anytype, n: u32, d: u32, out_m: usize, out_e: usize) !void {
+    const inputs = [2]packet.Value{ c.m.values[n], c.m.values[d] };
+    c.m.values[64] = inputs[0];
+    c.m.values[65] = inputs[1];
+    try constants(c);
+    try c.meta(64, 65);
+    if (!try c.flag(1)) return error.GraphF64Arithmetic;
+    const negative = try c.flag(2) != try c.flag(3);
+    c.move(66, 253);
+    c.move(67, 254);
+    c.move(68, 0);
+    try c.literal(72, if (negative) "-1" else "1");
+    if (!try c.nonzero(66)) {
+        try c.call("decimal_mul", &.{ 0, 72 }, 69);
+        return output(c, 69, 68, out_m, out_e);
+    }
+    var steps: usize = 0;
+    while (try c.less(66, 67)) {
+        try limit(&steps);
+        try c.call("decimal_mul", &.{ 66, 112 }, 66);
+        try c.call("sub", &.{ 68, 1 }, 68);
+    }
+    while (true) {
+        try c.call("decimal_mul", &.{ 67, 112 }, 70);
+        if (try c.less(66, 70)) break;
+        try limit(&steps);
+        c.move(67, 70);
+        try c.call("add", &.{ 68, 1 }, 68);
+    }
+    try c.call("decimal_mul", &.{ 66, 113 }, 66);
+    try c.literal(71, "52");
+    try c.call("sub", &.{ 68, 71 }, 68);
+    try c.divide(66, 67, 70, 71);
+    try c.call("round_div", &.{ 70, 71, 72, 67 }, 69);
+    try c.meta(69, 114);
+    if (try c.flag(5)) {
+        c.move(70, 253);
+        try c.call("half", &.{70}, 73);
+        try c.call("decimal_mul", &.{ 73, 72 }, 69);
+        try c.call("add", &.{ 68, 1 }, 68);
+    }
+    try ensureFloat(c, 69, 68);
+    try output(c, 69, 68, out_m, out_e);
+}
+
+/// Exact mantissa multiplication is truncated once, retaining guard and sticky predicates.
+pub fn multiply(c: anytype, m1: u32, e1: u32, m2: u32, e2: u32, out_m: usize, out_e: usize) !void {
+    try inputs4(c, m1, e1, m2, e2);
+    try ensureFloat(c, 64, 65);
+    try ensureFloat(c, 66, 67);
+    try c.call("decimal_mul", &.{ 64, 66 }, 68);
+    try c.call("add", &.{ 65, 67 }, 69);
+    try normalize(c, 68, 69, out_m, out_e);
+}
+
+/// Alignment is exact in decimal lanes, followed by one rounding of the signed difference.
+pub fn subtract(c: anytype, m1: u32, e1: u32, m2: u32, e2: u32, out_m: usize, out_e: usize) !void {
+    try inputs4(c, m1, e1, m2, e2);
+    try ensureFloat(c, 64, 65);
+    try ensureFloat(c, 66, 67);
+    try c.meta(64, 66);
+    const both_zero = !try c.flag(0) and !try c.flag(1);
+    const negative_zero = try c.flag(2) and !try c.flag(3);
+    if (both_zero) {
+        try c.literal(68, if (negative_zero) "-0" else "0");
+        return output(c, 68, 0, out_m, out_e);
+    }
+    var steps: usize = 0;
+    while (try c.less(65, 67)) {
+        try limit(&steps);
+        try c.call("decimal_mul", &.{ 66, 112 }, 66);
+        try c.call("sub", &.{ 67, 1 }, 67);
+    }
+    while (try c.less(67, 65)) {
+        try limit(&steps);
+        try c.call("decimal_mul", &.{ 64, 112 }, 64);
+        try c.call("sub", &.{ 65, 1 }, 65);
+    }
+    try c.call("sub", &.{ 64, 66 }, 68);
+    try normalize(c, 68, 65, out_m, out_e);
+}
+
+fn normalize(c: anytype, m: u32, e: u32, out_m: usize, out_e: usize) !void {
+    const inputs = [2]packet.Value{ c.m.values[m], c.m.values[e] };
+    c.m.values[80] = inputs[0];
+    c.m.values[81] = inputs[1];
+    try constants(c);
+    try c.meta(80, 0);
+    const negative = try c.flag(2);
+    c.move(84, 253);
+    if (!try c.flag(0)) return output(c, 80, 0, out_m, out_e);
+    var steps: usize = 0;
+    while (try c.less(84, 113)) {
+        try limit(&steps);
+        try c.call("decimal_mul", &.{ 84, 112 }, 84);
+        try c.call("sub", &.{ 81, 1 }, 81);
+    }
+    var guard = false;
+    var sticky = false;
+    while (!try c.less(84, 114)) {
+        try limit(&steps);
+        try c.call("half", &.{84}, 86);
+        sticky = sticky or guard;
+        guard = try c.nonzero(87);
+        c.move(84, 86);
+        try c.call("add", &.{ 81, 1 }, 81);
+    }
+    if (guard) {
+        try c.call("half", &.{84}, 86);
+        if (sticky or try c.nonzero(87)) try c.call("add", &.{ 84, 1 }, 84);
+    }
+    if (try c.equal(84, 114)) {
+        try c.call("half", &.{84}, 86);
+        c.move(84, 86);
+        try c.call("add", &.{ 81, 1 }, 81);
+    }
+    try c.literal(88, if (negative) "-1" else "1");
+    try c.call("decimal_mul", &.{ 84, 88 }, 89);
+    try ensureFloat(c, 89, 81);
+    try output(c, 89, 81, out_m, out_e);
+}
+
+fn isclose(c: anytype) !void {
+    const inputs = [8]packet.Value{
+        c.m.values[2], c.m.values[3], c.m.values[4], c.m.values[5],
+        c.m.values[6], c.m.values[7], c.m.values[8], c.m.values[9],
+    };
+    for (inputs, 128..) |value, i| c.m.values[i] = value;
+    for (0..4) |i| try ensureFloat(c, @intCast(128 + i * 2), @intCast(129 + i * 2));
+    for ([_]u32{ 132, 134 }) |m| {
+        try c.meta(m, 0);
+        if (try c.flag(0) and try c.flag(2)) return error.GraphF64Arithmetic;
+    }
+    const previous = c.extended;
+    c.extended = true;
+    defer c.extended = previous;
+    var close = try c.equal(128, 130) and try c.equal(129, 131);
+    if (!close) {
+        try subtract(c, 128, 129, 130, 131, 136, 137);
+        try c.meta(136, 0);
+        c.move(136, 253);
+        try c.meta(128, 0);
+        c.move(138, 253);
+        try multiply(c, 132, 133, 138, 129, 138, 139);
+        close = try positiveLE(c, 136, 137, 138, 139);
+        if (!close) {
+            try c.meta(130, 0);
+            c.move(138, 253);
+            try multiply(c, 132, 133, 138, 131, 138, 139);
+            close = try positiveLE(c, 136, 137, 138, 139);
+        }
+        if (!close) close = try positiveLE(c, 136, 137, 134, 135);
+    }
+    c.move(32, if (close) 1 else 0);
+    c.move(33, 0);
+}
+
+fn positiveLE(c: anytype, am: u32, ae: u32, bm: u32, be: u32) !bool {
+    if (!try c.nonzero(am)) return true;
+    if (!try c.nonzero(bm)) return false;
+    if (try c.less(ae, be)) return true;
+    if (!try c.equal(ae, be)) return false;
+    return try c.less(am, bm) or try c.equal(am, bm);
+}
+
+fn inputs4(c: anytype, m1: u32, e1: u32, m2: u32, e2: u32) !void {
+    const inputs = [4]packet.Value{ c.m.values[m1], c.m.values[e1], c.m.values[m2], c.m.values[e2] };
+    for (inputs, 64..) |value, i| c.m.values[i] = value;
+}
+
+fn output(c: anytype, m: u32, e: u32, out_m: usize, out_e: usize) !void {
+    if (out_m == out_e or out_m >= c.m.values.len or out_e >= c.m.values.len)
+        return error.GraphAlgorithmScratch;
+    const values = [2]packet.Value{ c.m.values[m], c.m.values[e] };
+    c.m.values[out_m] = values[0];
+    c.m.values[out_e] = values[1];
+}
+
+fn constants(c: anytype) !void {
+    try c.literal(112, "2");
+    try c.literal(113, "4503599627370496");
+    try c.literal(114, "9007199254740992");
+    try c.literal(115, "-1");
+    try c.literal(116, if (c.extended) "-256" else "-100");
+    try c.literal(117, if (c.extended) "256" else "100");
+}
+
+fn limit(steps: *usize) !void {
+    if (steps.* >= 1000) return error.GraphF64Arithmetic;
+    steps.* += 1;
+}
diff --git a/zig/src/core/runner_graph_f64_print.zig b/zig/src/core/runner_graph_f64_print.zig
new file mode 100644
index 000000000..92ee61d47
--- /dev/null
+++ b/zig/src/core/runner_graph_f64_print.zig
@@ -0,0 +1,210 @@
+//! Shortest bounded fixed decimal output keeps all operand arithmetic in prepared FFN kernels.
+const std = @import("std");
+const packet = @import("runner_graph_packet.zig");
+const math = @import("runner_graph_f64_math.zig");
+
+const s = struct {
+    const original_m: u32 = 140;
+    const original_e: u32 = 141;
+    const magnitude: u32 = 142;
+    const two: u32 = 143;
+    const ten: u32 = 144;
+    const minus_one: u32 = 145;
+    const hundred: u32 = 146;
+    const integral: u32 = 147;
+    const min_k: u32 = 148;
+    const max_k: u32 = 149;
+    const min_probe_k: u32 = 150;
+    const max_scale: u32 = 151;
+    const n: u32 = 152;
+    const d: u32 = 153;
+    const exponent: u32 = 154;
+    const k: u32 = 155;
+    const scaled_n: u32 = 156;
+    const temporary: u32 = 158;
+    const p_minus_one: u32 = 159;
+    const quotient: u32 = 160;
+    const remainder: u32 = 161;
+    const nearest: u32 = 162;
+    const other: u32 = 163;
+    const coefficient: u32 = 164;
+    const scale: u32 = 165;
+    const candidate_n: u32 = 166;
+    const candidate_d: u32 = 167;
+    const scale_work: u32 = 168;
+    const back_m: u32 = 169;
+    const back_e: u32 = 170;
+    const trim_q: u32 = 171;
+    const trim_r: u32 = 172;
+    const control: u32 = 173;
+    const adjusted_k: u32 = 174;
+    const decade: u32 = 175;
+    const sign_factor: u32 = 176;
+};
+
+/// Named repr emission publishes bytes only after preparation and the formatter both succeed.
+pub fn render(c: anytype, m: u32, e: u32) !void {
+    const refs = try prepare(c, m, e);
+    try publish(c, refs);
+}
+
+/// Returns coefficient/control refs 164/173 without BYTE output; scratch occupies only slots 140..176.
+pub fn prepare(c: anytype, m: u32, e: u32) ![2]u32 {
+    c.move(s.original_m, m);
+    c.move(s.original_e, e);
+    try math.ensureFloat(c, s.original_m, s.original_e);
+    try constants(c);
+    const negative = try c.sign(s.original_m);
+    c.move(s.sign_factor, if (negative) s.minus_one else 1);
+    if (!try c.nonzero(s.original_m)) {
+        try c.call("decimal_mul", &.{ 0, s.sign_factor }, s.coefficient);
+        c.move(s.control, s.integral);
+        return .{ s.coefficient, s.control };
+    }
+    try c.meta(s.original_m, 0);
+    c.move(s.magnitude, 253);
+    try exactFraction(c);
+    try normalize(c);
+    if (try c.less(s.k, s.min_probe_k) or try c.less(s.max_k, s.k))
+        return error.GraphF64Arithmetic;
+    c.move(s.scaled_n, s.n);
+    c.move(s.p_minus_one, 0);
+    c.move(s.decade, s.ten);
+    for (1..18) |_| {
+        try c.divide(s.scaled_n, s.d, s.quotient, s.remainder);
+        try c.call("round_div", &.{ s.quotient, s.remainder, s.scaled_n, s.d }, s.nearest);
+        try c.call("sub", &.{ s.p_minus_one, s.k }, s.scale);
+        if (try c.equal(s.nearest, s.quotient)) {
+            try c.call("add", &.{ s.quotient, 1 }, s.other);
+        } else c.move(s.other, s.quotient);
+        if (try roundtrips(c, s.nearest)) {
+            c.move(s.coefficient, s.nearest);
+            try finish(c);
+            return .{ s.coefficient, s.control };
+        }
+        if (try c.nonzero(s.remainder) and try roundtrips(c, s.other)) {
+            c.move(s.coefficient, s.other);
+            try finish(c);
+            return .{ s.coefficient, s.control };
+        }
+        // Only a carry to 10 can bring k=-5 into the admitted output interval, and p=1 already tried it.
+        if (try c.less(s.k, s.min_k)) return error.GraphF64Arithmetic;
+        try c.call("decimal_mul", &.{ s.scaled_n, s.ten }, s.scaled_n);
+        try c.call("add", &.{ s.p_minus_one, 1 }, s.p_minus_one);
+        try c.call("decimal_mul", &.{ s.decade, s.ten }, s.decade);
+    }
+    return error.GraphF64Arithmetic;
+}
+
+fn constants(c: anytype) !void {
+    try c.literal(s.two, "2");
+    try c.literal(s.ten, "10");
+    try c.literal(s.minus_one, "-1");
+    try c.literal(s.hundred, "100");
+    try c.literal(s.integral, "300");
+    try c.literal(s.min_k, "-4");
+    try c.literal(s.max_k, "15");
+    try c.literal(s.min_probe_k, "-5");
+    try c.literal(s.max_scale, "20");
+}
+
+fn exactFraction(c: anytype) !void {
+    c.move(s.n, s.magnitude);
+    c.move(s.d, 1);
+    c.move(s.exponent, s.original_e);
+    for (0..100) |_| {
+        if (!try c.nonzero(s.exponent)) return;
+        if (try c.less(s.exponent, 0)) {
+            try c.call("decimal_mul", &.{ s.d, s.two }, s.d);
+            try c.call("add", &.{ s.exponent, 1 }, s.exponent);
+        } else {
+            try c.call("decimal_mul", &.{ s.n, s.two }, s.n);
+            try c.call("sub", &.{ s.exponent, 1 }, s.exponent);
+        }
+    }
+    if (try c.nonzero(s.exponent)) return error.GraphF64Arithmetic;
+}
+
+/// N/D is made decimal-normal without division or any host interpretation of its tensor digits.
+fn normalize(c: anytype) !void {
+    c.move(s.k, 0);
+    for (0..64) |_| {
+        if (try c.less(s.n, s.d)) {
+            try c.call("decimal_mul", &.{ s.n, s.ten }, s.n);
+            try c.call("sub", &.{ s.k, 1 }, s.k);
+            continue;
+        }
+        try c.call("decimal_mul", &.{ s.d, s.ten }, s.temporary);
+        if (!try c.less(s.n, s.temporary)) {
+            c.move(s.d, s.temporary);
+            try c.call("add", &.{ s.k, 1 }, s.k);
+            continue;
+        }
+        return;
+    }
+    return error.GraphF64Arithmetic;
+}
+
+/// Candidate C has exact value C*10^-scale; canonical binary equality decides the shortest precision.
+fn roundtrips(c: anytype, coefficient: u32) !bool {
+    if (!try c.nonzero(coefficient)) return false;
+    c.move(s.candidate_n, coefficient);
+    c.move(s.candidate_d, 1);
+    c.move(s.scale_work, s.scale);
+    try c.meta(s.scale_work, 0);
+    c.move(s.temporary, 253);
+    if (try c.less(s.max_scale, s.temporary)) return error.GraphF64Arithmetic;
+    for (0..20) |_| {
+        if (!try c.nonzero(s.scale_work)) break;
+        if (try c.less(s.scale_work, 0)) {
+            try c.call("decimal_mul", &.{ s.candidate_n, s.ten }, s.candidate_n);
+            try c.call("add", &.{ s.scale_work, 1 }, s.scale_work);
+        } else {
+            try c.call("decimal_mul", &.{ s.candidate_d, s.ten }, s.candidate_d);
+            try c.call("sub", &.{ s.scale_work, 1 }, s.scale_work);
+        }
+    }
+    if (try c.nonzero(s.scale_work)) return error.GraphF64Arithmetic;
+    try c.call("decimal_mul", &.{ s.candidate_n, s.sign_factor }, s.candidate_n);
+    try math.ratio(c, s.candidate_n, s.candidate_d, s.back_m, s.back_e);
+    return try c.equal(s.back_m, s.original_m) and try c.equal(s.back_e, s.original_e);
+}
+
+fn finish(c: anytype) !void {
+    c.move(s.adjusted_k, s.k);
+    if (!try c.less(s.coefficient, s.decade))
+        try c.call("add", &.{ s.adjusted_k, 1 }, s.adjusted_k);
+    if (try c.less(s.adjusted_k, s.min_k) or try c.less(s.max_k, s.adjusted_k))
+        return error.GraphF64Arithmetic;
+    for (0..17) |_| {
+        try c.divide(s.coefficient, s.ten, s.trim_q, s.trim_r);
+        if (try c.nonzero(s.trim_r)) break;
+        c.move(s.coefficient, s.trim_q);
+        try c.call("sub", &.{ s.scale, 1 }, s.scale);
+    }
+    if (try c.less(0, s.scale)) {
+        if (try c.less(s.max_scale, s.scale)) return error.GraphF64Arithmetic;
+        try c.call("add", &.{ s.hundred, s.scale }, s.control);
+    } else {
+        for (0..15) |_| {
+            if (!try c.nonzero(s.scale)) break;
+            try c.call("decimal_mul", &.{ s.coefficient, s.ten }, s.coefficient);
+            try c.call("add", &.{ s.scale, 1 }, s.scale);
+        }
+        if (try c.nonzero(s.scale)) return error.GraphF64Arithmetic;
+        c.move(s.control, s.integral);
+    }
+    try c.call("decimal_mul", &.{ s.coefficient, s.sign_factor }, s.coefficient);
+}
+
+/// The emitter may stop after BYTE tokens, so no bytes are published until its successful halt.
+fn publish(c: anytype, refs: [2]u32) !void {
+    var bytes: std.ArrayList(u8) = .empty;
+    defer bytes.deinit(c.m.gpa);
+    const template = c.m.bank.find("format_f64", 62) orelse return error.GraphEmitMissing;
+    c.end = try c.m.invoke(template, &refs, 0, c.budget, &bytes, c.cancel, true);
+    if (c.end != .halted) return error.GraphAlgorithmStopped;
+    if (bytes.items.len > packet.max_output or c.out.items.len > packet.max_output - bytes.items.len)
+        return error.GraphOutputSize;
+    try c.out.appendSlice(c.m.gpa, bytes.items);
+}
diff --git a/zig/src/core/runner_graph_factor.zig b/zig/src/core/runner_graph_factor.zig
new file mode 100644
index 000000000..9ebb2f57a
--- /dev/null
+++ b/zig/src/core/runner_graph_factor.zig
@@ -0,0 +1,113 @@
+//! Bounded trial division follows prepared FFN predicates and keeps operand arithmetic inside the graph bank.
+const std = @import("std");
+const packet = @import("runner_graph_packet.zig");
+const printing = @import("runner_graph_print.zig");
+
+const max_factors = packet.max_digits * 4;
+const max_iterations = 10000 + max_factors;
+
+/// Inputs are n>=1 and inclusive bound 1..10000; negative signs, including signed zero, are domain errors.
+pub fn smallest(c: anytype) !u32 {
+    return trial(c, null);
+}
+
+/// Emits (remaining, count, f1, ..., fk) with a newline; n=1 emits (1, 0), and zero is rejected.
+pub fn factorize(c: anytype) !void {
+    var factors: std.ArrayList(packet.Value) = .empty;
+    defer factors.deinit(c.m.gpa);
+    _ = try trial(c, &factors);
+    var bytes: std.ArrayList(u8) = .empty;
+    defer bytes.deinit(c.m.gpa);
+    try emit(c, 5, .comma_space, true, &bytes);
+    try emit(c, 9, if (factors.items.len == 0) .close else .comma_space, false, &bytes);
+    for (factors.items, 0..) |value, i| {
+        c.m.values[14] = value;
+        try emit(c, 14, if (i + 1 == factors.items.len) .close else .comma_space, false, &bytes);
+    }
+    if (c.out.items.len > packet.max_output - bytes.items.len) return error.GraphOutputSize;
+    try c.out.appendSlice(c.m.gpa, bytes.items);
+}
+
+fn emit(c: anytype, ref: u32, ending: packet.Ending, prefix: bool, bytes: *std.ArrayList(u8)) !void {
+    c.end = try printing.emit(c.m, .{ .ref = ref, .ending = ending, .prefix = prefix }, c.budget, bytes, c.cancel);
+    if (c.end != .halted) return error.GraphAlgorithmStopped;
+}
+
+/// Slots 5..11 hold remaining, candidate, quotient, remainder, count, two and the bound ceiling.
+fn trial(c: anytype, factors: ?*std.ArrayList(packet.Value)) !u32 {
+    try c.meta(2, 3);
+    if (try c.flag(2) or try c.flag(3)) return error.GraphAlgorithmArithmetic;
+    if (!try c.flag(0) or !try c.flag(1)) return error.GraphAlgorithmArithmetic;
+    c.move(5, 20);
+    c.m.values[11] = try packet.literal("10000");
+    try c.meta(11, 3);
+    if (try c.flag(4)) return error.GraphAlgorithmArithmetic;
+    c.move(9, 0);
+    try c.meta(5, 1);
+    if (try c.flag(5)) return 1;
+    c.m.values[10] = try packet.literal("2");
+    c.move(6, 10);
+    var even = true;
+    for (0..max_iterations) |_| {
+        if (even) {
+            try c.call("half", &.{5}, 12);
+            c.move(7, 12);
+            c.move(8, 13);
+        } else try divide(c);
+        try c.meta(7, 6);
+        if (try c.flag(4)) {
+            if (factors) |list| {
+                try retain(c, list, 5);
+                c.move(5, 1);
+            }
+            return 5;
+        }
+        try c.meta(3, 6);
+        if (try c.flag(4)) return 0;
+        if (!try c.nonzero(8)) {
+            if (factors) |list| {
+                try retain(c, list, 6);
+                c.move(5, 7);
+                try c.meta(5, 1);
+                if (try c.flag(5)) return 5;
+                continue;
+            }
+            return 6;
+        }
+        try c.call("add", &.{ 6, if (even) @as(u32, 1) else 10 }, 6);
+        even = false;
+    }
+    return error.GraphAlgorithmLimit;
+}
+
+fn retain(c: anytype, factors: *std.ArrayList(packet.Value), ref: u32) !void {
+    if (factors.items.len >= max_factors) return error.GraphAlgorithmLimit;
+    try factors.append(c.m.gpa, c.m.values[ref]);
+    try c.call("add", &.{ 9, 1 }, 9);
+}
+
+/// Only occupied digit lanes are scheduled; quotient assembly copies FFN output bits without decoding them.
+fn divide(c: anytype) !void {
+    c.move(24, 5);
+    c.move(25, 6);
+    c.move(26, 0);
+    c.move(27, 0);
+    var digit: usize = c.width;
+    while (digit > 1) : (digit -= 1) {
+        const at = digit - 1;
+        var occupied = false;
+        for (c.m.values[24][at / 31][2 + at % 31 * 4 ..][0..4]) |bit|
+            occupied = occupied or bit != 0;
+        if (occupied) break;
+    }
+    while (digit > 0) {
+        digit -= 1;
+        c.move(28, 0);
+        packet.copyBits(&c.m.values[28], &c.m.values[24], .{ .ref = 24, .from = @intCast(digit), .digits = 1 });
+        try c.call("divstep", &.{ 27, 25, 28 }, 29);
+        c.move(27, 29);
+        packet.copyBits(&c.m.values[26], &c.m.values[30], .{ .ref = 30, .to = @intCast(digit), .digits = 1 });
+    }
+    c.move(7, 26);
+    c.move(8, 27);
+}
diff --git a/zig/src/core/runner_graph_frontend.zig b/zig/src/core/runner_graph_frontend.zig
new file mode 100644
index 000000000..671806d5d
--- /dev/null
+++ b/zig/src/core/runner_graph_frontend.zig
@@ -0,0 +1,15 @@
+//! A graph-only frontend that binds exact integer cells without invoking the Python/RV32 frontend.
+const std = @import("std");
+const api = @import("runner_api.zig");
+const Bank = @import("runner_graph_bank.zig").Bank;
+const bind = @import("runner_graph_bind.zig");
+
+pub fn frontend(bank: *const Bank) api.Frontend {
+    return .{ .ctx = @constCast(bank), .translate = translate };
+}
+
+fn translate(ctx: ?*anyopaque, a: std.mem.Allocator, cell: api.Cell) std.mem.Allocator.Error!api.Translation {
+    const bank: *const Bank = @ptrCast(@alignCast(ctx.?));
+    const bytes = try bind.cell(a, bank, cell) orelse return .{ .abstain = .unsupported };
+    return .{ .program = .{ .kind = .graph, .bytes = bytes } };
+}
diff --git a/zig/src/core/runner_graph_lazy.zig b/zig/src/core/runner_graph_lazy.zig
new file mode 100644
index 000000000..36ee6ca51
--- /dev/null
+++ b/zig/src/core/runner_graph_lazy.zig
@@ -0,0 +1,46 @@
+//! Logical bindings validated offline and again before publishing a lazily decoded circuit.
+const std = @import("std");
+const model = @import("steps_v1/runner_circuit_model.zig");
+const packet = @import("runner_graph_packet.zig");
+const missing = std.math.maxInt(u32);
+pub const Slots = [packet.max_arity][packet.max_groups]u32;
+
+pub const Binding = struct {
+    inputs: u8 = 0,
+    outputs: u8 = 0,
+    in_slots: Slots = @splat(@splat(missing)),
+    out_slots: Slots = @splat(@splat(missing)),
+
+    pub fn inspect(c: *const model.Circuit, width: u8) !Binding {
+        if (!packet.widthValid(width)) return error.GraphTemplate;
+        if (c.program.a_bit != packet.bit_scale or c.program.a_ref != packet.reference_scale)
+            return error.GraphValueScale;
+        if (c.tables.len != c.table_names.len) return error.GraphSlots;
+        var out: Binding = .{};
+        for (c.table_names, 0..) |name, table| {
+            if (std.mem.startsWith(u8, name, "output.cursor")) continue;
+            const input = std.mem.startsWith(u8, name, "in");
+            const output = std.mem.startsWith(u8, name, "out");
+            if (!input and !output) continue;
+            const prefix: usize = if (input) 2 else 3;
+            const dot = std.mem.indexOfScalarPos(u8, name, prefix, '.') orelse return error.GraphSlots;
+            const logical = std.fmt.parseInt(u8, name[prefix..dot], 10) catch return error.GraphSlots;
+            const offset = std.fmt.parseInt(u8, name[dot + 1 ..], 10) catch return error.GraphSlots;
+            if (logical >= packet.max_arity or offset % 31 != 0 or offset >= width) return error.GraphSlots;
+            const target = if (input) &out.in_slots else &out.out_slots;
+            const group = offset / 31;
+            if (target[logical][group] != missing or c.tables[table].rows.len != 128 * 128)
+                return error.GraphSlots;
+            target[logical][group] = @intCast(table);
+            const arity = if (input) &out.inputs else &out.outputs;
+            arity.* = @max(arity.*, logical + 1);
+        }
+        if (out.inputs == 0 or out.outputs == 0) return error.GraphSlots;
+        const groups = (@as(usize, width) + 30) / 31;
+        for (out.in_slots[0..out.inputs]) |s| for (s[0..groups]) |idx| if (idx == missing)
+            return error.GraphSlots;
+        for (out.out_slots[0..out.outputs]) |s| for (s[0..groups]) |idx| if (idx == missing)
+            return error.GraphSlots;
+        return out;
+    }
+};
diff --git a/zig/src/core/runner_graph_machine.zig b/zig/src/core/runner_graph_machine.zig
new file mode 100644
index 000000000..08851f4f9
--- /dev/null
+++ b/zig/src/core/runner_graph_machine.zig
@@ -0,0 +1,188 @@
+//! A fresh binding machine replays immutable template calls and transfers raw typed tensor rows.
+const std = @import("std");
+const api = @import("runner_api.zig");
+const State = @import("steps_v1/runner_circuit_state.zig").State;
+const state_cache = @import("runner_graph_state_cache.zig");
+const eval = @import("steps_v1/runner_circuit_eval.zig");
+const bank_mod = @import("runner_graph_bank.zig");
+const packet = @import("runner_graph_packet.zig");
+const algorithms = @import("runner_graph_algorithms.zig");
+const printing = @import("runner_graph_print.zig");
+const Allocator = std.mem.Allocator;
+
+pub const Machine = struct {
+    gpa: Allocator,
+    bank: *const bank_mod.Bank,
+    parsed: std.json.Parsed(packet.Packet),
+    values: []packet.Value,
+    ops: []const packet.Op,
+    result: u32,
+    initial: usize,
+    steps: u64 = 0,
+    used: bool = false,
+    trace: ?*std.ArrayList(u32) = null,
+    states: state_cache.Cache = .{},
+    reuse_states: bool = true,
+    adaptive_widths: bool = true,
+    algorithm: ?[]const u8 = null,
+    width: u16 = 62,
+    precision: u8 = 0,
+    prints: []const packet.Print = &.{},
+    decode: bool = true, // false: a template not yet prepared is error.GraphUnprepared, never decoded on this thread
+
+    pub fn boot(a: Allocator, bank: *const bank_mod.Bank, bytes: []const u8) !Machine {
+        if (bytes.len > packet.max_packet) return error.GraphPacketSize;
+        const parsed = try std.json.parseFromSlice(packet.Packet, a, bytes, .{});
+        errdefer parsed.deinit();
+        const p = parsed.value;
+        if (p.version != 1 or p.values.len > packet.max_values) return error.GraphPacket;
+        var ops = p.ops;
+        var result = p.result;
+        var constants: []const packet.Value = &.{};
+        var prepared_count: ?usize = null;
+        var algorithm: ?[]const u8 = null;
+        var width: u16 = 62;
+        var precision: u8 = 0;
+        if (p.plan) |name| {
+            if (p.ops.len != 0 or p.result != 0 or p.prints.len != 0) return error.GraphNamedPlanOverride;
+            const plan = bank.plan(name) orelse return error.GraphPlan;
+            if (p.values.len != plan.inputs) return error.GraphSlotArity;
+            ops = plan.ops;
+            result = plan.result;
+            constants = plan.constants;
+            prepared_count = plan.total_values;
+            algorithm = plan.algorithm;
+            width = plan.width;
+            precision = plan.precision;
+        }
+        if (constants.len > packet.max_values - p.values.len) return error.GraphPlanSize;
+        const initial = p.values.len + constants.len;
+        const count = prepared_count orelse try bank.validate(initial, ops, result);
+        try bank.validatePrints(p.prints, count);
+        const values = try a.alloc(packet.Value, count);
+        errdefer a.free(values);
+        for (p.values, values[0..p.values.len]) |text, *v| v.* = try packet.literal(text);
+        if (algorithm != null) for (values[0..p.values.len]) |*v| try fits(v, width);
+        @memcpy(values[p.values.len..initial], constants);
+        return .{ .gpa = a, .bank = bank, .parsed = parsed, .values = values, .ops = ops, .result = result, .initial = initial, .algorithm = algorithm, .width = width, .precision = precision, .prints = p.prints };
+    }
+
+    pub fn deinit(m: *Machine) void {
+        m.states.deinit(m.gpa);
+        m.gpa.free(m.values);
+        m.parsed.deinit();
+        m.* = undefined;
+    }
+
+    pub fn run(m: *Machine, budget: u64, out: *std.ArrayList(u8), cancel: ?*const std.atomic.Value(bool)) !api.RunEnd {
+        if (m.used) return error.GraphMachineAlreadyRun;
+        m.used = true;
+        if (m.algorithm) |kind| return algorithms.run(m, kind, m.width, budget, out, cancel);
+        var count = m.initial;
+        for (m.ops) |op| {
+            if (cancelled(cancel)) return .{ .end = .cancelled, .steps = m.steps };
+            if (std.mem.eql(u8, op.op, "bind")) {
+                var v: packet.Value = @splat(@splat(0));
+                for (op.copies) |c| packet.copyBits(&v, &m.values[c.ref], c);
+                if (op.flags) |ref| @memcpy(v[0][126..128], m.values[ref][0][126..128]);
+                m.values[count] = v;
+            } else {
+                const family = std.meta.stringToEnum(packet.Algorithm, op.op);
+                const t = if (family == null) m.bank.find(op.op, op.width).? else null;
+                const arity = if (family) |f| packet.algorithmArity(f) else t.?.inputs;
+                var refs: [packet.max_arity]u32 = undefined;
+                const args = if (op.args) |args| args else blk: {
+                    refs[0] = op.a;
+                    if (op.b) |b| refs[1] = b;
+                    break :blk refs[0..arity];
+                };
+                const end = if (family != null) try algorithms.compute(m, op.op, op.width, op.precision, args, count, budget, out, cancel) else try m.invoke(t.?, args, count, budget, out, cancel, false);
+                if (end != .halted) return .{ .end = end, .steps = m.steps };
+            }
+            if (op.checked) for (m.values[count .. count + op.outputs]) |value| {
+                const flag = value[0][127];
+                if (flag == packet.bit_scale) return error.GraphArithmetic;
+                if (flag != 0) return error.GraphPredicate;
+            };
+            count += op.outputs;
+        }
+        if (m.prints.len != 0) {
+            const validated = try printing.validateBytes(m, m.prints, budget, out, cancel);
+            if (validated != .halted) return .{ .end = validated, .steps = m.steps };
+            for (m.prints) |p| {
+                const end = try printing.emit(m, p, budget, out, cancel);
+                if (end != .halted) return .{ .end = end, .steps = m.steps };
+            }
+            return .{ .end = .halted, .steps = m.steps };
+        }
+        const width = packet.outputWidth(&m.values[m.result]);
+        const emitter = m.bank.find("emit", width) orelse return error.GraphEmitMissing;
+        const end = try m.invoke(emitter, &.{m.result}, 0, budget, out, cancel, true);
+        return .{ .end = end, .steps = m.steps };
+    }
+
+    pub fn invoke(m: *Machine, t: *const bank_mod.Template, refs: []const u32, dest: usize, budget: u64, out: *std.ArrayList(u8), cancel: ?*const std.atomic.Value(bool), emit: bool) !End {
+        if (refs.len != t.inputs) return error.GraphSlotArity;
+        if (m.steps >= budget) return .budget;
+        if (cancelled(cancel)) return .cancelled;
+        for (refs) |ref| try fits(&m.values[ref], t.width);
+        if (!m.decode and !t.isPrepared()) return error.GraphUnprepared;
+        try t.prepare();
+        if (cancelled(cancel)) return .cancelled;
+        var fresh: State = undefined;
+        const state = if (m.reuse_states) try m.states.get(m.gpa, t) else blk: {
+            fresh = try State.init(m.gpa, &t.circuit);
+            break :blk &fresh;
+        };
+        defer if (m.reuse_states) state_cache.reset(state) else state.deinit();
+        const groups = (@as(usize, t.width) + 30) / 31;
+        for (refs, 0..) |ref, logical| for (0..groups) |group| {
+            const table = t.in_slots[logical][group];
+            try state.own(table);
+            var row: [128]f32 = undefined;
+            @memcpy(&row, state.row(table, 0));
+            @memcpy(row[2..128], m.values[ref][group][2..128]);
+            try state.writeRow(table, 0, &row);
+        };
+        var token = t.circuit.go;
+        while (token != t.circuit.halt) {
+            if (cancelled(cancel)) return .cancelled;
+            if (m.steps >= budget) return .budget;
+            token = try eval.step(state, token);
+            m.steps += 1;
+            if (m.trace) |trace| try trace.append(m.gpa, token);
+            const fam, const payload = t.circuit.split(token) orelse return error.GraphOutputToken;
+            if (t.circuit.fault_family) |fault| if (fam == fault) return .fault;
+            if (fam == t.circuit.byte_family) {
+                if (!emit or payload > 255) return error.GraphUnexpectedByte;
+                if (out.items.len >= packet.max_output) return error.GraphOutputSize;
+                try out.append(m.gpa, @intCast(payload));
+            }
+        }
+        if (!emit) {
+            for (0..t.outputs) |logical| {
+                var v: packet.Value = @splat(@splat(0));
+                for (0..groups) |group| {
+                    const table = t.out_slots[logical][group];
+                    if (!state.rowPresent(table, 0)) return error.GraphOutputAbsent;
+                    @memcpy(&v[group], state.row(table, 0));
+                }
+                m.values[dest + logical] = v;
+            }
+        }
+        return .halted;
+    }
+};
+
+const End = @FieldType(api.RunEnd, "end");
+
+fn cancelled(flag: ?*const std.atomic.Value(bool)) bool {
+    return if (flag) |f| f.load(.acquire) else false;
+}
+
+fn fits(v: *const packet.Value, width: u16) !void {
+    for (width..packet.max_digits) |digit| {
+        const bits = v[digit / 31][2 + digit % 31 * 4 ..][0..4];
+        for (bits) |bit| if (bit != 0) return error.GraphNarrowBinding;
+    }
+}
diff --git a/zig/src/core/runner_graph_pack.zig b/zig/src/core/runner_graph_pack.zig
new file mode 100644
index 000000000..8aec2b67e
--- /dev/null
+++ b/zig/src/core/runner_graph_pack.zig
@@ -0,0 +1,48 @@
+//! Offline CLI: runner-graph-pack INPUT.tfimr OUTPUT.tfgp; runtime never uses this compiler path.
+const std = @import("std");
+const model = @import("steps_v1/runner_circuit_model.zig");
+const binary = @import("runner_graph_binary.zig");
+const loader = @import("steps_v1/runner_circuit_load.zig");
+const Identity = struct { experimental: struct { kind: []const u8, contract: struct { op: []const u8, width: u16 } } };
+
+pub fn main(init: std.process.Init) !void {
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+    if (args.len != 3) return error.ExpectedInputAndOutputPaths;
+    const source = try std.Io.Dir.cwd().readFileAlloc(init.io, args[1], init.gpa, .limited(1 << 30));
+    defer init.gpa.free(source);
+    const payload, _ = try loader.payload(source);
+    const identity = try std.json.parseFromSlice(Identity, init.gpa, payload, .{ .ignore_unknown_fields = true });
+    defer identity.deinit();
+    const contract = identity.value.experimental.contract;
+    if (!std.mem.eql(u8, identity.value.experimental.kind, "graph_template") or
+        !@import("runner_graph_packet.zig").widthValid(contract.width) or contract.width == 255) return error.ExpectedGraphTemplate;
+    var circuit = try loader.fromBytes(init.gpa, source);
+    defer circuit.deinit(init.gpa);
+    try requireGraph(&circuit, contract.width);
+    circuit.program.image.rom = &.{};
+    circuit.program.image.drom = &.{};
+    circuit.program.image.ram = &.{};
+    circuit.program.ram_tables = @splat(std.math.maxInt(u32));
+    circuit.program.input_address = 0;
+    circuit.program.input_capacity = 0;
+    circuit.program.kind = .elf;
+    const bytes = try binary.encode(init.gpa, circuit, contract.op, contract.width);
+    defer init.gpa.free(bytes);
+    try std.Io.Dir.cwd().writeFile(init.io, .{ .sub_path = args[2], .data = bytes });
+}
+
+fn requireGraph(c: *const model.Circuit, width: u16) !void {
+    var input = false;
+    var output = false;
+    for (c.table_names) |name| {
+        if (std.mem.startsWith(u8, name, "output.cursor")) continue;
+        if (std.mem.eql(u8, name, "in0.0")) input = true;
+        if (std.mem.eql(u8, name, "out0.0")) output = true;
+        const prefix: usize = if (std.mem.startsWith(u8, name, "in")) 2 else if (std.mem.startsWith(u8, name, "out")) 3 else continue;
+        const dot = std.mem.indexOfScalarPos(u8, name, prefix, '.') orelse return error.ExpectedGraphTemplate;
+        const logical = std.fmt.parseInt(u32, name[prefix..dot], 10) catch return error.ExpectedGraphTemplate;
+        const offset = std.fmt.parseInt(u32, name[dot + 1 ..], 10) catch return error.ExpectedGraphTemplate;
+        if (logical >= 16 or offset % 31 != 0 or offset >= width) return error.ExpectedGraphTemplate;
+    }
+    if (!input or !output) return error.ExpectedGraphTemplate;
+}
diff --git a/zig/src/core/runner_graph_packet.zig b/zig/src/core/runner_graph_packet.zig
new file mode 100644
index 000000000..0a24cf256
--- /dev/null
+++ b/zig/src/core/runner_graph_packet.zig
@@ -0,0 +1,435 @@
+//! Bounded literal binding packets and pure frontend serialization; operations contain no executable graph IR.
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+pub const max_packet = 1 << 20;
+pub const max_ops = 8192;
+pub const max_values = 8192;
+pub const max_arity = 16;
+pub const max_prints = 128;
+pub const max_output = 4096;
+pub const max_digits: usize = 256;
+pub const max_groups = (max_digits + 30) / 31;
+pub const Value = [max_groups][128]f32;
+pub const bit_scale: f32 = 128;
+pub const reference_scale: f32 = 16777216;
+
+pub const Copy = struct {
+    ref: u32,
+    from: u16 = 0,
+    to: u16 = 0,
+    digits: u16 = 62,
+};
+
+pub const Op = struct {
+    op: []const u8,
+    width: u16 = 62,
+    a: u32 = 0,
+    b: ?u32 = null,
+    args: ?[]const u32 = null,
+    outputs: u8 = 1,
+    copies: []const Copy = &.{},
+    flags: ?u32 = null,
+    precision: u8 = 0,
+    checked: bool = false,
+};
+
+pub const Style = enum { integer, fixed, comma, integral_float, boolean, fraction, tuple, byte, prepared };
+pub const Ending = enum { newline, space, empty, comma_space, close, slash, close_space, close_empty, close_comma_space };
+pub const Print = struct {
+    ref: u32,
+    second: ?u32 = null,
+    style: Style = .integer,
+    precision: u8 = 0,
+    ending: Ending = .newline,
+    prefix: bool = false,
+};
+
+pub const Packet = struct {
+    version: u32 = 1,
+    values: []const []const u8,
+    plan: ?[]const u8 = null,
+    ops: []const Op = &.{},
+    result: u32 = 0,
+    prints: []const Print = &.{},
+};
+
+pub const Plan = struct {
+    name: []const u8,
+    inputs: u32,
+    literals: []const []const u8 = &.{},
+    ops: []const Op,
+    result: u32,
+    algorithm: ?[]const u8 = null,
+    width: u16 = 62,
+    precision: u8 = 0,
+};
+
+pub const Family = enum { add, sub, mul, div, mod, pow };
+pub const Algorithm = enum { powmod, gcd, isqrt, range_product, factorial, digit_sum, divmod, square_offset, fraction, fixed_div, divexact, smallest_factor, factorize, f64_ratio, f64_mul, f64_sub, f64_isclose, f64_repr, f64_format };
+pub const Shape = enum { sum, squares, factorial, fib, list_sum, sorted_distance };
+
+pub const Builder = struct {
+    pub fn encode(a: Allocator, packet: Packet) ![]u8 {
+        if (packet.version != 1 or packet.values.len > max_values or packet.ops.len > max_ops or packet.prints.len > max_prints)
+            return error.GraphPacketSize;
+        const bytes = try std.json.Stringify.valueAlloc(a, packet, .{});
+        errdefer a.free(bytes);
+        if (bytes.len > max_packet) return error.GraphPacketSize;
+        return bytes;
+    }
+
+    /// Binds a complete SSA program to preloaded kernels and compiled output formatters.
+    pub fn program(a: Allocator, values: []const []const u8, ops: []const Op, prints: []const Print) ![]u8 {
+        if (prints.len == 0) return error.GraphPrint;
+        for (values) |value| _ = try literal(value);
+        return encode(a, .{ .values = values, .ops = ops, .prints = prints });
+    }
+
+    pub fn named(a: Allocator, name: []const u8, values: []const []const u8) ![]u8 {
+        return encode(a, .{ .values = values, .plan = name });
+    }
+
+    /// Selects a preloaded plan from operand metadata without evaluating its answer.
+    pub fn binary(a: Allocator, family: Family, lhs: []const u8, rhs: []const u8) ![]u8 {
+        return binaryWidth(a, family, lhs, rhs, 128);
+    }
+
+    /// Optional basic capacity is explicit; callers select 256 only with an extended loaded bank.
+    pub fn binaryWidth(a: Allocator, family: Family, lhs: []const u8, rhs: []const u8, max_width: u16) ![]u8 {
+        if (max_width != 128 and max_width != 256) return error.GraphTemplate;
+        _ = try literal(lhs);
+        _ = try literal(rhs);
+        const wa = lhs.len - @intFromBool(lhs[0] == '-' or lhs[0] == '+');
+        const wb = rhs.len - @intFromBool(rhs[0] == '-' or rhs[0] == '+');
+        if (wa > max_width or wb > max_width) return error.GraphLiteral;
+        if (family == .pow) {
+            const exponent = std.fmt.parseInt(i16, rhs, 10) catch return error.GraphExponent;
+            if (exponent < 0 or exponent > 999) return error.GraphExponent;
+            const legacy_needed = wa * @max(@as(usize, 1), @as(usize, @intCast(exponent)));
+            const needed = if (max_width == 256 and legacy_needed > 128) @max(@as(usize, 128), @max(wa, powerDigits(lhs, @intCast(exponent)))) else legacy_needed;
+            const width: u16 = if (max_width == 256 and needed > 128) 256 else if (needed > 62) 128 else 62;
+            const name = try std.fmt.allocPrint(a, "pow-{d}-{d}", .{ exponent, width });
+            defer a.free(name);
+            return named(a, name, &.{lhs});
+        }
+        const needed = switch (family) {
+            .add, .sub => @max(wa, wb) + 1,
+            .mul => wa + wb,
+            .div, .mod => @max(wa, wb),
+            .pow => unreachable,
+        };
+        const width = for ([_]u16{ 1, 2, 4, 8, 16, 32, 62, 128, 256 }) |n| {
+            if (n >= @min(@as(usize, max_width), needed)) break n;
+        } else unreachable;
+        const name = try std.fmt.allocPrint(a, "{s}-{d}", .{ @tagName(family), width });
+        defer a.free(name);
+        return named(a, name, &.{ lhs, rhs });
+    }
+
+    /// Selects an offline integer algorithm using operand widths without evaluating the result.
+    pub fn integer(a: Allocator, family: Algorithm, operands: []const []const u8) ![]u8 {
+        if (family == .fixed_div) return error.GraphPrecision;
+        const arity = algorithmArity(family);
+        if (operands.len != arity) return error.GraphSlotArity;
+        var needed: usize = 1;
+        for (operands) |operand| {
+            _ = try literal(operand);
+            const digits = operand.len - @intFromBool(operand[0] == '-' or operand[0] == '+');
+            if (digits > (if (family == .divmod or family == .powmod) @as(usize, 256) else 128)) return error.GraphLiteral;
+            needed = @max(needed, digits);
+        }
+        const width: u16 = if (family == .factorial or family == .range_product or
+            std.mem.startsWith(u8, @tagName(family), "f64_")) 128 else blk: {
+            for ([_]u16{ 1, 2, 4, 8, 16, 32, 62, 128, 256 }) |n| if (needed <= n) break :blk n;
+            unreachable;
+        };
+        const name = try std.fmt.allocPrint(a, "{s}-{d}", .{ @tagName(family), width });
+        defer a.free(name);
+        return named(a, name, operands);
+    }
+
+    /// Precision is bounded schedule metadata; all quotient and rounding work stays in prepared FFNs.
+    pub fn fixedDivision(a: Allocator, lhs: []const u8, rhs: []const u8, places: u8) ![]u8 {
+        if (places > 18) return error.GraphPrecision;
+        _ = try literal(lhs);
+        _ = try literal(rhs);
+        if (lhs.len - @intFromBool(lhs[0] == '-' or lhs[0] == '+') > 128 or
+            rhs.len - @intFromBool(rhs[0] == '-' or rhs[0] == '+') > 128)
+            return error.GraphNarrowBinding;
+        const needed = @max(lhs.len - @intFromBool(lhs[0] == '-' or lhs[0] == '+') + places + 1, rhs.len - @intFromBool(rhs[0] == '-' or rhs[0] == '+'));
+        const width = for ([_]u8{ 1, 2, 4, 8, 16, 32, 62, 128 }) |n| {
+            if (n >= @min(@as(usize, 128), needed)) break n;
+        } else unreachable;
+        const name = try std.fmt.allocPrint(a, "fixed_div-{d}-{d}", .{ places, width });
+        defer a.free(name);
+        return named(a, name, &.{ lhs, rhs });
+    }
+
+    /// Binds a recognized bounded-loop shape to its offline control schedule.
+    pub fn loop(a: Allocator, shape: Shape, bound: u16, values: []const []const u8) ![]u8 {
+        return loopWidth(a, shape, bound, values, 62);
+    }
+
+    pub fn loopWidth(a: Allocator, shape: Shape, bound: u16, values: []const []const u8, width: u16) ![]u8 {
+        if (shape == .sorted_distance) {
+            if (!widthValid(width) or width > 128 or bound > 16) return error.GraphLoop;
+        } else if (width != 62 and width != 128) return error.GraphLoop;
+        if (bound > 128 or values.len != (if (shape == .list_sum or shape == .sorted_distance) @as(usize, bound) else 0))
+            return error.GraphLoop;
+        for (values) |value| {
+            _ = try literal(value);
+            if (value.len - @intFromBool(value[0] == '-' or value[0] == '+') > 128)
+                return error.GraphNarrowBinding;
+        }
+        const name = try std.fmt.allocPrint(a, "loop-{s}-{d}-{d}", .{ @tagName(shape), bound, width });
+        defer a.free(name);
+        return named(a, name, values);
+    }
+
+    /// Selects a bounded compare-exchange schedule; pair count is control metadata, never operand arithmetic.
+    pub fn sortedDistance(a: Allocator, values: []const []const u8) ![]u8 {
+        if (values.len > 16) return error.GraphLoop;
+        var digits: usize = 1;
+        for (values) |value| {
+            _ = try literal(value);
+            const occupied = value.len - @intFromBool(value[0] == '-' or value[0] == '+');
+            if (occupied > 128) return error.GraphNarrowBinding;
+            digits = @max(digits, occupied);
+        }
+        var text: [8]u8 = undefined;
+        const pairs = values.len * (values.len -| 1);
+        const overhead = (try std.fmt.bufPrint(&text, "{d}", .{pairs})).len;
+        const width = for ([_]u8{ 1, 2, 4, 8, 16, 32, 62, 128 }) |n| {
+            if (n >= @min(@as(usize, 128), digits + overhead)) break n;
+        } else unreachable;
+        return loopWidth(a, .sorted_distance, @intCast(values.len), values, width);
+    }
+};
+
+pub fn algorithmArity(family: Algorithm) u8 {
+    return switch (family) {
+        .f64_mul, .f64_sub => 4,
+        .f64_isclose => 8,
+        .f64_ratio, .f64_repr, .f64_format => 2,
+        .powmod => 3,
+        .gcd, .range_product, .divmod, .square_offset, .fraction, .fixed_div, .divexact, .smallest_factor, .factorize => 2,
+        .isqrt, .factorial, .digit_sum => 1,
+    };
+}
+
+pub fn algorithmOutputs(family: Algorithm) u8 {
+    return if (family == .divmod or family == .fraction or family == .f64_ratio or family == .f64_mul or family == .f64_sub or family == .f64_format) 2 else 1;
+}
+
+pub fn algorithmWidthValid(family: Algorithm, width: u16) bool {
+    return widthValid(width) and (width <= 128 or (width == 256 and (family == .divmod or family == .powmod)));
+}
+
+// Width 255 is an internal alias for unchanged lazy binding head coverage; public banks reject it.
+pub fn widthValid(n: u16) bool {
+    return switch (n) {
+        1, 2, 4, 8, 16, 32, 62, 128, 255, 256 => true,
+        else => false,
+    };
+}
+
+pub fn literal(text: []const u8) !Value {
+    if (text.len == 0) return error.GraphLiteral;
+    const signed = text[0] == '-' or text[0] == '+';
+    const digits = text[@intFromBool(signed)..];
+    if (digits.len == 0 or digits.len > max_digits) return error.GraphLiteral;
+    var value: Value = @splat(@splat(0));
+    for (&value) |*row| {
+        row[0] = reference_scale;
+        row[1] = reference_scale;
+    }
+    value[0][126] = if (text[0] == '-') bit_scale else 0;
+    for (digits, 0..) |ch, i| {
+        if (ch < '0' or ch > '9') return error.GraphLiteral;
+        const digit = digits.len - i - 1;
+        for (0..4) |bit| value[digit / 31][2 + digit % 31 * 4 + bit] =
+            if ((ch - '0') >> @as(u3, @intCast(bit)) & 1 != 0) bit_scale else 0;
+    }
+    return value;
+}
+
+/// A literal magnitude bound chooses storage; no power result is evaluated on the host.
+fn powerDigits(text: []const u8, exponent: u16) usize {
+    if (exponent == 0) return 1;
+    const digits = text[@intFromBool(text[0] == '-' or text[0] == '+')..];
+    const magnitude = std.fmt.parseInt(u1024, digits, 10) catch return digits.len * exponent;
+    const bits: usize = if (magnitude <= 1) 0 else 1024 - @as(usize, @clz(magnitude - 1));
+    // 30103/100000 is a strict upper bound on log10(2).
+    return bits * exponent * 30103 / 100000 + 1;
+}
+
+/// Chooses an output template from occupied tensor bits without decoding the integer.
+pub fn outputWidth(value: *const Value) u16 {
+    var width: u16 = 62;
+    for (62..max_digits) |digit| {
+        const bits = value[digit / 31][2 + digit % 31 * 4 ..][0..4];
+        for (bits) |bit| if (bit != 0) {
+            if (digit >= 128) return 256;
+            width = 128;
+        };
+    }
+    return width;
+}
+
+pub fn copyBits(out: *Value, source: *const Value, c: Copy) void {
+    for (0..c.digits) |i| {
+        const src = @as(usize, c.from) + i;
+        const dst = @as(usize, c.to) + i;
+        @memcpy(out[dst / 31][2 + dst % 31 * 4 ..][0..4], source[src / 31][2 + src % 31 * 4 ..][0..4]);
+    }
+}
+
+test "frontend binding selects offline plans and rejects invalid controls" {
+    const t = std.testing;
+    const sum = try Builder.binary(t.allocator, .add, "-999", "1");
+    defer t.allocator.free(sum);
+    try t.expect(std.mem.indexOf(u8, sum, "add-4") != null);
+    const power = try Builder.binary(t.allocator, .pow, "2", "100");
+    defer t.allocator.free(power);
+    try t.expect(std.mem.indexOf(u8, power, "pow-100-128") != null);
+    try t.expectError(error.GraphExponent, Builder.binary(t.allocator, .pow, "2", "-1"));
+    try t.expectError(error.GraphLiteral, Builder.binary(t.allocator, .mul, "12x", "3"));
+    const squares = try Builder.loop(t.allocator, .squares, 10, &.{});
+    defer t.allocator.free(squares);
+    try t.expect(std.mem.indexOf(u8, squares, "loop-squares-10-62") != null);
+    try t.expectError(error.GraphLoop, Builder.loop(t.allocator, .squares, 129, &.{}));
+    try t.expectError(error.GraphLoop, Builder.loop(t.allocator, .list_sum, 2, &.{"1"}));
+}
+
+test "128 digit bindings span five groups and retain explicit wide plans" {
+    const t = std.testing;
+    const text: [128]u8 = @splat('9');
+    const too_wide: [max_digits + 1]u8 = @splat('9');
+    const value = try literal(&text);
+    try t.expectEqual(bit_scale, value[4][14]);
+    try t.expectEqual(@as(f32, 0), value[4][15]);
+    try t.expectError(error.GraphLiteral, literal(&too_wide));
+    var copied: Value = @splat(@splat(0));
+    copyBits(&copied, &value, .{ .ref = 0, .from = 124, .to = 30, .digits = 4 });
+    try t.expectEqual(bit_scale, copied[0][122]);
+    try t.expectEqual(bit_scale, copied[1][10]);
+    const sum = try Builder.binary(t.allocator, .add, &text, "1");
+    defer t.allocator.free(sum);
+    try t.expect(std.mem.indexOf(u8, sum, "add-128") != null);
+    const power = try Builder.binary(t.allocator, .pow, &text, "1");
+    defer t.allocator.free(power);
+    try t.expect(std.mem.indexOf(u8, power, "pow-1-128") != null);
+    const loop = try Builder.loopWidth(t.allocator, .factorial, 80, &.{}, 128);
+    defer t.allocator.free(loop);
+    try t.expect(std.mem.indexOf(u8, loop, "loop-factorial-80-128") != null);
+    try t.expectError(error.GraphLoop, Builder.loopWidth(t.allocator, .fib, 10, &.{}, 32));
+}
+
+test "256 digit basic bindings preserve the final group and refuse unsupported algorithms" {
+    const t = std.testing;
+    const text: [256]u8 = @splat('9');
+    const value = try literal(&text);
+    try t.expectEqual(@as(usize, 9), max_groups);
+    try t.expect(widthValid(256));
+    try t.expect(algorithmWidthValid(.divmod, 256));
+    try t.expect(algorithmWidthValid(.powmod, 256));
+    const modular = try Builder.integer(t.allocator, .powmod, &.{ &text, "3", &text });
+    defer t.allocator.free(modular);
+    try t.expect(std.mem.indexOf(u8, modular, "powmod-256") != null);
+    try t.expectError(error.GraphLiteral, Builder.integer(t.allocator, .gcd, &.{ &text, "1" }));
+    try t.expect(!algorithmWidthValid(.gcd, 256));
+    try t.expect(!algorithmWidthValid(.divmod, 255));
+    try t.expect(!widthValid(257));
+    try t.expectError(error.GraphTemplate, Builder.binaryWidth(t.allocator, .add, "1", "1", 255));
+    try t.expectEqual(@as(u16, 256), outputWidth(&value));
+    try t.expectEqual(bit_scale, value[8][30]);
+    try t.expectEqual(@as(f32, 0), value[8][31]);
+    var copied: Value = @splat(@splat(0));
+    copyBits(&copied, &value, .{ .ref = 0, .from = 248, .to = 248, .digits = 8 });
+    try t.expectEqual(bit_scale, copied[8][30]);
+    try t.expectEqual(@as(u16, 256), outputWidth(&copied));
+    var complete: Value = @splat(@splat(0));
+    copyBits(&complete, &value, .{ .ref = 0, .digits = 256 });
+    try t.expectEqual(bit_scale, complete[8][30]);
+    const excessive: [257]u8 = @splat('9');
+    try t.expectError(error.GraphLiteral, literal(&excessive));
+    try t.expectError(error.GraphLiteral, Builder.binaryWidth(t.allocator, .mul, &excessive, "1", 256));
+    for ([_]usize{ 129, 191, 256 }) |digits| {
+        const boundary = try literal(text[0..digits]);
+        try t.expectEqual(@as(u16, 256), outputWidth(&boundary));
+        const product = try Builder.binaryWidth(t.allocator, .mul, text[0..digits], "1", 256);
+        defer t.allocator.free(product);
+        try t.expect(std.mem.indexOf(u8, product, "mul-256") != null);
+    }
+    const narrow = try literal("1");
+    try t.expectEqual(@as(u16, 62), outputWidth(&narrow));
+    const old: [128]u8 = @splat('9');
+    const old_value = try literal(&old);
+    try t.expectEqual(@as(u16, 128), outputWidth(&old_value));
+    const sum = try Builder.binaryWidth(t.allocator, .add, &text, "1", 256);
+    defer t.allocator.free(sum);
+    try t.expect(std.mem.indexOf(u8, sum, "add-256") != null);
+    const power = try Builder.binaryWidth(t.allocator, .pow, "3", "400", 256);
+    defer t.allocator.free(power);
+    try t.expect(std.mem.indexOf(u8, power, "pow-400-256") != null);
+    const zero_power = try Builder.binaryWidth(t.allocator, .pow, &text, "0", 256);
+    defer t.allocator.free(zero_power);
+    try t.expect(std.mem.indexOf(u8, zero_power, "pow-0-256") != null);
+    try t.expectError(error.GraphLiteral, Builder.binary(t.allocator, .add, &text, "0"));
+    const narrow_power = try Builder.binaryWidth(t.allocator, .pow, "2", "400", 256);
+    defer t.allocator.free(narrow_power);
+    try t.expect(std.mem.indexOf(u8, narrow_power, "pow-400-128") != null);
+    const division = try Builder.binaryWidth(t.allocator, .div, &text, "1", 256);
+    defer t.allocator.free(division);
+    try t.expect(std.mem.indexOf(u8, division, "div-256") != null);
+    const remainder = try Builder.binaryWidth(t.allocator, .mod, &text, "1", 256);
+    defer t.allocator.free(remainder);
+    try t.expect(std.mem.indexOf(u8, remainder, "mod-256") != null);
+    try t.expectError(error.GraphNarrowBinding, Builder.fixedDivision(t.allocator, &text, "1", 0));
+    try t.expectError(error.GraphLiteral, Builder.integer(t.allocator, .gcd, &.{ &text, "1" }));
+    try t.expectError(error.GraphLoop, Builder.loopWidth(t.allocator, .sorted_distance, 0, &.{}, 256));
+    try t.expectError(error.GraphNarrowBinding, Builder.sortedDistance(t.allocator, &.{&text}));
+}
+
+test "integer algorithms bind arity and maximum operand width" {
+    const t = std.testing;
