+test "runner frontend integer list: the scripts run on the real bank and print CPython's stdout (TF_RUNNER_GRAPH_BANK)" {
+    const g = std.c.getenv("TF_RUNNER_GRAPH_BANK") orelse return error.SkipZigTest;
