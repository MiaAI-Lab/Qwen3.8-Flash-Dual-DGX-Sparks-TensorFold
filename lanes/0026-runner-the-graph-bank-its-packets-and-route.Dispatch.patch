@@ -0,0 +1,234 @@
+//! Bounded graph workers over a boot-loaded bank; the engine thread never waits for a running job.
+const std = @import("std");
+const api = @import("runner_api.zig");
+const place = @import("runner_place.zig");
+pub const Bank = @import("runner_graph_bank.zig").Bank;
+pub const Machine = @import("runner_graph_machine.zig").Machine;
+pub const Packet = @import("runner_graph_packet.zig").Packet;
+pub const Op = @import("runner_graph_packet.zig").Op;
+pub const Plan = @import("runner_graph_packet.zig").Plan;
+pub const Print = @import("runner_graph_packet.zig").Print;
+pub const PrintStyle = @import("runner_graph_packet.zig").Style;
+pub const PrintEnding = @import("runner_graph_packet.zig").Ending;
+pub const Builder = @import("runner_graph_packet.zig").Builder;
+pub const id = "graph";
+pub const bindCell = @import("runner_graph_bind.zig").cell;
+pub const bindExpression = @import("runner_graph_bind.zig").expression;
+pub const bindScript = @import("runner_graph_bind.zig").script;
+pub const directFrontend = @import("runner_graph_frontend.zig").frontend;
+
+const Allocator = std.mem.Allocator;
+
+const Job = struct {
+    id: api.JobId,
+    stream: u64,
+    program: []u8,
+    graph: bool,
+    budget: u64,
+    thread: ?std.Thread = null,
+    done: std.atomic.Value(bool) = .init(false),
+    cancel: std.atomic.Value(bool) = .init(false),
+    result: api.Result = .{ .status = .abstain, .abstain = .unsupported },
+    out: std.ArrayList(u8) = .empty,
+};
+
+const Cpu = struct {
+    gpa: Allocator,
+    bank: *const Bank,
+    workers: u8,
+    placer: ?*place.Placer = null,
+    next_id: api.JobId = 1,
+    jobs: std.ArrayList(*Job) = .empty,
+    dropped: std.ArrayList(*Job) = .empty,
+    delivered: std.ArrayList(*Job) = .empty,
+    now_out: std.ArrayList(u8) = .empty, // the last run on the engine thread's output
+
+    fn live(c: *Cpu) usize {
+        return c.jobs.items.len + c.dropped.items.len;
+    }
+
+    fn free(c: *Cpu, j: *Job) void {
+        if (j.thread) |t| t.join();
+        j.out.deinit(c.gpa);
+        c.gpa.free(j.program);
+        c.gpa.destroy(j);
+    }
+
+    /// Joins and frees cancelled jobs whose worker has stopped.
+    fn reap(c: *Cpu) void {
+        var i: usize = 0;
+        while (i < c.dropped.items.len) {
+            const j = c.dropped.items[i];
+            if (!j.done.load(.acquire)) {
+                i += 1;
+                continue;
+            }
+            _ = c.dropped.swapRemove(i);
+            c.free(j);
+        }
+    }
+
+    /// `out` of a stream's previous result stays valid only until the next call for that stream.
+    fn forget(c: *Cpu, stream: u64) void {
+        var i: usize = 0;
+        while (i < c.delivered.items.len) {
+            if (c.delivered.items[i].stream != stream) {
+                i += 1;
+                continue;
+            }
+            c.free(c.delivered.swapRemove(i));
+        }
+    }
+
+    fn find(c: *Cpu, job_id: api.JobId) ?usize {
+        for (c.jobs.items, 0..) |j, i| if (j.id == job_id) return i;
+        return null;
+    }
+
+    fn drop(c: *Cpu, i: usize) void {
+        const j = c.jobs.swapRemove(i);
+        j.cancel.store(true, .release);
+        c.dropped.appendAssumeCapacity(j);
+    }
+};
+
+fn work(c: *Cpu, j: *Job) void {
+    if (c.placer) |p| p.enter();
+    var began: std.c.timespec = undefined;
+    _ = std.c.clock_gettime(.MONOTONIC, &began);
+    defer {
+        var ended: std.c.timespec = undefined;
+        _ = std.c.clock_gettime(.MONOTONIC, &ended);
+        const ns = (ended.sec - began.sec) * std.time.ns_per_s + ended.nsec - began.nsec;
+        j.result.exec_ns = @intCast(@max(0, ns));
+        j.done.store(true, .release);
+    }
+    if (!j.graph) return;
+    var m = Machine.boot(c.gpa, c.bank, j.program) catch return;
+    defer m.deinit();
+    const end = m.run(j.budget, &j.out, &j.cancel) catch {
+        j.out.clearRetainingCapacity();
+        j.result = .{ .status = .abstain, .abstain = .unsupported, .steps = m.steps };
+        return;
+    };
+    j.result = resultOf(end);
+}
+
+fn resultOf(end: api.RunEnd) api.Result {
+    return .{
+        .status = switch (end.end) {
+            .halted => .ok,
+            .budget => .budget,
+            .fault => .fault,
+            .cancelled => .abstain,
+        },
+        .steps = end.steps,
+        .abstain = if (end.end == .cancelled) .unsupported else null,
+    };
+}
+
+/// A job's run here, capped at `quick` steps: one that ends sooner is the job's own result; else (or an error) null.
+fn now(ctx: *anyopaque, program: api.Program, budget: u64, quick: u64) ?api.Result {
+    const c: *Cpu = @ptrCast(@alignCast(ctx));
+    if (!std.mem.eql(u8, @tagName(program.kind), id) or program.bytes.len > @import("runner_graph_packet.zig").max_packet) return null;
+    c.now_out.clearRetainingCapacity();
+    var t0: std.c.timespec = undefined;
+    _ = std.c.clock_gettime(.MONOTONIC, &t0);
+    var m = Machine.boot(c.gpa, c.bank, program.bytes) catch return null;
+    defer m.deinit();
+    m.decode = false; // the engine thread: a template's first decode (0.1-0.4 s wide) is the job's, in a hold
+    const cap = @min(budget, quick);
+    const end = m.run(cap, &c.now_out, null) catch return null;
+    if (end.end == .budget and cap < budget) return null;
+    var t1: std.c.timespec = undefined;
+    _ = std.c.clock_gettime(.MONOTONIC, &t1);
+    var r = resultOf(end);
+    r.out = c.now_out.items;
+    r.exec_ns = @intCast(@max(0, (t1.sec - t0.sec) * std.time.ns_per_s + t1.nsec - t0.nsec));
+    return r;
+}
+
+fn start(ctx: *anyopaque, stream: u64, program: api.Program, budget: u64) error{ OutOfMemory, Busy }!api.JobId {
+    const c: *Cpu = @ptrCast(@alignCast(ctx));
+    c.reap();
+    c.forget(stream);
+    if (c.live() >= c.workers) return error.Busy;
+    const j = try c.gpa.create(Job);
+    errdefer c.gpa.destroy(j);
+    const valid = std.mem.eql(u8, @tagName(program.kind), id) and
+        program.bytes.len <= @import("runner_graph_packet.zig").max_packet;
+    const bytes = try c.gpa.dupe(u8, if (valid) program.bytes else "");
+    errdefer c.gpa.free(bytes);
+    j.* = .{ .id = c.next_id, .stream = stream, .program = bytes, .graph = valid, .budget = budget };
+    try c.jobs.ensureUnusedCapacity(c.gpa, 1);
+    j.thread = std.Thread.spawn(.{}, work, .{ c, j }) catch return error.Busy;
+    c.jobs.appendAssumeCapacity(j);
+    c.next_id += 1;
+    return j.id;
+}
+
+fn poll(ctx: *anyopaque, job_id: api.JobId) api.Poll {
+    const c: *Cpu = @ptrCast(@alignCast(ctx));
+    c.reap();
+    const i = c.find(job_id) orelse return .{ .done = .{ .status = .abstain, .abstain = .unsupported } };
+    const j = c.jobs.items[i];
+    if (!j.done.load(.acquire)) return .running;
+    _ = c.jobs.swapRemove(i);
+    if (j.thread) |t| t.join();
+    j.thread = null;
+    c.forget(j.stream);
+    c.delivered.append(c.gpa, j) catch {
+        c.free(j);
+        return .{ .done = .{ .status = .abstain, .abstain = .unsupported } };
+    };
+    var r = j.result;
+    r.out = j.out.items;
+    return .{ .done = r };
+}
+
+fn cancel(ctx: *anyopaque, job_id: api.JobId) void {
+    const c: *Cpu = @ptrCast(@alignCast(ctx));
+    if (c.find(job_id)) |i| c.drop(i);
+    c.reap();
+}
+
+fn release(ctx: *anyopaque, stream: u64) void {
+    const c: *Cpu = @ptrCast(@alignCast(ctx));
+    var i: usize = 0;
+    while (i < c.jobs.items.len) {
+        if (c.jobs.items[i].stream == stream) c.drop(i) else i += 1;
+    }
+    c.forget(stream);
+    c.reap();
+}
+
+const vtable: api.Backend.VTable = .{ .start = start, .poll = poll, .cancel = cancel, .release = release, .now = now };
+
+/// Runs at most workers jobs over a bank the caller keeps alive; gpa must support worker-thread allocations.
+pub fn backend(gpa: Allocator, bank: *const Bank, workers: u8) !api.Backend {
+    return placed(gpa, bank, workers, null);
+}
+
+/// As `backend`, each job's thread placed by `placer` (which the caller keeps alive) before it boots a machine.
+pub fn placed(gpa: Allocator, bank: *const Bank, workers: u8, placer: ?*place.Placer) !api.Backend {
+    if (workers == 0) return error.NoWorkers;
+    const c = try gpa.create(Cpu);
+    errdefer gpa.destroy(c);
+    c.* = .{ .gpa = gpa, .bank = bank, .workers = workers, .placer = placer };
+    try c.dropped.ensureTotalCapacity(gpa, workers);
+    errdefer c.dropped.deinit(gpa);
+    try c.jobs.ensureTotalCapacity(gpa, workers);
+    return .{ .ctx = c, .vtable = &vtable };
+}
+
+/// Cancels every job, waits for the workers and frees the backend.
+pub fn destroy(b: api.Backend) void {
+    const c: *Cpu = @ptrCast(@alignCast(b.ctx));
+    for (c.jobs.items) |j| j.cancel.store(true, .release);
+    for ([_]*std.ArrayList(*Job){ &c.jobs, &c.dropped, &c.delivered }) |list| {
+        for (list.items) |j| c.free(j);
+        list.deinit(c.gpa);
+    }
+    c.now_out.deinit(c.gpa);
+    c.gpa.destroy(c);
+}
diff --git a/zig/src/core/runner_graph_algorithms.zig b/zig/src/core/runner_graph_algorithms.zig
new file mode 100644
index 000000000..1e83f43e7
--- /dev/null
+++ b/zig/src/core/runner_graph_algorithms.zig
@@ -0,0 +1,403 @@
+//! Integer algorithms orchestrate prepared FFNs and transfer raw rows without decoding operands.
+const std = @import("std");
+const api = @import("runner_api.zig");
+const packet = @import("runner_graph_packet.zig");
+const factor = @import("runner_graph_factor.zig");
+const End = @FieldType(api.RunEnd, "end");
+const Cancel = ?*const std.atomic.Value(bool);
+
+/// Executes an algorithm in request-local scratch and copies only its typed outputs back to the caller.
+pub fn compute(m: anytype, kind: []const u8, width: u16, precision: u8, refs: []const u32, dest: usize, budget: u64, out: *std.ArrayList(u8), cancel: Cancel) !End {
+    if (std.mem.startsWith(u8, kind, "f64_")) return @import("runner_graph_f64.zig").compute(m, kind, width, refs, dest, budget, out, cancel);
+    if (std.mem.eql(u8, kind, "factorize")) return error.GraphAlgorithm;
+    const family = std.meta.stringToEnum(packet.Algorithm, kind) orelse return error.GraphAlgorithm;
+    const outputs = packet.algorithmOutputs(family);
+    if (!packet.algorithmWidthValid(family, width) or refs.len != packet.algorithmArity(family) or dest + outputs > m.values.len)
+        return error.GraphAlgorithmScratch;
+    if (precision > 18 or (family != .fixed_div and precision != 0)) return error.GraphPrecision;
+    const original = m.values;
+    const zero = try packet.literal("0");
+    var scratch: [32]packet.Value = @splat(zero);
+    scratch[1] = try packet.literal("1");
+    for (refs, 0..) |ref, i| {
+        if (ref >= original.len) return error.GraphReference;
+        for (width..packet.max_digits) |digit| {
+            const bits = original[ref][digit / 31][2 + digit % 31 * 4 ..][0..4];
+            for (bits) |bit| if (bit != 0) return error.GraphNarrowBinding;
+        }
+        scratch[2 + i] = original[ref];
+    }
+    m.values = &scratch;
+    defer m.values = original;
+    const work_width = if (std.mem.eql(u8, kind, "smallest_factor")) @max(width, 8) else width;
+    var c: Context(@TypeOf(m)) = .{ .m = m, .width = work_width, .precision = precision, .budget = budget, .out = out, .cancel = cancel, .input_digits = occupiedDigits(&scratch[2]) };
+    const result = c.calculate(kind) catch |err| switch (err) {
+        error.GraphAlgorithmStopped => return c.end,
+        error.GraphAlgorithmLimit => return .budget,
+        error.GraphAlgorithmArithmetic => blk: {
+            scratch[0][0][127] = packet.bit_scale;
+            break :blk [2]u32{ 0, 0 };
+        },
+        else => return err,
+    };
+    const values = [2]packet.Value{ scratch[result[0]], scratch[result[1]] };
+    @memcpy(original[dest .. dest + outputs], values[0..outputs]);
+    return .halted;
+}
+
+/// Named legacy algorithms retain their token schedules; new fractional formats use the compiled formatter.
+pub fn run(m: anytype, kind: []const u8, width: u16, budget: u64, out: *std.ArrayList(u8), cancel: Cancel) !api.RunEnd {
+    if (std.mem.startsWith(u8, kind, "f64_")) return @import("runner_graph_f64.zig").run(m, kind, budget, out, cancel);
+    if (std.mem.eql(u8, kind, "factorize")) return runFactorize(m, width, budget, out, cancel);
+    const family = std.meta.stringToEnum(packet.Algorithm, kind) orelse return error.GraphAlgorithm;
+    const refs = [_]u32{ 0, 1, 2 };
+    var end = try compute(m, kind, width, m.precision, refs[0..packet.algorithmArity(family)], 0, budget, out, cancel);
+    if (end != .halted) return .{ .end = end, .steps = m.steps };
+    if (std.mem.eql(u8, kind, "smallest_factor")) {
+        end = try @import("runner_graph_print.zig").emit(m, .{ .ref = 0 }, budget, out, cancel);
+        return .{ .end = end, .steps = m.steps };
+    }
+    if (family == .fraction or family == .fixed_div) {
+        end = try @import("runner_graph_print.zig").emit(m, .{ .ref = 0, .second = if (family == .fraction) 1 else null, .style = if (family == .fraction) .fraction else .fixed, .precision = m.precision }, budget, out, cancel);
+        return .{ .end = end, .steps = m.steps };
+    }
+    var c: Context(@TypeOf(m)) = .{ .m = m, .width = width, .budget = budget, .out = out, .cancel = cancel, .input_digits = 1 };
+    const failed = m.values[0][0][127];
+    if (failed != 0 and failed != packet.bit_scale) return error.GraphPredicate;
+    if (family == .divmod and failed == 0) {
+        c.emitNamed("emit_first", 0) catch |err| switch (err) {
+            error.GraphAlgorithmStopped => return .{ .end = c.end, .steps = m.steps },
+            else => return err,
+        };
+        c.emitNamed("emit_last", 1) catch |err| switch (err) {
+            error.GraphAlgorithmStopped => return .{ .end = c.end, .steps = m.steps },
+            else => return err,
+        };
+    } else c.emit(0) catch |err| switch (err) {
+        error.GraphAlgorithmStopped => return .{ .end = c.end, .steps = m.steps },
+        else => return err,
+    };
+    return .{ .end = .halted, .steps = m.steps };
+}
+
+fn runFactorize(m: anytype, width: u16, budget: u64, out: *std.ArrayList(u8), cancel: Cancel) !api.RunEnd {
+    if (!packet.widthValid(width) or width > 128 or m.values.len < 2) return error.GraphAlgorithmScratch;
+    if (m.precision != 0) return error.GraphPrecision;
+    const original = m.values;
+    const zero = try packet.literal("0");
+    var scratch: [32]packet.Value = @splat(zero);
+    scratch[1] = try packet.literal("1");
+    for (original[0..2], 0..) |value, i| {
+        for (width..packet.max_digits) |digit| {
+            for (value[digit / 31][2 + digit % 31 * 4 ..][0..4]) |bit|
+                if (bit != 0) return error.GraphNarrowBinding;
+        }
+        scratch[2 + i] = value;
+    }
+    m.values = &scratch;
+    defer m.values = original;
+    var c: Context(@TypeOf(m)) = .{ .m = m, .width = @max(width, 8), .budget = budget, .out = out, .cancel = cancel, .input_digits = occupiedDigits(&scratch[2]) };
+    factor.factorize(&c) catch |err| switch (err) {
+        error.GraphAlgorithmStopped => return .{ .end = c.end, .steps = m.steps },
+        error.GraphAlgorithmLimit => return .{ .end = .budget, .steps = m.steps },
+        error.GraphAlgorithmArithmetic => {
+            scratch[0][0][127] = packet.bit_scale;
+            const end = try @import("runner_graph_print.zig").emit(m, .{ .ref = 0 }, budget, out, cancel);
+            return .{ .end = end, .steps = m.steps };
+        },
+        else => return err,
+    };
+    return .{ .end = .halted, .steps = m.steps };
+}
+
+fn Context(comptime M: type) type {
+    return struct {
+        m: M,
+        width: u16,
+        budget: u64,
+        out: *std.ArrayList(u8),
+        cancel: Cancel,
+        input_digits: usize,
+        precision: u8 = 0,
+        end: End = .halted,
+
+        const Self = @This();
+
+        pub fn call(c: *Self, name: []const u8, refs: []const u32, dest: usize) !void {
+            const width = if (std.mem.eql(u8, name, "meta")) @max(c.width, 8) else c.width;
+            var needed: usize = 1;
+            for (refs) |ref| needed = @max(needed, occupiedDigits(&c.m.values[ref]));
+            if (std.mem.eql(u8, name, "mul")) {
+                needed = occupiedDigits(&c.m.values[refs[0]]) + occupiedDigits(&c.m.values[refs[1]]);
+            } else if (std.mem.eql(u8, name, "add") or std.mem.eql(u8, name, "sub") or std.mem.eql(u8, name, "scale10")) {
+                needed += 1;
+            } else if (std.mem.eql(u8, name, "meta")) needed = @max(needed, 8);
+            const selected = bucket(@min(needed, width));
+            const t = (if (c.m.adaptive_widths) c.m.bank.find(name, selected) else null) orelse
+                c.m.bank.find(name, width) orelse return error.GraphTemplate;
+            c.end = try c.m.invoke(t, refs, dest, c.budget, c.out, c.cancel, false);
+            if (c.end != .halted) return error.GraphAlgorithmStopped;
+            for (dest..dest + t.outputs) |i| try clean(&c.m.values[i]);
+        }
+
+        fn emit(c: *Self, ref: u32) !void {
+            return c.emitNamed("emit", ref);
+        }
+
+        fn emitNamed(c: *Self, name: []const u8, ref: u32) !void {
+            const needed = if (c.m.adaptive_widths) occupiedDigits(&c.m.values[ref]) else c.width;
+            const width: u16 = if (needed > 128) 256 else if (needed > 62) 128 else 62;
+            const t = c.m.bank.find(name, width) orelse return error.GraphEmitMissing;
+            c.end = try c.m.invoke(t, &.{ref}, 0, c.budget, c.out, c.cancel, true);
+            if (c.end != .halted) return error.GraphAlgorithmStopped;
+        }
+
+        pub fn move(c: *Self, dest: usize, source: usize) void {
+            c.m.values[dest] = c.m.values[source];
+        }
+
+        pub fn meta(c: *Self, a: u32, b: u32) !void {
+            try c.call("meta", &.{ a, b }, 20);
+        }
+
+        pub fn flag(c: *Self, digit: usize) !bool {
+            return predicate(&c.m.values[22], digit);
+        }
+
+        pub fn nonzero(c: *Self, ref: u32) !bool {
+            try c.meta(ref, 0);
+            return c.flag(0);
+        }
+
+        /// Slots 24..30 are private to long division; both result slots must be outside that interval.
+        fn unsigned(c: *Self, a: u32, b: u32, q: usize, r: usize) !void {
+            c.move(24, a);
+            c.move(25, b);
+            c.move(26, 0);
+            c.move(27, 0);
+            var digit: usize = c.width;
+            while (digit > 0) {
+                digit -= 1;
+                c.move(28, 0);
+                packet.copyBits(&c.m.values[28], &c.m.values[24], .{
+                    .ref = 24,
+                    .from = @intCast(digit),
+                    .digits = 1,
+                });
+                try c.call("divstep", &.{ 27, 25, 28 }, 29);
+                c.move(27, 29);
+                packet.copyBits(&c.m.values[26], &c.m.values[30], .{
+                    .ref = 30,
+                    .to = @intCast(digit),
+                    .digits = 1,
+                });
+            }
+            c.move(q, 26);
+            c.move(r, 27);
+        }
+
+        fn calculate(c: *Self, kind: []const u8) ![2]u32 {
+            if (std.mem.eql(u8, kind, "smallest_factor")) return .{ try factor.smallest(c), 0 };
+            if (std.mem.eql(u8, kind, "divmod") or std.mem.eql(u8, kind, "divexact")) {
+                try c.meta(2, 3);
+                c.move(5, 20);
+                c.move(6, 21);
+                try c.unsigned(5, 6, 7, 8);
+                if (std.mem.eql(u8, kind, "divexact")) {
+                    if (try c.nonzero(8)) return error.GraphAlgorithmArithmetic;
+                    try c.call("round_div", &.{ 7, 8, 2, 3 }, 10);
+                    return .{ 10, 0 };
+                }
+                try c.call("divfinal", &.{ 7, 8, 2, 3 }, 10);
+                return .{ 10, 11 };
+            }
+            if (std.mem.eql(u8, kind, "fraction")) return c.fraction();
+            if (std.mem.eql(u8, kind, "fixed_div")) return .{ try c.fixedDivision(), 0 };
+            const result: u32 = if (std.mem.eql(u8, kind, "gcd")) try c.gcd() else if (std.mem.eql(u8, kind, "isqrt")) try c.isqrt() else if (std.mem.eql(u8, kind, "digit_sum")) try c.digitSum() else if (std.mem.eql(u8, kind, "powmod")) try c.powmod() else if (std.mem.eql(u8, kind, "square_offset")) try c.squareOffset() else try c.product(std.mem.eql(u8, kind, "factorial"));
+            return .{ result, 0 };
+        }
+
+        fn fraction(c: *Self) ![2]u32 {
+            const divisor = try c.gcd();
+            c.move(15, divisor);
+            try c.meta(2, 3);
+            if (!try c.flag(1)) return error.GraphAlgorithmArithmetic;
+            c.move(5, 20);
+            c.move(6, 21);
+            try c.unsigned(5, 15, 7, 8);
+            try c.unsigned(6, 15, 9, 10);
+            try c.call("divfinal", &.{ 7, 0, 2, 3 }, 10);
+            return .{ 10, 9 };
+        }
+
+        fn fixedDivision(c: *Self) !u32 {
+            try c.meta(2, 3);
+            if (!try c.flag(1)) return error.GraphAlgorithmArithmetic;
+            c.move(5, 20);
+            c.move(6, 21);
+            try c.unsigned(5, 6, 7, 8);
+            for (0..c.precision) |_| {
+                try c.call("scale10", &.{7}, 7);
+                try c.call("divstep", &.{ 8, 6, 0 }, 10);
+                c.move(8, 10);
+                try c.call("add", &.{ 7, 11 }, 7);
+            }
+            try c.call("round_div", &.{ 7, 8, 2, 3 }, 10);
+            return 10;
+        }
+
+        fn gcd(c: *Self) !u32 {
+            try c.meta(2, 3);
+            c.move(5, 20);
+            c.move(6, 21);
+            var iterations: usize = 0;
+            while (try c.nonzero(6)) {
+                if (iterations >= @as(usize, c.width) * 8) return error.GraphAlgorithmLimit;
+                iterations += 1;
+                try c.unsigned(5, 6, 7, 8);
+                c.move(5, 6);
+                c.move(6, 8);
+            }
+            return 5;
+        }
+
+        fn isqrt(c: *Self) !u32 {
+            try c.meta(2, 0);
+            if (try c.flag(2)) return error.GraphAlgorithmArithmetic;
+            if (!try c.flag(0)) return 0;
+            c.move(5, 20);
+            const nines: [packet.max_digits]u8 = @splat('9');
+            c.m.values[6] = try packet.literal(nines[0 .. (c.input_digits + 1) / 2]);
+            for (0..@as(usize, c.width) * 8) |_| {
+                try c.unsigned(5, 6, 7, 8);
+                try c.call("half", &.{6}, 12);
+                c.move(9, 12);
+                c.move(10, 13);
+                try c.call("half", &.{7}, 12);
+                try c.call("add", &.{ 9, 12 }, 11);
+                if (try predicate(&c.m.values[10], 0)) {
+                    if (try predicate(&c.m.values[13], 0)) {
+                        try c.call("add", &.{ 11, 1 }, 11);
+                    }
+                }
+                try c.meta(11, 6);
+                if (!try c.flag(4)) return 6;
+                c.move(6, 11);
+            }
+            return error.GraphAlgorithmLimit;
+        }
+
+        fn digitSum(c: *Self) !u32 {
+            try c.call("digit_sum", &.{2}, 6);
+            return 6;
+        }
+
+        fn squareOffset(c: *Self) !u32 {
+            try c.meta(2, 3);
+            if (!try c.flag(1)) return 0;
+            try c.call("add", &.{ 2, 3 }, 5);
+            try c.call("add", &.{ 2, 5 }, 6);
+            try c.call("mul", &.{ 6, 3 }, 7);
+            return 7;
+        }
+
+        /// Range products use [start, stop); factorial includes n and never constructs n+1.
+        fn product(c: *Self, factorial: bool) !u32 {
+            try c.meta(2, if (factorial) 0 else 3);
+            if (try c.flag(2)) return error.GraphAlgorithmArithmetic;
+            if (try c.flag(3)) return error.GraphAlgorithmArithmetic;
+            c.move(5, if (factorial) 1 else 20);
+            c.move(6, if (factorial) 20 else 21);
+            c.move(7, 1);
+            var iterations: usize = 0;
+            while (true) {
+                try c.meta(5, 6);
+                const less = try c.flag(4);
+                const equal = try c.flag(5);
+                if (!less and !(factorial and equal)) return 7;
+                if (iterations >= 10000) return error.GraphAlgorithmLimit;
+                iterations += 1;
+                try c.call("mul", &.{ 7, 5 }, 7);
+                if (factorial and equal) return 7;
+                try c.call("add", &.{ 5, 1 }, 5);
+            }
+        }
+
+        /// One prepared Horner step consumes a decimal multiplier digit; modulus stays in slot 7.
+        fn modmul(c: *Self, a: u32, b: u32, dest: usize) !void {
+            c.move(17, a);
+            c.move(18, b);
+            c.move(16, 0);
+            var digit = occupiedDigits(&c.m.values[18]);
+            while (digit > 0) {
+                digit -= 1;
+                c.move(19, 0);
+                packet.copyBits(&c.m.values[19], &c.m.values[18], .{
+                    .ref = 18,
+                    .from = @intCast(digit),
+                    .digits = 1,
+                });
+                try c.call("mulmodstep", &.{ 16, 17, 19, 7 }, 16);
+            }
+            c.move(dest, 16);
+        }
+
+        fn powmod(c: *Self) !u32 {
+            try c.meta(2, 4);
+            c.move(5, 20);
+            c.move(7, 21);
+            c.move(9, 22);
+            if (!try c.flag(1)) return error.GraphAlgorithmArithmetic;
+            try c.meta(3, 0);
+            if (try c.flag(2)) return error.GraphAlgorithmArithmetic;
+            c.move(6, 20);
+            try c.unsigned(5, 7, 10, 11);
+            try c.call("divfinal", &.{ 10, 11, 2, 7 }, 10);
+            c.move(5, 11);
+            try c.unsigned(1, 7, 10, 11);
+            c.move(8, 11);
+            var iterations: usize = 0;
+            while (try c.nonzero(6)) {
+                if (iterations >= @as(usize, c.width) * 4) return error.GraphAlgorithmLimit;
+                iterations += 1;
+                try c.call("half", &.{6}, 12);
+                c.move(6, 12);
+                if (try predicate(&c.m.values[13], 0)) try c.modmul(8, 5, 8);
+                if (try c.nonzero(6)) try c.modmul(5, 5, 5);
+            }
+            if (try predicate(&c.m.values[9], 3)) {
+                if (try c.nonzero(8)) try c.call("sub", &.{ 8, 7 }, 8);
+            }
+            return 8;
+        }
+    };
+}
+
+fn occupiedDigits(value: *const packet.Value) usize {
+    var digits: usize = packet.max_digits;
+    while (digits > 1) : (digits -= 1) {
+        const at = digits - 1;
+        for (value[at / 31][2 + at % 31 * 4 ..][0..4]) |bit| if (bit != 0) return digits;
+    }
+    return digits;
+}
+
+fn bucket(needed: usize) u16 {
+    for ([_]u16{ 1, 2, 4, 8, 16, 32, 62, 128, 256 }) |width| if (needed <= width) return width;
+    unreachable;
+}
+
+fn clean(value: *const packet.Value) !void {
+    const bit = value[0][127];
+    if (bit == packet.bit_scale) return error.GraphAlgorithmArithmetic;
+    if (bit != 0) return error.GraphPredicate;
+}
+
+fn predicate(value: *const packet.Value, digit: usize) !bool {
+    try clean(value);
+    const bits = value[digit / 31][2 + digit % 31 * 4 ..][0..4];
+    for (bits[1..]) |bit| if (bit != 0) return error.GraphPredicate;
+    if (bits[0] == 0) return false;
+    if (bits[0] == packet.bit_scale) return true;
+    return error.GraphPredicate;
+}
diff --git a/zig/src/core/runner_graph_bank.zig b/zig/src/core/runner_graph_bank.zig
new file mode 100644
index 000000000..f57394243
--- /dev/null
+++ b/zig/src/core/runner_graph_bank.zig
@@ -0,0 +1,376 @@
+//! Stable template descriptors with once-only lazy prepared weights and validated named binding plans.
+const std = @import("std");
+const model = @import("steps_v1/runner_circuit_model.zig");
+const binary = @import("runner_graph_binary.zig");
+const packet = @import("runner_graph_packet.zig");
+const lazy = @import("runner_graph_lazy.zig");
+const Allocator = std.mem.Allocator;
+const missing = std.math.maxInt(u32);
+pub const Slots = lazy.Slots;
+
+pub const Template = struct {
+    name: []const u8,
+    width: u16,
+    circuit: model.Circuit,
+    inputs: u8,
+    outputs: u8,
+    in_slots: Slots,
+    out_slots: Slots,
+    preparation: ?*Preparation = null,
+    materialized: bool = true,
+
+    /// Circuit fields and logical slots may be read only after this succeeds; prepared copies keep their own circuit.
+    pub fn prepare(t: *const Template) !void {
+        const p = t.preparation orelse return;
+        if (p.ready.load(.acquire)) {
+            if (t != p.owner and !t.materialized) return error.GraphUnpreparedCopy;
+            return;
+        }
+        if (t != p.owner) return error.GraphUnpreparedCopy;
+        var threaded: std.Io.Threaded = .init_single_threaded;
+        const io = threaded.io();
+        p.mutex.lockUncancelable(io);
+        defer p.mutex.unlock(io);
+        if (p.ready.load(.acquire)) return;
+        if (p.failure) |err| return err;
+        _ = p.attempts.fetchAdd(1, .monotonic);
+        p.publish() catch |err| {
+            p.failure = err;
+            return err;
+        };
+    }
+
+    pub fn isPrepared(t: *const Template) bool {
+        const p = t.preparation orelse return true;
+        return p.ready.load(.acquire) and (t == p.owner or t.materialized);
+    }
+
+    pub fn loadAttempts(t: *const Template) u32 {
+        return if (t.preparation) |p| p.attempts.load(.monotonic) else 0;
+    }
+};
+
+const Preparation = struct {
+    gpa: Allocator,
+    owner: *Template,
+    path: []const u8,
+    header: binary.Header,
+    mutex: std.Io.Mutex = .init,
+    ready: std.atomic.Value(bool) = .init(false),
+    attempts: std.atomic.Value(u32) = .init(0),
+    failure: ?anyerror = null,
+
+    fn publish(p: *Preparation) !void {
+        const t = p.owner;
+        var circuit = try binary.loadPinned(p.gpa, p.path, t.name, t.width, &p.header);
+        errdefer circuit.deinit(p.gpa);
+        const layout = try lazy.Binding.inspect(&circuit, try binary.bindingWidth(t.width));
+        if ((t.inputs != 0 and layout.inputs != t.inputs) or (t.outputs != 0 and layout.outputs != t.outputs))
+            return error.GraphSlotArity;
+        if (t.inputs == 0) t.inputs = layout.inputs;
+        if (t.outputs == 0) t.outputs = layout.outputs;
+        t.circuit = circuit;
+        t.in_slots = layout.in_slots;
+        t.out_slots = layout.out_slots;
+        t.materialized = true;
+        p.ready.store(true, .release);
+    }
+};
+
+pub const LoadMode = enum { lazy, eager };
+
+const Descriptor = struct {
+    name: []const u8,
+    width: u16,
+    path: []const u8,
+    inputs: ?u8 = null,
+    outputs: ?u8 = null,
+};
+pub const PreparedPlan = struct {
+    name: []const u8,
+    inputs: u32,
+    ops: []const packet.Op,
+    result: u32,
+    constants: []const packet.Value,
+    total_values: usize,
+    algorithm: ?[]const u8,
+    width: u16,
+    precision: u8,
+};
+
+const Manifest = struct {
+    version: u32,
+    templates: []const Descriptor,
+    plans: []const packet.Plan = &.{},
+};
+
+pub const Bank = struct {
+    gpa: Allocator,
+    arena: std.heap.ArenaAllocator,
+    templates: []Template,
+    plans: []const PreparedPlan,
+
+    pub fn load(a: Allocator, path: []const u8) !Bank {
+        return loadWithMode(a, path, .lazy);
+    }
+
+    pub fn loadEager(a: Allocator, path: []const u8) !Bank {
+        return loadWithMode(a, path, .eager);
+    }
+
+    /// The allocator must support concurrent stream allocations; the bank owns all loaded circuits until deinit.
+    pub fn loadWithMode(a: Allocator, path: []const u8, mode: LoadMode) !Bank {
+        var threaded: std.Io.Threaded = .init_single_threaded;
+        const bytes = try std.Io.Dir.cwd().readFileAlloc(threaded.io(), path, a, .limited(32 << 20));
+        defer a.free(bytes);
+        var arena = std.heap.ArenaAllocator.init(a);
+        errdefer arena.deinit();
+        const doc = try std.json.parseFromSliceLeaky(Manifest, arena.allocator(), bytes, .{ .allocate = .alloc_always });
+        if (doc.version != 1 or doc.templates.len == 0 or doc.templates.len > 256) return error.GraphManifest;
+        const templates = try arena.allocator().alloc(Template, doc.templates.len);
+        const preparations = try arena.allocator().alloc(Preparation, doc.templates.len);
+        const expected_schema = binary.schemaHash();
+        var loaded: usize = 0;
+        errdefer for (templates[0..loaded]) |*t| {
+            if (t.isPrepared()) t.circuit.deinit(a);
+        };
+        for (doc.templates, templates, preparations) |d, *t, *preparation| {
+            if (!packet.widthValid(d.width) or d.width == 255 or d.name.len == 0 or d.path.len == 0) return error.GraphTemplate;
+            if (d.inputs) |n| if (n == 0 or n > packet.max_arity) return error.GraphSlotArity;
+            if (d.outputs) |n| if (n == 0 or n > packet.max_arity) return error.GraphSlotArity;
+            for (templates[0..loaded]) |prior| if (prior.width == d.width and std.mem.eql(u8, prior.name, d.name))
+                return error.GraphDuplicateTemplate;
+            const joined = if (std.fs.path.isAbsolute(d.path)) d.path else try std.fs.path.join(arena.allocator(), &.{ std.fs.path.dirname(path) orelse ".", d.path });
+            const resolved = try std.Io.Dir.cwd().realPathFileAlloc(threaded.io(), joined, arena.allocator());
+            const h = try binary.inspect(resolved, d.name, d.width, expected_schema);
+            const legacy = binary.isLegacy(&h);
+            const inputs = d.inputs orelse if (legacy) @as(u8, 0) else return error.GraphSlotArity;
+            const outputs = d.outputs orelse if (legacy) @as(u8, 0) else return error.GraphSlotArity;
+            if (!legacy and (inputs != h[80] or outputs != h[81])) return error.GraphSlotArity;
+            preparation.* = .{ .gpa = a, .owner = t, .path = resolved, .header = h };
+            t.* = .{ .name = d.name, .width = d.width, .circuit = undefined, .inputs = inputs, .outputs = outputs, .in_slots = @splat(@splat(missing)), .out_slots = @splat(@splat(missing)), .preparation = preparation, .materialized = false };
+            loaded += 1;
+            // Legacy headers omit bindings; validate the complete payload before exposing the descriptor.
+            if (legacy) try t.prepare();
+        }
+        const plans = try arena.allocator().alloc(PreparedPlan, doc.plans.len);
+        var bank: Bank = .{ .gpa = a, .arena = arena, .templates = templates, .plans = plans };
+        for (doc.plans, 0..) |p, i| {
+            if (p.name.len == 0) return error.GraphPlan;
+            for (doc.plans[0..i]) |prior| if (std.mem.eql(u8, prior.name, p.name)) return error.GraphDuplicatePlan;
+            if (p.inputs > packet.max_values or p.literals.len > packet.max_values - p.inputs)
+                return error.GraphPlanSize;
+            const constants = try arena.allocator().alloc(packet.Value, p.literals.len);
+            for (p.literals, constants) |text, *v| v.* = try packet.literal(text);
+            if (p.algorithm) |kind| {
+                const family = std.meta.stringToEnum(packet.Algorithm, kind) orelse return error.GraphAlgorithm;
+                if (p.inputs != packet.algorithmArity(family) or p.ops.len != 0 or constants.len != 0 or p.result != 0)
+                    return error.GraphAlgorithm;
+                try bank.validateAlgorithm(family, p.width, p.precision);
+            } else if (p.precision != 0) {
+                return error.GraphPrecision;
+            }
+            plans[i] = .{ .name = p.name, .inputs = p.inputs, .ops = p.ops, .result = p.result, .constants = constants, .total_values = if (p.algorithm != null) 32 else try bank.validate(p.inputs + p.literals.len, p.ops, p.result), .algorithm = p.algorithm, .width = p.width, .precision = p.precision };
+        }
+        const emitter = bank.find("emit", 62) orelse return error.GraphEmitMissing;
+        if (emitter.inputs != 1 or emitter.outputs != 1) return error.GraphSlotArity;
+        for (templates) |t| if (t.width == 128) {
+            const wide = bank.find("emit", 128) orelse return error.GraphEmitMissing;
+            if (wide.inputs != 1 or wide.outputs != 1) return error.GraphSlotArity;
+            break;
+        };
+        for (templates) |t| if (t.width == 256) {
+            try bank.require("emit", 256, 1, 1);
+            try bank.require("format", 256, 2, 2);
+            break;
+        };
+        bank.arena = arena;
+        if (mode == .eager) try bank.prepareAll();
+        return bank;
+    }
+
+    /// Destroy every backend and machine before freeing the bank; prepared copies borrow its circuit allocations.
+    pub fn deinit(b: *Bank) void {
+        for (b.templates) |*t| {
+            if (t.isPrepared()) t.circuit.deinit(b.gpa);
+        }
+        b.arena.deinit();
+        b.* = undefined;
+    }
+
+    pub fn prepareAll(b: *const Bank) !void {
+        for (b.templates) |*t| try t.prepare();
+    }
+
+    pub fn preparedCount(b: *const Bank) usize {
+        var count: usize = 0;
+        for (b.templates) |*t| count += @intFromBool(t.isPrepared());
+        return count;
+    }
+
+    pub fn loadAttempts(b: *const Bank) u64 {
+        var count: u64 = 0;
+        for (b.templates) |*t| count += t.loadAttempts();
+        return count;
+    }
+
+    /// Clears only a cached failure; the next use retries the pinned pack and successful circuits are never replaced.
+    pub fn retryFailed(b: *const Bank, name: []const u8, width: u16) !void {
+        const t = b.find(name, width) orelse return error.GraphTemplate;
+        const p = t.preparation orelse return error.GraphAlreadyPrepared;
+        var threaded: std.Io.Threaded = .init_single_threaded;
+        const io = threaded.io();
+        p.mutex.lockUncancelable(io);
+        defer p.mutex.unlock(io);
+        if (p.ready.load(.acquire)) return error.GraphAlreadyPrepared;
+        if (p.failure == null) return error.GraphNotFailed;
+        p.failure = null;
+    }
+
+    /// Lookup reads metadata only; call Template.prepare before accessing its circuit or logical slots.
+    pub fn find(b: *const Bank, name: []const u8, width: u16) ?*const Template {
+        for (b.templates) |*t| if (t.width == width and std.mem.eql(u8, t.name, name)) return t;
+        return null;
+    }
+
+    pub fn plan(b: *const Bank, name: []const u8) ?*const PreparedPlan {
+        for (b.plans) |*p| if (std.mem.eql(u8, p.name, name)) return p;
+        return null;
+    }
+
+    pub fn validate(b: *const Bank, inputs: usize, ops: []const packet.Op, result: u32) !usize {
+        if (inputs > packet.max_values or ops.len > packet.max_ops) return error.GraphPlanSize;
+        var count = inputs;
+        for (ops) |op| {
+            if (op.outputs == 0 or op.outputs > packet.max_arity or count + op.outputs > packet.max_values)
+                return error.GraphPlanSize;
+            if (std.mem.eql(u8, op.op, "bind")) {
+                if (op.outputs != 1 or op.copies.len > 128 or op.args != null or op.b != null or op.precision != 0)
+                    return error.GraphBinding;
+                for (op.copies) |c| if (c.ref >= count or c.from > packet.max_digits or c.to > packet.max_digits or
+                    c.digits > packet.max_digits - c.from or c.digits > packet.max_digits - c.to)
+                    return error.GraphBinding;
+                if (op.flags) |r| if (r >= count) return error.GraphReference;
+            } else {
+                if (std.mem.eql(u8, op.op, "factorize") or std.mem.eql(u8, op.op, "f64_repr")) return error.GraphAlgorithm;
+                if (std.mem.startsWith(u8, op.op, "emit") or (std.mem.eql(u8, op.op, "format") or std.mem.eql(u8, op.op, "format_f64")) or op.copies.len != 0 or op.flags != null)
+                    return error.GraphTemplate;
+                const arity: u8 = if (std.meta.stringToEnum(packet.Algorithm, op.op)) |family| blk: {
+                    try b.validateAlgorithm(family, op.width, op.precision);
+                    if (op.outputs != packet.algorithmOutputs(family)) return error.GraphSlotArity;
+                    break :blk packet.algorithmArity(family);
+                } else blk: {
+                    if (op.precision != 0) return error.GraphPrecision;
+                    const t = b.find(op.op, op.width) orelse return error.GraphTemplate;
+                    if (t.outputs != op.outputs) return error.GraphSlotArity;
+                    break :blk t.inputs;
+                };
+                if (op.args) |args| {
+                    if (args.len != arity) return error.GraphSlotArity;
+                    for (args) |r| if (r >= count) return error.GraphReference;
+                } else {
+                    if (arity != 1 + @as(usize, @intFromBool(op.b != null)) or op.a >= count)
+                        return error.GraphSlotArity;
+                    if (op.b) |r| if (r >= count) return error.GraphReference;
+                }
+            }
+            count += op.outputs;
+        }
+        if (result >= count) return error.GraphReference;
+        return count;
+    }
+
+    pub fn validatePrints(b: *const Bank, prints: []const packet.Print, count: usize) !void {
+        if (prints.len > packet.max_prints) return error.GraphPrint;
+        if (prints.len == 0) return;
+        try b.require("format", 62, 2, 2);
+        try b.require("format", 128, 2, 2);
+        for (prints) |p| {
+            if (p.ref >= count or p.precision > 18 or (p.style != .fixed and p.precision != 0)) return error.GraphPrint;
+            if (p.style == .byte) {
+                if (p.precision != 0 or p.prefix or p.ending != .empty or p.second != null) return error.GraphPrint;
+                try b.require("byte_check", 128, 1, 1);
+                try b.require("emit_byte", 4, 1, 1);
+                continue;
+            }
+            if (p.style == .prepared) {
+                try b.require("format_f64", 62, 2, 2);
+                if (p.prefix or p.precision != 0 or p.ending != .newline or p.second == null) return error.GraphPrint;
+            }
+            if ((p.style == .fraction or p.style == .tuple or p.style == .prepared) != (p.second != null)) return error.GraphPrint;
+            if (p.second) |ref| if (ref >= count) return error.GraphReference;
+            if (p.style == .fraction) try b.require("meta", 128, 2, 3);
+            if (p.style == .tuple and (p.prefix or (p.ending != .newline and p.ending != .space and p.ending != .empty and p.ending != .comma_space)))
+                return error.GraphPrint;
+        }
+    }
+
+    fn require(b: *const Bank, name: []const u8, width: u16, inputs: u8, outputs: u8) !void {
+        const t = b.find(name, width) orelse return error.GraphTemplate;
+        if (t.inputs != inputs or t.outputs != outputs) return error.GraphSlotArity;
+    }
+
+    fn validateAlgorithm256(b: *const Bank, family: packet.Algorithm) !void {
+        if (family != .divmod and family != .powmod) return error.GraphAlgorithm;
+        try b.require("meta", 256, 2, 3);
+        try b.require("divstep", 256, 3, 2);
+        try b.require("divfinal", 256, 4, 2);
+        if (family == .divmod) {
+            try b.require("emit_first", 256, 1, 1);
+            try b.require("emit_last", 256, 1, 1);
+        } else {
+            try b.require("half", 256, 1, 2);
+            try b.require("mulmodstep", 256, 4, 1);
+            try b.require("sub", 256, 2, 1);
+            try b.require("emit", 256, 1, 1);
+        }
+    }
+
+    fn validateAlgorithm(b: *const Bank, family: packet.Algorithm, width: u16, precision: u8) !void {
+        if (!packet.algorithmWidthValid(family, width) or precision > 18 or (family != .fixed_div and precision != 0))
+            return error.GraphAlgorithm;
+        if (width == 256) return b.validateAlgorithm256(family);
+        if (std.mem.startsWith(u8, @tagName(family), "f64_")) {
+            if (width != 128) return error.GraphAlgorithm;
+            try b.require("raw_meta", 128, 2, 3);
+            try b.require("format_f64", 62, 2, 2);
+            try b.require("decimal_mul", 128, 2, 1);
+            try b.require("compare", 128, 2, 1);
+            try b.require("round_div", 128, 4, 1);
+            try b.require("add", 128, 2, 1);
+            try b.require("sub", 128, 2, 1);
+            try b.require("half", 128, 1, 2);
+            try b.require("divstep", 128, 3, 2);
+            try b.require("format", 62, 2, 2);
+            return;
+        }
+        const factor = family == .smallest_factor or family == .factorize;
+        const work_width = if (factor) @max(width, 8) else width;
+        if (factor) {
+            try b.require("add", work_width, 2, 1);
+            try b.require("half", work_width, 1, 2);
+            try b.require("divstep", work_width, 3, 2);
+            try b.require("meta", work_width, 2, 3);
+            try b.require("format", 62, 2, 2);
+            try b.require("format", 128, 2, 2);
+            return;
+        }
+        const kernels = [_]struct { []const u8, u8, u8 }{
+            .{ "add", 2, 1 },        .{ "sub", 2, 1 },      .{ "mul", 2, 1 },  .{ "half", 1, 2 },
+            .{ "divstep", 3, 2 },    .{ "divfinal", 4, 2 }, .{ "meta", 2, 3 }, .{ "digit_sum", 1, 1 },
+            .{ "mulmodstep", 4, 1 },
+        };
+        for (kernels) |k| try b.require(k[0], if (std.mem.eql(u8, k[0], "meta")) @max(work_width, 8) else work_width, k[1], k[2]);
+        if (family == .fixed_div) {
+            try b.require("scale10", width, 1, 1);
+        }
+        if (family == .fixed_div or family == .divexact) try b.require("round_div", width, 4, 1);
+        if (family == .fraction or family == .fixed_div or factor) {
+            try b.require("format", 62, 2, 2);
+            try b.require("format", 128, 2, 2);
+        }
+        if (family == .fraction) try b.require("meta", 128, 2, 3);
+        if (family == .divmod) for ([_][]const u8{ "emit_first", "emit_last" }) |name|
+            try b.require(name, @max(width, 62), 1, 1);
+    }
+};
