+//! <prefix>_BACKEND=graph: a straight-line integer cell (assignments, divmod, prints) as graph packets.
+const std = @import("std");
+const graph = @import("runner_graph.zig");
+const route = @import("runner_graph_route.zig");
+const packet = @import("runner_graph_packet.zig");
+const api = @import("runner_api.zig");
+const Allocator = std.mem.Allocator;
+
+/// A straight-line cell's prints run as packets; each piece is `<I|B><N|S> <packet>` on its own line.
+pub const seq_magic = "TFGS1\n";
+/// As TFGS1, and a piece may be a template (`@` body) over earlier pieces' printed values, lowered when they finish.
+pub const seq_magic_v2 = "TFGS2\n";
+
+/// Straight-line integer Python (assignments, divmod, `;`, prints) as graph bytes over literals; null: other shapes.
+pub fn program(a: Allocator, bank: *const graph.Bank, code: []const u8) Allocator.Error!?[]u8 {
+    var arena_state = std.heap.ArenaAllocator.init(a);
+    defer arena_state.deinit();
+    const arena = arena_state.allocator();
+    if (code.len > 4096) return null;
+    // `import math` makes `math.f` callable, `from math import f` the bare `f`
+    var math_names: Calls = .{};
+    const text = try arena.dupe(u8, code);
+    _ = std.mem.replace(u8, code, "math.", "math_", text);
+    if (std.mem.indexOfAny(u8, text, "'\"\\[]{}.:") != null) return null;
+    var defs: std.StringHashMapUnmanaged([]const u8) = .empty;
+    // names whose value an earlier 'I' piece printed: later pieces read it there instead of recomputing it
+    var printed: std.StringHashMapUnmanaged(usize) = .empty;
+    var templated = false;
+    var pieces: std.ArrayList(u8) = .empty;
+    var n_pieces: usize = 0;
+    var lone: ?[]const u8 = null;
+    var lines = std.mem.splitScalar(u8, text, '\n');
+    while (lines.next()) |raw| {
+        const line = raw[0 .. std.mem.indexOfScalar(u8, raw, '#') orelse raw.len];
+        if (line.len > 0 and (line[0] == ' ' or line[0] == '\t') and std.mem.trim(u8, line, " \t\r").len > 0) return null;
+        var stmts = std.mem.splitScalar(u8, line, ';');
+        while (stmts.next()) |st| {
+            const t = std.mem.trim(u8, st, " \t\r");
+            if (t.len == 0) continue;
+            if (std.mem.eql(u8, t, "import math")) {
+                math_names.module = true;
+                continue;
+            }
+            if (std.mem.startsWith(u8, t, "from math import ")) {
+                var it = std.mem.splitScalar(u8, t["from math import ".len..], ',');
+                while (it.next()) |f| if (!math_names.allow(std.mem.trim(u8, f, " \t"))) return null;
+                continue;
+            }
+            if (std.mem.startsWith(u8, t, "print(") and t[t.len - 1] == ')') {
+                const args = try splitArgs(arena, t[6 .. t.len - 1]) orelse return null;
+                if (args.len == 0) return null;
+                for (args, 0..) |arg, i| {
+                    const last = i + 1 == args.len;
+                    var one = try call(arena, &defs, math_names, arg) orelse try piece(arena, bank, &defs, arg) orelse return null;
+                    if (one.from_piece) if (try template(arena, &defs, &printed, arg)) |tmpl| {
+                        one.packet = tmpl;
+                        templated = true;
+                    };
+                    if (n_pieces >= 16) return null;
+                    try pieces.print(arena, "{c}{c} {s}\n", .{ one.kind, @as(u8, if (last) 'N' else 'S'), one.packet });
+                    if (one.kind == 'I' and name(arg)) if (defs.get(arg)) |def| if (costly(def)) try printed.put(arena, arg, n_pieces);
+                    lone = if (n_pieces == 0 and one.kind == 'I' and last) one.packet else null;
+                    n_pieces += 1;
+                }
+                continue;
+            }
+            const eq = std.mem.indexOfScalar(u8, t, '=') orelse return null;
+            if (eq + 1 < t.len and t[eq + 1] == '=') return null;
+            const lhs = std.mem.trim(u8, t[0..eq], " \t()");
+            const rhs = std.mem.trim(u8, t[eq + 1 ..], " \t");
+            if (std.mem.indexOfScalar(u8, lhs, ',')) |comma| {
+                // q, r = divmod(x, y): Python's floor quotient and remainder
+                const q = std.mem.trim(u8, lhs[0..comma], " \t");
+                const rem = std.mem.trim(u8, lhs[comma + 1 ..], " \t");
+                if (!name(q) or !name(rem) or !std.mem.startsWith(u8, rhs, "divmod(") or rhs[rhs.len - 1] != ')') return null;
+                const args = try splitArgs(arena, rhs[7 .. rhs.len - 1]) orelse return null;
+                if (args.len != 2) return null;
+                const x = try expand(arena, &defs, args[0]) orelse return null;
+                const y = try expand(arena, &defs, args[1]) orelse return null;
+                try defs.put(arena, q, try std.mem.concat(arena, u8, &.{ "(", x, "//", y, ")" }));
+                try defs.put(arena, rem, try std.mem.concat(arena, u8, &.{ "(", x, "%", y, ")" }));
+                _ = printed.remove(q);
+                _ = printed.remove(rem);
+                continue;
+            }
+            if (!name(lhs)) return null;
+            const v = try expand(arena, &defs, rhs) orelse return null;
+            // a plain literal stays bare, so it can still be an exponent
+            const bare = v.len > 0 and for (v) |c| {
+                if (!std.ascii.isDigit(c)) break false;
+            } else true;
+            try defs.put(arena, lhs, if (bare) v else try std.mem.concat(arena, u8, &.{ "(", v, ")" }));
+            _ = printed.remove(lhs);
+        }
+    }
+    if (n_pieces == 0) return null;
+    if (n_pieces == 1) if (lone) |p| return try a.dupe(u8, p);
+    return try std.mem.concat(a, u8, &.{ if (templated) seq_magic_v2 else seq_magic, pieces.items });
+}
+
+const Piece = struct { kind: u8, packet: []const u8, from_piece: bool = false };
+
+/// The math functions a cell may call: `math.f` after `import math`, a bare `f` after `from math import f`.
+const Calls = struct {
+    module: bool = false,
+    gcd: bool = false,
+    isqrt: bool = false,
+    factorial: bool = false,
+
+    fn allow(c: *Calls, f: []const u8) bool {
+        inline for (.{ "gcd", "isqrt", "factorial" }) |n| if (std.mem.eql(u8, f, n)) {
+            @field(c, n) = true;
+            return true;
+        };
+        return false;
+    }
+};
+
+/// A print of pow(a, b, m) or math gcd, isqrt, factorial over integer literals (T1's algorithm plans); null: not one.
+fn call(arena: Allocator, defs: anytype, calls: Calls, arg: []const u8) Allocator.Error!?Piece {
+    const open = std.mem.indexOfScalar(u8, arg, '(') orelse return null;
+    if (arg[arg.len - 1] != ')') return null;
+    const f = std.mem.trim(u8, arg[0..open], " \t");
+    const module = std.mem.startsWith(u8, f, "math_");
+    const bare = if (module) f[5..] else f;
+    const algo: packet.Algorithm, const n: usize, const ok: bool = if (std.mem.eql(u8, f, "pow"))
+        .{ .powmod, 3, true }
+    else if (std.mem.eql(u8, bare, "gcd"))
+        .{ .gcd, 2, if (module) calls.module else calls.gcd }
+    else if (std.mem.eql(u8, bare, "isqrt"))
+        .{ .isqrt, 1, if (module) calls.module else calls.isqrt }
+    else if (std.mem.eql(u8, bare, "factorial"))
+        .{ .factorial, 1, if (module) calls.module else calls.factorial }
+    else
+        return null;
+    if (!ok) return null;
+    const args = try splitArgs(arena, arg[open + 1 .. arg.len - 1]) orelse return null;
+    // pow(a, b) with two arguments is an expression, not powmod
+    if (args.len != n) return null;
+    const values = try arena.alloc([]const u8, n);
+    for (args, values) |x, *v| {
+        const e = try expand(arena, defs, x) orelse return null;
+        const lit = std.mem.trim(u8, e, "()");
+        if (lit.len == 0 or lit.len + 2 * @as(usize, @intFromBool(lit.len != e.len)) != e.len) return null;
+        for (lit, 0..) |c, i| if (!std.ascii.isDigit(c) and !(i == 0 and c == '-' and lit.len > 1)) return null;
+        v.* = lit;
+    }
+    return .{ .kind = 'I', .packet = graph.Builder.integer(arena, algo, values) catch |e| switch (e) {
+        error.OutOfMemory => return error.OutOfMemory,
+        else => return null,
+    } };
+}
+
+/// One print argument: an integer expression ('I'), or one `==`/`!=` printed as True/False ('B').
+fn piece(arena: Allocator, bank: *const graph.Bank, defs: anytype, arg: []const u8) Allocator.Error!?Piece {
+    const cmp = std.mem.indexOf(u8, arg, "==") orelse std.mem.indexOf(u8, arg, "!=");
+    if (cmp == null) {
+        const e = try expand(arena, defs, arg) orelse return null;
+        return .{ .kind = 'I', .packet = try route.lower(arena, bank, e) orelse return null, .from_piece = true };
+    }
+    const at = cmp.?;
+    const l = try expand(arena, defs, arg[0..at]) orelse return null;
+    const r = try expand(arena, defs, arg[at + 2 ..]) orelse return null;
+    return .{ .kind = 'B', .packet = try compare(arena, bank, l, r, arg[at] == '=') orelse return null, .from_piece = true };
+}
+
+/// `l == r` (or `l != r`) over calc input as one packet printing 1 or 0; null when the bank cannot say it.
+pub fn compare(arena: Allocator, bank: *const graph.Bank, l: []const u8, r: []const u8, eq: bool) Allocator.Error!?[]u8 {
+    if (std.mem.indexOfAny(u8, l, "=!<>") != null or std.mem.indexOfAny(u8, r, "=!<>") != null) return null;
+    // d = l - r; with M = 10^D above |d|, (d+M)%M is 0 only at d = 0, so ((d+M)%M+M-1)//M is d != 0 (d read once)
+    const d = try std.mem.concat(arena, u8, &.{ "(", l, ")-(", r, ")" });
+    const sh = try route.shape(arena, d) orelse return null;
+    const digits = sh.nodes[sh.root].digits;
+    if (digits > 123) return null;
+    const m = try arena.alloc(u8, digits + 1);
+    m[0] = '1';
+    @memset(m[1..], '0');
+    const nz = try std.mem.concat(arena, u8, &.{ "((", d, "+", m, ")%", m, "+", m, "-1)//", m });
+    const e = if (eq) try std.mem.concat(arena, u8, &.{ "1-(", nz, ")" }) else nz;
+    return route.lower(arena, bank, e);
+}
+
+/// `@I<expr>`, `@=<l>;<r>` or `@!<l>;<r>` with `$k` for piece k's printed value; null when `arg` reads none.
+fn template(arena: Allocator, defs: anytype, printed: anytype, arg: []const u8) Allocator.Error!?[]const u8 {
+    var any = false;
+    const cmp = std.mem.indexOf(u8, arg, "==") orelse std.mem.indexOf(u8, arg, "!=");
+    const parts: [2][]const u8 = if (cmp) |at| .{ arg[0..at], arg[at + 2 ..] } else .{ arg, "" };
+    var out: std.ArrayList(u8) = .empty;
+    try out.appendSlice(arena, if (cmp) |at| if (arg[at] == '=') "@=" else "@!" else "@I");
+    for (parts, 0..) |part, side| {
+        if (side == 1 and cmp == null) break;
+        if (side == 1) try out.append(arena, ';');
+        var i: usize = 0;
+        while (i < part.len) {
+            const c = part[i];
+            if (std.ascii.isAlphabetic(c) or c == '_') {
+                const start = i;
+                while (i < part.len and (std.ascii.isAlphanumeric(part[i]) or part[i] == '_')) i += 1;
+                if (printed.get(part[start..i])) |k| {
+                    try out.print(arena, "${d}", .{k});
+                    any = true;
+                } else try out.appendSlice(arena, defs.get(part[start..i]) orelse return null);
+                continue;
+            }
+            if (c != ' ' and c != '\t') try out.append(arena, c);
+            i += 1;
+        }
+    }
+    return if (any) out.items else null;
+}
+
+/// A template piece's packet with each `$k` bound to `values[k]` (decimal text); null for a bad template or index.
+pub fn bind(arena: Allocator, bank: *const graph.Bank, body: []const u8, values: []const ?[]const u8) Allocator.Error!?[]u8 {
+    if (body.len < 2 or body[0] != '@') return null;
+    var out: std.ArrayList(u8) = .empty;
+    var i: usize = 2;
+    while (i < body.len) {
+        if (body[i] != '$') {
+            try out.append(arena, body[i]);
+            i += 1;
+            continue;
+        }
+        const start = i + 1;
+        i = start;
+        while (i < body.len and std.ascii.isDigit(body[i])) i += 1;
+        const k = std.fmt.parseInt(usize, body[start..i], 10) catch return null;
+        if (k >= values.len) return null;
+        const v = values[k] orelse return null;
+        try out.print(arena, "({s})", .{v});
+    }
+    const text = out.items;
+    return switch (body[1]) {
+        'I' => route.lower(arena, bank, text),
+        '=', '!' => {
+            const semi = std.mem.indexOfScalar(u8, text, ';') orelse return null;
+            return compare(arena, bank, text[0..semi], text[semi + 1 ..], body[1] == '=');
+        },
+        else => null,
+    };
+}
+
+/// `src` with every name replaced by its definition and blanks dropped (calc input); null for an undefined name.
+fn expand(arena: Allocator, defs: anytype, src: []const u8) Allocator.Error!?[]const u8 {
+    var out: std.ArrayList(u8) = .empty;
+    var i: usize = 0;
+    while (i < src.len) {
+        const c = src[i];
+        if (std.ascii.isAlphabetic(c) or c == '_') {
+            const start = i;
+            while (i < src.len and (std.ascii.isAlphanumeric(src[i]) or src[i] == '_')) i += 1;
+            try out.appendSlice(arena, defs.get(src[start..i]) orelse return null);
+            continue;
+        }
+        if (c != ' ' and c != '\t') try out.append(arena, c);
+        i += 1;
+    }
+    return if (out.items.len == 0) null else out.items;
+}
+
+/// Top-level comma-separated arguments; null for unbalanced parentheses.
+fn splitArgs(arena: Allocator, src: []const u8) Allocator.Error!?[]const []const u8 {
+    var out: std.ArrayList([]const u8) = .empty;
+    var depth: usize = 0;
+    var start: usize = 0;
+    for (src, 0..) |c, i| switch (c) {
+        '(' => depth += 1,
+        ')' => depth = std.math.sub(usize, depth, 1) catch return null,
+        ',' => if (depth == 0) {
+            try out.append(arena, std.mem.trim(u8, src[start..i], " \t"));
+            start = i + 1;
+        },
+        else => {},
+    };
+    if (depth != 0) return null;
+    const last = std.mem.trim(u8, src[start..], " \t");
+    if (last.len > 0) try out.append(arena, last) else if (out.items.len > 0) return null;
+    return out.items;
+}
+
+/// A definition worth reading from an earlier piece rather than recomputing: it divides or raises to a power.
+fn costly(def: []const u8) bool {
+    return std.mem.indexOf(u8, def, "//") != null or std.mem.indexOfScalar(u8, def, '%') != null or std.mem.indexOf(u8, def, "**") != null;
+}
+
+fn name(s: []const u8) bool {
+    if (s.len == 0 or !(std.ascii.isAlphabetic(s[0]) or s[0] == '_')) return false;
+    for (s) |c| if (!(std.ascii.isAlphanumeric(c) or c == '_')) return false;
+    for ([_][]const u8{ "print", "divmod", "True", "False", "None" }) |k| if (std.mem.eql(u8, s, k)) return false;
+    return true;
+}
+
+/// Whether earlier cells rebind `print` or `divmod`, which this cell's meaning depends on.
+pub fn shadowed(prior: []const []const u8) bool {
+    for (prior) |code| for ([_][]const u8{ "print", "divmod" }) |k| {
+        var at: usize = 0;
+        while (std.mem.indexOfPos(u8, code, at, k)) |i| : (at = i + 1) {
+            const rest = std.mem.trimStart(u8, code[i + k.len ..], " \t");
+            if (rest.len > 0 and (rest[0] == '=' and (rest.len == 1 or rest[1] != '=')) or std.mem.startsWith(u8, rest, ",")) return true;
+            if (i >= 4 and std.mem.eql(u8, code[i - 4 .. i], "def ")) return true;
+        }
+    };
+    return false;
+}
+
+/// An inline or REPL expression the frontend refused, onto 128-digit plans; `%` and REPL `^` (XOR) refuse.
+pub fn direct(a: Allocator, bank: *const graph.Bank, cell: api.Cell, why: api.Abstain) Allocator.Error!?[]u8 {
+    if ((why != .unsupported and why != .too_big) or cell.form == .fence or !std.mem.eql(u8, cell.lang, "python")) return null;
+    var src = std.mem.trim(u8, cell.code, " \t\n");
+    if (cell.form != .inline_expr and std.mem.startsWith(u8, src, ">>>")) src = std.mem.trim(u8, src[3..], " \t");
+    if (src.len == 0 or src.len > 4096 or shadowed(cell.prior)) return null;
+    if (cell.prior.len == 0)
+        if (try @import("runner_frontend_inline_integer.zig").lower(a, bank, src, cell.form == .inline_expr)) |bytes|
+            return bytes;
+    var out: std.ArrayList(u8) = .empty;
+    defer out.deinit(a);
+    var i: usize = 0;
+    while (i < src.len) {
+        const rest = src[i..];
+        if (cell.form == .inline_expr and std.mem.startsWith(u8, rest, "×")) {
+            try out.append(a, '*');
+            i += "×".len;
+        } else if (cell.form == .inline_expr and std.mem.startsWith(u8, rest, "−")) {
+            try out.append(a, '-');
+            i += "−".len;
+        } else {
+            switch (rest[0]) {
+                ' ', '\t' => {},
+                '%' => return null,
+                '^' => if (cell.form == .inline_expr) try out.appendSlice(a, "**") else return null,
+                else => try out.append(a, rest[0]),
+            }
+            i += 1;
+        }
+    }
+    return route.lower(a, bank, out.items);
+}
+
+fn planNames(a: Allocator, src: []const u8) !?[]u8 {
+    var arena_state = std.heap.ArenaAllocator.init(a);
+    defer arena_state.deinit();
+    const sh = try route.shape(arena_state.allocator(), src) orelse return null;
+    var out: std.ArrayList(u8) = .empty;
+    errdefer out.deinit(a);
+    for (sh.nodes, sh.live, sh.plans) |n, on, plan_name| if (on and n.kind != .literal) {
+        if (out.items.len != 0) try out.append(a, ' ');
+        try out.appendSlice(a, plan_name);
+    };
+    return try out.toOwnedSlice(a);
+}
+
+test "runner graph route: pure-integer calc programs become bank plans sized from their syntax" {
+    const a = std.testing.allocator;
+    for ([_][2][]const u8{
+        .{ "2**100-3**50", "pow-100-62 pow-50-62 sub-32" },
+        .{ "47*83", "mul-4" },
+        .{ "-7//2", "div-1" },
+        .{ "1071%462", "mod-4" },
+        .{ "-(2+3)", "add-2 sub-4" },
+        .{ "(-3)**5", "pow-5-62" },
+        .{ "10**61", "pow-61-62" },
+        .{ "(2+3)*4-1", "add-2 mul-4 sub-4" },
+        .{ "42", "" },
+        .{ "10**62", "pow-62-128" },
+        .{ "1000000000000000000000000000000000000000*100000000000000000000000000000", "mul-128" },
+        // big-number-020: (Y+B)**2 - Y**2 as B*(Y+(Y+B)), so no value passes 128 digits
+        .{ "(10**80+123456789)**2-10**160", "pow-80-128 add-128 add-128 mul-128" },
+    }) |c| {
+        const got = (try planNames(a, c[0])) orelse {
+            std.debug.print("not routed: {s}\n", .{c[0]});
+            return error.TestExpectedRoute;
+        };
+        defer a.free(got);
+        try std.testing.expectEqualStrings(c[1], got);
+    }
+}
+
+test "runner graph route: decimals, true division, computed exponents or divisors and values past 256 digits stay on calc" {
+    const a = std.testing.allocator;
+    for ([_][]const u8{
+        "1/2",
+        "1.5*2",
+        "2**-1",
+        "2**3**2",
+        "2**(3)",
+        "7//0",
+        "7%(1+1)",
+        "10**256", // past T1's 256-digit width (b047d48c8); a bank without it refuses at lowering
+        "(10**130+123456789)**2-10**261",
+        "(10**90+123456789)**3-10**270",
+        "007+1",
+        "x*2",
+        "",
+        "(1+2",
+        "2**1000",
+        "3^2",
+    }) |src| {
+        if (try planNames(a, src)) |got| {
+            defer a.free(got);
+            std.debug.print("routed: {s}\n", .{src});
+            return error.TestUnexpectedRoute;
+        }
+    }
+}
diff --git a/zig/src/core/runner_graph_route.zig b/zig/src/core/runner_graph_route.zig
new file mode 100644
index 000000000..726fbbbe4
--- /dev/null
+++ b/zig/src/core/runner_graph_route.zig
@@ -0,0 +1,465 @@
+//! <prefix>_BACKEND=graph: pure-integer calc programs run as one packet of T1's bank plans (128 digits).
+const std = @import("std");
+const api = @import("runner_api.zig");
+const graph = @import("runner_graph.zig");
+const packet = @import("runner_graph_packet.zig");
+const Family = packet.Family;
+const Allocator = std.mem.Allocator;
+const prog = @import("runner_graph_program.zig");
+pub const program = prog.program;
+
+/// One node of the program, children first; `digits` bounds its value's decimal digits from syntax alone.
+const Node = struct {
+    kind: enum { literal, neg, binary, pow },
+    family: Family = .add,
+    l: u32 = 0,
+    r: u32 = 0,
+    text: []const u8 = "",
+    k: u16 = 0,
+    digits: u32,
+    span: []const u8 = "", // its source text, for structural matches
+};
+
+const max_digits: u32 = packet.max_digits;
+
+const Invalid = error{ Unsupported, OutOfMemory };
+
+/// Calc firmware input over integer literals, + - * // % ** and parentheses; widths are checked when lowering.
+const Parser = struct {
+    a: Allocator,
+    src: []const u8,
+    pos: usize = 0,
+    nodes: std.ArrayList(Node) = .empty,
+    depth: u32 = 0,
+
+    fn peek(p: *Parser, token: []const u8) bool {
+        return std.mem.startsWith(u8, p.src[p.pos..], token);
+    }
+    fn take(p: *Parser, token: []const u8) bool {
+        if (!p.peek(token)) return false;
+        p.pos += token.len;
+        return true;
+    }
+    fn add(p: *Parser, n: Node) Invalid!u32 {
+        if (p.nodes.items.len >= packet.max_ops) return error.Unsupported;
+        try p.nodes.append(p.a, n);
+        return @intCast(p.nodes.items.len - 1);
+    }
+    fn at(p: *Parser, i: u32) Node {
+        return p.nodes.items[i];
+    }
+
+    fn expr(p: *Parser) Invalid!u32 {
+        p.depth += 1;
+        defer p.depth -= 1;
+        if (p.depth > 32) return error.Unsupported;
+        var l = try p.term();
+        while (true) {
+            const f: Family = if (p.take("+")) .add else if (p.take("-")) .sub else return l;
+            l = try p.binary(f, l, try p.term());
+        }
+    }
+
+    fn term(p: *Parser) Invalid!u32 {
+        var l = try p.unary();
+        while (true) {
+            if (p.peek("**")) return error.Unsupported;
+            const f: Family = if (p.take("//")) .div else if (p.peek("/")) return error.Unsupported else if (p.take("*")) .mul else if (p.take("%")) .mod else return l;
+            l = try p.binary(f, l, try p.unary());
+        }
+    }
+
+    fn unary(p: *Parser) Invalid!u32 {
+        if (p.take("+")) return p.unary();
+        if (!p.take("-")) return p.power();
+        const c = try p.unary();
+        const n = p.at(c);
+        if (n.kind == .literal and n.text[0] != '-')
+            return p.add(.{ .kind = .literal, .text = try std.mem.concat(p.a, u8, &.{ "-", n.text }), .digits = n.digits });
+        // -x is 0 - x
+        return p.add(.{ .kind = .neg, .r = c, .digits = n.digits });
+    }
+
+    fn power(p: *Parser) Invalid!u32 {
+        const base = try p.atom();
+        if (!p.take("**")) return base;
+        // the exponent is control data: a plain literal, so it selects a prepared pow-<k>-<width> schedule
+        const start = p.pos;
+        while (p.pos < p.src.len and std.ascii.isDigit(p.src[p.pos])) p.pos += 1;
+        const k = std.fmt.parseInt(u16, p.src[start..p.pos], 10) catch return error.Unsupported;
+        if (k > 999 or (p.pos - start > 1 and p.src[start] == '0') or p.peek("**") or p.peek(".")) return error.Unsupported;
+        const b = p.at(base);
+        const digits: u32 = if (k == 0) 1 else if (b.kind == .literal) literalPowDigits(b.text, k) else @min(1 << 20, b.digits * k);
+        return p.add(.{ .kind = .pow, .l = base, .k = k, .digits = digits, .span = if (b.span.len > 0) p.src[b.span.ptr - p.src.ptr .. p.pos] else "" });
+    }
+
+    fn atom(p: *Parser) Invalid!u32 {
+        if (p.take("(")) {
+            const e = try p.expr();
+            if (!p.take(")")) return error.Unsupported;
+            // `(x)` has x's value; its span keeps the parentheses, so `(x)**2` and `x` differ only by them
+            return e;
+        }
+        const start = p.pos;
+        while (p.pos < p.src.len and std.ascii.isDigit(p.src[p.pos])) p.pos += 1;
+        const n = p.pos - start;
+        if (n == 0 or (n > 1 and p.src[start] == '0') or p.peek(".")) return error.Unsupported;
+        return p.add(.{ .kind = .literal, .text = p.src[start..p.pos], .digits = @intCast(n), .span = p.src[start..p.pos] });
+    }
+
+    fn binary(p: *Parser, f: Family, l: u32, r: u32) Invalid!u32 {
+        const dl = p.at(l).digits;
+        const dr = p.at(r).digits;
+        if (f == .div or f == .mod) {
+            // only a nonzero literal divisor: Python raises on zero, a computed divisor could be zero
+            const d = p.at(r);
+            if (d.kind != .literal or std.mem.eql(u8, std.mem.trimStart(u8, d.text, "-"), "0")) return error.Unsupported;
+        }
+        const digits = switch (f) {
+            .add, .sub => @max(dl, dr) + 1,
+            .mul => dl + dr,
+            // |a // b| < 10^(da-db+1), plus one for the floor; never more than |a| itself
+            .div => @min(dl, @max(1, (dl + 2) -| dr)),
+            .mod => dr,
+            .pow => unreachable,
+        };
+        if (f == .sub) if (try p.squareOffset(l, r)) |n| return n;
+        const span = if (p.at(l).span.len > 0 and p.at(r).span.len > 0) p.src[p.at(l).span.ptr - p.src.ptr .. p.at(r).span.ptr - p.src.ptr + p.at(r).span.len] else "";
+        return p.add(.{ .kind = .binary, .family = f, .l = l, .r = r, .digits = digits, .span = span });
+    }
+
+    /// (Y+B)**2 - Y**2 (or L**(2k) for Y = L**k) as B*(Y+(Y+B)), without the square's width (big-number-020).
+    fn squareOffset(p: *Parser, l: u32, r: u32) Invalid!?u32 {
+        const sq = p.at(l);
+        if (sq.kind != .pow or sq.k != 2) return null;
+        const x = p.at(sq.l);
+        if (x.kind != .binary or x.family != .add) return null;
+        const same = struct {
+            fn f(q: *Parser, y: u32, rhs: Node) bool {
+                const yn = q.at(y);
+                if (rhs.kind != .pow) return false;
+                if (rhs.k == 2 and yn.span.len > 0 and std.mem.eql(u8, q.at(rhs.l).span, yn.span)) return true;
+                // L**(2k) against Y = L**k, over the same literal L
+                const base = q.at(rhs.l);
+                return yn.kind == .pow and base.kind == .literal and q.at(yn.l).kind == .literal and
+                    std.mem.eql(u8, base.text, q.at(yn.l).text) and rhs.k == 2 * @as(u32, yn.k);
+            }
+        }.f;
+        const rhs = p.at(r);
+        const y, const b = if (same(p, x.l, rhs)) .{ x.l, x.r } else if (same(p, x.r, rhs)) .{ x.r, x.l } else return null;
+        const yx = try p.add(.{ .kind = .binary, .family = .add, .l = y, .r = sq.l, .digits = @max(p.at(y).digits, x.digits) + 1 });
+        return try p.add(.{ .kind = .binary, .family = .mul, .l = b, .r = yx, .digits = p.at(b).digits + p.at(yx).digits });
+    }
+};
+
+/// Builder.binary's bucket: add/sub cover the wider operand plus a carry, mul the digit sum, div/mod the wider operand.
+fn plan(a: Allocator, f: Family, dl: u32, dr: u32) error{ Unsupported, OutOfMemory }![]const u8 {
+    const needed = switch (f) {
+        .add, .sub => @max(dl, dr) + 1,
+        .mul => dl + dr,
+        .div, .mod => @max(dl, dr),
+        .pow => unreachable,
+    };
+    if (needed > max_digits) return error.Unsupported;
+    // 256: T1's b047d48c8 widths; a bank without that plan (v4, or div/mod) refuses at lowering, never here
+    const width = for ([_]u16{ 1, 2, 4, 8, 16, 32, 62, 128, 256 }) |n| {
+        if (n >= needed) break n;
+    } else return error.Unsupported;
+    return std.fmt.allocPrint(a, "{t}-{d}", .{ f, width });
+}
+
+/// Digits of |b|**k bounded from the literal's own digits: floor(k * log10|b|) + 1, rounded up for safety.
+fn literalPowDigits(text: []const u8, k: u16) u32 {
+    const digits = std.mem.trimStart(u8, text, "-");
+    if (std.mem.eql(u8, digits, "0") or std.mem.eql(u8, digits, "1")) return 1;
+    const lead = @min(digits.len, 15);
+    const m = std.fmt.parseFloat(f64, digits[0..lead]) catch return 1 << 20;
+    // past 15 digits the leading part rounds up, so the bound stays above the true value
+    const log = std.math.log10(if (digits.len > lead) m + 1 else m) + @as(f64, @floatFromInt(digits.len - lead));
+    const bound = @floor(@as(f64, @floatFromInt(k)) * log + 1e-9) + 1;
+    return if (bound > 1 << 20) 1 << 20 else @intFromFloat(bound);
+}
+
+/// A prepared constant back to the decimal text that binds it (plan data such as 0 and 1, never an answer).
+fn constantText(a: Allocator, v: *const packet.Value) ![]u8 {
+    var buf: [packet.max_digits + 1]u8 = undefined;
+    var top: usize = 0;
+    var digits: [packet.max_digits]u8 = undefined;
+    for (&digits, 0..) |*d, i| {
+        d.* = 0;
+        for (0..4) |bit| if (v[i / 31][2 + i % 31 * 4 + bit] != 0) {
+            d.* |= @as(u8, 1) << @intCast(bit);
+        };
+        if (d.* > 9) return error.GraphLiteral;
+        if (d.* != 0) top = i;
+    }
+    var n: usize = 0;
+    if (v[0][126] != 0) {
+        buf[0] = '-';
+        n = 1;
+    }
+    var i = top + 1;
+    while (i > 0) : (i -= 1) {
+        buf[n] = '0' + digits[i - 1];
+        n += 1;
+    }
+    const text = try a.dupe(u8, buf[0..n]);
+    const back = try packet.literal(text);
+    if (!std.mem.eql(u8, std.mem.asBytes(&back), std.mem.asBytes(v))) return error.GraphLiteral;
+    return text;
+}
+
+pub const Shape = struct {
+    nodes: []const Node,
+    root: u32,
+    live: []const bool, // reachable from root; only these are lowered and width-checked
+    plans: []const []const u8, // each live operation's bank plan
+};
+
+/// Calc input `src` as nodes with their bank plans; null when any live part is not a graph route.
+pub fn shape(arena: Allocator, src: []const u8) Allocator.Error!?Shape {
+    if (src.len == 0 or src.len > 4096) return null;
+    var p: Parser = .{ .a = arena, .src = src };
+    const root = p.expr() catch |e| return if (e == error.OutOfMemory) error.OutOfMemory else null;
+    if (p.pos != src.len) return null;
+    const nodes = p.nodes.items;
+    const live = try arena.alloc(bool, nodes.len);
+    @memset(live, false);
+    live[root] = true;
+    var i = nodes.len;
+    while (i > 0) : (i -= 1) if (live[i - 1]) switch (nodes[i - 1].kind) {
+        .literal => {},
+        .neg => live[nodes[i - 1].r] = true,
+        .pow => live[nodes[i - 1].l] = true,
+        .binary => {
+            live[nodes[i - 1].l] = true;
+            live[nodes[i - 1].r] = true;
+        },
+    };
+    const plans = try arena.alloc([]const u8, nodes.len);
+    for (nodes, live, plans) |n, on, *name| {
+        name.* = "";
+        if (!on) continue;
+        if (n.digits > max_digits) return null;
+        name.* = switch (n.kind) {
+            .literal => continue,
+            .neg => plan(arena, .sub, 1, n.digits),
+            .binary => plan(arena, n.family, nodes[n.l].digits, nodes[n.r].digits),
+            .pow => std.fmt.allocPrint(arena, "pow-{d}-{d}", .{ n.k, @as(u32, if (n.digits > 128) 256 else if (n.digits > 62) 128 else 62) }),
+        } catch |e| return if (e == error.OutOfMemory) error.OutOfMemory else null;
+    }
+    return .{ .nodes = nodes, .root = root, .live = live, .plans = plans };
+}
+
+/// Calc input `src` as one graph packet inlining each operation's named plan from `bank`, else null.
+pub fn lower(a: Allocator, bank: *const graph.Bank, src: []const u8) Allocator.Error!?[]u8 {
+    var arena_state = std.heap.ArenaAllocator.init(a);
+    defer arena_state.deinit();
+    const arena = arena_state.allocator();
+    const sh = try shape(arena, src) orelse return null;
+    const nodes = sh.nodes;
+    // pass 1: every bound value first (literals, then each plan's constants), as the packet requires
+    var values: std.ArrayList([]const u8) = .empty;
+    const value_at = try arena.alloc(u32, nodes.len);
+    const const_at = try arena.alloc(u32, nodes.len);
+    const plans = try arena.alloc(?*const @import("runner_graph_bank.zig").PreparedPlan, nodes.len);
+    var zero: ?u32 = null;
+    for (nodes, 0..) |n, i| {
+        plans[i] = null;
+        if (!sh.live[i]) continue;
+        if (n.kind == .literal) {
+            value_at[i] = @intCast(values.items.len);
+            try values.append(arena, n.text);
+            continue;
+        }
+        const pp = bank.plan(sh.plans[i]) orelse return null;
+        if (pp.algorithm != null) return null;
+        if (pp.inputs != @as(u32, if (n.kind == .pow) 1 else 2)) return null;
+        plans[i] = pp;
+        const_at[i] = @intCast(values.items.len);
+        for (pp.constants) |*c| try values.append(arena, constantText(arena, c) catch |e| return if (e == error.OutOfMemory) error.OutOfMemory else null);
+        if (n.kind == .neg and zero == null) {
+            zero = @intCast(values.items.len);
+            try values.append(arena, "0");
+        }
+    }
+    if (values.items.len > packet.max_values) return null;
+    // pass 2: each plan's ops with its inputs, constants and outputs renumbered into the packet
+    var ops: std.ArrayList(packet.Op) = .empty;
+    var count: u32 = @intCast(values.items.len);
+    for (nodes, 0..) |n, i| {
+        const pp = plans[i] orelse continue;
+        const ins: [2]u32 = switch (n.kind) {
+            .literal => unreachable,
+            .neg => .{ zero.?, value_at[n.r] },
+            .binary => .{ value_at[n.l], value_at[n.r] },
+            .pow => .{ value_at[n.l], 0 },
+        };
+        const m: Map = .{ .ins = ins[0..pp.inputs], .consts = const_at[i], .n_consts = @intCast(pp.constants.len), .base = count };
+        for (pp.ops) |op| {
+            if (ops.items.len >= packet.max_ops) return null;
+            var o = op;
+            o.a = m.ref(op.a);
+            if (op.b) |b| o.b = m.ref(b);
+            if (op.args) |args| {
+                const re = try arena.alloc(u32, args.len);
+                for (args, re) |x, *y| y.* = m.ref(x);
+                o.args = re;
+            }
+            if (op.copies.len != 0) {
+                const re = try arena.dupe(packet.Copy, op.copies);
+                for (re) |*c| c.ref = m.ref(c.ref);
+                o.copies = re;
+            }
+            if (op.flags) |f| o.flags = m.ref(f);
+            try ops.append(arena, o);
+            count += op.outputs;
+        }
+        value_at[i] = m.ref(pp.result);
+    }
+    const result = value_at[sh.root];
+    _ = bank.validate(values.items.len, ops.items, result) catch return null;
+    return graph.Builder.encode(a, .{ .values = values.items, .ops = ops.items, .result = result }) catch |e| switch (e) {
+        error.OutOfMemory => error.OutOfMemory,
+        else => null,
+    };
+}
+
+/// A plan's own references (inputs, then constants, then its outputs) to packet references.
+const Map = struct {
+    ins: []const u32,
+    consts: u32,
+    n_consts: u32,
+    base: u32,
+
+    fn ref(m: Map, r: u32) u32 {
+        const n_in: u32 = @intCast(m.ins.len);
+        if (r < n_in) return m.ins[r];
+        if (r < n_in + m.n_consts) return m.consts + (r - n_in);
+        return m.base + (r - n_in - m.n_consts);
+    }
+};
+
+/// The most hex digits a bare literal cell converts: 16^100 has 121 decimal digits, under the bank's 128.
+pub const max_hex = 100;
+
+/// A bare hex literal cell (`0xFEDC… =`): Horner's rule on the bank over its digits, so the circuit does the radix.
+pub fn hexLiteral(a: Allocator, bank: *const graph.Bank, cell: api.Cell) Allocator.Error!?[]u8 {
+    if ((cell.form != .inline_expr and cell.form != .repl) or !std.mem.eql(u8, cell.lang, "python")) return null;
+    const src = std.mem.trim(u8, cell.code, " \t");
+    if (src.len < 4 or src.len > 2 + max_hex or src[0] != '0' or (src[1] != 'x' and src[1] != 'X')) return null;
+    const hex = src[2..];
+    for (hex) |c| if (!std.ascii.isHex(c)) return null;
+    var arena_state = std.heap.ArenaAllocator.init(a);
+    defer arena_state.deinit();
+    const arena = arena_state.allocator();
+    const values = try arena.alloc([]const u8, hex.len + 1);
+    values[0] = "16";
+    for (hex, 1..) |c, i| values[i] = try std.fmt.allocPrint(arena, "{d}", .{std.fmt.charToDigit(c, 16) catch unreachable});
+    var ops: std.ArrayList(packet.Op) = .empty;
+    var acc: u32 = 1;
+    for (2..values.len) |k| {
+        // after k digits the value is below 16^k: at most k*1.21 + 1 decimal digits (log10 16 < 1.21)
+        const w = for ([_]u8{ 1, 2, 4, 8, 16, 32, 62, 128 }) |x| {
+            if (k * 121 / 100 + 1 <= x) break x;
+        } else return null;
+        if (bank.find("mul", w) == null or bank.find("add", w) == null) return null;
+        const digit: u32 = @intCast(k);
+        const product: u32 = @intCast(values.len + ops.items.len);
+        try ops.append(arena, .{ .op = "mul", .width = w, .args = try arena.dupe(u32, &.{ acc, 0 }), .checked = true });
+        try ops.append(arena, .{ .op = "add", .width = w, .args = try arena.dupe(u32, &.{ product, digit }), .checked = true });
+        acc = product + 1;
+    }
+    _ = bank.validate(values.len, ops.items, acc) catch return null;
+    return packet.Builder.program(a, values, ops.items, &.{.{ .ref = acc }}) catch |e| return if (e == error.OutOfMemory) error.OutOfMemory else null;
+}
+
+/// A frontend that runs `inner`, then moves a pure-integer calc program onto the graph bank; calc and ELF otherwise.
+pub const Routed = struct {
+    inner: api.Frontend,
+    bank: *const graph.Bank,
+
+    pub fn frontend(r: *Routed) api.Frontend {
+        return .{ .ctx = r, .translate = translate };
+    }
+
+    /// The graph steps before the inner frontend (no compile): T1's binding, a straight-line program, a whole script.
+    fn graphFirst(r: *const Routed, a: Allocator, cell: api.Cell) Allocator.Error!?[]u8 {
+        const source_frontend = @import("runner_frontend.zig");
+        if (cell.form == .inline_expr and r.inner.ctx != null and
+            r.inner.translate == source_frontend.frontend().translate)
+        {
+            const context: *const source_frontend.Context = @ptrCast(@alignCast(r.inner.ctx.?));
+            if (!context.exact_inline) return null;
+        }
+        if (try hexLiteral(a, r.bank, cell)) |bytes| return bytes;
+        if (try @import("runner_graph_edit.zig").cell(a, r.bank, cell)) |bytes| return bytes;
+        if (try graph.bindCell(a, r.bank, cell)) |bytes| return bytes;
+        if (cell.form != .inline_expr and std.mem.eql(u8, cell.lang, "python") and !prog.shadowed(cell.prior))
+            if (try prog.program(a, r.bank, cell.code)) |bytes| return bytes;
+        // a whole script the frontend checks runs on the bank before any compile; earlier cells' names stay on its path
+        if (cell.form != .inline_expr and std.mem.eql(u8, cell.lang, "python") and cell.prior.len == 0)
+            if (try @import("runner_graph_table.zig").translate(a, r.bank, cell.code)) |bytes| return bytes;
+        // an inline `gcd(a, b) =` (the scanner's literal call) is math.gcd's plan, as the printed Python call
+        if (cell.form == .inline_expr and std.mem.startsWith(u8, cell.code, "gcd(") and cell.code.len <= 160) {
+            var src: [200]u8 = undefined;
+            const py = std.fmt.bufPrint(&src, "from math import gcd\nprint({s})", .{cell.code}) catch unreachable;
+            if (try prog.program(a, r.bank, py)) |bytes| return bytes;
+        }
+        return null;
+    }
+
+    fn translate(ctx: ?*anyopaque, a: Allocator, cell: api.Cell) Allocator.Error!api.Translation {
+        const r: *Routed = @ptrCast(@alignCast(ctx.?));
+        // R5: a literal-only inline value (`140 mod 9`, `10^9 mod 11`) reads no earlier cell, so it runs without them
+        if (cell.form == .inline_expr and cell.prior.len != 0 and closedLiteral(cell.code)) {
+            var alone = cell;
+            alone.prior = &.{};
+            return translate(ctx, a, alone);
+        }
+        if (try r.graphFirst(a, cell)) |bytes| return .{ .program = .{ .kind = .graph, .bytes = bytes } };
+        const t = try r.inner.translate(r.inner.ctx, a, cell);
+        if (t == .abstain) if (try prog.direct(a, r.bank, cell, t.abstain)) |bytes| return .{ .program = .{ .kind = .graph, .bytes = bytes } };
+        if (t != .program or t.program.kind != .calc) return t;
+        const bytes = try lower(a, r.bank, t.program.bytes) orelse return t;
+        a.free(t.program.bytes); // the calc program the graph replaces
+        return .{ .program = .{ .kind = .graph, .bytes = bytes } };
+    }
+};
+
+/// An inline value of literals only: digits, `+ - * ^`, brackets, the word `mod`; no name, call, `%`, `.`, `/` or `e`.
+pub fn closedLiteral(code: []const u8) bool {
+    var i: usize = 0;
+    var digit = false;
+    while (i < code.len) : (i += 1) {
+        if (std.mem.startsWith(u8, code[i..], " mod ")) {
+            i += 4;
+            continue;
+        }
+        switch (code[i]) {
+            '0'...'9' => digit = true,
+            ' ', '(', ')', '+', '-', '*', '^' => {},
+            else => return false,
+        }
+    }
+    return digit;
+}
+
+/// <prefix>_SYNC_GRAPH on the engine thread: the whole route for an inline value, else its graph steps only.
+pub const Quick = struct {
+    routed: *Routed,
+
+    pub fn frontend(q: *Quick) api.Frontend {
+        return .{ .ctx = q, .translate = translate };
+    }
+
+    fn translate(ctx: ?*anyopaque, a: Allocator, cell: api.Cell) Allocator.Error!api.Translation {
+        const q: *Quick = @ptrCast(@alignCast(ctx.?));
+        if (cell.form == .inline_expr) return Routed.translate(q.routed, a, cell);
+        const bytes = try q.routed.graphFirst(a, cell) orelse return .{ .abstain = .unsupported };
+        return .{ .program = .{ .kind = .graph, .bytes = bytes } };
+    }
+};
+
+/// Graph programs to the graph backend, calc and ELF to the circuit (runner_graph_dispatch.zig).
+pub const Dispatch = @import("runner_graph_dispatch.zig").Dispatch;
