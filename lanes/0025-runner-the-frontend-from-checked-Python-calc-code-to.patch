+pub const prime =
+    \\def is_prime(n):
+    \\    if n < 2:
+    \\        return False
+    \\    if n % 2 == 0:
+    \\        return n == 2
+    \\    d = 3
+    \\    while d * d <= n:
+    \\        if n % d == 0:
+    \\            return False
+    \\        d += 2
+    \\    return True
+    \\primes = []
+    \\n = 2
+    \\while len(primes) < 100:
+    \\    if is_prime(n):
+    \\        primes.append(n)
+    \\    n += 1
+    \\print("100th prime:", primes[-1])
+    \\print("Sum of first 100 primes:", sum(primes))
+;
+
+pub const factorial =
+    \\def factorial(n):
+    \\    if n < 0:
+    \\        raise ValueError("factorial is undefined for negative values")
+    \\    result = 1
+    \\    for i in range(2, n + 1):
+    \\        result *= i
+    \\    return result
+    \\for n in [0, 1, 5, 12]:
+    \\    print(f"{n}! = {factorial(n)}")
+;
+
+const bounded_lcm =
