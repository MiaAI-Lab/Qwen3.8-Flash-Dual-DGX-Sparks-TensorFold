--- /dev/null
+++ b/zig/src/core/runner_frontend_cwide_test.zig
@@ -0,0 +1,190 @@
+const std = @import("std");
+const compiler = @import("runner_frontend_program_compile.zig");
+const frontend = @import("runner_frontend.zig");
+const reference = @import("runner_frontend_reference_test.zig");
+const t = std.testing;
+
+pub const observed_fibonacci =
+    \\#include <stdio.h>
+    \\
+    \\unsigned long long fib_iter(unsigned int n) {
+    \\    if (n == 0) return 0ULL;
+    \\    if (n == 1) return 1ULL;
+    \\
+    \\    unsigned long long a = 0ULL; // F(0)
+    \\    unsigned long long b = 1ULL; // F(1)
+    \\    unsigned long long next;
+    \\
+    \\    for (unsigned int i = 2; i <= n; ++i) {
+    \\        next = a + b;
+    \\        a = b;
+    \\        b = next;
+    \\    }
+    \\
+    \\    return b;
+    \\}
+    \\
+    \\int main(void) {
+    \\    unsigned int indices[] = {0, 1, 10, 40};
+    \\    size_t count = sizeof(indices) / sizeof(indices[0]);
+    \\
+    \\    for (size_t i = 0; i < count; ++i) {
+    \\        unsigned int n = indices[i];
+    \\        printf("F(%u) = %llu\n", n, fib_iter(n));
+    \\    }
+    \\
+    \\    return 0;
+    \\}
+;
+
+test "wide printf lexical validation accepts only supported lengths and conversions" {
+    const good = [_][]const u8{
+        "printf(\"%lld %lli %llu\\n\", -1LL, 2LL, 3ULL);",
+        "printf(\"%%llu %d %i %u %c %s\", -1, 2, 3u, 'x', \"ok\");",
+        "// printf(\"%lln\", 0);\nprintf(\"%llu\", 0ULL);",
+        "const char *s = \"%lln\"; printf(\"%s\", s);",
+        observed_fibonacci,
+    };
+    for (good) |source| try t.expect(compiler.safeFormats(source));
+    const bad = [_][]const u8{
+        "printf(\"%ll\", 1ULL);",
+        "printf(\"%l\", 1L);",
+        "printf(\"%\");",
+        "printf(\"%llu",
+        "printf(\"%llllu\", 1ULL);",
+        "printf(\"%ld\", 1L);",
+        "printf(\"%lu\", 1UL);",
+        "printf(\"%llx\", 1ULL);",
+        "printf(\"%llf\", 1.0);",
+        "printf(\"%lls\", \"text\");",
+        "printf(\"%llc\", 'x');",
+        "printf(\"%lln\", 0);",
+        "printf(\"%ll%\");",
+        "printf(\"%020llu\", 1ULL);",
+        "printf(\"%+lld\", 1LL);",
+        "printf(\"%.*llu\", 2, 1ULL);",
+        "printf(\"%1$llu\", 1ULL);",
+        "printf(\"%ll\" \"u\", 1ULL);",
+        "printf(\"\\x25llu\", 1ULL);",
+        "printf(format, 1ULL);",
+    };
+    for (bad) |source| try t.expect(!compiler.safeFormats(source));
+}
+
+test "observed unsigned long long C Fibonacci fence executes exactly" {
+    var env = try t.environ.createMap(t.allocator);
+    defer env.deinit();
+    const clang = env.get("TF_RUNNER_CLANG") orelse return error.SkipZigTest;
+    const root = env.get("TF_RUNNER_QWENPUTER") orelse return error.SkipZigTest;
+    var context: frontend.Context = .{
+        .io = t.io,
+        .compiler = .{ .clang = clang, .linker = env.get("TF_RUNNER_LLD") },
+    };
+    const front = context.frontend();
+    const result = try front.translate(front.ctx, t.allocator, .{
+        .form = .fence,
+        .lang = "c",
+        .code = observed_fibonacci,
+    });
+    try t.expect(result == .program);
+    defer t.allocator.free(result.program.bytes);
+    try t.expectEqual(.elf, result.program.kind);
+    try reference.check(root, env.get("TF_RUNNER_REFERENCE_PYTHON") orelse "/usr/bin/python3", result.program, "F(0) = 0\nF(1) = 1\nF(10) = 55\nF(40) = 102334155\n");
+}
+
+test "wide C decimals preserve extrema signs aliases varargs alignment and printf counts" {
+    var env = try t.environ.createMap(t.allocator);
+    defer env.deinit();
+    const clang = env.get("TF_RUNNER_CLANG") orelse return error.SkipZigTest;
+    const root = env.get("TF_RUNNER_QWENPUTER") orelse return error.SkipZigTest;
+    const cases = [_][2][]const u8{
+        .{ "printf(\"%llu\", 18446744073709551615ULL);", "18446744073709551615" },
+        .{ "printf(\"%lld\", (-9223372036854775807LL - 1LL));", "-9223372036854775808" },
+        .{ "printf(\"%lli\", 9223372036854775807LL);", "9223372036854775807" },
+        .{ "printf(\"%lld %lli %llu\", -1LL, 0LL, 0ULL);", "-1 0 0" },
+        .{ "uint64_t n = 4294967296ULL; int64_t s = -4294967296LL; printf(\"%llu %lli\", n, s);", "4294967296 -4294967296" },
+        .{ "printf(\"%d %llu %u %lld %s %c %%\", -7, 18446744073709551615ULL, 9u, -8LL, \"ok\", 'x');", "-7 18446744073709551615 9 -8 ok x %" },
+        .{ "int n = printf(\"%llu\", 18446744073709551615ULL); printf(\" %d\", n);", "18446744073709551615 20" },
+        .{ "int n = printf(\"%lld\", (-9223372036854775807LL - 1LL)); printf(\" %d\", n);", "-9223372036854775808 20" },
+        .{ "unsigned long long a = 0, b = 1; for(int i = 2; i <= 93; ++i) {" ++ " unsigned long long next = a + b; a = b; b = next; } printf(\"%llu\", b);", "12200160415121876738" },
+    };
+    for ([_]compiler.Config{ .{ .optimize = .O0 }, .{ .optimize = .O1 } }) |profile| {
+        for (cases) |case| {
+            const source = try std.fmt.allocPrint(t.allocator, "int main(void) {{ {s} return 0; }}", .{case[0]});
+            defer t.allocator.free(source);
+            const elf = (try compiler.compile(t.allocator, t.io, source, .{
+                .clang = clang,
+                .linker = env.get("TF_RUNNER_LLD"),
+                .optimize = profile.optimize,
+                .step_budget = 0,
+            })) orelse return error.UnexpectedAbstention;
+            defer t.allocator.free(elf);
+            try checkWide(root, env.get("TF_RUNNER_REFERENCE_PYTHON") orelse "/usr/bin/python3", elf, case[1]);
+        }
+    }
+}
+
+test "C compiler refuses wide printf argument width and count mismatches" {
+    var env = try t.environ.createMap(t.allocator);
+    defer env.deinit();
+    const clang = env.get("TF_RUNNER_CLANG") orelse return error.SkipZigTest;
+    _ = env.get("TF_RUNNER_QWENPUTER") orelse return error.SkipZigTest;
+    const control = (try compiler.compile(t.allocator, t.io, "int main(void) { printf(\"%llu\", 1ULL); return 0; }", .{
+        .clang = clang,
+        .linker = env.get("TF_RUNNER_LLD"),
+    })) orelse return error.UnexpectedAbstention;
+    defer t.allocator.free(control);
+    const bad = [_][]const u8{
+        "printf(\"%llu\", 1u);",
+        "printf(\"%lld\", 1);",
+        "printf(\"%lli\", 1L);",
+        "printf(\"%llu\", 1.0);",
+        "printf(\"%llu\");",
+        "printf(\"%d\", 1LL);",
+        "printf(\"%lu\", 1ULL);",
+        "printf(\"%lln\", 0);",
+    };
+    for (bad) |body| {
+        const source = try std.fmt.allocPrint(t.allocator, "int main(void) {{ {s} return 0; }}", .{body});
+        defer t.allocator.free(source);
+        const result = try compiler.compile(t.allocator, t.io, source, .{
+            .clang = clang,
+            .linker = env.get("TF_RUNNER_LLD"),
+        });
+        defer if (result) |elf| t.allocator.free(elf);
+        try t.expect(result == null);
+    }
+}
+
+fn checkWide(root: []const u8, python: []const u8, elf: []const u8, expected: []const u8) !void {
+    var tmp = t.tmpDir(.{});
+    defer tmp.cleanup();
+    const file = try tmp.dir.createFile(t.io, "wide.elf", .{});
+    defer file.close(t.io);
+    try file.writeStreamingAll(t.io, elf);
+    const path = try tmp.dir.realPathFileAlloc(t.io, "wide.elf", t.allocator);
+    defer t.allocator.free(path);
+    const script =
+        \\import sys
+        \\from pathlib import Path
+        \\sys.path.insert(0, str(Path(sys.argv[1]) / 'experimental/riscv'))
+        \\from chipformer.rv import elf, ref
+        \\m = ref.Machine.from_program(elf.program(sys.argv[2]))
+        \\m.run(5000000)
+        \\assert m.halted and m.fault is None and m.exit_code == 0, (m.halted, m.fault, m.exit_code)
+        \\sys.stdout.buffer.write(bytes(m.out))
+    ;
+    const result = try std.process.run(t.allocator, t.io, .{
+        .argv = &.{ python, "-c", script, root, path },
+        .stdout_limit = .limited(4096),
+        .stderr_limit = .limited(16384),
+        .timeout = .{ .duration = .{ .raw = .fromSeconds(10), .clock = .awake } },
+    });
+    defer t.allocator.free(result.stdout);
+    defer t.allocator.free(result.stderr);
+    if (!result.term.success()) {
+        std.debug.print("wide C RV32 reference failed: {s}\n", .{result.stderr});
+        return error.ReferenceFailed;
+    }
+    try t.expectEqualStrings(expected, result.stdout);
+}
diff --git a/zig/src/core/runner_frontend_decimal.zig b/zig/src/core/runner_frontend_decimal.zig
new file mode 100644
index 000000000..9a98cdf3d
--- /dev/null
+++ b/zig/src/core/runner_frontend_decimal.zig
@@ -0,0 +1,183 @@
+const std = @import("std");
+const ast = @import("runner_frontend_integer_ast.zig");
+const integer = @import("runner_frontend_integer.zig");
+const statements = @import("runner_frontend_integer_statements.zig");
+const Invalid = ast.Invalid;
+const Value = struct { root: usize, scale: u8 = 0, negative: bool = false, decimal: bool = false };
+
+pub fn lowerWithCost(a: std.mem.Allocator, code: []const u8, budget: usize) std.mem.Allocator.Error!?integer.Lowered {
+    var arena = std.heap.ArenaAllocator.init(a);
+    defer arena.deinit();
+    var p = Parser{ .a = arena.allocator(), .nodes = .{ .source = "" } };
+    return p.script(a, code, budget) catch |err| switch (err) {
+        error.Unsupported => null,
+        error.OutOfMemory => error.OutOfMemory,
+    };
+}
+
+const Parser = struct {
+    a: std.mem.Allocator,
+    nodes: ast.Parser,
+    source: []const u8 = "",
+    pos: usize = 0,
+    imported: bool = false,
+    names: [32][]const u8 = undefined,
+    values: [32]Value = undefined,
+    count: usize = 0,
+
+    fn script(p: *Parser, a: std.mem.Allocator, code: []const u8, budget: usize) !?integer.Lowered {
+        if (code.len == 0 or code.len > 4096 or std.mem.indexOfScalar(u8, code, '\r') != null) return error.Unsupported;
+        var lines = statements.Iterator{ .code = code };
+        var roots: [8]usize = undefined;
+        var styles: [8]u8 = undefined;
+        var scales: [8]u8 = undefined;
+        var count: usize = 0;
+        while (try lines.next()) |line| {
+            var text = std.mem.trimEnd(u8, line.text, " \t");
+            if (line.after_semicolon) text = std.mem.trimStart(u8, text, " \t");
+            if (text.len == 0) continue;
+            if (text[0] == ' ' or text[0] == '\t') return error.Unsupported;
+            if (std.mem.eql(u8, text, "from decimal import Decimal")) {
+                if (p.imported or p.count != 0 or count != 0) return error.Unsupported;
+                p.imported = true;
+            } else if (statements.separator(text, '=')) |i| {
+                const name = std.mem.trim(u8, text[0..i], " \t");
+                if (!@import("runner_frontend_python_ast.zig").validName(name) or std.mem.eql(u8, name, "Decimal"))
+                    return error.Unsupported;
+                const value = try p.parse(text[i + 1 ..]);
+                var existing: ?usize = null;
+                for (p.names[0..p.count], 0..) |old, j| if (std.mem.eql(u8, old, name)) {
+                    existing = j;
+                    break;
+                };
+                if (existing) |j| p.values[j] = value else {
+                    if (p.count == p.names.len) return error.Unsupported;
+                    p.names[p.count] = name;
+                    p.values[p.count] = value;
+                    p.count += 1;
+                }
+            } else {
+                if (!std.mem.startsWith(u8, text, "print(") or text[text.len - 1] != ')' or count == roots.len)
+                    return error.Unsupported;
+                const value = try p.parse(text[6 .. text.len - 1]);
+                if (!value.decimal) return error.Unsupported;
+                if (p.nodes.nodes[value.root].value == 0 and value.negative) return error.Unsupported;
+                roots[count] = value.root;
+                styles[count] = 2;
+                scales[count] = value.scale;
+                count += 1;
+            }
+        }
+        if (!p.imported or count == 0) return error.Unsupported;
+        var steps: ?usize = null;
+        if (budget != 0) {
+            const extra = count * 256;
+            if (extra >= budget) return error.Unsupported;
+            steps = (@import("runner_frontend_integer_cost.zig").estimateMany(&p.nodes, roots[0..count], budget - extra) orelse return error.Unsupported) + extra;
+        }
+        const endings: [8]u8 = @splat('\n');
+        const source = try integer.lowerFormatted(a, &p.nodes, roots[0..count], endings[0..count], styles[0..count], scales[0..count]);
+        return .{ .source = source, .estimated_steps = steps, .table = integer.table(&p.nodes, roots[0..count], endings[0..count], styles[0..count], scales[0..count]) };
+    }
+
+    fn parse(p: *Parser, text: []const u8) !Value {
+        p.source = std.mem.trim(u8, text, " \t");
+        p.pos = 0;
+        const value = try p.product(0);
+        p.space();
+        if (p.pos != p.source.len) return error.Unsupported;
+        return value;
+    }
+
+    fn space(p: *Parser) void {
+        while (p.pos < p.source.len and p.source[p.pos] == ' ') : (p.pos += 1) {}
+    }
+    fn eat(p: *Parser, token: []const u8) bool {
+        p.space();
+        if (!std.mem.startsWith(u8, p.source[p.pos..], token)) return false;
+        p.pos += token.len;
+        return true;
+    }
+    fn need(p: *Parser, token: []const u8) !void {
+        if (!p.eat(token)) return error.Unsupported;
+    }
+    fn node(p: *Parser, text: []const u8) !usize {
+        p.nodes.source = text;
+        p.nodes.pos = 0;
+        return p.nodes.parse();
+    }
+    fn product(p: *Parser, depth: usize) (Invalid || std.mem.Allocator.Error)!Value {
+        if (depth > 8) return error.Unsupported;
+        var left = try p.atom(depth + 1);
+        while (p.eat("*")) {
+            const right = try p.atom(depth + 1);
+            if (left.scale + right.scale > 6) return error.Unsupported;
+            try p.nodes.bind("_decimal_l", left.root);
+            try p.nodes.bind("_decimal_r", right.root);
+            const root = try p.node("_decimal_l*_decimal_r");
+            var magnitude = p.nodes.nodes[root].value;
+            if (magnitude < 0) magnitude = -magnitude;
+            if (magnitude >= std.math.pow(i512, 10, 28)) return error.Unsupported;
+            const typed_decimal = left.decimal or right.decimal;
+            left = .{ .root = root, .scale = left.scale + right.scale, .negative = (left.negative != right.negative) and (typed_decimal or magnitude != 0), .decimal = typed_decimal };
+        }
+        return left;
+    }
+    fn atom(p: *Parser, depth: usize) (Invalid || std.mem.Allocator.Error)!Value {
+        if (depth > 8) return error.Unsupported;
+        if (p.eat("(")) {
+            const value = try p.product(depth + 1);
+            try p.need(")");
+            return value;
+        }
+        if (p.eat("Decimal(")) {
+            if (!p.imported) return error.Unsupported;
+            p.space();
+            if (p.pos == p.source.len or (p.source[p.pos] != '\'' and p.source[p.pos] != '"')) return error.Unsupported;
+            const quote = p.source[p.pos];
+            p.pos += 1;
+            const start = p.pos;
+            while (p.pos < p.source.len and p.source[p.pos] != quote) : (p.pos += 1) {}
+            if (p.pos == p.source.len) return error.Unsupported;
+            const text = p.source[start..p.pos];
+            p.pos += 1;
+            try p.need(")");
+            return p.literal(text, true);
+        }
+        p.space();
+        const start = p.pos;
+        if (p.pos < p.source.len and (p.source[p.pos] == '-' or p.source[p.pos] == '+')) p.pos += 1;
+        while (p.pos < p.source.len and std.ascii.isDigit(p.source[p.pos])) : (p.pos += 1) {}
+        if (p.pos > start and std.ascii.isDigit(p.source[p.pos - 1])) return p.literal(p.source[start..p.pos], false);
+        p.pos = start;
+        while (p.pos < p.source.len and (std.ascii.isAlphanumeric(p.source[p.pos]) or p.source[p.pos] == '_')) : (p.pos += 1) {}
+        const name = p.source[start..p.pos];
+        for (p.names[0..p.count], p.values[0..p.count]) |old, value| if (std.mem.eql(u8, old, name)) return value;
+        return error.Unsupported;
+    }
+    fn literal(p: *Parser, text: []const u8, decimal: bool) !Value {
+        if (text.len == 0 or text.len > 64) return error.Unsupported;
+        var digits: [64]u8 = undefined;
+        var len: usize = 0;
+        var scale: u8 = 0;
+        var point = false;
+        const sign = text[0] == '-' or text[0] == '+';
+        for (text[@intFromBool(sign)..]) |c| {
+            if (c == '.' and decimal and !point) {
+                point = true;
+                continue;
+            }
+            if (!std.ascii.isDigit(c)) return error.Unsupported;
+            digits[len] = c;
+            len += 1;
+            if (point) scale += 1;
+        }
+        if (len == 0 or scale > 6) return error.Unsupported;
+        var first: usize = 0;
+        while (first + 1 < len and digits[first] == '0') : (first += 1) {}
+        if (len - first > 28 or (!decimal and len > 1 and digits[0] == '0')) return error.Unsupported;
+        const negative = text[0] == '-' and (decimal or digits[first] != '0' or len - first > 1);
+        const coefficient = try std.fmt.allocPrint(p.a, "{s}{s}", .{ if (negative) @as([]const u8, "-") else "", digits[first..len] });
+        return .{ .root = try p.node(coefficient), .scale = scale, .negative = negative, .decimal = decimal };
+    }
+};
