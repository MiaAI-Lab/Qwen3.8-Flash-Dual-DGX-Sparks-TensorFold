+                "volatile char __tfimr_s_{d}[] __attribute__((section(\".data\"))) = {s};\n" ++
+                    "char * volatile __tfimr_p_{d} = (char *)__tfimr_s_{d};\n",
+                .{ n, token, n, n },
+            ));
+            replacement = try p.fmt("(__tfimr_p_{d})", .{n});
+        } else {
