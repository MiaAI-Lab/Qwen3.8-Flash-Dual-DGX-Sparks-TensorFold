--- /dev/null
+++ b/zig/src/core/runner_frontend_elf_cache_test.zig
@@ -0,0 +1,72 @@
+//! The compiled-image cache through compile() and the frontend: opaque Python cells repeat from it, nothing else does.
+const std = @import("std");
+const compiler = @import("runner_frontend_program_compile.zig");
+const elf_cache = @import("runner_frontend_elf_cache.zig");
+const f = @import("runner_frontend.zig");
+const t = std.testing;
+
+test {
+    _ = @import("runner_frontend_spawn.zig");
+    _ = @import("runner_frontend_compile_time_test.zig");
+    _ = @import("runner_frontend_split_test.zig");
+    _ = @import("runner_frontend_rvlink.zig");
+    _ = elf_cache;
+}
+
+const body = "int main(void) {\n return 0;\n}\n";
+
+test "compile answers a cached opaque-input source with no compiler run; other settings and trusted C miss" {
+    elf_cache.reset(t.io);
+    defer elf_cache.reset(t.io);
+    const config: compiler.Config = .{ .clang = "/nonexistent-elf-cache-clang", .opaque_inputs = true, .estimated_steps = 40 };
+    elf_cache.put(t.io, (try compiler.cacheKey(t.allocator, body, config)).?, "cached image");
+    const hit = (try compiler.compile(t.allocator, t.io, body, config)).?;
+    defer t.allocator.free(hit);
+    try t.expectEqualStrings("cached image", hit);
+    try t.expectEqual(@as(u64, 1), elf_cache.hitCount(t.io));
+    // each of these reaches the missing compiler and abstains: none may take the cached image
+    var plain = config;
+    plain.opaque_inputs = false;
+    var over = config;
+    over.estimated_steps = config.step_budget + 1;
+    var unknown = config;
+    unknown.estimated_steps = null;
+    var o2 = config;
+    o2.optimize = .O2;
+    var stack = config;
+    stack.stack_limit = 4096;
+    var other_clang = config;
+    other_clang.clang = "/nonexistent-elf-cache-clang-2";
+    for ([_]compiler.Config{ plain, over, unknown, o2, stack, other_clang }) |c| {
+        try t.expectEqual(@as(?[]u8, null), try compiler.compile(t.allocator, t.io, body, c));
+    }
+    try t.expectEqual(@as(?[]u8, null), try compiler.compile(t.allocator, t.io, "int main(void) {\n return 1;\n}\n", config));
+    try t.expectEqual(@as(u64, 1), elf_cache.hitCount(t.io));
+}
+
+test "configured RV32: a repeated Python cell is compiled once and returns the same image; a C cell compiles each time" {
+    var env = try t.environ.createMap(t.allocator);
+    defer env.deinit();
+    const clang = env.get("TF_RUNNER_CLANG") orelse return error.SkipZigTest;
+    elf_cache.reset(t.io);
+    defer elf_cache.reset(t.io);
+    var context: f.Context = .{ .io = t.io, .compiler = .{ .clang = clang, .linker = env.get("TF_RUNNER_LLD") } };
+    const front = context.frontend();
+    const code = "def f(n):\n    s = 0\n    for i in range(n):\n        s += i * i\n    return s\nprint(f(12))\n";
+    var images: [2][]const u8 = undefined;
+    for (&images, 0..) |*image, i| {
+        const r = try front.translate(front.ctx, t.allocator, .{ .form = .fence, .lang = "python", .code = code });
+        try t.expect(r == .program);
+        try t.expectEqual(.elf, r.program.kind);
+        image.* = r.program.bytes;
+        try t.expectEqual(@as(u64, i), elf_cache.hitCount(t.io));
+    }
+    defer for (images) |image| t.allocator.free(image);
+    try t.expectEqualSlices(u8, images[0], images[1]);
+    for (0..2) |_| {
+        const r = try front.translate(front.ctx, t.allocator, .{ .form = .fence, .lang = "c", .code = "int main(void) { return 0; }\n" });
+        try t.expect(r == .program);
+        t.allocator.free(r.program.bytes);
+    }
+    try t.expectEqual(@as(u64, 1), elf_cache.hitCount(t.io));
+}
diff --git a/zig/src/core/runner_frontend_forkserver.zig b/zig/src/core/runner_frontend_forkserver.zig
new file mode 100644
index 000000000..5432bdc43
--- /dev/null
+++ b/zig/src/core/runner_frontend_forkserver.zig
@@ -0,0 +1,270 @@
+//! Clang kept started: a preloaded shim forks a child per request running clang's main; failures spawn as before.
+const std = @import("std");
+const builtin = @import("builtin");
+const spawn = @import("runner_frontend_spawn.zig");
+const linux = std.os.linux;
+const Allocator = std.mem.Allocator;
+const log = std.log.scoped(.runner_frontend);
+
+const supported = builtin.link_libc and builtin.os.tag == .linux;
+
+/// The shim, built at warm-up by the configured clang for the host: no headers, libc resolved in the tool.
+pub const shim_source = @embedFile("runner_frontend_forkserver_shim.c");
+
+/// Upper bound on any file a served child writes (outputs and captured streams).
+const file_limit = 8 << 20;
+
+const Server = struct {
+    tool: [256]u8 = undefined,
+    tool_len: usize = 0,
+    pid: linux.pid_t = 0,
+    fd: linux.fd_t = -1,
+    busy: std.Io.Mutex = .init,
+    alive: bool = false,
+};
+
+var table_lock: std.Io.Mutex = .init;
+var servers: [2]Server = @splat(.{});
+
+/// Starts a server for `tool` when none runs; true when one is ready. `dir` is an empty scratch directory.
+pub fn start(a: Allocator, io: std.Io, tool: []const u8, linker: ?[]const u8, dir: []const u8) Allocator.Error!bool {
+    if (comptime !supported) return false;
+    if (tool.len == 0 or tool.len > 255) return false;
+    table_lock.lockUncancelable(io);
+    defer table_lock.unlock(io);
+    for (&servers) |*s| if (s.alive and std.mem.eql(u8, s.tool[0..s.tool_len], tool)) return true;
+    const slot = for (&servers) |*s| {
+        if (!s.alive) break s;
+    } else return false;
+    const src = try std.fs.path.join(a, &.{ dir, "fs.c" });
+    defer a.free(src);
+    const so = try std.fs.path.join(a, &.{ dir, "fs.so" });
+    defer a.free(so);
+    const file = std.Io.Dir.cwd().createFile(io, src, .{ .permissions = .fromMode(0o600) }) catch return false;
+    file.writeStreamingAll(io, shim_source) catch {
+        file.close(io);
+        return false;
+    };
+    file.close(io);
+    const ld = if (linker) |l| try std.fmt.allocPrint(a, "--ld-path={s}", .{l}) else try a.dupe(u8, "-fuse-ld=lld");
+    defer a.free(ld);
+    // -nostdlib: an aarch64 compare-and-swap must be inline, not compiler-rt's outline-atomics call
+    const atomics = if (builtin.cpu.arch == .aarch64) "-mno-outline-atomics" else "-O2";
+    const built = try spawn.run(a, io, &.{ tool, "-shared", "-fPIC", "-nostdinc", "-nostdlib", "-O2", atomics, ld, "-o", so, src }, .{ .stdout = 4096, .stderr = 16384, .timeout = .fromMilliseconds(10_000) }) orelse return false;
+    defer built.deinit(a);
+    if (!built.ok) {
+        log.warn("fork server shim did not build with {s}; clang starts per call", .{tool});
+        return false;
+    }
+    var pair: [2]linux.fd_t = undefined;
+    if (linux.errno(linux.socketpair(linux.AF.UNIX, linux.SOCK.STREAM | linux.SOCK.CLOEXEC, 0, &pair)) != .SUCCESS) return false;
+    const pid = launch(a, tool, so, pair[1]) catch |e| {
+        _ = linux.close(pair[0]);
+        _ = linux.close(pair[1]);
+        return e;
+    };
+    _ = linux.close(pair[1]);
+    if (pid == 0) {
+        _ = linux.close(pair[0]);
+        return false;
+    }
+    var hello: [4]u8 = undefined;
+    if (!exact(pair[0], &hello, 5000) or std.mem.readInt(u32, &hello, .little) != 0x52454459) {
+        _ = linux.close(pair[0]);
+        _ = linux.kill(pid, .KILL);
+        reap(pid);
+        return false;
+    }
+    slot.pid = pid;
+    slot.fd = pair[0];
+    slot.tool_len = tool.len;
+    @memcpy(slot.tool[0..tool.len], tool);
+    @atomicStore(bool, &slot.alive, true, .release);
+    return true;
+}
+
+/// argv by argv[0]'s ready, free server (in absolute `dir`, streams in dir/.stdout, .stderr), else posix_spawn.
+pub fn run(a: Allocator, io: std.Io, dir: []const u8, argv: []const []const u8, limits: spawn.Limits) Allocator.Error!?spawn.Ran {
+    if (comptime supported) {
+        if (find(io, argv[0])) |s| {
+            defer s.busy.unlock(io);
+            return served(a, io, s, dir, argv, limits);
+        }
+    }
+    return spawn.run(a, io, argv, limits);
+}
+
+/// The ready server's process for `tool` (tests: what it holds open).
+pub fn serverPid(tool: []const u8) ?linux.pid_t {
+    for (&servers) |*s| if (@atomicLoad(bool, &s.alive, .acquire) and std.mem.eql(u8, s.tool[0..s.tool_len], tool)) return s.pid;
+    return null;
+}
+
+/// Whether a server for `tool` is ready (tests and reports).
+pub fn ready(tool: []const u8) bool {
+    for (&servers) |*s| if (@atomicLoad(bool, &s.alive, .acquire) and std.mem.eql(u8, s.tool[0..s.tool_len], tool)) return true;
+    return false;
+}
+
+fn find(io: std.Io, tool: []const u8) ?*Server {
+    for (&servers) |*s| {
+        if (!@atomicLoad(bool, &s.alive, .acquire) or !std.mem.eql(u8, s.tool[0..s.tool_len], tool)) continue;
+        if (!s.busy.tryLock()) return null;
+        if (s.alive) return s;
+        s.busy.unlock(io);
+        return null;
+    }
+    return null;
+}
+
+fn served(a: Allocator, io: std.Io, s: *Server, dir: []const u8, argv: []const []const u8, limits: spawn.Limits) Allocator.Error!?spawn.Ran {
+    var request: std.ArrayList(u8) = .empty;
+    defer request.deinit(a);
+    try request.appendNTimes(a, 0, 8);
+    std.mem.writeInt(u32, request.items[4..8], file_limit, .little);
+    for ([_][]const []const u8{ &.{dir}, argv }) |list| for (list) |arg| {
+        if (std.mem.indexOfScalar(u8, arg, 0) != null) return null;
+        try request.appendSlice(a, arg);
+        try request.append(a, 0);
+    };
+    if (request.items.len - 4 > 65535) return spawn.run(a, io, argv, limits);
+    std.mem.writeInt(u32, request.items[0..4], @intCast(request.items.len - 4), .little);
+    const end = now() + @as(u64, @intCast(@max(limits.timeout.toNanoseconds(), 0)));
+    if (left(end) <= 0) return null;
+    var reply: [4]u8 = undefined;
+    // no server or a child gone before clang ran nothing: the argv spawns; 50 ms floor keeps healthy servers
+    const took = send(s.fd, request.items) and exact(s.fd, &reply, std.math.clamp(left(end), 50, 2000));
+    const child: linux.pid_t = if (took) @bitCast(std.mem.readInt(u32, &reply, .little)) else 0;
+    if (child <= 0) {
+        if (!took or child < 0) dead(s);
+        if (left(end) <= 0) return null;
+        var rest = limits;
+        rest.timeout = .fromMilliseconds(left(end));
+        return spawn.run(a, io, argv, rest);
+    }
+    // a status there at the deadline is the child's (it ran): no kill, as its pid may name another process now
+    if (!exact(s.fd, &reply, left(end)) and !exact(s.fd, &reply, 0)) {
+        _ = linux.kill(child, .KILL);
+        if (!exact(s.fd, &reply, 2000)) dead(s);
+        return null;
+    }
+    const status = std.mem.readInt(u32, &reply, .little);
+    const stdout = try slurp(a, io, dir, ".stdout", limits.stdout) orelse return null;
+    errdefer a.free(stdout);
+    const stderr = try slurp(a, io, dir, ".stderr", limits.stderr) orelse {
+        a.free(stdout);
+        return null;
+    };
+    return .{ .stdout = stdout, .stderr = stderr, .ok = status == 0 };
+}
+
+/// A server that stopped answering is closed (it exits on end of stream); this call and later ones spawn.
+fn dead(s: *Server) void {
+    @atomicStore(bool, &s.alive, false, .release);
+    _ = linux.close(s.fd);
+    _ = linux.kill(s.pid, .KILL);
+    reap(s.pid);
+    log.warn("fork server for {s} stopped; clang starts per call", .{s.tool[0..s.tool_len]});
+}
+
+fn slurp(a: Allocator, io: std.Io, dir: []const u8, name: []const u8, limit: usize) Allocator.Error!?[]u8 {
+    const path = try std.fs.path.join(a, &.{ dir, name });
+    defer a.free(path);
+    return std.Io.Dir.cwd().readFileAlloc(io, path, a, .limited(limit + 1)) catch |e| switch (e) {
+        error.OutOfMemory => error.OutOfMemory,
+        else => null,
+    };
+}
+
+/// Milliseconds before `end`, 0 once past.
+fn left(end: u64) i64 {
+    const t = now();
+    return if (t >= end) 0 else @intCast((end - t) / std.time.ns_per_ms);
+}
+
+fn send(fd: linux.fd_t, bytes: []const u8) bool {
+    var at: usize = 0;
+    while (at < bytes.len) {
+        // MSG_NOSIGNAL: a server gone fails the write instead of raising SIGPIPE in a host that keeps it
+        const n = linux.sendto(fd, bytes[at..].ptr, bytes.len - at, linux.MSG.NOSIGNAL, null, 0);
+        if (linux.errno(n) == .INTR) continue;
+        if (linux.errno(n) != .SUCCESS or n == 0) return false;
+        at += n;
+    }
+    return true;
+}
+
+/// Reads exactly buf.len bytes within `ms` milliseconds (0: only what is already there).
+fn exact(fd: linux.fd_t, buf: []u8, ms: i64) bool {
+    const end = now() + @as(u64, @intCast(ms)) * std.time.ns_per_ms;
+    var at: usize = 0;
+    while (at < buf.len) {
+        const t = now();
+        const wait: u64 = if (t >= end) 0 else (end - t) / std.time.ns_per_ms + 1;
+        var pf = [_]linux.pollfd{.{ .fd = fd, .events = linux.POLL.IN, .revents = 0 }};
+        const rc = linux.poll(&pf, 1, @intCast(@min(wait, std.math.maxInt(i32))));
+        if (linux.errno(rc) == .INTR) continue;
+        if (linux.errno(rc) != .SUCCESS) return false;
+        if (rc == 0) {
+            if (t >= end) return false;
+            continue;
+        }
+        const n = linux.read(fd, buf[at..].ptr, buf.len - at);
+        if (linux.errno(n) == .INTR) continue;
+        if (linux.errno(n) != .SUCCESS or n == 0) return false;
+        at += n;
+    }
+    return true;
+}
+
+const libc = struct {
+    extern "c" fn posix_spawn(pid: *linux.pid_t, path: [*:0]const u8, actions: *const Opaque, attr: ?*const anyopaque, argv: [*:null]const ?[*:0]const u8, envp: [*:null]const ?[*:0]const u8) c_int;
+    extern "c" fn posix_spawn_file_actions_init(actions: *Opaque) c_int;
+    extern "c" fn posix_spawn_file_actions_destroy(actions: *Opaque) c_int;
+    extern "c" fn posix_spawn_file_actions_adddup2(actions: *Opaque, fd: c_int, to: c_int) c_int;
+    extern "c" fn posix_spawn_file_actions_addopen(actions: *Opaque, fd: c_int, path: [*:0]const u8, flags: c_int, mode: c_uint) c_int;
+    extern "c" var environ: [*:null]?[*:0]u8;
+};
+
+const Opaque = extern struct { bytes: [512]u8 align(16) = undefined };
+
+/// The tool with the shim preloaded and the control socket on fd 3; 0 if it could not start.
+fn launch(a: Allocator, tool: []const u8, so: []const u8, control: linux.fd_t) Allocator.Error!linux.pid_t {
+    var arena_state = std.heap.ArenaAllocator.init(a);
+    defer arena_state.deinit();
+    const arena = arena_state.allocator();
+    var env: std.ArrayList(?[*:0]const u8) = .empty;
+    var i: usize = 0;
+    while (libc.environ[i]) |e| : (i += 1) {
+        const text = std.mem.span(e);
+        if (std.mem.startsWith(u8, text, "LD_PRELOAD=") or std.mem.startsWith(u8, text, "TF_FORKSERVER_FD=")) continue;
+        try env.append(arena, e);
+    }
+    try env.append(arena, try std.fmt.allocPrintSentinel(arena, "LD_PRELOAD={s}", .{so}, 0));
+    try env.append(arena, "TF_FORKSERVER_FD=3");
+    try env.append(arena, null);
+    const path = try arena.dupeSentinel(u8, tool, 0);
+    const argv = [_:null]?[*:0]const u8{path};
+    var actions: Opaque = .{};
+    if (libc.posix_spawn_file_actions_init(&actions) != 0) return 0;
+    defer _ = libc.posix_spawn_file_actions_destroy(&actions);
+    var rc = libc.posix_spawn_file_actions_addopen(&actions, 0, "/dev/null", 0, 0);
+    if (rc == 0) rc = libc.posix_spawn_file_actions_addopen(&actions, 1, "/dev/null", 1, 0);
+    if (rc == 0) rc = libc.posix_spawn_file_actions_addopen(&actions, 2, "/dev/null", 1, 0);
+    // fds above 3 close in the shim's serve(): posix_spawn_file_actions_addclosefrom_np needs glibc 2.34
+    if (rc == 0) rc = libc.posix_spawn_file_actions_adddup2(&actions, control, 3);
+    var pid: linux.pid_t = 0;
+    if (rc == 0) rc = libc.posix_spawn(&pid, path, &actions, null, &argv, @ptrCast(env.items.ptr));
+    return if (rc == 0) pid else 0;
+}
+
+fn reap(pid: linux.pid_t) void {
+    var st: i32 = 0;
+    while (linux.errno(linux.wait4(pid, &st, 0, null)) == .INTR) {}
+}
+
+fn now() u64 {
+    var ts: std.c.timespec = undefined;
+    _ = std.c.clock_gettime(.MONOTONIC, &ts);
+    return @as(u64, @intCast(ts.sec)) * std.time.ns_per_s + @as(u64, @intCast(ts.nsec));
+}
diff --git a/zig/src/core/runner_frontend_forkserver_shim.c b/zig/src/core/runner_frontend_forkserver_shim.c
new file mode 100644
index 000000000..a021f535d
--- /dev/null
+++ b/zig/src/core/runner_frontend_forkserver_shim.c
@@ -0,0 +1,113 @@
+typedef unsigned long size_t;
+typedef long ssize_t;
+typedef int pid_t;
+struct rlimit { unsigned long cur, max; };
+extern char **environ;
+extern int fork(void);
+extern pid_t waitpid(pid_t, int *, int);
+extern pid_t getpid(void);
+extern ssize_t read(int, void *, size_t);
+extern ssize_t write(int, const void *, size_t);
+extern int chdir(const char *);
+extern int open(const char *, int, ...);
+extern int dup2(int, int);
+extern int close(int);
+extern void _exit(int) __attribute__((noreturn));
+extern void exit(int) __attribute__((noreturn));
+extern int on_exit(void (*)(int, void *), void *);
+extern int fflush(void *);
+extern char *getenv(const char *);
+extern int unsetenv(const char *);
+extern int setrlimit(int, const struct rlimit *);
+extern void *mmap(void *, size_t, int, int, int, long);
+extern void *dlsym(void *, const char *);
+extern int *__errno_location(void);
+extern long syscall(long, ...);
+typedef int (*main_fn)(int, char **, char **);
+typedef int (*start_fn)(main_fn, int, char **, void (*)(void), void (*)(void), void (*)(void), void *);
+static main_fn tool_main;
+static int control = -1;
+static volatile int *flags;
+static char request[65536];
+static char *args[1024];
+static int full(int fd, void *buffer, size_t count, int writing) {
+    char *p = buffer;
+    while (count) {
+        ssize_t n = writing ? write(fd, p, count) : read(fd, p, count);
+        if (n < 0 && *__errno_location() == 4) continue;
+        if (n <= 0) return 0;
+        p += n;
+        count -= (size_t)n;
+    }
+    return 1;
+}
+static void report(int rc, void *unused) {
+    (void)unused;
+    int status = (rc & 0xff) << 8;
+    fflush(0);
+    close(1);
+    close(2);
+    if (__sync_bool_compare_and_swap(&flags[2], 0, 1)) full(control, &status, 4, 1);
+}
+static void child(void) {
+    unsigned int size;
+    if (!full(control, &size, 4, 0) || size < 6 || size > sizeof request - 1) _exit(0);
+    flags[0] = 1;
+    if (!full(control, request, size, 0)) _exit(0);
+    request[size] = 0;
+    unsigned int limit = *(unsigned int *)request;
+    char *dir = request + 4, *p = dir;
+    while (*p) ++p;
+    ++p;
+    int n = 0;
+    while (p < request + size && n < 1023) {
+        args[n++] = p;
+        while (*p) ++p;
+        ++p;
+    }
+    args[n] = 0;
+    int pid = getpid();
+    if (!full(control, &pid, 4, 1)) _exit(0);
+    flags[1] = 1;
+    unsetenv("TF_FORKSERVER_FD");
+    unsetenv("LD_PRELOAD");
+    if (n == 0 || chdir(dir) != 0) _exit(127);
+    int in = open("/dev/null", 0), out = open(".stdout", 01101, 0600), err = open(".stderr", 01101, 0600);
+    if (in < 0 || out < 0 || err < 0 || dup2(in, 0) < 0 || dup2(out, 1) < 0 || dup2(err, 2) < 0) _exit(127);
+    struct rlimit fsize = { limit, limit };
+    setrlimit(1, &fsize);
+    on_exit(report, 0);
+    exit(tool_main(n, args, environ));
+}
+static int serve(int argc, char **argv, char **envp) {
+    (void)argc; (void)argv; (void)envp;
+    // the server outlives calls: drop the runner's other pipes and sockets (close_range, else one by one)
+    if (syscall(436, 4u, ~0u, 0u) != 0) for (int fd = 4; fd < 1024; ++fd) close(fd);
+    flags = mmap(0, 4096, 3, 0x21, -1, 0);
+    if (flags == (void *)-1l) _exit(0);
+    unsigned int ready = 0x52454459;
+    if (!full(control, &ready, 4, 1)) _exit(0);
+    for (;;) {
+        flags[0] = flags[1] = flags[2] = 0;
+        int pid = fork();
+        if (pid == 0) child();
+        if (pid < 0) _exit(0);
+        int status = 0;
+        while (waitpid(pid, &status, 0) < 0 && *__errno_location() == 4) {}
+        if (!flags[0]) _exit(0);
+        int zero = 0;
+        if (!flags[1] && !full(control, &zero, 4, 1)) _exit(0);
+        if (__sync_bool_compare_and_swap(&flags[2], 0, 1) && !full(control, &status, 4, 1)) _exit(0);
+    }
+}
+int __libc_start_main(main_fn main, int argc, char **argv, void (*init)(void), void (*fini)(void),
+                      void (*rtld)(void), void *stack) {
+    start_fn next = (start_fn)dlsym((void *)-1l, "__libc_start_main");
+    const char *fd = getenv("TF_FORKSERVER_FD");
+    tool_main = main;
+    if (fd && *fd >= '3' && *fd <= '9' && !fd[1]) {
+        control = *fd - '0';
+        return next(serve, argc, argv, init, fini, rtld, stack);
+    }
+    return next(main, argc, argv, init, fini, rtld, stack);
+}
diff --git a/zig/src/core/runner_frontend_fraction.zig b/zig/src/core/runner_frontend_fraction.zig
new file mode 100644
index 000000000..aa2a50ff6
--- /dev/null
+++ b/zig/src/core/runner_frontend_fraction.zig
@@ -0,0 +1,326 @@
+const std = @import("std");
+const ast = @import("runner_frontend_integer_ast.zig");
+const integer = @import("runner_frontend_integer.zig");
+const statements = @import("runner_frontend_integer_statements.zig");
+const cost = @import("runner_frontend_integer_cost.zig");
+const Allocator = std.mem.Allocator;
+const Invalid = ast.Invalid;
+const Failure = Allocator.Error || Invalid;
+
+const Kind = enum { integer, fraction, integral_float };
+const Value = struct { root: usize, kind: Kind = .integer, denominator: ?usize = null };
+const Binding = struct { name: []const u8, value: Value };
+
+// Proofs admit exact integral quotients; runtime nodes retain the original operands and literal text.
+pub fn lowerWithCost(a: Allocator, code: []const u8, budget: usize) Allocator.Error!?integer.Lowered {
+    return checked(a, code, budget) catch |err| switch (err) {
+        error.Unsupported => null,
+        error.OutOfMemory => error.OutOfMemory,
+    };
+}
+
+fn checked(a: Allocator, code: []const u8, budget: usize) Failure!integer.Lowered {
+    var script = try parse(code);
+    const roots = script.roots[0..script.output_count];
+    var steps: ?usize = null;
+    if (budget != 0) {
+        var extra: usize = 0;
+        for (script.styles[0..script.output_count]) |style| {
+            if (style == 1) extra += 128;
+        }
+        if (extra >= budget) return error.Unsupported;
+        steps = (cost.estimateMany(&script.parser, roots, budget - extra) orelse return error.Unsupported) + extra;
+    }
+    return .{
+        .source = try integer.lowerFormatted(
+            a,
+            &script.parser,
+            roots,
+            script.endings[0..script.output_count],
+            script.styles[0..script.output_count],
+            script.scales[0..script.output_count],
+        ),
+        .estimated_steps = steps,
+        .table = integer.table(&script.parser, roots, script.endings[0..script.output_count], script.styles[0..script.output_count], script.scales[0..script.output_count]),
+    };
+}
+
+const Script = struct {
+    parser: ast.Parser = .{ .source = "", .require_math_import = true },
+    bindings: [32]Binding = undefined,
+    binding_count: usize = 0,
+    fraction_import: bool = false,
+    special: bool = false,
+    roots: [8]usize = undefined,
+    endings: [8]u8 = undefined,
+    styles: [8]u8 = undefined,
+    scales: [8]u8 = @splat(0),
+    output_count: usize = 0,
+
+    fn lookup(self: *const Script, name: []const u8) ?Value {
+        for (self.bindings[0..self.binding_count]) |binding| {
+            if (std.mem.eql(u8, name, binding.name)) return binding.value;
+        }
+        return null;
+    }
+
+    fn assign(self: *Script, name: []const u8, rhs: []const u8) Invalid!void {
+        if (statements.separator(name, ',')) |comma| {
+            const first = trim(name[0..comma]);
+            const second = trim(name[comma + 1 ..]);
+            if (!validBinding(first) or !validBinding(second) or std.mem.eql(u8, first, second))
+                return error.Unsupported;
+            const pair = try self.parser.divisionPair(try self.integerExpr(rhs, 0));
+            try self.bind(first, .{ .root = pair[0] });
+            try self.bind(second, .{ .root = pair[1] });
+            return;
+        }
+        const value = try self.expression(rhs, 0);
+        if (self.parser.nodes[value.root].op == .divmod) return error.Unsupported;
+        if (value.kind != .integer and self.lookup(unwrap(trim(rhs))) != null) return error.Unsupported;
+        try self.bind(name, value);
+    }
+
+    fn bind(self: *Script, name: []const u8, value: Value) Invalid!void {
+        if (!validBinding(name) or self.lookup(name) != null or self.binding_count == self.bindings.len)
+            return error.Unsupported;
+        self.bindings[self.binding_count] = .{ .name = name, .value = value };
+        self.binding_count += 1;
+        if (value.kind == .integer) try self.parser.bind(name, value.root);
+    }
+
+    fn print(self: *Script, text: []const u8) Invalid!void {
+        var rest = text;
+        while (true) {
+            const comma = statements.separator(rest, ',');
+            if (self.output_count == self.roots.len) return error.Unsupported;
+            const value = try self.expression(rest[0 .. comma orelse rest.len], 0);
+            const i = self.output_count;
+            self.roots[i] = value.root;
+            self.endings[i] = if (comma != null) ' ' else '\n';
+            self.styles[i] = if (value.kind == .integral_float) 1 else 0;
+            self.output_count += 1;
+            if (comma) |j| rest = rest[j + 1 ..] else break;
+        }
+    }
+
+    fn expression(self: *Script, raw: []const u8, depth: usize) Invalid!Value {
+        if (depth > 12) return error.Unsupported;
+        const text = unwrap(trim(raw));
+        if (text.len == 0) return error.Unsupported;
+        if (self.lookup(text)) |value| return value;
+        if (call(text, "Fraction")) |args| {
+            if (!self.fraction_import) return error.Unsupported;
+            const comma = statements.separator(args, ',') orelse return error.Unsupported;
+            const numerator = try self.integerExpr(args[0..comma], depth + 1);
+            const denominator = try self.integerExpr(args[comma + 1 ..], depth + 1);
+            const root = try self.quotient(numerator, denominator);
+            self.special = true;
+            return .{ .root = root, .kind = .fraction, .denominator = denominator };
+        }
+        if (call(text, "float")) |args| {
+            const value = try self.expression(args, depth + 1);
+            if (value.kind != .fraction) return error.Unsupported;
+            try self.floatRange(value.root);
+            self.special = true;
+            return .{ .root = value.root, .kind = .integral_float };
+        }
+        if (std.mem.lastIndexOfScalar(u8, text, '.')) |dot| {
+            if (self.lookup(trim(text[0..dot]))) |value| {
+                if (value.kind != .fraction) return error.Unsupported;
+                const attribute = trim(text[dot + 1 ..]);
+                if (std.mem.eql(u8, attribute, "numerator")) return .{ .root = value.root };
+                if (!std.mem.eql(u8, attribute, "denominator")) return error.Unsupported;
+                const denominator = value.denominator orelse return error.Unsupported;
+                const root = try self.append(.{ .op = .floor, .l = denominator, .r = denominator, .value = 1 });
+                return .{ .root = root };
+            }
+        }
+        if (singleSlash(text)) |slash| {
+            const left = trim(text[0..slash]);
+            const right = trim(text[slash + 1 ..]);
+            if (!divisionOperand(left) or !divisionOperand(right)) return error.Unsupported;
+            const n = try self.integerExpr(left, depth + 1);
+            const d = try self.integerExpr(right, depth + 1);
+            const root = try self.quotient(n, d);
+            try self.floatRange(root);
+            self.special = true;
+            return .{ .root = root, .kind = .integral_float };
+        }
+        return .{ .root = try self.integerExpr(text, depth + 1) };
+    }
+
+    fn integerExpr(self: *Script, raw: []const u8, depth: usize) Invalid!usize {
+        if (depth > 12) return error.Unsupported;
+        const text = unwrap(trim(raw));
+        if (call(text, "abs")) |arg| {
+            const root = try self.integerExpr(arg, depth + 1);
+            if (boolean(self.parser.nodes[root].op) or self.parser.nodes[root].op == .divmod)
+                return error.Unsupported;
+            const value = self.parser.nodes[root].value;
+            return self.append(.{ .op = .gcd, .l = root, .r = root, .value = if (value < 0) -value else value });
+        }
+        const qualified = call(text, "math.gcd");
+        const unqualified = call(text, "gcd");
+        if (qualified != null or unqualified != null) {
+            if (if (qualified != null) !self.parser.math_module else self.parser.math_imports & 1 == 0)
+                return error.Unsupported;
+            const args = qualified orelse unqualified.?;
+            const comma = statements.separator(args, ',') orelse return error.Unsupported;
+            const l = try self.integerExpr(args[0..comma], depth + 1);
+            const r = try self.integerExpr(args[comma + 1 ..], depth + 1);
+            if (self.parser.nodes[l].op == .divmod or self.parser.nodes[r].op == .divmod) return error.Unsupported;
+            var x = self.parser.nodes[l].value;
+            var y = self.parser.nodes[r].value;
+            if (x < 0) x = -x;
+            if (y < 0) y = -y;
+            while (y != 0) {
+                const remainder = @mod(x, y);
+                x = y;
+                y = remainder;
+            }
+            return self.append(.{ .op = .gcd, .l = l, .r = r, .value = x });
+        }
+        self.parser.source = text;
+        self.parser.pos = 0;
+        return self.parser.parse();
+    }
+
+    fn quotient(self: *Script, numerator: usize, denominator: usize) Invalid!usize {
+        if (boolean(self.parser.nodes[numerator].op) or boolean(self.parser.nodes[denominator].op) or
+            self.parser.nodes[numerator].op == .divmod or self.parser.nodes[denominator].op == .divmod)
+            return error.Unsupported;
+        const n = self.parser.nodes[numerator].value;
+        const d = self.parser.nodes[denominator].value;
+        if (d == 0 or @mod(n, d) != 0) return error.Unsupported;
+        const q = @divFloor(n, d);
+        if (q <= -1_000_000_000_000_000 or q >= 1_000_000_000_000_000) return error.Unsupported;
+        return self.append(.{ .op = .floor, .l = numerator, .r = denominator, .value = q });
+    }
+
+    fn floatRange(self: *const Script, root: usize) Invalid!void {
+        const value = self.parser.nodes[root].value;
+        if (value == 0 or value <= -1_000_000_000_000_000 or value >= 1_000_000_000_000_000)
+            return error.Unsupported;
+    }
+
+    fn append(self: *Script, node: ast.Node) Invalid!usize {
+        if (self.parser.count == self.parser.capacity) return error.Unsupported;
+        const root = self.parser.count;
+        self.parser.nodes[root] = node;
+        self.parser.proved[root] = true;
+        self.parser.count += 1;
+        return root;
+    }
+};
+
+fn parse(code: []const u8) Invalid!Script {
+    if (code.len == 0 or code.len > 4096 or std.mem.indexOfScalar(u8, code, '\r') != null)
+        return error.Unsupported;
+    var script: Script = .{};
+    var lines = statements.Iterator{ .code = code };
+    while (try lines.next()) |raw| {
+        var line = std.mem.trimEnd(u8, raw.text, " \t");
+        if (raw.after_semicolon) line = std.mem.trimStart(u8, line, " \t");
+        if (line.len == 0) continue;
+        if (line[0] == ' ' or line[0] == '\t') return error.Unsupported;
+        if (std.mem.eql(u8, line, "from fractions import Fraction")) {
+            script.fraction_import = true;
+        } else if (std.mem.eql(u8, line, "import math")) {
+            script.parser.math_module = true;
+        } else if (std.mem.startsWith(u8, line, "from math import ")) {
+            var names = std.mem.splitScalar(u8, line[17..], ',');
+            while (names.next()) |part| {
+                const name = trim(part);
+                script.parser.math_imports |= if (std.mem.eql(u8, name, "gcd")) @as(u8, 1) else if (std.mem.eql(u8, name, "isqrt"))
+                    @as(u8, 2)
+                else if (std.mem.eql(u8, name, "factorial"))
+                    @as(u8, 4)
+                else if (std.mem.eql(u8, name, "prod"))
+                    @as(u8, 8)
+                else
+                    return error.Unsupported;
+            }
+        } else if (call(line, "print")) |args| {
+            try script.print(args);
+        } else if (statements.separator(line, '=')) |equal| {
+            try script.assign(trim(line[0..equal]), line[equal + 1 ..]);
+        } else return error.Unsupported;
+    }
+    if (!script.special or script.output_count == 0) return error.Unsupported;
+    return script;
+}
+
+fn trim(text: []const u8) []const u8 {
+    return std.mem.trim(u8, text, " \t");
+}
+
+fn call(text: []const u8, name: []const u8) ?[]const u8 {
+    if (!std.mem.startsWith(u8, text, name)) return null;
+    const rest = trim(text[name.len..]);
+    if (rest.len < 2 or rest[0] != '(' or close(rest) != rest.len - 1) return null;
+    return rest[1 .. rest.len - 1];
+}
+
+fn close(text: []const u8) ?usize {
+    var depth: usize = 0;
+    var quote: u8 = 0;
+    var escaped = false;
+    for (text, 0..) |c, i| {
+        if (quote != 0) {
+            if (escaped) escaped = false else if (c == '\\') escaped = true else if (c == quote) quote = 0;
+        } else if (c == '\'' or c == '"') {
+            quote = c;
+        } else if (c == '(') {
+            depth += 1;
+        } else if (c == ')') {
+            if (depth == 0) return null;
+            depth -= 1;
+            if (depth == 0) return i;
+        }
+    }
+    return null;
+}
+
+fn unwrap(raw: []const u8) []const u8 {
+    var text = raw;
+    while (text.len >= 2 and text[0] == '(' and close(text) == text.len - 1)
+        text = trim(text[1 .. text.len - 1]);
+    return text;
+}
+
+fn singleSlash(text: []const u8) ?usize {
+    const i = statements.separator(text, '/') orelse return null;
+    if ((i > 0 and text[i - 1] == '/') or (i + 1 < text.len and text[i + 1] == '/')) return null;
+    if (statements.separator(text[i + 1 ..], '/') != null) return null;
+    return i;
+}
+
+// Restrict true division to two atoms; accepting a surrounding sum would change Python's float arithmetic.
+fn divisionOperand(raw: []const u8) bool {
+    var text = trim(raw);
+    if (text.len == 0) return false;
+    if (text[0] == '+' or text[0] == '-') text = trim(text[1..]);
+    if (text.len == 0) return false;
+    for ("+-*/%<>=,&|") |token| if (statements.separator(text, token) != null) return false;
+    return true;
+}
+
+fn boolean(op: ast.Op) bool {
+    return switch (op) {
+        .eq, .ne, .lt, .le, .gt, .ge => true,
+        else => false,
+    };
+}
+
+fn validBinding(name: []const u8) bool {
+    if (name.len == 0 or !(std.ascii.isAlphabetic(name[0]) or name[0] == '_')) return false;
+    for (name) |c| if (!(std.ascii.isAlphanumeric(c) or c == '_')) return false;
+    for ([_][]const u8{
+        "Fraction", "float",  "fractions", "print",  "pow",   "divmod",   "int",   "str",   "len",   "sum",       "map",          "range",    "all", "abs",    "math",
+        "gcd",      "isqrt",  "factorial", "prod",   "True",  "False",    "None",  "and",   "or",    "not",       "if",           "else",     "for", "while",  "in",
+        "is",       "def",    "return",    "import", "from",  "as",       "class", "del",   "yield", "lambda",    "global",       "nonlocal", "try", "except", "finally",
+        "with",     "assert", "raise",     "pass",   "break", "continue", "async", "await", "elif",  "__debug__", "__builtins__",
+    }) |reserved| if (std.mem.eql(u8, name, reserved)) return false;
+    return true;
+}
