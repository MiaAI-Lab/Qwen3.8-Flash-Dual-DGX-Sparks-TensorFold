+    const huge = try f.counted("i", "int", 0, try f.number(1_000_000, "int"), &.{});
+    try t.expectEqual(@as(?usize, null), try f.estimate(&.{}, &.{
+        flags,
+        try f.node("IfStmt", "", &.{ condition, light, huge }),
