+    try std.testing.expect(std.mem.indexOf(u8, source, "tf_run(tf_nodes,") != null);
+    try std.testing.expect(std.mem.indexOf(u8, source, "\"100\"") != null);
+}
+
+test "multiple wide prints retain runtime DAGs and charge the total deadline" {
+    const a = std.testing.allocator;
+    const code = "a=11232463670103386525\nb=732667528837627997\nc=242246186388029\n" ++
+        "print(a-b*129+c)\nprint(b*129)\n";
+    try std.testing.expectEqual(@as(?[]u8, null), try python.lowerCalc(a, code));
+    const result = (try python.lowerWithCost(a, code, std.math.maxInt(usize))).?;
+    defer a.free(result.source);
+    try std.testing.expect(std.mem.indexOf(u8, result.source, "\"11232463670103386525\"") != null);
+    try std.testing.expect(std.mem.indexOf(u8, result.source, "\"732667528837627997\"") != null);
+    try std.testing.expect(std.mem.indexOf(u8, result.source, "\"242246186388029\"") != null);
+    try std.testing.expect(std.mem.indexOf(u8, result.source, "\"83281405303764237059\"") == null);
+    try std.testing.expect(std.mem.indexOf(u8, result.source, "tf_roots") != null);
+    try std.testing.expect(std.mem.indexOf(u8, result.source, "tf_nodes_1") == null);
+    const total = result.estimated_steps.?;
+    const exact = (try python.lowerWithCost(a, code, total)).?;
+    defer a.free(exact.source);
+    try std.testing.expectEqual(@as(?usize, total), exact.estimated_steps);
+    try std.testing.expect((try python.lowerWithCost(a, code, total - 1)) == null);
+    const single = (try python.lowerWithCost(a, "b=732667528837627997\nprint(b*129)", total)).?;
+    defer a.free(single.source);
+    try std.testing.expect(single.estimated_steps.? < total);
+}
+
+test "multiple prints snapshot bindings and validate the complete script" {
+    const a = std.testing.allocator;
+    const source = (try python.lower(a, "x=7\nprint(x)\nx=11\nprint(x)")).?;
+    defer a.free(source);
+    try std.testing.expect(std.mem.indexOf(u8, source, "tf_roots") != null);
+    try std.testing.expect(std.mem.indexOf(u8, source, "\"7\"") != null);
+    try std.testing.expect(std.mem.indexOf(u8, source, "\"11\"") != null);
+    for ([_][]const u8{
+        "x=7\nprint(x)\nx=1//0\nprint(3)",
+        "print(1)\nprint(2)\nx=10**62",
+        "print(1)\nimport os\nprint(2)",
+        "print(1)\nprint=3\nprint(2)",
+        "print(1)\nprint(2.5)",
+        "1\nprint(2)",
+        "1\nx=2\nprint(x)",
+        "print(1)\nprint(2)\nprint(3)\nprint(4)\nprint(5)\nprint(6)\nprint(7)\nprint(8)\nprint(9)",
+    }) |code| try std.testing.expectEqual(@as(?[]u8, null), try python.lower(a, code));
+}
diff --git a/zig/src/core/runner_frontend_spawn.zig b/zig/src/core/runner_frontend_spawn.zig
new file mode 100644
index 000000000..d2aa084dd
--- /dev/null
+++ b/zig/src/core/runner_frontend_spawn.zig
@@ -0,0 +1,263 @@
+//! The cross compiler's process by posix_spawn (Linux libc): unlike fork it never copies the runner's page tables.
+const std = @import("std");
+const builtin = @import("builtin");
+const linux = std.os.linux;
+const Allocator = std.mem.Allocator;
+
+/// A finished child's captured streams and whether it exited 0; the caller frees both streams.
+pub const Ran = struct {
+    stdout: []u8,
+    stderr: []u8,
+    ok: bool,
+
+    pub fn deinit(r: Ran, a: Allocator) void {
+        a.free(r.stdout);
+        a.free(r.stderr);
+    }
+};
+
+pub const Limits = struct { stdout: usize, stderr: usize, timeout: std.Io.Duration };
+
+const spawned = builtin.link_libc and builtin.os.tag == .linux;
+const spawn_setpgroup: c_short = 0x02;
+
+/// argv run with stdin on /dev/null (PATH for a bare name); null if it cannot start, overflows a limit or times out.
+pub fn run(a: Allocator, io: std.Io, argv: []const []const u8, limits: Limits) Allocator.Error!?Ran {
+    if (comptime !spawned) return forked(a, io, argv, limits);
+    var arena_state = std.heap.ArenaAllocator.init(a);
+    defer arena_state.deinit();
+    const arena = arena_state.allocator();
+    const args = try arena.allocSentinel(?[*:0]const u8, argv.len, null);
+    for (argv, 0..) |arg, i| args[i] = try arena.dupeSentinel(u8, arg, 0);
+    var fds: [4]linux.fd_t = @splat(-1);
+    defer for (fds) |fd| if (fd >= 0) close(fd);
+    for (0..2) |i| {
+        var pair: [2]linux.fd_t = undefined;
+        if (linux.errno(linux.pipe2(&pair, .{ .CLOEXEC = true })) != .SUCCESS) return null;
+        fds[2 * i] = pair[0];
+        fds[2 * i + 1] = pair[1];
+    }
+    const deadline = now() +| @as(u64, @intCast(@max(limits.timeout.toNanoseconds(), 0)));
+    var pid: linux.pid_t = 0;
+    if (!start(&pid, args, fds[1], fds[3])) return null;
+    for ([_]usize{ 1, 3 }) |i| {
+        close(fds[i]);
+        fds[i] = -1;
+    }
+    var out: std.ArrayList(u8) = .empty;
+    defer out.deinit(a);
+    var err: std.ArrayList(u8) = .empty;
+    defer err.deinit(a);
+    const drained = drain(a, &fds, &out, &err, limits, deadline) catch |e| {
+        kill(pid);
+        return e;
+    };
+    if (!drained) {
+        kill(pid);
+        return null;
+    }
+    const status = switch (waitUntil(pid, deadline)) {
+        .done => |status| status,
+        .timed_out => {
+            kill(pid);
+            return null;
+        },
+        .lost => return null,
+    };
+    const stdout = try out.toOwnedSlice(a);
+    errdefer a.free(stdout);
+    return .{ .stdout = stdout, .stderr = try err.toOwnedSlice(a), .ok = status == 0 };
+}
+
+/// Reads both pipes to end of stream; false on a passed limit, the deadline or a failed poll.
+fn drain(a: Allocator, fds: *[4]linux.fd_t, out: *std.ArrayList(u8), err: *std.ArrayList(u8), limits: Limits, deadline: u64) Allocator.Error!bool {
+    var buf: [4096]u8 = undefined;
+    while (fds[0] >= 0 or fds[2] >= 0) {
+        const t = now();
+        if (t >= deadline) return false;
+        var pf = [_]linux.pollfd{
+            .{ .fd = fds[0], .events = linux.POLL.IN, .revents = 0 },
+            .{ .fd = fds[2], .events = linux.POLL.IN, .revents = 0 },
+        };
+        const wait: i32 = @intCast(@min((deadline - t) / std.time.ns_per_ms + 1, std.math.maxInt(i32)));
+        const rc = linux.poll(&pf, pf.len, wait);
+        if (linux.errno(rc) == .INTR) continue;
+        if (linux.errno(rc) != .SUCCESS) return false;
+        for ([_]usize{ 0, 2 }, [_]*std.ArrayList(u8){ out, err }, [_]usize{ limits.stdout, limits.stderr }, 0..) |i, list, limit, p| {
+            if (pf[p].revents == 0) continue;
+            const n = linux.read(fds[i], &buf, buf.len);
+            if (linux.errno(n) == .INTR or linux.errno(n) == .AGAIN) continue;
+            if (linux.errno(n) != .SUCCESS or n == 0) {
+                close(fds[i]);
+                fds[i] = -1;
+                continue;
+            }
+            if (list.items.len + n > limit) return false;
+            try list.appendSlice(a, buf[0..n]);
+        }
+    }
+    return true;
+}
+
+const libc = struct {
+    extern "c" fn posix_spawnp(pid: *linux.pid_t, file: [*:0]const u8, actions: *const Opaque, attr: ?*const anyopaque, argv: [*:null]const ?[*:0]const u8, envp: [*:null]const ?[*:0]const u8) c_int;
+    extern "c" fn posix_spawn_file_actions_init(actions: *Opaque) c_int;
+    extern "c" fn posix_spawn_file_actions_destroy(actions: *Opaque) c_int;
+    extern "c" fn posix_spawn_file_actions_adddup2(actions: *Opaque, fd: c_int, to: c_int) c_int;
+    extern "c" fn posix_spawn_file_actions_addopen(actions: *Opaque, fd: c_int, path: [*:0]const u8, flags: c_int, mode: c_uint) c_int;
+    extern "c" fn posix_spawnattr_init(attr: *Opaque) c_int;
+    extern "c" fn posix_spawnattr_destroy(attr: *Opaque) c_int;
+    extern "c" fn posix_spawnattr_setpgroup(attr: *Opaque, group: linux.pid_t) c_int;
+    extern "c" fn posix_spawnattr_setflags(attr: *Opaque, flags: c_short) c_int;
+    extern "c" fn getsid(pid: linux.pid_t) linux.pid_t;
+    extern "c" var environ: [*:null]?[*:0]u8;
+};
+
+const Opaque = extern struct { bytes: [512]u8 align(16) = undefined };
+
+fn start(pid: *linux.pid_t, argv: [:null]?[*:0]const u8, stdout: linux.fd_t, stderr: linux.fd_t) bool {
+    var attr: Opaque = .{};
+    if (libc.posix_spawnattr_init(&attr) != 0) return false;
+    defer _ = libc.posix_spawnattr_destroy(&attr);
+    if (libc.posix_spawnattr_setpgroup(&attr, 0) != 0 or libc.posix_spawnattr_setflags(&attr, spawn_setpgroup) != 0) return false;
+    var actions: Opaque = .{};
+    if (libc.posix_spawn_file_actions_init(&actions) != 0) return false;
+    defer _ = libc.posix_spawn_file_actions_destroy(&actions);
+    var rc = libc.posix_spawn_file_actions_addopen(&actions, 0, "/dev/null", 0, 0);
+    if (rc == 0) rc = libc.posix_spawn_file_actions_adddup2(&actions, stdout, 1);
+    if (rc == 0) rc = libc.posix_spawn_file_actions_adddup2(&actions, stderr, 2);
+    if (rc == 0) rc = libc.posix_spawnp(pid, argv[0].?, &actions, &attr, argv.ptr, @ptrCast(libc.environ));
+    return rc == 0;
+}
+
+fn kill(pid: linux.pid_t) void {
+    _ = linux.kill(-pid, .KILL);
+    _ = reap(pid);
+}
+
+/// Pipe EOF does not prove exit: a child that closes its streams still has the original deadline.
+fn waitUntil(pid: linux.pid_t, deadline: u64) union(enum) { done: u32, timed_out, lost } {
+    while (true) {
+        var st: i32 = 0;
+        const rc = linux.wait4(pid, &st, 1, null);
+        switch (linux.errno(rc)) {
+            .SUCCESS => if (rc != 0) return .{ .done = @bitCast(st) },
+            .INTR => continue,
+            else => return .lost,
+        }
+        if (now() >= deadline) return .timed_out;
+        const pause: linux.timespec = .{ .sec = 0, .nsec = std.time.ns_per_ms };
+        _ = linux.nanosleep(&pause, null);
+    }
+}
+
+/// The child's wait status, or null when it cannot be reaped.
+fn reap(pid: linux.pid_t) ?u32 {
+    while (true) {
+        var st: i32 = 0;
+        switch (linux.errno(linux.wait4(pid, &st, 0, null))) {
+            .SUCCESS => return @bitCast(st),
+            .INTR => continue,
+            else => return null,
+        }
+    }
+}
+
+fn close(fd: linux.fd_t) void {
+    _ = linux.close(fd);
+}
+
+fn now() u64 {
+    var ts: std.c.timespec = undefined;
+    _ = std.c.clock_gettime(.MONOTONIC, &ts);
+    return @as(u64, @intCast(ts.sec)) * std.time.ns_per_s + @as(u64, @intCast(ts.nsec));
+}
+
+/// Hosts without Linux libc (macOS builds) keep std.process.run.
+fn forked(a: Allocator, io: std.Io, argv: []const []const u8, limits: Limits) Allocator.Error!?Ran {
+    const r = std.process.run(a, io, .{
+        .argv = argv,
+        .stdout_limit = .limited(limits.stdout),
+        .stderr_limit = .limited(limits.stderr),
+        .timeout = .{ .duration = .{ .raw = limits.timeout, .clock = .awake } },
+    }) catch |err| switch (err) {
+        error.OutOfMemory => return error.OutOfMemory,
+        else => return null,
+    };
+    return .{ .stdout = r.stdout, .stderr = r.stderr, .ok = r.term.success() };
+}
+
+test "spawned compiler process: exit status, captured streams, limits, timeout and a missing program" {
+    const t = std.testing;
+    const ok = (try run(t.allocator, t.io, &.{ "/bin/sh", "-c", "printf out; printf err >&2" }, .{ .stdout = 64, .stderr = 64, .timeout = .fromMilliseconds(5000) })).?;
+    defer ok.deinit(t.allocator);
+    try t.expect(ok.ok);
+    try t.expectEqualStrings("out", ok.stdout);
+    try t.expectEqualStrings("err", ok.stderr);
+    const failed = (try run(t.allocator, t.io, &.{ "sh", "-c", "read x; exit 3" }, .{ .stdout = 64, .stderr = 64, .timeout = .fromMilliseconds(5000) })).?;
+    defer failed.deinit(t.allocator);
+    try t.expect(!failed.ok);
+    try t.expectEqual(@as(?Ran, null), try run(t.allocator, t.io, &.{ "/bin/sh", "-c", "head -c 200 /dev/zero" }, .{ .stdout = 64, .stderr = 64, .timeout = .fromMilliseconds(5000) }));
+    const t0 = now();
+    try t.expectEqual(@as(?Ran, null), try run(t.allocator, t.io, &.{ "/bin/sh", "-c", "sleep 5" }, .{ .stdout = 64, .stderr = 64, .timeout = .fromMilliseconds(100) }));
+    try t.expect(now() - t0 < 3 * std.time.ns_per_s);
+    if (comptime spawned) {
+        const closed = now();
+        try t.expectEqual(@as(?Ran, null), try run(t.allocator, t.io, &.{ "/bin/sh", "-c", "exec 1>/dev/null 2>&1; sleep 5" }, .{ .stdout = 64, .stderr = 64, .timeout = .fromMilliseconds(100) }));
+        try t.expect(now() - closed < 3 * std.time.ns_per_s);
+        try descendantsStop();
+    }
+    try t.expectEqual(@as(?Ran, null), try run(t.allocator, t.io, &.{"/nonexistent/tf-clang"}, .{ .stdout = 64, .stderr = 64, .timeout = .fromMilliseconds(5000) }));
+}
+
+/// A timed-out compiler driver must leave no live worker in the scope, even when the worker outlives the driver.
+fn descendantsStop() !void {
+    const t = std.testing;
+    var tmp = t.tmpDir(.{});
+    defer tmp.cleanup();
+    const dir = try tmp.dir.realPathFileAlloc(t.io, ".", t.allocator);
+    defer t.allocator.free(dir);
+    const path = try std.fs.path.join(t.allocator, &.{ dir, "child" });
+    defer t.allocator.free(path);
+    try t.expectEqual(@as(?Ran, null), try run(t.allocator, t.io, &.{ "/bin/sh", "-c", "sleep 30 & echo $! > \"$1\"; wait", "compiler", path }, .{ .stdout = 64, .stderr = 64, .timeout = .fromMilliseconds(200) }));
+    const bytes = try tmp.dir.readFileAlloc(t.io, "child", t.allocator, .limited(64));
+    defer t.allocator.free(bytes);
+    const pid = try std.fmt.parseInt(linux.pid_t, std.mem.trim(u8, bytes, " \r\n\t"), 10);
+    const proc = try std.fmt.allocPrint(t.allocator, "/proc/{d}/stat", .{pid});
+    defer t.allocator.free(proc);
+    const settled_by = now() + std.time.ns_per_s;
+    var alive = true;
+    var owned = false;
+    while (true) {
+        const file = std.Io.Dir.cwd().openFile(t.io, proc, .{}) catch |err| switch (err) {
+            error.FileNotFound => return,
+            else => return err,
+        };
+        defer file.close(t.io);
+        var buffer: [4096]u8 = undefined;
+        var reader = file.readerStreaming(t.io, &buffer);
+        // a stat that opens but fails to read (ESRCH) belongs to a task already gone; the open can keep succeeding
+        const stat = reader.interface.allocRemaining(t.allocator, .limited(4096)) catch |err| switch (err) {
+            error.ReadFailed => {
+                alive = false;
+                break;
+            },
+            else => return err,
+        };
+        defer t.allocator.free(stat);
+        if (stat.len == 0) return;
+        const end = std.mem.lastIndexOfScalar(u8, stat, ')') orelse return error.InvalidProcStat;
+        var fields = std.mem.tokenizeScalar(u8, stat[end + 1 ..], ' ');
+        const state = fields.next() orelse return error.InvalidProcStat;
+        _ = fields.next() orelse return error.InvalidProcStat;
+        _ = fields.next() orelse return error.InvalidProcStat;
+        const sid = try std.fmt.parseInt(linux.pid_t, fields.next() orelse return error.InvalidProcStat, 10);
+        alive = state[0] != 'Z' and state[0] != 'X';
+        owned = sid == libc.getsid(0) and std.mem.indexOf(u8, stat, "(sleep)") != null;
+        if (!alive or now() >= settled_by) break;
+        const pause: linux.timespec = .{ .sec = 0, .nsec = std.time.ns_per_ms };
+        _ = linux.nanosleep(&pause, null);
+    }
+    if (alive and owned) _ = linux.kill(pid, .KILL);
+    try t.expect(!alive);
+}
diff --git a/zig/src/core/runner_frontend_split.zig b/zig/src/core/runner_frontend_split.zig
new file mode 100644
index 000000000..2b1719143
--- /dev/null
+++ b/zig/src/core/runner_frontend_split.zig
@@ -0,0 +1,161 @@
+//! Runtime compiled once per clang and level; a body using none of its statics compiles alone, as in the whole file.
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const compile = @import("runner_frontend_program_compile.zig");
+const forkserver = @import("runner_frontend_forkserver.zig");
+const rvlink = @import("runner_frontend_rvlink.zig");
+const log = std.log.scoped(.runner_frontend);
+
+/// The whole file's runtime compiled alone: its static printf and helpers drop out, memset and memcpy stay.
+pub const runtime = compile.runtime;
+
+/// What a body sees of the runtime: its types, macros and Python's print, and the two functions it may call.
+pub const declarations = compile.runtime[0..std.mem.indexOf(u8, compile.runtime, "void *memset").?] ++
+    \\void *memset(void *destination, int value, size_t count);
+    \\void *memcpy(void *destination, const void *source, size_t count);
+    \\
+;
+
+/// A body may compile alone when it names no runtime static or inlinable call; tf_py_print is assembly in both builds.
+pub fn eligible(body: []const u8) bool {
+    var i: usize = 0;
+    while (i < body.len) {
+        const c = body[i];
+        if (!(std.ascii.isAlphabetic(c) or c == '_')) {
+            i += 1;
+            continue;
+        }
+        const start = i;
+        while (i < body.len and (std.ascii.isAlphanumeric(body[i]) or body[i] == '_')) i += 1;
+        const word = body[start..i];
+        for ([_][]const u8{ "printf", "putchar", "puts", "memset", "memcpy" }) |helper| if (std.mem.eql(u8, word, helper)) return false;
+        if (std.mem.startsWith(u8, word, "tf_") and !std.mem.eql(u8, word, "tf_py_print")) return false;
+    }
+    return true;
+}
+
+const Prebuilt = struct { clang: [256]u8 = undefined, clang_len: usize = 0, optimize: u8 = 0, object: []u8 = &.{}, su: []u8 = &.{} };
+
+var lock: std.Io.Mutex = .init;
+var prebuilt: [4]Prebuilt = @splat(.{});
+var published: std.atomic.Value(usize) = .init(0); // entries below this never change, so calls read them unlocked
+
+fn level(optimize: anytype) []const u8 {
+    return switch (optimize) {
+        .O0 => "-O0",
+        .O1 => "-O1",
+        .O2 => "-O2",
+    };
+}
+
+/// The compile step's flags for an object: the whole-file build's, without the link.
+fn objectArgv(config: compile.Config, src: []const u8, out: []const u8) [22][]const u8 {
+    return .{
+        config.clang,           "--target=riscv32-unknown-elf", "-march=rv32im_zba",  "-mabi=ilp32",
+        level(config.optimize), "-ffreestanding",               "-fno-builtin",       "-nostdinc",
+        "-fno-stack-protector", "-fno-pic",                     "-mno-relax",         "-Werror=format",
+        "-Wno-format-security", "-fstack-usage",                "-fno-unwind-tables", "-fno-asynchronous-unwind-tables",
+        "-c",                   "-x",                           "c",                  src,
+        "-o",                   out,
+    };
+}
+
+fn find(config: compile.Config) ?Prebuilt {
+    for (prebuilt[0..published.load(.acquire)]) |e| if (e.optimize == @backingInt(config.optimize) and std.mem.eql(u8, e.clang[0..e.clang_len], config.clang)) return e;
+    return null;
+}
+
+/// The runtime object and stack report for `config`, else compiled in empty `path`; a call (`wait` false) never queues.
+fn runtimeFor(a: Allocator, io: std.Io, path: []const u8, config: compile.Config, timeout: std.Io.Duration, wait: bool) Allocator.Error!?Prebuilt {
+    if (config.clang.len > 256) return null;
+    if (find(config)) |e| return e;
+    if (wait) lock.lockUncancelable(io) else if (!lock.tryLock()) return null;
+    defer lock.unlock(io);
+    if (find(config)) |e| return e;
+    const n = published.load(.monotonic);
+    if (n == prebuilt.len) return null;
+    const src = try std.fs.path.join(a, &.{ path, "runtime.c" });
+    defer a.free(src);
+    const obj = try std.fs.path.join(a, &.{ path, "runtime.o" });
+    defer a.free(obj);
+    std.Io.Dir.cwd().writeFile(io, .{ .sub_path = src, .data = runtime }) catch return null;
+    var argv = objectArgv(config, src, obj);
+    const ran = try forkserver.run(a, io, path, &argv, .{ .stdout = 4096, .stderr = 16384, .timeout = timeout }) orelse return null;
+    defer ran.deinit(a);
+    if (!ran.ok) return null;
+    const object = readFile(io, path, "runtime.o", 1 << 20) orelse return null;
+    const su = readFile(io, path, "runtime.su", 65536) orelse {
+        std.heap.page_allocator.free(object);
+        return null;
+    };
+    var entry: Prebuilt = .{ .optimize = @backingInt(config.optimize), .object = object, .su = su, .clang_len = config.clang.len };
+    @memcpy(entry.clang[0..config.clang.len], config.clang);
+    prebuilt[n] = entry;
+    published.store(n + 1, .release);
+    return entry;
+}
+
+fn readFile(io: std.Io, dir: []const u8, name: []const u8, limit: usize) ?[]u8 {
+    var buf: [4096]u8 = undefined;
+    const path = std.fmt.bufPrint(&buf, "{s}/{s}", .{ dir, name }) catch return null;
+    return std.Io.Dir.cwd().readFileAlloc(io, path, std.heap.page_allocator, .limited(limit)) catch null;
+}
+
+/// A linked image and the summed stack report of runtime and body; the caller frees both.
+pub const Built = struct {
+    elf: []u8,
+    su: []u8,
+
+    pub fn deinit(b: Built, a: Allocator) void {
+        a.free(b.elf);
+        a.free(b.su);
+    }
+};
+
+/// The body compiled alone in `path`, linked with the runtime; null on any failure (the whole file builds instead).
+pub fn build(a: Allocator, io: std.Io, path: []const u8, body: []const u8, config: compile.Config, timeout: std.Io.Duration) Allocator.Error!?Built {
+    // the identity tests cover O1 and O2, the levels calls use
+    if (config.optimize == .O0) return null;
+    const rt = try runtimeFor(a, io, path, config, timeout, false) orelse return null;
+    const src = try std.fs.path.join(a, &.{ path, "body.c" });
+    defer a.free(src);
+    const obj = try std.fs.path.join(a, &.{ path, "body.o" });
+    defer a.free(obj);
+    const text = try std.mem.concat(a, u8, &.{ declarations, body });
+    defer a.free(text);
+    std.Io.Dir.cwd().writeFile(io, .{ .sub_path = src, .data = text }) catch return null;
+    var argv = objectArgv(config, src, obj);
+    const ran = try forkserver.run(a, io, path, &argv, .{ .stdout = 4096, .stderr = 16384, .timeout = timeout }) orelse return null;
+    defer ran.deinit(a);
+    if (!ran.ok) return null;
+    const object = readFile(io, path, "body.o", 1 << 20) orelse return null;
+    defer std.heap.page_allocator.free(object);
+    // an aggregate copy or fill the compiler lowered to a call: the whole file may inline that function
+    if (rvlink.references(object, "memset") or rvlink.references(object, "memcpy")) return null;
+    const body_su = readFile(io, path, "body.su", 65536) orelse return null;
+    defer std.heap.page_allocator.free(body_su);
+    const elf = try rvlink.link(a, &.{ rt.object, object }) orelse {
+        log.debug("in-process link declined a body; ld.lld links it", .{});
+        return null;
+    };
+    errdefer a.free(elf);
+    return .{ .elf = elf, .su = try std.mem.concat(a, u8, &.{ rt.su, body_su }) };
+}
+
+/// Starts the fork server and compiles the runtime at O1 and O2 (numeric programs); best effort, off the call path.
+pub fn warm(a: Allocator, io: std.Io, config: compile.Config) Allocator.Error!void {
+    if (!std.fs.path.isAbsolute(config.scratch_root)) return;
+    const parent = std.Io.Dir.cwd().openDir(io, config.scratch_root, .{}) catch return;
+    defer parent.close(io);
+    var name_buf: [64]u8 = undefined;
+    const name = compile.scratch(io, parent, &name_buf) orelse return;
+    defer parent.deleteTree(io, name) catch {};
+    const path = try std.fs.path.join(a, &.{ config.scratch_root, name });
+    defer a.free(path);
+    _ = try forkserver.start(a, io, config.clang, config.linker, path);
+    for ([_]@TypeOf(config.optimize){ .O1, .O2 }) |optimize| {
+        var at = config;
+        at.optimize = optimize;
+        _ = try runtimeFor(a, io, path, at, .fromMilliseconds(10_000), true);
+    }
+}
