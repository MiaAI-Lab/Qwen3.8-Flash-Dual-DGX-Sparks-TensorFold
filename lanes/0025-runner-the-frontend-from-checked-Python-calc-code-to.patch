+}
+
+fn charRange(s: []const u8, index: Range) Value {
+    if (index.lo >= s.len) return Value.integer(0);
+    return .{ .number = .{ .lo = if (index.hi < s.len) 1 else 0, .hi = 127 } };
+}
+
+fn truth(r: Range, invert: bool) Range {
+    const yes = r.lo > 0 or r.hi < 0;
+    const no = r.lo == 0 and r.hi == 0;
+    if (yes) return Range.exact(@intFromBool(!invert));
+    if (no) return Range.exact(@intFromBool(invert));
+    return .{ .lo = 0, .hi = 1 };
+}
+
+fn fit(node: V, r: Range) Error!Range {
+    const t = m.integerType(m.typ(node)) orelse return error.Unsupported;
+    if (t.fits(r)) return r;
+    if (t.signed) return error.Unsupported;
+    return t.range();
+}
+
+fn binary(node: V, operator: []const u8, x: Range, y: Range) Error!Range {
+    if (std.mem.eql(u8, operator, "+")) return fit(node, .{ .lo = x.lo + y.lo, .hi = x.hi + y.hi });
+    if (std.mem.eql(u8, operator, "-")) return fit(node, .{ .lo = x.lo - y.hi, .hi = x.hi - y.lo });
+    if (std.mem.eql(u8, operator, "*")) {
+        const t = m.integerType(m.typ(node)) orelse return error.Unsupported;
+        const pairs = [_][2]i128{ .{ x.lo, y.lo }, .{ x.lo, y.hi }, .{ x.hi, y.lo }, .{ x.hi, y.hi } };
+        var r: Range = .{ .lo = std.math.maxInt(i128), .hi = std.math.minInt(i128) };
+        for (pairs) |pair| {
+            const n = std.math.mul(i128, pair[0], pair[1]) catch {
+                if (t.signed) return error.Unsupported;
+                return t.range();
+            };
+            r.lo = @min(r.lo, n);
+            r.hi = @max(r.hi, n);
+        }
+        return fit(node, r);
+    }
+    if (std.mem.eql(u8, operator, "/") or std.mem.eql(u8, operator, "%")) {
+        if (y.lo <= 0 and y.hi >= 0) return error.Unsupported;
+        const t = m.integerType(m.typ(node)) orelse return error.Unsupported;
+        if (x.lo == t.range().lo and t.signed and y.lo <= -1 and y.hi >= -1) return error.Unsupported;
+        if (std.mem.eql(u8, operator, "%")) {
+            const bound = @max(@abs(y.lo), @abs(y.hi)) - 1;
+            return .{ .lo = if (x.lo < 0) -@as(i128, @intCast(bound)) else 0, .hi = if (x.hi > 0) @intCast(bound) else 0 };
+        }
+        const values = [_]i128{ @divTrunc(x.lo, y.lo), @divTrunc(x.lo, y.hi), @divTrunc(x.hi, y.lo), @divTrunc(x.hi, y.hi) };
+        var r = Range.exact(values[0]);
+        for (values[1..]) |n| r = r.join(Range.exact(n));
+        return fit(node, r);
+    }
+    var yes = false;
+    var no = false;
+    if (std.mem.eql(u8, operator, "<")) {
+        yes = x.hi < y.lo;
+        no = x.lo >= y.hi;
+    } else if (std.mem.eql(u8, operator, "<=")) {
+        yes = x.hi <= y.lo;
+        no = x.lo > y.hi;
+    } else if (std.mem.eql(u8, operator, ">")) {
+        yes = x.lo > y.hi;
+        no = x.hi <= y.lo;
+    } else if (std.mem.eql(u8, operator, ">=")) {
+        yes = x.lo >= y.hi;
+        no = x.hi < y.lo;
+    } else if (std.mem.eql(u8, operator, "==") or std.mem.eql(u8, operator, "!=")) {
+        yes = x.lo == x.hi and y.lo == y.hi and x.lo == y.lo;
+        no = x.hi < y.lo or y.hi < x.lo;
+        if (std.mem.eql(u8, operator, "!=")) std.mem.swap(bool, &yes, &no);
+    } else return error.Unsupported;
+    return if (yes) Range.exact(1) else if (no) Range.exact(0) else .{ .lo = 0, .hi = 1 };
+}
+
+pub fn refine(env: *Env, condition: V, positive: bool) void {
+    const node = m.strip(condition);
+    const c = m.children(node);
+    if (m.is(node, "UnaryOperator") and m.op(node, "!") and c.len == 1) return refine(env, c[0], !positive);
+    if (m.is(node, "DeclRefExpr")) {
+        const b = env.find(safeRef(env, condition)) orelse return;
+        var r = b.value.number orelse return;
+        if (!positive and r.lo <= 0 and r.hi >= 0) r = Range.exact(0) else if (positive and r.lo == 0 and r.hi > 0) r.lo = 1;
+        b.value.number = r;
+        return;
+    }
+    if (!m.is(node, "BinaryOperator") or c.len != 2) return;
+    const left = env.find(safeRef(env, c[0]));
+    const right = env.find(safeRef(env, c[1]));
+    const x = if (left) |b| b.value.number else literal(c[0]);
+    const y = if (right) |b| b.value.number else literal(c[1]);
+    if (x == null or y == null) return;
+    var a = x.?;
+    var b = y.?;
+    var operator = m.text(m.field(node, "opcode"));
+    if (!positive) {
+        const pairs = [_][2][]const u8{ .{ "<", ">=" }, .{ "<=", ">" }, .{ ">", "<=" }, .{ ">=", "<" }, .{ "==", "!=" }, .{ "!=", "==" } };
+        for (pairs) |pair| if (std.mem.eql(u8, operator, pair[0])) {
+            operator = pair[1];
+            break;
+        };
+    }
+    if (std.mem.eql(u8, operator, ">") or std.mem.eql(u8, operator, ">=")) {
+        const delta: i128 = @intFromBool(std.mem.eql(u8, operator, ">"));
+        a.lo = @max(a.lo, b.lo + delta);
+        b.hi = @min(b.hi, a.hi - delta);
+    } else if (std.mem.eql(u8, operator, "<") or std.mem.eql(u8, operator, "<=")) {
+        const delta: i128 = @intFromBool(std.mem.eql(u8, operator, "<"));
+        a.hi = @min(a.hi, b.hi - delta);
+        b.lo = @max(b.lo, a.lo + delta);
+    } else if (std.mem.eql(u8, operator, "==")) {
+        a = .{ .lo = @max(a.lo, b.lo), .hi = @min(a.hi, b.hi) };
+        b = a;
+    } else if (std.mem.eql(u8, operator, "!=")) {
+        if (b.lo == b.hi) {
+            if (a.lo == b.lo) a.lo += 1;
+            if (a.hi == b.hi) a.hi -= 1;
+        }
+        if (x.?.lo == x.?.hi) {
+            if (b.lo == x.?.lo) b.lo += 1;
+            if (b.hi == x.?.hi) b.hi -= 1;
+        }
+    }
+    if (a.lo <= a.hi) {
+        if (left) |binding| binding.value.number = a;
+    }
+    if (b.lo <= b.hi) {
+        if (right) |binding| binding.value.number = b;
+    }
+}
+
+pub fn safeRef(env: *Env, raw: V) []const u8 {
+    const id = m.ref(raw);
+    const binding = env.find(id) orelse return "";
+    const r = binding.value.number orelse return "";
+    return transparentRef(raw, r);
+}
+
+pub fn transparentRef(raw: V, r: Range) []const u8 {
+    const id = m.ref(raw);
+    var n = raw;
+    for (0..64) |_| {
+        if (m.is(n, "DeclRefExpr")) return id;
+        const c = m.children(n);
+        if (c.len != 1) return "";
+        if (m.is(n, "ImplicitCastExpr") or m.is(n, "CStyleCastExpr")) {
+            const t = m.integerType(m.typ(n)) orelse return "";
+            if (!t.fits(r)) return "";
+        } else if (!m.is(n, "ParenExpr")) return "";
+        n = c[0];
+    }
+    return "";
+}
+
+fn literal(v: V) ?Range {
+    const n = m.strip(v);
+    if (!m.is(n, "IntegerLiteral") and !m.is(n, "CharacterLiteral")) return null;
+    const r = Range.exact(m.integer(n) catch return null);
+    var wrapper = v;
+    for (0..64) |_| {
+        if (m.is(wrapper, "IntegerLiteral") or m.is(wrapper, "CharacterLiteral")) return r;
+        const c = m.children(wrapper);
+        if (c.len != 1) return null;
+        if (m.is(wrapper, "ImplicitCastExpr") or m.is(wrapper, "CStyleCastExpr")) {
+            const t = m.integerType(m.typ(wrapper)) orelse return null;
+            if (!t.fits(r)) return null;
+        } else if (!m.is(wrapper, "ParenExpr") and !m.is(wrapper, "ConstantExpr")) return null;
+        wrapper = c[0];
+    }
+    return null;
+}
diff --git a/zig/src/core/runner_frontend_c_cost_loops.zig b/zig/src/core/runner_frontend_c_cost_loops.zig
new file mode 100644
index 000000000..af26f324c
--- /dev/null
+++ b/zig/src/core/runner_frontend_c_cost_loops.zig
@@ -0,0 +1,236 @@
+const std = @import("std");
+const m = @import("runner_frontend_c_cost_model.zig");
+const expression = @import("runner_frontend_c_cost_expr.zig");
+const Flow = @import("runner_frontend_c_cost.zig").Flow;
+const V = m.V;
+const Error = m.Error;
+const Env = m.Env;
+
+pub fn forLoop(p: anytype, env: *Env, node: V) Error!Flow {
+    const c = m.children(node);
+    if (c.len != 5 or m.field(c[1], "kind") != .null) return error.Unsupported;
+    const mark = env.bindings.items.len;
+    defer env.bindings.shrinkRetainingCapacity(mark);
+    if (m.field(c[0], "kind") != .null) {
+        const init = try p.stmt(env, c[0]);
+        if (!init.normal or init.returned != null) return error.Unsupported;
+    }
+    const step = try increment(c[3]);
+    const count = try tripCount(p, env, c[2], step);
+    return run(p, env, c[2], c[3], c[4], null, count);
+}
+
+pub fn whileLoop(p: anytype, env: *Env, node: V) Error!Flow {
+    const c = m.children(node);
+    if (c.len != 2) return error.Unsupported;
+    if (try euclid(p, env, c[0], c[1])) |flow| return flow;
+    if (!m.is(c[1], "CompoundStmt")) {
+        const step = try increment(c[1]);
+        const count = try tripCount(p, env, c[0], step);
+        return run(p, env, c[0], c[1], .null, &.{}, count);
+    }
+    const body = m.children(c[1]);
+    if (body.len == 0) return error.Unsupported;
+    const inc = body[body.len - 1];
+    const step = try increment(inc);
+    const count = try tripCount(p, env, c[0], step);
+    return run(p, env, c[0], inc, .null, body[0 .. body.len - 1], count);
+}
+
+const Step = struct { id: []const u8, delta: i128 };
+
+fn increment(raw: V) Error!Step {
+    const n = m.strip(raw);
+    const c = m.children(n);
+    if (c.len == 1 and m.is(n, "UnaryOperator") and (m.op(n, "++") or m.op(n, "--"))) {
+        const id = m.ref(c[0]);
+        if (id.len == 0) return error.Unsupported;
+        return .{ .id = id, .delta = if (m.op(n, "++")) 1 else -1 };
+    }
+    if (c.len == 2 and m.is(n, "CompoundAssignOperator") and (m.op(n, "+=") or m.op(n, "-="))) {
+        const id = m.ref(c[0]);
+        const value = m.strip(c[1]);
+        if (id.len == 0 or !m.is(value, "IntegerLiteral")) return error.Unsupported;
+        var delta = try m.integer(value);
+        if (m.op(n, "-=")) delta = -delta;
+        if (delta == 0) return error.Unsupported;
+        return .{ .id = id, .delta = delta };
+    }
+    if (c.len == 2 and m.is(n, "BinaryOperator") and m.op(n, "=")) {
+        const id = m.ref(c[0]);
+        const rhs = m.strip(c[1]);
+        const terms = m.children(rhs);
+        if (id.len == 0 or !m.is(rhs, "BinaryOperator") or terms.len != 2 or
+            !std.mem.eql(u8, id, m.ref(terms[0])) or (!m.op(rhs, "+") and !m.op(rhs, "-")))
+            return error.Unsupported;
+        const value = m.strip(terms[1]);
+        if (!m.is(value, "IntegerLiteral")) return error.Unsupported;
+        var delta = try m.integer(value);
+        if (m.op(rhs, "-")) delta = -delta;
+        if (delta == 0) return error.Unsupported;
+        return .{ .id = id, .delta = delta };
+    }
+    return error.Unsupported;
+}
+
+fn tripCount(p: anytype, env: *Env, raw: V, step: Step) Error!usize {
+    const n = m.strip(raw);
+    const c = m.children(n);
+    const binding = env.find(step.id) orelse return error.Unsupported;
+    const start = try binding.value.numeric();
+    if (start.lo != start.hi) return error.Unsupported;
+    if (m.is(n, "ArraySubscriptExpr") and c.len == 2 and step.delta == 1 and
+        std.mem.eql(u8, m.ref(c[1]), step.id))
+    {
+        const base = try p.eval(env, c[0]);
+        const text = base.text orelse if (base.array) |ar| ar.text orelse return error.Unsupported else return error.Unsupported;
+        if (start.lo < 0 or start.hi > text.len) return error.Unsupported;
+        const count = text.len - @as(usize, @intCast(start.lo));
+        if (count > p.limit) return error.Unsupported;
+        return count;
+    }
+    if (!m.is(n, "BinaryOperator") or c.len != 2 or !std.mem.eql(u8, expression.safeRef(env, c[0]), step.id))
+        return error.Unsupported;
+    try pure(p, c[1], 0);
+    const stop = try (try p.eval(env, c[1])).numeric();
+    var count: i128 = 0;
+    if (step.delta > 0 and (m.op(n, "<") or m.op(n, "<="))) {
+        const last = stop.hi - @intFromBool(m.op(n, "<"));
+        if (last >= start.lo) count = @divFloor(last - start.lo, step.delta) + 1;
+    } else if (step.delta < 0 and (m.op(n, ">") or m.op(n, ">="))) {
+        const last = stop.lo + @intFromBool(m.op(n, ">"));
+        if (start.hi >= last) count = @divFloor(start.hi - last, -step.delta) + 1;
+    } else return error.Unsupported;
+    if (count > p.limit) return error.Unsupported;
+    const t = binding.typ orelse return error.Unsupported;
+    const end = std.math.mul(i128, count, step.delta) catch return error.Unsupported;
+    const final = std.math.add(i128, start.lo, end) catch return error.Unsupported;
+    if (!t.fits(m.Range.exact(final))) return error.Unsupported;
+    return @intCast(count);
+}
+
+fn run(p: anytype, env: *Env, condition: V, inc: V, body: V, slice: ?[]const V, count: usize) Error!Flow {
+    var exits: ?Env = null;
+    var result: Flow = .{ .normal = false };
+    var iteration: usize = 0;
+    while (true) {
+        const r = try (try p.eval(env, condition)).numeric();
+        try p.charge(2);
+        const maybe_exit = r.lo <= 0 and r.hi >= 0;
+        if (maybe_exit) {
+            var exit = try p.clone(env);
+            expression.refine(&exit, condition, false);
+            if (exits) |*old| try old.merge(&exit) else exits = exit;
+        }
+        if (r.lo == 0 and r.hi == 0) break;
+        if (iteration >= count) return error.Unsupported;
+        iteration += 1;
+        expression.refine(env, condition, true);
+        const lock_mark = p.locked.items.len;
+        try protect(p, condition, 0);
+        const next = if (slice) |nodes| try p.block(env, nodes) else try p.stmt(env, body);
+        p.locked.shrinkRetainingCapacity(lock_mark);
+        try result.include(next);
+        if (!next.normal) break;
+        _ = try p.eval(env, inc);
+        try p.charge(2);
+    }
+    if (exits) |exit| {
+        env.* = exit;
+        result.normal = true;
+    }
+    return result;
+}
+
+fn protect(p: anytype, n: V, depth: usize) Error!void {
+    if (depth >= 64 or p.locked.items.len >= 256) return error.Unsupported;
+    try pure(p, n, depth);
+    const id = m.ref(n);
+    if (id.len != 0) try p.locked.append(p.a, id);
+    for (m.children(n)) |child| try protect(p, child, depth + 1);
+}
+
+fn pure(p: anytype, n: V, depth: usize) Error!void {
+    try p.touch();
+    if (depth >= 64 or m.is(n, "CallExpr") or m.is(n, "CompoundAssignOperator") or m.op(n, "=") or
+        m.op(n, "++") or m.op(n, "--") or m.op(n, ",")) return error.Unsupported;
+    for (m.children(n)) |child| try pure(p, child, depth + 1);
+}
+
+fn assignment(n: V) ?struct { id: []const u8, rhs: V } {
+    const c = m.children(n);
+    if (!m.is(n, "BinaryOperator") or !m.op(n, "=") or c.len != 2) return null;
+    const id = m.ref(c[0]);
+    if (id.len == 0) return null;
+    return .{ .id = id, .rhs = c[1] };
+}
+
+fn euclid(p: anytype, env: *Env, cond: V, body: V) Error!?Flow {
+    const nodes = m.children(body);
+    if (!m.is(body, "CompoundStmt") or nodes.len != 3 or !m.is(nodes[0], "DeclStmt")) return null;
+    const declarations = m.children(nodes[0]);
+    if (declarations.len != 1 or !m.is(declarations[0], "VarDecl")) return null;
+    const temp = declarations[0];
+    const initializers = m.children(temp);
+    if (initializers.len != 1) return null;
+    const first = assignment(nodes[1]) orelse return null;
+    const second = assignment(nodes[2]) orelse return null;
+    const delayed = m.ref(initializers[0]).len != 0;
+    const remainder_source = if (delayed) first.rhs else initializers[0];
+    const rem = m.strip(remainder_source);
+    const operands = m.children(rem);
+    if (!m.is(rem, "BinaryOperator") or !m.op(rem, "%") or operands.len != 2) return null;
+    if ((m.integerType(m.typ(rem)) orelse return error.Unsupported).bits > 32) return error.Unsupported;
+    const a_id = expression.safeRef(env, operands[0]);
+    const b_id = expression.safeRef(env, operands[1]);
+    const t_id = m.text(m.field(temp, "id"));
+    if (a_id.len == 0 or b_id.len == 0 or std.mem.eql(u8, a_id, b_id)) return null;
+    const saved_b = if (delayed) initializers[0] else first.rhs;
+    if (!std.mem.eql(u8, first.id, if (delayed) b_id else a_id) or
+        !std.mem.eql(u8, expression.safeRef(env, saved_b), b_id) or
+        !std.mem.eql(u8, second.id, if (delayed) a_id else b_id) or
+        !std.mem.eql(u8, m.ref(second.rhs), t_id)) return null;
+    const guard = m.strip(cond);
+    var guard_id = expression.safeRef(env, cond);
+    if (m.is(guard, "BinaryOperator") and m.op(guard, "!=")) {
+        const c = m.children(guard);
+        if (c.len != 2 or !m.is(m.strip(c[1]), "IntegerLiteral") or try m.integer(m.strip(c[1])) != 0)
+            return null;
+        guard_id = expression.safeRef(env, c[0]);
+    }
+    if (!std.mem.eql(u8, guard_id, b_id)) return null;
+    const a_binding = env.find(a_id) orelse return error.Unsupported;
+    const b_binding = env.find(b_id) orelse return error.Unsupported;
+    const x = try a_binding.value.numeric();
+    const y = try b_binding.value.numeric();
+    const top = @max(x.hi, y.hi);
+    if (x.lo < 0 or y.lo < 0 or top > std.math.maxInt(u32)) return error.Unsupported;
+    const bound: m.Range = .{ .lo = 0, .hi = top };
+    var wrapper = remainder_source;
+    for (0..64) |_| {
+        if (m.is(wrapper, "BinaryOperator")) break;
+        const inner = m.children(wrapper);
+        if (inner.len != 1) return error.Unsupported;
+        if (m.is(wrapper, "ImplicitCastExpr") or m.is(wrapper, "CStyleCastExpr")) {
+            if (!(m.integerType(m.typ(wrapper)) orelse return error.Unsupported).fits(bound))
+                return error.Unsupported;
+        } else if (!m.is(wrapper, "ParenExpr")) return error.Unsupported;
+        wrapper = inner[0];
+    }
+    if (!std.mem.eql(u8, expression.transparentRef(second.rhs, bound), t_id) or
+        !std.mem.eql(u8, expression.transparentRef(saved_b, bound), b_id) or
+        !std.mem.eql(u8, expression.transparentRef(operands[0], bound), a_id) or
+        !std.mem.eql(u8, expression.transparentRef(operands[1], bound), b_id)) return error.Unsupported;
+    if (!(a_binding.typ orelse return error.Unsupported).fits(bound) or
+        !(b_binding.typ orelse return error.Unsupported).fits(bound) or
+        !(m.integerType(m.typ(temp)) orelse return error.Unsupported).fits(bound)) return error.Unsupported;
+    var bits: usize = 0;
+    var n = top;
+    while (n > 0) : (n = @divTrunc(n, 2)) bits += 1;
+    const iterations = if (y.hi == 0) 0 else 2 * bits + 1;
+    if (iterations > p.limit) return error.Unsupported;
+    try p.charge(12 + iterations * 45);
+    try p.store(env, operands[0], .{ .number = bound });
+    try p.store(env, operands[1], m.Value.integer(0));
+    return Flow{};
+}
diff --git a/zig/src/core/runner_frontend_c_cost_model.zig b/zig/src/core/runner_frontend_c_cost_model.zig
new file mode 100644
index 000000000..8ffea4e11
--- /dev/null
+++ b/zig/src/core/runner_frontend_c_cost_model.zig
@@ -0,0 +1,248 @@
+const std = @import("std");
+pub const V = std.json.Value;
+pub const Error = std.mem.Allocator.Error || error{Unsupported};
+pub const Range = struct {
+    lo: i128,
+    hi: i128,
+
+    pub fn exact(n: i128) Range {
+        return .{ .lo = n, .hi = n };
+    }
+    pub fn join(x: Range, y: Range) Range {
+        return .{ .lo = @min(x.lo, y.lo), .hi = @max(x.hi, y.hi) };
+    }
+};
+pub const Type = struct {
+    bits: u8,
+    signed: bool,
+    plain_char: bool = false,
+
+    pub fn range(t: Type) Range {
+        if (t.plain_char) return .{ .lo = -128, .hi = 255 };
+        const n = @as(i128, 1) << @intCast(t.bits - @intFromBool(t.signed));
+        return .{ .lo = if (t.signed) -n else 0, .hi = n - 1 };
+    }
+    pub fn fits(t: Type, r: Range) bool {
+        if (t.plain_char) return r.lo >= 0 and r.hi <= 127;
+        const full = t.range();
+        return r.lo >= full.lo and r.hi <= full.hi;
+    }
+};
+pub const Array = struct {
+    count: usize,
+    element: Range,
+    element_type: Type,
+    text: ?[]const u8 = null,
+    readable: bool = true,
+};
+pub const Value = struct {
+    number: ?Range = null,
+    array: ?Array = null,
+    text: ?[]const u8 = null,
+
+    pub fn integer(n: i128) Value {
+        return .{ .number = Range.exact(n) };
+    }
+    pub fn numeric(v: Value) Error!Range {
+        return v.number orelse error.Unsupported;
+    }
+    pub fn join(x: Value, y: Value) Error!Value {
+        if ((x.number == null and x.array == null and x.text == null) or
+            (y.number == null and y.array == null and y.text == null)) return .{};
+        if (x.number) |r| return .{ .number = r.join(try y.numeric()) };
+        if (x.array) |r| {
+            const s = y.array orelse return error.Unsupported;
+            if (r.count != s.count or r.element_type.bits != s.element_type.bits or
+                r.element_type.signed != s.element_type.signed or
+                r.element_type.plain_char != s.element_type.plain_char) return error.Unsupported;
+            var result = r;
+            result.element = r.element.join(s.element);
+            result.readable = r.readable and s.readable;
+            if (r.text == null or s.text == null or !std.mem.eql(u8, r.text.?, s.text.?)) result.text = null;
+            return .{ .array = result };
+        }
+        if (x.text) |s| {
+            if (y.text) |t| {
+                if (std.mem.eql(u8, s, t)) return x;
+            }
+        }
+        return error.Unsupported;
+    }
+};
+pub const Binding = struct {
+    id: []const u8,
+    value: Value,
+    typ: ?Type,
+    global: bool = false,
+    indirect: bool = false,
+};
+pub const Env = struct {
+    bindings: std.ArrayList(Binding) = .empty,
+
+    pub fn find(e: *Env, id: []const u8) ?*Binding {
+        for (e.bindings.items) |*b| if (std.mem.eql(u8, b.id, id)) return b;
+        return null;
+    }
+    pub fn add(e: *Env, a: std.mem.Allocator, b: Binding) Error!void {
+        if (e.bindings.items.len >= 128 or e.find(b.id) != null) return error.Unsupported;
+        try e.bindings.append(a, b);
+    }
+    pub fn clone(e: *const Env, a: std.mem.Allocator) Error!Env {
+        var out: Env = .{};
+        try out.bindings.appendSlice(a, e.bindings.items);
+        return out;
+    }
+    pub fn merge(e: *Env, other: *const Env) Error!void {
+        for (e.bindings.items) |*b| {
+            for (other.bindings.items) |s| {
+                if (!std.mem.eql(u8, b.id, s.id)) continue;
+                b.value = try b.value.join(s.value);
+                break;
+            }
+        }
+    }
+};
+pub fn field(v: V, name: []const u8) V {
+    return if (v == .object) v.object.get(name) orelse .null else .null;
+}
+pub fn text(v: V) []const u8 {
+    return if (v == .string) v.string else "";
+}
+pub fn is(v: V, kind: []const u8) bool {
+    return std.mem.eql(u8, text(field(v, "kind")), kind);
+}
+pub fn children(v: V) []const V {
+    const inner = field(v, "inner");
+    return if (inner == .array) inner.array.items else &.{};
+}
+pub fn op(v: V, s: []const u8) bool {
+    return std.mem.eql(u8, text(field(v, "opcode")), s);
+}
+pub fn strip(v: V) V {
+    var n = v;
+    for (0..64) |_| {
+        if (!is(n, "ParenExpr") and !is(n, "ImplicitCastExpr") and !is(n, "CStyleCastExpr") and
+            !is(n, "ConstantExpr")) return n;
+        const c = children(n);
+        if (c.len != 1) return n;
+        n = c[0];
+    }
+    return .null;
+}
+pub fn ref(v: V) []const u8 {
+    const n = strip(v);
+    if (!is(n, "DeclRefExpr")) return "";
+    return text(field(field(n, "referencedDecl"), "id"));
+}
+pub fn typ(v: V) []const u8 {
+    const t = field(v, "type");
+    const desugared = text(field(t, "desugaredQualType"));
+    return if (desugared.len != 0) desugared else text(field(t, "qualType"));
+}
+pub fn integerType(raw: []const u8) ?Type {
+    var s = raw;
+    while (true) {
+        var changed = false;
+        for ([_][]const u8{ "const ", "volatile ", "restrict " }) |prefix| {
+            if (std.mem.startsWith(u8, s, prefix)) {
+                s = s[prefix.len..];
+                changed = true;
+            }
+        }
+        if (!changed) break;
+    }
+    if (std.mem.eql(u8, s, "char")) return .{ .bits = 8, .signed = true, .plain_char = true };
+    if (std.mem.eql(u8, s, "_Bool")) return .{ .bits = 1, .signed = false };
+    var signed = true;
+    if (std.mem.startsWith(u8, s, "unsigned ")) {
+        signed = false;
+        s = s[9..];
+    } else if (std.mem.startsWith(u8, s, "signed ")) s = s[7..];
+    const bits: u8 = if (std.mem.eql(u8, s, "char")) 8 else if (std.mem.eql(u8, s, "short")) 16 else if (std.mem.eql(u8, s, "int") or std.mem.eql(u8, s, "long")) 32 else if (std.mem.eql(u8, s, "long long")) 64 else return null;
+    return .{ .bits = bits, .signed = signed };
+}
+pub fn arrayType(raw: []const u8) ?struct { element: Type, count: usize } {
+    const start = std.mem.indexOfScalar(u8, raw, '[') orelse return null;
+    if (raw.len < start + 3 or raw[raw.len - 1] != ']') return null;
+    const count = std.fmt.parseInt(usize, raw[start + 1 .. raw.len - 1], 10) catch return null;
+    if (count == 0 or count > 32768) return null;
+    return .{ .element = integerType(std.mem.trim(u8, raw[0..start], " ")) orelse return null, .count = count };
+}
+pub fn pointerType(raw: []const u8) ?Type {
+    const s = std.mem.trim(u8, raw, " ");
+    if (s.len == 0 or s[s.len - 1] != '*') return null;
+    return integerType(std.mem.trim(u8, s[0 .. s.len - 1], " "));
+}
+pub fn size(raw: []const u8) ?usize {
+    if (integerType(raw)) |t| return @max(@as(usize, 1), t.bits / 8);
+    if (arrayType(raw)) |t| return t.count * @max(@as(usize, 1), t.element.bits / 8);
+    if (pointerType(raw) != null) return 4;
+    return null;
+}
+pub fn integer(v: V) Error!i128 {
+    const n = field(v, "value");
+    return switch (n) {
+        .integer => n.integer,
+        .string => std.fmt.parseInt(i128, n.string, 10) catch error.Unsupported,
+        else => error.Unsupported,
+    };
+}
+pub fn string(a: std.mem.Allocator, v: V) Error![]const u8 {
+    const raw = text(field(strip(v), "value"));
+    if (!is(strip(v), "StringLiteral") or raw.len < 2 or raw.len > 16386 or
+        raw[0] != '"' or raw[raw.len - 1] != '"')
+        return error.Unsupported;
+    var out: std.ArrayList(u8) = .empty;
+    var i: usize = 1;
+    while (i + 1 < raw.len) : (i += 1) {
+        var c = raw[i];
+        if (c == '\\') {
+            i += 1;
+            if (i + 1 >= raw.len) return error.Unsupported;
+            c = switch (raw[i]) {
+                'n' => '\n',
+                'r' => '\r',
+                't' => '\t',
+                '\\' => '\\',
+                '"' => '"',
+                '\'' => '\'',
+                '0'...'7' => blk: {
+                    var n: u16 = raw[i] - '0';
+                    var digits: usize = 1;
+                    while (digits < 3 and i + 2 < raw.len and raw[i + 1] >= '0' and raw[i + 1] <= '7') : (digits += 1) {
+                        i += 1;
+                        n = n * 8 + raw[i] - '0';
+                    }
+                    if (n > 255) return error.Unsupported;
+                    break :blk @intCast(n);
+                },
+                else => return error.Unsupported,
+            };
+        }
+        if (c == 0) return error.Unsupported;
+        if (c >= 128) return error.Unsupported;
+        try out.append(a, c);
+    }
+    return out.items;
+}
+pub fn validateJson(s: []const u8) bool {
+    var depth: usize = 0;
+    var quoted = false;
+    var escaped = false;
+    var objects: usize = 0;
+    for (s) |c| {
+        if (quoted) {
+            if (escaped) escaped = false else if (c == '\\') escaped = true else if (c == '"') quoted = false;
+        } else if (c == '"') {
+            quoted = true;
+        } else if (c == '[' or c == '{') {
+            depth += 1;
+            if (c == '{') objects += 1;
+            if (depth > 64 or objects > 32768) return false;
+        } else if (c == ']' or c == '}') {
+            if (depth == 0) return false;
+            depth -= 1;
+        }
+    }
+    return depth == 0 and !quoted;
+}
diff --git a/zig/src/core/runner_frontend_c_cost_print.zig b/zig/src/core/runner_frontend_c_cost_print.zig
new file mode 100644
index 000000000..7a2897c7c
--- /dev/null
+++ b/zig/src/core/runner_frontend_c_cost_print.zig
@@ -0,0 +1,95 @@
+const std = @import("std");
+const m = @import("runner_frontend_c_cost_model.zig");
+const Error = m.Error;
+const Value = m.Value;
+
+pub fn call(p: anytype, name: []const u8, args: []const Value) Error!Value {
+    if (std.mem.eql(u8, name, "putchar")) {
+        if (args.len != 1) return error.Unsupported;
+        _ = try args[0].numeric();
+        try p.charge(20);
+        return .{ .number = .{ .lo = 0, .hi = 255 } };
+    }
+    if (std.mem.eql(u8, name, "puts")) {
+        if (args.len != 1) return error.Unsupported;
+        const s = try terminated(args[0]);
+        try p.charge(24 + (s.len + 1) * 16);
+        return Value.integer(0);
+    }
+    if (std.mem.eql(u8, name, "tf_print_int")) {
+        if (args.len != 1) return error.Unsupported;
+        _ = try decimal(p, args[0], false, false);
+        try p.charge(20);
+        return Value.integer(0);
+    }
+    if (!std.mem.eql(u8, name, "printf") or args.len == 0) return error.Unsupported;
+    const format = args[0].text orelse return error.Unsupported;
+    var i: usize = 0;
+    var argument: usize = 1;
+    var bytes: usize = 0;
+    try p.charge(32);
+    while (i < format.len) : (i += 1) {
+        if (format[i] != '%') {
+            try p.charge(16);
+            bytes += 1;
+            continue;
+        }
+        i += 1;
+        if (i >= format.len) return error.Unsupported;
+        if (format[i] == '%') {
+            try p.charge(20);
+            bytes += 1;
+            continue;
+        }
+        var wide = false;
+        if (i + 1 < format.len and format[i] == 'l' and format[i + 1] == 'l') {
+            wide = true;
+            i += 2;
+        }
+        if (i >= format.len or argument >= args.len) return error.Unsupported;
+        const value = args[argument];
+        argument += 1;
+        try p.charge(16);
+        switch (format[i]) {
+            'u', 'i', 'd' => bytes += try decimal(p, value, format[i] == 'u', wide),
+            'c' => {
+                if (wide) return error.Unsupported;
+                _ = try value.numeric();
+                bytes += 1;
+                try p.charge(20);
+            },
+            's' => {
+                if (wide) return error.Unsupported;
+                const s = try terminated(value);
+                bytes += s.len;
+                try p.charge(20 + s.len * 16);
+            },
+            else => return error.Unsupported,
+        }
+    }
+    if (argument != args.len) return error.Unsupported;
+    return .{ .number = .{ .lo = 0, .hi = @intCast(bytes) } };
+}
+
+fn terminated(v: Value) Error![]const u8 {
+    if (v.text) |s| return s;
+    if (v.array) |a| if (a.text) |s| return s;
+    return error.Unsupported;
+}
+
+fn decimal(p: anytype, value: Value, unsigned: bool, wide: bool) Error!usize {
+    const r = try value.numeric();
+    const t: m.Type = .{ .bits = if (wide) 64 else 32, .signed = !unsigned };
+    if (!t.fits(r)) return error.Unsupported;
+    var n = @max(@abs(r.lo), @abs(r.hi));
+    const big = n > std.math.maxInt(u32);
+    var digits: usize = 1;
+    while (n >= 10) : (n /= 10) digits += 1;
+    try p.charge(40 + digits * 28);
+    if (wide) {
+        try p.charge(12);
+        if (big) try p.charge(digits * 64 * 24);
+    }
+    if (r.lo < 0) try p.charge(24);
+    return digits + @intFromBool(r.lo < 0);
+}
diff --git a/zig/src/core/runner_frontend_c_cost_test.zig b/zig/src/core/runner_frontend_c_cost_test.zig
new file mode 100644
index 000000000..a99e08bde
--- /dev/null
+++ b/zig/src/core/runner_frontend_c_cost_test.zig
@@ -0,0 +1,341 @@
+const std = @import("std");
+const cost = @import("runner_frontend_c_cost.zig");
+const t = std.testing;
+const budget = 10_522;
+const Node = struct {
+    kind: ?[]const u8 = null,
+    id: []const u8 = "",
+    name: []const u8 = "",
+    type: struct { qualType: []const u8 = "" } = .{},
+    loc: struct { offset: usize = 100 } = .{},
+    inner: []const Node = &.{},
+    opcode: []const u8 = "",
+    value: ?[]const u8 = null,
+    referencedDecl: ?struct { id: []const u8, kind: []const u8, name: []const u8 } = null,
+};
+
+const Fixture = struct {
+    a: std.mem.Allocator,
+
+    fn node(f: Fixture, kind: []const u8, typ: []const u8, inner: []const Node) !Node {
+        return .{ .kind = kind, .type = .{ .qualType = typ }, .inner = try f.a.dupe(Node, inner) };
+    }
+    fn number(f: Fixture, n: i128, typ: []const u8) !Node {
+        var out = try f.node("IntegerLiteral", typ, &.{});
+        out.value = try std.fmt.allocPrint(f.a, "{d}", .{n});
+        return out;
+    }
+    fn reference(id: []const u8, typ: []const u8) Node {
+        return .{
+            .kind = "DeclRefExpr",
+            .type = .{ .qualType = typ },
+            .referencedDecl = .{ .id = id, .kind = "VarDecl", .name = id },
+        };
+    }
+    fn binary(f: Fixture, op: []const u8, typ: []const u8, x: Node, y: Node) !Node {
+        var out = try f.node("BinaryOperator", typ, &.{ x, y });
+        out.opcode = op;
+        return out;
+    }
+    fn variable(f: Fixture, id: []const u8, typ: []const u8, init: ?Node) !Node {
+        var out = try f.node("VarDecl", typ, if (init) |n| &.{n} else &.{});
+        out.id = id;
+        out.name = id;
+        return out;
+    }
+    fn declare(f: Fixture, id: []const u8, typ: []const u8, init: ?Node) !Node {
+        return f.node("DeclStmt", "", &.{try f.variable(id, typ, init)});
+    }
+    fn unary(f: Fixture, op: []const u8, typ: []const u8, child: Node) !Node {
+        var out = try f.node("UnaryOperator", typ, &.{child});
+        out.opcode = op;
+        return out;
+    }
+    fn block(f: Fixture, nodes: []const Node) !Node {
+        return f.node("CompoundStmt", "", nodes);
+    }
+    fn ret(f: Fixture, n: Node) !Node {
+        return f.node("ReturnStmt", "", &.{n});
+    }
+    fn function(f: Fixture, name: []const u8, params: []const Node, body: []const Node) !Node {
+        var inner: std.ArrayList(Node) = .empty;
+        try inner.appendSlice(f.a, params);
+        try inner.append(f.a, try f.block(body));
+        var out = try f.node("FunctionDecl", "int (void)", inner.items);
+        out.id = name;
+        out.name = name;
+        return out;
+    }
+    fn call(f: Fixture, name: []const u8, typ: []const u8, args: []const Node) !Node {
+        var inner: std.ArrayList(Node) = .empty;
+        try inner.append(f.a, .{
+            .kind = "DeclRefExpr",
+            .referencedDecl = .{ .id = name, .kind = "FunctionDecl", .name = name },
+        });
+        try inner.appendSlice(f.a, args);
+        return f.node("CallExpr", typ, inner.items);
+    }
+    fn string(f: Fixture, value: []const u8) !Node {
+        var out = try f.node("StringLiteral", "char[128]", &.{});
+        out.value = value;
+        return out;
+    }
+    fn counted(f: Fixture, id: []const u8, typ: []const u8, start: i128, stop: Node, body: []const Node) !Node {
+        return f.node("ForStmt", "", &.{
+            try f.declare(id, typ, try f.number(start, typ)),
+            .{},
+            try f.binary("<", "int", reference(id, typ), stop),
+            try f.unary("++", typ, reference(id, typ)),
+            try f.block(body),
+        });
+    }
+    fn estimate(f: Fixture, functions: []const Node, body: []const Node, limit: usize) !?usize {
+        var top: std.ArrayList(Node) = .empty;
+        for ([_][]const u8{ "printf", "puts", "putchar", "tf_print_int" }) |name| {
+            try top.append(f.a, .{ .kind = "FunctionDecl", .id = name, .name = name, .loc = .{ .offset = 1 } });
+        }
+        try top.appendSlice(f.a, functions);
+        try top.append(f.a, try f.function("main", &.{}, body));
+        const root = try f.node("TranslationUnitDecl", "", top.items);
+        const json = try std.json.Stringify.valueAlloc(f.a, root, .{});
+        return cost.estimate(t.allocator, json, 100, limit);
+    }
+};
+
+test "C cost admission includes startup and saturates at the caller limit" {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const f: Fixture = .{ .a = arena.allocator() };
+    const body = [_]Node{try f.ret(try f.number(0, "int"))};
+    const steps = (try f.estimate(&.{}, &body, budget)).?;
+    try t.expect(steps >= 200);
+    try t.expectEqual(@as(?usize, steps), try f.estimate(&.{}, &body, steps));
+    try t.expectEqual(@as(?usize, null), try f.estimate(&.{}, &body, steps - 1));
+    try t.expectEqual(@as(?usize, null), try cost.estimate(t.allocator, "{", 0, budget));
+    try t.expectEqual(@as(?usize, null), try cost.estimate(t.allocator, "{}", 0, budget));
+}
+
+test "counted arithmetic admits a small loop and refuses huge counts before expansion" {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const f: Fixture = .{ .a = arena.allocator() };
+    const sum = Fixture.reference("sum", "int");
+    const i = Fixture.reference("i", "int");
+    const update = try f.binary("=", "int", sum, try f.binary("+", "int", sum, try f.binary("*", "int", i, i)));
+    for ([_]i128{ 10, 1_000_000_000 }) |n| {
+        const body = [_]Node{
+            try f.declare("sum", "int", try f.number(0, "int")),
+            try f.counted("i", "int", 0, try f.number(n, "int"), &.{update}),
+            try f.call("tf_print_int", "void", &.{sum}),
+        };
+        const steps = try f.estimate(&.{}, &body, budget);
+        try t.expect((steps != null) == (n == 10));
+    }
+}
+
+test "body mutation of invariant bounds and unsigned induction wrap abstain" {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const f: Fixture = .{ .a = arena.allocator() };
+    const bound = Fixture.reference("n", "int");
+    const mutation = try f.unary("++", "int", bound);
+    try t.expectEqual(@as(?usize, null), try f.estimate(&.{}, &.{
+        try f.declare("n", "int", try f.number(3, "int")),
+        try f.counted("i", "int", 0, bound, &.{mutation}),
+    }, budget));
+    const i = Fixture.reference("i", "unsigned int");
+    const loop = try f.node("ForStmt", "", &.{
+        try f.declare("i", "unsigned int", try f.number(std.math.maxInt(u32), "unsigned int")),
+        .{},
+        try f.binary("<=", "int", i, try f.number(std.math.maxInt(u32), "unsigned int")),
+        try f.unary("++", "unsigned int", i),
+        try f.block(&.{}),
+    });
+    try t.expectEqual(@as(?usize, null), try f.estimate(&.{}, &.{loop}, budget));
+}
+
+test "acyclic calls are charged and reachable recursion abstains" {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const f: Fixture = .{ .a = arena.allocator() };
+    const recursive = try f.function("recur", &.{}, &.{try f.ret(try f.call("recur", "int", &.{}))});
+    try t.expectEqual(@as(?usize, null), try f.estimate(&.{recursive}, &.{try f.call("recur", "int", &.{})}, budget));
+    const leaf = try f.function("leaf", &.{}, &.{try f.ret(try f.number(7, "int"))});
+    try t.expect((try f.estimate(&.{leaf}, &.{try f.call("leaf", "int", &.{})}, budget)) != null);
+}
+
+test "uncertain branches charge the larger path and include expensive alternatives" {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const f: Fixture = .{ .a = arena.allocator() };
+    const light = try f.counted("i", "int", 0, try f.number(180, "int"), &.{});
+    const heavy = try f.counted("i", "int", 0, try f.number(200, "int"), &.{});
+    const base = (try f.estimate(&.{}, &.{heavy}, budget)).?;
+    const flags = try f.declare("flags", "int[2]", try f.node("InitListExpr", "int[2]", &.{
