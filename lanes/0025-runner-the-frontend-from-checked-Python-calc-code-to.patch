--- /dev/null
+++ b/zig/src/core/runner_frontend_python_eval.zig
@@ -0,0 +1,567 @@
+const std = @import("std");
+const ast = @import("runner_frontend_python_ast.zig");
+const Error = ast.Error;
+const Scalar = struct { n: i64 = 0, boolean: bool = false };
+const List = struct { items: [128]Scalar = undefined, len: usize = 0 };
+const Value = union(enum) { scalar: Scalar, list: *List };
+const Frame = struct {
+    scope: *ast.Scope,
+    function: ?usize = null,
+    values: [64]Value = undefined,
+    defined: [64]bool = @splat(false),
+};
+const Binding = struct { name: []const u8, value: Scalar = .{}, parent: ?*const Binding = null };
+const Range = struct { start: i64 = 0, stop: i64, step: i64 = 1 };
+
+pub fn prove(p: *ast.Program) Error!void {
+    p.estimated_steps = 0;
+    if (p.functions.items.len > 32) return error.Unsupported;
+    try infer(p, &p.globals, p.body);
+    for (p.functions.items) |*f| {
+        if (p.globals.find(f.name) != null) return error.Unsupported;
+        for (f.params) |name| {
+            const id = f.scope.find(name) orelse return error.Unsupported;
+            f.scope.symbols.items[id].kind = .scalar;
+        }
+        try inferGeneratorParams(p, f, f.body);
+        try infer(p, &f.scope, f.body);
+        for (f.scope.symbols.items) |s| if (p.functionId(s.name) != null) return error.Unsupported;
+    }
+    var v: Validator = .{ .p = p };
+    try v.block(&p.globals, null, p.body);
+    for (p.functions.items, 0..) |*f, id| try v.block(&f.scope, id, f.body);
+    for (p.functions.items, 0..) |_, id| try v.acyclic(id, 0);
+    var globals: Frame = .{ .scope = &p.globals };
+    var r: Runtime = .{ .p = p, .globals = &globals };
+    if (try r.block(&globals, p.body) != null) return error.Unsupported;
+    p.estimated_steps = r.estimated_steps;
+}
+
+fn inferGeneratorParams(p: *ast.Program, f: *ast.Function, body: []const ast.Stmt) Error!void {
+    for (body) |s| {
+        switch (s.tag) {
+            .assign, .ret, .assertion, .conditional, .loop, .each => try generatorParams(p, f, s.expr),
+            else => {},
+        }
+        try inferGeneratorParams(p, f, s.body);
+        try inferGeneratorParams(p, f, s.otherwise);
+    }
+}
+
+fn generatorParams(p: *ast.Program, f: *ast.Function, id: usize) Error!void {
+    const e = p.nodes.items[id];
+    if (e.tag == .sum_filtered and p.nodes.items[e.rhs].tag == .name) {
+        const name = p.nodes.items[e.rhs].text;
+        for (f.params) |param| if (std.mem.eql(u8, param, name)) {
+            f.scope.symbols.items[f.scope.find(param).?].kind = .list;
+        };
+    }
+    switch (e.tag) {
+        .integer, .boolean, .name, .string => {},
+        .format, .list, .call => for (e.args) |arg| try generatorParams(p, f, arg),
+        .neg, .logical_not, .reverse_digits => try generatorParams(p, f, e.lhs),
+        else => {
+            try generatorParams(p, f, e.lhs);
+            try generatorParams(p, f, e.rhs);
+            if (e.filter) |filter| try generatorParams(p, f, filter);
+        },
+    }
+}
+
+fn infer(p: *ast.Program, scope: *ast.Scope, body: []const ast.Stmt) Error!void {
+    for (body) |s| {
+        if (s.tag == .assign or s.tag == .each) {
+            const id = scope.find(s.name) orelse return error.Unsupported;
+            const kind: ast.Kind = if (s.tag == .assign and p.nodes.items[s.expr].tag == .list) .list else .scalar;
+            const previous = scope.symbols.items[id].kind;
+            if (previous != .unknown and previous != kind) return error.Unsupported;
+            scope.symbols.items[id].kind = kind;
+        }
+        if (s.tag != .function) {
+            try infer(p, scope, s.body);
+            try infer(p, scope, s.otherwise);
+        }
+    }
+}
+
+const Validator = struct {
+    p: *ast.Program,
+    edges: [32]u32 = @splat(0),
+    checked: u32 = 0,
+    depth: usize = 0,
+
+    fn symbol(v: *Validator, scope: *ast.Scope, name: []const u8, gen: ?*const Binding) Error!ast.Kind {
+        var binding = gen;
+        while (binding) |g| : (binding = g.parent) if (std.mem.eql(u8, g.name, name)) return .scalar;
+        if (scope.find(name)) |id| {
+            const kind = scope.symbols.items[id].kind;
+            if (kind == .unknown) return error.Unsupported;
+            return kind;
+        }
+        if (scope != &v.p.globals) if (v.p.globals.find(name)) |id| {
+            const kind = v.p.globals.symbols.items[id].kind;
+            if (kind != .scalar) return error.Unsupported;
+            return kind;
+        };
+        return error.Unsupported;
+    }
+
+    fn expr(v: *Validator, scope: *ast.Scope, fun: ?usize, id: usize, gen: ?*const Binding) Error!ast.Kind {
+        if (v.depth >= 64) return error.Unsupported;
+        v.depth += 1;
+        defer v.depth -= 1;
+        const e = v.p.nodes.items[id];
+        switch (e.tag) {
+            .integer, .boolean => return .scalar,
+            .name => return v.symbol(scope, e.text, gen),
+            .string, .format => return error.Unsupported,
+            .list => {
+                if (e.args.len > 128) return error.Unsupported;
+                for (e.args) |arg| try v.scalar(scope, fun, arg, gen);
+                return .list;
+            },
+            .index => {
+                if (try v.expr(scope, fun, e.lhs, gen) != .list) return error.Unsupported;
+                try v.scalar(scope, fun, e.rhs, gen);
+                return .scalar;
+            },
+            .neg, .logical_not, .reverse_digits => try v.scalar(scope, fun, e.lhs, gen),
+            .call => {
+                if (std.mem.eql(u8, e.text, "len") or std.mem.eql(u8, e.text, "sum")) {
+                    if (e.args.len != 1 or try v.expr(scope, fun, e.args[0], gen) != .list)
+                        return error.Unsupported;
+                } else if (std.mem.eql(u8, e.text, "gcd")) {
+                    if (!v.p.gcd_imported or e.args.len != 2) return error.Unsupported;
+                    for (e.args) |arg| try v.scalar(scope, fun, arg, gen);
+                } else {
+                    const callee = v.p.functionId(e.text) orelse return error.Unsupported;
+                    if (e.args.len != v.p.functions.items[callee].params.len) return error.Unsupported;
+                    if (fun) |caller| v.edges[caller] |= @as(u32, 1) << @intCast(callee);
+                    const f = &v.p.functions.items[callee];
+                    for (e.args, f.params) |arg, param| {
+                        if (try v.expr(scope, fun, arg, gen) != f.scope.symbols.items[f.scope.find(param).?].kind)
+                            return error.Unsupported;
+                    }
+                }
+            },
+            .sum_filtered => {
+                if (!ast.validName(e.text) or v.p.functionId(e.text) != null) return error.Unsupported;
+                const seq = v.p.nodes.items[e.rhs];
+                if (seq.tag == .call and std.mem.eql(u8, seq.text, "range")) {
+                    try v.range(scope, fun, e.rhs, gen);
+                } else if (try v.expr(scope, fun, e.rhs, gen) != .list) return error.Unsupported;
+                const local: Binding = .{ .name = e.text, .parent = gen };
+                if (e.filter) |filter| try v.scalar(scope, fun, filter, &local);
+                try v.scalar(scope, fun, e.lhs, &local);
+            },
+            .all_range => {
+                if (!ast.validName(e.text) or v.p.functionId(e.text) != null) return error.Unsupported;
+                try v.range(scope, fun, e.rhs, gen);
+                const local: Binding = .{ .name = e.text, .parent = gen };
+                try v.scalar(scope, fun, e.lhs, &local);
+            },
+            else => {
+                try v.scalar(scope, fun, e.lhs, gen);
+                try v.scalar(scope, fun, e.rhs, gen);
+            },
+        }
+        return .scalar;
+    }
+
+    fn scalar(v: *Validator, scope: *ast.Scope, fun: ?usize, id: usize, gen: ?*const Binding) Error!void {
+        if (try v.expr(scope, fun, id, gen) != .scalar) return error.Unsupported;
+    }
+
+    fn range(v: *Validator, scope: *ast.Scope, fun: ?usize, id: usize, gen: ?*const Binding) Error!void {
+        const e = v.p.nodes.items[id];
+        if (e.tag != .call or !std.mem.eql(u8, e.text, "range") or e.args.len < 1 or e.args.len > 3)
+            return error.Unsupported;
+        for (e.args) |arg| try v.scalar(scope, fun, arg, gen);
+    }
+
+    fn printed(v: *Validator, scope: *ast.Scope, fun: ?usize, id: usize) Error!void {
+        const e = v.p.nodes.items[id];
+        if (e.tag == .string) return;
+        if (e.tag == .format) {
+            for (e.args) |arg| {
+                if (v.p.nodes.items[arg].tag != .string) try v.scalar(scope, fun, arg, null);
+            }
+        } else try v.scalar(scope, fun, id, null);
+    }
+
+    fn block(v: *Validator, scope: *ast.Scope, fun: ?usize, body: []const ast.Stmt) Error!void {
+        for (body) |s| {
+            switch (s.tag) {
+                .assign => {
+                    const id = scope.find(s.name) orelse return error.Unsupported;
+                    if (try v.expr(scope, fun, s.expr, null) != scope.symbols.items[id].kind)
+                        return error.Unsupported;
+                    if (scope.symbols.items[id].kind == .list and v.p.nodes.items[s.expr].tag != .list)
+                        return error.Unsupported;
+                    if (fun) |function| {
+                        if (scope.symbols.items[id].kind == .list) {
+                            for (v.p.functions.items[function].params) |param|
+                                if (std.mem.eql(u8, param, s.name)) return error.Unsupported;
+                        }
+                    }
+                },
+                .append => {
+                    if (fun != null or try v.symbol(scope, s.name, null) != .list) return error.Unsupported;
+                    try v.scalar(scope, fun, s.expr, null);
+                },
+                .conditional, .loop, .assertion => try v.scalar(scope, fun, s.expr, null),
+                .each => {
+                    const e = v.p.nodes.items[s.expr];
+                    if (e.tag == .list) {
+                        _ = try v.expr(scope, fun, s.expr, null);
+                    } else try v.range(scope, fun, s.expr, null);
+                },
+                .ret => {
+                    if (fun == null) return error.Unsupported;
+                    try v.scalar(scope, fun, s.expr, null);
+                },
+                .print => {
+                    if (fun != null) return error.Unsupported;
+                    for (s.args) |arg| try v.printed(scope, fun, arg);
+                },
+                .function => {
+                    if (fun != null) return error.Unsupported;
+                },
+                .math_import => if (fun != null) return error.Unsupported,
+                .raise => {},
+            }
+            if (s.tag != .function) {
+                try v.block(scope, fun, s.body);
+                try v.block(scope, fun, s.otherwise);
+            }
+        }
+    }
+
+    fn acyclic(v: *Validator, id: usize, active: u32) Error!void {
+        const bit = @as(u32, 1) << @intCast(id);
+        if (active & bit != 0) return error.Unsupported;
+        if (v.checked & bit != 0) return;
+        for (v.p.functions.items, 0..) |_, next| {
+            if (v.edges[id] & (@as(u32, 1) << @intCast(next)) != 0) try v.acyclic(next, active | bit);
+        }
+        v.checked |= bit;
+    }
+};
+
+const Runtime = struct {
+    p: *ast.Program,
+    globals: *Frame,
+    fuel: usize = 2_000_000,
+    iterations: usize = 0,
+    depth: usize = 0,
+    active: u32 = 0,
+    declared: [32]bool = @splat(false),
+    gcd_imported: bool = false,
+    estimated_steps: usize = 200,
+
+    // The caller applies its policy limit; existing fuel and iteration bounds still contain the proof.
+    fn charge(r: *Runtime, steps: usize) void {
+        r.estimated_steps +|= steps;
+    }
+
+    fn output(r: *Runtime, bytes: usize) void {
+        r.charge(20 +| (bytes *| 10));
+    }
+
+    fn printedScalar(r: *Runtime, value: Scalar) void {
+        if (value.boolean) {
+            r.output(if (value.n == 0) 5 else 4);
+            return;
+        }
+        var magnitude = @abs(value.n);
+        var digits: usize = 1 + @as(usize, @intFromBool(value.n < 0));
+        while (magnitude >= 10) : (magnitude /= 10) digits += 1;
+        r.charge(20);
+        r.output(digits);
+    }
+
+    fn tick(r: *Runtime) Error!void {
+        if (r.iterations >= 10_000) return error.Unsupported;
+        r.iterations += 1;
+        r.charge(20);
+    }
+
+    fn get(r: *Runtime, frame: *Frame, name: []const u8, gen: ?*const Binding) Error!Value {
+        var binding = gen;
+        while (binding) |g| : (binding = g.parent) if (std.mem.eql(u8, g.name, name))
+            return .{ .scalar = g.value };
+        if (frame.scope.find(name)) |id| {
+            if (!frame.defined[id]) return error.Unsupported;
+            return frame.values[id];
+        }
+        if (frame != r.globals) return r.get(r.globals, name, null);
+        return error.Unsupported;
+    }
+
+    fn put(frame: *Frame, name: []const u8, value: Value) Error!void {
+        const id = frame.scope.find(name) orelse return error.Unsupported;
+        frame.values[id] = value;
+        frame.defined[id] = true;
+    }
+
+    fn scalar(r: *Runtime, frame: *Frame, id: usize, gen: ?*const Binding) Error!Scalar {
+        return switch (try r.expr(frame, id, gen)) {
+            .scalar => |s| s,
+            else => error.Unsupported,
+        };
+    }
+
+    fn list(r: *Runtime, frame: *Frame, id: usize, gen: ?*const Binding) Error!*List {
+        return switch (try r.expr(frame, id, gen)) {
+            .list => |l| l,
+            else => error.Unsupported,
+        };
+    }
+
+    fn expr(r: *Runtime, frame: *Frame, id: usize, gen: ?*const Binding) Error!Value {
+        if (r.fuel == 0) return error.Unsupported;
+        r.fuel -= 1;
+        r.charge(10);
+        const e = r.p.nodes.items[id];
+        switch (e.tag) {
+            .integer, .boolean => return .{ .scalar = try number(e.value, e.tag == .boolean) },
+            .name => return r.get(frame, e.text, gen),
+            .string, .format => return error.Unsupported,
+            .list => {
+                const l = try r.p.a.create(List);
+                l.* = .{};
+                r.charge(4 + e.args.len * 6);
+                for (e.args) |arg| {
+                    if (l.len >= 128) return error.Unsupported;
+                    l.items[l.len] = try r.scalar(frame, arg, gen);
+                    l.len += 1;
+                }
+                return .{ .list = l };
+            },
+            .index => {
+                const l = try r.list(frame, e.lhs, gen);
+                var i = (try r.scalar(frame, e.rhs, gen)).n;
+                if (i < 0) i += @intCast(l.len);
+                if (i < 0 or i >= @as(i64, @intCast(l.len))) return error.Unsupported;
+                r.charge(6);
+                return .{ .scalar = l.items[@intCast(i)] };
+            },
+            .call => return .{ .scalar = try r.call(frame, e, gen) },
+            .sum_filtered => return .{ .scalar = try r.sumFiltered(frame, e, gen) },
+            .all_range => {
+                const bounds = try r.range(frame, e.rhs, gen);
+                var i = bounds.start;
+                while (if (bounds.step > 0) i < bounds.stop else i > bounds.stop) : (i += bounds.step) {
+                    try r.tick();
+                    const local: Binding = .{ .name = e.text, .value = try number(i, false), .parent = gen };
+                    if ((try r.scalar(frame, e.lhs, &local)).n == 0)
+                        return .{ .scalar = try number(0, true) };
+                }
+                return .{ .scalar = try number(1, true) };
+            },
+            else => {},
+        }
+        const x = try r.scalar(frame, e.lhs, gen);
+        if (e.tag == .reverse_digits) {
+            if (x.boolean or x.n < 0) return error.Unsupported;
+            r.charge(20);
+            var remaining = x.n;
+            var reversed: i64 = 0;
+            while (remaining != 0) : (remaining = @divTrunc(remaining, 10)) {
+                r.charge(40);
+                reversed = (try number(reversed * 10 + @mod(remaining, 10), false)).n;
+            }
+            return .{ .scalar = try number(reversed, false) };
+        }
+        if (e.tag == .neg) return .{ .scalar = try number(-x.n, false) };
+        if (e.tag == .logical_not) return .{ .scalar = try number(@intFromBool(x.n == 0), true) };
+        if (e.tag == .logical_and and x.n == 0) return .{ .scalar = x };
+        if (e.tag == .logical_or and x.n != 0) return .{ .scalar = x };
+        const y = try r.scalar(frame, e.rhs, gen);
+        const result: Scalar = switch (e.tag) {
+            .add => try number(x.n + y.n, false),
+            .sub => try number(x.n - y.n, false),
+            .mul => try number(x.n * y.n, false),
+            .floor, .modulo => blk: {
+                r.charge(8);
+                if (y.n == 0 or (x.n == std.math.minInt(i32) and y.n == -1)) return error.Unsupported;
+                const quotient = @divFloor(x.n, y.n);
+                break :blk try number(if (e.tag == .floor) quotient else x.n - quotient * y.n, false);
+            },
+            .eq => try number(@intFromBool(x.n == y.n), true),
+            .ne => try number(@intFromBool(x.n != y.n), true),
+            .lt => try number(@intFromBool(x.n < y.n), true),
+            .le => try number(@intFromBool(x.n <= y.n), true),
+            .gt => try number(@intFromBool(x.n > y.n), true),
+            .ge => try number(@intFromBool(x.n >= y.n), true),
+            .logical_and, .logical_or => y,
+            else => return error.Unsupported,
+        };
+        return .{ .scalar = result };
+    }
+
+    fn sumFiltered(r: *Runtime, frame: *Frame, e: ast.Expr, gen: ?*const Binding) Error!Scalar {
+        r.charge(20);
+        const seq = r.p.nodes.items[e.rhs];
+        const is_range = seq.tag == .call and std.mem.eql(u8, seq.text, "range");
+        const l = if (is_range) null else try r.list(frame, e.rhs, gen);
+        if (seq.tag == .list) r.charge(128 * 6);
+        const bounds = if (is_range) try r.range(frame, e.rhs, gen) else Range{ .stop = @intCast(l.?.len) };
+        var sum: i64 = 0;
+        var i = bounds.start;
+        while (if (bounds.step > 0) i < bounds.stop else i > bounds.stop) : (i += bounds.step) {
+            try r.tick();
+            const value = if (l) |items| items.items[@intCast(i)] else try number(i, false);
+            const local: Binding = .{ .name = e.text, .value = value, .parent = gen };
+            if (e.filter) |filter| if ((try r.scalar(frame, filter, &local)).n == 0) continue;
+            r.charge(12);
+            sum = (try number(sum + (try r.scalar(frame, e.lhs, &local)).n, false)).n;
+        }
+        return number(sum, false);
+    }
+
+    fn range(r: *Runtime, frame: *Frame, id: usize, gen: ?*const Binding) Error!Range {
+        r.charge(20);
+        const e = r.p.nodes.items[id];
+        if (e.tag != .call or !std.mem.eql(u8, e.text, "range") or e.args.len < 1 or e.args.len > 3)
+            return error.Unsupported;
+        var args: [3]i64 = .{ 0, 0, 1 };
+        for (e.args, 0..) |arg, i| args[i] = (try r.scalar(frame, arg, gen)).n;
+        const result: Range = if (e.args.len == 1) .{ .stop = args[0] } else .{ .start = args[0], .stop = args[1], .step = if (e.args.len == 3) args[2] else 1 };
+        if (result.step == 0) return error.Unsupported;
+        return result;
+    }
+
+    fn call(r: *Runtime, frame: *Frame, e: ast.Expr, gen: ?*const Binding) Error!Scalar {
+        r.charge(20);
+        if (std.mem.eql(u8, e.text, "len")) return number(@intCast((try r.list(frame, e.args[0], gen)).len), false);
+        if (std.mem.eql(u8, e.text, "sum")) {
+            const l = try r.list(frame, e.args[0], gen);
+            var sum: i64 = 0;
+            for (l.items[0..l.len]) |item| {
+                r.charge(12);
+                sum = (try number(sum + item.n, false)).n;
+            }
+            return number(sum, false);
+        }
+        if (std.mem.eql(u8, e.text, "gcd")) {
+            if (!r.gcd_imported) return error.Unsupported;
+            const x = (try r.scalar(frame, e.args[0], gen)).n;
+            const y = (try r.scalar(frame, e.args[1], gen)).n;
+            if (x == std.math.minInt(i32) or y == std.math.minInt(i32)) return error.Unsupported;
+            var a = if (x < 0) -x else x;
+            var b = if (y < 0) -y else y;
+            while (b != 0) {
+                try r.tick();
+                r.charge(10);
+                const rem = @mod(a, b);
+                a = b;
+                b = rem;
+            }
+            return number(a, false);
+        }
+        const id = r.p.functionId(e.text) orelse return error.Unsupported;
+        const mask = @as(u32, 1) << @intCast(id);
+        if (!r.declared[id] or r.depth >= 8 or r.active & mask != 0) return error.Unsupported;
+        const f = &r.p.functions.items[id];
+        var local: Frame = .{ .scope = &f.scope, .function = id };
+        for (f.params, e.args) |param, arg| {
+            if (r.p.nodes.items[arg].tag == .list) r.charge(128 * 6);
+            try put(&local, param, try r.expr(frame, arg, gen));
+        }
+        r.depth += 1;
+        r.active |= mask;
+        defer {
+            r.depth -= 1;
+            r.active &= ~mask;
+        }
+        return try r.block(&local, f.body) orelse error.Unsupported;
+    }
+
+    fn printed(r: *Runtime, frame: *Frame, id: usize) Error!void {
+        const e = r.p.nodes.items[id];
+        if (e.tag == .string) {
+            r.charge(10);
+            r.output(e.text.len);
+            return;
+        }
+        if (e.tag == .format) {
+            r.charge(10);
+            for (e.args) |arg| try r.printed(frame, arg);
+        } else r.printedScalar(try r.scalar(frame, id, null));
+    }
+
+    fn block(r: *Runtime, frame: *Frame, body: []const ast.Stmt) Error!?Scalar {
+        for (body) |s| {
+            if (s.tag != .function and s.tag != .math_import) r.charge(4);
+            switch (s.tag) {
+                .assign => {
+                    const value = try r.expr(frame, s.expr, null);
+                    if (value == .list) r.charge(4 + value.list.len * 10);
+                    try put(frame, s.name, value);
+                },
+                .append => {
+                    const l = switch (try r.get(frame, s.name, null)) {
+                        .list => |l| l,
+                        else => return error.Unsupported,
+                    };
+                    const value = try r.scalar(frame, s.expr, null);
+                    if (l.len >= 128) return error.Unsupported;
+                    r.charge(12);
+                    l.items[l.len] = value;
+                    l.len += 1;
+                },
+                .conditional => {
+                    const branch = if ((try r.scalar(frame, s.expr, null)).n != 0) s.body else s.otherwise;
+                    if (try r.block(frame, branch)) |value| return value;
+                },
+                .loop => {
+                    while ((try r.scalar(frame, s.expr, null)).n != 0) {
+                        try r.tick();
+                        if (try r.block(frame, s.body)) |value| return value;
+                    }
+                },
+                .each => {
+                    const e = r.p.nodes.items[s.expr];
+                    if (e.tag == .list) {
+                        const l = try r.list(frame, s.expr, null);
+                        for (l.items[0..l.len]) |item| {
+                            try r.tick();
+                            try put(frame, s.name, .{ .scalar = item });
+                            if (try r.block(frame, s.body)) |value| return value;
+                        }
+                    } else {
+                        const bounds = try r.range(frame, s.expr, null);
+                        var i = bounds.start;
+                        while (if (bounds.step > 0) i < bounds.stop else i > bounds.stop) : (i += bounds.step) {
+                            try r.tick();
+                            try put(frame, s.name, .{ .scalar = try number(i, false) });
+                            if (try r.block(frame, s.body)) |value| return value;
+                        }
+                    }
+                },
+                .function => r.declared[s.function] = true,
+                .ret => return try r.scalar(frame, s.expr, null),
+                .print => {
+                    for (s.args, 0..) |arg, i| {
+                        if (i != 0) r.output(1);
+                        try r.printed(frame, arg);
+                    }
+                    r.output(1);
+                },
+                .assertion => {
+                    r.charge(4);
+                    if ((try r.scalar(frame, s.expr, null)).n == 0) return error.Unsupported;
+                },
+                .raise => return error.Unsupported,
+                .math_import => r.gcd_imported = true,
+            }
+        }
+        return null;
+    }
+};
+
+fn number(n: i64, boolean: bool) Error!Scalar {
+    if (n < std.math.minInt(i32) or n > std.math.maxInt(i32)) return error.Unsupported;
+    return .{ .n = n, .boolean = boolean };
+}
diff --git a/zig/src/core/runner_frontend_python_expr.zig b/zig/src/core/runner_frontend_python_expr.zig
new file mode 100644
index 000000000..aa6112fac
--- /dev/null
+++ b/zig/src/core/runner_frontend_python_expr.zig
@@ -0,0 +1,360 @@
+const std = @import("std");
+const ast = @import("runner_frontend_python_ast.zig");
+
+pub fn parse(program: *ast.Program, source: []const u8) ast.Error!usize {
+    if (!std.unicode.utf8ValidateSlice(source)) return error.Unsupported;
+    var p: Parser = .{ .program = program, .source = source };
+    const root = try p.expression();
+    try p.end();
+    try boundedDepth(program, root, 0);
+    return root;
+}
+
+pub fn parseArgs(program: *ast.Program, source: []const u8) ast.Error![]const usize {
+    if (!std.unicode.utf8ValidateSlice(source)) return error.Unsupported;
+    var p: Parser = .{ .program = program, .source = source };
+    var args: std.ArrayList(usize) = .empty;
+    p.space();
+    if (p.pos == p.source.len) return &.{};
+    while (true) {
+        if (args.items.len >= 128) return error.Unsupported;
+        const root = try p.expression();
+        try boundedDepth(program, root, 0);
+        try args.append(program.a, root);
+        if (!p.eat(",")) break;
+        p.space();
+        if (p.pos == p.source.len) break;
+    }
+    try p.end();
+    return args.toOwnedSlice(program.a);
+}
+
+const Parser = struct {
+    program: *ast.Program,
+    source: []const u8,
+    pos: usize = 0,
+    depth: usize = 0,
+
+    fn space(p: *Parser) void {
+        while (p.pos < p.source.len and p.source[p.pos] == ' ') p.pos += 1;
+    }
+
+    fn eat(p: *Parser, token: []const u8) bool {
+        p.space();
+        if (!std.mem.startsWith(u8, p.source[p.pos..], token)) return false;
+        const end_pos = p.pos + token.len;
+        if (nameChar(token[token.len - 1]) and end_pos < p.source.len and nameChar(p.source[end_pos])) return false;
+        p.pos = end_pos;
+        return true;
+    }
+
+    fn need(p: *Parser, token: []const u8) ast.Invalid!void {
+        if (!p.eat(token)) return error.Unsupported;
+    }
+
+    fn end(p: *Parser) ast.Invalid!void {
+        p.space();
+        if (p.pos != p.source.len) return error.Unsupported;
+    }
+
+    fn identifier(p: *Parser) ast.Invalid![]const u8 {
+        p.space();
+        const start = p.pos;
+        if (start == p.source.len or !(std.ascii.isAlphabetic(p.source[start]) or p.source[start] == '_'))
+            return error.Unsupported;
+        p.pos += 1;
+        while (p.pos < p.source.len and nameChar(p.source[p.pos])) p.pos += 1;
+        return p.source[start..p.pos];
+    }
+
+    fn expression(p: *Parser) ast.Error!usize {
+        if (p.depth >= 8) return error.Unsupported;
+        p.depth += 1;
+        defer p.depth -= 1;
+        var root = try p.conjunction();
+        while (p.eat("or")) root = try p.binary(.logical_or, root, try p.conjunction());
+        return root;
+    }
+
+    fn conjunction(p: *Parser) ast.Error!usize {
+        var root = try p.inversion();
+        while (p.eat("and")) root = try p.binary(.logical_and, root, try p.inversion());
+        return root;
+    }
+
+    fn inversion(p: *Parser) ast.Error!usize {
+        if (p.eat("not")) {
+            if (p.depth >= 8) return error.Unsupported;
+            p.depth += 1;
+            defer p.depth -= 1;
+            return p.program.node(.{ .tag = .logical_not, .lhs = try p.inversion() });
+        }
+        var root = try p.additive();
+        const tag: ast.Tag = if (p.eat("==")) .eq else if (p.eat("!=")) .ne else if (p.eat("<=")) .le else if (p.eat(">=")) .ge else if (p.eat("<")) .lt else if (p.eat(">")) .gt else return root;
+        root = try p.binary(tag, root, try p.additive());
+        return root;
+    }
+
+    fn additive(p: *Parser) ast.Error!usize {
+        var root = try p.product();
+        while (true) {
+            const tag: ast.Tag = if (p.eat("+")) .add else if (p.eat("-")) .sub else break;
+            root = try p.binary(tag, root, try p.product());
+        }
+        return root;
+    }
+
+    fn product(p: *Parser) ast.Error!usize {
+        var root = try p.unary();
+        while (true) {
+            const tag: ast.Tag = if (p.eat("//")) .floor else if (p.eat("%")) .modulo else if (p.eat("*")) .mul else break;
+            root = try p.binary(tag, root, try p.unary());
+        }
+        return root;
+    }
+
+    fn unary(p: *Parser) ast.Error!usize {
+        if (p.eat("-")) {
+            if (p.depth >= 8) return error.Unsupported;
+            p.depth += 1;
+            defer p.depth -= 1;
+            return p.program.node(.{ .tag = .neg, .lhs = try p.unary() });
+        }
+        if (p.eat("+")) {
+            if (p.depth >= 8) return error.Unsupported;
+            p.depth += 1;
+            defer p.depth -= 1;
+            const zero = try p.program.node(.{ .tag = .integer });
+            return p.binary(.add, zero, try p.unary());
+        }
+        var root = try p.atom();
+        if (p.eat("[")) {
+            root = try p.program.node(.{ .tag = .index, .lhs = root, .rhs = try p.expression() });
+            try p.need("]");
+        }
+        return root;
+    }
+
+    fn binary(p: *Parser, tag: ast.Tag, lhs: usize, rhs: usize) ast.Error!usize {
+        return p.program.node(.{ .tag = tag, .lhs = lhs, .rhs = rhs });
+    }
+
+    fn atom(p: *Parser) ast.Error!usize {
+        if (p.eat("(")) {
+            const root = try p.expression();
+            try p.need(")");
+            return root;
+        }
+        if (p.eat("[")) return p.sequence();
+        if (p.eat("True")) return p.program.node(.{ .tag = .boolean, .value = 1 });
+        if (p.eat("False")) return p.program.node(.{ .tag = .boolean, .value = 0 });
+        p.space();
+        if (p.pos >= p.source.len) return error.Unsupported;
+        if (p.source[p.pos] == '\'' or p.source[p.pos] == '"') return p.string(false);
+        if (p.source[p.pos] == 'f' and p.pos + 1 < p.source.len and
+            (p.source[p.pos + 1] == '\'' or p.source[p.pos + 1] == '"'))
+        {
+            p.pos += 1;
+            return p.string(true);
+        }
+        if (std.ascii.isDigit(p.source[p.pos])) {
+            const start = p.pos;
+            while (p.pos < p.source.len and std.ascii.isDigit(p.source[p.pos])) p.pos += 1;
+            const text = p.source[start..p.pos];
+            if (text.len > 1 and text[0] == '0') return error.Unsupported;
+            const value = std.fmt.parseInt(i64, text, 10) catch return error.Unsupported;
+            if (value > std.math.maxInt(i32)) return error.Unsupported;
+            return p.program.node(.{ .tag = .integer, .value = value });
+        }
+        const name = try p.identifier();
+        if (p.eat("(")) return p.call(name);
+        if (!ast.validName(name)) return error.Unsupported;
+        return p.program.node(.{ .tag = .name, .text = name });
+    }
+
+    fn sequence(p: *Parser) ast.Error!usize {
+        var args: std.ArrayList(usize) = .empty;
+        if (!p.eat("]")) while (true) {
+            if (args.items.len >= 128) return error.Unsupported;
+            try args.append(p.program.a, try p.expression());
+            if (p.eat("]")) break;
+            try p.need(",");
+            if (p.eat("]")) break;
+        };
+        return p.program.node(.{ .tag = .list, .args = try args.toOwnedSlice(p.program.a) });
+    }
+
+    fn call(p: *Parser, name: []const u8) ast.Error!usize {
+        if (std.mem.eql(u8, name, "int")) {
+            try p.need("str");
+            try p.need("(");
+            const operand = try p.expression();
+            try p.need(")");
+            try p.need("[");
+            try p.need(":");
+            try p.need(":");
+            try p.need("-");
+            try p.need("1");
+            try p.need("]");
+            try p.need(")");
+            return p.program.node(.{ .tag = .reverse_digits, .lhs = operand });
+        }
+        const builtins = [_][]const u8{ "len", "sum", "range", "gcd", "all", "print", "ValueError" };
+        var allowed = ast.validName(name);
+        for (builtins) |builtin| {
+            if (std.mem.eql(u8, name, builtin)) allowed = true;
+        }
+        if (!allowed) return error.Unsupported;
+        var args: std.ArrayList(usize) = .empty;
+        if (!p.eat(")")) while (true) {
+            if (args.items.len >= 128) return error.Unsupported;
+            const arg = try p.expression();
+            if (args.items.len == 0 and (std.mem.eql(u8, name, "all") or std.mem.eql(u8, name, "sum")) and p.eat("for")) {
+                if (p.pos < 4 or p.source[p.pos - 4] != ' ') return error.Unsupported;
+                const variable = try p.identifier();
+                if (!ast.validName(variable)) return error.Unsupported;
+                try p.need("in");
+                const range = try p.expression();
+                const iterable = p.program.nodes.items[range];
+                const all = std.mem.eql(u8, name, "all");
+                if (all and (iterable.tag != .call or !std.mem.eql(u8, iterable.text, "range")))
+                    return error.Unsupported;
+                const filter: ?usize = if (!all and p.eat("if")) try p.expression() else null;
+                try p.need(")");
+                return p.program.node(.{
+                    .tag = if (all) .all_range else .sum_filtered,
+                    .text = variable,
+                    .lhs = arg,
+                    .rhs = range,
+                    .filter = filter,
+                });
+            }
+            try args.append(p.program.a, arg);
+            if (p.eat(")")) break;
+            try p.need(",");
+            if (p.eat(")")) break;
+        };
+        return p.program.node(.{ .tag = .call, .text = name, .args = try args.toOwnedSlice(p.program.a) });
+    }
+
+    fn string(p: *Parser, formatted: bool) ast.Error!usize {
+        const quote = p.source[p.pos];
+        p.pos += 1;
+        var bytes: std.ArrayList(u8) = .empty;
+        var pieces: std.ArrayList(usize) = .empty;
+        while (p.pos < p.source.len) {
+            const c = p.source[p.pos];
+            p.pos += 1;
+            if (c == quote) {
+                if (!formatted) return p.program.node(.{ .tag = .string, .text = try bytes.toOwnedSlice(p.program.a) });
+                try p.flush(&bytes, &pieces);
+                return p.program.node(.{ .tag = .format, .args = try pieces.toOwnedSlice(p.program.a) });
+            }
+            if (c == '\n' or c == '\r' or c == 0) return error.Unsupported;
+            if (c == '\\') {
+                try bytes.append(p.program.a, try p.escape());
+            } else if (formatted and (c == '{' or c == '}')) {
+                if (p.pos < p.source.len and p.source[p.pos] == c) {
+                    p.pos += 1;
+                    try bytes.append(p.program.a, c);
+                } else if (c == '{') {
+                    try p.flush(&bytes, &pieces);
+                    const interpolation = try p.field();
+                    if (p.depth >= 8) return error.Unsupported;
+                    var nested: Parser = .{ .program = p.program, .source = interpolation, .depth = p.depth };
+                    const root = try nested.expression();
+                    try nested.end();
+                    try pieces.append(p.program.a, root);
+                } else return error.Unsupported;
+            } else try bytes.append(p.program.a, c);
+        }
+        return error.Unsupported;
+    }
+
+    fn flush(p: *Parser, bytes: *std.ArrayList(u8), pieces: *std.ArrayList(usize)) ast.Error!void {
+        if (bytes.items.len == 0) return;
+        const text = try bytes.toOwnedSlice(p.program.a);
+        try pieces.append(p.program.a, try p.program.node(.{ .tag = .string, .text = text }));
+    }
+
+    fn escape(p: *Parser) ast.Error!u8 {
+        if (p.pos >= p.source.len) return error.Unsupported;
+        const c = p.source[p.pos];
+        p.pos += 1;
+        return switch (c) {
+            '\\', '\'', '"' => c,
+            'n' => '\n',
+            'r' => '\r',
+            't' => '\t',
+            'b' => 8,
+            'f' => 12,
+            'v' => 11,
+            'a' => 7,
+            'x' => blk: {
+                if (p.pos + 2 > p.source.len) return error.Unsupported;
+                for (p.source[p.pos .. p.pos + 2]) |digit| if (!std.ascii.isHex(digit)) return error.Unsupported;
+                const byte = std.fmt.parseInt(u8, p.source[p.pos .. p.pos + 2], 16) catch return error.Unsupported;
+                if (byte == 0 or byte >= 128) return error.Unsupported;
+                p.pos += 2;
+                break :blk byte;
+            },
+            else => error.Unsupported,
+        };
+    }
+
+    fn field(p: *Parser) ast.Invalid![]const u8 {
+        const start = p.pos;
+        var nesting: usize = 0;
+        var quote: u8 = 0;
+        var escaped = false;
+        while (p.pos < p.source.len) : (p.pos += 1) {
+            const c = p.source[p.pos];
+            if (quote != 0) {
+                if (escaped) escaped = false else if (c == '\\') escaped = true else if (c == quote) quote = 0;
+                continue;
+            }
+            switch (c) {
+                '\'', '"' => quote = c,
+                '(', '[' => {
+                    nesting += 1;
+                    if (nesting > 8) return error.Unsupported;
+                },
+                ')', ']' => {
+                    if (nesting == 0) return error.Unsupported;
+                    nesting -= 1;
+                },
+                '}' => {
+                    if (nesting != 0) return error.Unsupported;
+                    const result = p.source[start..p.pos];
+                    p.pos += 1;
+                    return result;
+                },
+                '{', ':', '\n', '\r' => return error.Unsupported,
+                '!' => {
+                    if (p.pos + 1 >= p.source.len or p.source[p.pos + 1] != '=') return error.Unsupported;
+                },
+                else => {},
+            }
+        }
+        return error.Unsupported;
+    }
+};
+
+fn nameChar(c: u8) bool {
+    return std.ascii.isAlphanumeric(c) or c == '_';
+}
+
+pub fn boundedDepth(program: *const ast.Program, id: usize, depth: usize) ast.Invalid!void {
+    if (depth >= 8) return error.Unsupported;
+    const node = program.nodes.items[id];
+    switch (node.tag) {
+        .integer, .boolean, .name, .string => {},
+        .format, .list, .call => for (node.args) |arg| try boundedDepth(program, arg, depth + 1),
+        .neg, .logical_not, .reverse_digits => try boundedDepth(program, node.lhs, depth + 1),
+        else => {
+            try boundedDepth(program, node.lhs, depth + 1);
+            try boundedDepth(program, node.rhs, depth + 1);
+            if (node.filter) |filter| try boundedDepth(program, filter, depth + 1);
+        },
+    }
+}
diff --git a/zig/src/core/runner_frontend_reference_test.zig b/zig/src/core/runner_frontend_reference_test.zig
new file mode 100644
index 000000000..00816c7e9
--- /dev/null
+++ b/zig/src/core/runner_frontend_reference_test.zig
@@ -0,0 +1,77 @@
+const std = @import("std");
+const api = @import("runner_api.zig");
+const t = std.testing;
+
+const reference =
+    \\import sys
+    \\from pathlib import Path
+    \\root = Path(sys.argv[1])
+    \\sys.path.insert(0, str(root / 'experimental/riscv'))
+    \\from chipformer.rv import calc, elf, ref
+    \\if sys.argv[2] == 'calc':
+    \\    m = calc.machine(sys.argv[3], root / 'experimental/riscv/tests/data/rv/calc.elf')
+    \\else:
+    \\    m = ref.Machine.from_program(elf.program(sys.argv[3]))
+    \\tokens = 1
+    \\while not m.halted and tokens < 4000000:
+    \\    tokens += len(m.record())
+    \\assert tokens <= 4000000, tokens
+    \\assert m.halted and m.fault is None and m.exit_code == 0, (m.halted, m.fault, m.exit_code)
+    \\sys.stdout.buffer.write(bytes(m.out))
+;
+
+pub fn check(root: []const u8, python: []const u8, program: api.Program, expected: []const u8) !void {
+    var tmp = t.tmpDir(.{});
+    defer tmp.cleanup();
+    var path: ?[:0]u8 = null;
+    defer if (path) |p| t.allocator.free(p);
+    var input = program.bytes;
+    if (program.kind == .elf) {
+        const file = try tmp.dir.createFile(t.io, "program.elf", .{});
+        defer file.close(t.io);
+        try file.writeStreamingAll(t.io, program.bytes);
+        path = try tmp.dir.realPathFileAlloc(t.io, "program.elf", t.allocator);
+        input = path.?;
+    }
+    const result = try std.process.run(t.allocator, t.io, .{
+        .argv = &.{ python, "-c", reference, root, @tagName(program.kind), input },
+        .stdout_limit = .limited(4096),
+        .stderr_limit = .limited(16384),
+        .timeout = .{ .duration = .{ .raw = .fromSeconds(10), .clock = .awake } },
+    });
+    defer t.allocator.free(result.stdout);
+    defer t.allocator.free(result.stderr);
+    if (!result.term.success()) {
+        std.debug.print("RV32 reference failed: {s}\n", .{result.stderr});
+        return error.ReferenceFailed;
+    }
+    try t.expectEqualStrings(expected, result.stdout);
+}
+
+test "accepted arithmetic executes in the firmware reference with exact output" {
+    var env = try t.environ.createMap(t.allocator);
+    defer env.deinit();
+    const root = env.get("TF_RUNNER_QWENPUTER") orelse {
+        std.debug.print("SKIP firmware reference: set TF_RUNNER_QWENPUTER to its source checkout\n", .{});
+        return error.SkipZigTest;
+    };
+    var context: @import("runner_frontend.zig").Context = .{ .io = t.io, .exact_tags = true };
+    const frontend = context.frontend();
+    const cases = [_][3][]const u8{
+        .{ "python", "print(123456789012345*987654321098765)", "121932631137021071359549253925\n" },
+        .{ "python", "print(123456789012345678901234567890*987654321098765432109876543210)", "121932631137021795226185032733622923332237463801111263526900\n" },
+        .{ "python", "2**100", "1267650600228229401496703205376\n" },
+        .{ "python", "-7//3", "-3\n" },
+        .{ "python", "-7%3", "2\n" },
+        .{ "exact", "1/3+2/3", "1\n" },
+        .{ "exact", "1.25*2.4", "3\n" },
+        .{ "exact", "123456789012345678901234567890.12345678901234567890123456789012", "123456789012345678901234567890.12345678901234567890123456789012\n" },
+        .{ "exact", "gcd(48,18)", "6\n" },
+    };
+    for (cases) |case| {
+        const result = try frontend.translate(frontend.ctx, t.allocator, .{ .form = .repl, .lang = case[0], .code = case[1] });
+        try t.expect(result == .program);
+        defer t.allocator.free(result.program.bytes);
+        try check(root, env.get("TF_RUNNER_REFERENCE_PYTHON") orelse "/usr/bin/python3", result.program, case[2]);
+    }
+}
diff --git a/zig/src/core/runner_frontend_rvlink.zig b/zig/src/core/runner_frontend_rvlink.zig
new file mode 100644
index 000000000..69a4986c3
--- /dev/null
+++ b/zig/src/core/runner_frontend_rvlink.zig
@@ -0,0 +1,337 @@
+//! In-process link of RV32 objects (runtime, cell body) under compile's linker script; null when unsure (ld.lld then).
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+
+const text_base = 0x40000;
+const text_end = 0x80000;
+const rodata_base = 0x20000;
+const rodata_end = 0x40000;
+const ram_base = 0x100;
+/// The linker script's ASSERT: RAM leaves 4K for the stack.
+const ram_end = 0x7000;
+
+const Kind = enum { text_init, text, rodata, data, bss };
+
+const Input = struct { file: usize, index: usize, kind: Kind, addr: u32 = 0 };
+
+const Object = struct {
+    bytes: []const u8,
+    sections: []const [40]u8,
+    names: []const u8,
+    symtab: ?usize = null,
+    /// Output address of each section, 0 when it is not placed.
+    addrs: []u32,
+};
+
+fn word(comptime T: type, b: []const u8, off: usize) ?T {
+    if (off > b.len or b.len - off < @sizeOf(T)) return null;
+    return std.mem.readInt(T, b[off..][0..@sizeOf(T)], .little);
+}
+
+fn field(sh: [40]u8, comptime i: usize) u32 {
+    return std.mem.readInt(u32, sh[4 * i ..][0..4], .little);
+}
+
+fn cstr(b: []const u8, off: usize) ?[]const u8 {
+    if (off >= b.len) return null;
+    const end = std.mem.indexOfScalarPos(u8, b, off, 0) orelse return null;
+    return b[off..end];
+}
+
+fn prefixed(name: []const u8, comptime base: []const u8) bool {
+    return std.mem.eql(u8, name, base) or std.mem.startsWith(u8, name, base ++ ".");
+}
+
+/// The script's output section for an allocated input section; null when the script would not place it.
+fn classify(name: []const u8) ?Kind {
+    if (std.mem.eql(u8, name, ".text.init")) return .text_init;
+    if (prefixed(name, ".text")) return .text;
+    if (prefixed(name, ".rodata") or prefixed(name, ".srodata")) return .rodata;
+    if (prefixed(name, ".data") or prefixed(name, ".sdata")) return .data;
+    if (prefixed(name, ".bss") or prefixed(name, ".sbss")) return .bss;
+    return null;
+}
+
+fn parse(a: Allocator, b: []const u8) Allocator.Error!?Object {
+    if (b.len < 52 or !std.mem.eql(u8, b[0..7], "\x7fELF\x01\x01\x01")) return null;
+    if (word(u16, b, 16) != 1 or word(u16, b, 18) != 243 or word(u32, b, 36) != 0) return null;
+    const shoff = word(u32, b, 32) orelse return null;
+    const shentsize = word(u16, b, 46) orelse return null;
+    const shnum = word(u16, b, 48) orelse return null;
+    const shstrndx = word(u16, b, 50) orelse return null;
+    if (shentsize != 40 or shnum == 0 or shstrndx >= shnum or shoff > b.len or b.len - shoff < 40 * @as(usize, shnum)) return null;
+    const sections = std.mem.bytesAsSlice([40]u8, b[shoff..][0 .. 40 * @as(usize, shnum)]);
+    const strs = sections[shstrndx];
+    const names_off = field(strs, 4);
+    if (names_off > b.len or b.len - names_off < field(strs, 5)) return null;
+    var o: Object = .{ .bytes = b, .sections = sections, .names = b[names_off..][0..field(strs, 5)], .addrs = try a.alloc(u32, shnum) };
+    @memset(o.addrs, 0);
+    for (sections, 0..) |sh, i| {
+        const kind = field(sh, 1);
+        const flags = field(sh, 2);
+        if (kind == 2) {
+            if (o.symtab != null) return null;
+            o.symtab = i;
+        }
+        // SHT_REL, SHT_GROUP, SHT_SYMTAB_SHNDX and COMDAT or TLS sections are outside what the compile step emits
+        if (kind == 9 or kind == 17 or kind == 18 or flags & (0x200 | 0x400) != 0) return null;
+        if (kind != 1 and kind != 8 and flags & 2 != 0) return null;
+        if (kind == 1 or kind == 8) if (field(sh, 4) > b.len or (kind == 1 and b.len - field(sh, 4) < field(sh, 5))) return null;
+    }
+    return o;
+}
+
+fn sectionName(o: Object, sh: [40]u8) ?[]const u8 {
+    return cstr(o.names, field(sh, 0));
+}
+
+/// The three segments' bytes: text, rodata, data (bss is memory size only).
+const Image = struct { bytes: [3]std.ArrayList(u8) = @splat(.empty) };
+
+/// ELF32 executable bytes for `objects` (in command-line order), or null.
+pub fn link(a: Allocator, objects: []const []const u8) Allocator.Error!?[]u8 {
+    var arena_state = std.heap.ArenaAllocator.init(a);
+    defer arena_state.deinit();
+    const arena = arena_state.allocator();
+    const objs = try arena.alloc(Object, objects.len);
+    for (objects, objs) |bytes, *o| o.* = try parse(arena, bytes) orelse return null;
+    var inputs: std.ArrayList(Input) = .empty;
+    for (objs, 0..) |o, f| for (o.sections, 0..) |sh, i| {
+        if (field(sh, 2) & 2 == 0) continue;
+        const kind = classify(sectionName(o, sh) orelse return null) orelse return null;
+        if ((kind == .bss) != (field(sh, 1) == 8)) return null;
+        try inputs.append(arena, .{ .file = f, .index = i, .kind = kind });
+    };
+    // the script's order: every .text.init first, then each output section's inputs in file and section order
+    var out: Image = .{};
+    var cursor = [5]u32{ text_base, 0, rodata_base, ram_base, 0 };
+    for ([_]Kind{ .text_init, .text, .rodata, .data, .bss }) |kind| {
+        const k = @backingInt(kind);
+        if (kind == .text) cursor[k] = cursor[0];
+        if (kind == .bss) cursor[k] = cursor[3];
+        // as ld.lld, an output section starts at the largest alignment of its inputs (.text continues .text.init)
+        var widest: u32 = 1;
+        for (inputs.items) |in| if (in.kind == kind) {
+            const alignment = @max(field(objs[in.file].sections[in.index], 8), 1);
+            if (!std.math.isPowerOfTwo(alignment) or alignment > 4096) return null;
+            widest = @max(widest, alignment);
+        };
+        if (kind != .text) cursor[k] = std.mem.alignForward(u32, cursor[k], widest);
+        for (inputs.items) |*in| if (in.kind == kind) {
+            const sh = objs[in.file].sections[in.index];
+            const at = std.mem.alignForward(u32, cursor[k], @max(field(sh, 8), 1));
+            const size = field(sh, 5);
+            if (size > text_end) return null;
+            in.addr = at;
+            objs[in.file].addrs[in.index] = at;
+            cursor[k] = std.math.add(u32, at, size) catch return null;
+        };
+    }
+    if (cursor[1] > text_end or cursor[2] > rodata_end or cursor[4] > ram_end or cursor[3] > ram_end) return null;
+    // section bytes into the three segments, then relocations patched in place
+    const segs = [3]struct { first: u32, last: u32 }{
+        .{ .first = text_base, .last = cursor[1] },
+        .{ .first = rodata_base, .last = cursor[2] },
+        .{ .first = ram_base, .last = cursor[3] },
+    };
+    for (&out.bytes, segs) |*list, seg| try list.appendNTimes(arena, 0, seg.last - seg.first);
+    for (inputs.items) |in| {
+        if (in.kind == .bss) continue;
+        const sh = objs[in.file].sections[in.index];
+        const s: usize = switch (in.kind) {
+            .text_init, .text => 0,
+            .rodata => 1,
+            else => 2,
+        };
+        const off = field(sh, 4);
+        @memcpy(out.bytes[s].items[in.addr - segs[s].first ..][0..field(sh, 5)], objs[in.file].bytes[off..][0..field(sh, 5)]);
+    }
+    var globals: std.StringHashMapUnmanaged(u32) = .empty;
+    for (objs) |o| {
+        const st = o.symtab orelse continue;
+        var it = symbols(o, st) orelse return null;
+        while (it.next()) |sym| {
+            if (sym.bind == 0 or sym.shndx == 0) continue;
+            const value = resolve(o, sym) orelse return null;
+            const got = try globals.getOrPut(arena, sym.name);
+            if (got.found_existing) return null;
+            got.value_ptr.* = value;
+        }
+    }
+    for (objs) |o| for (o.sections) |sh| {
+        if (field(sh, 1) != 4) continue;
+        const target = field(sh, 7);
+        if (target >= o.sections.len or o.symtab == null or field(sh, 6) != o.symtab.?) return null;
+        const place = o.addrs[target];
+        if (place == 0) {
+            if (field(o.sections[target], 2) & 2 != 0) return null;
+            continue;
+        }
+        const s: usize = if (place >= text_base) 0 else if (place >= rodata_base) 1 else 2;
+        const seg = out.bytes[s].items;
+        const rel_off = field(sh, 4);
+        const count = field(sh, 5) / 12;
+        if (rel_off > o.bytes.len or o.bytes.len - rel_off < 12 * @as(usize, count)) return null;
+        for (0..count) |r| {
+            const e = rel_off + 12 * r;
+            const offset = word(u32, o.bytes, e).?;
+            const info = word(u32, o.bytes, e + 4).?;
+            const addend: i32 = @bitCast(word(u32, o.bytes, e + 8).?);
+            const sym = symbol(o, o.symtab.?, info >> 8) orelse return null;
+            const value = if (sym.shndx == 0) globals.get(sym.name) orelse return null else resolve(o, sym) orelse return null;
+            if (offset >= field(o.sections[target], 5)) return null;
+            const p = place + offset;
+            if (!patch(seg, p - segs[s].first, @truncate(info), value +% @as(u32, @bitCast(addend)), p)) return null;
+        }
+    };
+    const entry = globals.get("_start") orelse return null;
+    return try write(a, entry, .{ out.bytes[0].items, out.bytes[1].items, out.bytes[2].items }, cursor[4] - ram_base);
+}
+
+/// Whether a relocatable object leaves `symbol_name` undefined (it calls into another object for it).
+pub fn references(bytes: []const u8, symbol_name: []const u8) bool {
+    var buf: [4096]u8 = undefined;
+    var fba = std.heap.FixedBufferAllocator.init(&buf);
+    const o = (parse(fba.allocator(), bytes) catch return false) orelse return false;
+    var it = symbols(o, o.symtab orelse return false) orelse return false;
+    while (it.next()) |sym| if (sym.shndx == 0 and std.mem.eql(u8, sym.name, symbol_name)) return true;
+    return false;
+}
+
+const Symbol = struct { name: []const u8, value: u32, shndx: u16, bind: u8, kind: u8 };
+
+const Symbols = struct {
+    o: Object,
+    strings: []const u8,
+    table: []const u8,
+    at: usize = 1,
+
+    fn next(it: *Symbols) ?Symbol {
+        if (it.at >= it.table.len / 16) return null;
+        defer it.at += 1;
+        return decode(it.table, it.strings, it.at);
+    }
+};
+
+fn decode(table: []const u8, strings: []const u8, i: usize) ?Symbol {
+    const e = 16 * i;
+    if (e + 16 > table.len) return null;
+    const info = table[e + 12];
+    return .{
+        .name = cstr(strings, word(u32, table, e).?) orelse return null,
+        .value = word(u32, table, e + 4).?,
+        .shndx = word(u16, table, e + 14).?,
+        .bind = info >> 4,
+        .kind = info & 0xf,
+    };
+}
+
+fn symbols(o: Object, st: usize) ?Symbols {
+    const sh = o.sections[st];
+    const link_index = field(sh, 6);
+    if (link_index >= o.sections.len) return null;
+    const strs = o.sections[link_index];
+    const off = field(sh, 4);
+    const str_off = field(strs, 4);
+    if (off > o.bytes.len or o.bytes.len - off < field(sh, 5) or str_off > o.bytes.len or o.bytes.len - str_off < field(strs, 5)) return null;
+    return .{ .o = o, .table = o.bytes[off..][0..field(sh, 5)], .strings = o.bytes[str_off..][0..field(strs, 5)] };
+}
+
+fn symbol(o: Object, st: usize, i: u32) ?Symbol {
+    const it = symbols(o, st) orelse return null;
+    return decode(it.table, it.strings, i);
+}
+
+/// A defined symbol's address: absolute, or its placed section's address plus its value (COMMON is not placed).
+fn resolve(o: Object, sym: Symbol) ?u32 {
+    if (sym.shndx == 0xfff1) return sym.value;
+    if (sym.shndx == 0 or sym.shndx >= o.sections.len) return null;
+    const base = o.addrs[sym.shndx];
+    if (base == 0) return null;
+    return base + sym.value;
+}
+
+/// Applies one RISC-V relocation at segment offset `at` (absolute place `p`); false when unknown or out of range.
+pub fn patch(seg: []u8, at: usize, kind: u8, value: u32, p: u32) bool {
+    const span: usize = if (kind == 18 or kind == 19) 8 else 4;
+    if (at > seg.len or seg.len - at < span) return false;
+    const insn = std.mem.readInt(u32, seg[at..][0..4], .little);
+    const rel = value -% p;
+    const put = struct {
+        fn at32(s: []u8, i: usize, v: u32) void {
+            std.mem.writeInt(u32, s[i..][0..4], v, .little);
+        }
+    }.at32;
+    switch (kind) {
+        1 => put(seg, at, value),
+        26 => put(seg, at, (insn & 0xfff) | ((value +% 0x800) & 0xfffff000)),
+        27 => put(seg, at, (insn & 0xfffff) | (value << 20)),
+        28 => put(seg, at, (insn & 0x1fff07f) | ((value & 0xfe0) << 20) | ((value & 0x1f) << 7)),
+        18, 19 => {
+            const next = std.mem.readInt(u32, seg[at + 4 ..][0..4], .little);
+            put(seg, at, (insn & 0xfff) | ((rel +% 0x800) & 0xfffff000));
+            put(seg, at + 4, (next & 0xfffff) | (rel << 20));
+        },
+        16 => {
+            const off: i32 = @bitCast(rel);
+            if (off < -4096 or off > 4094 or off & 1 != 0) return false;
+            const r = rel;
+            put(seg, at, (insn & 0x1fff07f) | (((r >> 12) & 1) << 31) | (((r >> 5) & 0x3f) << 25) | (((r >> 1) & 0xf) << 8) | (((r >> 11) & 1) << 7));
+        },
+        17 => {
+            const off: i32 = @bitCast(rel);
+            if (off < -(1 << 20) or off > (1 << 20) - 2 or off & 1 != 0) return false;
+            const r = rel;
+            put(seg, at, (insn & 0xfff) | (((r >> 20) & 1) << 31) | (((r >> 1) & 0x3ff) << 21) | (((r >> 11) & 1) << 20) | (((r >> 12) & 0xff) << 12));
+        },
+        else => return false,
+    }
+    return true;
+}
+
+/// Header, three PT_LOAD headers (text R+X, rodata R, data+bss R+W) and the segment bytes; no section headers.
+fn write(a: Allocator, entry: u32, segs: [3][]const u8, ram_size: u32) Allocator.Error![]u8 {
+    var offsets: [3]u32 = undefined;
+    var size: u32 = 52 + 3 * 32;
+    for (segs, &offsets) |s, *off| {
+        size = std.mem.alignForward(u32, size, 4);
+        off.* = size;
+        size += @intCast(s.len);
+    }
+    const b = try a.alloc(u8, size);
+    @memset(b, 0);
+    @memcpy(b[0..7], "\x7fELF\x01\x01\x01");
+    const put16 = struct {
+        fn f(x: []u8, i: usize, v: u16) void {
+            std.mem.writeInt(u16, x[i..][0..2], v, .little);
+        }
+    }.f;
+    const put32 = struct {
+        fn f(x: []u8, i: usize, v: u32) void {
+            std.mem.writeInt(u32, x[i..][0..4], v, .little);
+        }
+    }.f;
+    put16(b, 16, 2);
+    put16(b, 18, 243);
+    put32(b, 20, 1);
+    put32(b, 24, entry);
+    put32(b, 28, 52);
+    put16(b, 40, 52);
+    put16(b, 42, 32);
+    put16(b, 44, 3);
+    const vaddr = [3]u32{ text_base, rodata_base, ram_base };
+    const flags = [3]u32{ 5, 4, 6 };
+    for (0..3) |i| {
+        const ph = 52 + 32 * i;
+        put32(b, ph, 1);
+        put32(b, ph + 4, offsets[i]);
+        put32(b, ph + 8, vaddr[i]);
+        put32(b, ph + 12, vaddr[i]);
+        put32(b, ph + 16, @intCast(segs[i].len));
+        put32(b, ph + 20, if (i == 2) ram_size else @intCast(segs[i].len));
+        put32(b, ph + 24, flags[i]);
+        put32(b, ph + 28, 4);
+        @memcpy(b[offsets[i]..][0..segs[i].len], segs[i]);
+    }
+    return b;
+}
