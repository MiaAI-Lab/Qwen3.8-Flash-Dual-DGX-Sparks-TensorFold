+    defer env.deinit();
+    const clang = env.get("TF_RUNNER_CLANG") orelse {
+        std.debug.print("SKIP RV32 toolchain: set TF_RUNNER_CLANG and optionally TF_RUNNER_LLD\n", .{});
+        return error.SkipZigTest;
+    };
+    var context: f.Context = .{
+        .io = t.io,
+        .compiler = .{ .clang = clang, .linker = env.get("TF_RUNNER_LLD") },
+    };
+    const front = context.frontend();
+    const cases = [_][4][]const u8{
+        .{ "python", "print(2); print(3)", "prints.elf", "2\n3\n" },
+        .{ "python", "print(sum(i*i for i in range(10)))", "squares.elf", "285\n" },
+        .{ "python", "print(sum(i+i for i in range(10)))", "addition.elf", "90\n" },
+        .{ "python", "s = 0\nfor i in range(10):\n    s += i*i\nprint(s)", "loop.elf", "285\n" },
+        .{ "python", "n = 123456789\ns = 0\nwhile n > 0:\n    s += n % 10\n    n //= 10\nprint(s)", "digits.elf", "45\n" },
+        .{ "python", "a = 462\nb = 1071\nwhile b:\n    a, b = b, a % b\nprint(a)", "gcd-loop.elf", "21\n" },
+        .{ "c", "#include <stdio.h>\nint main(void) { int s=0; for(int i=0;i<10;i++) s+=i*i; printf(\"%d\\n\",s); return 0; }", "c.elf", "285\n" },
+        .{ "c", "int main(void) { puts(\"circuit\"); return 0; }", "puts.elf", "circuit\n" },
+        .{ "c", "int s=0; for(int i=0;i<10;i++) s+=i*i; printf(\"%d\\n\",s);", "snippet.elf", "285\n" },
+    };
+    for (cases) |case| {
+        const result = try front.translate(front.ctx, t.allocator, .{ .form = .fence, .lang = case[0], .code = case[1] });
+        try t.expect(result == .program);
+        defer t.allocator.free(result.program.bytes);
+        try t.expectEqual(.elf, result.program.kind);
+        const repeated = try front.translate(front.ctx, t.allocator, .{ .form = .fence, .lang = case[0], .code = case[1] });
+        try t.expect(repeated == .program);
+        defer t.allocator.free(repeated.program.bytes);
+        try t.expectEqualSlices(u8, result.program.bytes, repeated.program.bytes);
+        try t.expect(@import("runner_frontend_program.zig").compiler.validElf(result.program.bytes));
+        if (env.get("TF_RUNNER_QWENPUTER")) |root|
+            try @import("runner_frontend_reference_test.zig").check(root, env.get("TF_RUNNER_REFERENCE_PYTHON") orelse "/usr/bin/python3", result.program, case[3]);
+        if (env.get("TF_RUNNER_FRONTEND_ARTIFACTS")) |path| {
+            const dir = try std.Io.Dir.cwd().openDir(t.io, path, .{});
+            defer dir.close(t.io);
+            const file = try dir.createFile(t.io, case[2], .{});
+            defer file.close(t.io);
+            try file.writeStreamingAll(t.io, result.program.bytes);
+        }
+    }
+    const missing = try front.translate(front.ctx, t.allocator, .{ .form = .fence, .lang = "c", .code = "int main(void) { unknown(); }" });
+    try t.expect(missing == .abstain);
+    context.compiler.clang = "/nonexistent-tensorfold-clang";
+    const unavailable = try front.translate(front.ctx, t.allocator, .{
+        .form = .repl,
+        .lang = "python",
+        .code = "print(sum(i*i for i in range(10)))",
+    });
+    try t.expect(unavailable == .abstain);
+}
+
+test "prior cells cannot silently shadow Python builtins" {
+    const front = f.frontend();
+    const result = try front.translate(null, t.allocator, .{
+        .form = .repl,
+        .lang = "python",
+        .code = "print(2*3)",
+        .prior = &.{"print = lambda x: None"},
+    });
+    try t.expect(result == .abstain);
+}
+
+test "independent arithmetic cells accept safe earlier cells and refuse hidden builtin rebinding" {
+    const front = f.frontend();
+    for ([_][]const u8{ "314159 * 271828", "n = 7", "print(3)" }) |prior| {
+        const result = try front.translate(null, t.allocator, .{
+            .form = .repl,
+            .lang = "python",
+            .code = "2**100 - 3**50",
+            .prior = &.{prior},
+        });
+        try t.expect(result == .program);
+        defer t.allocator.free(result.program.bytes);
+        try t.expectEqual(.calc, result.program.kind);
+    }
+    for ([_][]const u8{ "__builtins__ = 0", "print = 1", "len = 1", "import builtins", "import os" }) |prior| {
+        const result = try front.translate(null, t.allocator, .{
+            .form = .repl,
+            .lang = "python",
+            .code = "print(314159*271828)",
+            .prior = &.{prior},
+        });
+        try t.expect(result == .abstain);
+    }
+    const dependent = try front.translate(null, t.allocator, .{
+        .form = .repl,
+        .lang = "python",
+        .code = "print(n+1)",
+        .prior = &.{"n = 7"},
+    });
+    try t.expect(dependent == .abstain);
+}
+
+test "inline typographic operators normalize without changing Python syntax or tuple semantics" {
+    const front = f.frontend();
+    const result = try front.translate(null, t.allocator, .{ .form = .inline_expr, .lang = "python", .code = "47 × 83 − 1" });
+    try t.expect(result == .program);
+    defer t.allocator.free(result.program.bytes);
+    try t.expectEqualStrings("((47*83)-1)", result.program.bytes);
+    for ([_][]const u8{ "47 × 83", "47 − 83" }) |code| {
+        try t.expect((try front.translate(null, t.allocator, .{ .form = .fence, .lang = "python", .code = code })) == .abstain);
+    }
+    for ([_][]const u8{ "1,000 + 2", "2*3,18", "unknown(2,4)" }) |code| {
+        try t.expect((try front.translate(null, t.allocator, .{ .form = .inline_expr, .lang = "python", .code = code })) == .abstain);
+    }
+}
+
+comptime {
+    _ = @import("runner_frontend_collections_test.zig");
+}
diff --git a/zig/src/core/runner_frontend_tool_script_test.zig b/zig/src/core/runner_frontend_tool_script_test.zig
new file mode 100644
index 000000000..61cd52859
--- /dev/null
+++ b/zig/src/core/runner_frontend_tool_script_test.zig
@@ -0,0 +1,143 @@
+const std = @import("std");
+const python = @import("runner_frontend_integer_python.zig");
+const frontend = @import("runner_frontend.zig");
+const reference = @import("runner_frontend_reference_test.zig");
+const optimization = @import("runner_frontend_optimization_test.zig");
+const t = std.testing;
+
+pub const dividend = "314159265358979323846264338327950288419716939937510";
+pub const divisor = "271828182845904523536";
+pub const inputs = "a=" ++ dividend ++ "\nb=" ++ divisor ++ "\n";
+pub const verification = inputs ++ "q,r=divmod(a,b)\nprint(q)\nprint(r)\nprint(q*b+r==a)";
+pub const expected = "1155727349790921717910215407028\n23663814570294126502\nTrue\n";
+
+const fixtures = [_][2][]const u8{
+    .{ verification, expected },
+    .{ "a=0x100000000;b=0x10001;q,r=divmod(a,b);print(q,r,q*b+r==a)", "65535 1 True\n" },
+    .{ "a=0x7fff00000000;b=0x8000ffff;q,r=divmod(a,b);print(q,r,q*b+r==a)", "65532 327676 True\n" },
+    .{ "a=0x800000000000ffff;b=0x800000000001;q,r=divmod(a,b);print(q,r,q*b+r==a)", "65535 140737488355328 True\n" },
+    .{ "print(1);print(2)", "1\n2\n" },
+    .{ inputs ++ "q,r=divmod(a,b)\nprint(q,r)", "1155727349790921717910215407028 23663814570294126502\n" },
+    .{ "a=-7; b=3; q,r=divmod(a,b); print(q); print(r); print(q*b+r==a)", "-3\n2\nTrue\n" },
+    .{ "q,r=divmod(7,-3); print(q,r); print(q*(-3)+r==7)", "-3 -2\nTrue\n" },
+    .{ "q,r=divmod(-7,-3); print(q,r,q*(-3)+r==-7)", "2 -1 True\n" },
+    .{ "q,q=divmod(7,3); print(q)", "1\n" },
+    .{ "x=7; print(x); x=11; print(x)", "7\n11\n" },
+    .{ "x=3==3; print(x); print(x+1)", "True\n2\n" },
+    .{ "a=100000000000000000000; b=a+1; print(a<b,a>=b,a!=b)", "True False True\n" },
+    .{ "import math; a=48; b=18; print(math.gcd(a,b))", "6\n" },
+    .{ "x=2; y=3\nprint(x+y); # trailing separator/comment\n", "5\n" },
+};
+
+const refused = [_][]const u8{
+    "print(+(1==1))",
+    "print(len(str(1==1)))",
+    "print(sum(map(int,str(1==1))))",
+    "x=1==1;print(len(str(x)))",
+    "q,r=divmod(7,0); print(q,r)",
+    "q,r=divmod(7.0,3); print(q,r)",
+    "q,r=divmod(7,3.0); print(q,r)",
+    "q,r,s=divmod(7,3); print(q,r)",
+    "q,r=(7,3); print(q,r)",
+    "q,r=divmod(7,3)[0]; print(q,r)",
+    "q,r=divmod(7,3); print(q,r,sep=':')",
+    "q,r=divmod(7,3); print(q and r)",
+    "q,r=divmod(7,3); print(0<q<3)",
+    "q,r=divmod(7,3); print(q); x=1//0",
+    "q,r=divmod(7,3); print(q); assert False",
+    "q,r=divmod(10**62,3); print(q,r)",
+    ";print(1)",
+    "x=2;;print(x)",
+    "x=2; ;print(x)",
+    "x=2;\n print(x)",
+    "x=2; y=int('3;4');print(x+y)",
+    "print(1); import os; print(2)",
+};
+
+test "whole integer tool scripts retain source DAGs and fit the unchanged cost cap" {
+    for (fixtures) |fixture| {
+        const result = (try python.lowerWithCost(t.allocator, fixture[0], 10_522)) orelse {
+            std.debug.print("script cost abstained: {s}\n", .{fixture[0]});
+            return error.UnexpectedAbstention;
+        };
+        defer t.allocator.free(result.source);
+        try t.expect(result.estimated_steps.? <= 10_522);
+        try t.expect(std.mem.indexOf(u8, result.source, "tf_run") != null);
+    }
+    const source = (try python.lower(t.allocator, verification)).?;
+    defer t.allocator.free(source);
+    try t.expect(std.mem.indexOf(u8, source, dividend) != null);
+    try t.expect(std.mem.indexOf(u8, source, divisor) != null);
+    try t.expect(std.mem.indexOf(u8, source, "1155727349790921717910215407028") == null);
+    try t.expect(std.mem.indexOf(u8, source, "23663814570294126502") == null);
+}
+
+test "whole script validation refuses malformed unpacking effects floats and chains" {
+    for (refused) |code| {
+        const result = try python.lower(t.allocator, code);
+        defer if (result) |s| t.allocator.free(s);
+        try t.expect(result == null);
+    }
+}
+
+test "configured whole scripts execute grouped and boolean prints exactly like CPython" {
+    var env = try t.environ.createMap(t.allocator);
+    defer env.deinit();
+    const clang = env.get("TF_RUNNER_CLANG") orelse return error.SkipZigTest;
+    const root = env.get("TF_RUNNER_QWENPUTER") orelse return error.SkipZigTest;
+    var context: frontend.Context = .{ .io = t.io, .compiler = .{
+        .clang = clang,
+        .linker = env.get("TF_RUNNER_LLD"),
+    } };
+    const f = context.frontend();
+    for (fixtures) |fixture| {
+        const translated = try f.translate(f.ctx, t.allocator, .{ .form = .fence, .lang = "python", .code = fixture[0] });
+        if (translated != .program) {
+            std.debug.print("script dispatch abstained: {s}\n", .{fixture[0]});
+            return error.UnexpectedAbstention;
+        }
+        defer t.allocator.free(translated.program.bytes);
+        try reference.check(root, env.get("TF_RUNNER_REFERENCE_PYTHON") orelse "/usr/bin/python3", translated.program, fixture[1]);
+        if (translated.program.kind == .elf) try optimization.assertNoOutputInRodata(translated.program.bytes, fixture[1]);
+    }
+}
+
+test "configured whole division script passes optimized work and rodata folding guards" {
+    var env = try t.environ.createMap(t.allocator);
+    defer env.deinit();
+    if (env.get("TF_RUNNER_CLANG") == null or env.get("TF_RUNNER_QWENPUTER") == null)
+        return error.SkipZigTest;
+    const source = (try python.lower(t.allocator, verification)).?;
+    defer t.allocator.free(source);
+    try optimization.checkOptimization(&env, source, expected, true);
+}
+
+test "configured Boolean coercion preserves CPython semantics through generic fallback" {
+    var env = try t.environ.createMap(t.allocator);
+    defer env.deinit();
+    const clang = env.get("TF_RUNNER_CLANG") orelse return error.SkipZigTest;
+    _ = env.get("TF_RUNNER_QWENPUTER") orelse return error.SkipZigTest;
+    var context: frontend.Context = .{ .io = t.io, .compiler = .{
+        .clang = clang,
+        .linker = env.get("TF_RUNNER_LLD"),
+    } };
+    const f = context.frontend();
+    const result = try f.translate(f.ctx, t.allocator, .{
+        .form = .fence,
+        .lang = "python",
+        .code = "print(+(1==1))",
+    });
+    defer if (result == .program) t.allocator.free(result.program.bytes);
+    try t.expect(result == .program);
+    const compat = @import("runner_frontend_collections_compat_test.zig");
+    try compat.checkExact(&env, result.program, "print(+(1==1))");
+    for ([_][]const u8{
+        "print(+True)",
+        "print(-True)",
+        "print(len(str(1==1)))",
+        "x=1==1;print(len(str(x)))",
+        "print(sum(map(int,str(1==1))))",
+    }) |code| {
+        try compat.checkRejectionOrExact(&env, &f, .{ .form = .fence, .lang = "python", .code = code });
+    }
+}
diff --git a/zig/src/core/runner_frontend_value.zig b/zig/src/core/runner_frontend_value.zig
new file mode 100644
index 000000000..91a2d5500
--- /dev/null
+++ b/zig/src/core/runner_frontend_value.zig
@@ -0,0 +1,325 @@
+const std = @import("std");
+const Invalid = error{Unsupported};
+const limit: i512 = std.math.pow(i512, 10, 62);
+const Value = struct { n: i512, d: i512 = 1, scale: usize = 0, width: usize = 0 };
+
+// Checks firmware value limits; the returned program remains the source expression, not this validation value.
+pub fn valid(source: []const u8) bool {
+    if (source.len == 0 or source.len > 255) return false;
+    var p: Parser = .{ .src = source };
+    _ = p.expr() catch return false;
+    return p.pos == source.len;
+}
+
+// This admission estimate models firmware arithmetic; it never replaces the emitted source with a proof value.
+pub fn estimate(source: []const u8, budget: usize) ?usize {
+    if (source.len == 0 or source.len > 255) return null;
+    var p: Parser = .{ .src = source, .budget = budget };
+    p.charge(200) catch return null;
+    const value = p.expr() catch return null;
+    if (p.pos != source.len) return null;
+    const output = if (value.scale != 0)
+        @max(width(value), value.scale + 1) + 1
+    else if (value.d != 1)
+        digits(value.n) + digits(value.d) + 1
+    else
+        digits(value.n);
+    p.charge(40 + 10 * (output + @intFromBool(value.n < 0))) catch return null;
+    return p.steps;
+}
+
+fn magnitude(n: i512) i512 {
+    return if (n < 0) -n else n;
+}
+
+fn gcd(a: i512, b: i512) i512 {
+    var x = magnitude(a);
+    var y = magnitude(b);
+    while (y != 0) {
+        const r = @mod(x, y);
+        x = y;
+        y = r;
+    }
+    return x;
+}
+
+fn checked(n: i512, d: i512) Invalid!Value {
+    if (d == 0) return error.Unsupported;
+    const g = gcd(n, d);
+    const sign: i512 = if (d < 0) -1 else 1;
+    const v: Value = .{ .n = @divTrunc(n, g) * sign, .d = @divTrunc(d, g) * sign };
+    if (magnitude(v.n) >= limit or v.d >= limit) return error.Unsupported;
+    return v;
+}
+
+fn integer(v: Value) Invalid!i512 {
+    if (v.d != 1 or v.scale != 0) return error.Unsupported;
+    return v.n;
+}
+
+fn digits(n: i512) usize {
+    var v = magnitude(n);
+    var count: usize = 1;
+    while (v >= 10) : (count += 1) v = @divTrunc(v, 10);
+    return count;
+}
+
+fn rational(op: u8, a: Value, b: Value) Invalid!Value {
+    if (op == '*') {
+        if (digits(a.n) + digits(b.n) > 62 or
+            (a.d != 1 and b.d != 1 and digits(a.d) + digits(b.d) > 62)) return error.Unsupported;
+        return checked(a.n * b.n, a.d * b.d);
+    }
+    if (op == '/') {
+        if (b.n == 0 or (b.d != 1 and digits(a.n) + digits(b.d) > 62) or
+            (a.d != 1 and digits(a.d) + digits(b.n) > 62)) return error.Unsupported;
+        return checked(a.n * b.d, a.d * b.n);
+    }
+    if ((b.d != 1 and digits(a.n) + digits(b.d) > 62) or
+        (a.d != 1 and digits(b.n) + digits(a.d) > 62) or
+        (a.d != 1 and b.d != 1 and digits(a.d) + digits(b.d) > 62)) return error.Unsupported;
+    const x = a.n * b.d;
+    const y = if (op == '+') b.n * a.d else -b.n * a.d;
+    if ((x < 0) == (y < 0) and @max(digits(x), digits(y)) + 1 > 62) return error.Unsupported;
+    return checked(x + y, a.d * b.d);
+}
+
+fn width(v: Value) usize {
+    return if (v.width == 0) digits(v.n) else v.width;
+}
+
+fn decimal(op: u8, a: Value, b: Value) Invalid!Value {
+    if (op != '+' and op != '-' and op != '*') return error.Unsupported;
+    if (op == '*') {
+        const w = width(a) + width(b);
+        if (w > 62) return error.Unsupported;
+        var v = try checked(a.n * b.n, 1);
+        v.scale = a.scale + b.scale;
+        v.width = w;
+        return v;
+    }
+    // Firmware shift() leaves shifted zero untrimmed; reject it before later magnitude comparisons.
+    if ((a.n == 0 and a.scale < b.scale) or (b.n == 0 and b.scale < a.scale)) return error.Unsupported;
+    const scale = @max(a.scale, b.scale);
+    const wa = width(a) + scale - a.scale;
+    const wb = width(b) + scale - b.scale;
+    if (wa > 62 or wb > 62) return error.Unsupported;
+    const x = a.n * std.math.pow(i512, 10, scale - a.scale);
+    const y = b.n * std.math.pow(i512, 10, scale - b.scale) * @as(i512, if (op == '+') 1 else -1);
+    const w = @max(wa, wb) + @intFromBool((x < 0) == (y < 0));
+    if (w > 62) return error.Unsupported;
+    var v = try checked(x + y, 1);
+    v.scale = scale;
+    v.width = w;
+    return v;
+}
+
+const Parser = struct {
+    src: []const u8,
+    pos: usize = 0,
+    budget: ?usize = null,
+    steps: usize = 0,
+
+    fn charge(self: *Parser, amount: usize) Invalid!void {
+        const budget = self.budget orelse return;
+        if (amount > budget - self.steps) {
+            self.steps = budget +| 1;
+            return error.Unsupported;
+        }
+        self.steps += amount;
+    }
+
+    fn divisionCost(self: *Parser, a: i512, b: i512) Invalid!void {
+        try self.charge(80 + 8 * digits(a) * digits(b));
+    }
+
+    fn gcdCost(self: *Parser, a: i512, b: i512) Invalid!i512 {
+        if (self.budget == null) return gcd(a, b);
+        var x = magnitude(a);
+        var y = magnitude(b);
+        try self.charge(40);
+        while (y != 0) {
+            try self.divisionCost(x, y);
+            try self.charge(30);
+            const remainder = @mod(x, y);
+            x = y;
+            y = remainder;
+        }
+        return x;
+    }
+
+    fn reductionCost(self: *Parser, n: i512, d: i512) Invalid!void {
+        if (self.budget == null) return;
+        if (d == 1) return self.charge(20);
+        const g = try self.gcdCost(n, d);
+        try self.divisionCost(n, g);
+        try self.divisionCost(d, g);
+    }
+
+    fn multiplyCost(self: *Parser, a: usize, b: usize) Invalid!void {
+        try self.charge(80 + 3 * a * b);
+    }
+
+    fn apply(self: *Parser, op: u8, a: Value, b: Value) Invalid!Value {
+        const is_decimal = a.scale != 0 or b.scale != 0;
+        const result = if (is_decimal) try decimal(op, a, b) else try rational(op, a, b);
+        if (self.budget == null) return result;
+        if (is_decimal) {
+            if (op == '*') {
+                try self.multiplyCost(width(a), width(b));
+            } else {
+                const scale = @max(a.scale, b.scale);
+                const wa = width(a) + scale - a.scale;
+                const wb = width(b) + scale - b.scale;
+                try self.charge(40 + 5 * @max(wa, wb));
+                try self.charge(10 * ((scale - a.scale) * width(a) + (scale - b.scale) * width(b)));
+            }
+            try self.reductionCost(result.n, 1);
+            return result;
+        }
+        var n: i512 = undefined;
+        var d: i512 = undefined;
+        if (op == '*') {
+            try self.multiplyCost(digits(a.n), digits(b.n));
+            if (a.d != 1 and b.d != 1) try self.multiplyCost(digits(a.d), digits(b.d));
+            n = a.n * b.n;
+            d = a.d * b.d;
+        } else if (op == '/') {
+            try self.charge(60);
+            if (b.d != 1) try self.multiplyCost(digits(a.n), digits(b.d));
+            if (a.d != 1) try self.multiplyCost(digits(a.d), digits(b.n));
+            n = a.n * b.d;
+            d = a.d * b.n;
+        } else {
+            if (b.d != 1) try self.multiplyCost(digits(a.n), digits(b.d));
+            if (a.d != 1) try self.multiplyCost(digits(b.n), digits(a.d));
+            if (a.d != 1 and b.d != 1) try self.multiplyCost(digits(a.d), digits(b.d));
+            const x = a.n * b.d;
+            const y = b.n * a.d;
+            try self.charge(40 + 5 * @max(digits(x), digits(y)));
+            n = if (op == '+') x + y else x - y;
+            d = a.d * b.d;
+        }
+        try self.reductionCost(n, d);
+        return result;
+    }
+
+    fn take(self: *Parser, s: []const u8) bool {
+        if (!std.mem.startsWith(u8, self.src[self.pos..], s)) return false;
+        self.pos += s.len;
+        return true;
+    }
+
+    fn expr(self: *Parser) Invalid!Value {
+        var a = try self.term();
+        while (self.pos < self.src.len) {
+            const op = self.src[self.pos];
+            if (op != '+' and op != '-') break;
+            self.pos += 1;
+            const b = try self.term();
+            if ((a.scale != 0 or b.scale != 0) and (a.d != 1 or b.d != 1)) return error.Unsupported;
+            a = try self.apply(op, a, b);
+        }
+        return a;
+    }
+
+    fn term(self: *Parser) Invalid!Value {
+        var a = try self.factor();
+        while (self.pos < self.src.len) {
+            const op = self.src[self.pos];
+            if (op != '*' and op != '/' and op != '%') break;
+            self.pos += 1;
+            const floor = op == '/' and self.take("/");
+            const b = try self.factor();
+            if (floor or op == '%') {
+                const x = try integer(a);
+                const y = try integer(b);
+                if (y == 0) return error.Unsupported;
+                if ((x < 0) != (y < 0) and @rem(x, y) != 0 and digits(@divTrunc(x, y)) == 62)
+                    return error.Unsupported;
+                try self.divisionCost(x, y);
+                try self.charge(40);
+                a = try checked(if (floor) @divFloor(x, y) else x - @divFloor(x, y) * y, 1);
+                try self.reductionCost(a.n, 1);
+            } else if (a.scale != 0 or b.scale != 0) {
+                if (op != '*' or a.d != 1 or b.d != 1) return error.Unsupported;
+                a = try self.apply(op, a, b);
+            } else if (op == '/' or a.d != 1 or b.d != 1) {
+                a = try self.apply(op, a, b);
+            } else a = try self.apply('*', a, b);
+        }
+        return a;
+    }
+
+    fn factor(self: *Parser) Invalid!Value {
+        if (self.take("+")) {
+            try self.charge(20);
+            return self.factor();
+        }
+        if (self.take("-")) {
+            try self.charge(20);
+            var v = try self.factor();
+            v.n = -v.n;
+            return v;
+        }
+        var a = try self.atom();
+        if (self.take("**")) {
+            var exp = try integer(try self.factor());
+            if (exp < 0 or exp > 999) return error.Unsupported;
+            try self.charge(40);
+            var base = Value{ .n = try integer(a) };
+            a = .{ .n = 1 };
+            while (exp > 0) {
+                try self.charge(20);
+                if (@mod(exp, 2) == 1) a = try self.apply('*', a, base);
+                exp = @divTrunc(exp, 2);
+                if (exp > 0) base = try self.apply('*', base, base);
+            }
+        }
+        return a;
+    }
+
+    fn atom(self: *Parser) Invalid!Value {
+        if (self.take("gcd(")) {
+            try self.charge(40);
+            const a = try integer(try self.expr());
+            if (!self.take(",")) return error.Unsupported;
+            const b = try integer(try self.expr());
+            if (!self.take(")")) return error.Unsupported;
+            return .{ .n = try self.gcdCost(a, b) };
+        }
+        if (self.take("(")) {
+            try self.charge(40);
+            const v = try self.expr();
+            if (!self.take(")")) return error.Unsupported;
+            return v;
+        }
+        var n: i512 = 0;
+        var scale: usize = 0;
+        var dot = false;
+        var count: usize = 0;
+        const start = self.pos;
+        while (self.pos < self.src.len) {
+            const c = self.src[self.pos];
+            if (c == '.' and !dot) {
+                dot = true;
+            } else if (std.ascii.isDigit(c)) {
+                count += 1;
+                if (count > 62) return error.Unsupported;
+                n = n * 10 + c - '0';
+                if (dot) scale += 1;
+            } else break;
+            self.pos += 1;
+        }
+        if (start == self.pos or (self.budget != null and count == 0)) return error.Unsupported;
+        try self.charge(40 + 10 * count);
+        return .{ .n = n, .scale = scale };
+    }
+};
+
+test "value preflight refuses overflow and arithmetic errors" {
+    for ([_][]const u8{ "2**100", "-2**2", "(-2)**2", "7//-3", "1/3+2/3", "1.25*2.4" }) |s|
+        try std.testing.expect(valid(s));
+    for ([_][]const u8{ "10**100", "2**1000", "2**-1", "1/0", "1//0", "1%0", "gcd(1/2,3)", "(1/2)**3" }) |s|
+        try std.testing.expect(!valid(s));
+}
