+        } else if (persistent) {
+            try p.edit(.{ .lo = group, .hi = group }, try p.fmt(
+                " static int __tfimr_g_{d}; if (!__tfimr_g_{d}) {{ {s} __tfimr_g_{d} = 1; }} {s}",
+                .{ n, n, setup, n, fence },
+            ));
+        } else {
+            try p.edit(.{ .lo = group, .hi = group }, try p.fmt(" {s}{s}", .{ setup, fence }));
+        }
+    }
+    fn walk(p: *Pass, node: V, local: bool, no_insert: bool, depth: usize) Error!void {
+        if (depth > 64 or node != .object) return error.Unsupported;
+        const kind = field(node, "kind");
+        const range = field(node, "range");
+        if (!local and !eq(kind, "TranslationUnitDecl")) {
+            const raw = field(range, "end");
+            const loc = if (field(raw, "expansionLoc") == .null) raw else field(raw, "expansionLoc");
+            const end = field(loc, "offset");
+            if (end == .integer and end.integer >= 0) {
+                const position = std.math.cast(usize, end.integer) orelse return error.Unsupported;
+                if (position < p.offset) return;
+            }
+            if (end == .null and field(node, "isImplicit") == .bool and field(node, "isImplicit").bool) return;
+            _ = try p.span(node);
+        }
+        if (std.mem.indexOfScalar(u8, canonical(node), '[') != null and !support.expressionType(canonical(node))) return error.Unsupported;
+        if (eq(kind, "VarDecl")) return p.variable(node, local, no_insert, depth);
+        if (eq(kind, "IntegerLiteral") or eq(kind, "CharacterLiteral"))
+            return p.slot(node);
+        const children = items(field(node, "inner"));
+        if (eq(kind, "DeclStmt") and children.len > 1) {
+            for (children) |child| {
+                if (eq(field(child, "kind"), "VarDecl") and
+                    std.mem.indexOfScalar(u8, canonical(child), '[') != null and
+                    !eq(field(child, "storageClass"), "static")) return error.Unsupported;
+            }
+        }
+        if (eq(kind, "ImplicitCastExpr")) {
+            if (eq(field(node, "castKind"), "LValueToRValue")) return p.scalarRead(node, local, no_insert, depth);
+            if (eq(field(node, "castKind"), "NullToPointer")) return error.Unsupported;
+            if (eq(field(node, "castKind"), "ArrayToPointerDecay") and children.len == 1) {
+                var child = children[0];
+                var nesting: usize = 0;
+                while (eq(field(child, "kind"), "ParenExpr")) {
+                    const inner = items(field(child, "inner"));
+                    nesting += 1;
+                    if (inner.len != 1 or nesting > 64) return error.Unsupported;
+                    child = inner[0];
+                }
+                if (eq(field(child, "kind"), "StringLiteral")) return p.slot(child);
+            }
+        }
+        if (eq(kind, "DeclRefExpr") and std.mem.startsWith(u8, string(field(field(node, "referencedDecl"), "name")), "__builtin_"))
+            return error.Unsupported;
+        if (eq(kind, "UnaryExprOrTypeTraitExpr")) {
+            if (!eq(field(node, "name"), "sizeof") and !eq(field(node, "name"), "alignof"))
+                return error.Unsupported;
+            if (!fixedMetadata(node, 0)) return error.Unsupported;
+            return p.slot(node);
+        }
+        if (eq(kind, "FunctionDecl")) {
+            if (eq(field(node, "name"), "main")) {
+                if (!std.mem.eql(u8, ty(node), "int (void)") and !std.mem.eql(u8, ty(node), "int ()"))
+                    return error.Unsupported;
+                for (children) |child| if (eq(field(child, "kind"), "CompoundStmt")) {
+                    if (p.main_found) return error.Unsupported;
+                    const body = try p.span(child);
+                    if (p.source[body.hi - 1] != '}') return error.Unsupported;
+                    try p.edit(.{ .lo = body.hi - 1, .hi = body.hi - 1 }, " return __tfimr_zero; ");
+                    p.main_found = true;
+                };
+            }
+            for (children) |child| try p.walk(child, true, false, depth + 1);
+            return;
+        }
+        if (eq(kind, "ParmVarDecl") and !objectType(canonical(node))) return error.Unsupported;
+        const allowed = [_][]const u8{
+            "TranslationUnitDecl", "ParmVarDecl",  "CompoundStmt",          "DeclStmt",               "ImplicitCastExpr",
+            "CStyleCastExpr",      "ParenExpr",    "BinaryOperator",        "CompoundAssignOperator", "UnaryOperator",
+            "ReturnStmt",          "IfStmt",       "ForStmt",               "WhileStmt",              "DoStmt",
+            "BreakStmt",           "ContinueStmt", "NullStmt",              "CallExpr",               "ArraySubscriptExpr",
+            "ConditionalOperator", "InitListExpr", "ImplicitValueInitExpr", "DeclRefExpr",            "SwitchStmt",
+            "CaseStmt",            "DefaultStmt",
+        };
+        var supported = false;
+        for (allowed) |name| {
+            if (eq(kind, name)) {
+                supported = true;
+                break;
+            }
+        }
+        if (!supported) return error.Unsupported;
+        if (eq(kind, "InitListExpr") and std.mem.indexOfScalar(u8, ty(node), '*') == null) {
+            for (children) |child| if (eq(field(child, "kind"), "StringLiteral")) return error.Unsupported;
+        }
+        if (eq(kind, "CaseStmt") and children.len != 2) return error.Unsupported;
+        if (eq(kind, "CaseStmt") and !constantContext(children[0], 0)) return error.Unsupported;
+        for (children, 0..) |child, i| {
+            if (eq(kind, "CaseStmt") and i == 0) continue;
+            if (child == .object and child.object.count() == 0 and eq(kind, "ForStmt")) continue;
+            try p.walk(child, local, no_insert or eq(kind, "SwitchStmt") or
+                (eq(kind, "ForStmt") and i == 0), depth + 1);
+        }
+        for (items(field(node, "array_filler"))) |child| try p.walk(child, local, no_insert, depth + 1);
+    }
+    fn trivia(p: *Pass, pos: *usize) Error!bool {
+        const i = pos.*;
+        if (std.ascii.isWhitespace(p.source[i])) {
+            pos.* += 1;
+        } else if (p.source[i] == '/' and i + 1 < p.source.len and p.source[i + 1] == '*') {
+            const end = std.mem.indexOf(u8, p.source[i + 2 ..], "*/") orelse return error.Unsupported;
+            pos.* = i + end + 4;
+        } else if (p.source[i] == '/' and i + 1 < p.source.len and p.source[i + 1] == '/') {
+            pos.* = std.mem.indexOfScalarPos(u8, p.source, i, '\n') orelse p.source.len;
+        } else return false;
+        return true;
+    }
+    fn preprocessor(p: *Pass) Error![]const u8 {
+        var macros: std.ArrayList(u8) = .empty;
+        var i: usize = 0;
+        var prefix = true;
+        while (i < p.source.len) {
+            if (try p.trivia(&i)) continue;
+            if (p.source[i] == '#') {
+                if (!prefix) return error.Unsupported;
+                const end = std.mem.indexOfScalarPos(u8, p.source, i, '\n') orelse p.source.len;
+                var words = std.mem.tokenizeAny(u8, p.source[i + 1 .. end], " \t\r");
+                if (!std.mem.eql(u8, words.next() orelse return error.Unsupported, "define")) return error.Unsupported;
+                const name = words.next() orelse return error.Unsupported;
+                if (name.len == 0 or std.ascii.isDigit(name[0]) or std.mem.eql(u8, name, "main")) return error.Unsupported;
+                for (name) |c| if (!identifier(c)) return error.Unsupported;
+                const reserved = [_][]const u8{
+                    "volatile",      "char",    "unsigned", "signed", "short", "long",   "int",    "const", "_Bool",
+                    "__attribute__", "section", "static",   "void",   "while", "sizeof", "return", "if",    "__typeof__",
+                    "_Alignof",
+                };
+                for (reserved) |word| if (std.mem.eql(u8, name, word)) return error.Unsupported;
+                const body = std.mem.trim(u8, words.rest(), " \t\r");
+                if (body.len == 0) return error.Unsupported;
+                if (body[0] == '"' or body[0] == '\'') {
+                    var j: usize = 1;
+                    while (j < body.len and body[j] != body[0]) : (j += 1) {
+                        if (body[j] == '\\') j += 1;
+                    }
+                    if (j + 1 != body.len) return error.Unsupported;
+                } else {
+                    if (!std.ascii.isDigit(body[0])) return error.Unsupported;
+                    for (body) |c| if (!std.ascii.isAlphanumeric(c)) return error.Unsupported;
+                }
+                try p.append(&macros, p.source[i..end]);
+                try p.append(&macros, "\n");
+                try p.edit(.{ .lo = i, .hi = end }, "");
+                i = end;
+            } else {
+                prefix = false;
+                if (p.source[i] == '"' or p.source[i] == '\'') {
+                    const quote = p.source[i];
+                    i += 1;
+                    while (i < p.source.len and p.source[i] != quote) : (i += 1) {
+                        if (p.source[i] == '\\') i += 1;
+                    }
+                    if (i >= p.source.len) return error.Unsupported;
+                }
+                i += 1;
+            }
+        }
+        return macros.items;
+    }
+    fn run(p: *Pass, root: V) Error![]const u8 {
+        if (!eq(field(root, "kind"), "TranslationUnitDecl")) return error.Unsupported;
+        const macros = try p.preprocessor();
+        try p.walk(root, false, false, 0);
+        if (!p.main_found) return error.Unsupported;
+        const body = try p.render(.{ .lo = 0, .hi = p.source.len }, p.edits.items);
+        return p.fmt(
+            "{s}volatile int __tfimr_zero __attribute__((section(\".data\"))) = 0;\n{s}" ++
+                "static void __tfimr_copy(volatile unsigned char *__tfimr_d, volatile unsigned char *__tfimr_s, unsigned long __tfimr_n) {{ while (__tfimr_n--) *__tfimr_d++ = *__tfimr_s++; }}\n" ++
+                "#define main __tfimr_user_main\n{s}\n#undef main\n" ++
+                "int main(void) {{ {s} return __tfimr_user_main(); }}\n",
+            .{ macros, p.data.items, body, p.startup.items },
+        );
+    }
+};
diff --git a/zig/src/core/runner_frontend_c_inputs_support.zig b/zig/src/core/runner_frontend_c_inputs_support.zig
new file mode 100644
index 000000000..dba5b96cf
--- /dev/null
+++ b/zig/src/core/runner_frontend_c_inputs_support.zig
@@ -0,0 +1,106 @@
+const std = @import("std");
+
+pub fn jsonDepth(s: []const u8) bool {
+    var depth: usize = 0;
+    var quoted = false;
+    var escape = false;
+    for (s) |c| {
+        if (quoted) {
+            if (escape) escape = false else if (c == '\\') escape = true else if (c == '"') quoted = false;
+        } else if (c == '"') {
+            quoted = true;
+        } else if (c == '{' or c == '[') {
+            depth += 1;
+            if (depth > 64) return false;
+        } else if (c == '}' or c == ']') {
+            if (depth == 0) return false;
+            depth -= 1;
+        }
+    }
+    return !quoted and depth == 0;
+}
+
+pub fn integerType(s: []const u8) bool {
+    const types = [_][]const u8{ "char", "signed char", "unsigned char", "short", "unsigned short", "int", "unsigned int", "long", "unsigned long", "long long", "unsigned long long", "_Bool" };
+    for (types) |t| if (std.mem.eql(u8, s, t)) return true;
+    return false;
+}
+pub fn objectType(s: []const u8) bool {
+    if (s.len == 0 or s.len > 512) return false;
+    const bracket = std.mem.indexOfScalar(u8, s, '[') orelse s.len;
+    var tokens = std.mem.tokenizeAny(u8, s[0..bracket], " *");
+    var base = false;
+    while (tokens.next()) |token| {
+        if (!integerType(token) and !std.mem.eql(u8, token, "unsigned") and
+            !std.mem.eql(u8, token, "signed") and !std.mem.eql(u8, token, "const") and
+            !std.mem.eql(u8, token, "volatile")) return false;
+        if (integerType(token)) base = true;
+    }
+    var i = bracket;
+    while (i < s.len) {
+        if (s[i] != '[') return false;
+        i += 1;
+        const begin = i;
+        while (i < s.len and std.ascii.isDigit(s[i])) : (i += 1) {}
+        if (i == begin or i == s.len or s[i] != ']') return false;
+        i += 1;
+    }
+    return base;
+}
+
+// RV32 ILP32 object sizes; reject incomplete, variable or oversized shapes before generating copies.
+pub fn objectBytes(s: []const u8) ?usize {
+    if (!objectType(s)) return null;
+    const bracket = std.mem.indexOfScalar(u8, s, '[') orelse s.len;
+    const base = s[0..bracket];
+    var bytes: usize = 4;
+    if (std.mem.indexOfScalar(u8, base, '*') == null) {
+        var tokens = std.mem.tokenizeScalar(u8, base, ' ');
+        var longs: usize = 0;
+        while (tokens.next()) |word| {
+            if (std.mem.eql(u8, word, "char") or std.mem.eql(u8, word, "_Bool")) bytes = 1;
+            if (std.mem.eql(u8, word, "short")) bytes = 2;
+            if (std.mem.eql(u8, word, "long")) longs += 1;
+        }
+        if (longs == 2) bytes = 8;
+    }
+    var i = bracket;
+    while (i < s.len) {
+        const end = std.mem.indexOfScalarPos(u8, s, i, ']') orelse return null;
+        const count = std.fmt.parseInt(usize, s[i + 1 .. end], 10) catch return null;
+        if (count == 0 or count > 32768 / bytes) return null;
+        bytes *= count;
+        i = end + 1;
+    }
+    return bytes;
+}
+
+pub fn expressionType(s: []const u8) bool {
+    if (objectType(s)) return true;
+    const pointer = std.mem.indexOf(u8, s, " (*)") orelse return false;
+    var buffer: [512]u8 = undefined;
+    const tail = s[pointer + 4 ..];
+    if (pointer + tail.len > buffer.len) return false;
+    @memcpy(buffer[0..pointer], s[0..pointer]);
+    @memcpy(buffer[pointer..][0..tail.len], tail);
+    return objectType(buffer[0 .. pointer + tail.len]);
+}
+
+pub fn readBytes(s: []const u8) ?usize {
+    if (std.mem.indexOf(u8, s, " (*)") != null) return if (expressionType(s)) 4 else null;
+    if (std.mem.indexOfScalar(u8, s, '[') != null) return null;
+    return objectBytes(s);
+}
+
+// The expression runs once; typeof is unevaluated because supported scalar types exclude variably modified types.
+pub fn readExpression(a: std.mem.Allocator, expr: []const u8, type_expr: []const u8, bytes: usize, id: usize) (std.mem.Allocator.Error || error{Unsupported})![]const u8 {
+    if (expr.len > 65536 or type_expr.len > 16384) return error.Unsupported;
+    if (bytes == 8) return std.fmt.allocPrint(a, "({{ unsigned long long __tfimr_r_{d} = (unsigned long long)({s}); " ++
+        "unsigned int __tfimr_lo_{d} = (unsigned int)__tfimr_r_{d}; " ++
+        "unsigned int __tfimr_hi_{d} = (unsigned int)(__tfimr_r_{d} >> 32); " ++
+        "__asm__ volatile(\"\" : \"+r\"(__tfimr_lo_{d}), \"+r\"(__tfimr_hi_{d})); " ++
+        "(__typeof__({s}))((unsigned long long)__tfimr_lo_{d} | ((unsigned long long)__tfimr_hi_{d} << 32)); }})", .{ id, expr, id, id, id, id, id, id, type_expr, id, id });
+    if (bytes != 1 and bytes != 2 and bytes != 4) return error.Unsupported;
+    return std.fmt.allocPrint(a, "({{ unsigned int __tfimr_r_{d} = (unsigned int)({s}); " ++
+        "__asm__ volatile(\"\" : \"+r\"(__tfimr_r_{d})); (__typeof__({s}))__tfimr_r_{d}; }})", .{ id, expr, id, type_expr, id });
+}
diff --git a/zig/src/core/runner_frontend_c_inputs_test.zig b/zig/src/core/runner_frontend_c_inputs_test.zig
new file mode 100644
index 000000000..0ec53f290
--- /dev/null
+++ b/zig/src/core/runner_frontend_c_inputs_test.zig
@@ -0,0 +1,577 @@
+const std = @import("std");
+const inputs = @import("runner_frontend_c_inputs.zig");
+const support = @import("runner_frontend_c_inputs_support.zig");
+const t = std.testing;
+const Loc = struct {
+    offset: usize,
+    tokLen: usize = 1,
+    expansionLoc: ?*const Loc = null,
+    spellingLoc: ?*const Loc = null,
+    isMacroArgExpansion: bool = false,
+};
+const Range = struct { begin: Loc, end: Loc };
+const Node = struct {
+    kind: []const u8,
+    type: struct { qualType: []const u8 = "", desugaredQualType: []const u8 = "" } = .{},
+    name: []const u8 = "",
+    range: ?Range = null,
+    loc: ?Loc = null,
+    inner: []const Node = &.{},
+    array_filler: []const Node = &.{},
+    value: std.json.Value = .null,
+    storageClass: []const u8 = "",
+    castKind: []const u8 = "",
+    argType: struct { qualType: []const u8 = "" } = .{},
+};
+
+// These fixtures exercise the AST schema and edits; real Clang/ELF validation belongs to the parent host suite.
+const Fixture = struct {
+    a: std.mem.Allocator,
+    source: []const u8,
+    offset: usize = 0,
+
+    fn at(f: Fixture, text: []const u8) usize {
+        return std.mem.indexOf(u8, f.source, text).?;
+    }
+    fn range(f: Fixture, lo: usize, hi: usize) Range {
+        return .{ .begin = .{ .offset = f.offset + lo }, .end = .{ .offset = f.offset + hi - 1 } };
+    }
+    fn node(f: Fixture, kind: []const u8, text: []const u8, typ: []const u8) Node {
+        const lo = f.at(text);
+        return .{ .kind = kind, .type = .{ .qualType = typ }, .range = f.range(lo, lo + text.len) };
+    }
+    fn lastNode(f: Fixture, kind: []const u8, text: []const u8, typ: []const u8) Node {
+        const lo = std.mem.lastIndexOf(u8, f.source, text).?;
+        return .{ .kind = kind, .type = .{ .qualType = typ }, .range = f.range(lo, lo + text.len) };
+    }
+    fn list(f: Fixture, nodes: []const Node) ![]const Node {
+        return f.a.dupe(Node, nodes);
+    }
+    fn readNode(f: Fixture, child: Node, typ: []const u8) !Node {
+        return .{ .kind = "ImplicitCastExpr", .type = .{ .qualType = typ }, .range = child.range, .castKind = "LValueToRValue", .inner = try f.list(&.{child}) };
+    }
+    fn variable(f: Fixture, text: []const u8, name: []const u8, typ: []const u8, init: ?Node) !Node {
+        var n = f.node("VarDecl", text, typ);
+        n.name = name;
+        var name_index: usize = 0;
+        while (name_index < text.len) : (name_index += 1) {
+            if (!std.mem.startsWith(u8, text[name_index..], name)) continue;
+            if (name_index != 0 and (std.ascii.isAlphanumeric(text[name_index - 1]) or text[name_index - 1] == '_')) continue;
+            const end = name_index + name.len;
+            if (end < text.len and (std.ascii.isAlphanumeric(text[end]) or text[end] == '_')) continue;
+            break;
+        }
+        const name_at = f.at(text) + name_index;
+        n.loc = .{ .offset = f.offset + name_at, .tokLen = name.len };
+        if (init) |child| n.inner = try f.list(&.{child});
+        if (std.mem.startsWith(u8, text, "static")) n.storageClass = "static";
+        return n;
+    }
+    fn ast(f: Fixture, globals: []const Node, body: []const Node) ![]const u8 {
+        var function = f.node("FunctionDecl", f.source[f.at("int main")..], "int (void)");
+        function.name = "main";
+        const open = std.mem.indexOfScalarPos(u8, f.source, f.at("int main"), '{').?;
+        function.inner = try f.list(&.{.{ .kind = "CompoundStmt", .inner = body, .range = f.range(open, f.source.len) }});
+        var top: std.ArrayList(Node) = .empty;
+        try top.appendSlice(f.a, globals);
+        try top.append(f.a, function);
+        return std.json.Stringify.valueAlloc(f.a, Node{ .kind = "TranslationUnitDecl", .inner = top.items }, .{});
+    }
+    fn lower(f: Fixture, globals: []const Node, body: []const Node) !?[]u8 {
+        return inputs.lower(t.allocator, f.source, try f.ast(globals, body), f.offset);
+    }
+    fn lowerCost(f: Fixture, globals: []const Node, body: []const Node) !?inputs.Lowered {
+        return inputs.lowerWithCost(t.allocator, f.source, try f.ast(globals, body), f.offset);
+    }
+};
+
+fn contains(s: []const u8, text: []const u8) !void {
+    try t.expect(std.mem.indexOf(u8, s, text) != null);
+}
+
+// The parent supplies real normalized source and its matching Clang JSON without storing private fixture paths here.
+pub fn expectClangFixture(source: []const u8, ast_json: []const u8, source_offset: usize) !void {
+    const output = (try inputs.lower(t.allocator, source, ast_json, source_offset)) orelse
+        return error.UnsupportedClangFixture;
+    defer t.allocator.free(output);
+    try contains(output, "#define main __tfimr_user_main\n");
+    try contains(output, "#undef main\nint main(void)");
+    try contains(output, "return __tfimr_user_main();");
+    const repeated = (try inputs.lower(t.allocator, source, ast_json, source_offset)) orelse
+        return error.UnsupportedClangFixture;
+    defer t.allocator.free(repeated);
+    try t.expectEqualStrings(output, repeated);
+}
+
+test "literal leaves retain signedness and width and source arithmetic" {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const f: Fixture = .{ .a = arena.allocator(), .source = "int main(void){ return 21U + 'a' + 9LL; }", .offset = 173 };
+    var character = f.node("CharacterLiteral", "'a'", "int");
+    character.value = .{ .integer = 97 };
+    const body = [_]Node{
+        f.node("IntegerLiteral", "21U", "unsigned int"), character,
+        f.node("IntegerLiteral", "9LL", "long long"),
+    };
+    const output = (try f.lower(&.{}, &body)).?;
+    defer t.allocator.free(output);
+    try contains(output, "volatile unsigned int __tfimr_v_0");
+    try contains(output, "= 21U;");
+    try contains(output, "volatile int __tfimr_v_1");
+    try contains(output, "= 'a';");
+    try contains(output, "volatile long long __tfimr_v_2");
+    try contains(output, "return (__tfimr_v_0) + (__tfimr_v_1) + (__tfimr_v_2);");
+    const again = (try f.lower(&.{}, &body)).?;
+    defer t.allocator.free(again);
+    try t.expectEqualStrings(output, again);
+}
+
+test "automatic numeric array leaves remain inside the initializer" {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const f: Fixture = .{ .a = arena.allocator(), .source = "int main(void){ int a[3]={4,5}; return a[1]; }" };
+    var init = f.node("InitListExpr", "{4,5}", "int[3]");
+    const four = f.node("IntegerLiteral", "4", "int");
+    init.inner = try f.list(&.{four});
+    init.array_filler = try f.list(&.{ .{ .kind = "ImplicitValueInitExpr" }, four, f.node("IntegerLiteral", "5", "int") });
