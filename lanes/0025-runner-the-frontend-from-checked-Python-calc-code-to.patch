+                .conditional => {
+                    const flow = try r.block(f, if (try val.truth(try r.expr(f, s.expr.?, b))) s.body else s.otherwise, b);
+                    if (flow != .next) return flow;
+                },
+                .while_loop => {
+                    while (try val.truth(try r.expr(f, s.expr.?, b))) {
