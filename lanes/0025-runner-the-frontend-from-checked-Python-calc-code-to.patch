+}
+
+test "firmware refusal leaves wide runtime lowering available" {
+    const code = "a=0x100\nb=0x20\nprint(a*b)";
+    try std.testing.expectEqual(@as(?[]u8, null), try python.lowerCalc(std.testing.allocator, code));
