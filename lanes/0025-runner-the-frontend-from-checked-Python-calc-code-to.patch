+    }
+    fn less(_: void, x: Edit, y: Edit) bool {
+        return x.span.lo < y.span.lo or (x.span.lo == y.span.lo and x.span.hi < y.span.hi);
+    }
+    fn render(p: *Pass, s: Span, edits: []Edit) Error![]const u8 {
+        std.mem.sort(Edit, edits, {}, less);
