+    try t.expectEqual(steps, exact.estimated_steps.?);
+    const short = try fraction.lowerWithCost(t.allocator, code, steps - 1);
+    defer if (short) |lowered| t.allocator.free(lowered.source);
+    try t.expect(short == null);
+}
+
+test "Fraction frozen scripts and neighbors execute as opaque RV32 arithmetic with exact formatting" {
+    var env = try t.environ.createMap(t.allocator);
+    defer env.deinit();
+    const clang = env.get("TF_RUNNER_CLANG") orelse return error.SkipZigTest;
+    const root = env.get("TF_RUNNER_QWENPUTER") orelse return error.SkipZigTest;
+    for (frozen ++ neighbors) |case| {
+        const lowered = (try fraction.lowerWithCost(t.allocator, case.code, 0)).?;
+        defer t.allocator.free(lowered.source);
+        const elf = (try compiler.compile(t.allocator, t.io, lowered.source, .{
+            .clang = clang,
+            .linker = env.get("TF_RUNNER_LLD"),
+            .step_budget = 0,
+            .opaque_inputs = true,
+            .optimize = .O2,
+        })) orelse return error.UnexpectedAbstention;
+        defer t.allocator.free(elf);
+        try reference.check(root, env.get("TF_RUNNER_REFERENCE_PYTHON") orelse "/usr/bin/python3", .{
+            .kind = .elf,
+            .bytes = elf,
+        }, case.expected);
+    }
+}
+
+test "Fraction comment bytes preserve Python syntax refusal" {
+    try t.expectEqual(@as(?@import("runner_frontend_integer.zig").Lowered, null), try fraction.lowerWithCost(t.allocator, "print(12/3) #\x00", 10522));
+}
diff --git a/zig/src/core/runner_frontend_inline.zig b/zig/src/core/runner_frontend_inline.zig
new file mode 100644
index 000000000..f0d6a808b
--- /dev/null
+++ b/zig/src/core/runner_frontend_inline.zig
@@ -0,0 +1,246 @@
+const std = @import("std");
+const ast = @import("runner_frontend_inline_ast.zig");
+const calc = @import("runner_frontend_calc.zig");
+const Allocator = std.mem.Allocator;
+const Failure = Allocator.Error || ast.Invalid;
+
+// Proof values select a format and admission only; emitted expressions retain source arithmetic.
+pub fn lower(a: Allocator, code: []const u8, exact: bool) Allocator.Error!?[]u8 {
+    if (code.len == 0 or code.len > 1024) return null;
+    // `^` is a power in math notation (Python's XOR), so only exact inline math takes it
+    if (!exact and std.mem.indexOfScalar(u8, code, '^') != null) return null;
+    var arena = std.heap.ArenaAllocator.init(a);
+    defer arena.deinit();
+    const scratch = arena.allocator();
+    const source = try normalize(scratch, code) orelse return null;
+    var parser = ast.Parser{ .source = source };
+    const root = parser.parse() catch return null;
+    if (!exact and parser.exact_syntax) return null;
+    const emitter = Emitter{ .a = scratch, .parser = &parser };
+    if (!parser.decimal_context) {
+        const canonical = emitter.canonical(root) catch |err| return failure(err);
+        return calc.lower(a, canonical);
+    }
+    // Keep decimal arithmetic integral until the final scale; firmware can miscompare a shifted zero.
+    const k = finiteScale(parser.nodes[root].value.d) orelse return null;
+    const rep = emitter.represent(root) catch |err| return failure(err);
+    const integer = emitter.scaledInteger(rep, k) catch |err| return failure(err);
+    const output = if (k == 0) integer else blk: {
+        const reciprocal = try scratch.alloc(u8, k + 2);
+        reciprocal[0] = '0';
+        reciprocal[1] = '.';
+        @memset(reciprocal[2..], '0');
+        reciprocal[k + 1] = '1';
+        break :blk emitter.binary(integer, "*", reciprocal) catch |err| return failure(err);
+    };
+    return calc.lower(a, output);
+}
+
+fn failure(err: Failure) Allocator.Error!?[]u8 {
+    return switch (err) {
+        error.OutOfMemory => error.OutOfMemory,
+        error.Unsupported => null,
+    };
+}
+
+fn normalize(a: Allocator, code: []const u8) Allocator.Error!?[]u8 {
+    var out: std.ArrayList(u8) = .empty;
+    errdefer out.deinit(a);
+    for (code) |c| if (c == '\n' or c == '\r') return null;
+    var pos: usize = 0;
+    while (pos < code.len) {
+        var replaced = false;
+        const symbols = [_][]const u8{ "×", "÷", "−", "^" };
+        const operators = [_][]const u8{ "*", "/", "-", "**" };
+        for (symbols, operators) |symbol, op| {
+            if (std.mem.startsWith(u8, code[pos..], symbol)) {
+                try out.appendSlice(a, op);
+                pos += symbol.len;
+                replaced = true;
+                break;
+            }
+        }
+        if (!replaced) {
+            try out.append(a, code[pos]);
+            pos += 1;
+        }
+    }
+    return try out.toOwnedSlice(a);
+}
+
+fn finiteScale(denominator: i512) ?usize {
+    var d = denominator;
+    var two: usize = 0;
+    var five: usize = 0;
+    while (@mod(d, 2) == 0) : (two += 1) d = @divTrunc(d, 2);
+    while (@mod(d, 5) == 0) : (five += 1) d = @divTrunc(d, 5);
+    const k = @max(two, five);
+    return if (d == 1 and k <= 61) k else null;
+}
+
+const Rep = struct { n: []const u8, d: ?[]const u8 = null, scale: i32 = 0 };
+const Emitter = struct {
+    a: Allocator,
+    parser: *const ast.Parser,
+
+    fn binary(self: Emitter, left: []const u8, op: []const u8, right: []const u8) Failure![]const u8 {
+        if (left.len + right.len + op.len + 2 > 255) return error.Unsupported;
+        return std.fmt.allocPrint(self.a, "({s}{s}{s})", .{ left, op, right });
+    }
+
+    fn times(self: Emitter, left: []const u8, right: []const u8) Failure![]const u8 {
+        if (std.mem.eql(u8, left, "1")) return right;
+        if (std.mem.eql(u8, right, "1")) return left;
+        return self.binary(left, "*", right);
+    }
+
+    fn denominators(self: Emitter, left: ?[]const u8, right: ?[]const u8) Failure!?[]const u8 {
+        if (left == null) return right;
+        if (right == null) return left;
+        return try self.times(left.?, right.?);
+    }
+
+    fn ten(self: Emitter, exponent: i32) Failure![]const u8 {
+        if (exponent < 0 or exponent > 61) return error.Unsupported;
+        const text = try self.a.alloc(u8, @as(usize, @intCast(exponent)) + 1);
+        @memset(text, '0');
+        text[0] = '1';
+        return text;
+    }
+
+    fn shift(self: Emitter, text: []const u8, exponent: i32) Failure![]const u8 {
+        return self.times(text, try self.ten(exponent));
+    }
+
+    fn literal(self: Emitter, text: []const u8, point: bool) Failure![]const u8 {
+        var out: std.ArrayList(u8) = .empty;
+        if (point and text[0] == '.') try out.append(self.a, '0');
+        for (text) |c| if (c != '.' or point) try out.append(self.a, c);
+        var result = out.items;
+        while (result.len > 1 and result[0] == '0' and result[1] != '.') result = result[1..];
+        return result;
+    }
+
+    fn canonical(self: Emitter, index: usize) Failure![]const u8 {
+        const node = self.parser.nodes[index];
+        if (node.kind == .literal) return self.literal(node.text, true);
+        const left = try self.canonical(node.left);
+        if (node.kind == .neg) return std.fmt.allocPrint(self.a, "(-{s})", .{left});
+        if (node.kind == .percent) return self.binary(left, "/", "100");
+        const op: []const u8 = switch (node.kind) {
+            .add => "+",
+            .sub => "-",
+            .mul => "*",
+            .div => "/",
+            .floor => "//",
+            .pow => "**",
+            else => return error.Unsupported,
+        };
+        return self.binary(left, op, try self.canonical(node.right));
+    }
+
+    fn scaledInteger(self: Emitter, rep: Rep, scale: usize) Failure![]const u8 {
+        const delta = @as(i32, @intCast(scale)) - rep.scale;
+        const n = if (delta > 0) try self.shift(rep.n, delta) else rep.n;
+        const d: ?[]const u8 = if (delta < 0) try self.shift(rep.d orelse "1", -delta) else rep.d;
+        return if (d) |denominator| self.binary(n, "//", denominator) else n;
+    }
+
+    fn represent(self: Emitter, index: usize) Failure!Rep {
+        const node = self.parser.nodes[index];
+        if (node.kind == .literal) {
+            const dot = std.mem.indexOfScalar(u8, node.text, '.');
+            return .{
+                .n = try self.literal(node.text, false),
+                .scale = if (dot) |pos| @intCast(node.text.len - pos - 1) else 0,
+            };
+        }
+        var left = try self.represent(node.left);
+        if (node.kind == .neg) {
+            left.n = try std.fmt.allocPrint(self.a, "(-{s})", .{left.n});
+            return left;
+        }
+        if (node.kind == .percent) {
+            left.scale += 2;
+            if (@abs(left.scale) > 124) return error.Unsupported;
+            return left;
+        }
+        const right = try self.represent(node.right);
+        var result: Rep = undefined;
+        switch (node.kind) {
+            .add, .sub => {
+                const scale = @max(left.scale, right.scale);
+                const a = try self.shift(try self.times(left.n, right.d orelse "1"), scale - left.scale);
+                const b = try self.shift(try self.times(right.n, left.d orelse "1"), scale - right.scale);
+                result = .{
+                    .n = try self.binary(a, if (node.kind == .add) "+" else "-", b),
+                    .d = try self.denominators(left.d, right.d),
+                    .scale = scale,
+                };
+            },
+            .mul => result = .{
+                .n = try self.binary(left.n, "*", right.n),
+                .d = try self.denominators(left.d, right.d),
+                .scale = left.scale + right.scale,
+            },
+            .div => result = .{
+                .n = try self.times(left.n, right.d orelse "1"),
+                .d = try self.times(left.d orelse "1", right.n),
+                .scale = left.scale - right.scale,
+            },
+            .floor => result = .{ .n = try self.binary(
+                try self.scaledInteger(left, 0),
+                "//",
+                try self.scaledInteger(right, 0),
+            ) },
+            .pow => {
+                if (right.d != null or right.scale != 0) return error.Unsupported;
+                const exponent: i32 = @intCast(self.parser.nodes[node.right].value.n);
+                result = .{
+                    .n = try self.binary(left.n, "**", right.n),
+                    .d = if (left.d) |d| try self.binary(d, "**", right.n) else null,
+                    .scale = left.scale * exponent,
+                };
+            },
+            else => return error.Unsupported,
+        }
+        if (@abs(result.scale) > 124) return error.Unsupported;
+        return result;
+    }
+};
+
+test "inline normalization and exact decimal arithmetic retain source operands" {
+    const a = std.testing.allocator;
+    const bytes = (try lower(a, "1.25 × 2.4", true)).?;
+    defer a.free(bytes);
+    try std.testing.expect(std.mem.indexOf(u8, bytes, "125") != null);
+    try std.testing.expect(std.mem.indexOf(u8, bytes, "24") != null);
+    const fraction = (try lower(a, "11 ÷ 18", true)).?;
+    defer a.free(fraction);
+    try std.testing.expectEqualStrings("(11/18)", fraction);
+    const normalized = (try normalize(a, "−.5 × 2")).?;
+    defer a.free(normalized);
+    try std.testing.expectEqualStrings("-.5 * 2", normalized);
+}
+
+test "finite decimal division emits arithmetic rather than the host answer" {
+    const a = std.testing.allocator;
+    const bytes = (try lower(a, "1.0/8", true)).?;
+    defer a.free(bytes);
+    try std.testing.expect(std.mem.indexOf(u8, bytes, "//") != null);
+    try std.testing.expect(std.mem.indexOf(u8, bytes, "0.001") != null);
+    try std.testing.expect(std.mem.indexOf(u8, bytes, "0.125") == null);
+}
+
+test "malformed prose repeating decimals and exact syntax with exact off abstain" {
+    const bad = [_][]const u8{
+        "+2",    "2.",  "2+",    "(2",      "2,3", "x+1",  "print(2)", ">>> 2", "2=", "2#x", "2\n",
+        "1.0/3", "1/0", "2**-1", "2**1000", "2%%", "2(3)", "50%3",
+    };
+    for (bad) |code| try std.testing.expectEqual(@as(?[]u8, null), try lower(std.testing.allocator, code, true));
+    for ([_][]const u8{ "1.0", "50%", "4/2", "0.0+1" }) |code|
+        try std.testing.expectEqual(@as(?[]u8, null), try lower(std.testing.allocator, code, false));
+    const integer = (try lower(std.testing.allocator, "-7//3", false)).?;
+    defer std.testing.allocator.free(integer);
+    try std.testing.expectEqualStrings("((-7)//3)", integer);
+}
diff --git a/zig/src/core/runner_frontend_inline_ast.zig b/zig/src/core/runner_frontend_inline_ast.zig
new file mode 100644
index 000000000..f55943ba1
--- /dev/null
+++ b/zig/src/core/runner_frontend_inline_ast.zig
@@ -0,0 +1,199 @@
+const std = @import("std");
+
+pub const Invalid = error{Unsupported};
+pub const limit: i512 = std.math.pow(i512, 10, 62);
+pub const Value = struct { n: i512, d: i512 = 1 };
+pub const Kind = enum { literal, neg, add, sub, mul, div, floor, pow, percent };
+pub const Node = struct {
+    kind: Kind,
+    value: Value,
+    left: usize = 0,
+    right: usize = 0,
+    text: []const u8 = "",
+};
+
+pub fn magnitude(n: i512) i512 {
+    return if (n < 0) -n else n;
+}
+
+pub fn checked(n: i512, d: i512) Invalid!Value {
+    if (d == 0) return error.Unsupported;
+    var x = magnitude(n);
+    var y = magnitude(d);
+    while (y != 0) {
+        const rem = @mod(x, y);
+        x = y;
+        y = rem;
+    }
+    const sign: i512 = if (d < 0) -1 else 1;
+    const v = Value{ .n = @divTrunc(n, x) * sign, .d = @divTrunc(d, x) * sign };
+    if (magnitude(v.n) >= limit or v.d >= limit) return error.Unsupported;
+    return v;
+}
+
+fn product(a: Value, b: Value) Invalid!Value {
+    return checked(a.n * b.n, a.d * b.d);
+}
+
+pub const Parser = struct {
+    source: []const u8,
+    pos: usize = 0,
+    nodes: [32]Node = undefined,
+    count: usize = 0,
+    decimal_context: bool = false,
+    exact_syntax: bool = false,
+
+    pub fn parse(self: *Parser) Invalid!usize {
+        self.space();
+        if (self.pos == self.source.len or self.source[self.pos] == '+') return error.Unsupported;
+        const root = try self.expr(0);
+        self.space();
+        if (self.pos != self.source.len) return error.Unsupported;
+        return root;
+    }
+
+    fn space(self: *Parser) void {
+        while (self.pos < self.source.len and (self.source[self.pos] == ' ' or self.source[self.pos] == '\t'))
+            self.pos += 1;
+    }
+
+    fn take(self: *Parser, s: []const u8) bool {
+        self.space();
+        if (!std.mem.startsWith(u8, self.source[self.pos..], s)) return false;
+        self.pos += s.len;
+        return true;
+    }
+
+    fn append(self: *Parser, node: Node) Invalid!usize {
+        if (self.count == self.nodes.len) return error.Unsupported;
+        const index = self.count;
+        self.nodes[index] = node;
+        self.count += 1;
+        return index;
+    }
+
+    fn binary(self: *Parser, kind: Kind, left: usize, right: usize) Invalid!usize {
+        const a = self.nodes[left].value;
+        const b = self.nodes[right].value;
+        const value: Value = switch (kind) {
+            .add => try checked(a.n * b.d + b.n * a.d, a.d * b.d),
+            .sub => try checked(a.n * b.d - b.n * a.d, a.d * b.d),
+            .mul => try product(a, b),
+            .div => try checked(a.n * b.d, a.d * b.n),
+            .floor => blk: {
+                if (a.d != 1 or b.d != 1 or b.n == 0) return error.Unsupported;
+                break :blk try checked(@divFloor(a.n, b.n), 1);
+            },
+            .pow => blk: {
+                if (b.d != 1 or b.n < 0 or b.n > 999) return error.Unsupported;
+                var exponent = b.n;
+                var base = a;
+                var result = Value{ .n = 1 };
+                while (exponent != 0) {
+                    if (@mod(exponent, 2) != 0) result = try product(result, base);
+                    exponent = @divTrunc(exponent, 2);
+                    if (exponent != 0) base = try product(base, base);
+                }
+                break :blk result;
+            },
+            else => return error.Unsupported,
+        };
+        return self.append(.{ .kind = kind, .left = left, .right = right, .value = value });
+    }
+
+    fn expr(self: *Parser, depth: usize) Invalid!usize {
+        if (depth > 10) return error.Unsupported;
+        var left = try self.term(depth);
+        while (true) {
+            const kind: Kind = if (self.take("+")) .add else if (self.take("-")) .sub else break;
+            left = try self.binary(kind, left, try self.term(depth));
+        }
+        return left;
+    }
+
+    fn term(self: *Parser, depth: usize) Invalid!usize {
+        var left = try self.factor(depth);
+        while (true) {
+            self.space();
+            if (std.mem.startsWith(u8, self.source[self.pos..], "**")) return error.Unsupported;
+            const kind: Kind = if (self.take("//")) .floor else if (self.take("/")) .div else if (self.take("*")) .mul else break;
+            if (kind == .div) self.exact_syntax = true;
+            left = try self.binary(kind, left, try self.factor(depth));
+        }
+        return left;
+    }
+
+    fn factor(self: *Parser, depth: usize) Invalid!usize {
+        if (depth > 10) return error.Unsupported;
+        if (self.take("+")) return self.factor(depth + 1);
+        if (self.take("-")) {
+            const child = try self.factor(depth + 1);
+            const v = self.nodes[child].value;
+            return self.append(.{ .kind = .neg, .left = child, .value = .{ .n = -v.n, .d = v.d } });
+        }
+        var left = try self.atom(depth);
+        if (self.take("%")) {
+            self.decimal_context = true;
+            self.exact_syntax = true;
+            const v = self.nodes[left].value;
+            left = try self.append(.{ .kind = .percent, .left = left, .value = try checked(v.n, v.d * 100) });
+        }
+        if (self.take("**")) {
+            left = try self.binary(.pow, left, try self.factor(depth + 1));
+        }
+        return left;
+    }
+
+    fn atom(self: *Parser, depth: usize) Invalid!usize {
+        if (self.take("(")) {
+            const child = try self.expr(depth + 1);
+            if (!self.take(")")) return error.Unsupported;
+            return child;
+        }
+        self.space();
+        const start = self.pos;
+        var n: i512 = 0;
+        var digits: usize = 0;
+        var scale: usize = 0;
+        var dot = false;
+        while (self.pos < self.source.len) {
+            const c = self.source[self.pos];
+            if (std.ascii.isDigit(c)) {
+                digits += 1;
+                if (digits > 62) return error.Unsupported;
+                n = n * 10 + c - '0';
+                if (dot) scale += 1;
+            } else if (c == '.' and !dot) {
+                dot = true;
+            } else break;
+            self.pos += 1;
+        }
+        if (digits == 0 or (dot and scale == 0)) return error.Unsupported;
+        if (dot) {
+            self.decimal_context = true;
+            self.exact_syntax = true;
+        }
+        return self.append(.{
+            .kind = .literal,
+            .text = self.source[start..self.pos],
+            .value = try checked(n, std.math.pow(i512, 10, scale)),
+        });
+    }
+};
+
+test "inline proof respects precedence right association and percentage scale" {
+    const cases = [_]struct { code: []const u8, n: i512, d: i512 = 1 }{
+        .{ .code = "2**3**2", .n = 512 },
+        .{ .code = "-2**2", .n = -4 },
+        .{ .code = "(-2)**2", .n = 4 },
+        .{ .code = "50%", .n = 1, .d = 2 },
+        .{ .code = "-.5/2", .n = -1, .d = 4 },
+        .{ .code = "-7//3", .n = -3 },
+    };
+    for (cases) |case| {
+        var parser = Parser{ .source = case.code };
+        const root = try parser.parse();
+        try std.testing.expectEqual(case.n, parser.nodes[root].value.n);
+        try std.testing.expectEqual(case.d, parser.nodes[root].value.d);
+    }
+}
diff --git a/zig/src/core/runner_frontend_integer.zig b/zig/src/core/runner_frontend_integer.zig
new file mode 100644
index 000000000..1f1422a46
--- /dev/null
+++ b/zig/src/core/runner_frontend_integer.zig
@@ -0,0 +1,178 @@
+const std = @import("std");
+const ast = @import("runner_frontend_integer_ast.zig");
+const compiler = @import("runner_frontend_program_compile.zig");
+const cost = @import("runner_frontend_integer_cost.zig");
+
+/// graph_only: only the graph route takes the table (lists, more than eight values); `source` is empty.
+pub const Lowered = struct { source: []u8, estimated_steps: ?usize, table: ?Table = null, graph_only: bool = false };
+
+/// A lowered script's DAG and ordered outputs, the data the runtime evaluates; literal text is dropped (use value).
+pub const Table = struct {
+    nodes: [ast.max_nodes]ast.Node = undefined,
+    count: usize = 0,
+    roots: [32]usize = undefined,
+    endings: [32]u8 = undefined, // ' ', '\n', or ',' between a printed list's elements
+    styles: [32]u8 = @splat(0), // 0 integer/bool/tuple, 1 exact integral float, 2 fixed Decimal
+    scales: [32]u8 = @splat(0),
+    brackets: [32]u8 = @splat(0), // 1: a list's `[` before the value, 2: its `]` after
+    outputs: usize = 0,
+};
+
+/// The table lowerFormatted renders as C; a non-literal node's value is a proof, never a result to print.
+pub fn table(parser: *const ast.Parser, roots: []const usize, endings: []const u8, styles: ?[]const u8, scales: ?[]const u8) Table {
+    var t: Table = .{ .count = parser.count, .outputs = roots.len };
+    for (parser.nodes[0..parser.count], t.nodes[0..parser.count]) |n, *m| m.* = .{ .op = n.op, .l = n.l, .r = n.r, .k = n.k, .value = n.value };
+    @memcpy(t.roots[0..roots.len], roots);
+    @memcpy(t.endings[0..roots.len], endings);
+    if (styles) |s| @memcpy(t.styles[0..roots.len], s);
+    if (scales) |s| @memcpy(t.scales[0..roots.len], s);
+    return t;
+}
+
+pub fn ambiguousPercent(a: std.mem.Allocator, source: []const u8) std.mem.Allocator.Error!bool {
+    if (std.mem.indexOfScalar(u8, source, '%') == null) return false;
+    var parser = ast.Parser{ .source = source };
+    _ = parser.parse() catch return false;
+    const percentage = try @import("runner_frontend_inline.zig").lower(a, source, true) orelse return false;
+    defer a.free(percentage);
+    return true;
+}
+
+// Proof values decide admission; emitted nodes retain the requested arithmetic and original literal values.
+pub fn lower(a: std.mem.Allocator, source: []const u8) std.mem.Allocator.Error!?[]u8 {
+    const result = try lowerWithCost(a, source, 0) orelse return null;
+    return result.source;
+}
+
+pub fn lowerWithCost(a: std.mem.Allocator, source: []const u8, budget: usize) std.mem.Allocator.Error!?Lowered {
+    var code = std.mem.trim(u8, source, " \t\r\n");
+    if (std.mem.startsWith(u8, code, ">>> ")) code = std.mem.trim(u8, code[4..], " \t\r\n");
+    if (std.mem.startsWith(u8, code, "print")) {
+        const rest = std.mem.trimStart(u8, code[5..], " \t");
+        if (rest.len < 3 or rest[0] != '(' or rest[rest.len - 1] != ')') return null;
+        code = rest[1 .. rest.len - 1];
+    }
+    if (code.len == 0 or code.len > 4096) return null;
+    var parser = ast.Parser{ .source = code };
+    const root = parser.parse() catch return null;
+    var steps: ?usize = null;
+    if (budget != 0) steps = cost.estimate(&parser, root, budget) orelse return null;
+    return .{ .source = try lowerParser(a, &parser, root), .estimated_steps = steps };
+}
+
+// Emit only a successfully proved root; proof values never replace operations or literal text.
+pub fn lowerParser(a: std.mem.Allocator, parser: *ast.Parser, root: usize) std.mem.Allocator.Error![]u8 {
+    var out: std.ArrayList(u8) = .empty;
+    errdefer out.deinit(a);
+    try out.appendSlice(a, @embedFile("runner_frontend_integer_runtime.c"));
+    try out.appendSlice(a, "\nstatic const struct tf_node tf_nodes[] = {\n");
+    var emitter = Emitter{ .a = a, .parser = parser, .out = &out };
+    _ = try emitter.node(root);
+    try out.print(a, "}};\nint main(void) {{ return tf_run(tf_nodes, {d}); }}\n", .{emitter.count});
+    return try out.toOwnedSlice(a);
+}
+
+// All ordered print roots share one original DAG and are evaluated before the first output.
+pub fn lowerParsers(a: std.mem.Allocator, parser: *ast.Parser, roots: []const usize) std.mem.Allocator.Error![]u8 {
+    const endings: [8]u8 = @splat('\n');
+    return lowerPrints(a, parser, roots, endings[0..roots.len]);
+}
+
+// A space continues a grouped print and a newline ends it; all roots share their original runtime nodes.
+pub fn lowerPrints(a: std.mem.Allocator, parser: *ast.Parser, roots: []const usize, endings: []const u8) std.mem.Allocator.Error![]u8 {
+    const defaults: [8]u8 = @splat(0);
+    return lowerFormatted(a, parser, roots, endings, defaults[0..roots.len], defaults[0..roots.len]);
+}
+
+// Styles: 0 ordinary integer/bool/tuple, 1 exact integral float, 2 fixed Decimal.
+pub fn lowerFormatted(a: std.mem.Allocator, parser: *ast.Parser, roots: []const usize, endings: []const u8, styles: []const u8, scales: []const u8) std.mem.Allocator.Error![]u8 {
+    std.debug.assert(roots.len > 0 and roots.len <= 8 and endings.len == roots.len);
+    for (endings) |ending| std.debug.assert(ending == ' ' or ending == '\n');
+    std.debug.assert(styles.len == roots.len and scales.len == roots.len);
+    var formatted = false;
+    for (styles, scales) |style, scale| {
+        std.debug.assert(style <= 2 and scale <= 6);
+        formatted = formatted or style != 0;
+    }
+    if (!formatted and roots.len == 1 and endings[0] == '\n') return lowerParser(a, parser, roots[0]);
+    var out: std.ArrayList(u8) = .empty;
+    errdefer out.deinit(a);
+    try out.appendSlice(a, @embedFile("runner_frontend_integer_runtime.c"));
+    try out.appendSlice(a, "\nstatic const struct tf_node tf_nodes[] = {\n");
+    var emitter = Emitter{ .a = a, .parser = parser, .out = &out };
+    var refs: [8]usize = undefined;
+    for (roots, 0..) |root, i| refs[i] = try emitter.node(root);
+    try out.appendSlice(a, "};\nstatic const int tf_roots[] = {");
+    for (refs[0..roots.len]) |ref| try out.print(a, "{d},", .{ref});
+    try out.appendSlice(a, "};\nstatic const unsigned char tf_endings[] = {");
+    for (endings) |ending| try out.print(a, "{d},", .{ending});
+    if (formatted) {
+        try out.appendSlice(a, "};\nstatic const unsigned char tf_styles[] = {");
+        for (styles) |style| try out.print(a, "{d},", .{style});
+        try out.appendSlice(a, "};\nstatic const unsigned char tf_scales[] = {");
+        for (scales) |scale| try out.print(a, "{d},", .{scale});
+        try out.print(a, "}};\nint main(void) {{ return tf_run_formatted(tf_nodes, {d}, tf_roots, tf_endings, " ++
+            "tf_styles, tf_scales, {d}); }}\n", .{ emitter.count, roots.len });
+    } else {
+        try out.print(a, "}};\nint main(void) {{ return tf_run_prints(tf_nodes, {d}, tf_roots, tf_endings, {d}); }}\n", .{
+            emitter.count, roots.len,
+        });
+    }
+    return try out.toOwnedSlice(a);
+}
+
+pub fn compile(a: std.mem.Allocator, io: std.Io, code: []const u8, config: compiler.Config) std.mem.Allocator.Error!?[]u8 {
+    const result = try lowerWithCost(a, code, config.step_budget) orelse return null;
+    defer a.free(result.source);
+    var runtime_config = config;
+    runtime_config.estimated_steps = result.estimated_steps;
+    if (runtime_config.optimize != .O0) runtime_config.optimize = .O2;
+    runtime_config.opaque_inputs = true;
+    return compiler.compile(a, io, result.source, runtime_config);
+}
+
+const Emitter = struct {
+    a: std.mem.Allocator,
+    parser: *const ast.Parser,
+    out: *std.ArrayList(u8),
+    count: usize = 0,
+    mapped: [64]?usize = @splat(null),
+
+    fn node(self: *Emitter, index: usize) std.mem.Allocator.Error!usize {
+        if (self.mapped[index]) |mapped| return mapped;
+        const n = self.parser.nodes[index];
+        var l: usize = 0;
+        var r: usize = 0;
+        var k: usize = 0;
+        if (n.op != .literal) l = try self.node(n.l);
+        switch (n.op) {
+            .literal, .neg, .digits, .isqrt, .factorial, .digit_sum => {},
+            else => r = try self.node(n.r),
+        }
+        if (n.op == .powmod or n.op == .range_product) k = try self.node(n.k);
+        if (n.op == .literal) {
+            try self.out.print(self.a, "{{0,0,0,{d},\"{s}{s}\"}},\n", .{
+                n.base, if (n.value < 0) "-" else "", n.text,
+            });
+        } else {
+            var op: u8 = @backingInt(n.op);
+            if (n.op == .mod) {
+                for (self.parser.nodes[0..self.parser.count], 0..) |prior, j| {
+                    if ((prior.op == .floor or prior.op == .divmod) and prior.l == n.l and prior.r == n.r) {
+                        if (self.mapped[j]) |ref| {
+                            op = 22;
+                            l = ref;
+                            r = 0;
+                            break;
+                        }
+                    }
+                }
+            }
+            try self.out.print(self.a, "{{{d},{d},{d},{d},0}},\n", .{ op, l, r, k });
+        }
+        const result = self.count;
+        self.count += 1;
+        self.mapped[index] = result;
+        return result;
+    }
+};
