+    \\def lcm(a, b):
+    \\    return a // gcd(a, b) * b
+    \\n = 1
+    \\for k in range(1, 6):
+    \\    n = lcm(n, k)
+    \\print("LCM:", n)
+    \\print("Divisible:", all(n % d == 0 for d in range(1, 6)))
+    \\m = 1
+    \\while not all(m % d == 0 for d in range(1, 6)):
+    \\    m += 1
+    \\print("Brute force:", m)
+;
+
