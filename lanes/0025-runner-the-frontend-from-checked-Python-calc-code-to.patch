index 000000000..392d505a0
--- /dev/null
+++ b/zig/src/core/runner_frontend_calc_cost_test.zig
@@ -0,0 +1,71 @@
+const std = @import("std");
+const value = @import("runner_frontend_value.zig");
+const t = std.testing;
+const cap: usize = 10_522;
+const unlimited = std.math.maxInt(usize);
+const multiply30 = "123456789012345678901234567890*987654321098765432109876543210";
+
+test "calc cost admits the exact boundary and rejects smaller budgets" {
+    for ([_][]const u8{
+        "1", "-1", "1+2", "2*3", "gcd(54,24)", "0**0", "2**1", "2**2", "2**3", multiply30,
+    }) |source| {
+        try t.expect(value.valid(source));
+        const full = value.estimate(source, unlimited) orelse return error.UnexpectedCostRefusal;
+        try t.expect(full > 0);
+        try t.expectEqual(@as(?usize, full), value.estimate(source, full));
+        try t.expectEqual(@as(?usize, full), value.estimate(source, full + 1));
+        try t.expectEqual(@as(?usize, null), value.estimate(source, full - 1));
+        try t.expectEqual(@as(?usize, null), value.estimate(source, 0));
+    }
+    try t.expect(value.estimate("2**3", unlimited).? > value.estimate("2**2", unlimited).?);
+    try t.expect(value.estimate("2**2", unlimited).? > value.estimate("2**1", unlimited).?);
+}
+
+test "calc cost leaves headroom for the known power and multiply firmware cases" {
+    for ([_][]const u8{ "2**100", "2**100-3**50", multiply30 }) |source| {
+        const steps = value.estimate(source, cap) orelse return error.UnexpectedCostRefusal;
+        try t.expect(steps <= cap);
+    }
+    try t.expect(value.estimate("2**100-3**50", unlimited).? > value.estimate("2**100", unlimited).?);
+}
+
+test "calc cost is monotone in budget and rejects composite expensive work" {
+    const twice = multiply30 ++ "+" ++ multiply30;
+    const thrice = twice ++ "+" ++ multiply30;
+    try t.expect(value.valid(thrice));
+    try t.expect(value.estimate(twice, cap) != null);
+    try t.expect(value.estimate(thrice, cap) == null);
+    const full = value.estimate(thrice, unlimited).?;
+    for ([_]usize{ 0, 200, 1000, cap, full - 1, full, full + 1, unlimited }) |budget| {
+        const result = value.estimate(thrice, budget);
+        if (budget < full) try t.expect(result == null) else try t.expectEqual(@as(?usize, full), result);
+    }
+}
+
+test "calc cost follows fractional reduction decimal alignment and Euclidean paths" {
+    for ([_][]const u8{
+        "1/3+2/3", "11/18", "1.25*2.4", "1.2+3", "7//-3", "-7%3", "gcd(0,0)", "gcd(-54,24)",
+    }) |source| {
+        try t.expect(value.valid(source));
+        try t.expect(value.estimate(source, unlimited) != null);
+    }
+    try t.expect(value.estimate("1/2", unlimited).? > value.estimate("1/1", unlimited).?);
+    try t.expect(value.estimate("gcd(89,55)", unlimited).? > value.estimate("gcd(99,33)", unlimited).?);
+    try t.expect(value.estimate("1.2+3", unlimited).? > value.estimate("12+3", unlimited).?);
+    try t.expect(value.estimate("1.2*3.4", unlimited).? > value.estimate("12*34", unlimited).?);
+    const nines: [62]u8 = @splat('9');
+    const ones: [61]u8 = @splat('1');
+    const wide_gcd = "gcd(" ++ nines ++ "," ++ ones ++ ")";
+    try t.expect(value.valid(wide_gcd));
+    try t.expect(value.estimate(wide_gcd, cap) == null);
+}
+
+test "calc cost rejects invalid canonical syntax overflow and arithmetic errors" {
+    const over_digits: [63]u8 = @splat('9');
+    const over_source: [256]u8 = @splat('1');
+    for ([_][]const u8{
+        "",        ".",       " ",          "1 2",        "1+",   "2(3)", "(1",         "1)",       "unknown(1)", "gcd(1)",
+        "10**100", "2**1000", "2**-1",      "1/0",        "1//0", "1%0",  "gcd(1/2,3)", "(1/2)**3", "1e10",       "1.2/3",
+        "1.2%3",   "1.2+1/3", &over_digits, &over_source,
+    }) |source| try t.expectEqual(@as(?usize, null), value.estimate(source, unlimited));
+}
diff --git a/zig/src/core/runner_frontend_collections.zig b/zig/src/core/runner_frontend_collections.zig
new file mode 100644
index 000000000..8d6f4094e
--- /dev/null
+++ b/zig/src/core/runner_frontend_collections.zig
@@ -0,0 +1,22 @@
+const std = @import("std");
+const ast = @import("runner_frontend_collections_ast.zig");
+const parser = @import("runner_frontend_collections_parse.zig");
+const proof = @import("runner_frontend_collections_proof.zig");
+const emitter = @import("runner_frontend_collections_emit.zig");
+pub const Lowered = struct { source: []u8, estimated_steps: usize };
+
+pub fn lowerWithCost(a: std.mem.Allocator, source: []const u8) std.mem.Allocator.Error!?Lowered {
+    if (source.len == 0 or source.len > 4096 or std.mem.indexOfScalar(u8, source, 0) != null) return null;
+    var arena = std.heap.ArenaAllocator.init(a);
+    defer arena.deinit();
+    var p: ast.Program = .{ .a = arena.allocator() };
+    parser.parse(&p, source) catch |err| return switch (err) {
+        error.Unsupported => null,
+        error.OutOfMemory => error.OutOfMemory,
+    };
+    proof.prove(&p) catch |err| return switch (err) {
+        error.Unsupported => null,
+        error.OutOfMemory => error.OutOfMemory,
+    };
+    return .{ .source = try emitter.emit(a, &p), .estimated_steps = p.stats.steps };
+}
diff --git a/zig/src/core/runner_frontend_collections_ast.zig b/zig/src/core/runner_frontend_collections_ast.zig
new file mode 100644
index 000000000..faf45f0c3
--- /dev/null
+++ b/zig/src/core/runner_frontend_collections_ast.zig
@@ -0,0 +1,95 @@
+const std = @import("std");
+pub const Error = error{Unsupported} || std.mem.Allocator.Error;
+pub const Id = usize;
+pub const Tag = enum {
+    integer,
+    boolean,
+    none,
+    string,
+    name,
+    list,
+    tuple,
+    dict,
+    set,
+    call,
+    method,
+    index,
+    slice,
+    comprehension,
+    conditional,
+    add,
+    sub,
+    mul,
+    floor,
+    modulo,
+    neg,
+    pos,
+    logical_not,
+    eq,
+    ne,
+    lt,
+    le,
+    gt,
+    ge,
+    contains,
+    not_contains,
+    is_identity,
+    is_not,
+    logical_and,
+    logical_or,
+};
+pub const Node = struct {
+    tag: Tag,
+    value: i64 = 0,
+    text: []const u8 = "",
+    a: Id = 0,
+    b: Id = 0,
+    c: ?Id = null,
+    args: []const Id = &.{},
+    keywords: []const []const u8 = &.{},
+};
+pub const StmtTag = enum { assign, augassign, expression, print, conditional, for_loop, while_loop, function, ret, assertion, break_loop, continue_loop, pass };
+pub const Stmt = struct {
+    tag: StmtTag,
+    targets: []const Id = &.{},
+    expr: ?Id = null,
+    op: Tag = .add,
+    body: []const Stmt = &.{},
+    otherwise: []const Stmt = &.{},
+    function: usize = 0,
+};
+pub const Scope = struct {
+    names: std.ArrayList([]const u8) = .empty,
+    pub fn find(s: *const Scope, name: []const u8) ?usize {
+        for (s.names.items, 0..) |old, i| if (std.mem.eql(u8, old, name)) return i;
+        return null;
+    }
+    pub fn bind(s: *Scope, a: std.mem.Allocator, name: []const u8) Error!usize {
+        if (s.find(name)) |i| return i;
+        if (s.names.items.len == 64) return error.Unsupported;
+        try s.names.append(a, name);
+        return s.names.items.len - 1;
+    }
+};
+pub const Function = struct { name: []const u8, params: []const []const u8, scope: Scope = .{}, body: []const Stmt = &.{} };
+pub const Stats = struct { steps: usize = 0, cells: usize = 0, objects: usize = 0, chars: usize = 0, prints: usize = 0, depth: usize = 0 };
+pub const Program = struct {
+    a: std.mem.Allocator,
+    nodes: std.ArrayList(Node) = .empty,
+    functions: std.ArrayList(Function) = .empty,
+    globals: Scope = .{},
+    body: []const Stmt = &.{},
+    stats: Stats = .{},
+    pub fn node(p: *Program, n: Node) Error!Id {
+        if (p.nodes.items.len == 1024) return error.Unsupported;
+        try p.nodes.append(p.a, n);
+        return p.nodes.items.len - 1;
+    }
+    pub fn functionId(p: *const Program, name: []const u8) ?usize {
+        for (p.functions.items, 0..) |f, i| if (std.mem.eql(u8, f.name, name)) return i;
+        return null;
+    }
+};
+pub fn validName(name: []const u8) bool {
+    return @import("runner_frontend_python_ast.zig").validName(name);
+}
diff --git a/zig/src/core/runner_frontend_collections_builtins.zig b/zig/src/core/runner_frontend_collections_builtins.zig
new file mode 100644
index 000000000..bb9ce00bf
--- /dev/null
+++ b/zig/src/core/runner_frontend_collections_builtins.zig
@@ -0,0 +1,187 @@
+const std = @import("std");
+const v = @import("runner_frontend_collections_value.zig");
+const ops = @import("runner_frontend_collections_ops.zig");
+const ast = @import("runner_frontend_collections_ast.zig");
+const Value = v.Value;
+const Heap = v.Heap;
+const Error = ast.Error;
+fn is(name: []const u8, wanted: []const u8) bool {
+    return std.mem.eql(u8, name, wanted);
+}
+fn argc(args: []const Value, min: usize, max: usize) Error!void {
+    if (args.len < min or args.len > max) return error.Unsupported;
+}
+fn iterator(h: *Heap, kind: v.Kind, args: []const Value) Error!Value {
+    if (kind == .enumerate) {
+        if (!iteratorInput(args[0])) return error.Unsupported;
+    } else {
+        for (args) |x| {
+            if (!iteratorInput(x)) return error.Unsupported;
+        }
+    }
+    if (h.stats.cells + args.len > 1536) return error.Unsupported;
+    const out = try h.new(kind);
+    h.stats.cells += args.len;
+    try out.obj.?.items.appendSlice(h.a, args);
+    return out;
+}
+pub fn call(h: *Heap, name: []const u8, args: []const Value, keywords: []const []const u8) Error!Value {
+    try h.charge(24);
+    if (args.len > 3 or keywords.len != args.len) return error.Unsupported;
+    if (is(name, "sorted")) return sorted(h, args, keywords);
+    for (keywords) |key| if (key.len != 0) return error.Unsupported;
+    if (is(name, "len")) {
+        try argc(args, 1, 1);
+        return Value.int(@intCast(try v.length(args[0])));
+    }
+    if (is(name, "bool")) {
+        try argc(args, 0, 1);
+        return Value.boolean(args.len != 0 and try v.truth(args[0]));
+    }
+    if (is(name, "str")) {
+        try argc(args, 0, 1);
+        return if (args.len == 0) h.string("") else ops.string(h, args[0]);
+    }
+    if (is(name, "int")) {
+        try argc(args, 0, 1);
+        if (args.len == 0) return Value.int(0);
+        if (args[0].kind != .string) return Value.int(try args[0].numeric());
+        const s = std.mem.trim(u8, args[0].obj.?.text, " \t\n");
+        if (s.len == 0) return error.Unsupported;
+        var i: usize = @intFromBool(s[0] == '-' or s[0] == '+');
+        if (i == s.len) return error.Unsupported;
+        while (i < s.len) : (i += 1) if (!std.ascii.isDigit(s[i])) return error.Unsupported;
+        return Value.int(std.fmt.parseInt(i64, s, 10) catch return error.Unsupported);
+    }
+    if (is(name, "abs")) {
+        try argc(args, 1, 1);
+        const n = try args[0].numeric();
+        return Value.int(if (n < 0) -n else n);
+    }
+    if (is(name, "range")) {
+        try argc(args, 1, 3);
+        const start = if (args.len > 1) try args[0].numeric() else 0;
+        const stop = try args[@intFromBool(args.len > 1)].numeric();
+        const step = if (args.len == 3) try args[2].numeric() else 1;
+        if (step == 0) return error.Unsupported;
+        const out = try h.new(.range);
+        var i = start;
+        while (if (step > 0) i < stop else i > stop) : (i += step) try h.append(out, try Value.int(i));
+        return out;
+    }
+    if (is(name, "list") or is(name, "tuple") or is(name, "set")) {
+        try argc(args, 0, 1);
+        const kind: v.Kind = if (is(name, "list")) .list else if (is(name, "tuple")) .tuple else .set;
+        const out = try h.new(kind);
+        if (args.len == 0) return out;
+        var cursor: usize = 0;
+        while (try ops.next(h, args[0], &cursor)) |x| {
+            if (kind == .set) try h.setAdd(out, x) else try h.append(out, x);
+        }
+        return out;
+    }
+    if (is(name, "dict")) {
+        try argc(args, 0, 1);
+        const out = try h.new(.dict);
+        if (args.len == 0) return out;
+        if (args[0].kind == .dict) {
+            const data = args[0].obj.?.items.items;
+            var i: usize = 0;
+            while (i < data.len) : (i += 2) try h.dictSet(out, data[i], data[i + 1]);
+        } else {
+            var cursor: usize = 0;
+            while (try ops.next(h, args[0], &cursor)) |pair| {
+                if (try v.length(pair) != 2) return error.Unsupported;
+                const key = try ops.at(h, pair, 0);
+                const value = try ops.at(h, pair, 1);
+                try h.dictSet(out, key, value);
+            }
+        }
+        return out;
+    }
+    if (is(name, "enumerate")) {
+        try argc(args, 1, 2);
+        const start = if (args.len == 2) args[1] else try Value.int(0);
+        _ = try start.numeric();
+        return iterator(h, .enumerate, &.{ args[0], start });
+    }
+    if (is(name, "zip")) {
+        try argc(args, 0, 3);
+        return iterator(h, .zip, args);
+    }
+    if (is(name, "map")) {
+        try argc(args, 2, 2);
+        if (args[0].kind != .builtin or args[0].n != 2) return error.Unsupported;
+        return iterator(h, .map_str, args[1..]);
+    }
+    if (is(name, "sum")) {
+        try argc(args, 1, 2);
+        var sum = if (args.len == 2) args[1] else try Value.int(0);
+        _ = try sum.numeric();
+        var cursor: usize = 0;
+        while (try ops.next(h, args[0], &cursor)) |x| {
+            _ = try x.numeric();
+            sum = try ops.binary(h, .add, sum, x);
+        }
+        return sum;
+    }
+    if (is(name, "min") or is(name, "max")) {
+        try argc(args, 1, 3);
+        var values = args;
+        if (args.len == 1) values = (try ops.collect(h, args[0], false)).obj.?.items.items;
+        if (values.len == 0) return error.Unsupported;
+        var best = values[0];
+        for (values[1..]) |x| {
+            try h.charge(16);
+            if (try h.order(x, best) == (if (is(name, "min")) std.math.Order.lt else .gt)) best = x;
+        }
+        return best;
+    }
+    if (is(name, "any") or is(name, "all")) {
+        try argc(args, 1, 1);
+        var cursor: usize = 0;
+        while (try ops.next(h, args[0], &cursor)) |x| {
+            try h.charge(8);
+            if (try v.truth(x) == is(name, "any")) return Value.boolean(is(name, "any"));
+        }
+        return Value.boolean(is(name, "all"));
+    }
+    return error.Unsupported;
+}
+fn sorted(h: *Heap, args: []const Value, keywords: []const []const u8) Error!Value {
+    if (args.len == 0 or args.len > 3 or keywords[0].len != 0) return error.Unsupported;
+    var key: Value = .{};
+    var reverse = false;
+    for (args[1..], keywords[1..]) |arg, keyword| {
+        if (is(keyword, "key")) {
+            if (arg.kind != .none and (arg.kind != .builtin or arg.n != 1)) return error.Unsupported;
+            key = arg;
+        } else if (is(keyword, "reverse")) reverse = (try arg.numeric()) != 0 else return error.Unsupported;
+    }
+    const out = try ops.collect(h, args[0], true);
+    const data = out.obj.?.items.items;
+    var keys: [128]Value = undefined;
+    for (data, 0..) |item, i| keys[i] = if (key.kind == .builtin) try call(h, "sum", &.{item}, &.{""}) else item;
+    for (1..@max(1, data.len)) |i| {
+        const item = data[i];
+        const k = keys[i];
+        var j = i;
+        while (j > 0) {
+            const prior = data[j - 1];
+            const pk = keys[j - 1];
+            try h.charge(20);
+            const order = try h.order(pk, k);
+            if (if (reverse) order != .lt else order != .gt) break;
+            data[j] = prior;
+            keys[j] = pk;
+            j -= 1;
+        }
+        data[j] = item;
+        keys[j] = k;
+    }
+    return out;
+}
+
+fn iteratorInput(value: Value) bool {
+    return value.kind == .string or value.kind == .list or value.kind == .tuple or value.kind == .range;
+}
diff --git a/zig/src/core/runner_frontend_collections_compat_test.zig b/zig/src/core/runner_frontend_collections_compat_test.zig
new file mode 100644
index 000000000..12a9443ad
--- /dev/null
+++ b/zig/src/core/runner_frontend_collections_compat_test.zig
@@ -0,0 +1,29 @@
+const std = @import("std");
+const api = @import("runner_api.zig");
+const reference = @import("runner_frontend_reference_test.zig");
+const t = std.testing;
+
+// Call only for the fixed, finite test fixtures; never for arbitrary frontend input.
+pub fn checkExact(env: *const std.process.Environ.Map, program: api.Program, code: []const u8) !void {
+    const python = env.get("TF_RUNNER_REFERENCE_PYTHON") orelse "/usr/bin/python3";
+    const oracle = try std.process.run(t.allocator, t.io, .{
+        .argv = &.{ python, "-I", "-c", code },
+        .stdout_limit = .limited(16384),
+        .stderr_limit = .limited(16384),
+        .timeout = .{ .duration = .{ .raw = .fromSeconds(2), .clock = .awake } },
+    });
+    defer t.allocator.free(oracle.stdout);
+    defer t.allocator.free(oracle.stderr);
+    if (!oracle.term.success()) {
+        std.debug.print("frontend admitted a failing CPython fixture: {s}\n{s}\n", .{ code, oracle.stderr });
+        return error.InvalidPythonAdmission;
+    }
+    const root = env.get("TF_RUNNER_QWENPUTER") orelse return error.SkipZigTest;
+    try reference.check(root, python, program, oracle.stdout);
+}
+
+pub fn checkRejectionOrExact(env: *const std.process.Environ.Map, front: *const api.Frontend, cell: api.Cell) !void {
+    const result = try front.translate(front.ctx, t.allocator, cell);
+    defer if (result == .program) t.allocator.free(result.program.bytes);
+    if (result == .program) try checkExact(env, result.program, cell.code);
+}
diff --git a/zig/src/core/runner_frontend_collections_emit.zig b/zig/src/core/runner_frontend_collections_emit.zig
new file mode 100644
index 000000000..c2e791f14
--- /dev/null
+++ b/zig/src/core/runner_frontend_collections_emit.zig
@@ -0,0 +1,425 @@
+const std = @import("std");
+const ast = @import("runner_frontend_collections_ast.zig");
+const Allocator = std.mem.Allocator;
+const Error = Allocator.Error;
+pub const builtins = [_][]const u8{ "len", "sum", "min", "max", "range", "list", "tuple", "set", "dict", "enumerate", "zip", "sorted", "str", "int", "bool", "abs", "any", "all", "map" };
+pub const methods = [_][]const u8{ "append", "pop", "reverse", "get", "setdefault", "keys", "items", "values", "add", "remove", "discard", "find", "rfind", "join", "split", "copy" };
+pub fn lookup(names: []const []const u8, name: []const u8) ?usize {
+    for (names, 0..) |s, i| if (std.mem.eql(u8, s, name)) return i;
+    return null;
+}
+
+pub fn emit(a: Allocator, p: *const ast.Program) Error![]u8 {
+    var e: Emitter = .{ .a = a, .p = p };
+    errdefer e.out.deinit(a);
+    defer e.bindings.deinit(a);
+    try e.put(@embedFile("runner_frontend_collections_runtime.c"));
+    try e.put(@embedFile("runner_frontend_collections_support.c"));
+    try e.put("\nstatic volatile int inputs[]={");
+    var input_count: usize = 0;
+    for (p.nodes.items) |n| if (n.tag == .integer or n.tag == .boolean) {
+        try e.out.print(a, "{d},", .{n.value});
+        input_count += 1;
+    };
+    if (input_count == 0) try e.put("0");
+    try e.put("};\n");
+    for (p.nodes.items, 0..) |n, id| if (n.tag == .string) {
+        try e.out.print(a, "static volatile char text{d}[]=", .{id});
+        try e.quoted(n.text);
+        try e.out.print(a, ";\nstatic V literal{d};\n", .{id});
+    };
+    for (p.globals.names.items, 0..) |_, i| try e.out.print(a, "static V g{d}={{-1,0}};\n", .{i});
+    for (p.functions.items, 0..) |f, i| {
+        try e.out.print(a, "static unsigned defined{d};\n", .{i});
+        try e.signature(f, i);
+        try e.put(";\n");
+    }
+    for (p.functions.items, 0..) |f, i| {
+        e.scope = &p.functions.items[i].scope;
+        try e.signature(f, i);
+        try e.put("{\n");
+        for (f.scope.names.items, 0..) |_, j| try e.out.print(a, "V l{d}={{-1,0}};\n", .{j});
+        for (f.params, 0..) |name, j| try e.out.print(a, "l{d}=p{d};\n", .{ f.scope.find(name).?, j });
+        try e.statements(f.body);
+        try e.put("return none();\n}\n");
+    }
+    e.scope = null;
+    try e.put("int main(void){\n");
+    for (p.nodes.items, 0..) |n, i| if (n.tag == .string) {
+        try e.out.print(a, "literal{d}=text(text{d},{d});\n", .{ i, i, n.text.len });
+    };
+    if (p.globals.find("__name__")) |i| try e.out.print(a, "g{d}=text(\"__main__\",8);\n", .{i});
+    try e.statements(p.body);
+    try e.put("return 0;\n}\n");
+    return e.out.toOwnedSlice(a);
+}
+
+const Binding = struct { name: []const u8, id: usize };
+const Emitter = struct {
+    a: Allocator,
+    p: *const ast.Program,
+    out: std.ArrayList(u8) = .empty,
+    scope: ?*const ast.Scope = null,
+    next: usize = 0,
+    bindings: std.ArrayList(Binding) = .empty,
+
+    fn put(e: *Emitter, s: []const u8) Error!void {
+        try e.out.appendSlice(e.a, s);
+    }
+    fn fresh(e: *Emitter) usize {
+        const i = e.next;
+        e.next += 1;
+        return i;
+    }
+    fn quoted(e: *Emitter, s: []const u8) Error!void {
+        try e.put("\"");
+        for (s) |c| try e.out.print(e.a, "\\{o:0>3}", .{c});
+        try e.put("\"");
+    }
+    fn signature(e: *Emitter, f: ast.Function, i: usize) Error!void {
+        try e.out.print(e.a, "static V f{d}(", .{i});
+        if (f.params.len == 0) try e.put("void");
+        for (f.params, 0..) |_, j| {
+            if (j != 0) try e.put(",");
+            try e.out.print(e.a, "V p{d}", .{j});
+        }
+        try e.put(")");
+    }
+    fn variable(e: *Emitter, name: []const u8) Error!void {
+        var i = e.bindings.items.len;
+        while (i != 0) {
+            i -= 1;
+            const b = e.bindings.items[i];
+            if (std.mem.eql(u8, b.name, name)) {
+                try e.out.print(e.a, "v{d}", .{b.id});
+                return;
+            }
+        }
+        if (e.scope) |s| if (s.find(name)) |j| {
+            try e.out.print(e.a, "l{d}", .{j});
+            return;
+        };
+        if (e.p.globals.find(name)) |j| {
+            try e.out.print(e.a, "g{d}", .{j});
+        } else try e.put("(V){-1,0}");
+    }
+    fn decl(e: *Emitter, i: usize) Error!void {
+        try e.out.print(e.a, "V v{d}=", .{i});
+    }
+    fn expr(e: *Emitter, id: ast.Id) Error!usize {
+        const n = e.p.nodes.items[id];
+        const r = e.fresh();
+        switch (n.tag) {
+            .integer, .boolean => {
+                try e.decl(r);
+                var slot: usize = 0;
+                for (e.p.nodes.items[0..id]) |prior| if (prior.tag == .integer or prior.tag == .boolean) {
+                    slot += 1;
+                };
+                try e.out.print(e.a, "val({d},inputs[{d}]);\n", .{ @intFromBool(n.tag == .boolean), slot });
+            },
+            .none => {
+                try e.decl(r);
+                try e.put("none();\n");
+            },
+            .string => {
+                try e.decl(r);
+                try e.out.print(e.a, "py_hold(literal{d});\n", .{id});
+            },
+            .name => {
+                try e.decl(r);
+                if ((std.mem.eql(u8, n.text, "sum") or std.mem.eql(u8, n.text, "str")) and e.p.globals.find(n.text) == null and
+                    (e.scope == null or e.scope.?.find(n.text) == null))
+                {
+                    try e.out.print(e.a, "val(9,{d});\n", .{if (std.mem.eql(u8, n.text, "sum")) @as(usize, 1) else 2});
+                } else {
+                    try e.put("checked(");
+                    try e.variable(n.text);
+                    try e.put(");\n");
+                }
+            },
+            .list, .tuple, .dict, .set => {
+                try e.decl(r);
+                const tag: usize = switch (n.tag) {
+                    .list => 4,
+                    .tuple => 5,
+                    .dict => 6,
+                    else => 7,
+                };
+                try e.out.print(e.a, "fresh({d});\n", .{tag});
+                var i: usize = 0;
+                while (i < n.args.len) : (i += 1) {
+                    const x = try e.expr(n.args[i]);
+                    if (n.tag == .dict) {
+                        i += 1;
+                        const y = try e.expr(n.args[i]);
+                        try e.out.print(e.a, "store(v{d},v{d},v{d});\n", .{ r, x, y });
+                    } else try e.out.print(e.a, "{s}(v{d},v{d});\n", .{ if (n.tag == .set) "setadd" else "append", r, x });
+                }
+            },
+            .logical_and, .logical_or => {
+                const x = try e.expr(n.a);
+                try e.decl(r);
+                try e.out.print(e.a, "v{d};\nif({s}truth(v{d})){{\n", .{ x, if (n.tag == .logical_or) "!" else "", x });
+                const y = try e.expr(n.b);
+                try e.out.print(e.a, "v{d}=py_hold(v{d});\n}}\n", .{ r, y });
+            },
+            .conditional => {
+                const cond = try e.expr(n.b);
+                try e.out.print(e.a, "V v{d};if(truth(v{d})){{\n", .{ r, cond });
+                const x = try e.expr(n.a);
+                try e.out.print(e.a, "v{d}=py_hold(v{d});\n}}else{{\n", .{ r, x });
+                const y = try e.expr(n.c.?);
+                try e.out.print(e.a, "v{d}=py_hold(v{d});\n}}\n", .{ r, y });
+            },
+            .neg, .pos, .logical_not => {
+                const x = try e.expr(n.a);
+                try e.decl(r);
+                const op: usize = if (n.tag == .neg) 0 else if (n.tag == .pos) 1 else 2;
+                try e.out.print(e.a, "unary({d},v{d});\n", .{ op, x });
+            },
+            .index => {
+                const x = try e.expr(n.a);
+                const y = try e.expr(n.b);
+                try e.decl(r);
+                try e.out.print(e.a, "get(v{d},v{d});\n", .{ x, y });
+            },
+            .slice => {
+                const x = try e.expr(n.a);
+                var parts: [3]usize = undefined;
+                for (&parts, 0..) |*part, i| part.* = try e.expr(n.args[i]);
+                try e.decl(r);
+                try e.out.print(e.a, "slice(v{d},v{d},v{d},v{d});\n", .{ x, parts[0], parts[1], parts[2] });
+            },
+            .call, .method => try e.call(n, r),
+            .comprehension => try e.comprehension(n, r),
+            else => {
+                const x = try e.expr(n.a);
+                const y = try e.expr(n.b);
+                try e.decl(r);
+                try e.out.print(e.a, "binary({d},v{d},v{d});\n", .{ binaryId(n.tag), x, y });
+            },
+        }
+        return r;
+    }
+    fn call(e: *Emitter, n: ast.Node, r: usize) Error!void {
+        if (n.tag == .call) if (e.p.functionId(n.text)) |f| {
+            try e.out.print(e.a, "if(!defined{d})fail();\n", .{f});
+        };
+        if (n.tag == .call and n.args.len == 1 and
+            (std.mem.eql(u8, n.text, "any") or std.mem.eql(u8, n.text, "all")))
+        {
+            const gen = e.p.nodes.items[n.args[0]];
+            if (gen.tag == .comprehension and gen.value == 1) return e.generatorTruth(gen, r, std.mem.eql(u8, n.text, "all"));
+        }
+        const base = if (n.tag == .method) try e.expr(n.a) else 0;
+        var args: std.ArrayList(usize) = .empty;
+        defer args.deinit(e.a);
+        for (n.args) |arg| try args.append(e.a, try e.expr(arg));
+        try e.decl(r);
+        if (n.tag == .call) if (e.p.functionId(n.text)) |f| {
+            try e.out.print(e.a, "f{d}(", .{f});
+            for (args.items, 0..) |x, i| {
+                if (i != 0) try e.put(",");
+                try e.out.print(e.a, "v{d}", .{x});
+            }
+            try e.put(");\n");
+            return;
+        };
+        const id = lookup(if (n.tag == .method) &methods else &builtins, n.text);
+        var valid_keywords = true;
+        var positional: usize = 0;
+        for (n.keywords) |key| {
+            if (key.len == 0) {
+                positional += 1;
+            } else if (n.tag != .call or !std.mem.eql(u8, n.text, "sorted") or
+                (!std.mem.eql(u8, key, "key") and !std.mem.eql(u8, key, "reverse"))) valid_keywords = false;
+        }
+        if (std.mem.eql(u8, n.text, "sorted") and positional > 1) valid_keywords = false;
+        if (id == null or args.items.len > 3 or !valid_keywords) {
+            try e.put("none();fail();\n");
+            return;
+        }
+        try e.out.print(e.a, "{s}({d},", .{ if (n.tag == .method) "method" else "builtin", id.? });
+        if (n.tag == .method) try e.out.print(e.a, "v{d},", .{base});
+        try e.out.print(e.a, "{d},", .{args.items.len});
+        var slots: [3]?usize = .{ null, null, null };
+        if (n.tag == .call and id.? == 11) {
+            var pos: usize = 0;
+            for (args.items, 0..) |x, i| {
+                const key = if (i < n.keywords.len) n.keywords[i] else "";
+                if (std.mem.eql(u8, key, "key")) slots[1] = x else if (std.mem.eql(u8, key, "reverse")) slots[2] = x else {
+                    if (pos < 3) slots[pos] = x;
+                    pos += 1;
+                }
+            }
+        } else for (args.items, 0..) |x, i| slots[i] = x;
+        for (slots, 0..) |x, i| {
+            if (i != 0) try e.put(",");
+            if (x) |j| try e.out.print(e.a, "v{d}", .{j}) else try e.put("none()");
+        }
+        try e.put(");\n");
+    }
+    fn generatorTruth(e: *Emitter, n: ast.Node, r: usize, all: bool) Error!void {
+        const seq = try e.expr(n.b);
+        const loop = e.fresh();
+        const item = e.fresh();
+        try e.decl(r);
+        try e.out.print(e.a, "boolean({d});\n", .{@intFromBool(all)});
+        try e.iterHead(seq, loop, item);
+        try e.bindings.append(e.a, .{ .name = n.text, .id = item });
+        defer _ = e.bindings.pop();
+        if (n.c) |filter| {
+            const f = try e.expr(filter);
+            try e.out.print(e.a, "if(!truth(v{d}))continue;\n", .{f});
+        }
+        const x = try e.expr(n.a);
+        try e.out.print(e.a, "if({s}truth(v{d})){{v{d}=boolean({d});break;}}\n}}\n", .{ if (all) "!" else "", x, r, @intFromBool(!all) });
+    }
+    fn comprehension(e: *Emitter, n: ast.Node, r: usize) Error!void {
+        const seq = try e.expr(n.b);
+        const loop = e.fresh();
+        const item = e.fresh();
+        try e.decl(r);
+        try e.put("fresh(4);\n");
+        try e.iterHead(seq, loop, item);
+        try e.bindings.append(e.a, .{ .name = n.text, .id = item });
+        defer _ = e.bindings.pop();
+        if (n.c) |filter| {
+            const f = try e.expr(filter);
+            try e.out.print(e.a, "if(!truth(v{d}))continue;\n", .{f});
+        }
+        const x = try e.expr(n.a);
+        try e.out.print(e.a, "append(v{d},v{d});\n}}\n", .{ r, x });
+    }
+    fn iterHead(e: *Emitter, seq: usize, loop: usize, item: usize) Error!void {
+        try e.out.print(e.a, "int i{d}=0,guard{d}=dict_size(v{d});V v{d};\nwhile(1){{\n", .{ loop, loop, seq, item });
+        try e.out.print(e.a, "iter_guard(v{d},guard{d});if(!cg_iter(v{d},&i{d},&v{d}))break;\n", .{ seq, loop, seq, loop, item });
+    }
+    fn target(e: *Emitter, id: usize, value: usize) Error!void {
+        const n = e.p.nodes.items[id];
+        switch (n.tag) {
+            .name => {
+                try e.variable(n.text);
+                try e.out.print(e.a, "=py_hold(v{d});\n", .{value});
+            },
+            .tuple, .list => {
+                const cursor = e.fresh();
+                try e.out.print(e.a, "int unpack{d}=0;\n", .{cursor});
+                var values: std.ArrayList(usize) = .empty;
+                defer values.deinit(e.a);
+                for (n.args) |_| {
+                    const x = e.fresh();
+                    try values.append(e.a, x);
+                    try e.out.print(e.a, "V v{d};if(!cg_iter(v{d},&unpack{d},&v{d}))fail();\n", .{ x, value, cursor, x });
+                }
+                const extra = e.fresh();
+                try e.out.print(e.a, "V v{d};if(cg_iter(v{d},&unpack{d},&v{d}))fail();\n", .{ extra, value, cursor, extra });
+                for (n.args, values.items) |arg, x| try e.target(arg, x);
+            },
+            .index => {
+                const x = try e.expr(n.a);
+                const y = try e.expr(n.b);
+                try e.out.print(e.a, "put(v{d},v{d},v{d});\n", .{ x, y, value });
+            },
+            else => try e.put("fail();\n"),
+        }
+    }
+    fn statements(e: *Emitter, body: []const ast.Stmt) Error!void {
+        for (body) |s| switch (s.tag) {
+            .assign => {
+                const x = try e.expr(s.expr.?);
+                for (s.targets) |t| try e.target(t, x);
+            },
+            .augassign => {
+                const n = e.p.nodes.items[s.targets[0]];
+                if (n.tag == .index) {
+                    const a = try e.expr(n.a);
+                    const b = try e.expr(n.b);
+                    const old = e.fresh();
+                    try e.decl(old);
+                    try e.out.print(e.a, "get(v{d},v{d});\n", .{ a, b });
+                    const x = try e.expr(s.expr.?);
+                    try e.out.print(e.a, "put(v{d},v{d},inplace({d},v{d},v{d}));\n", .{ a, b, binaryId(s.op), old, x });
+                } else {
+                    const old = try e.expr(s.targets[0]);
+                    const x = try e.expr(s.expr.?);
+                    const r = e.fresh();
+                    try e.decl(r);
+                    try e.out.print(e.a, "inplace({d},v{d},v{d});\n", .{ binaryId(s.op), old, x });
+                    try e.target(s.targets[0], r);
+                }
+            },
+            .expression => _ = try e.expr(s.expr.?),
+            .print => {
+                var values: std.ArrayList(usize) = .empty;
+                defer values.deinit(e.a);
+                for (s.targets) |arg| try values.append(e.a, try e.expr(arg));
+                if (s.expr) |arg| try values.append(e.a, try e.expr(arg));
+                for (values.items, 0..) |x, i| {
+                    if (i != 0) try e.put("outchar(32);\n");
+                    try e.out.print(e.a, "repr(v{d},1);\n", .{x});
+                }
+                try e.put("outchar(10);\n");
+            },
+            .conditional => {
+                const x = try e.expr(s.expr.?);
+                try e.out.print(e.a, "if(truth(v{d})){{\n", .{x});
+                try e.statements(s.body);
+                try e.put("}else{\n");
+                try e.statements(s.otherwise);
+                try e.put("}\n");
+            },
+            .while_loop => {
+                try e.put("while(1){\n");
+                const x = try e.expr(s.expr.?);
+                try e.out.print(e.a, "if(!truth(v{d}))break;\n", .{x});
+                try e.statements(s.body);
+                try e.put("}\n");
+            },
+            .for_loop => {
+                const x = try e.expr(s.expr.?);
+                const i = e.fresh();
+                const item = e.fresh();
+                try e.iterHead(x, i, item);
+                try e.target(s.targets[0], item);
+                try e.statements(s.body);
+                try e.put("}\n");
+            },
+            .ret => {
+                if (s.expr) |arg| {
+                    const x = try e.expr(arg);
+                    try e.out.print(e.a, "return py_hold(v{d});\n", .{x});
+                } else try e.put("return none();\n");
+            },
+            .assertion => {
+                const x = try e.expr(s.expr.?);
+                try e.out.print(e.a, "if(!truth(v{d}))fail();\n", .{x});
+            },
+            .break_loop => try e.put("break;\n"),
+            .continue_loop => try e.put("continue;\n"),
+            .function => try e.out.print(e.a, "defined{d}=1;\n", .{s.function}),
+            .pass => {},
+        };
+    }
+};
+fn binaryId(tag: ast.Tag) usize {
+    return switch (tag) {
+        .add => 0,
+        .sub => 1,
+        .mul => 2,
+        .floor => 3,
+        .modulo => 4,
+        .eq => 5,
+        .ne => 6,
+        .lt => 7,
+        .le => 8,
+        .gt => 9,
+        .ge => 10,
+        .contains => 11,
+        .not_contains => 12,
+        .is_identity => 13,
+        .is_not => 14,
+        else => 99,
+    };
+}
diff --git a/zig/src/core/runner_frontend_collections_expr.zig b/zig/src/core/runner_frontend_collections_expr.zig
new file mode 100644
index 000000000..394b8ef20
--- /dev/null
+++ b/zig/src/core/runner_frontend_collections_expr.zig
@@ -0,0 +1,339 @@
+const std = @import("std");
+const ast = @import("runner_frontend_collections_ast.zig");
+
+pub fn parse(p: *ast.Program, source: []const u8) ast.Error!ast.Id {
+    var s: Parser = .{ .p = p, .source = source };
+    const id = try s.tuple();
+    s.space();
+    if (s.pos != source.len) return error.Unsupported;
+    try bounded(p, id, 0);
+    return id;
+}
+
+pub const Parser = struct {
+    p: *ast.Program,
+    source: []const u8,
+    pos: usize = 0,
+    depth: usize = 0,
+
+    pub fn space(s: *Parser) void {
+        while (s.pos < s.source.len and std.ascii.isWhitespace(s.source[s.pos])) s.pos += 1;
+    }
+
+    pub fn eat(s: *Parser, token: []const u8) bool {
+        s.space();
+        if (!std.mem.startsWith(u8, s.source[s.pos..], token)) return false;
+        const end = s.pos + token.len;
+        if (nameChar(token[token.len - 1]) and end < s.source.len and nameChar(s.source[end])) return false;
+        s.pos = end;
+        return true;
+    }
+
+    pub fn need(s: *Parser, token: []const u8) ast.Error!void {
+        if (!s.eat(token)) return error.Unsupported;
+    }
+
+    pub fn identifier(s: *Parser) ast.Error![]const u8 {
+        s.space();
+        const start = s.pos;
+        if (start == s.source.len or !(std.ascii.isAlphabetic(s.source[start]) or s.source[start] == '_'))
+            return error.Unsupported;
+        s.pos += 1;
+        while (s.pos < s.source.len and nameChar(s.source[s.pos])) s.pos += 1;
+        const name = s.source[start..s.pos];
+        if (!validName(name)) return error.Unsupported;
+        return name;
+    }
+
+    pub fn tuple(s: *Parser) ast.Error!ast.Id {
+        const first = try s.expression();
+        if (!s.eat(",")) return first;
+        var args: std.ArrayList(ast.Id) = .empty;
+        try args.append(s.p.a, first);
+        while (true) {
+            s.space();
+            if (s.pos == s.source.len or s.source[s.pos] == ')') break;
+            try args.append(s.p.a, try s.expression());
+            if (!s.eat(",")) break;
+        }
+        return s.p.node(.{ .tag = .tuple, .args = try args.toOwnedSlice(s.p.a) });
+    }
+
+    pub fn expression(s: *Parser) ast.Error!ast.Id {
+        if (s.depth >= 24) return error.Unsupported;
+        s.depth += 1;
+        defer s.depth -= 1;
+        const yes = try s.disjunction();
+        if (!s.eat("if")) return yes;
+        const condition = try s.disjunction();
+        try s.need("else");
+        return s.p.node(.{ .tag = .conditional, .a = yes, .b = condition, .c = try s.expression() });
+    }
+
+    fn disjunction(s: *Parser) ast.Error!ast.Id {
+        var root = try s.conjunction();
+        while (s.eat("or")) root = try s.binary(.logical_or, root, try s.conjunction());
+        return root;
+    }
+
+    fn conjunction(s: *Parser) ast.Error!ast.Id {
+        var root = try s.inversion();
+        while (s.eat("and")) root = try s.binary(.logical_and, root, try s.inversion());
+        return root;
+    }
+
+    fn inversion(s: *Parser) ast.Error!ast.Id {
+        if (s.eat("not")) {
+            if (s.depth >= 24) return error.Unsupported;
+            s.depth += 1;
+            defer s.depth -= 1;
+            return s.p.node(.{ .tag = .logical_not, .a = try s.inversion() });
+        }
+        const left = try s.additive();
+        const tag: ast.Tag = if (s.eat("==")) .eq else if (s.eat("!=")) .ne else if (s.eat("<=")) .le else if (s.eat(">=")) .ge else if (s.eat("<")) .lt else if (s.eat(">")) .gt else if (s.eat("in")) .contains else if (s.eat("not")) blk: {
+            try s.need("in");
+            break :blk .not_contains;
+        } else if (s.eat("is")) (if (s.eat("not")) ast.Tag.is_not else ast.Tag.is_identity) else return left;
+        return s.binary(tag, left, try s.additive());
+    }
+
+    fn additive(s: *Parser) ast.Error!ast.Id {
+        var root = try s.product();
+        while (true) {
+            const tag: ast.Tag = if (s.eat("+")) .add else if (s.eat("-")) .sub else break;
+            root = try s.binary(tag, root, try s.product());
+        }
+        return root;
+    }
+
+    fn product(s: *Parser) ast.Error!ast.Id {
+        var root = try s.unary();
+        while (true) {
+            const tag: ast.Tag = if (s.eat("//")) .floor else if (s.eat("%")) .modulo else if (s.eat("*")) .mul else break;
+            root = try s.binary(tag, root, try s.unary());
+        }
+        return root;
+    }
+
+    fn unary(s: *Parser) ast.Error!ast.Id {
+        const tag: ?ast.Tag = if (s.eat("-")) .neg else if (s.eat("+")) .pos else null;
+        if (tag) |op| {
+            if (s.depth >= 24) return error.Unsupported;
+            s.depth += 1;
+            defer s.depth -= 1;
+            return s.p.node(.{ .tag = op, .a = try s.unary() });
+        }
+        var root = try s.atom();
+        while (true) {
+            if (s.eat("[")) {
+                const start = if (s.peek(":")) try s.p.node(.{ .tag = .none }) else try s.expression();
+                if (s.eat(":")) {
+                    const stop = if (s.peek(":") or s.peek("]")) try s.p.node(.{ .tag = .none }) else try s.expression();
+                    var step = try s.p.node(.{ .tag = .none });
+                    if (s.eat(":")) {
+                        if (!s.peek("]")) step = try s.expression();
+                    }
+                    try s.need("]");
+                    root = try s.p.node(.{ .tag = .slice, .a = root, .args = try s.p.a.dupe(ast.Id, &.{ start, stop, step }) });
+                } else {
+                    try s.need("]");
+                    root = try s.p.node(.{ .tag = .index, .a = root, .b = start });
+                }
+            } else if (s.eat(".")) {
+                const name = try s.identifier();
+                try s.need("(");
+                root = try s.call(.method, name, root);
+            } else break;
+        }
+        return root;
+    }
+
+    fn peek(s: *Parser, token: []const u8) bool {
+        const save = s.pos;
+        defer s.pos = save;
+        return s.eat(token);
+    }
+
+    fn binary(s: *Parser, tag: ast.Tag, a: ast.Id, b: ast.Id) ast.Error!ast.Id {
+        return s.p.node(.{ .tag = tag, .a = a, .b = b });
+    }
+
+    fn atom(s: *Parser) ast.Error!ast.Id {
+        if (s.eat("(")) {
+            if (s.eat(")")) return s.p.node(.{ .tag = .tuple });
+            const root = try s.tuple();
+            try s.need(")");
+            return root;
+        }
+        if (s.eat("[")) return s.sequence(.list, "]");
+        if (s.eat("{")) return s.sequence(.set, "}");
+        if (s.eat("True")) return s.p.node(.{ .tag = .boolean, .value = 1 });
+        if (s.eat("False")) return s.p.node(.{ .tag = .boolean });
+        if (s.eat("None")) return s.p.node(.{ .tag = .none });
+        s.space();
+        if (s.pos == s.source.len) return error.Unsupported;
+        if (s.source[s.pos] == '\'' or s.source[s.pos] == '"') return s.string();
+        if (std.ascii.isDigit(s.source[s.pos])) {
+            const start = s.pos;
+            while (s.pos < s.source.len and std.ascii.isDigit(s.source[s.pos])) s.pos += 1;
+            const text = s.source[start..s.pos];
+            if (s.pos < s.source.len and nameChar(s.source[s.pos])) return error.Unsupported;
+            if (text.len > 1 and text[0] == '0') return error.Unsupported;
+            const value = std.fmt.parseInt(i64, text, 10) catch return error.Unsupported;
+            if (value > 2147483648) return error.Unsupported;
+            return s.p.node(.{ .tag = .integer, .value = value });
+        }
+        const name = try s.identifier();
+        if (s.eat("(")) return s.call(.call, name, 0);
+        return s.p.node(.{ .tag = .name, .text = name });
+    }
+
+    fn sequence(s: *Parser, kind: ast.Tag, close: []const u8) ast.Error!ast.Id {
+        var tag = kind;
+        var args: std.ArrayList(ast.Id) = .empty;
+        if (s.eat(close)) return s.p.node(.{ .tag = if (kind == .set) .dict else kind });
+        const first = try s.expression();
+        if (kind == .list and s.eat("for")) {
+            const comp = try s.comprehension(first);
+            try s.need(close);
+            return comp;
+        }
+        try args.append(s.p.a, first);
+        if (kind == .set and s.eat(":")) {
+            tag = .dict;
+            try args.append(s.p.a, try s.expression());
+        }
+        while (!s.eat(close)) {
+            try s.need(",");
+            if (s.eat(close)) break;
+            try args.append(s.p.a, try s.expression());
+            if (tag == .dict) {
+                try s.need(":");
+                try args.append(s.p.a, try s.expression());
+            }
+        }
+        return s.p.node(.{ .tag = tag, .args = try args.toOwnedSlice(s.p.a) });
+    }
+
+    fn comprehension(s: *Parser, output: ast.Id) ast.Error!ast.Id {
+        const name = try s.identifier();
+        try s.need("in");
+        const iterable = try s.disjunction();
+        const filter: ?ast.Id = if (s.eat("if")) try s.disjunction() else null;
+        return s.p.node(.{ .tag = .comprehension, .text = name, .a = output, .b = iterable, .c = filter });
+    }
+
+    fn call(s: *Parser, tag: ast.Tag, name: []const u8, base: ast.Id) ast.Error!ast.Id {
+        var args: std.ArrayList(ast.Id) = .empty;
+        var keywords: std.ArrayList([]const u8) = .empty;
+        var named = false;
+        if (!s.eat(")")) while (true) {
+            const save = s.pos;
+            var key: []const u8 = "";
+            if (s.identifier()) |candidate| {
+                if (s.eat("=") and !s.peek("=")) key = candidate else s.pos = save;
+            } else |_| s.pos = save;
+            if (key.len != 0) {
+                for (keywords.items) |old| if (std.mem.eql(u8, old, key)) return error.Unsupported;
+                named = true;
+            } else if (named) return error.Unsupported;
+            var arg = try s.expression();
+            if (s.eat("for")) {
+                if (tag != .call or args.items.len != 0 or key.len != 0 or
+                    !(std.mem.eql(u8, name, "any") or std.mem.eql(u8, name, "all"))) return error.Unsupported;
+                arg = try s.comprehension(arg);
+                s.p.nodes.items[arg].value = 1;
+                try args.append(s.p.a, arg);
+                try keywords.append(s.p.a, "");
+                try s.need(")");
+                break;
+            }
+            try args.append(s.p.a, arg);
+            try keywords.append(s.p.a, key);
+            if (s.eat(")")) break;
+            try s.need(",");
+            if (s.eat(")")) break;
+        };
+        return s.p.node(.{ .tag = tag, .text = name, .a = base, .args = try args.toOwnedSlice(s.p.a), .keywords = try keywords.toOwnedSlice(s.p.a) });
+    }
+
+    fn string(s: *Parser) ast.Error!ast.Id {
+        const quote = s.source[s.pos];
+        s.pos += 1;
+        var bytes: std.ArrayList(u8) = .empty;
+        while (s.pos < s.source.len) {
+            var c = s.source[s.pos];
+            s.pos += 1;
+            if (c == quote) return s.p.node(.{ .tag = .string, .text = try bytes.toOwnedSlice(s.p.a) });
+            if (c < 32 or c >= 128) return error.Unsupported;
+            if (c == '\\') c = try s.escape();
+            if (bytes.items.len >= 128) return error.Unsupported;
+            try bytes.append(s.p.a, c);
+        }
+        return error.Unsupported;
+    }
+
+    fn escape(s: *Parser) ast.Error!u8 {
+        if (s.pos == s.source.len) return error.Unsupported;
+        const c = s.source[s.pos];
+        s.pos += 1;
+        switch (c) {
+            '\\', '\'', '"' => return c,
+            'n' => return 10,
+            'r' => return 13,
+            't' => return 9,
+            'b' => return 8,
+            'f' => return 12,
+            'v' => return 11,
+            'a' => return 7,
+            'x', 'u', 'U' => {
+                const len: usize = if (c == 'x') 2 else if (c == 'u') 4 else 8;
+                if (s.pos + len > s.source.len) return error.Unsupported;
+                const value = std.fmt.parseInt(u32, s.source[s.pos .. s.pos + len], 16) catch return error.Unsupported;
+                for (s.source[s.pos .. s.pos + len]) |digit| if (!std.ascii.isHex(digit)) return error.Unsupported;
+                if (value >= 128) return error.Unsupported;
+                s.pos += len;
+                return @intCast(value);
+            },
+            '0'...'7' => {
+                var value: u16 = c - '0';
+                var count: usize = 1;
+                while (count < 3 and s.pos < s.source.len and s.source[s.pos] >= '0' and s.source[s.pos] <= '7') : (count += 1) {
+                    value = value * 8 + s.source[s.pos] - '0';
+                    s.pos += 1;
+                }
+                if (value >= 128) return error.Unsupported;
+                return @intCast(value);
+            },
+            else => return error.Unsupported,
+        }
+    }
+};
+
+fn nameChar(c: u8) bool {
+    return std.ascii.isAlphanumeric(c) or c == '_';
+}
+
+pub fn validName(name: []const u8) bool {
+    if (name.len == 0 or !(std.ascii.isAlphabetic(name[0]) or name[0] == '_')) return false;
+    for (name) |c| if (!nameChar(c)) return false;
+    const reserved = [_][]const u8{ "__debug__", "__builtins__", "False", "None", "True", "and", "as", "assert", "async", "await", "break", "class", "continue", "def", "del", "elif", "else", "except", "finally", "for", "from", "global", "if", "import", "in", "is", "lambda", "nonlocal", "not", "or", "pass", "raise", "return", "try", "while", "with", "yield" };
+    for (reserved) |word| if (std.mem.eql(u8, word, name)) return false;
+    return true;
+}
+
+fn bounded(p: *const ast.Program, id: ast.Id, depth: usize) ast.Error!void {
+    if (depth >= 24) return error.Unsupported;
+    const n = p.nodes.items[id];
+    switch (n.tag) {
+        .integer, .boolean, .none, .string, .name => {},
+        .list, .tuple, .dict, .set, .call => {},
+        .slice, .method, .neg, .pos, .logical_not => try bounded(p, n.a, depth + 1),
+        else => {
+            try bounded(p, n.a, depth + 1);
+            try bounded(p, n.b, depth + 1);
+            if (n.c) |c| try bounded(p, c, depth + 1);
+        },
+    }
+    for (n.args) |arg| try bounded(p, arg, depth + 1);
+}
diff --git a/zig/src/core/runner_frontend_collections_methods.zig b/zig/src/core/runner_frontend_collections_methods.zig
new file mode 100644
index 000000000..00e3ea100
--- /dev/null
+++ b/zig/src/core/runner_frontend_collections_methods.zig
@@ -0,0 +1,123 @@
+const std = @import("std");
+const ast = @import("runner_frontend_collections_ast.zig");
+const v = @import("runner_frontend_collections_value.zig");
+const ops = @import("runner_frontend_collections_ops.zig");
+const Value = v.Value;
+const Heap = v.Heap;
+const Error = ast.Error;
+fn is(a: []const u8, b: []const u8) bool {
+    return std.mem.eql(u8, a, b);
+}
+fn argc(args: []const Value, min: usize, max: usize) Error!void {
+    if (args.len < min or args.len > max) return error.Unsupported;
+}
+pub fn call(h: *Heap, object: Value, name: []const u8, args: []const Value, keywords: []const []const u8) Error!Value {
+    try h.charge(24);
+    if (args.len != keywords.len) return error.Unsupported;
+    for (keywords) |key| if (key.len != 0) return error.Unsupported;
+    if (is(name, "append")) {
+        try argc(args, 1, 1);
+        if (object.kind != .list) return error.Unsupported;
+        try h.append(object, args[0]);
+        return .{};
+    }
+    if (is(name, "pop")) {
+        try argc(args, 0, 1);
+        if (object.kind != .list) return error.Unsupported;
+        const o = object.obj.?;
+        const i = try v.normalized(if (args.len == 0) -1 else try args[0].numeric(), o.items.items.len);
+        try h.charge((o.items.items.len - i) * 8);
+        return o.items.orderedRemove(i);
+    }
+    if (is(name, "reverse")) {
+        try argc(args, 0, 0);
+        if (object.kind != .list) return error.Unsupported;
+        std.mem.reverse(Value, object.obj.?.items.items);
+        try h.charge(object.obj.?.items.items.len * 8);
+        return .{};
+    }
+    if (is(name, "copy")) {
+        try argc(args, 0, 0);
+        if (object.kind != .list) return error.Unsupported;
+        return ops.collect(h, object, false);
+    }
+    if (is(name, "get") or is(name, "setdefault")) {
+        try argc(args, 1, 2);
+        if (object.kind != .dict) return error.Unsupported;
+        if (try h.contains(object, args[0])) return h.get(object, args[0]);
+        const fallback = if (args.len == 2) args[1] else Value{};
+        if (is(name, "setdefault")) try h.dictSet(object, args[0], fallback);
+        return fallback;
+    }
+    if (is(name, "keys") or is(name, "items") or is(name, "values")) {
+        try argc(args, 0, 0);
+        if (object.kind != .dict) return error.Unsupported;
+        return .{ .kind = if (is(name, "keys")) .keys else if (is(name, "items")) .items else .values, .obj = object.obj };
+    }
+    if (is(name, "add")) {
+        try argc(args, 1, 1);
+        try h.setAdd(object, args[0]);
+        return .{};
+    }
+    if (is(name, "remove") or is(name, "discard")) {
+        try argc(args, 1, 1);
+        if (object.kind != .set or !v.hashable(args[0])) return error.Unsupported;
+        const data = object.obj.?.items.items;
+        for (data, 0..) |x, i| {
+            try h.charge(12);
+            if (try h.eq(x, args[0])) {
+                _ = object.obj.?.items.orderedRemove(i);
+                return .{};
+            }
+        }
+        if (is(name, "remove")) return error.Unsupported;
+        return .{};
+    }
+    if (is(name, "find") or is(name, "rfind")) {
+        try argc(args, 1, 3);
+        if (object.kind != .string or args[0].kind != .string) return error.Unsupported;
+        const s = object.obj.?.text;
+        const needle = args[0].obj.?.text;
+        const n: i64 = @intCast(s.len);
+        var lo: i64 = if (args.len >= 2) try args[1].numeric() else 0;
+        var hi: i64 = if (args.len >= 3) try args[2].numeric() else n;
+        if (lo < 0) lo += n;
+        lo = @max(lo, 0);
+        if (hi < 0) hi += n;
+        hi = @min(n, @max(hi, 0));
+        var found: i64 = -1;
+        while (lo + @as(i64, @intCast(needle.len)) <= hi) : (lo += 1) {
+            try h.charge(12 + needle.len * 4);
+            const i: usize = @intCast(lo);
+            if (std.mem.eql(u8, s[i..][0..needle.len], needle)) {
+                found = lo;
+                if (is(name, "find")) break;
+            }
+        }
+        return Value.int(found);
+    }
+    if (is(name, "join")) {
+        try argc(args, 1, 1);
+        if (object.kind != .string) return error.Unsupported;
+        const seq = try ops.collect(h, args[0], false);
+        var text: std.ArrayList(u8) = .empty;
+        for (seq.obj.?.items.items, 0..) |x, i| {
+            if (x.kind != .string) return error.Unsupported;
+            if (i != 0) try text.appendSlice(h.a, object.obj.?.text);
+            try text.appendSlice(h.a, x.obj.?.text);
+        }
+        return h.string(text.items);
+    }
+    if (is(name, "split")) {
+        try argc(args, 1, 1);
+        if (object.kind != .string or args[0].kind != .string or args[0].obj.?.text.len == 0) return error.Unsupported;
+        const out = try h.new(.list);
+        var iterator = std.mem.splitSequence(u8, object.obj.?.text, args[0].obj.?.text);
+        while (iterator.next()) |part| {
+            const item = try h.string(part);
+            try h.append(out, item);
+        }
+        return out;
+    }
+    return error.Unsupported;
+}
diff --git a/zig/src/core/runner_frontend_collections_ops.zig b/zig/src/core/runner_frontend_collections_ops.zig
new file mode 100644
index 000000000..d9c7d3281
--- /dev/null
+++ b/zig/src/core/runner_frontend_collections_ops.zig
@@ -0,0 +1,195 @@
+const std = @import("std");
+const ast = @import("runner_frontend_collections_ast.zig");
+const val = @import("runner_frontend_collections_value.zig");
+const Value = val.Value;
+const Heap = val.Heap;
+const Error = ast.Error;
+
+pub fn unary(h: *Heap, tag: ast.Tag, v: Value) Error!Value {
+    try h.charge(8);
+    if (tag == .logical_not) return Value.boolean(!try val.truth(v));
+    const n = try v.numeric();
+    return Value.int(if (tag == .neg) -n else if (tag == .pos) n else return error.Unsupported);
+}
+pub fn binary(h: *Heap, tag: ast.Tag, a: Value, b: Value) Error!Value {
+    try h.charge(16);
+    if (tag == .eq or tag == .ne) {
+        const same = try h.eq(a, b);
+        return Value.boolean(if (tag == .eq) same else !same);
+    }
+    if (tag == .is_identity or tag == .is_not) {
+        if (a.kind != .none and b.kind != .none and !((a.kind == .list or a.kind == .dict or a.kind == .set) and
+            (b.kind == .list or b.kind == .dict or b.kind == .set))) return error.Unsupported;
+        const same = a.kind == b.kind and (a.kind == .none or a.obj == b.obj);
+        return Value.boolean(if (tag == .is_identity) same else !same);
+    }
+    if (tag == .contains or tag == .not_contains) {
+        const yes = try h.contains(b, a);
+        return Value.boolean(if (tag == .contains) yes else !yes);
+    }
+    if (tag == .lt or tag == .le or tag == .gt or tag == .ge) {
+        const order = try h.order(a, b);
+        return Value.boolean(switch (tag) {
+            .lt => order == .lt,
+            .le => order != .gt,
+            .gt => order == .gt,
+            .ge => order != .lt,
+            else => unreachable,
+        });
+    }
+    if (tag == .add and a.kind == .string and b.kind == .string) {
+        const text = try std.mem.concat(h.a, u8, &.{ a.obj.?.text, b.obj.?.text });
+        return h.string(text);
+    }
+    if (tag == .add and a.kind == b.kind and (a.kind == .list or a.kind == .tuple)) {
+        const out = try h.new(a.kind);
+        for (a.obj.?.items.items) |x| try h.append(out, x);
+        for (b.obj.?.items.items) |x| try h.append(out, x);
+        return out;
+    }
+    if (tag == .mul and (a.kind == .string or a.kind == .list or a.kind == .tuple)) return repeat(h, a, try b.numeric());
+    if (tag == .mul and (b.kind == .string or b.kind == .list or b.kind == .tuple)) return repeat(h, b, try a.numeric());
+    const x = try a.numeric();
+    const y = try b.numeric();
+    return Value.int(switch (tag) {
+        .add => x + y,
+        .sub => x - y,
+        .mul => x * y,
+        .floor => if (y == 0 or (x == std.math.minInt(i32) and y == -1)) return error.Unsupported else @divFloor(x, y),
+        .modulo => if (y == 0 or (x == std.math.minInt(i32) and y == -1)) return error.Unsupported else @mod(x, y),
+        else => return error.Unsupported,
+    });
+}
+pub fn repeat(h: *Heap, v: Value, n: i64) Error!Value {
+    const count: usize = @intCast(@max(0, n));
+    const len = try val.length(v);
+    if (count > 128 or len * count > 128) return error.Unsupported;
+    if (v.kind == .string) {
+        const text = try h.a.alloc(u8, len * count);
+        for (0..count) |i| @memcpy(text[i * len ..][0..len], v.obj.?.text);
+        return h.string(text);
+    }
+    const out = try h.new(v.kind);
+    for (0..count) |_| for (v.obj.?.items.items) |x| {
+        try h.append(out, x);
+    };
+    return out;
+}
+pub fn inplace(h: *Heap, tag: ast.Tag, left: Value, right: Value) Error!Value {
+    if (left.kind != .list or (tag != .add and tag != .mul)) return binary(h, tag, left, right);
+    if (tag == .add) {
+        if (right.kind != .list and right.kind != .tuple) return error.Unsupported;
+        const items = try collect(h, right, false);
+        const copy = try h.a.dupe(Value, items.obj.?.items.items);
+        for (copy) |v| try h.append(left, v);
+    } else {
+        const n = try right.numeric();
+        const original = try h.a.dupe(Value, left.obj.?.items.items);
+        if (n > 128 or original.len * @as(usize, @intCast(@max(n, 0))) > 128) return error.Unsupported;
+        if (n <= 0) left.obj.?.items.clearRetainingCapacity() else {
+            var k: i64 = 1;
+            while (k < n) : (k += 1) for (original) |v| {
+                try h.append(left, v);
+            };
+        }
+    }
+    return left;
+}
+pub fn slice(h: *Heap, v: Value, lo: Value, hi: Value, step_value: Value) Error!Value {
+    if (v.kind != .string and v.kind != .list and v.kind != .tuple) return error.Unsupported;
+    const len: i64 = @intCast(try val.length(v));
+    const step = if (step_value.kind == .none) 1 else try step_value.numeric();
+    if (step == 0) return error.Unsupported;
+    const lower: i64 = if (step > 0) 0 else -1;
+    const upper: i64 = if (step > 0) len else len - 1;
+    const start = if (lo.kind == .none) (if (step > 0) @as(i64, 0) else len - 1) else @min(upper, @max(lower, adjust(try lo.numeric(), len)));
+    const stop = if (hi.kind == .none) (if (step > 0) len else @as(i64, -1)) else @min(upper, @max(lower, adjust(try hi.numeric(), len)));
+    var bytes: [128]u8 = undefined;
+    var n: usize = 0;
+    const out = if (v.kind == .string) Value{} else try h.new(v.kind);
+    var i = start;
+    while (if (step > 0) i < stop else i > stop) : (i += step) {
+        try h.charge(12);
+        if (v.kind == .string) {
+            bytes[n] = v.obj.?.text[@intCast(i)];
+            n += 1;
+        } else try h.append(out, v.obj.?.items.items[@intCast(i)]);
+    }
+    return if (v.kind == .string) h.string(bytes[0..n]) else out;
+}
+fn adjust(i: i64, len: i64) i64 {
+    return if (i < 0) i + len else i;
+}
+pub fn indexable(v: Value) bool {
+    return v.kind == .string or v.kind == .list or v.kind == .tuple or v.kind == .dict or v.kind == .range or
+        v.kind == .items or v.kind == .keys or v.kind == .values;
+}
+pub fn at(h: *Heap, v: Value, i: usize) Error!Value {
+    if (i >= try val.length(v)) return error.Unsupported;
+    try h.charge(8);
+    if (v.kind == .string) return h.string(v.obj.?.text[i .. i + 1]);
+    if (v.kind == .dict or v.kind == .keys) return v.obj.?.items.items[2 * i];
+    if (v.kind == .values) return v.obj.?.items.items[2 * i + 1];
+    if (v.kind == .items) {
+        const out = try h.new(.tuple);
+        try h.append(out, v.obj.?.items.items[2 * i]);
+        try h.append(out, v.obj.?.items.items[2 * i + 1]);
+        return out;
+    }
+    if (!indexable(v)) return error.Unsupported;
+    return v.obj.?.items.items[i];
+}
+pub fn next(h: *Heap, v: Value, cursor: *usize) Error!?Value {
+    if (indexable(v)) {
+        if (cursor.* >= try val.length(v)) return null;
+        const value = try at(h, v, cursor.*);
+        cursor.* += 1;
+        return value;
+    }
+    if (v.kind != .enumerate and v.kind != .zip and v.kind != .map_str) return error.Unsupported;
+    const o = v.obj.?;
+    const args = o.items.items;
+    const i = o.cursor;
+    if (o.exhausted) return null;
+    if (v.kind == .zip and args.len == 0) {
+        o.exhausted = true;
+        return null;
+    }
+    for (if (v.kind == .enumerate) args[0..1] else args) |src| if (i >= try val.length(src)) {
+        o.exhausted = true;
+        return null;
+    };
+    o.cursor += 1;
+    if (v.kind == .map_str) return try string(h, try at(h, args[0], i));
+    const result = try h.new(.tuple);
+    if (v.kind == .enumerate) {
+        try h.append(result, try Value.int((try args[1].numeric()) + @as(i64, @intCast(i))));
+        try h.append(result, try at(h, args[0], i));
+    } else {
+        for (args) |src| {
+            try h.append(result, try at(h, src, i));
+        }
+    }
+    return result;
+}
+pub fn collect(h: *Heap, v: Value, allow_set: bool) Error!Value {
+    const out = try h.new(.list);
+    if (v.kind == .set and allow_set) {
+        for (v.obj.?.items.items) |x| try h.append(out, x);
+    } else {
+        var cursor: usize = 0;
+        while (try next(h, v, &cursor)) |x| try h.append(out, x);
+    }
+    return out;
+}
+pub fn string(h: *Heap, v: Value) Error!Value {
+    if (v.kind == .string) return v;
+    var buffer: [16]u8 = undefined;
+    const text = switch (v.kind) {
+        .integer => std.fmt.bufPrint(&buffer, "{d}", .{v.n}) catch return error.Unsupported,
+        .boolean => if (v.n != 0) "True" else "False",
+        .none => "None",
+        else => return error.Unsupported,
+    };
+    return h.string(text);
+}
diff --git a/zig/src/core/runner_frontend_collections_parse.zig b/zig/src/core/runner_frontend_collections_parse.zig
new file mode 100644
index 000000000..f6a8b71cb
--- /dev/null
+++ b/zig/src/core/runner_frontend_collections_parse.zig
@@ -0,0 +1,488 @@
+const std = @import("std");
+const ast = @import("runner_frontend_collections_ast.zig");
+const expr = @import("runner_frontend_collections_expr.zig");
+
+pub fn parse(p: *ast.Program, source: []const u8) ast.Error!void {
+    if (source.len == 0 or source.len > 4096) return error.Unsupported;
+    var s: Parser = .{ .p = p, .lines = try lines(p, source) };
+    if (s.lines.len == 0 or s.lines[0].indent != 0) return error.Unsupported;
+    p.body = try s.block(0, &p.globals, false, 0, 0);
+    if (s.pos != s.lines.len) return error.Unsupported;
+    for (p.nodes.items) |n| {
+        if (n.tag == .name and std.mem.eql(u8, n.text, "__name__")) _ = try p.globals.bind(p.a, "__name__");
+    }
+    try protectedScope(p, &p.globals);
+    for (p.functions.items) |*f| try protectedScope(p, &f.scope);
+}
+
+const Line = struct { indent: usize, text: []const u8 };
+const Parser = struct {
+    p: *ast.Program,
+    lines: []const Line,
+    pos: usize = 0,
+    count: usize = 0,
+
+    fn block(s: *Parser, indent: usize, scope: *ast.Scope, function: bool, loops: usize, depth: usize) ast.Error![]const ast.Stmt {
+        if (depth >= 16) return error.Unsupported;
+        var out: std.ArrayList(ast.Stmt) = .empty;
+        while (s.pos < s.lines.len) {
+            const line = s.lines[s.pos];
+            if (line.indent < indent) break;
+            if (line.indent != indent) return error.Unsupported;
+            if (starts(line.text, "else:") or starts(line.text, "elif ")) break;
+            s.pos += 1;
+            try s.statements(&out, line.text, indent, scope, function, loops, depth);
+        }
+        if (out.items.len == 0) return error.Unsupported;
+        return out.toOwnedSlice(s.p.a);
+    }
+
+    fn statements(s: *Parser, out: *std.ArrayList(ast.Stmt), text: []const u8, indent: usize, scope: *ast.Scope, function: bool, loops: usize, depth: usize) ast.Error!void {
+        if (compound(text)) {
+            try out.append(s.p.a, try s.statement(text, indent, scope, function, loops, depth));
+            return;
+        }
+        var rest = text;
+        while (rest.len != 0) {
+            const sep = topChar(rest, ';') orelse rest.len;
+            const part = trim(rest[0..sep]);
+            if (part.len == 0 or compound(part)) return error.Unsupported;
+            try out.append(s.p.a, try s.statement(part, indent, scope, function, loops, depth));
+            if (sep == rest.len) break;
+            rest = trim(rest[sep + 1 ..]);
+        }
+    }
+
+    fn suite(s: *Parser, tail: []const u8, indent: usize, scope: *ast.Scope, function: bool, loops: usize, depth: usize) ast.Error![]const ast.Stmt {
+        if (depth >= 16) return error.Unsupported;
+        if (trim(tail).len != 0) {
+            if (compound(trim(tail))) return error.Unsupported;
+            var out: std.ArrayList(ast.Stmt) = .empty;
+            try s.statements(&out, trim(tail), indent, scope, function, loops, depth + 1);
+            return out.toOwnedSlice(s.p.a);
+        }
+        if (s.pos == s.lines.len or s.lines[s.pos].indent <= indent) return error.Unsupported;
+        return s.block(s.lines[s.pos].indent, scope, function, loops, depth + 1);
+    }
+
+    fn conditional(s: *Parser, text: []const u8, indent: usize, scope: *ast.Scope, function: bool, loops: usize, depth: usize) ast.Error!ast.Stmt {
+        if (depth >= 16) return error.Unsupported;
+        const colon = topChar(text, ':') orelse return error.Unsupported;
+        const condition = try expr.parse(s.p, trim(text[0..colon]));
+        const body = try s.suite(text[colon + 1 ..], indent, scope, function, loops, depth);
+        var otherwise: []const ast.Stmt = &.{};
+        if (s.pos < s.lines.len and s.lines[s.pos].indent == indent) {
+            const next = s.lines[s.pos].text;
+            if (starts(next, "else:")) {
+                s.pos += 1;
+                otherwise = try s.suite(next[5..], indent, scope, function, loops, depth);
+            } else if (starts(next, "elif ")) {
+                s.pos += 1;
+                const branch = try s.p.a.alloc(ast.Stmt, 1);
+                branch[0] = try s.conditional(next[5..], indent, scope, function, loops, depth + 1);
+                otherwise = branch;
+            }
+        }
+        return .{ .tag = .conditional, .expr = condition, .body = body, .otherwise = otherwise };
+    }
+
+    fn statement(s: *Parser, text: []const u8, indent: usize, scope: *ast.Scope, function: bool, loops: usize, depth: usize) ast.Error!ast.Stmt {
+        if (s.count >= 256) return error.Unsupported;
+        s.count += 1;
+        if (keyword(text, "if")) return s.conditional(text[2..], indent, scope, function, loops, depth);
+        if (starts(text, "def ")) {
+            if (function or depth != 0 or s.p.functions.items.len >= 16) return error.Unsupported;
+            return s.definition(text[4..], indent, depth);
+        }
+        if (starts(text, "for ") or keyword(text, "while")) {
+            const is_for = starts(text, "for ");
+            const header_start: usize = if (is_for) 4 else 5;
+            const header = text[header_start..];
+            const colon = topChar(header, ':') orelse return error.Unsupported;
+            var targets: []const ast.Id = &.{};
+            const value = if (is_for) blk: {
+                const sep = topWord(header[0..colon], "in") orelse return error.Unsupported;
+                const target = try expr.parse(s.p, trim(header[0..sep]));
+                try bindTarget(s.p, scope, target, false, 0);
+                targets = try s.p.a.dupe(ast.Id, &.{target});
+                break :blk try expr.parse(s.p, trim(header[sep + 2 .. colon]));
+            } else try expr.parse(s.p, trim(header[0..colon]));
+            const body = try s.suite(header[colon + 1 ..], indent, scope, function, loops + 1, depth);
+            return .{ .tag = if (is_for) .for_loop else .while_loop, .targets = targets, .expr = value, .body = body };
+        }
+        if (std.mem.eql(u8, text, "break") or std.mem.eql(u8, text, "continue")) {
+            if (loops == 0) return error.Unsupported;
+            return .{ .tag = if (text[0] == 'b') .break_loop else .continue_loop };
+        }
+        if (std.mem.eql(u8, text, "pass")) return .{ .tag = .pass };
+        if (keyword(text, "return")) {
+            if (!function) return error.Unsupported;
+            const tail = trim(text[6..]);
+            return .{ .tag = .ret, .expr = if (tail.len == 0) null else try expr.parse(s.p, tail) };
+        }
+        if (keyword(text, "assert")) {
+            const tail = trim(text[6..]);
+            if (topChar(tail, ',') != null) return error.Unsupported;
+            return .{ .tag = .assertion, .expr = try expr.parse(s.p, tail) };
+        }
+        if (assignment(text)) |eq| {
+            var lhs = trim(text[0..eq]);
+            const rhs = trim(text[eq + 1 ..]);
+            if (lhs.len == 0 or rhs.len == 0) return error.Unsupported;
+            var op: ?ast.Tag = null;
+            if (std.mem.endsWith(u8, lhs, "//")) {
+                lhs = trim(lhs[0 .. lhs.len - 2]);
+                op = .floor;
+            } else {
+                op = switch (lhs[lhs.len - 1]) {
+                    '+' => .add,
+                    '-' => .sub,
+                    '*' => .mul,
+                    '%' => .modulo,
+                    else => null,
+                };
+                if (op != null) lhs = trim(lhs[0 .. lhs.len - 1]);
+            }
+            var targets: std.ArrayList(ast.Id) = .empty;
+            const target = try expr.parse(s.p, lhs);
+            try bindTarget(s.p, scope, target, true, 0);
+            if (op != null and s.p.nodes.items[target].tag != .name and s.p.nodes.items[target].tag != .index)
+                return error.Unsupported;
+            try targets.append(s.p.a, target);
+            var rest = rhs;
+            while (assignment(rest)) |next| {
+                if (op != null) return error.Unsupported;
+                const chained = try expr.parse(s.p, trim(rest[0..next]));
+                try bindTarget(s.p, scope, chained, true, 0);
+                try targets.append(s.p.a, chained);
+                rest = trim(rest[next + 1 ..]);
+            }
+            return .{ .tag = if (op != null) .augassign else .assign, .op = op orelse .add, .targets = try targets.toOwnedSlice(s.p.a), .expr = try expr.parse(s.p, rest) };
+        }
+        const root = try expr.parse(s.p, text);
+        const node = s.p.nodes.items[root];
+        if (node.tag == .call and std.mem.eql(u8, node.text, "print")) {
+            for (node.keywords) |key| if (key.len != 0) return error.Unsupported;
+            return .{ .tag = .print, .targets = node.args };
+        }
+        return .{ .tag = .expression, .expr = root };
+    }
+
+    fn definition(s: *Parser, text: []const u8, indent: usize, depth: usize) ast.Error!ast.Stmt {
+        var e: expr.Parser = .{ .p = s.p, .source = text };
+        const name = try e.identifier();
+        if (builtinName(name) or s.p.functionId(name) != null) return error.Unsupported;
+        try e.need("(");
+        var params: std.ArrayList([]const u8) = .empty;
+        var scope: ast.Scope = .{};
+        if (!e.eat(")")) while (true) {
+            const param = try e.identifier();
+            if (scope.find(param) != null or builtinName(param)) return error.Unsupported;
+            _ = try scope.bind(s.p.a, param);
+            try params.append(s.p.a, param);
+            if (e.eat(")")) break;
+            try e.need(",");
+            if (e.eat(")")) break;
+        };
+        try e.need(":");
+        const id = s.p.functions.items.len;
+        try s.p.functions.append(s.p.a, .{ .name = name, .params = try params.toOwnedSlice(s.p.a) });
+        const body = try s.suite(text[e.pos..], indent, &scope, true, 0, depth);
+        s.p.functions.items[id].scope = scope;
+        s.p.functions.items[id].body = body;
+        return .{ .tag = .function, .function = id };
+    }
+};
+
+fn bindTarget(p: *ast.Program, scope: *ast.Scope, id: ast.Id, index: bool, depth: usize) ast.Error!void {
+    if (depth >= 24) return error.Unsupported;
+    const n = p.nodes.items[id];
+    switch (n.tag) {
+        .name => {
+            if (builtinName(n.text) or std.mem.eql(u8, n.text, "__name__")) return error.Unsupported;
+            _ = try scope.bind(p.a, n.text);
+        },
+        .tuple, .list => {
+            if (n.args.len == 0) return error.Unsupported;
+            p.nodes.items[id].tag = .tuple;
+            for (n.args) |arg| try bindTarget(p, scope, arg, index, depth + 1);
+        },
+        .index => if (!index) return error.Unsupported,
+        else => return error.Unsupported,
+    }
+}
+
+fn protectedScope(p: *const ast.Program, scope: *const ast.Scope) ast.Error!void {
+    for (scope.names.items) |name| if (p.functionId(name) != null) return error.Unsupported;
+    for (p.nodes.items) |n| {
+        if (n.tag == .call and scope.find(n.text) != null) return error.Unsupported;
+        if (n.tag == .comprehension and (builtinName(n.text) or p.functionId(n.text) != null)) return error.Unsupported;
+    }
+}
+
+fn builtinName(name: []const u8) bool {
+    const names = [_][]const u8{ "print", "len", "sum", "min", "max", "range", "enumerate", "zip", "sorted", "set", "dict", "list", "tuple", "str", "int", "bool", "any", "all", "map", "abs", "reversed" };
+    for (names) |n| if (std.mem.eql(u8, n, name)) return true;
+    return false;
+}
+
+fn trim(text: []const u8) []const u8 {
+    return std.mem.trim(u8, text, " \t\r\n");
+}
+
+fn starts(text: []const u8, prefix: []const u8) bool {
+    return std.mem.startsWith(u8, text, prefix);
+}
+
+fn keyword(text: []const u8, word: []const u8) bool {
+    return starts(text, word) and (text.len == word.len or
+        !(std.ascii.isAlphanumeric(text[word.len]) or text[word.len] == '_'));
+}
+
+fn compound(text: []const u8) bool {
+    return keyword(text, "if") or starts(text, "for ") or keyword(text, "while") or starts(text, "def ");
+}
+
+pub fn topChar(text: []const u8, wanted: u8) ?usize {
+    var nesting: usize = 0;
+    var quote: u8 = 0;
+    var escaped = false;
+    for (text, 0..) |c, i| {
+        if (quote != 0) {
+            if (escaped) escaped = false else if (c == '\\') escaped = true else if (c == quote) quote = 0;
+        } else if (c == '\'' or c == '"') {
+            quote = c;
+        } else if (nesting == 0 and c == wanted) {
+            return i;
+        } else if (c == '(' or c == '[' or c == '{') {
+            nesting += 1;
+        } else if (c == ')' or c == ']' or c == '}') {
+            if (nesting == 0) return null;
+            nesting -= 1;
+        }
+    }
+    return null;
+}
+
+fn topWord(text: []const u8, word: []const u8) ?usize {
+    var offset: usize = 0;
+    while (offset < text.len) {
+        const relative = topChar(text[offset..], word[0]) orelse return null;
+        const i = offset + relative;
+        if ((i == 0 or text[i - 1] == ' ') and starts(text[i..], word) and
+            (i + word.len == text.len or text[i + word.len] == ' ')) return i;
+        offset = i + 1;
+    }
+    return null;
+}
+
+fn assignment(text: []const u8) ?usize {
+    var offset: usize = 0;
+    while (offset < text.len) {
+        const relative = topChar(text[offset..], '=') orelse return null;
+        const i = offset + relative;
+        if ((i == 0 or std.mem.indexOfScalar(u8, "=!<>", text[i - 1]) == null) and
+            (i + 1 == text.len or text[i + 1] != '=')) return i;
+        offset = i + 1;
+    }
+    return null;
+}
+
+fn lines(p: *ast.Program, source: []const u8) ast.Error![]const Line {
+    var out: std.ArrayList(Line) = .empty;
+    var text: std.ArrayList(u8) = .empty;
+    var stack: [24]u8 = undefined;
+    var depth: usize = 0;
+    var quote: u8 = 0;
+    var escaped = false;
+    var comment = false;
+    var beginning = true;
+    var indent: usize = 0;
+    for (source, 0..) |c, source_pos| {
+        if (c == '\r') {
+            if (source_pos + 1 < source.len and source[source_pos + 1] == '\n') continue;
+            return error.Unsupported;
+        }
+        if (c == 0 or c >= 128 or (c < 32 and c != '\n' and c != '\t')) return error.Unsupported;
+        if (comment and c != '\n') continue;
+        if (c == '\n' and quote == 0) {
+            comment = false;
+            if (depth != 0) {
+                try text.append(p.a, ' ');
+            } else {
+                const value = trim(text.items);
+                if (value.len != 0) try out.append(p.a, .{ .indent = indent, .text = try p.a.dupe(u8, value) });
+                text.clearRetainingCapacity();
+                beginning = true;
+                indent = 0;
+            }
+            continue;
+        }
+        if (quote != 0) {
+            if (c == '\n') return error.Unsupported;
+            if (escaped) escaped = false else if (c == '\\') escaped = true else if (c == quote) quote = 0;
+        } else {
+            if (c == '#') {
+                comment = true;
+                continue;
+            }
+            if (beginning and c == ' ') {
+                indent += 1;
+                continue;
+            }
+            if (c == '\t') return error.Unsupported;
+            beginning = false;
+            if (c == '\'' or c == '"') quote = c else if (c == '(' or c == '[' or c == '{') {
+                if (depth == stack.len) return error.Unsupported;
+                stack[depth] = c;
+                depth += 1;
+            } else if (c == ')' or c == ']' or c == '}') {
+                if (depth == 0) return error.Unsupported;
+                depth -= 1;
+                const expected: u8 = switch (c) {
+                    ')' => '(',
+                    ']' => '[',
+                    else => '{',
+                };
+                if (stack[depth] != expected) return error.Unsupported;
+            }
+        }
+        try text.append(p.a, c);
+    }
+    if (quote != 0 or depth != 0) return error.Unsupported;
+    const value = trim(text.items);
+    if (value.len != 0) try out.append(p.a, .{ .indent = indent, .text = try p.a.dupe(u8, value) });
+    return out.toOwnedSlice(p.a);
+}
+
+test "collections parser preserves print grouping and conditional slots" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    var p: ast.Program = .{ .a = arena.allocator() };
+    try parse(&p, "print(1, 2); print((1, 2)); print(3 if True else 4)");
+    try std.testing.expectEqual(@as(usize, 3), p.body.len);
+    try std.testing.expectEqual(@as(usize, 2), p.body[0].targets.len);
+    try std.testing.expectEqual(@as(usize, 1), p.body[1].targets.len);
+    try std.testing.expectEqual(ast.Tag.tuple, p.nodes.items[p.body[1].targets[0]].tag);
+    const choice = p.nodes.items[p.body[2].targets[0]];
+    try std.testing.expectEqual(ast.Tag.conditional, choice.tag);
+    try std.testing.expectEqual(@as(i64, 3), p.nodes.items[choice.a].value);
+    try std.testing.expectEqual(ast.Tag.boolean, p.nodes.items[choice.b].tag);
+    try std.testing.expectEqual(@as(i64, 4), p.nodes.items[choice.c.?].value);
+
+    const slices = [_][]const u8{ "a[:]", "a[1:3]", "a[::-1]" };
+    for (slices, 0..) |source, i| {
+        const slice_id = try expr.parse(&p, source);
+        const slice = p.nodes.items[slice_id];
+        try std.testing.expectEqual(ast.Tag.slice, slice.tag);
+        try std.testing.expectEqualStrings("a", p.nodes.items[slice.a].text);
+        try std.testing.expectEqual(@as(usize, 3), slice.args.len);
+        if (i == 1) {
+            try std.testing.expectEqual(@as(i64, 1), p.nodes.items[slice.args[0]].value);
+            try std.testing.expectEqual(@as(i64, 3), p.nodes.items[slice.args[1]].value);
+        } else {
+            try std.testing.expectEqual(ast.Tag.none, p.nodes.items[slice.args[0]].tag);
+            try std.testing.expectEqual(ast.Tag.none, p.nodes.items[slice.args[1]].tag);
+        }
+        try std.testing.expectEqual(if (i == 2) ast.Tag.neg else ast.Tag.none, p.nodes.items[slice.args[2]].tag);
+    }
+    const nested_id = try expr.parse(&p, "a[0][1:3]");
+    const nested = p.nodes.items[nested_id];
+    try std.testing.expectEqual(ast.Tag.slice, nested.tag);
+    const indexed = p.nodes.items[nested.a];
+    try std.testing.expectEqual(ast.Tag.index, indexed.tag);
+    try std.testing.expectEqualStrings("a", p.nodes.items[indexed.a].text);
+    const after_slice_id = try expr.parse(&p, "a[:][0]");
+    const after_slice = p.nodes.items[after_slice_id];
+    try std.testing.expectEqual(ast.Tag.index, after_slice.tag);
+    try std.testing.expectEqual(ast.Tag.slice, p.nodes.items[after_slice.a].tag);
+    const ordinary_id = try expr.parse(&p, "a[0][1]");
+    const ordinary = p.nodes.items[ordinary_id];
+    try std.testing.expectEqual(ast.Tag.index, ordinary.tag);
+    try std.testing.expectEqual(ast.Tag.index, p.nodes.items[ordinary.a].tag);
+}
+
+test "collections parser builds source calls and parameter first recursive scopes" {
