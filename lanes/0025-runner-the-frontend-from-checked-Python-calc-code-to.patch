new file mode 100644
index 000000000..71549da5f
--- /dev/null
+++ b/zig/src/core/runner_frontend_integer_ast.zig
@@ -0,0 +1,573 @@
+const std = @import("std");
+const list = @import("runner_frontend_integer_list.zig");
+
+pub const Invalid = error{Unsupported};
+pub const limit: i512 = std.math.pow(i512, 10, 62);
+/// Elements all of a script's lists may hold together (each one a node, so the node budget binds first).
+pub const max_items = 64;
+/// Nodes a whole script may make (loops unroll into them); other lowerings keep `capacity`'s 64, the C runtime's.
+pub const max_nodes = 512;
+/// A name bound but not yet assigned: a function's local before its first assignment (UnboundLocalError).
+pub const unbound = std.math.maxInt(usize);
+pub const Op = enum(u8) { literal, neg, add, sub, mul, floor, mod, pow, powmod, digits, divmod, gcd, isqrt, factorial, range_product, digit_sum, eq, ne, lt, le, gt, ge };
+pub const Node = struct {
+    op: Op,
+    l: usize = 0,
+    r: usize = 0,
+    k: usize = 0,
+    value: i512 = 0,
+    text: []const u8 = "",
+    base: u8 = 10,
+};
+pub const Parser = struct {
+    source: []const u8,
+    pos: usize = 0,
+    nodes: [max_nodes]Node = undefined,
+    count: usize = 0,
+    capacity: usize = 64,
+    proved: [max_nodes]bool = @splat(false),
+    names: [64][]const u8 = undefined,
+    roots: [64]usize = undefined,
+    binding_count: usize = 0,
+    require_math_import: bool = false,
+    math_module: bool = false,
+    math_imports: u8 = 0,
+    functions: [8]Function = undefined,
+    function_count: usize = 0,
+    // inside an inlined body: its parameters are bindings[frame..], the module's are bindings[0..globals]
+    frame: ?Frame = null,
+    active: u8 = 0, // functions being inlined, one bit each: a call to one of them is recursion
+    check_only: bool = false, // a def's body at its definition: syntax only, names are not looked up
+    // static int lists: parse-time values over element nodes; a name of kind list holds its index in lists
+    items: [max_items]usize = undefined,
+    item_count: usize = 0,
+    lists: [16]list.List = undefined,
+    list_count: usize = 0,
+    kinds: [64]bool = undefined,
+    module_count: usize = 0, // the module's names: bindings[0..module_count] outside any frame or comprehension
+    allow_lists: bool = false, // the whole-script lowering's lists and min/max; every other parser keeps its grammar
+    listed: bool = false, // a list or min/max parsed: the graph route's script only (calc and ELF keep their own)
+    asserted: bool = false, // an `assert` proved: like a def or a list, the graph route's script only
+    looped: bool = false, // a loop, a suite body or a digit reversal: the graph route's script only
+    calls: u8 = 0, // nested calls being inlined: a suite's recursion stops at 24
+    no_recurse: bool = false, // a branch tried only if it needs no recursion (a schedule's last level)
+    recursions: u32 = 0, // recursive calls inlined so far: a branch that recursed is not a schedule's last level
+    cut: bool = false, // a recursion no_recurse refused: the untaken branch is past the schedule, not unsupported
+
+    /// `def name(params): return <expr>`, inlined at each call; `body` borrows the script.
+    pub const Function = struct { name: []const u8, params: [4][]const u8 = undefined, arity: usize = 0, body: []const u8, suite: []const u8 = "" };
+    const Frame = struct { start: usize, globals: usize };
+    /// An int node, or a list's index in `lists`.
+    pub const Operand = struct { index: usize, list: bool };
+    pub const Mark = struct { pos: usize, count: usize, items: usize, lists: usize };
+
+    // Names and literal slices borrow source storage; bind after parsing the RHS to preserve prior roots.
+    pub fn bind(self: *Parser, name: []const u8, root: usize) Invalid!void {
+        return self.bindAs(name, .{ .index = root, .list = false });
+    }
+
+    pub fn bindAs(self: *Parser, name: []const u8, v: Operand) Invalid!void {
+        if (name.len == 0 or v.index >= (if (v.list) self.list_count else self.count) or self.function(name) != null)
+            return error.Unsupported;
+        for (self.names[0..self.binding_count], self.roots[0..self.binding_count], 0..) |bound_name, *bound_root, i| {
+            if (std.mem.eql(u8, name, bound_name)) {
+                bound_root.* = v.index;
+                self.kinds[i] = v.list;
+                return;
+            }
+        }
+        if (self.binding_count == self.names.len) return error.Unsupported;
+        self.names[self.binding_count] = name;
+        self.roots[self.binding_count] = v.index;
+        self.kinds[self.binding_count] = v.list;
+        self.binding_count += 1;
+        self.module_count = self.binding_count;
+    }
+
+    /// Where to drop what a parse added (a failed attempt, or nodes only a proof reads).
+    pub fn mark(self: *const Parser) Mark {
+        return .{ .pos = self.pos, .count = self.count, .items = self.item_count, .lists = self.list_count };
+    }
+
+    pub fn reset(self: *Parser, m: Mark) void {
+        self.pos, self.count, self.item_count, self.list_count = .{ m.pos, m.count, m.items, m.lists };
+    }
+
+    /// A call argument or a whole right side: a list when one parses up to `,`, `)` or the end, else an int.
+    pub fn operand(self: *Parser, depth: usize) Invalid!Operand {
+        if (list.ahead(self)) {
+            const m = self.mark();
+            if (list.parse(self, depth)) |li| {
+                self.space();
+                if (self.pos == self.source.len or self.source[self.pos] == ',' or self.source[self.pos] == ')')
+                    return .{ .index = li, .list = true };
+            } else |_| {}
+            self.reset(m);
+        }
+        return .{ .index = try self.expr(depth), .list = false };
+    }
+
+    /// A def as Python compiles it: the body must parse now (names resolve at each call), the name must be new.
+    pub fn define(self: *Parser, f: Function) Invalid!void {
+        if (self.function_count == self.functions.len or self.function(f.name) != null) return error.Unsupported;
+        for (self.names[0..self.binding_count]) |held| if (std.mem.eql(u8, held, f.name)) return error.Unsupported;
+        for (f.params[0..f.arity], 0..) |p, i| {
+            if (std.mem.eql(u8, p, f.name)) return error.Unsupported;
+            for (f.params[0..i]) |q| if (std.mem.eql(u8, p, q)) return error.Unsupported;
+        }
+        const saved = .{ self.source, self.pos, self.count, self.item_count, self.list_count };
+        defer {
+            self.source, self.pos, self.count, self.item_count, self.list_count = saved;
+            self.check_only = false;
+        }
+        self.check_only = true;
+        if (f.suite.len != 0) try @import("runner_frontend_integer_suite.zig").check(self, f.suite) else {
+            self.source = f.body;
+            self.pos = 0;
+            _ = try self.expr(0);
+            self.space();
+            if (self.pos != self.source.len) return error.Unsupported;
+        }
+        self.functions[self.function_count] = f;
+        self.function_count += 1;
+    }
+
+    fn function(self: *const Parser, name: []const u8) ?usize {
+        for (self.functions[0..self.function_count], 0..) |f, i| if (std.mem.eql(u8, f.name, name)) return i;
+        return null;
+    }
+
+    /// A name's binding: a body's params, then module names (never a caller's); newest first, so targets shadow.
+    pub fn slot(self: *const Parser, name: []const u8) ?usize {
+        const visible: [2][2]usize = if (self.frame) |f| .{ .{ f.start, self.binding_count }, .{ 0, f.globals } } else .{ .{ 0, self.binding_count }, .{ 0, 0 } };
+        for (visible) |range| {
+            var i = range[1];
+            while (i > range[0]) {
+                i -= 1;
+                if (std.mem.eql(u8, name, self.names[i])) return i;
+            }
+        }
+        return null;
+    }
+
+    fn lookup(self: *const Parser, name: []const u8) ?usize {
+        const s = self.slot(name) orelse return null;
+        return if (self.kinds[s] or self.roots[s] == unbound) null else self.roots[s];
+    }
+
+    pub fn lookupList(self: *const Parser, name: []const u8) ?usize {
+        const s = self.slot(name) orelse return null;
+        return if (self.kinds[s]) self.roots[s] else null;
+    }
+
+    /// `f(args)` with f's body parsed over the argument nodes: pure, so inlining is exact; recursion refuses.
+    fn call(self: *Parser, index: usize, depth: usize) Invalid!usize {
+        const f = self.functions[index];
+        const bit = @as(u8, 1) << @intCast(index);
+        // only a suite recurses, within its schedule (runner_frontend_integer_suite.zig)
+        if (self.active & bit != 0) {
+            if (f.suite.len == 0 or self.calls >= 24) return error.Unsupported;
+            if (self.no_recurse) {
+                self.cut = true;
+                return error.Unsupported;
+            }
+            self.recursions += 1;
+        }
+        var args: [4]Operand = undefined;
+        var n: usize = 0;
+        try self.need("(");
+        if (!self.take(")")) while (true) {
+            if (n == args.len) return error.Unsupported;
+            args[n] = try self.operand(depth + 1);
+            n += 1;
+            if (self.take(")")) break;
+            try self.need(",");
+        };
+        if (n != f.arity or self.binding_count + n > self.names.len) return error.Unsupported;
+        const saved = .{ self.source, self.pos, self.binding_count, self.frame, self.active, self.calls };
+        defer {
+            self.source, self.pos, self.binding_count, self.frame, self.active, self.calls = saved;
+        }
+        // read the outer frame before writing: a struct literal assigned in place may alias self.frame
+        const globals = if (self.frame) |outer| outer.globals else self.module_count;
+        self.frame = .{ .start = self.binding_count, .globals = globals };
+        for (f.params[0..n], args[0..n]) |p, arg| {
+            self.names[self.binding_count] = p;
+            self.roots[self.binding_count] = arg.index;
+            self.kinds[self.binding_count] = arg.list;
+            self.binding_count += 1;
+        }
+        self.active |= bit;
+        self.calls += 1;
+        if (f.suite.len != 0) return @import("runner_frontend_integer_suite.zig").call(self, f.suite);
+        self.source = f.body;
+        self.pos = 0;
+        const root = try self.expr(depth + 1);
+        self.space();
+        if (self.pos != self.source.len) return error.Unsupported;
+        return root;
+    }
+
+    pub fn parse(self: *Parser) Invalid!usize {
+        self.space();
+        if (self.pos == self.source.len or self.source[self.pos] == '+') return error.Unsupported;
+        const root = try self.expr(0);
+        self.space();
+        if (self.pos != self.source.len) return error.Unsupported;
+        _ = try self.prove(root, root);
+        return root;
+    }
+
+    // Project both results from the original operands; proof values never become literal nodes.
+    pub fn divisionPair(self: *Parser, root: usize) Invalid![2]usize {
+        if (root >= self.count or self.nodes[root].op != .divmod or self.count > self.capacity - 2)
+            return error.Unsupported;
+        _ = try self.prove(root, root);
+        const n = self.nodes[root];
+        const q = try self.add(.{ .op = .floor, .l = n.l, .r = n.r });
+        const r = try self.add(.{ .op = .mod, .l = n.l, .r = n.r });
+        _ = try self.prove(q, q);
+        _ = try self.prove(r, r);
+        return .{ q, r };
+    }
+
+    pub fn space(self: *Parser) void {
+        while (self.pos < self.source.len and (self.source[self.pos] == ' ' or self.source[self.pos] == '\t'))
+            self.pos += 1;
+    }
+
+    pub fn take(self: *Parser, s: []const u8) bool {
+        self.space();
+        if (!std.mem.startsWith(u8, self.source[self.pos..], s)) return false;
+        self.pos += s.len;
+        return true;
+    }
+
+    pub fn need(self: *Parser, s: []const u8) Invalid!void {
+        if (!self.take(s)) return error.Unsupported;
+    }
+
+    pub fn add(self: *Parser, node: Node) Invalid!usize {
+        if (self.count == self.capacity) return error.Unsupported;
+        self.nodes[self.count] = node;
+        self.proved[self.count] = false; // a reset may reuse the slot
+        self.count += 1;
+        return self.count - 1;
+    }
+
+    fn comparison(self: *Parser) ?Op {
+        const tokens = [_][]const u8{ "==", "!=", "<", "<=", ">", ">=" };
+        const ops = [_]Op{ .eq, .ne, .lt, .le, .gt, .ge };
+        for ([_]usize{ 0, 1, 3, 5, 2, 4 }) |i| {
+            if (self.take(tokens[i])) return ops[i];
+        }
+        return null;
+    }
+
+    pub fn expr(self: *Parser, depth: usize) Invalid!usize {
+        const left = try self.sum(depth);
+        const op = self.comparison() orelse return left;
+        const right = try self.sum(depth);
+        if (self.comparison() != null) return error.Unsupported;
+        return self.add(.{ .op = op, .l = left, .r = right });
+    }
+
+    fn sum(self: *Parser, depth: usize) Invalid!usize {
+        if (depth > 12) return error.Unsupported;
+        var left = try self.term(depth);
+        while (true) {
+            const op: Op = if (self.take("+")) .add else if (self.take("-")) .sub else break;
+            left = try self.add(.{ .op = op, .l = left, .r = try self.term(depth) });
+        }
+        return left;
+    }
+
+    fn term(self: *Parser, depth: usize) Invalid!usize {
+        var left = try self.factor(depth);
+        while (true) {
+            const op: Op = if (self.take("//")) .floor else if (self.take("%")) .mod else if (self.take("*")) .mul else break;
+            const right = try self.factor(depth);
+            const n = self.nodes[left];
+            if (op == .mod and n.op == .pow) {
+                left = try self.add(.{ .op = .powmod, .l = n.l, .r = n.r, .k = right });
+            } else if (op == .mod and n.op == .neg and self.nodes[n.l].op == .pow) {
+                const p = self.nodes[n.l];
+                const reduced = try self.add(.{ .op = .powmod, .l = p.l, .r = p.r, .k = right });
+                const negative = try self.add(.{ .op = .neg, .l = reduced });
+                left = try self.add(.{ .op = .mod, .l = negative, .r = right });
+            } else {
+                left = try self.add(.{ .op = op, .l = left, .r = right });
+            }
+        }
+        return left;
+    }
+
+    pub fn boolean(self: *const Parser, index: usize) bool {
+        return switch (self.nodes[index].op) {
+            .eq, .ne, .lt, .le, .gt, .ge => true,
+            else => false,
+        };
+    }
+
+    fn factor(self: *Parser, depth: usize) Invalid!usize {
+        if (depth > 12) return error.Unsupported;
+        if (self.take("+")) {
+            const child = try self.factor(depth + 1);
+            if (self.boolean(child)) return error.Unsupported;
+            return child;
+        }
+        if (self.take("-")) return self.add(.{ .op = .neg, .l = try self.factor(depth + 1) });
+        const left = try self.atom(depth);
+        if (self.take("**")) return self.add(.{ .op = .pow, .l = left, .r = try self.factor(depth + 1) });
+        return left;
+    }
+
+    fn atom(self: *Parser, depth: usize) Invalid!usize {
+        if (self.take("(")) {
+            const n = try self.expr(depth + 1);
+            try self.need(")");
+            return n;
+        }
+        if (list.ahead(self)) return list.index(self, try list.parse(self, depth), depth);
+        if (try self.algorithm(depth)) |n| return n;
+        if (self.word("sum")) {
+            if (!self.allow_lists) return self.digitSum(depth);
+            const m = self.mark();
+            if (self.digitSum(depth)) |n| return n else |_| self.reset(m);
+            return list.sum(self, depth);
+        }
+        if (self.allow_lists and self.word("min")) return list.extreme(self, depth, false);
+        if (self.allow_lists and self.word("max")) return list.extreme(self, depth, true);
+        if (self.word("divmod")) {
+            try self.need("(");
+            const a = try self.expr(depth + 1);
+            try self.need(",");
+            const b = try self.expr(depth + 1);
+            try self.need(")");
+            return self.add(.{ .op = .divmod, .l = a, .r = b });
+        }
+        if (self.word("pow")) {
+            try self.need("(");
+            const a = try self.expr(depth + 1);
+            try self.need(",");
+            const b = try self.expr(depth + 1);
+            if (!self.take(",")) return error.Unsupported;
+            const m = try self.expr(depth + 1);
+            try self.need(")");
+            return self.add(.{ .op = .powmod, .l = a, .r = b, .k = m });
+        }
+        if (self.word("len")) {
+            if (!self.allow_lists) return self.textLength(depth);
+            const m = self.mark();
+            if (self.textLength(depth)) |n| return n else |_| self.reset(m);
+            return list.length(self, depth);
+        }
+        if (self.word("int")) return if (self.take("(str(")) @import("runner_frontend_integer_digits.zig").reversed(self, depth) else self.convert();
+        self.space();
+        if (self.pos < self.source.len and
+            (std.ascii.isAlphabetic(self.source[self.pos]) or self.source[self.pos] == '_'))
+        {
+            const name = try self.identifier();
+            self.space();
+            const called = self.pos < self.source.len and self.source[self.pos] == '(';
+            if (self.check_only) {
+                // a def's body at its definition: any name, any call (defined later or not), resolved when it runs
+                if (called) {
+                    try self.need("(");
+                    if (!self.take(")")) while (true) {
+                        _ = try self.operand(depth + 1);
+                        if (self.take(")")) break;
+                        try self.need(",");
+                    };
+                } else if (self.take("[")) {
+                    _ = try self.expr(depth + 1);
+                    try self.need("]");
+                }
+                return self.add(.{ .op = .literal, .value = 1, .text = "1" });
+            }
+            if (called) return self.call(self.function(name) orelse return error.Unsupported, depth);
+            return self.lookup(name) orelse error.Unsupported;
+        }
+        return self.literal();
+    }
+
+    fn algorithm(self: *Parser, depth: usize) Invalid!?usize {
+        const start = self.pos;
+        const qualified = self.word("math");
+        if (qualified) try self.need(".");
+        const op: Op = if (self.word("gcd")) .gcd else if (self.word("isqrt")) .isqrt else if (self.word("factorial")) .factorial else if (self.word("prod")) .range_product else {
+            if (qualified) return error.Unsupported;
+            return null;
+        };
+        if (self.require_math_import) {
+            const mask: u8 = switch (op) {
+                .gcd => 1,
+                .isqrt => 2,
+                .factorial => 4,
+                .range_product => 8,
+                else => unreachable,
+            };
+            if (!qualified and self.math_imports & mask == 0) {
+                self.pos = start; // not imported: a def of that name, or nothing (the call refuses)
+                return null;
+            }
+            if (qualified and !self.math_module) return error.Unsupported;
+        }
+        try self.need("(");
+        if (op == .range_product) {
+            try self.need("range");
+            try self.need("(");
+        }
+        var a = try self.expr(depth + 1);
+        var b: usize = 0;
+        var k: usize = 0;
+        if (op == .gcd) {
+            try self.need(",");
+            b = try self.expr(depth + 1);
+        }
+        if (op == .range_product) {
+            if (self.take(",")) {
+                b = try self.expr(depth + 1);
+            } else {
+                b = a;
+                a = try self.add(.{ .op = .literal, .value = 0, .text = "0" });
+            }
+            k = if (self.take(",")) try self.expr(depth + 1) else try self.add(.{
+                .op = .literal,
+                .value = 1,
+                .text = "1",
+            });
+            try self.need(")");
+        }
+        try self.need(")");
+        return try self.add(.{ .op = op, .l = a, .r = b, .k = k });
+    }
+
+    pub fn word(self: *Parser, token: []const u8) bool {
+        self.space();
+        const rest = self.source[self.pos..];
+        if (!std.mem.startsWith(u8, rest, token)) return false;
+        if (rest.len > token.len and (std.ascii.isAlphanumeric(rest[token.len]) or rest[token.len] == '_'))
+            return false;
+        self.pos += token.len;
+        return true;
+    }
+
+    pub fn identifier(self: *Parser) Invalid![]const u8 {
+        self.space();
+        const start = self.pos;
+        while (self.pos < self.source.len and
+            (std.ascii.isAlphanumeric(self.source[self.pos]) or self.source[self.pos] == '_')) self.pos += 1;
+        if (start == self.pos or std.ascii.isDigit(self.source[start])) return error.Unsupported;
+        const name = self.source[start..self.pos];
+        if (std.mem.eql(u8, name, "int") or std.mem.eql(u8, name, "__debug__")) return error.Unsupported;
+        const reserved = [_][]const u8{ "False", "None", "True", "and", "as", "assert", "async", "await", "break", "class", "continue", "def", "del", "elif", "else", "except", "finally", "for", "from", "global", "if", "import", "in", "is", "lambda", "nonlocal", "not", "or", "pass", "raise", "return", "try", "while", "with", "yield" };
+        for (reserved) |token| if (std.mem.eql(u8, name, token)) return error.Unsupported;
+        return name;
+    }
+
+    /// len(str(n)): n's digit count, its sign included.
+    fn textLength(self: *Parser, depth: usize) Invalid!usize {
+        try self.need("(");
+        try self.need("str");
+        try self.need("(");
+        const n = try self.expr(depth + 1);
+        try self.need(")");
+        try self.need(")");
+        return self.add(.{ .op = .digits, .l = n });
+    }
+
+    fn digitSum(self: *Parser, depth: usize) Invalid!usize {
+        try self.need("(");
+        const mapped = self.word("map");
+        if (mapped) {
+            try self.need("(");
+            try self.need("int");
+            try self.need(",");
+        } else {
+            try self.need("int");
+            try self.need("(");
+            const name = try self.identifier();
+            try self.need(")");
+            if (!self.word("for")) return error.Unsupported;
+            const binding = try self.identifier();
+            if (!std.mem.eql(u8, name, binding) or !self.word("in")) return error.Unsupported;
+        }
+        try self.need("str");
+        try self.need("(");
+        const value = try self.expr(depth + 1);
+        try self.need(")");
+        if (mapped) try self.need(")");
+        try self.need(")");
+        return self.add(.{ .op = .digit_sum, .l = value });
+    }
+
+    fn convert(self: *Parser) Invalid!usize {
+        try self.need("(");
+        self.space();
+        if (self.pos == self.source.len) return error.Unsupported;
+        const quote = self.source[self.pos];
+        if (quote != '\'' and quote != '"') return error.Unsupported;
+        self.pos += 1;
+        const begin = self.pos;
+        while (self.pos < self.source.len and self.source[self.pos] != quote) : (self.pos += 1) {}
+        if (self.pos == self.source.len) return error.Unsupported;
+        const text = std.mem.trim(u8, self.source[begin..self.pos], " \t");
+        self.pos += 1;
+        var base: u8 = 10;
+        if (self.take(",")) {
+            if (self.take("16")) base = 16 else if (self.take("2")) base = 2 else return error.Unsupported;
+        }
+        try self.need(")");
+        var digits = text;
+        var sign: i512 = 1;
+        if (digits.len != 0 and (digits[0] == '-' or digits[0] == '+')) {
+            if (digits[0] == '-') sign = -1;
+            digits = digits[1..];
+        }
+        if (digits.len >= 2 and digits[0] == '0' and
+            ((base == 16 and (digits[1] == 'x' or digits[1] == 'X')) or
+                (base == 2 and (digits[1] == 'b' or digits[1] == 'B')))) digits = digits[2..];
+        return self.add(.{ .op = .literal, .value = sign * try radix(digits, base), .text = digits, .base = base });
+    }
+
+    fn literal(self: *Parser) Invalid!usize {
+        self.space();
+        const begin = self.pos;
+        var base: u8 = 10;
+        if (self.pos + 2 <= self.source.len and self.source[self.pos] == '0') {
+            const c = self.source[self.pos + 1];
+            if (c == 'x' or c == 'X') base = 16 else if (c == 'b' or c == 'B') base = 2;
+            if (base != 10) self.pos += 2;
+        }
+        const start = self.pos;
+        while (self.pos < self.source.len and digit(self.source[self.pos]) < base) : (self.pos += 1) {}
+        if (base == 10 and self.pos - begin > 1 and self.source[begin] == '0') return error.Unsupported;
+        const text = self.source[start..self.pos];
+        return self.add(.{ .op = .literal, .value = try radix(text, base), .text = text, .base = base });
+    }
+
+    /// The node's value, folded once (the checks and arithmetic in runner_frontend_integer_prove.zig).
+    pub fn prove(self: *Parser, index: usize, root: usize) Invalid!i512 {
+        return @import("runner_frontend_integer_prove.zig").prove(self, index, root);
+    }
+};
+
+fn digit(c: u8) u8 {
+    return if (c >= '0' and c <= '9') c - '0' else if (c >= 'a' and c <= 'f') c - 'a' + 10 else if (c >= 'A' and c <= 'F') c - 'A' + 10 else 255;
+}
+
+fn radix(text: []const u8, base: u8) Invalid!i512 {
+    if (text.len == 0) return error.Unsupported;
+    var n: i512 = 0;
+    for (text) |c| {
+        if (digit(c) >= base) return error.Unsupported;
+        n = try bound(n * base + digit(c));
+    }
+    return n;
+}
+
+pub fn bound(n: i512) Invalid!i512 {
+    if (n <= -limit or n >= limit) return error.Unsupported;
+    return n;
+}
diff --git a/zig/src/core/runner_frontend_integer_calc.zig b/zig/src/core/runner_frontend_integer_calc.zig
new file mode 100644
index 000000000..dd1113049
--- /dev/null
+++ b/zig/src/core/runner_frontend_integer_calc.zig
@@ -0,0 +1,57 @@
+const std = @import("std");
+const ast = @import("runner_frontend_integer_ast.zig");
+const calc = @import("runner_frontend_calc.zig");
+
+// Expand immutable roots with original decimal digits; calc retains its grammar and firmware safety checks.
+pub fn lower(a: std.mem.Allocator, parser: *const ast.Parser, root: usize) std.mem.Allocator.Error!?[]u8 {
+    var renderer = Renderer{ .parser = parser };
+    renderer.node(root, 0) catch return null;
+    return calc.lower(a, renderer.bytes[0..renderer.len]);
+}
+
+const Renderer = struct {
+    parser: *const ast.Parser,
+    bytes: [calc.max_input]u8 = undefined,
+    len: usize = 0,
+    visits: usize = 0,
+
+    fn emit(self: *Renderer, text: []const u8) ast.Invalid!void {
+        if (text.len > self.bytes.len - self.len) return error.Unsupported;
+        @memcpy(self.bytes[self.len..][0..text.len], text);
+        self.len += text.len;
+    }
+
+    fn node(self: *Renderer, index: usize, depth: usize) ast.Invalid!void {
+        if (index >= self.parser.count or depth > 12 or self.visits == 128) return error.Unsupported;
+        self.visits += 1;
+        const n = self.parser.nodes[index];
+        if (n.op == .literal) {
+            if (n.base != 10 or n.text.len == 0) return error.Unsupported;
+            if (n.value < 0) try self.emit("-");
+            return self.emit(n.text);
+        }
+        if (!self.parser.proved[index]) return error.Unsupported;
+        const token = switch (n.op) {
+            .neg => "-",
+            .add => "+",
+            .sub => "-",
+            .mul => "*",
+            .floor => "//",
+            .mod => "%",
+            .pow => "**",
+            .gcd => ",",
+            else => return error.Unsupported,
+        };
+        if (n.l >= index or (n.op != .neg and n.r >= index)) return error.Unsupported;
+        try self.emit(if (n.op == .gcd) "gcd(" else "(");
+        if (n.op == .neg) {
+            try self.emit(token);
+            try self.node(n.l, depth + 1);
+        } else {
+            try self.node(n.l, depth + 1);
+            try self.emit(token);
+            try self.node(n.r, depth + 1);
+        }
+        try self.emit(")");
+    }
+};
diff --git a/zig/src/core/runner_frontend_integer_cost.zig b/zig/src/core/runner_frontend_integer_cost.zig
new file mode 100644
index 000000000..f4f43d23a
--- /dev/null
+++ b/zig/src/core/runner_frontend_integer_cost.zig
@@ -0,0 +1,389 @@
+const ast = @import("runner_frontend_integer_ast.zig");
+
+const Refused = error{Refused};
+
+// Source-based RV32 instruction weights need calibration against the selected compiler and optimization mode.
+pub fn estimate(parser: *const ast.Parser, root: usize, budget: usize) ?usize {
+    return estimateMany(parser, &.{root}, budget);
+}
+
+// One shared traversal charges arithmetic once and formatting separately for every ordered output.
+pub fn estimateMany(parser: *const ast.Parser, roots: []const usize, budget: usize) ?usize {
+    if (parser.count == 0 or parser.count > 64 or roots.len == 0 or roots.len > 8) return null;
+    var counter = Counter{ .parser = parser, .root = 0, .budget = budget };
+    counter.charge(200) catch return null;
+    for (roots) |root| {
+        if (root >= parser.count) return null;
+        counter.root = root;
+        const value = counter.visit(root) catch return null;
+        const op = parser.nodes[root].op;
+        counter.charge(if (isComparison(op)) 160 else formatCost(value, true) + 16) catch return null;
+        if (op == .divmod) {
+            const n = parser.nodes[root];
+            const remainder = @mod(parser.nodes[n.l].value, parser.nodes[n.r].value);
+            counter.charge(formatCost(remainder, true) + 64) catch return null;
+        }
+    }
+    return counter.total;
+}
+
+fn isComparison(op: ast.Op) bool {
+    return switch (op) {
+        .eq, .ne, .lt, .le, .gt, .ge => true,
+        else => false,
+    };
+}
+
+const Counter = struct {
+    parser: *const ast.Parser,
+    root: usize,
+    budget: usize,
+    total: usize = 0,
+    seen: u64 = 0,
+
+    fn charge(self: *Counter, amount: usize) Refused!void {
+        if (amount > self.budget - self.total) {
+            self.total = self.budget +| 1;
+            return error.Refused;
+        }
+        self.total += amount;
+    }
+
+    fn child(self: *Counter, index: usize, parent: usize) Refused!i512 {
+        if (index >= parent) return error.Refused;
+        if (self.parser.nodes[index].op == .divmod) return error.Refused;
+        return self.visit(index);
+    }
+
+    fn visit(self: *Counter, index: usize) Refused!i512 {
+        if (index >= self.parser.count or index >= 64) return error.Refused;
+        const n = self.parser.nodes[index];
+        try bounded(n.value);
+        const mask = @as(u64, 1) << @intCast(index);
+        if (self.seen & mask != 0) return n.value;
+        self.seen |= mask;
+        try self.charge(160);
+        if (n.op == .literal) {
+            if (n.text.len == 0 or n.text.len > 4096 or (n.base != 2 and n.base != 10 and n.base != 16))
+                return error.Refused;
+            const digit_cost: usize = if (n.base == 16) 132 else 128;
+            try self.charge(if (n.base == 10) 80 + n.text.len * 8 else 48 + n.text.len * digit_cost);
+            var value: i512 = 0;
+            for (n.text, 0..) |c, i| {
+                if (n.base == 10 and i % 4 == 0) try self.charge(40 + @max(words(value), 1) * 20);
+                const digit: u8 = switch (c) {
+                    '0'...'9' => c - '0',
+                    'a'...'f' => c - 'a' + 10,
+                    'A'...'F' => c - 'A' + 10,
+                    else => return error.Refused,
+                };
+                if (digit >= n.base) return error.Refused;
+                value = value * n.base + digit;
+                try bounded(value);
+            }
+            if (n.value != (if (n.value < 0) -value else value)) return error.Refused;
+            return n.value;
+        }
+        if (!self.parser.proved[index] or (n.op == .divmod and index != self.root)) return error.Refused;
+        const a = try self.child(n.l, index);
+        if ((n.op == .digits or n.op == .digit_sum) and isComparison(self.parser.nodes[n.l].op))
+            return error.Refused;
+        const b: i512 = switch (n.op) {
+            .neg, .digits, .isqrt, .factorial, .digit_sum => 0,
+            .add, .sub, .mul, .floor, .mod, .pow, .powmod, .divmod, .gcd, .range_product, .eq, .ne, .lt, .le, .gt, .ge => try self.child(n.r, index),
+            else => return error.Refused,
+        };
+        const k: i512 = switch (n.op) {
+            .powmod, .range_product => try self.child(n.k, index),
+            else => 0,
+        };
+        const value: i512 = switch (n.op) {
+            .neg => blk: {
+                try self.charge(80);
+                break :blk -a;
+            },
+            .add, .sub => blk: {
+                try self.charge(220);
+                break :blk if (n.op == .add) a + b else a - b;
+            },
+            .mul => blk: {
+                try self.charge(multiplyCost(a, b));
+                break :blk try product(a, b);
+            },
+            .floor, .mod, .divmod => blk: {
+                if (b == 0) return error.Refused;
+                var cached = false;
+                if (n.op == .mod) {
+                    for (self.parser.nodes[0..self.parser.count], 0..) |prior, j| {
+                        if ((prior.op == .floor or prior.op == .divmod) and prior.l == n.l and prior.r == n.r and
+                            self.seen & (@as(u64, 1) << @intCast(j)) != 0) cached = true;
+                    }
+                }
+                try self.charge(if (cached) 80 else divisionCost(a, b) + 140);
+                break :blk if (n.op == .mod) @mod(a, b) else @divFloor(a, b);
+            },
+            .eq, .ne, .lt, .le, .gt, .ge => blk: {
+                try self.charge(180);
+                break :blk @intFromBool(switch (n.op) {
+                    .eq => a == b,
+                    .ne => a != b,
+                    .lt => a < b,
+                    .le => a <= b,
+                    .gt => a > b,
+                    .ge => a >= b,
+                    else => unreachable,
+                });
+            },
+            .pow, .powmod => try self.power(a, b, if (n.op == .powmod) k else null),
+            .digits => blk: {
+                try self.charge(formatCost(a, false));
+                break :blk @as(i512, @intCast(decimalDigits(a) + @intFromBool(a < 0)));
+            },
+            .gcd => try self.gcd(a, b),
+            .isqrt => try self.isqrt(a),
+            .factorial => try self.factorial(a),
+            .range_product => try self.range(a, b, k),
+            .digit_sum => try self.digitSum(a),
+            else => return error.Refused,
+        };
+        try bounded(value);
+        if (value != n.value) return error.Refused;
+        return value;
+    }
+
+    fn gcd(self: *Counter, a: i512, b: i512) Refused!i512 {
+        var x = positive(a);
+        var y = positive(b);
+        try self.charge(80);
+        var count: usize = 0;
+        while (y != 0) {
+            if (count == 512) return error.Refused;
+            count += 1;
+            try self.charge(divisionCost(x, y) + 120);
+            const remainder = @mod(x, y);
+            x = y;
+            y = remainder;
+        }
+        return x;
+    }
+
+    fn isqrt(self: *Counter, a: i512) Refused!i512 {
+        if (a < 0) return error.Refused;
+        try self.charge(160);
+        if (a == 0) return 0;
+        var x = @as(i512, 1) << @intCast((bits(a) + 1) / 2);
+        var count: usize = 0;
+        while (true) {
+            if (count == 256) return error.Refused;
+            count += 1;
+            try self.charge(divisionCost(a, x) + 220 + smallDivisionCost(0, 8, 2) + 100);
+            const y = @divTrunc(x + @divTrunc(a, x), 2);
+            if (y >= x) return x;
+            x = y;
+        }
+    }
+
+    fn factorial(self: *Counter, a: i512) Refused!i512 {
+        if (a < 0 or a > 48) return error.Refused;
+        try self.charge(100);
+        var result: i512 = 1;
+        var factor: i512 = 2;
+        while (factor <= a) : (factor += 1) {
+            try self.charge(multiplyCost(result, factor) + 80);
+            result = try product(result, factor);
+        }
+        return result;
+    }
+
+    fn range(self: *Counter, start: i512, stop: i512, step: i512) Refused!i512 {
+        if (step == 0) return error.Refused;
+        try self.charge(160);
+        if (if (step > 0) start >= stop else start <= stop) return 1;
+        const distance = if (step > 0) stop - start else start - stop;
+        const stride = positive(step);
+        const length = @divTrunc(distance, stride) + @intFromBool(@mod(distance, stride) != 0);
+        if (length > 10000) return error.Refused;
+        try self.charge(220 + divisionCost(distance, stride) + 140 + 80);
+        if (@mod(distance, stride) != 0) try self.charge(220);
+        var value = start;
+        var result: i512 = 1;
+        var count: usize = 0;
+        while (if (step > 0) value < stop else value > stop) {
+            if (count == 10000) return error.Refused;
+            count += 1;
+            try bounded(value);
+            try self.charge(180 + multiplyCost(result, value));
+            result = try product(result, value);
+            if (result == 0) return 0;
+            try self.charge(220);
+            value += step;
+        }
+        return result;
+    }
+
+    fn digitSum(self: *Counter, a: i512) Refused!i512 {
+        if (a < 0) return error.Refused;
+        try self.charge(80);
+        var value = a;
+        var result: i512 = 0;
+        while (value != 0) {
+            try self.charge(smallDivisionCost(@intCast(value), 8, 10) + 64);
+            result += @mod(value, 10);
+            value = @divTrunc(value, 10);
+        }
+        return result;
+    }
+
+    fn power(self: *Counter, a: i512, exponent: i512, modulus: ?i512) Refused!i512 {
+        if (exponent < 0) return error.Refused;
+        try self.charge(160);
+        var base = a;
+        var result: i512 = 1;
+        var m: i512 = 0;
+        if (modulus) |signed| {
+            if (signed == 0) return error.Refused;
+            m = positive(signed);
+            if (m == 1) return 0;
+            try self.charge(divisionCost(a, m) + 100);
+            base = @mod(a, m);
+            if (a < 0 and base != 0) try self.charge(220);
+        }
+        const count = bits(exponent);
+        var remaining = exponent;
+        for (0..count) |bit| {
+            try self.charge(64);
+            if (@mod(remaining, 2) != 0) result = try self.powerProduct(result, base, m);
+            remaining = @divTrunc(remaining, 2);
+            if (bit + 1 < count) base = try self.powerProduct(base, base, m);
+        }
+        if (modulus) |signed| {
+            if (signed < 0 and result != 0) {
+                try self.charge(220);
+                result -= m;
+            }
+        }
+        return result;
+    }
+
+    fn powerProduct(self: *Counter, a: i512, b: i512, modulus: i512) Refused!i512 {
+        if (modulus == 0) {
+            try self.charge(multiplyCost(a, b));
+            return product(a, b);
+        }
+        const wide = a * b;
+        try self.charge(productCost(a, b) + 120);
+        if (words(modulus) == 1) {
+            try self.charge(smallDivisionCost(@intCast(wide), 16, @intCast(modulus)));
+        } else {
+            try self.charge(160 + bits(wide) * 224);
+        }
+        return @mod(wide, modulus);
+    }
+};
+
+fn bounded(value: i512) Refused!void {
+    if (value <= -ast.limit or value >= ast.limit) return error.Refused;
+}
+
+fn product(a: i512, b: i512) Refused!i512 {
+    const value = a * b;
+    try bounded(value);
+    return value;
+}
+
+fn positive(value: i512) i512 {
+    return if (value < 0) -value else value;
+}
+
+fn bits(value: i512) usize {
+    const magnitude: u512 = @intCast(positive(value));
+    return @intCast(512 - @clz(magnitude));
+}
+
+fn words(value: i512) usize {
+    return (bits(value) + 31) / 32;
+}
+
+fn decimalDigits(value: i512) usize {
+    var magnitude = positive(value);
+    var count: usize = 1;
+    while (magnitude >= 10) : (magnitude = @divTrunc(magnitude, 10)) count += 1;
+    return count;
+}
+
+// Charge the supplied limb span; small divisors use two native halfword divisions per limb.
+fn smallDivisionCost(value: u512, limbs: usize, divisor: u32) usize {
+    if (divisor <= 65535) return 24 + limbs * 20;
+    var cost: usize = 24;
+    var remainder: u64 = 0;
+    var index = limbs;
+    while (index != 0) {
+        index -= 1;
+        const word: u32 = @truncate(value >> @intCast(index * 32));
+        cost += if (remainder == 0) @as(usize, 14) else 32 * 16 + 20;
+        remainder = ((remainder << 32) | word) % divisor;
+    }
+    return cost;
+}
+
+fn divisionCost(a: i512, b: i512) usize {
+    const numerator = positive(a);
+    const divisor = positive(b);
+    if (numerator < divisor) return 160;
+    if (divisor <= 65535) return 120 + smallDivisionCost(@intCast(numerator), words(a), @intCast(divisor));
+    return longDivisionCost(numerator, divisor);
+}
+
+// Replay only quotient estimation for cost admission; the emitter still retains all original arithmetic nodes.
+fn longDivisionCost(a: i512, b: i512) usize {
+    const na = (bits(a) + 15) / 16;
+    const nb = (bits(b) + 15) / 16;
+    const shift: u9 = @intCast(16 * nb - bits(b));
+    const divisor = b << shift;
+    var remaining = a << shift;
+    const top_shift: u9 = @intCast(16 * (nb - 1));
+    const second_shift: u9 = @intCast(16 * (nb - 2));
+    const top = divisor >> top_shift;
+    const second = (divisor >> second_shift) & 65535;
+    var total: usize = 240 + (na + nb) * 20;
+    var position = na - nb + 1;
+    while (position != 0) {
+        position -= 1;
+        const digit_shift: u9 = @intCast(16 * position);
+        const window = remaining >> digit_shift;
+        const prefix = window >> top_shift;
+        var digit = @min(@divTrunc(prefix, top), 65535);
+        var rem = prefix - digit * top;
+        total += 112 + nb * 20;
+        while (rem < 65536 and digit * second > rem * 65536 + ((window >> second_shift) & 65535)) {
+            digit -= 1;
+            rem += top;
+            total += 24;
+        }
+        const exact = @divTrunc(window, divisor);
+        if (digit > exact) total += 24 + nb * 16;
+        remaining -= (exact * divisor) << digit_shift;
+    }
+    return total;
+}
+
+fn productCost(a: i512, b: i512) usize {
+    return 200 + words(a) * words(b) * 24 + words(a) * 10;
+}
+
+fn multiplyCost(a: i512, b: i512) usize {
+    return productCost(a, b) + 140;
+}
+
+fn formatCost(value: i512, print: bool) usize {
+    const digits = decimalDigits(value);
+    const sign: usize = @intFromBool(value < 0);
+    var magnitude = positive(value);
+    var format: usize = 64 + digits * 12 + sign * 12;
+    while (true) {
+        format += smallDivisionCost(@intCast(magnitude), words(magnitude), 10000) + 24;
+        magnitude = @divTrunc(magnitude, 10000);
+        if (magnitude == 0) break;
+    }
+    return format + (if (print) 48 + (digits + sign) * 16 else @as(usize, 0));
+}
diff --git a/zig/src/core/runner_frontend_integer_cost_test.zig b/zig/src/core/runner_frontend_integer_cost_test.zig
new file mode 100644
index 000000000..9529ee01e
--- /dev/null
+++ b/zig/src/core/runner_frontend_integer_cost_test.zig
@@ -0,0 +1,217 @@
+const std = @import("std");
+const ast = @import("runner_frontend_integer_ast.zig");
+const cost = @import("runner_frontend_integer_cost.zig");
+const t = std.testing;
+const cap: usize = 10_522;
+const unlimited = std.math.maxInt(usize);
+
+fn measured(code: []const u8, budget: usize) !?usize {
+    var parser = ast.Parser{ .source = code };
+    const root = try parser.parse();
+    return cost.estimate(&parser, root, budget);
+}
+
+test "integer cost exact model counters and inclusive budget boundary" {
+    const cases = [_][]const u8{
+        "1",            "-1",   "1+2",                  "2*3",           "gcd(54,24)", "gcd(0,0)", "isqrt(0)",
+        "factorial(0)", "0**0", "sum(map(int,str(0)))", "314159*271828",
+    };
+    for (cases) |code| {
+        const full = (try measured(code, unlimited)).?;
+        try t.expect(full > 0);
+        try t.expectEqual(@as(?usize, full), try measured(code, full));
+        try t.expectEqual(@as(?usize, null), try measured(code, full - 1));
+        try t.expectEqual(@as(?usize, null), try measured(code, 0));
+    }
+}
+
+test "integer cost admission is monotone in budget and does not mutate proof state" {
+    var parser = ast.Parser{ .source = "pow(-2,19,-97)+isqrt(144)" };
+    const root = try parser.parse();
+    const before = parser;
+    const full = cost.estimate(&parser, root, unlimited).?;
+    for ([_]usize{ 0, 200, full / 2, full - 1, full, full + 1, unlimited }) |budget| {
+        const result = cost.estimate(&parser, root, budget);
+        if (budget < full) try t.expect(result == null) else try t.expectEqual(@as(?usize, full), result);
+    }
+    try t.expectEqual(before.count, parser.count);
+    try t.expectEqualSlices(bool, &before.proved, &parser.proved);
+    try t.expectEqualSlices(u8, before.source, parser.source);
+    for (before.nodes[0..before.count], parser.nodes[0..parser.count]) |a, b| {
+        try t.expectEqual(a.op, b.op);
+        try t.expectEqual(a.l, b.l);
+        try t.expectEqual(a.r, b.r);
+        try t.expectEqual(a.k, b.k);
+        try t.expectEqual(a.value, b.value);
+        try t.expectEqualSlices(u8, a.text, b.text);
+    }
+}
+
+test "integer cost charges shared DAG nodes once and ignores unreachable nodes" {
+    var parser = ast.Parser{ .source = "7" };
+    try parser.bind("x", try parser.parse());
+    parser.source = "x+x";
+    parser.pos = 0;
+    const root = try parser.parse();
+    const shared = cost.estimate(&parser, root, unlimited).?;
+    const separate = (try measured("7+7", unlimited)).?;
+    try t.expect(shared < separate);
+    parser.nodes[parser.count] = .{ .op = .factorial, .value = 0 };
+    parser.count += 1;
+    try t.expectEqual(@as(?usize, shared), cost.estimate(&parser, root, unlimited));
+    try t.expect((try measured("2**1000%1000", unlimited)) != null);
+}
+
+test "integer cost covers radix widths output formatting and signed divmod" {
+    const decimal = (try measured("16", unlimited)).?;
+    const hex = (try measured("0x10", unlimited)).?;
+    try t.expect(hex > decimal);
+    try t.expect((try measured("0b10000", unlimited)).? > decimal);
+    try t.expect((try measured("1000000000", unlimited)).? > (try measured("1", unlimited)).?);
+    const scalar = (try measured("4294967296//4294967295", unlimited)).?;
+    const wide = (try measured("4294967296//4294967296", unlimited)).?;
+    try t.expect(wide > 0 and scalar > 0);
+    try t.expect((try measured("4294967296//4294967296", cap)) != null);
+    try t.expect((try measured("divmod(-7,3)", unlimited)).? > (try measured("-7//3", unlimited)).?);
+    try t.expect((try measured("len(str(-12345))", unlimited)) != null);
+    try t.expect((try measured("sum(int(d) for d in str(12345))", unlimited)) != null);
+}
+
+test "integer cost follows bounded algorithm paths and declines costly wide work" {
+    for ([_][]const u8{
+        "314159*271828",     "gcd(-54,24)",           "isqrt(144)",        "factorial(5)",
+        "prod(range(0,10))", "prod(range(0,-10,-1))", "prod(range(10,0))", "sum(int(d) for d in str(12345))",
+    }) |code| try t.expect((try measured(code, cap)) != null);
+    for ([_][]const u8{
+        "factorial(48)", "isqrt(10**60)", "gcd(10**61-1,10**30-1)", "prod(range(1,21))",
+    }) |code| try t.expectEqual(@as(?usize, null), try measured(code, cap));
+    try t.expect((try measured("factorial(10)", unlimited)).? > (try measured("factorial(5)", unlimited)).?);
+    try t.expect((try measured("gcd(89,55)", unlimited)).? > (try measured("gcd(99,33)", unlimited)).?);
+    try t.expect((try measured("isqrt(144)", unlimited)).? > (try measured("isqrt(0)", unlimited)).?);
+    try t.expectEqual(try measured("pow(2,100,1)", unlimited), try measured("pow(2,999,1)", unlimited));
+    try t.expect((try measured("pow(2,15,97)", unlimited)).? > (try measured("pow(2,7,97)", unlimited)).?);
+    try t.expect((try measured("pow(10**40+1,2,10**61)", unlimited)) != null);
+}
+
+test "integer cost zero absorption preserves the full range length precheck" {
+    const shorter = (try measured("prod(range(0,1000))", unlimited)).?;
+    const longer = (try measured("prod(range(0,9999))", unlimited)).?;
+    try t.expectEqual(shorter, longer);
+    try t.expect((try measured("prod(range(0,-9999,-1))", cap)) != null);
+    var parser = ast.Parser{ .source = "prod(range(0,10000))" };
+    const root = try parser.parse();
+    const stop = parser.nodes[root].r;
+    parser.nodes[stop].value = 10001;
+    parser.nodes[stop].text = "10001";
+    try t.expectEqual(@as(?usize, null), cost.estimate(&parser, root, unlimited));
+}
+
+test "integer cost refuses unproved invalid and inconsistent graph state" {
+    var parser = ast.Parser{ .source = "isqrt(144)" };
+    const root = try parser.parse();
+    const original = parser;
+    parser.proved[root] = false;
+    try t.expectEqual(@as(?usize, null), cost.estimate(&parser, root, unlimited));
+    parser = original;
+    parser.nodes[root].l = root;
+    try t.expectEqual(@as(?usize, null), cost.estimate(&parser, root, unlimited));
+    parser = original;
+    parser.nodes[root].l = 64;
+    try t.expectEqual(@as(?usize, null), cost.estimate(&parser, root, unlimited));
+    parser = original;
+    parser.nodes[root].value += 1;
+    try t.expectEqual(@as(?usize, null), cost.estimate(&parser, root, unlimited));
+    parser = original;
+    parser.nodes[root].r = 1000;
+    parser.nodes[root].k = 1000;
+    try t.expectEqual(cost.estimate(&original, root, unlimited), cost.estimate(&parser, root, unlimited));
+    parser = original;
+    parser.count = 65;
+    try t.expectEqual(@as(?usize, null), cost.estimate(&parser, root, unlimited));
+    parser.count = 0;
+    try t.expectEqual(@as(?usize, null), cost.estimate(&parser, 0, unlimited));
+    try t.expectEqual(@as(?usize, null), cost.estimate(&original, original.count, unlimited));
+}
+
+test "integer cost handles the final mask bit and rejects malformed ternary and tuple children" {
+    var last = ast.Parser{ .source = "", .count = 64 };
+    last.nodes[63] = .{ .op = .literal, .value = 1, .text = "1" };
+    try t.expectEqual(try measured("1", unlimited), cost.estimate(&last, 63, unlimited));
+    var ternary = ast.Parser{ .source = "pow(2,3,5)" };
+    const power = try ternary.parse();
+    ternary.nodes[power].k = ternary.count;
+    try t.expectEqual(@as(?usize, null), cost.estimate(&ternary, power, unlimited));
+    var tuple = ast.Parser{ .source = "7//3+1" };
+    const root = try tuple.parse();
+    const division = tuple.nodes[root].l;
+    tuple.nodes[division].op = .divmod;
+    try t.expectEqual(@as(?usize, null), cost.estimate(&tuple, root, unlimited));
+}
+
+test "integer cost refuses forged arithmetic failures and bad literal encodings" {
+    const cases = [_]struct { code: []const u8, slot: enum { l, r, k }, value: i512, text: []const u8 }{
+        .{ .code = "factorial(0)", .slot = .l, .value = -1, .text = "1" },
+        .{ .code = "isqrt(1)", .slot = .l, .value = -1, .text = "1" },
+        .{ .code = "7//3", .slot = .r, .value = 0, .text = "0" },
+        .{ .code = "pow(2,1,3)", .slot = .r, .value = -1, .text = "1" },
+        .{ .code = "pow(2,1,3)", .slot = .k, .value = 0, .text = "0" },
+        .{ .code = "prod(range(1,5))", .slot = .k, .value = 0, .text = "0" },
+        .{ .code = "sum(map(int,str(1)))", .slot = .l, .value = -1, .text = "1" },
+    };
+    for (cases) |case| {
+        var parser = ast.Parser{ .source = case.code };
+        const root = try parser.parse();
+        const n = parser.nodes[root];
+        const index = switch (case.slot) {
+            .l => n.l,
+            .r => n.r,
+            .k => n.k,
+        };
+        parser.nodes[index].value = case.value;
+        parser.nodes[index].text = case.text;
+        try t.expectEqual(@as(?usize, null), cost.estimate(&parser, root, unlimited));
+    }
+    var literal = ast.Parser{ .source = "1" };
+    const root = try literal.parse();
+    literal.nodes[root].base = 3;
+    try t.expectEqual(@as(?usize, null), cost.estimate(&literal, root, unlimited));
+    literal.nodes[root].base = 10;
+    literal.nodes[root].text = "2";
+    try t.expectEqual(@as(?usize, null), cost.estimate(&literal, root, unlimited));
+    literal.nodes[root].text = "g";
+    try t.expectEqual(@as(?usize, null), cost.estimate(&literal, root, unlimited));
+    literal.nodes[root].text = "";
+    try t.expectEqual(@as(?usize, null), cost.estimate(&literal, root, unlimited));
+    literal.nodes[root].text = "1";
+    literal.nodes[root].value = ast.limit;
+    try t.expectEqual(@as(?usize, null), cost.estimate(&literal, root, unlimited));
+}
+
+test "integer lowering preserves source APIs and applies optional cost admission before emission" {
+    const integer = @import("runner_frontend_integer.zig");
+    const python = @import("runner_frontend_integer_python.zig");
+    const Lower = *const fn (std.mem.Allocator, []const u8, usize) std.mem.Allocator.Error!?integer.Lowered;
+    for ([_]Lower{ integer.lowerWithCost, python.lowerWithCost }) |lowerWithCost| {
+        const admitted = (try lowerWithCost(t.allocator, "314159*271828", cap)).?;
+        defer t.allocator.free(admitted.source);
+        try t.expectEqual(try measured("314159*271828", unlimited), admitted.estimated_steps);
+        const bypass = (try lowerWithCost(t.allocator, "314159*271828", 0)).?;
+        defer t.allocator.free(bypass.source);
+        try t.expectEqual(@as(?usize, null), bypass.estimated_steps);
+        try t.expectEqualSlices(u8, admitted.source, bypass.source);
+        try t.expect((try lowerWithCost(t.allocator, "314159*271828", admitted.estimated_steps.? - 1)) == null);
+    }
+    const plain = (try integer.lower(t.allocator, "factorial(48)")).?;
+    defer t.allocator.free(plain);
+    const statement = "from math import factorial\nprint(factorial(48))";
+    const source = (try python.lower(t.allocator, statement)).?;
+    defer t.allocator.free(source);
+    try t.expectEqualSlices(u8, plain, source);
+    try t.expect((try python.lowerWithCost(t.allocator, statement, cap)) == null);
+    const bypass = (try python.lowerWithCost(t.allocator, statement, 0)).?;
+    defer t.allocator.free(bypass.source);
+    try t.expectEqual(@as(?usize, null), bypass.estimated_steps);
+    const wide = (try python.lowerWithCost(t.allocator, "a=314159\nb=271828\nprint(a*b)", cap)).?;
+    defer t.allocator.free(wide.source);
+    try t.expectEqual(try measured("314159*271828", unlimited), wide.estimated_steps);
+}
diff --git a/zig/src/core/runner_frontend_integer_digits.zig b/zig/src/core/runner_frontend_integer_digits.zig
new file mode 100644
index 000000000..b42b5a650
--- /dev/null
+++ b/zig/src/core/runner_frontend_integer_digits.zig
@@ -0,0 +1,140 @@
+//! A number's digits in the integer lowering: int(str(x)[::-1]) and `while x > 0: ... x //= L`, unrolled by place.
+const std = @import("std");
+const ast = @import("runner_frontend_integer_ast.zig");
+const suite = @import("runner_frontend_integer_suite.zig");
+const Parser = ast.Parser;
+const Invalid = ast.Invalid;
+
+/// Decimal digits a reversal may unroll.
+const max_digits = 30;
+
+/// `int(str(x)[::-1])` after `int(str(`: x's digits read back, each one past the first gated by x >= 10^k.
+pub fn reversed(p: *Parser, depth: usize) Invalid!usize {
+    const x = try p.expr(depth + 1);
+    try p.need(")");
+    try p.need("[::-1]");
+    try p.need(")");
+    if (p.check_only) return x;
+    if (p.boolean(x)) return error.Unsupported;
+    const v = try p.prove(x, x);
+    if (v < 0) return error.Unsupported; // int("21-") raises ValueError
+    p.looped = true;
+    var exact: usize = 1;
+    var m = v;
+    while (m >= 10) : (m = @divTrunc(m, 10)) exact += 1;
+    if (exact > max_digits) return error.Unsupported;
+    // headroom, as a range loop's: a power of two of places, unless the graph route could not hold it
+    const spare = @min(max_digits, std.math.ceilPowerOfTwo(usize, @max(exact, 2)) catch max_digits);
+    const mark = p.mark();
+    if (spare > exact) {
+        if (horner(p, x, spare)) |root| {
+            if (!suite.heavy(p, root)) return root;
+        } else |_| {}
+        p.reset(mark);
+    }
+    return horner(p, x, exact);
+}
+
+/// r = x % 10, then r = r * (1 + 9c) + c * d for each further place: c = x >= 10^k, d = x // 10^k % 10.
+fn horner(p: *Parser, x: usize, places: usize) Invalid!usize {
+    const ten = try suite.literal(p, 10);
+    const nine = try suite.literal(p, 9);
+    const one = try suite.literal(p, 1);
+    var r = try suite.node(p, .mod, x, ten);
+    var place: i512 = 1;
+    for (1..places) |_| {
+        place *= 10;
+        const pk = try suite.literal(p, place);
+        const c = try suite.node(p, .ge, x, pk);
+        const d = try suite.node(p, .mod, try suite.node(p, .floor, x, pk), ten);
+        const grow = try suite.node(p, .add, one, try suite.node(p, .mul, c, nine));
+        r = try suite.node(p, .add, try suite.node(p, .mul, r, grow), try suite.node(p, .mul, c, d));
+    }
+    return r;
+}
+
+/// `while x > 0:` (`x >= 1`, `x != 0`, `0 < x`) with one `x //= L`: trip k runs where x0 >= L^k, reading x0 // L^k.
+pub fn whileDivides(r: *suite.Run, cond: []const u8, body: usize, end: usize) Invalid!bool {
+    const p = r.p;
+    // no trip's test reads another trip's state; anything else (false) is the general loop's
+    if (r.pred != null) return false;
+    var buf: [64]u8 = undefined;
+    const test_text = compact(&buf, cond) orelse return false;
+    const name = for ([_][]const u8{ ">0", ">=1", "!=0" }) |tail| {
+        if (std.mem.endsWith(u8, test_text, tail)) break test_text[0 .. test_text.len - tail.len];
+    } else if (std.mem.startsWith(u8, test_text, "0<")) test_text[2..] else return false;
+    if (!@import("runner_frontend_integer_python.zig").validBinding(name)) return false;
+    var at: ?usize = null;
+    var divisor: i512 = 0;
+    for (body..end) |i| {
+        const line = r.lines.items[i];
+        const target = suite.assigns(line.text) orelse continue;
+        if (!std.mem.eql(u8, target, name)) continue;
+        if (at != null or line.indent != r.lines.items[body].indent) return false;
+        var lbuf: [64]u8 = undefined;
+        const t = compact(&lbuf, line.text) orelse return false;
+        if (!std.mem.startsWith(u8, t, name) or !std.mem.startsWith(u8, t[name.len..], "//=")) return false;
+        const digits = t[name.len + 3 ..];
+        if (digits.len == 0 or digits.len > 18) return false;
+        for (digits) |c| if (!std.ascii.isDigit(c)) return false;
+        divisor = std.fmt.parseInt(i512, digits, 10) catch return false;
+        if (divisor < 2) return false;
+        at = i;
+    }
+    const line = at orelse return false;
+    const s = p.slot(name) orelse return false;
+    if (p.kinds[s] or p.roots[s] == ast.unbound) return false;
+    const x0 = p.roots[s];
+    var v = p.nodes[x0].value;
+    if (v < 0) return false; // `x != 0` would never end
+    var trips: usize = 0;
+    while (v > 0) : (v = @divFloor(v, divisor)) {
+        trips += 1;
+        if (trips > suite.max_trips) return error.Unsupported;
+    }
+    const mark = p.mark();
+    const saved = suite.Saved.take(p);
+    const spare = suite.schedule(trips);
+    if (spare > trips) {
+        if (unroll(r, name, x0, divisor, line, spare, body, end)) |_| {
+            if (!suite.heavy(p, null)) return true;
+        } else |_| {}
+        p.reset(mark);
+        saved.put(p);
+    }
+    try unroll(r, name, x0, divisor, line, trips, body, end);
+    return true;
+}
+
+fn unroll(r: *suite.Run, name: []const u8, x0: usize, divisor: i512, line: usize, count: usize, body: usize, end: usize) Invalid!void {
+    const p = r.p;
+    var place: i512 = 1;
+    for (0..count) |k| {
+        const pk = try suite.literal(p, place);
+        const c = try suite.node(p, .ge, x0, pk);
+        const xk = if (k == 0) x0 else try suite.node(p, .floor, x0, pk);
+        place = std.math.mul(i512, place, divisor) catch return error.Unsupported;
+        if (place > ast.limit) return error.Unsupported;
+        var inner = r.*;
+        inner.pred = c;
+        inner.divided = .{ .line = line, .name = name, .root = try suite.node(p, .floor, x0, try suite.literal(p, place)) };
+        try suite.store(r, name, xk);
+        if (try suite.exec(&inner, body, end, false) != null) return error.Unsupported;
+    }
+    // after the loop: 0 where it ran (the schedule covers its trips), x0 where it never did
+    const one = try suite.literal(p, 1);
+    const idle = try suite.node(p, .sub, one, try suite.node(p, .ge, x0, one));
+    try suite.store(r, name, try suite.node(p, .mul, idle, x0));
+}
+
+/// `text` without spaces or tabs, or null past the buffer.
+fn compact(buf: []u8, text: []const u8) ?[]const u8 {
+    var n: usize = 0;
+    for (text) |c| {
+        if (c == ' ' or c == '\t') continue;
+        if (n == buf.len) return null;
+        buf[n] = c;
+        n += 1;
+    }
+    return buf[0..n];
+}
diff --git a/zig/src/core/runner_frontend_integer_list.zig b/zig/src/core/runner_frontend_integer_list.zig
new file mode 100644
index 000000000..3474d38e8
--- /dev/null
+++ b/zig/src/core/runner_frontend_integer_list.zig
@@ -0,0 +1,564 @@
+//! Static int lists in the integer lowering: literals, range, list(), sorted(), comprehensions; len/sum/min/max/[i].
+const std = @import("std");
+const ast = @import("runner_frontend_integer_ast.zig");
+const Parser = ast.Parser;
+const Invalid = ast.Invalid;
+const node_cap = @typeInfo(@FieldType(Parser, "nodes")).array.len;
+
+/// items[start..][0..len]; a range never prints here; a filtered list's 0/1 masks follow (its len is a circuit value).
+pub const List = struct { start: usize = 0, len: usize = 0, range: bool = false, masked: bool = false, literal: bool = false };
+
+/// A list whose elements all exist: a filtered one only reaches sum() and len(), on the circuit.
+pub fn plain(p: *const Parser, li: usize) Invalid!List {
+    const l = p.lists[li];
+    if (l.masked) return error.Unsupported;
+    return l;
+}
+
+/// Whether node `i` is the script's text alone: no comparison (a filter's or a min's choice) beneath it.
+fn fixed(p: *const Parser, i: usize) bool {
+    var seen: [node_cap]bool = @splat(false);
+    return fixedAt(p, i, &seen);
+}
+
+fn fixedAt(p: *const Parser, i: usize, seen: *[node_cap]bool) bool {
+    if (i >= p.count) return false;
+    if (seen[i]) return true;
+    seen[i] = true;
+    const n = p.nodes[i];
+    return switch (n.op) {
+        .literal => true,
+        .eq, .ne, .lt, .le, .gt, .ge => false,
+        .neg, .digits, .isqrt, .factorial, .digit_sum => fixedAt(p, n.l, seen),
+        .powmod, .range_product => fixedAt(p, n.l, seen) and fixedAt(p, n.r, seen) and fixedAt(p, n.k, seen),
+        else => fixedAt(p, n.l, seen) and fixedAt(p, n.r, seen),
+    };
+}
+
+/// `acc` or `e`, chosen on the circuit: acc + (e - acc) * (e < acc), or `>` for max; a tie keeps acc (Python's first).
+fn pick(p: *Parser, acc: usize, e: usize, largest: bool) Invalid!usize {
+    const better = try p.add(.{ .op = if (largest) .gt else .lt, .l = e, .r = acc });
+    const step = try p.add(.{ .op = .mul, .l = try p.add(.{ .op = .sub, .l = e, .r = acc }), .r = better });
+    return p.add(.{ .op = .add, .l = acc, .r = step });
+}
+
+/// min and max of a and b on the circuit: t = (b - a) * (b < a); min = a + t, max = b - t.
+fn exchange(p: *Parser, a: usize, b: usize) Invalid![2]usize {
+    const t = try p.add(.{ .op = .mul, .l = try p.add(.{ .op = .sub, .l = b, .r = a }), .r = try p.add(.{ .op = .lt, .l = b, .r = a }) });
+    return .{ try p.add(.{ .op = .add, .l = a, .r = t }), try p.add(.{ .op = .sub, .l = b, .r = t }) };
+}
+
+/// sorted() as a compare-exchange network, each output a circuit value; its depth sets the packet's size.
+fn network(p: *Parser, elems: []usize, reverse: bool) Invalid!void {
+    for (elems) |e| if (p.boolean(e)) return error.Unsupported; // sorted([True, 0]) keeps its bools
+    if (elems.len == 4) {
+        // the depth-3 network for four (transposition's depth 4 outgrows a packet)
+        for ([_][2]usize{ .{ 0, 1 }, .{ 2, 3 }, .{ 0, 2 }, .{ 1, 3 }, .{ 1, 2 } }) |c| {
+            const lo, const hi = try exchange(p, elems[c[0]], elems[c[1]]);
+            elems[c[0]], elems[c[1]] = if (reverse) .{ hi, lo } else .{ lo, hi };
+        }
+        if (p.count > network_nodes) return error.Unsupported;
+        return;
+    }
+    // odd-even transposition: n rounds
+    for (0..elems.len) |round| {
+        var i = round % 2;
+        while (i + 1 < elems.len) : (i += 2) {
+            const lo, const hi = try exchange(p, elems[i], elems[i + 1]);
+            elems[i], elems[i + 1] = if (reverse) .{ hi, lo } else .{ lo, hi };
+        }
+    }
+    // the 64-node budget the networks were sized for (a packet's depth), though a whole script may make 512 nodes
+    if (p.count > network_nodes) return error.Unsupported;
+}
+
+const network_nodes = 64;
+
+/// Small literals the lowering itself makes (an index, a length): their text, as a literal node must carry one.
+const digits = blk: {
+    @setEvalBranchQuota(20000);
+    var texts: [ast.max_items + 1][]const u8 = undefined;
+    for (&texts, 0..) |*t, i| t.* = std.fmt.comptimePrint("{d}", .{i});
+    break :blk texts;
+};
+
+fn number(p: *Parser, v: usize) Invalid!usize {
+    if (v > ast.max_items) return error.Unsupported;
+    return p.add(.{ .op = .literal, .value = @intCast(v), .text = digits[v] });
+}
+
+/// Whether a list expression starts here (nothing consumed): `[`, `range(`/`sorted(`/`list(`, or a name holding one.
+pub fn ahead(p: *Parser) bool {
+    if (!p.allow_lists) return false;
+    p.space();
+    const save = p.pos;
+    defer p.pos = save;
+    if (p.pos < p.source.len and p.source[p.pos] == '[') return true;
+    for ([_][]const u8{ "range", "sorted", "list" }) |w| {
+        p.pos = save;
+        if (p.word(w)) {
+            p.space();
+            return p.pos < p.source.len and p.source[p.pos] == '(';
+        }
+    }
+    p.pos = save;
+    if (p.check_only) return false; // a def's body at its definition: a name may be anything
+    const name = p.identifier() catch return false;
+    p.space();
+    if (p.pos < p.source.len and p.source[p.pos] == '(') return false;
+    return p.lookupList(name) != null;
+}
+
+/// `text` as one whole list expression (an assignment's right side, a print argument).
+pub fn whole(p: *Parser, text: []const u8) Invalid!usize {
+    p.source = std.mem.trim(u8, text, " \t");
+    p.pos = 0;
+    const li = try parse(p, 0);
+    p.space();
+    if (p.pos != p.source.len) return error.Unsupported;
+    return li;
+}
+
+/// A list expression here. Never a node: its length is the script's shape; its filter and order are circuit values.
+pub fn parse(p: *Parser, depth: usize) Invalid!usize {
+    if (depth > 12) return error.Unsupported;
+    p.space();
+    if (p.pos < p.source.len and p.source[p.pos] == '[') {
+        const close = closing(p.source, p.pos) orelse return error.Unsupported;
+        const content = p.source[p.pos + 1 .. close];
+        const li = if (top(content, "for", 0) != null) try comprehension(p, content, depth) else try literal(p, content, depth);
+        p.pos = close + 1;
+        return li;
+    }
+    if (p.word("range")) return range(p, depth);
+    const sorting = p.word("sorted");
+    if (sorting or p.word("list")) {
+        const content = try parenthesized(p);
+        var arg = content;
+        var reverse = false;
+        // a bare generator is the only argument (its targets' commas are its own)
+        const generator = top(content, "for", 0) != null;
+        if (sorting and !generator) {
+            // sorted(xs, reverse=True|False); key= or anything else refuses
+            if (separator(content)) |comma| {
+                const kw = std.mem.trim(u8, content[comma + 1 ..], " \t");
+                if (std.mem.eql(u8, kw, "reverse=True")) reverse = true else if (!std.mem.eql(u8, kw, "reverse=False")) return error.Unsupported;
+                arg = content[0..comma];
+            }
+        } else if (!generator and separator(content) != null) return error.Unsupported;
+        const src = try argument(p, arg, depth);
+        if (p.check_only) return src;
+        const l = try plain(p, src);
+        var elems: [ast.max_items]usize = undefined;
+        @memcpy(elems[0..l.len], p.items[l.start..][0..l.len]);
+        if (sorting) try network(p, elems[0..l.len], reverse);
+        return make(p, elems[0..l.len], false);
+    }
+    const name = try p.identifier();
+    if (p.check_only) return placeholder(p);
+    return p.lookupList(name) orelse error.Unsupported;
+}
+
+/// The argument of sorted()/list()/sum()/min()/max(): a bare generator expression, or a list.
+fn argument(p: *Parser, text: []const u8, depth: usize) Invalid!usize {
+    const t = std.mem.trim(u8, text, " \t");
+    if (top(t, "for", 0) != null) return comprehension(p, t, depth);
+    return nested(p, t, depth);
+}
+
+/// `text` as one whole list expression, the parser's position kept.
+fn nested(p: *Parser, text: []const u8, depth: usize) Invalid!usize {
+    const saved = .{ p.source, p.pos };
+    defer {
+        p.source, p.pos = saved;
+    }
+    p.source = std.mem.trim(u8, text, " \t");
+    p.pos = 0;
+    const li = try parse(p, depth + 1);
+    p.space();
+    if (p.pos != p.source.len) return error.Unsupported;
+    return li;
+}
+
+fn placeholder(p: *Parser) Invalid!usize {
+    const one = try p.add(.{ .op = .literal, .value = 1, .text = "1" });
+    return make(p, &.{one}, false);
+}
+
+/// A new list of these element nodes, each proved now (Python builds a list eagerly: `[1//0]` raises at once).
+pub fn make(p: *Parser, elems: []const usize, is_range: bool) Invalid!usize {
+    p.listed = true;
+    if (p.list_count == p.lists.len or p.item_count + elems.len > p.items.len) return error.Unsupported;
+    for (elems) |e| {
+        if (e >= p.count or p.nodes[e].op == .divmod) return error.Unsupported; // a tuple is not an int element
+        if (p.check_only) continue;
+        _ = try p.prove(e, e);
+    }
+    @memcpy(p.items[p.item_count..][0..elems.len], elems);
+    p.lists[p.list_count] = .{ .start = p.item_count, .len = elems.len, .range = is_range };
+    p.item_count += elems.len;
+    p.list_count += 1;
+    return p.list_count - 1;
+}
+
+/// A comprehension's list with each element's 0/1 keep mask (every element proved: one a filter drops may refuse).
+fn filtered(p: *Parser, elems: []const usize, masks: []const usize) Invalid!usize {
+    if (p.item_count + 2 * elems.len > p.items.len) return error.Unsupported;
+    const li = try make(p, elems, false);
+    for (masks) |m| if (!p.check_only) {
+        _ = try p.prove(m, m);
+    };
+    @memcpy(p.items[p.item_count..][0..masks.len], masks);
+    p.item_count += masks.len;
+    p.lists[li].masked = true;
+    return li;
+}
+
+fn literal(p: *Parser, content: []const u8, depth: usize) Invalid!usize {
+    var elems: [ast.max_items]usize = undefined;
+    var n: usize = 0;
+    const saved = .{ p.source, p.pos };
+    defer {
+        p.source, p.pos = saved;
+    }
+    p.source = content;
+    p.pos = 0;
+    p.space();
+    while (p.pos < p.source.len) {
+        if (n == elems.len) return error.Unsupported;
+        elems[n] = try p.expr(depth + 1);
+        n += 1;
+        p.space();
+        if (p.pos == p.source.len) break;
+        try p.need(",");
+        p.space();
+    }
+    const li = try make(p, elems[0..n], false);
+    p.lists[li].literal = true; // its length is the script's text, never a value's decision
+    return li;
+}
+
+/// range(n) is the literals 0..n-1; range(start, stop[, step]) is start, then each element before plus the step.
+fn range(p: *Parser, depth: usize) Invalid!usize {
+    var args: [3]usize = undefined;
+    var n: usize = 0;
+    try p.need("(");
+    while (true) {
+        if (n == 3) return error.Unsupported;
+        args[n] = try p.expr(depth + 1);
+        n += 1;
+        if (p.take(")")) break;
+        try p.need(",");
+    }
+    if (p.check_only) return placeholder(p);
+    // the length is a shape: never from a circuit choice (a filter's len, a min)
+    for (args[0..n]) |a| if (p.boolean(a) or p.nodes[a].op == .divmod or !fixed(p, a)) return error.Unsupported;
+    const start: ?usize = if (n == 1) null else args[0];
+    const stop = if (n == 1) args[0] else args[1];
+    const step: ?usize = if (n == 3) args[2] else null;
+    const a: i512 = if (start) |s| try p.prove(s, s) else 0;
+    const b = try p.prove(stop, stop);
+    const s: i512 = if (step) |x| try p.prove(x, x) else 1;
+    if (s == 0) return error.Unsupported; // ValueError in Python
+    const span = if (s > 0) b - a else a - b;
+    const mag = if (s > 0) s else -s;
+    const len: i512 = if (span <= 0) 0 else @divFloor(span + mag - 1, mag);
+    if (len > ast.max_items) return error.Unsupported;
+    const count: usize = @intCast(len);
+    var elems: [ast.max_items]usize = undefined;
+    if (start) |first| {
+        if (count != 0) elems[0] = first;
+        const inc = if (count > 1) step orelse try number(p, 1) else 0;
+        for (1..@max(count, 1)) |k| elems[k] = try p.add(.{ .op = .add, .l = elems[k - 1], .r = inc });
+    } else for (0..count) |k| {
+        elems[k] = try number(p, k);
+    }
+    return make(p, elems[0..count], true);
+}
+
+/// `body for target in iterable [if cond]...`: one `for` clause; targets are one name, or two over zip/enumerate.
+fn comprehension(p: *Parser, content: []const u8, depth: usize) Invalid!usize {
+    const f = top(content, "for", 0) orelse return error.Unsupported;
+    const body = std.mem.trim(u8, content[0..f], " \t");
+    const in_at = top(content, "in", f + 3) orelse return error.Unsupported;
+    if (top(content, "for", f + 3) != null) return error.Unsupported; // a second for clause
+    var targets_text = std.mem.trim(u8, content[f + 3 .. in_at], " \t");
+    if (targets_text.len >= 2 and targets_text[0] == '(' and targets_text[targets_text.len - 1] == ')')
+        targets_text = std.mem.trim(u8, targets_text[1 .. targets_text.len - 1], " \t");
+    var targets: [2][]const u8 = undefined;
+    var arity: usize = 0;
+    var names = std.mem.splitScalar(u8, targets_text, ',');
+    while (names.next()) |raw| {
+        if (arity == 2) return error.Unsupported;
+        targets[arity] = std.mem.trim(u8, raw, " \t");
+        if (!target(targets[arity])) return error.Unsupported;
+        arity += 1;
+    }
+    if (arity == 2 and std.mem.eql(u8, targets[0], targets[1])) return error.Unsupported;
+    const first_if = top(content, "if", in_at + 2);
+    const iterable = std.mem.trim(u8, content[in_at + 2 .. first_if orelse content.len], " \t");
+    var conds: [4][]const u8 = undefined;
+    var nconds: usize = 0;
+    var at = first_if;
+    while (at) |i| {
+        if (nconds == conds.len) return error.Unsupported;
+        const next = top(content, "if", i + 2);
+        conds[nconds] = std.mem.trim(u8, content[i + 2 .. next orelse content.len], " \t");
+        if (conds[nconds].len == 0) return error.Unsupported;
+        nconds += 1;
+        at = next;
+    }
+    if (body.len == 0 or iterable.len == 0) return error.Unsupported;
+    // the iterable: zip(a, b) and enumerate(a[, start]) give pairs; any other list gives single values
+    var columns: [2]List = undefined;
+    var first: ?usize = null; // enumerate's start node
+    var pairs: enum { none, zip, enumerate } = .none;
+    {
+        const saved = .{ p.source, p.pos };
+        defer {
+            p.source, p.pos = saved;
+        }
+        p.source = iterable;
+        p.pos = 0;
+        if (p.word("zip")) {
+            const args = try parenthesized(p);
+            const comma = separator(args) orelse return error.Unsupported;
+            if (separator(args[comma + 1 ..]) != null) return error.Unsupported;
+            columns[0] = try plain(p, try nested(p, args[0..comma], depth));
+            columns[1] = try plain(p, try nested(p, args[comma + 1 ..], depth));
+            pairs = .zip;
+        } else if (p.word("enumerate")) {
+            const args = try parenthesized(p);
+            const comma = separator(args);
+            columns[1] = try plain(p, try nested(p, args[0 .. comma orelse args.len], depth));
+            if (comma) |c| {
+                first = try sub(p, std.mem.trim(u8, args[c + 1 ..], " \t"), depth);
+                if (p.boolean(first.?) or p.nodes[first.?].op == .divmod) return error.Unsupported;
+            }
+            pairs = .enumerate;
+        } else {
+            columns[0] = try plain(p, try parse(p, depth + 1));
+        }
+        p.space();
+        if (p.pos != p.source.len) return error.Unsupported;
+    }
+    if ((pairs == .none) != (arity == 1)) return error.Unsupported;
+    const len = switch (pairs) {
+        .none => columns[0].len,
+        .zip => @min(columns[0].len, columns[1].len),
+        .enumerate => columns[1].len,
+    };
+    var out: [ast.max_items]usize = undefined;
+    var masks: [ast.max_items]usize = undefined;
+    var counter: usize = 0; // enumerate's count from its start: the start, then one more each element
+    const one = if (first != null and len > 1) try number(p, 1) else 0;
+    for (0..len) |k| {
+        var values: [2]usize = undefined;
+        switch (pairs) {
+            .none => values[0] = p.items[columns[0].start + k],
+            .zip => values = .{ p.items[columns[0].start + k], p.items[columns[1].start + k] },
+            .enumerate => {
+                counter = if (first) |s| (if (k == 0) s else try p.add(.{ .op = .add, .l = counter, .r = one })) else try number(p, k);
+                values = .{ counter, p.items[columns[1].start + k] };
+            },
+        }
+        // the targets are the comprehension's own names: they shadow, and vanish after it (Python 3 scoping)
+        const bound = p.binding_count;
+        defer p.binding_count = bound;
+        if (p.binding_count + arity > p.names.len) return error.Unsupported;
+        for (targets[0..arity], values[0..arity]) |name, value| {
+            p.names[p.binding_count] = name;
+            p.roots[p.binding_count] = value;
+            p.kinds[p.binding_count] = false;
+            p.binding_count += 1;
+        }
+        // the conditions' product is the element's keep mask, a circuit value: the host never chooses what stays
+        var mask: ?usize = null;
+        for (conds[0..nconds]) |cond| {
+            const c = try sub(p, cond, depth);
+            if (p.nodes[c].op == .divmod) return error.Unsupported;
+            // an int condition is its truth: nonzero
+            const truth = if (p.boolean(c)) c else try p.add(.{ .op = .ne, .l = c, .r = try number(p, 0) });
+            mask = if (mask) |m| try p.add(.{ .op = .mul, .l = m, .r = truth }) else truth;
+        }
+        if (k == out.len) return error.Unsupported;
+        if (mask) |m| masks[k] = m;
+        out[k] = try sub(p, body, depth);
+    }
+    if (nconds == 0) return make(p, out[0..len], false);
+    return filtered(p, out[0..len], masks[0..len]);
+}
+
+/// An int expression over `text`, the parser's position kept.
+fn sub(p: *Parser, text: []const u8, depth: usize) Invalid!usize {
+    const saved = .{ p.source, p.pos };
+    defer {
+        p.source, p.pos = saved;
+    }
+    p.source = text;
+    p.pos = 0;
+    const n = try p.expr(depth + 1);
+    p.space();
+    if (p.pos != p.source.len) return error.Unsupported;
+    return n;
+}
+
+fn target(name: []const u8) bool {
+    if (name.len == 0 or !(std.ascii.isAlphabetic(name[0]) or name[0] == '_')) return false;
+    for (name) |c| if (!(std.ascii.isAlphanumeric(c) or c == '_')) return false;
+    for ([_][]const u8{ "for", "in", "if", "else", "and", "or", "not", "is", "lambda", "None", "True", "False", "sum", "len", "min", "max", "range", "sorted", "list", "zip", "enumerate", "print", "pow", "divmod", "int", "str", "abs", "math", "gcd", "isqrt", "factorial", "prod" }) |w|
+        if (std.mem.eql(u8, name, w)) return false;
+    return true;
+}
+
+/// The text inside `( ... )` at the position (after the call's name); the position moves past `)`.
+fn parenthesized(p: *Parser) Invalid![]const u8 {
+    p.space();
+    if (p.pos >= p.source.len or p.source[p.pos] != '(') return error.Unsupported;
+    const close = closing(p.source, p.pos) orelse return error.Unsupported;
+    const content = p.source[p.pos + 1 .. close];
+    p.pos = close + 1;
+    return content;
+}
+
+// ---- int consumers, called from the parser's atoms ----
+
+/// len(xs): the list's static length, a literal (its new nodes dropped); a filtered list's is its masks' sum.
+pub fn length(p: *Parser, depth: usize) Invalid!usize {
+    const content = try parenthesized(p);
+    // len() of a generator is a TypeError
+    if (top(content, "for", 0) != null or separator(content) != null) return error.Unsupported;
+    const m = p.mark();
+    const li = try nested(p, content, depth);
+    const l = p.lists[li];
+    if (p.check_only or !l.masked) {
+        p.reset(m);
+        return number(p, if (p.check_only) 1 else l.len);
+    }
+    // from 0: one mask alone would print as a bool
+    var acc = try number(p, 0);
+    for (p.items[l.start + l.len ..][0..l.len]) |mask| acc = try p.add(.{ .op = .add, .l = acc, .r = mask });
+    return acc;
+}
+
+/// sum(xs) or sum(generator): 0 for none, else the elements added left to right (start= refuses).
+pub fn sum(p: *Parser, depth: usize) Invalid!usize {
+    const content = try parenthesized(p);
+    if (top(content, "for", 0) == null and separator(content) != null) return error.Unsupported;
+    const l = p.lists[try argument(p, content, depth)];
+    if (l.masked) {
+        // each element times its keep mask, from 0
+        var acc = try number(p, 0);
+        for (p.items[l.start..][0..l.len], p.items[l.start + l.len ..][0..l.len]) |e, mask|
+            acc = try p.add(.{ .op = .add, .l = acc, .r = try p.add(.{ .op = .mul, .l = e, .r = mask }) });
+        return acc;
+    }
+    if (l.len == 0) return number(p, 0);
+    var acc = p.items[l.start];
+    // sum([True]) is 1, an int
+    if (l.len == 1 and p.boolean(acc)) return p.add(.{ .op = .add, .l = try number(p, 0), .r = acc });
+    for (p.items[l.start + 1 ..][0 .. l.len - 1]) |e| acc = try p.add(.{ .op = .add, .l = acc, .r = e });
+    return acc;
+}
+
+/// min/max of one list or generator, or of two or more ints: chosen on the circuit, pairwise (an empty list refuses).
+pub fn extreme(p: *Parser, depth: usize, comptime largest: bool) Invalid!usize {
+    p.listed = true;
+    const content = try parenthesized(p);
+    var elems: [ast.max_items]usize = undefined;
+    var n: usize = 0;
+    if (top(content, "for", 0) == null and separator(content) != null) {
+        var rest = content;
+        while (true) {
+            if (n == elems.len) return error.Unsupported;
+            const comma = separator(rest);
+            // a key= or default= does not parse as an int; a list argument is a TypeError
+            elems[n] = try sub(p, std.mem.trim(u8, rest[0 .. comma orelse rest.len], " \t"), depth);
+            if (p.nodes[elems[n]].op == .divmod) return error.Unsupported;
+            n += 1;
+            if (comma) |c| rest = rest[c + 1 ..] else break;
+        }
+    } else {
+        const l = try plain(p, try argument(p, content, depth));
+        @memcpy(elems[0..l.len], p.items[l.start..][0..l.len]);
+        n = l.len;
+    }
+    if (n == 0) return error.Unsupported; // ValueError
+    for (elems[0..n]) |e| if (p.boolean(e)) return error.Unsupported; // min(True, 2) is True, a bool
+    var best = elems[0];
+    for (elems[1..n]) |e| best = try pick(p, best, e, largest);
+    if (!p.check_only) _ = try p.prove(best, best);
+    return best;
+}
+
+/// xs[i] for a proved index (negative from the end); out of range refuses (IndexError).
+pub fn index(p: *Parser, li: usize, depth: usize) Invalid!usize {
+    try p.need("[");
+    const i = try p.expr(depth + 1);
+    try p.need("]");
+    if (p.check_only) return i;
+    // which element is a shape: never from a circuit choice
+    if (p.boolean(i) or p.nodes[i].op == .divmod or !fixed(p, i)) return error.Unsupported;
+    const l = try plain(p, li);
+    const v = try p.prove(i, i);
+    const at = if (v < 0) v + @as(i512, @intCast(l.len)) else v;
+    if (at < 0 or at >= l.len) return error.Unsupported;
+    return p.items[l.start + @as(usize, @intCast(at))];
+}
+
+// ---- text scanning at bracket depth 0, outside quotes ----
+
+/// The index of the bracket closing the one at `open`.
+pub fn closing(text: []const u8, open: usize) ?usize {
+    var depth: usize = 0;
+    var quote: u8 = 0;
+    var i = open;
+    while (i < text.len) : (i += 1) {
+        const c = text[i];
+        if (quote != 0) {
+            if (c == '\\') i += 1 else if (c == quote) quote = 0;
+            continue;
+        }
+        switch (c) {
+            '\'', '"' => quote = c,
+            '(', '[', '{' => depth += 1,
+            ')', ']', '}' => {
+                depth -= 1;
+                if (depth == 0) return i;
+            },
+            else => {},
+        }
+    }
+    return null;
+}
+
+/// The first top-level comma.
+fn separator(text: []const u8) ?usize {
+    return @import("runner_frontend_integer_statements.zig").separator(text, ',');
+}
+
+/// The first whole word `w` at depth 0 from `from`.
+pub fn top(text: []const u8, w: []const u8, from: usize) ?usize {
+    var depth: usize = 0;
+    var quote: u8 = 0;
+    var i = from;
+    while (i < text.len) : (i += 1) {
+        const c = text[i];
+        if (quote != 0) {
+            if (c == '\\') i += 1 else if (c == quote) quote = 0;
+            continue;
+        }
+        switch (c) {
+            '\'', '"' => quote = c,
+            '(', '[', '{' => depth += 1,
+            ')', ']', '}' => depth -|= 1,
+            else => if (depth == 0 and std.mem.startsWith(u8, text[i..], w)) {
+                const before_ok = i == 0 or !(std.ascii.isAlphanumeric(text[i - 1]) or text[i - 1] == '_');
+                const end = i + w.len;
+                const after_ok = end == text.len or !(std.ascii.isAlphanumeric(text[end]) or text[end] == '_');
+                if (before_ok and after_ok) return i;
+            },
+        }
+    }
+    return null;
+}
diff --git a/zig/src/core/runner_frontend_integer_prove.zig b/zig/src/core/runner_frontend_integer_prove.zig
new file mode 100644
index 000000000..2109a6a1f
--- /dev/null
+++ b/zig/src/core/runner_frontend_integer_prove.zig
@@ -0,0 +1,121 @@
+//! A whole-script integer node's value, folded once with every bound checked (integer_ast Parser.prove).
+const ast = @import("runner_frontend_integer_ast.zig");
+const Parser = ast.Parser;
+const Invalid = ast.Invalid;
+const bound = ast.bound;
+
+pub fn prove(self: *Parser, index: usize, root: usize) Invalid!i512 {
+    const n = self.nodes[index];
+    if (n.op == .divmod and index != root) return error.Unsupported;
+    if (self.proved[index]) return n.value;
+    if (n.op == .literal) return n.value;
+    const a = try self.prove(n.l, root);
+    const b = switch (n.op) {
+        .neg, .digits, .isqrt, .factorial, .digit_sum => 0,
+        else => try self.prove(n.r, root),
+    };
+    const result = switch (n.op) {
+        .literal => unreachable,
+        .neg => -a,
+        .add => a + b,
+        .sub => a - b,
+        .mul => a * b,
+        .eq => @intFromBool(a == b),
+        .ne => @intFromBool(a != b),
+        .lt => @intFromBool(a < b),
+        .le => @intFromBool(a <= b),
+        .gt => @intFromBool(a > b),
+        .ge => @intFromBool(a >= b),
+        .floor, .mod, .divmod => blk: {
+            if (b == 0 or (n.op == .divmod and index != root)) return error.Unsupported;
+            if (n.op == .mod) break :blk @mod(a, b);
+            const q = @divFloor(a, b);
+            if (n.op == .divmod) _ = try bound(@mod(a, b));
+            break :blk q;
+        },
+        .pow => try power(a, b),
+        .powmod => blk: {
+            const m = try self.prove(n.k, root);
+            if (m == 0 or b < 0) return error.Unsupported;
+            var exponent = b;
+            var base = @mod(a, m);
+            var result = @mod(@as(i512, 1), m);
+            while (exponent != 0) {
+                if (@mod(exponent, 2) != 0) result = @mod(result * base, m);
+                exponent = @divTrunc(exponent, 2);
+                if (exponent != 0) base = @mod(base * base, m);
+            }
+            break :blk result;
+        },
+        .gcd => blk: {
+            var x = if (a < 0) -a else a;
+            var y = if (b < 0) -b else b;
+            while (y != 0) {
+                const r = @mod(x, y);
+                x = y;
+                y = r;
+            }
+            break :blk x;
+        },
+        .isqrt => blk: {
+            if (a < 0) return error.Unsupported;
+            var x = a;
+            var y = @divTrunc(x + 1, 2);
+            while (y < x) {
+                x = y;
+                y = @divTrunc(x + @divTrunc(a, x), 2);
+            }
+            break :blk x;
+        },
+        .factorial => blk: {
+            if (a < 0 or a > 48) return error.Unsupported;
+            var result: i512 = 1;
+            var x: i512 = 2;
+            while (x <= a) : (x += 1) result = try bound(result * x);
+            break :blk result;
+        },
+        .range_product => blk: {
+            const step = try self.prove(n.k, root);
+            if (step == 0) return error.Unsupported;
+            var x = a;
+            var count: usize = 0;
+            var result: i512 = 1;
+            while (if (step > 0) x < b else x > b) : (x += step) {
+                if (count == 10000) return error.Unsupported;
+                count += 1;
+                result = try bound(result * try bound(x));
+            }
+            break :blk result;
+        },
+        .digit_sum => blk: {
+            if (self.boolean(n.l) or a < 0) return error.Unsupported;
+            var x = a;
+            var result: i512 = 0;
+            while (x != 0) : (x = @divTrunc(x, 10)) result += @mod(x, 10);
+            break :blk result;
+        },
+        .digits => blk: {
+            if (self.boolean(n.l)) return error.Unsupported;
+            var magnitude = if (a < 0) -a else a;
+            var count: i512 = if (a < 0) 2 else 1;
+            while (magnitude >= 10) : (magnitude = @divTrunc(magnitude, 10)) count += 1;
+            break :blk count;
+        },
+    };
+    self.nodes[index].value = try bound(result);
+    self.proved[index] = true;
+    return result;
+}
+
+fn power(a: i512, b: i512) Invalid!i512 {
+    if (b < 0) return error.Unsupported;
+    var exponent = b;
+    var base = a;
+    var result: i512 = 1;
+    while (exponent != 0) {
+        if (@mod(exponent, 2) != 0) result = try bound(result * base);
+        exponent = @divTrunc(exponent, 2);
+        if (exponent != 0) base = try bound(base * base);
+    }
+    return result;
+}
diff --git a/zig/src/core/runner_frontend_integer_python.zig b/zig/src/core/runner_frontend_integer_python.zig
new file mode 100644
index 000000000..41adcb453
--- /dev/null
+++ b/zig/src/core/runner_frontend_integer_python.zig
@@ -0,0 +1,373 @@
+const std = @import("std");
+const ast = @import("runner_frontend_integer_ast.zig");
+const integer = @import("runner_frontend_integer.zig");
+const compiler = @import("runner_frontend_program_compile.zig");
+const cost = @import("runner_frontend_integer_cost.zig");
+const list = @import("runner_frontend_integer_list.zig");
+const Allocator = std.mem.Allocator;
+const Failure = Allocator.Error || ast.Invalid;
+
+// Immutable bindings retain expression nodes; proof values never replace the requested runtime arithmetic.
+pub fn lower(a: Allocator, code: []const u8) Allocator.Error!?[]u8 {
+    const result = try lowerWithCost(a, code, 0) orelse return null;
+    if (result.graph_only) {
+        a.free(result.source);
+        return null;
+    }
+    return result.source;
+}
+
+pub fn lowerWithCost(a: Allocator, code: []const u8, budget: usize) Allocator.Error!?integer.Lowered {
+    return checked(a, code, budget) catch |err| switch (err) {
+        error.Unsupported => null,
+        error.OutOfMemory => error.OutOfMemory,
+    };
+}
+
+fn checked(a: Allocator, code: []const u8, budget: usize) Failure!integer.Lowered {
+    var script = try parseOutputs(code, true);
+    const parser = &script.parser;
+    var steps: ?usize = null;
+    const roots = script.roots[0..script.count];
+    const endings = script.endings[0..script.count];
+    var t = integer.table(parser, roots, endings, null, null);
+    @memcpy(t.brackets[0..script.count], script.brackets[0..script.count]);
+    // lists, defs, asserts, loops, over 64 nodes or 8 outputs: only the graph route's table (calc, ELF keep theirs)
+    if (parser.listed or parser.function_count != 0 or parser.asserted or parser.looped or parser.count > 64 or script.count > 8) {
+        if (budget != 0) return error.Unsupported;
+        return .{ .source = try a.alloc(u8, 0), .estimated_steps = null, .table = t, .graph_only = true };
+    }
+    if (budget != 0) steps = cost.estimateMany(parser, roots, budget) orelse return error.Unsupported;
+    return .{ .source = try integer.lowerPrints(a, parser, roots, endings), .estimated_steps = steps, .table = t };
+}
+
+// Shares whole-script validation with the RV32 path, including unused assignments and import gates.
+pub fn lowerCalc(a: Allocator, code: []const u8) Allocator.Error!?[]u8 {
+    var script = parseScript(code) catch return null;
+    const p = &script.parser;
+    if (p.listed or p.function_count != 0 or p.asserted or p.looped or p.count > 64) return null;
+    return @import("runner_frontend_integer_calc.zig").lower(a, &script.parser, script.root);
+}
+
+pub const Script = struct { parser: ast.Parser, root: usize };
+
+pub fn parseScript(code: []const u8) ast.Invalid!Script {
+    const script = try parseOutputs(code, false);
+    return .{ .parser = script.parser, .root = script.roots[0] };
+}
+
+const Outputs = struct {
+    parser: ast.Parser,
+    roots: [32]usize = undefined,
+    endings: [32]u8 = undefined, // ' ' or '\n' as print ends a value; ',' between a list's elements
+    brackets: [32]u8 = @splat(0), // 1: a list opens before the value, 2: it closes after
+    count: usize = 0,
+};
+const statements = @import("runner_frontend_integer_statements.zig");
+const suite = @import("runner_frontend_integer_suite.zig");
+
+fn parseOutputs(code: []const u8, multiple: bool) ast.Invalid!Outputs {
+    if (code.len == 0 or code.len > 4096 or std.mem.indexOfScalar(u8, code, '\r') != null)
+        return error.Unsupported;
+    var parser: ast.Parser = .{ .source = "", .require_math_import = true, .allow_lists = true, .capacity = ast.max_nodes };
+    var lines = statements.Iterator{ .code = code };
+    var outputs = Outputs{ .parser = undefined };
+    var expression_only = false;
+    var started = false;
+    while (try lines.next()) |raw| {
+        var line = std.mem.trimEnd(u8, raw.text, " \t");
+        if (raw.after_semicolon) line = std.mem.trimStart(u8, line, " \t");
+        if (line.len == 0) continue;
+        if (((!multiple or expression_only) and outputs.count != 0) or line[0] == ' ' or line[0] == '\t')
+            return error.Unsupported;
+        if (std.mem.startsWith(u8, line, ">>> ")) line = line[4..];
+        if (std.mem.eql(u8, line, "import math")) {
+            if (started) return error.Unsupported;
+            parser.math_module = true;
+            continue;
+        }
+        if (std.mem.startsWith(u8, line, "from math import ")) {
+            if (started) return error.Unsupported;
+            var names = std.mem.splitScalar(u8, line[17..], ',');
+            while (names.next()) |part| {
+                const name = std.mem.trim(u8, part, " ");
+                parser.math_imports |= if (std.mem.eql(u8, name, "gcd")) @as(u8, 1) else if (std.mem.eql(u8, name, "isqrt"))
+                    @as(u8, 2)
+                else if (std.mem.eql(u8, name, "factorial"))
+                    @as(u8, 4)
+                else if (std.mem.eql(u8, name, "prod"))
+                    @as(u8, 8)
+                else
+                    return error.Unsupported;
+            }
+            continue;
+        }
+        started = true;
+        const printed = std.mem.startsWith(u8, line, "print") and line.len > 5 and
+            (line[5] == '(' or line[5] == ' ' or line[5] == '\t');
+        if (keyword(line, "def")) {
+            try define(&parser, &lines, line);
+        } else if (keyword(line, "for") or keyword(line, "while")) {
+            if (!multiple) return error.Unsupported;
+            const Print = struct {
+                fn print(ctx: *anyopaque, p: *ast.Parser, text: []const u8) ast.Invalid!void {
+                    return printRoots(p, @ptrCast(@alignCast(ctx)), text, true);
+                }
+            };
+            try suite.module(&parser, try block(&lines, line), .{ .ctx = &outputs, .print = Print.print });
+        } else if (keyword(line, "assert")) {
+            try check(&parser, line["assert".len..]);
+        } else if (printed) {
+            line = std.mem.trimStart(u8, line[5..], " \t");
+            if (line.len < 3 or line[0] != '(' or line[line.len - 1] != ')') return error.Unsupported;
+            try printRoots(&parser, &outputs, line[1 .. line.len - 1], multiple);
+        } else if (statements.separator(line, '=')) |equal| {
+            try assignment(&parser, std.mem.trim(u8, line[0..equal], " \t"), line[equal + 1 ..]);
+        } else {
+            if (outputs.count != 0 or parser.binding_count != 0 or parser.function_count != 0 or parser.math_module or
+                parser.math_imports != 0) return error.Unsupported;
+            try printRoots(&parser, &outputs, line, false);
+            expression_only = true;
+        }
+    }
+    if (outputs.count == 0) return error.Unsupported;
+    outputs.parser = parser;
+    return outputs;
+}
+
+/// A compound statement from its header line through its indented suite, as one slice of the script.
+fn block(lines: *statements.Iterator, header: []const u8) ast.Invalid![]const u8 {
+    const start = @intFromPtr(header.ptr) - @intFromPtr(lines.code.ptr);
+    var end = start + header.len;
+    var indented = false;
+    while (true) {
+        var ahead = lines.*;
+        const raw = try ahead.next() orelse break;
+        const text = std.mem.trimEnd(u8, raw.text, " \t");
+        const stmt = std.mem.trim(u8, text, " \t");
+        // a semicolon's next statement shares its line: inside the suite after an indented one, else the header's body
+        if (stmt.len != 0 and !raw.after_semicolon and text[0] != ' ' and text[0] != '\t') break;
+        if (raw.after_semicolon and !indented and stmt.len != 0 and header[header.len - 1] == ':') break;
+        lines.* = ahead;
+        if (stmt.len == 0) continue;
+        if (!raw.after_semicolon) indented = true;
+        end = @intFromPtr(raw.text.ptr) - @intFromPtr(lines.code.ptr) + text.len;
+    }
+    return lines.code[start..end];
+}
+
+fn expression(parser: *ast.Parser, text: []const u8) ast.Invalid!usize {
+    parser.source = std.mem.trim(u8, text, " \t");
+    parser.pos = 0;
+    return parser.parse();
+}
+
+/// A whole right side or print argument: a static int list when one parses, else an int expression.
+fn side(parser: *ast.Parser, text: []const u8) ast.Invalid!ast.Parser.Operand {
+    parser.source = std.mem.trim(u8, text, " \t");
+    parser.pos = 0;
+    if (list.ahead(parser)) {
+        const m = parser.mark();
+        if (list.whole(parser, parser.source)) |li| return .{ .index = li, .list = true } else |_| parser.reset(m);
+    }
+    return .{ .index = try parser.parse(), .list = false };
+}
+
+fn assignment(parser: *ast.Parser, names: []const u8, rhs: []const u8) ast.Invalid!void {
+    if (statements.separator(names, ',')) |comma| {
+        const first = std.mem.trim(u8, names[0..comma], " \t");
+        const second = std.mem.trim(u8, names[comma + 1 ..], " \t");
+        if (!validBinding(first) or !validBinding(second)) return error.Unsupported;
+        const pair = try parser.divisionPair(try expression(parser, rhs));
+        try parser.bind(first, pair[0]);
+        try parser.bind(second, pair[1]);
+    } else {
+        if (!validBinding(names)) return error.Unsupported;
+        const v = try side(parser, rhs);
+        if (!v.list and parser.nodes[v.index].op == .divmod) return error.Unsupported;
+        try parser.bindAs(names, v);
+    }
+}
+
+fn keyword(line: []const u8, word: []const u8) bool {
+    return std.mem.startsWith(u8, line, word) and line.len > word.len and
+        (line[word.len] == ' ' or line[word.len] == '\t' or line[word.len] == '(');
+}
+
+/// `def name(a, b):` (`int` annotations): one `return <int expr>` (a docstring first), or a suite of int statements.
+fn define(parser: *ast.Parser, lines: *statements.Iterator, header: []const u8) ast.Invalid!void {
+    const open = std.mem.indexOfScalar(u8, header, '(') orelse return error.Unsupported;
+    const close = std.mem.indexOfScalarPos(u8, header, open, ')') orelse return error.Unsupported;
+    var f: ast.Parser.Function = .{ .name = std.mem.trim(u8, header["def".len..open], " \t"), .body = "" };
+    if (!validBinding(f.name) and !unimported(parser, f.name)) return error.Unsupported;
+    const params = std.mem.trim(u8, header[open + 1 .. close], " \t");
+    if (params.len != 0) {
+        var names = std.mem.splitScalar(u8, params, ',');
+        while (names.next()) |raw| {
+            var p = std.mem.trim(u8, raw, " \t");
+            if (std.mem.indexOfScalar(u8, p, ':')) |colon| {
+                if (!std.mem.eql(u8, std.mem.trim(u8, p[colon + 1 ..], " \t"), "int")) return error.Unsupported;
+                p = std.mem.trim(u8, p[0..colon], " \t");
+            }
+            if (!validBinding(p) or f.arity == f.params.len) return error.Unsupported;
+            f.params[f.arity] = p;
+            f.arity += 1;
+        }
+    }
+    var rest = std.mem.trim(u8, header[close + 1 ..], " \t");
+    if (std.mem.startsWith(u8, rest, "->")) {
+        rest = std.mem.trimStart(u8, rest[2..], " \t");
+        if (!std.mem.startsWith(u8, rest, "int")) return error.Unsupported;
+        rest = std.mem.trimStart(u8, rest[3..], " \t"); // `-> intx:` leaves `x:`, refused below
+    }
+    if (rest.len == 0 or rest[0] != ':') return error.Unsupported;
+    rest = std.mem.trim(u8, rest[1..], " \t");
+    if (rest.len == 0) {
+        // an indented suite: one `return <expr>` (a docstring first) stays an expression body, else statements run
+        const code = try block(lines, header);
+        const text = code[header.len..];
+        if (single(text)) |value| f.body = value else f.suite = text;
+        return parser.define(f);
+    }
+    f.body = try returned(rest);
+    // nothing else may follow on the def's own line or under it
+    while (true) {
+        var ahead = lines.*;
+        const raw = try ahead.next() orelse break;
+        if (raw.after_semicolon) return error.Unsupported; // `def f(): return x; y = 1`: a second body statement
+        const text = std.mem.trimEnd(u8, raw.text, " \t");
+        const stmt = std.mem.trim(u8, text, " \t");
+        if (stmt.len != 0 and text[0] != ' ' and text[0] != '\t') break;
+        lines.* = ahead;
+        if (stmt.len != 0) return error.Unsupported;
+    }
+    try parser.define(f);
+}
+
+/// A suite that is one `return <expr>` without a conditional expression (a docstring may come first), else null.
+fn single(text: []const u8) ?[]const u8 {
+    var it = statements.Iterator{ .code = text };
+    var value: ?[]const u8 = null;
+    var docstring = true;
+    while (it.next() catch return null) |raw| {
+        const stmt = std.mem.trim(u8, raw.text, " \t");
+        if (stmt.len == 0) continue;
+        if (value != null) return null;
+        if (docstring and stmt.len >= 2 and (stmt[0] == '"' or stmt[0] == '\'') and stmt[stmt.len - 1] == stmt[0]) {
+            docstring = false;
+            continue;
+        }
+        docstring = false;
+        const v = returned(stmt) catch return null;
+        if (list.top(v, "if", 0) != null) return null;
+        value = v;
+    }
+    return value;
+}
+
+/// The expression of `return <expr>`: one value (a tuple, or a bare `return`, is not an int).
+fn returned(stmt: []const u8) ast.Invalid![]const u8 {
+    if (!keyword(stmt, "return")) return error.Unsupported;
+    const value = std.mem.trim(u8, stmt["return".len..], " \t");
+    if (value.len == 0 or statements.separator(value, ',') != null) return error.Unsupported;
+    return value;
+}
+
+/// `assert <int cmp>`, proved on the outputs' exact values: true prints nothing; false refuses (the sandbox raises).
+fn check(parser: *ast.Parser, text: []const u8) ast.Invalid!void {
+    if (statements.separator(text, ',') != null) return error.Unsupported; // a message: refuse rather than evaluate it
+    const m = parser.mark();
+    const root = try expression(parser, text);
+    if (!parser.boolean(root) or parser.nodes[root].value == 0) return error.Unsupported;
+    parser.reset(m); // its nodes only proved it: they never print
+    parser.asserted = true;
+}
+
+fn printRoots(parser: *ast.Parser, outputs: *Outputs, text: []const u8, multiple: bool) ast.Invalid!void {
+    var rest = text;
+    while (true) {
+        const comma = statements.separator(rest, ',');
+        if (comma != null and !multiple) return error.Unsupported;
+        const ending: u8 = if (comma != null) ' ' else '\n';
+        const v = try side(parser, rest[0 .. comma orelse rest.len]);
+        if (v.list) {
+            // Python's repr: [1, -2, True]; an empty list or a range object prints no value, so it refuses
+            const l = parser.lists[v.index];
+            if (!multiple or l.range or l.masked or l.len == 0 or outputs.count + l.len > outputs.roots.len) return error.Unsupported;
+            for (parser.items[l.start..][0..l.len], 0..) |e, i| {
+                outputs.roots[outputs.count] = e;
+                outputs.endings[outputs.count] = if (i + 1 == l.len) ending else ',';
+                outputs.brackets[outputs.count] = @as(u8, @intFromBool(i == 0)) | @as(u8, if (i + 1 == l.len) 2 else 0);
+                outputs.count += 1;
+            }
+        } else {
+            if (outputs.count == outputs.roots.len) return error.Unsupported;
+            outputs.roots[outputs.count] = v.index;
+            outputs.endings[outputs.count] = ending;
+            outputs.count += 1;
+        }
+        if (comma) |i| rest = rest[i + 1 ..] else break;
+    }
+}
+
+pub fn compile(a: Allocator, io: std.Io, code: []const u8, config: compiler.Config) Allocator.Error!?[]u8 {
+    const result = try lowerWithCost(a, code, config.step_budget) orelse return null;
+    defer a.free(result.source);
+    if (result.graph_only) return null;
+    var trusted = config;
+    trusted.estimated_steps = result.estimated_steps;
+    if (trusted.optimize != .O0) trusted.optimize = .O2;
+    trusted.opaque_inputs = true;
+    return compiler.compile(a, io, result.source, trusted);
+}
+
+/// math's gcd/isqrt/factorial/prod as a def's own name, where the script never imports it bare.
+fn unimported(parser: *const ast.Parser, name: []const u8) bool {
+    for ([_][]const u8{ "gcd", "isqrt", "factorial", "prod" }, 0..) |w, i| {
+        if (std.mem.eql(u8, name, w)) return parser.math_imports & (@as(u8, 1) << @intCast(i)) == 0;
+    }
+    return false;
+}
+
+pub fn validBinding(name: []const u8) bool {
+    if (name.len == 0 or !(std.ascii.isAlphabetic(name[0]) or name[0] == '_')) return false;
+    for (name) |c| if (!(std.ascii.isAlphanumeric(c) or c == '_')) return false;
+    for ([_][]const u8{
+        "print",  "pow",    "divmod",    "int",       "str",          "len",     "sum",    "map",    "range", "all",   "abs",       "math",
+        "gcd",    "isqrt",  "factorial", "prod",      "True",         "False",   "None",   "and",    "or",    "not",   "if",        "else",
+        "for",    "while",  "in",        "is",        "def",          "return",  "import", "from",   "as",    "class", "del",       "yield",
+        "lambda", "global", "nonlocal",  "try",       "except",       "finally", "with",   "assert", "raise", "pass",  "break",     "continue",
+        "async",  "await",  "elif",      "__debug__", "__builtins__", "min",     "max",    "sorted", "list",  "zip",   "enumerate",
+    }) |reserved| if (std.mem.eql(u8, name, reserved)) return false;
+    return true;
+}
+
+test "wide assignment bindings preserve requests and validate unused expressions" {
+    const a = std.testing.allocator;
+    for ([_][]const u8{
+        "a = 314159\nb = 271828\nprint(a * b)",
+        "x = 10**40\ny = pow(x,2,97)\nprint(y)",
+        "a = 7\na = a+2\nprint(a*a)",
+        "import math\nn = 12345678901234567890\nprint(math.isqrt(n))",
+        "from math import gcd\na = 48\nb = 18\nprint(gcd(a,b))",
+    }) |code| {
+        const source = (try lower(a, code)).?;
+        defer a.free(source);
+        try std.testing.expect(std.mem.indexOf(u8, source, "tf_run(tf_nodes,") != null);
+    }
+    for ([_][]const u8{
+        "x = 1//0\nprint(3)",
+        "x = 10**62\nprint(3)",
+        "x = x+1\nprint(x)",
+        "print(math.gcd(48,18))",
+        "print(gcd(48,18))",
+        "from math import *\nprint(3)",
+        "import math as m\nprint(m.gcd(48,18))",
+        "pow = 2\nprint(pow)",
+        "a = divmod(7,3)\nprint(a)",
+        "import os\nprint(3)",
+        "x = 1.25\nprint(x)",
+        "__builtins__ = 0\nprint(3)",
+        "x = 3\nx*2",
+    }) |code| try std.testing.expectEqual(@as(?[]u8, null), try lower(a, code));
+}
diff --git a/zig/src/core/runner_frontend_integer_runtime.c b/zig/src/core/runner_frontend_integer_runtime.c
new file mode 100644
index 000000000..9a2dc9f78
--- /dev/null
+++ b/zig/src/core/runner_frontend_integer_runtime.c
@@ -0,0 +1,574 @@
+// RV32 integer library; program_compile supplies memory operations, putchar and startup.
+typedef unsigned int tf_wu;
+typedef unsigned long long tf_wd;
+struct tf_wint { tf_wu v[8]; int neg; };
+
+// ABI: nodes are topological with n <= 64; tf_run prints node n-1 and tf_run_many takes ordered output refs.
+struct tf_node { int op, l, r, k; const char *text; };
+
+// Ops 0..15 are stable; 16..21 compare integers and internal op 22 reads a cached division remainder.
+static volatile struct tf_wint tf_wvalues[64];
+static volatile struct tf_wint tf_wremainders[64];
+
+// The parent proves every admitted input and node result has magnitude below 10^62; scratch products use 512 bits.
+static int tf_wbad;
+
+static struct tf_wint tf_wsmall(tf_wu x) {
+    struct tf_wint a;
+    for (int i = 0; i < 8; ++i) a.v[i] = 0;
+    a.v[0] = x;
+    a.neg = 0;
+    return a;
+}
+
+static int tf_wused(const struct tf_wint *a) {
+    int n = 8;
+    while (n && !a->v[n - 1]) --n;
+    return n;
+}
+
+static void tf_wnormalize(struct tf_wint *a) {
+    if (!tf_wused(a)) a->neg = 0;
+}
+
+static int tf_wcmp(const struct tf_wint *a, const struct tf_wint *b) {
+    for (int i = 7; i >= 0; --i) {
+        if (a->v[i] != b->v[i]) return a->v[i] > b->v[i] ? 1 : -1;
+    }
+    return 0;
+}
+
+static void tf_wbound(const struct tf_wint *a) {
+    const struct tf_wint limit = {
+        { 0u, 1073741824u, 4155282634u, 576837993u, 895677624u, 3947553080u, 15930u, 0u }, 0
+    };
+    if (tf_wcmp(a, &limit) >= 0) tf_wbad = 1;
+}
+
+static struct tf_wint tf_waddmag(const struct tf_wint *a, const struct tf_wint *b) {
+    struct tf_wint c = tf_wsmall(0);
+    tf_wd carry = 0;
+    for (int i = 0; i < 8; ++i) {
+        tf_wd s = (tf_wd)a->v[i] + b->v[i] + carry;
+        c.v[i] = (tf_wu)s;
+        carry = s >> 32;
+    }
+    if (carry) tf_wbad = 1;
+    return c;
+}
+
+// Magnitude subtraction also supports the wrapped low words of a 257-bit division remainder.
+static struct tf_wint tf_wsubmag(const struct tf_wint *a, const struct tf_wint *b) {
+    struct tf_wint c = tf_wsmall(0);
+    tf_wd borrow = 0;
+    for (int i = 0; i < 8; ++i) {
+        tf_wd t = (tf_wd)b->v[i] + borrow;
+        c.v[i] = a->v[i] - (tf_wu)t;
+        borrow = (tf_wd)a->v[i] < t;
+    }
+    return c;
+}
+
+static struct tf_wint tf_wadd(struct tf_wint a, struct tf_wint b) {
+    struct tf_wint c;
+    if (a.neg == b.neg) {
+        c = tf_waddmag(&a, &b);
+        c.neg = a.neg;
+    } else if (tf_wcmp(&a, &b) >= 0) {
+        c = tf_wsubmag(&a, &b);
+        c.neg = a.neg;
+    } else {
+        c = tf_wsubmag(&b, &a);
+        c.neg = b.neg;
+    }
+    tf_wnormalize(&c);
+    return c;
+}
+
+static void tf_wproduct(tf_wu w[16], const struct tf_wint *a, const struct tf_wint *b) {
+    for (int i = 0; i < 16; ++i) w[i] = 0;
+    int na = tf_wused(a), nb = tf_wused(b);
+    for (int i = 0; i < na; ++i) {
+        tf_wd carry = 0;
+        for (int j = 0; j < nb; ++j) {
+            tf_wd t = (tf_wd)a->v[i] * b->v[j] + w[i + j] + carry;
+            w[i + j] = (tf_wu)t;
+            carry = t >> 32;
+        }
+        w[i + nb] = (tf_wu)carry;
+    }
+}
+
+static struct tf_wint tf_wmul(const struct tf_wint *a, const struct tf_wint *b) {
+    tf_wu w[16];
+    tf_wproduct(w, a, b);
+    struct tf_wint c = tf_wsmall(0);
+    for (int i = 0; i < 8; ++i) {
+        c.v[i] = w[i];
+        if (w[i + 8]) tf_wbad = 1;
+    }
+    c.neg = a->neg != b->neg;
+    tf_wnormalize(&c);
+    tf_wbound(&c);
+    return c;
+}
+
+// All divisions use 32-bit instructions; the small-divisor path handles two halfwords per limb.
+static tf_wu tf_wdivsmall(tf_wu *w, int n, tf_wu d) {
+    tf_wu rem = 0;
+    for (int i = n - 1; i >= 0; --i) {
+        tf_wu x = w[i];
+        if (d <= 65535u) {
+            tf_wu t = (rem << 16) | (x >> 16);
+            tf_wu q = t / d;
+            t = ((t % d) << 16) | (x & 65535u);
+            w[i] = (q << 16) | (t / d);
+            rem = t % d;
+        } else if (!rem) {
+            w[i] = x / d;
+            rem = x % d;
+        } else {
+            tf_wu q = 0;
+            for (int bit = 31; bit >= 0; --bit) {
+                tf_wu high = rem >> 31;
+                rem = (rem << 1) | ((x >> bit) & 1u);
+                if (high || rem >= d) {
+                    rem -= d;
+                    q |= 1u << bit;
+                }
+            }
+            w[i] = q;
+        }
+    }
+    return rem;
+}
+
+static int tf_wbits(const tf_wu *w, int n) {
+    while (n && !w[n - 1]) --n;
+    if (!n) return 0;
+    tf_wu x = w[n - 1];
+    int bits = (n - 1) * 32;
+    while (x) { ++bits; x >>= 1; }
+    return bits;
+}
+
+static int tf_wstep(struct tf_wint *r, tf_wu bit, const struct tf_wint *d) {
+    tf_wu carry = bit;
+    for (int i = 0; i < 8; ++i) {
+        tf_wu high = r->v[i] >> 31;
+        r->v[i] = (r->v[i] << 1) | carry;
+        carry = high;
+    }
+    if (!carry && tf_wcmp(r, d) < 0) return 0;
+    *r = tf_wsubmag(r, d);
+    return 1;
+}
+
+static void tf_wdivmag(const struct tf_wint *a, const struct tf_wint *b,
+                       struct tf_wint *q, struct tf_wint *r) {
+    *q = tf_wsmall(0);
+    *r = tf_wsmall(0);
+    int na = (tf_wbits(a->v, 8) + 15) / 16;
+    int nb = (tf_wbits(b->v, 8) + 15) / 16;
+    if (!nb) { tf_wbad = 1; return; }
+    if (tf_wcmp(a, b) < 0) { *r = *a; r->neg = 0; return; }
+    if (nb == 1) {
+        *q = *a;
+        q->neg = 0;
+        r->v[0] = tf_wdivsmall(q->v, tf_wused(q), b->v[0]);
+        return;
+    }
+    tf_wu u[17], v[16];
+    int shift = 16 * nb - tf_wbits(b->v, 8);
+    tf_wu carry = 0;
+    for (int i = 0; i < nb; ++i) {
+        tf_wu x = ((b->v[i / 2] >> (16 * (i % 2))) & 65535u) << shift;
+        v[i] = (x | carry) & 65535u;
+        carry = x >> 16;
+    }
+    carry = 0;
+    for (int i = 0; i < na; ++i) {
+        tf_wu x = ((a->v[i / 2] >> (16 * (i % 2))) & 65535u) << shift;
+        u[i] = (x | carry) & 65535u;
+        carry = x >> 16;
+    }
+    u[na] = carry;
+    for (int j = na - nb; j >= 0; --j) {
+        tf_wu top = (u[j + nb] << 16) | u[j + nb - 1];
+        tf_wu digit = u[j + nb] == v[nb - 1] ? 65535u : top / v[nb - 1];
+        tf_wu rem = top - digit * v[nb - 1];
+        while (rem < 65536u && digit * v[nb - 2] > (rem << 16) + u[j + nb - 2]) {
+            --digit;
+            rem += v[nb - 1];
+        }
+        tf_wu borrow = 0;
+        for (int i = 0; i < nb; ++i) {
+            tf_wu product = digit * v[i] + borrow;
+            tf_wu low = product & 65535u;
+            borrow = (product >> 16) + (u[j + i] < low);
+            u[j + i] = (u[j + i] - low) & 65535u;
+        }
+        int negative = u[j + nb] < borrow;
+        u[j + nb] = (u[j + nb] - borrow) & 65535u;
+        if (negative) {
+            --digit;
+            carry = 0;
+            for (int i = 0; i < nb; ++i) {
+                tf_wu sum = u[j + i] + v[i] + carry;
+                u[j + i] = sum & 65535u;
+                carry = sum >> 16;
+            }
+            u[j + nb] = (u[j + nb] + carry) & 65535u;
+        }
+        q->v[j / 2] |= digit << (16 * (j % 2));
+    }
+    for (int i = 0; i < nb; ++i) {
+        tf_wu digit = ((u[i] | (u[i + 1] << 16)) >> shift) & 65535u;
+        r->v[i / 2] |= digit << (16 * (i % 2));
+    }
+}
+
+static void tf_wdivmod(const struct tf_wint *a, const struct tf_wint *b,
+                       struct tf_wint *q, struct tf_wint *r) {
+    tf_wdivmag(a, b, q, r);
+    if (tf_wbad) return;
+    if (a->neg != b->neg && tf_wused(r)) {
+        struct tf_wint one = tf_wsmall(1);
+        *q = tf_waddmag(q, &one);
+        *r = tf_wsubmag(b, r);
+    }
+    q->neg = a->neg != b->neg;
+    r->neg = b->neg;
+    tf_wnormalize(q);
+    tf_wnormalize(r);
+}
+
+static struct tf_wint tf_wmodmul(const struct tf_wint *a, const struct tf_wint *b,
+                                const struct tf_wint *m) {
+    tf_wu w[16];
+    tf_wproduct(w, a, b);
+    struct tf_wint r = tf_wsmall(0);
+    if (tf_wused(m) == 1) {
+        r.v[0] = tf_wdivsmall(w, 16, m->v[0]);
+        return r;
+    }
+    for (int bit = tf_wbits(w, 16) - 1; bit >= 0; --bit)
+        tf_wstep(&r, (w[bit / 32] >> (bit % 32)) & 1u, m);
+    return r;
+}
+
+static struct tf_wint tf_wpow(struct tf_wint a, const struct tf_wint *e,
+                             const struct tf_wint *mod) {
+    struct tf_wint result = tf_wsmall(1), m = tf_wsmall(0), unused;
+    if (e->neg) { tf_wbad = 1; return m; }
+    if (mod) {
+        m = *mod;
+        m.neg = 0;
+        if (!tf_wused(&m)) { tf_wbad = 1; return m; }
+        if (tf_wused(&m) == 1 && m.v[0] == 1) return tf_wsmall(0);
+        int negative = a.neg;
+        struct tf_wint reduced;
+        tf_wdivmag(&a, &m, &unused, &reduced);
+        a = reduced;
+        if (negative && tf_wused(&a)) a = tf_wsubmag(&m, &a);
+    }
+    int bits = tf_wbits(e->v, 8);
+    for (int bit = 0; bit < bits && !tf_wbad; ++bit) {
+        if ((e->v[bit / 32] >> (bit % 32)) & 1u)
+            result = mod ? tf_wmodmul(&result, &a, &m) : tf_wmul(&result, &a);
+        if (bit + 1 < bits) a = mod ? tf_wmodmul(&a, &a, &m) : tf_wmul(&a, &a);
+    }
+    if (mod && mod->neg && tf_wused(&result)) {
+        result = tf_wsubmag(&m, &result);
+        result.neg = 1;
+    }
+    return result;
+}
+
+static struct tf_wint tf_wgcd(struct tf_wint a, struct tf_wint b) {
+    a.neg = b.neg = 0;
+    while (tf_wused(&b) && !tf_wbad) {
+        struct tf_wint q, r;
+        tf_wdivmag(&a, &b, &q, &r);
+        a = b;
+        b = r;
+    }
+    return a;
+}
+
+static struct tf_wint tf_wisqrt(const struct tf_wint *a) {
+    struct tf_wint x = tf_wsmall(0), q, r;
+    if (a->neg) { tf_wbad = 1; return x; }
+    int bits = tf_wbits(a->v, 8);
+    if (!bits) return x;
+    int shift = (bits + 1) / 2;
+    x.v[shift / 32] = 1u << (shift % 32);
+    tf_wdivmag(a, &x, &q, &r);
+    struct tf_wint y = tf_waddmag(&x, &q);
+    tf_wdivsmall(y.v, 8, 2);
+    while (tf_wcmp(&y, &x) < 0 && !tf_wbad) {
+        x = y;
+        tf_wdivmag(a, &x, &q, &r);
+        y = tf_waddmag(&x, &q);
+        tf_wdivsmall(y.v, 8, 2);
+    }
+    return x;
+}
+
+static struct tf_wint tf_wfactorial(const struct tf_wint *a) {
+    struct tf_wint result = tf_wsmall(1), maximum = tf_wsmall(48);
+    if (a->neg || tf_wcmp(a, &maximum) > 0) { tf_wbad = 1; return result; }
+    for (tf_wu i = 2; i <= a->v[0] && !tf_wbad; ++i) {
+        struct tf_wint factor = tf_wsmall(i);
+        result = tf_wmul(&result, &factor);
+    }
+    return result;
+}
+
+static int tf_wsignedcmp(const struct tf_wint *a, const struct tf_wint *b) {
+    if (a->neg != b->neg) return a->neg ? -1 : 1;
+    return a->neg ? -tf_wcmp(a, b) : tf_wcmp(a, b);
+}
+
+static struct tf_wint tf_wrange(struct tf_wint a, const struct tf_wint *stop,
+                               const struct tf_wint *step) {
+    struct tf_wint result = tf_wsmall(1);
+    if (!tf_wused(step)) { tf_wbad = 1; return result; }
+    if (step->neg ? tf_wsignedcmp(&a, stop) <= 0 : tf_wsignedcmp(&a, stop) >= 0) return result;
+    struct tf_wint negative = step->neg ? *stop : a;
+    negative.neg = !negative.neg;
+    struct tf_wint distance = tf_wadd(step->neg ? a : *stop, negative);
+    struct tf_wint stride = *step, length, remainder;
+    stride.neg = 0;
+    tf_wdivmod(&distance, &stride, &length, &remainder);
+    if (tf_wused(&remainder)) length = tf_wadd(length, tf_wsmall(1));
+    struct tf_wint maximum = tf_wsmall(10000);
+    if (tf_wbad || tf_wcmp(&length, &maximum) > 0) { tf_wbad = 1; return result; }
+    int count = 0;
+    while (!tf_wbad && (step->neg ? tf_wsignedcmp(&a, stop) > 0 : tf_wsignedcmp(&a, stop) < 0)) {
+        if (++count > 10000) { tf_wbad = 1; break; }
+        tf_wbound(&a);
+        result = tf_wmul(&result, &a);
+        if (!tf_wused(&result)) return result;
+        a = tf_wadd(a, *step);
+    }
+    return result;
+}
+
+static struct tf_wint tf_wdigitsum(struct tf_wint a) {
+    tf_wu sum = 0;
+    if (a.neg) tf_wbad = 1;
+    while (tf_wused(&a)) sum += tf_wdivsmall(a.v, 8, 10);
+    return tf_wsmall(sum);
+}
+
+// Literal text contains signed digits without a radix prefix; k is radix 2, 10, or 16, not a child index.
+static struct tf_wint tf_wparse(const volatile char *s, int base) {
+    struct tf_wint a = tf_wsmall(0);
+    if (!s || (base != 2 && base != 10 && base != 16)) { tf_wbad = 1; return a; }
+    int negative = *s == '-';
+    if (*s == '-' || *s == '+') ++s;
+    if (!*s) tf_wbad = 1;
+    int used = 1;
+    while (*s) {
+        tf_wu chunk = 0, multiplier = 1;
+        int count = 0;
+        do {
+            unsigned char c = (unsigned char)*s++;
+            int digit;
+            if (c >= '0' && c <= '9') digit = c - '0';
+            else if (c >= 'a' && c <= 'f') digit = c - 'a' + 10;
+            else if (c >= 'A' && c <= 'F') digit = c - 'A' + 10;
+            else { tf_wbad = 1; return a; }
+            if (digit >= base) { tf_wbad = 1; return a; }
+            chunk = chunk * (tf_wu)base + (tf_wu)digit;
+            multiplier *= (tf_wu)base;
+            ++count;
+        } while (base == 10 && count < 4 && *s);
+        tf_wd carry = chunk;
+        for (int i = 0; i < used; ++i) {
+            tf_wd t = (tf_wd)a.v[i] * multiplier + carry;
+            a.v[i] = (tf_wu)t;
+            carry = t >> 32;
+        }
+        if (carry) {
+            if (used == 8) { tf_wbad = 1; return a; }
+            a.v[used++] = (tf_wu)carry;
+        }
+    }
+    a.neg = negative;
+    tf_wnormalize(&a);
+    return a;
+}
+
+static int tf_wformat(struct tf_wint a, char text[79]) {
+    char digits[78];
+    int count = 0, len = 0;
+    int used = tf_wused(&a);
+    do {
+        tf_wu chunk = tf_wdivsmall(a.v, used, 10000);
+        while (used && !a.v[used - 1]) --used;
+        int width = 0;
+        do {
+            digits[count++] = (char)('0' + chunk % 10);
+            chunk /= 10;
+            ++width;
+        } while (used ? width < 4 : chunk != 0);
+    } while (used);
+    if (a.neg) text[len++] = '-';
+    while (count) text[len++] = digits[--count];
+    return len;
+}
+
+static void tf_wprint(const struct tf_wint *a) {
+    char text[79];
+    int len = tf_wformat(*a, text);
+    for (int i = 0; i < len; ++i) putchar(text[i]);
+}
+
+// Fixed Decimal formatting inserts the proved scale into a runtime coefficient.
+static void tf_wfixed(const struct tf_wint *value, int scale) {
+    char text[79];
+    int length = tf_wformat(*value, text);
+    int start = text[0] == '-', digits = length - start;
+    if (start) putchar('-');
+    if (!scale) {
+        for (int i = start; i < length; ++i) putchar(text[i]);
+    } else if (digits <= scale) {
+        putchar('0'); putchar('.');
+        for (int i = digits; i < scale; ++i) putchar('0');
+        for (int i = start; i < length; ++i) putchar(text[i]);
+    } else {
+        for (int i = start; i < length; ++i) {
+            if (i == length - scale) putchar('.');
+            putchar(text[i]);
+        }
+    }
+}
+
+// Evaluate every node before printing any ordered root; volatile reads retain the requested runtime arithmetic.
+int tf_run_formatted(const volatile struct tf_node *nodes, int n, const volatile int *roots,
+                     const volatile unsigned char *endings, const volatile unsigned char *styles,
+                     const volatile unsigned char *scales, int count) {
+    tf_wbad = 0;
+    if (!nodes || n < 1 || n > 64 || !roots || count < 1 || count > 8) return 1;
+    int outputs[8];
+    unsigned char separators[8], formats[8], precision[8];
+    for (int j = 0; j < count; ++j) {
+        outputs[j] = roots[j];
+        if (outputs[j] < 0 || outputs[j] >= n) return 1;
+        separators[j] = endings ? endings[j] : '\n';
+        if (separators[j] != ' ' && separators[j] != '\n') return 1;
+        formats[j] = styles ? styles[j] : 0;
+        precision[j] = scales ? scales[j] : 0;
+        if (formats[j] > 2 || precision[j] > 6) return 1;
+        int op = nodes[outputs[j]].op;
+        if (formats[j] && (op == 10 || (op >= 16 && op <= 21))) return 1;
+    }
+    for (int i = 0; i < n; ++i) {
+        const volatile struct tf_node *node = &nodes[i];
+        struct tf_wint a = tf_wsmall(0), b = tf_wsmall(0), c;
+        int op = node->op, l = node->l, r = node->r, k = node->k;
+        if (op < 0 || op > 22) return 1;
+        if (op) {
+            if (l < 0 || l >= i || (op != 22 && nodes[l].op == 10)) return 1;
+            a = tf_wvalues[l];
+        }
+        if ((op >= 2 && op <= 8) || op == 10 || op == 11 || op == 14 || (op >= 16 && op <= 21)) {
+            if (r < 0 || r >= i || nodes[r].op == 10) return 1;
+            b = tf_wvalues[r];
+        }
+        switch (op) {
+        case 0: c = tf_wparse(node->text, k); break;
+        case 1:
+            c = a;
+            c.neg = !c.neg;
+            tf_wnormalize(&c);
+            break;
+        case 2: c = tf_wadd(a, b); break;
+        case 3:
+            b.neg = !b.neg;
+            c = tf_wadd(a, b);
+            break;
+        case 4: c = tf_wmul(&a, &b); break;
+        case 5: case 6: case 10: {
+            struct tf_wint remainder;
+            tf_wdivmod(&a, &b, &c, &remainder);
+            tf_wremainders[i] = remainder;
+            if (op == 6) c = remainder;
+            break;
+        }
+        case 7: c = tf_wpow(a, &b, (const struct tf_wint *)0); break;
+        case 8: case 14: {
+            if (k < 0 || k >= i || nodes[k].op == 10) return 1;
+            struct tf_wint third = tf_wvalues[k];
+            c = op == 8 ? tf_wpow(a, &b, &third) : tf_wrange(a, &b, &third);
+            break;
+        }
+        case 9: {
+            char text[79];
+            c = tf_wsmall((tf_wu)tf_wformat(a, text));
+            break;
+        }
+        case 11: c = tf_wgcd(a, b); break;
+        case 12: c = tf_wisqrt(&a); break;
+        case 13: c = tf_wfactorial(&a); break;
+        case 15: c = tf_wdigitsum(a); break;
+        case 16: case 17: case 18: case 19: case 20: case 21: {
+            int cmp = tf_wsignedcmp(&a, &b);
+            c = tf_wsmall((tf_wu)(op == 16 ? cmp == 0 : op == 17 ? cmp != 0 :
+                op == 18 ? cmp < 0 : op == 19 ? cmp <= 0 : op == 20 ? cmp > 0 : cmp >= 0));
+            break;
+        }
+        case 22:
+            if (nodes[l].op != 5 && nodes[l].op != 10) return 1;
+            c = tf_wremainders[l];
+            break;
+        default: return 1;
+        }
+        tf_wbound(&c);
+        if (tf_wbad) return 1;
+        tf_wvalues[i] = c;
+    }
+    for (int j = 0; j < count; ++j) {
+        int root = outputs[j], op = nodes[root].op;
+        struct tf_wint value = tf_wvalues[root];
+        if (formats[j] >= 2) {
+            tf_wfixed(&value, precision[j]);
+        } else if (formats[j] == 1) {
+            tf_wprint(&value); putchar('.'); putchar('0');
+        } else if (op >= 16 && op <= 21) {
+            const char *text = tf_wused(&value) ? "True" : "False";
+            while (*text) putchar(*text++);
+        } else {
+            if (op == 10) putchar('(');
+            tf_wprint(&value);
+            if (op == 10) {
+                putchar(',');
+                putchar(' ');
+                struct tf_wint remainder = tf_wremainders[root];
+                tf_wprint(&remainder);
+                putchar(')');
+            }
+        }
+        putchar(separators[j]);
+    }
+    return 0;
+}
+
+int tf_run_prints(const volatile struct tf_node *nodes, int n, const volatile int *roots,
+                  const volatile unsigned char *endings, int count) {
+    return tf_run_formatted(nodes, n, roots, endings, (const volatile unsigned char *)0,
+                            (const volatile unsigned char *)0, count);
+}
+
+int tf_run_many(const volatile struct tf_node *nodes, int n, const volatile int *roots, int count) {
+    return tf_run_prints(nodes, n, roots, (const volatile unsigned char *)0, count);
+}
+
+// Retain the standalone ABI and its last-node output convention.
+int tf_run(const volatile struct tf_node *nodes, int n) {
+    if (n < 1 || n > 64) return 1;
+    const int root = n - 1;
+    return tf_run_many(nodes, n, &root, 1);
+}
diff --git a/zig/src/core/runner_frontend_integer_statements.zig b/zig/src/core/runner_frontend_integer_statements.zig
new file mode 100644
index 000000000..1a48c5936
--- /dev/null
+++ b/zig/src/core/runner_frontend_integer_statements.zig
@@ -0,0 +1,80 @@
+const std = @import("std");
+const Invalid = @import("runner_frontend_integer_ast.zig").Invalid;
+
+pub const Statement = struct { text: []const u8, after_semicolon: bool };
+
+// Split only physical top-level statements. Quoted conversion literals retain their original bytes.
+pub const Iterator = struct {
+    code: []const u8,
+    pos: usize = 0,
+    continuation: bool = false,
+
+    pub fn next(self: *Iterator) Invalid!?Statement {
+        if (self.pos == 0 and std.mem.indexOfScalar(u8, self.code, 0) != null) return error.Unsupported;
+        if (self.pos == self.code.len) return null;
+        const start = self.pos;
+        const continuation = self.continuation;
+        var quote: u8 = 0;
+        var depth: usize = 0;
+        while (self.pos < self.code.len) {
+            const c = self.code[self.pos];
+            if (quote != 0) {
+                if (c == '\n') return error.Unsupported;
+                self.pos += 1;
+                if (c == '\\') {
+                    if (self.pos == self.code.len) return error.Unsupported;
+                    self.pos += 1;
+                } else if (c == quote) quote = 0;
+                continue;
+            }
+            if (c == '\'' or c == '"') {
+                quote = c;
+            } else if (c == '(' or c == '[' or c == '{') {
+                depth += 1;
+                if (depth > 16) return error.Unsupported;
+            } else if (c == ')' or c == ']' or c == '}') {
+                if (depth == 0) return error.Unsupported;
+                depth -= 1;
+            } else if (c == '#' or c == '\n' or (c == ';' and depth == 0)) {
+                if (depth != 0) return error.Unsupported;
+                const end = self.pos;
+                if (c == ';' and std.mem.trim(u8, self.code[start..end], " \t").len == 0)
+                    return error.Unsupported;
+                if (c == '#') {
+                    while (self.pos < self.code.len and self.code[self.pos] != '\n') : (self.pos += 1) {}
+                }
+                if (self.pos < self.code.len) self.pos += 1;
+                self.continuation = c == ';';
+                return .{ .text = self.code[start..end], .after_semicolon = continuation };
+            }
+            self.pos += 1;
+        }
+        if (quote != 0 or depth != 0) return error.Unsupported;
+        self.continuation = false;
+        return .{ .text = self.code[start..], .after_semicolon = continuation };
+    }
+};
+
+// Commas and assignment signs inside calls/conversion strings are not statement syntax.
+pub fn separator(text: []const u8, token: u8) ?usize {
+    var quote: u8 = 0;
+    var escaped = false;
+    var depth: usize = 0;
+    for (text, 0..) |c, i| {
+        if (quote != 0) {
+            if (escaped) escaped = false else if (c == '\\') escaped = true else if (c == quote) quote = 0;
+            continue;
+        }
+        if (c == '\'' or c == '"') quote = c else if (c == '(' or c == '[' or c == '{') {
+            depth += 1;
+        } else if (c == ')' or c == ']' or c == '}') {
+            if (depth == 0) return null;
+            depth -= 1;
+        } else if (depth == 0 and c == token) {
+            if (token == '=' and ((i != 0 and std.mem.indexOfScalar(u8, "=!<>", text[i - 1]) != null) or
+                (i + 1 < text.len and text[i + 1] == '='))) continue;
+            return i;
+        }
+    }
+    return null;
+}
diff --git a/zig/src/core/runner_frontend_integer_suite.zig b/zig/src/core/runner_frontend_integer_suite.zig
new file mode 100644
index 000000000..dc5ad1f0a
--- /dev/null
+++ b/zig/src/core/runner_frontend_integer_suite.zig
@@ -0,0 +1,516 @@
+//! Suites in the whole-script integer lowering: def bodies and for/while loops, unrolled into nodes.
+const std = @import("std");
+const ast = @import("runner_frontend_integer_ast.zig");
+const statements = @import("runner_frontend_integer_statements.zig");
+const list = @import("runner_frontend_integer_list.zig");
+const Parser = ast.Parser;
+const Invalid = ast.Invalid;
+
+// Value decisions (a trip, a while test, a base case) are 0/1 nodes gating each assignment; unroll counts are schedule.
+
+/// Iterations one loop may unroll (a range's length, a while's true tests); past it the script refuses.
+pub const max_trips = 32;
+
+/// A module statement's `print(...)` arguments, printed as the script's own outputs.
+pub const Printer = struct { ctx: *anyopaque, print: *const fn (*anyopaque, *Parser, []const u8) Invalid!void };
+
+const Line = struct { indent: usize, text: []const u8 };
+const Lines = struct {
+    items: [96]Line = undefined,
+    len: usize = 0,
+
+    fn push(l: *Lines, indent: usize, text: []const u8) Invalid!void {
+        if (l.len == l.items.len) return error.Unsupported;
+        l.items[l.len] = .{ .indent = indent, .text = text };
+        l.len += 1;
+    }
+};
+
+pub const Run = struct {
+    p: *Parser,
+    lines: *const Lines,
+    function: bool, // a def's body: locals bind in its frame, `return` ends it, print refuses (a side effect)
+    printer: ?Printer = null,
+    pred: ?usize = null, // the 0/1 node gating every assignment here; null: unconditional
+    check: bool = false, // at the def: syntax only (each loop body once, both branches parsed), as Python compiles it
+    divided: ?struct { line: usize, name: []const u8, root: usize } = null, // a digit loop's `x //= L`: its closed form
+};
+
+/// A def's suite inlined at a call: its frame holds the parameters; every name it assigns is local from the start.
+pub fn call(p: *Parser, suite: []const u8) Invalid!usize {
+    const lines = try split(suite);
+    p.looped = true;
+    try prebind(p, &lines);
+    var r: Run = .{ .p = p, .lines = &lines, .function = true };
+    return (try exec(&r, 0, lines.len, true)) orelse error.Unsupported;
+}
+
+/// A def's suite as Python compiles it: statement shapes and expression syntax; names resolve at each call.
+pub fn check(p: *Parser, suite: []const u8) Invalid!void {
+    const lines = try split(suite);
+    const saved = .{ p.source, p.pos, p.count, p.item_count, p.list_count, p.check_only, p.binding_count };
+    defer {
+        p.source, p.pos, p.count, p.item_count, p.list_count, p.check_only, p.binding_count = saved;
+    }
+    p.check_only = true;
+    var r: Run = .{ .p = p, .lines = &lines, .function = true, .check = true };
+    _ = try exec(&r, 0, lines.len, true);
+}
+
+/// A module-level `for`/`while` statement and its suite; prints only where no value decides whether they run.
+pub fn module(p: *Parser, block: []const u8, printer: Printer) Invalid!void {
+    const lines = try split(block);
+    p.looped = true;
+    var r: Run = .{ .p = p, .lines = &lines, .function = false, .printer = printer };
+    if (try exec(&r, 0, lines.len, false) != null) return error.Unsupported;
+}
+
+/// A suite's statements with their columns; a header's same-line body sits one column deeper.
+fn split(code: []const u8) Invalid!Lines {
+    var out: Lines = .{};
+    var it = statements.Iterator{ .code = code };
+    var last: usize = 0;
+    while (try it.next()) |raw| {
+        const text = std.mem.trimEnd(u8, raw.text, " \t");
+        const body = std.mem.trimStart(u8, text, " \t");
+        if (body.len == 0) continue;
+        var indent = last;
+        if (!raw.after_semicolon) {
+            indent = 0;
+            for (text[0 .. text.len - body.len]) |c| indent = if (c == '\t') (indent / 8 + 1) * 8 else indent + 1;
+        }
+        last = indent;
+        if (header(body)) |colon| {
+            try out.push(indent, body[0 .. colon + 1]);
+            const rest = std.mem.trim(u8, body[colon + 1 ..], " \t");
+            if (rest.len != 0) {
+                last = indent + 1;
+                try out.push(last, rest);
+            }
+        } else try out.push(indent, body);
+    }
+    if (out.len == 0) return error.Unsupported;
+    return out;
+}
+
+/// The colon ending a compound statement's header, or null for a simple statement.
+fn header(text: []const u8) ?usize {
+    for ([_][]const u8{ "for", "while", "if", "elif", "else", "def", "class", "with", "try", "except", "finally" }) |w| {
+        if (word(text, w)) return statements.separator(text, ':') orelse text.len - 1;
+    }
+    return null;
+}
+
+fn word(text: []const u8, w: []const u8) bool {
+    if (!std.mem.startsWith(u8, text, w)) return false;
+    return text.len == w.len or !(std.ascii.isAlphanumeric(text[w.len]) or text[w.len] == '_');
+}
+
+/// The first line past `i` at `i`'s column or left of it: the end of i's suite.
+fn blockEnd(lines: *const Lines, i: usize, end: usize) usize {
+    var j = i + 1;
+    while (j < end and lines.items[j].indent > lines.items[i].indent) j += 1;
+    return j;
+}
+
+/// Lines start..end, one block at one column; the returned root when a `return` ends it (`top`: the def's own suite).
+pub fn exec(r: *Run, start: usize, end: usize, top: bool) Invalid!?usize {
+    if (start >= end) return error.Unsupported;
+    const column = r.lines.items[start].indent;
+    var i = start;
+    while (i < end) {
+        const line = r.lines.items[i];
+        if (line.indent != column) return error.Unsupported;
+        const next = blockEnd(r.lines, i, end);
+        const t = line.text;
+        if (r.divided) |d| if (d.line == i) {
+            try store(r, d.name, d.root);
+            i = next;
+            continue;
+        };
+        const compound = header(t) != null;
+        if (compound and (next == i + 1 or t[t.len - 1] != ':')) return error.Unsupported;
+        if (!compound and next != i + 1) return error.Unsupported; // an indented line under a simple statement
+        if (word(t, "for")) {
+            try forLoop(r, t["for".len .. t.len - 1], i + 1, next);
+        } else if (word(t, "while")) {
+            try whileLoop(r, t["while".len .. t.len - 1], i + 1, next);
+        } else if (word(t, "if")) {
+            if (!r.function or !top or r.pred != null) return error.Unsupported;
+            return try early(r, t["if".len .. t.len - 1], i + 1, next, end);
+        } else if (compound) {
+            return error.Unsupported; // elif, else, def, class, with, try
+        } else if (word(t, "return")) {
+            if (!r.function or !top or r.pred != null or next != end) return error.Unsupported;
+            return try value(r, t["return".len..]);
+        } else if (i == start and top and r.function and t.len >= 2 and (t[0] == '"' or t[0] == '\'') and t[t.len - 1] == t[0]) {
+            // a docstring
+        } else if (std.mem.eql(u8, t, "pass")) {} else if (word(t, "print")) {
+            const args = std.mem.trim(u8, t["print".len..], " \t");
+            if (args.len < 2 or args[0] != '(' or args[args.len - 1] != ')') return error.Unsupported;
+            const pr = r.printer orelse return error.Unsupported;
+            if (r.pred != null or r.check) return error.Unsupported;
+            try pr.print(pr.ctx, r.p, args[1 .. args.len - 1]);
+        } else try assignment(r, t);
+        i = next;
+    }
+    return null;
+}
+
+/// An expression's root: proved, or at the def syntax only.
+fn expression(r: *Run, text: []const u8) Invalid!usize {
+    const p = r.p;
+    p.source = std.mem.trim(u8, text, " \t");
+    p.pos = 0;
+    if (!r.check) return p.parse();
+    if (p.source.len == 0) return error.Unsupported;
+    const root = try p.expr(0);
+    p.space();
+    if (p.pos != p.source.len) return error.Unsupported;
+    return root;
+}
+
+/// A returned value: `A if C else B` chooses on the graph, else one int expression.
+fn value(r: *Run, text: []const u8) Invalid!usize {
+    const t = std.mem.trim(u8, text, " \t");
+    if (t.len == 0 or statements.separator(t, ',') != null) return error.Unsupported;
+    const at = list.top(t, "if", 0) orelse return expression(r, t);
+    const otherwise = list.top(t, "else", at + 2) orelse return error.Unsupported;
+    return choose(r, t[at + 2 .. otherwise], .{ .text = t[0..at] }, .{ .text = t[otherwise + 4 ..] });
+}
+
+const Branch = union(enum) { text: []const u8, rest: [2]usize };
+
+fn branch(r: *Run, b: Branch) Invalid!usize {
+    return switch (b) {
+        .text => |t| value(r, t),
+        .rest => |x| (try exec(r, x[0], x[1], true)) orelse error.Unsupported, // falling off the end returns None
+    };
+}
+
+/// `if C: return A` then the rest of the suite: A if C else (the rest).
+fn early(r: *Run, cond: []const u8, body: usize, body_end: usize, end: usize) Invalid!usize {
+    const ret = r.lines.items[body].text;
+    if (body_end != body + 1 or !word(ret, "return") or body_end == end) return error.Unsupported;
+    if (word(r.lines.items[body_end].text, "elif") or word(r.lines.items[body_end].text, "else")) return error.Unsupported;
+    return choose(r, cond, .{ .text = ret["return".len..] }, .{ .rest = .{ body_end, end } });
+}
+
+/// Bindings as they were: a branch's assignments never reach the other branch.
+pub const Saved = struct {
+    count: usize,
+    roots: [64]usize,
+    kinds: [64]bool,
+
+    pub fn take(p: *const Parser) Saved {
+        return .{ .count = p.binding_count, .roots = p.roots, .kinds = p.kinds };
+    }
+
+    pub fn put(s: *const Saved, p: *Parser) void {
+        p.binding_count = s.count;
+        p.roots = s.roots;
+        p.kinds = s.kinds;
+    }
+};
+
+/// c*A + (1-c)*B, both built: the branch C takes, then the other unless it needs recursion (the schedule's last level).
+fn choose(r: *Run, cond: []const u8, a: Branch, b: Branch) Invalid!usize {
+    const p = r.p;
+    const c = try expression(r, cond);
+    if (!p.boolean(c)) return error.Unsupported;
+    const saved = Saved.take(p);
+    if (r.check) {
+        _ = try branch(r, a);
+        saved.put(p);
+        _ = try branch(r, b);
+        saved.put(p);
+        return c;
+    }
+    const yes = p.nodes[c].value != 0;
+    const before = p.recursions;
+    const taken = try branch(r, if (yes) a else b);
+    const recursed = p.recursions != before;
+    saved.put(p);
+    const m = p.mark();
+    const was = .{ p.no_recurse, p.cut };
+    p.no_recurse, p.cut = .{ true, false };
+    const other: ?usize = branch(r, if (yes) b else a) catch null;
+    const cut = p.cut;
+    p.no_recurse, p.cut = was;
+    saved.put(p);
+    const o = other orelse {
+        // only a base case may stand alone: the other branch recursed past the schedule, and this one did not recurse
+        if (!cut or recursed) return error.Unsupported;
+        p.reset(m);
+        return taken;
+    };
+    if (p.boolean(taken) or p.boolean(o)) return error.Unsupported; // c*True is 1, not True
+    return blend(p, c, if (yes) taken else o, if (yes) o else taken);
+}
+
+/// c*a + (1-c)*b over a 0/1 node c.
+fn blend(p: *Parser, c: usize, a: usize, b: usize) Invalid!usize {
+    if (p.boolean(a) or p.boolean(b)) return error.Unsupported;
+    const off = try node(p, .sub, try literal(p, 1), c);
+    return node(p, .add, try node(p, .mul, c, a), try node(p, .mul, off, b));
+}
+
+pub fn node(p: *Parser, op: ast.Op, l: usize, rhs: usize) Invalid!usize {
+    const n = try p.add(.{ .op = op, .l = l, .r = rhs });
+    _ = try p.prove(n, n);
+    return n;
+}
+
+/// A constant of the lowering itself (a 0/1 offset, a digit's place, an iteration's index): schedule, not input.
+pub fn literal(p: *Parser, v: i512) Invalid!usize {
+    return p.add(.{ .op = .literal, .value = v, .text = "" });
+}
+
+/// `T op= E` or `T = E` on one int name; under a predicate the old value stays where the test is 0.
+fn assignment(r: *Run, t: []const u8) Invalid!void {
+    const p = r.p;
+    const eq = statements.separator(t, '=') orelse return error.Unsupported;
+    var name = std.mem.trim(u8, t[0..eq], " \t");
+    var op: ?ast.Op = null;
+    if (std.mem.endsWith(u8, name, "//")) {
+        op = .floor;
+        name = name[0 .. name.len - 2];
+    } else if (name.len != 0) {
+        op = switch (name[name.len - 1]) {
+            '+' => .add,
+            '-' => .sub,
+            '*' => .mul,
+            '%' => .mod,
+            else => null,
+        };
+        if (op != null) name = name[0 .. name.len - 1];
+    }
+    name = std.mem.trim(u8, name, " \t");
+    if (!@import("runner_frontend_integer_python.zig").validBinding(name)) return error.Unsupported;
+    const v = try expression(r, t[eq + 1 ..]);
+    if (r.check) return;
+    const old: ?usize = if (p.slot(name)) |s| (if (p.kinds[s] or p.roots[s] == ast.unbound) null else p.roots[s]) else null;
+    const new = if (op) |o| try update(p, r.pred, o, old orelse return error.Unsupported, v) else if (r.pred) |c|
+        try blend(p, c, v, old orelse return error.Unsupported) // a name first bound under a test may stay unbound
+    else
+        v;
+    try store(r, name, new);
+}
+
+/// old op v; under c: x + c*v, x - c*v, x*(1 + c*(v-1)), x*(v - c*(v-1)) // v (v a literal); `%=` refuses.
+fn update(p: *Parser, pred: ?usize, op: ast.Op, old: usize, v: usize) Invalid!usize {
+    const c = pred orelse return node(p, op, old, v);
+    const one = try literal(p, 1);
+    return switch (op) {
+        .add, .sub => node(p, op, old, try node(p, .mul, c, v)),
+        .mul => node(p, .mul, old, try node(p, .add, one, try node(p, .mul, c, try node(p, .sub, v, one)))),
+        .floor => blk: {
+            if (p.nodes[v].op != .literal or p.nodes[v].value == 0) return error.Unsupported;
+            const keep = try node(p, .sub, v, try node(p, .mul, c, try node(p, .sub, v, one)));
+            break :blk node(p, .floor, try node(p, .mul, old, keep), v);
+        },
+        else => error.Unsupported,
+    };
+}
+
+/// A def's locals in its frame; module names as the module binds them.
+pub fn store(r: *Run, name: []const u8, root: usize) Invalid!void {
+    const p = r.p;
+    if (!r.function) return p.bind(name, root);
+    const f = p.frame orelse return error.Unsupported;
+    var i = p.binding_count;
+    while (i > f.start) {
+        i -= 1;
+        if (std.mem.eql(u8, p.names[i], name)) {
+            p.roots[i] = root;
+            p.kinds[i] = false;
+            return;
+        }
+    }
+    return error.Unsupported; // prebind made every assigned name local
+}
+
+/// Every name a def's suite assigns is local for the whole body: read before it is assigned, Python raises.
+fn prebind(p: *Parser, lines: *const Lines) Invalid!void {
+    const f = p.frame orelse return error.Unsupported;
+    for (lines.items[0..lines.len]) |line| {
+        const name = assigns(line.text) orelse continue;
+        const known = for (p.names[f.start..p.binding_count]) |held| {
+            if (std.mem.eql(u8, held, name)) break true;
+        } else false;
+        if (known) continue;
+        if (p.binding_count == p.names.len) return error.Unsupported;
+        p.names[p.binding_count] = name;
+        p.roots[p.binding_count] = ast.unbound;
+        p.kinds[p.binding_count] = false;
+        p.binding_count += 1;
+    }
+}
+
+/// The name a line binds: a `for` target, or an assignment's (augmented or not).
+pub fn assigns(t: []const u8) ?[]const u8 {
+    if (word(t, "for")) {
+        const at = list.top(t, "in", 3) orelse return null;
+        return std.mem.trim(u8, t[3..at], " \t");
+    }
+    if (header(t) != null or word(t, "return")) return null;
+    const eq = statements.separator(t, '=') orelse return null;
+    return std.mem.trim(u8, std.mem.trimEnd(u8, std.mem.trim(u8, t[0..eq], " \t"), "+-*/%"), " \t");
+}
+
+/// `for T in range(...)` (predicated per trip) or over a literal list (its length is the script's text).
+fn forLoop(r: *Run, head: []const u8, body: usize, end: usize) Invalid!void {
+    const p = r.p;
+    const at = list.top(head, "in", 0) orelse return error.Unsupported;
+    const target = std.mem.trim(u8, head[0..at], " \t");
+    if (!@import("runner_frontend_integer_python.zig").validBinding(target)) return error.Unsupported;
+    const iter = std.mem.trim(u8, head[at + 2 ..], " \t");
+    if (std.mem.startsWith(u8, iter, "range(") and iter[iter.len - 1] == ')') return rangeLoop(r, target, iter[6 .. iter.len - 1], body, end);
+    p.source = iter;
+    p.pos = 0;
+    if (!r.check and !list.ahead(p)) return error.Unsupported;
+    const li = try list.whole(p, iter);
+    if (r.check) {
+        _ = try exec(r, body, end, false);
+        return;
+    }
+    const l = p.lists[li];
+    if (!l.literal) return error.Unsupported; // a range object, filter or sort: its length is a value's decision
+    var elems: [ast.max_items]usize = undefined;
+    @memcpy(elems[0..l.len], p.items[l.start..][0..l.len]);
+    for (elems[0..l.len]) |e| {
+        try store(r, target, e);
+        if (try exec(r, body, end, false) != null) return error.Unsupported;
+    }
+}
+
+/// range(stop) / range(start, stop[, step]): trip k runs where start + k*step is still short of stop.
+fn rangeLoop(r: *Run, target: []const u8, args_text: []const u8, body: usize, end: usize) Invalid!void {
+    const p = r.p;
+    var args: [3]usize = undefined;
+    var n: usize = 0;
+    var rest = args_text;
+    while (true) {
+        if (n == 3) return error.Unsupported;
+        const comma = statements.separator(rest, ',');
+        args[n] = try expression(r, rest[0 .. comma orelse rest.len]);
+        if (!r.check and p.boolean(args[n])) return error.Unsupported;
+        n += 1;
+        rest = rest[(comma orelse break) + 1 ..];
+    }
+    if (r.check) {
+        _ = try exec(r, body, end, false);
+        return;
+    }
+    const start: ?usize = if (n == 1) null else args[0];
+    const stop = if (n == 1) args[0] else args[1];
+    const step: ?usize = if (n == 3) args[2] else null;
+    const a: i512 = if (start) |s| p.nodes[s].value else 0;
+    const b = p.nodes[stop].value;
+    const s: i512 = if (step) |x| p.nodes[x].value else 1;
+    if (s == 0) return error.Unsupported; // ValueError
+    const span = if (s > 0) b - a else a - b;
+    const mag = if (s > 0) s else -s;
+    const trips: i512 = if (span <= 0) 0 else @divFloor(span + mag - 1, mag);
+    if (trips > max_trips) return error.Unsupported;
+    // headroom: the schedule's trips are a power of two past the script's own, so a larger input still runs exactly
+    const m = p.mark();
+    const saved = Saved.take(p);
+    const spare = schedule(@intCast(trips));
+    if (spare > trips) {
+        if (trip(r, target, .{ start, stop, step }, s > 0, spare, body, end)) |_| {
+            if (!heavy(p, null)) return unbind(r, target);
+        } else |_| {}
+        p.reset(m);
+        saved.put(p);
+    }
+    try trip(r, target, .{ start, stop, step }, s > 0, @intCast(trips), body, end);
+    try unbind(r, target); // after the loop its value is the last trip's, which a value decided
+}
+
+/// Whether a bound value outgrows headroom: its calc tree (shared nodes repeat) or the graph route's digit bound.
+pub fn heavy(p: *const Parser, extra: ?usize) bool {
+    var size: [ast.max_nodes]u32 = undefined;
+    var digits: [ast.max_nodes]u32 = undefined;
+    for (p.nodes[0..p.count], 0..) |n, i| {
+        const l: u32 = if (n.op == .literal) 0 else digits[n.l];
+        const r: u32 = if (n.op == .literal) 0 else digits[n.r];
+        size[i] = switch (n.op) {
+            .literal => 1,
+            .neg, .digits, .isqrt, .factorial, .digit_sum => 1 +| size[n.l],
+            else => 1 +| size[n.l] +| size[n.r] +| (if (n.op == .powmod or n.op == .range_product) size[n.k] else 0),
+        };
+        digits[i] = switch (n.op) {
+            .literal => @intCast(std.fmt.count("{d}", .{@abs(n.value)})),
+            .add, .sub => @max(l, r) + 1,
+            .mul => l +| r,
+            .floor => @min(l, @max(1, (l + 2) -| r)),
+            .mod => r,
+            .eq, .ne, .lt, .le, .gt, .ge => 5, // the table's sign trick: (d + M - 1) // M, and 1 - that
+            else => l,
+        };
+    }
+    for (p.roots[0..p.binding_count], p.kinds[0..p.binding_count]) |root, listed| {
+        if (listed or root == ast.unbound or root >= p.count) continue;
+        if (size[root] > 250 or digits[root] > 120) return true;
+    }
+    const x = extra orelse return false;
+    return size[x] > 250 or digits[x] > 120;
+}
+
+/// A power of two at least `n` (at least one trip), within the budget.
+pub fn schedule(n: usize) usize {
+    return @min(max_trips, std.math.ceilPowerOfTwo(usize, @max(n, 1)) catch max_trips);
+}
+
+/// `count` trips of a range loop's body, each gated by its index short of stop (`up`) or past it.
+fn trip(r: *Run, target: []const u8, bounds: [3]?usize, up: bool, count: usize, body: usize, end: usize) Invalid!void {
+    const p = r.p;
+    const start, const stop, const step = bounds;
+    for (0..count) |k| {
+        const kk = try literal(p, @intCast(k));
+        const index = if (start) |first| (if (k == 0) first else try node(p, .add, first, if (step) |x| try node(p, .mul, kk, x) else kk)) else kk;
+        const c = try node(p, if (up) .lt else .gt, index, stop.?);
+        var inner = r.*;
+        inner.pred = if (r.pred) |outer| try node(p, .mul, outer, c) else c;
+        try store(r, target, index);
+        if (try exec(&inner, body, end, false) != null) return error.Unsupported;
+    }
+}
+
+/// `while C:` unrolled while C is true here; trip k runs where every test so far is 1.
+fn whileLoop(r: *Run, cond: []const u8, body: usize, end: usize) Invalid!void {
+    const p = r.p;
+    if (r.check) {
+        _ = try expression(r, cond);
+        _ = try exec(r, body, end, false);
+        return;
+    }
+    if (try @import("runner_frontend_integer_digits.zig").whileDivides(r, cond, body, end)) return;
+    var active = r.pred;
+    var k: usize = 0;
+    while (true) : (k += 1) {
+        const c = try expression(r, cond);
+        if (!p.boolean(c)) return error.Unsupported;
+        if (p.nodes[c].value == 0) break;
+        if (k == max_trips) return error.Unsupported; // unbounded here, or past the budget
+        active = if (active) |x| try node(p, .mul, x, c) else c;
+        var inner = r.*;
+        inner.pred = active;
+        if (try exec(&inner, body, end, false) != null) return error.Unsupported;
+    }
+}
+
+fn unbind(r: *Run, name: []const u8) Invalid!void {
+    const s = r.p.slot(name) orelse return error.Unsupported;
+    r.p.roots[s] = ast.unbound;
+}
+
+test "suite lines: columns, same-line bodies and semicolons" {
+    const lines = try split("for i in range(3): s += i; t += 1\nwhile x:\n    x -= 1\n");
+    try std.testing.expectEqual(@as(usize, 5), lines.len);
+    try std.testing.expectEqualStrings("for i in range(3):", lines.items[0].text);
+    try std.testing.expectEqual(@as(usize, 1), lines.items[1].indent);
+    try std.testing.expectEqual(@as(usize, 1), lines.items[2].indent);
+    try std.testing.expectEqual(@as(usize, 4), lines.items[4].indent);
+}
