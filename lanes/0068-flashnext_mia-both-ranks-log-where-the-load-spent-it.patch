+/// Engine.init's stages, timed: both ranks print where their load spent its time (a slow start shows its stage).
+const Marks = struct {
+    io: std.Io,
+    last: std.Io.Timestamp,
+    names: [12][]const u8 = undefined,
+    secs: [12]f64 = undefined,
+    n: usize = 0,
+
+    fn mark(m: *Marks, name: []const u8) void {
+        const now = std.Io.Clock.awake.now(m.io);
+        if (m.n < m.names.len) {
+            m.names[m.n] = name;
+            m.secs[m.n] = @as(f64, @floatFromInt(now.toNanoseconds() - m.last.toNanoseconds())) / 1e9;
+            m.n += 1;
+        }
+        m.last = now;
+    }
+
+    fn text(m: *const Marks, buf: []u8) []const u8 {
+        var w: std.Io.Writer = .fixed(buf);
+        for (m.names[0..m.n], m.secs[0..m.n], 0..) |name, s, i| w.print("{s}{s} {d:.1}", .{ if (i > 0) ", " else "", name, s }) catch break;
+        return w.buffered();
+    }
+
+    fn log(m: *const Marks, rank: u32, total: f64) void {
+        var buf: [384]u8 = undefined;
+        std.log.info("rank {d}: loaded in {d:.1} s ({s} s)", .{ rank, total, m.text(&buf) });
+    }
+};
+
+test "load stages: each stage's time in order, after the one before" {
+    const io = std.testing.io;
+    var m: Marks = .{ .io = io, .last = std.Io.Clock.awake.now(io) };
+    m.mark("config");
+    m.mark("weights");
+    try std.testing.expectEqual(@as(usize, 2), m.n);
+    for (m.secs[0..m.n]) |s| try std.testing.expect(s >= 0 and s < 60);
+    var buf: [64]u8 = undefined;
+    const t = m.text(&buf);
+    try std.testing.expect(std.mem.startsWith(u8, t, "config 0.0, weights 0.0"));
+}
+
