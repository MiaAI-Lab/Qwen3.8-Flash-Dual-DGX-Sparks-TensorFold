diff --git a/zig/src/core/lanes/round_trace.zig b/zig/src/core/lanes/round_trace.zig
new file mode 100644
index 000000000..6859f0d3f
--- /dev/null
+++ b/zig/src/core/lanes/round_trace.zig
@@ -0,0 +1,226 @@
+//! Rounds around held streams (runner fires), one JSON line each: N before a hold, N after its resume; read-only.
+const std = @import("std");
+const Engine = @import("engine.zig").Engine;
+const Stream = @import("stream.zig").Stream;
+
+/// A backend's counters, read before and after each step; a record carries each one's change over its step.
+pub const Extras = struct { ctx: *anyopaque, names: []const []const u8, read: *const fn (ctx: *anyopaque, out: []u64) void };
+
+const max_extras = 16;
+const max_streams = 64;
+const max_ring = 64;
+
+const Kind = enum { forced, drafted, plain };
+
+/// What the trace last saw of a stream: its counters before the step, and where it stands around its fires.
+const Seen = struct {
+    s: ?*const Stream = null, // compared, never read: the engine frees a stream once it leaves `live`
+    rounds: u64 = 0,
+    drafted: u64 = 0,
+    accepted: u64 = 0,
+    emitted: usize = 0,
+    forced: bool = false,
+    awaiting: bool = false,
+    hold_ns: u64 = 0,
+    since: i64 = -1, // rounds since its last resume (-1: none yet)
+    post: u32 = 0, // rounds after the resume still to write
+};
+
+const Rec = struct {
+    step: u64,
+    t_ns: u64,
+    stream: u32,
+    since: i64,
+    kind: Kind,
+    drafted: u64,
+    kept: u64,
+    got: usize,
+    held_next: u32,
+    wall_ns: u64,
+    gap_ns: u64,
+    streams: usize,
+    x: [max_extras]u64,
+};
+
+var fd: c_int = -1;
+var around: u32 = 0;
+var extras: ?Extras = null;
+var seen: [max_streams]Seen = @splat(.{});
+var ring: [max_ring]Rec = undefined;
+var ring_len: usize = 0;
+var ring_at: usize = 0;
+var t_open: u64 = 0;
+var step_start: u64 = 0;
+var last_end: u64 = 0;
+var x_before: [max_extras]u64 = @splat(0);
+var buf: [4096]u8 = undefined;
+
+/// Writes to `out` (an open file descriptor): `rounds` rounds before each hold and after each resume (most 64).
+pub fn open(out: c_int, rounds: u32, x: ?Extras) void {
+    fd = out;
+    around = @min(rounds, max_ring);
+    extras = if (x) |v| if (v.names.len <= max_extras) v else null else null;
+    t_open = now();
+    last_end = t_open;
+    var w = std.Io.Writer.fixed(&buf);
+    w.print("{{\"rt\":\"open\",\"rounds\":{d},\"extras\":[", .{around}) catch return;
+    if (extras) |v| for (v.names, 0..) |n, i| w.print("{s}\"{s}\"", .{ if (i > 0) "," else "", n }) catch return;
+    w.writeAll("]}\n") catch return;
+    put(w.buffered());
+}
+
+/// Off on Windows at compile time: the trace writes through libc there is none of.
+pub inline fn on() bool {
+    return @import("builtin").os.tag != .windows and fd >= 0;
+}
+
+fn now() u64 {
+    var ts: std.c.timespec = undefined;
+    _ = std.c.clock_gettime(.MONOTONIC, &ts);
+    return @as(u64, @intCast(ts.sec)) * std.time.ns_per_s + @as(u64, @intCast(ts.nsec));
+}
+
+fn put(s: []const u8) void {
+    var at: usize = 0;
+    while (at < s.len) {
+        const n = std.c.write(fd, s[at..].ptr, s.len - at);
+        if (n <= 0) return;
+        at += @intCast(n);
+    }
+}
+
+fn readExtras(out: []u64) void {
+    if (extras) |v| v.read(v.ctx, out[0..v.names.len]);
+}
+
+fn live(e: *const Engine, p: *const Stream) bool {
+    for (e.live.items) |s| if (s == p) return true;
+    return false;
+}
+
+/// Frees entries of streams no longer live (pointers compared only): a new stream at a freed address starts fresh.
+fn forget(e: *const Engine) void {
+    for (&seen) |*x| if (x.s) |p| if (!live(e, p)) {
+        x.* = .{};
+    };
+}
+
+/// The live stream's entry (a new one takes an entry no live stream holds; null when all are taken).
+fn entry(e: *const Engine, s: *const Stream) ?*Seen {
+    var free: ?*Seen = null;
+    for (&seen) |*x| {
+        if (x.s == s) return x;
+        if (free == null and (x.s == null or !live(e, x.s.?))) free = x;
+    }
+    const x = free orelse return null;
+    x.* = .{ .s = s, .rounds = s.rounds, .drafted = s.drafted, .accepted = s.accepted, .emitted = s.emitted().len };
+    return x;
+}
+
+/// Before a step: the clock, the backend's counters, each live stream's; a stream resumed since its hold is noted.
+pub fn before(e: *const Engine) void {
+    step_start = now();
+    readExtras(&x_before);
+    forget(e);
+    for (e.live.items) |s| {
+        const x = entry(e, s) orelse continue;
+        if (x.awaiting and !s.awaiting) {
+            var w = std.Io.Writer.fixed(&buf);
+            w.print("{{\"rt\":\"resume\",\"stream\":{d},\"t_us\":{d},\"held_us\":{d},\"forced\":{d}}}\n", .{ index(x), us(step_start - t_open), us(step_start - x.hold_ns), s.force.items.len }) catch {};
+            put(w.buffered());
+            x.since = 0;
+            x.post = around;
+        }
+        x.awaiting = s.awaiting;
+        x.rounds = s.rounds;
+        x.drafted = s.drafted;
+        x.accepted = s.accepted;
+        x.emitted = s.emitted().len;
+        x.forced = s.force.items.len > 0;
+    }
+}
+
+/// After a step: each stream that ran a round, written when it is near a fire, else kept as the next fire's before.
+pub fn after(e: *const Engine) void {
+    const t = now();
+    var x_after: [max_extras]u64 = @splat(0);
+    readExtras(&x_after);
+    defer for (e.live.items) |s| {
+        // a finished stream leaves `live` in this step's sweep, then is freed: its entry goes now, while it is live
+        if (s.finished) if (find(s)) |x| {
+            x.* = .{};
+        };
+    };
+    for (e.live.items) |s| {
+        const x = entry(e, s) orelse continue;
+        if (s.rounds == x.rounds) continue;
+        if (x.since >= 0) x.since += 1;
+        var r: Rec = .{ .step = e.steps, .t_ns = t - t_open, .stream = index(x), .since = x.since, .kind = if (x.forced) .forced else if (s.drafted > x.drafted) .drafted else .plain, .drafted = s.drafted - x.drafted, .kept = s.accepted - x.accepted, .got = s.emitted().len - x.emitted, .held_next = if (s.next) |n| n.count else 0, .wall_ns = t - step_start, .gap_ns = step_start - last_end, .streams = e.live.items.len, .x = undefined };
+        for (&r.x, x_after, x_before) |*d, b, a| d.* = b -% a;
+        x.rounds = s.rounds;
+        if (s.awaiting and !x.awaiting) {
+            flush();
+            write(r, "trigger");
+            var w = std.Io.Writer.fixed(&buf);
+            w.print("{{\"rt\":\"hold\",\"stream\":{d},\"t_us\":{d}}}\n", .{ index(x), us(t - t_open) }) catch {};
+            put(w.buffered());
+            x.awaiting = true;
+            x.hold_ns = t;
+            x.post = 0;
+        } else if (x.post > 0) {
+            write(r, "post");
+            x.post -= 1;
+        } else push(r);
+    }
+    last_end = now();
+}
+
+fn find(s: *const Stream) ?*Seen {
+    for (&seen) |*x| if (x.s == s) return x;
+    return null;
+}
+
+/// Entries held (tests).
+pub fn held() usize {
+    var n: usize = 0;
+    for (seen) |x| n += @intFromBool(x.s != null);
+    return n;
+}
+
+fn index(x: *const Seen) u32 {
+    return @intCast((@intFromPtr(x) - @intFromPtr(&seen)) / @sizeOf(Seen));
+}
+
+fn us(ns: u64) u64 {
+    return ns / std.time.ns_per_us;
+}
+
+fn push(r: Rec) void {
+    if (around == 0) return;
+    ring[(ring_at + ring_len) % max_ring] = r;
+    if (ring_len < around) ring_len += 1 else ring_at = (ring_at + 1) % max_ring;
+}
+
+/// The rounds kept since the last write, as a hold's before.
+fn flush() void {
+    for (0..ring_len) |i| write(ring[(ring_at + i) % max_ring], "pre");
+    ring_len = 0;
+    ring_at = 0;
+}
+
+fn write(r: Rec, phase: []const u8) void {
+    var w = std.Io.Writer.fixed(&buf);
+    w.print("{{\"rt\":\"round\",\"phase\":\"{s}\",\"step\":{d},\"t_us\":{d},\"stream\":{d},\"since\":{d},\"kind\":\"{s}\",\"drafted\":{d},\"kept\":{d},\"got\":{d},\"held_next\":{d},\"wall_us\":{d},\"gap_us\":{d},\"streams\":{d}", .{ phase, r.step, us(r.t_ns), r.stream, r.since, @tagName(r.kind), r.drafted, r.kept, r.got, r.held_next, us(r.wall_ns), us(r.gap_ns), r.streams }) catch return;
+    if (extras) |v| for (v.names, r.x[0..v.names.len]) |n, d| w.print(",\"{s}\":{d}", .{ n, d }) catch return;
+    w.writeAll("}\n") catch return;
+    put(w.buffered());
+}
+
+/// Closes the trace (tests): the descriptor is the caller's.
+pub fn close() void {
+    fd = -1;
+    extras = null;
+    seen = @splat(.{});
+    ring_len = 0;
+    ring_at = 0;
+}
diff --git a/zig/src/core/lanes/round_trace_test.zig b/zig/src/core/lanes/round_trace_test.zig
new file mode 100644
index 000000000..74d69f69d
--- /dev/null
+++ b/zig/src/core/lanes/round_trace_test.zig
@@ -0,0 +1,93 @@
+//! The round trace beside streams that finish and are freed: it reads only live streams (a rank-0 fault seen in a smoke run).
+const std = @import("std");
+const Engine = @import("engine.zig").Engine;
+const sm = @import("stream.zig");
+const fake = @import("fake.zig");
+const shared = @import("engine_test.zig");
+const round_trace = @import("round_trace.zig");
+
+const gpa = std.testing.allocator;
+
+fn stepUntil(engine: *Engine, s: *const sm.Stream) !void {
+    var n: u32 = 0;
+    while (!s.finished and n < 200) : (n += 1) try engine.step();
+    try std.testing.expect(s.finished);
+}
+
+test "round trace: a traced stream finishes and is freed, then a new stream takes an entry; no freed stream is read" {
+    var fds: [2]c_int = undefined;
+    try std.testing.expectEqual(@as(c_int, 0), std.c.pipe(&fds));
+    defer _ = std.c.close(fds[0]);
+    defer _ = std.c.close(fds[1]);
+    var cfg = try shared.modelWith(true);
+    defer cfg.deinit(gpa);
+    var target: fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    var clock: fake.FixedClock = .{};
+    var engine = Engine.init(gpa, &cfg, target.backend(), clock.clock());
+    defer engine.deinit();
+    round_trace.open(fds[1], 4, null);
+    defer round_trace.close();
+    // a stream that outlives the others, so the trace keeps stepping beside the freed one
+    var long = try sm.Stream.init(gpa, .{ .id = "long", .prompt = &shared.p1, .max_new = 60 });
+    defer long.deinit(gpa);
+    try engine.addStream(&long);
+    // the first stream in a mapping of its own, unmapped once the engine is done with it: any read of it faults
+    const first = try std.heap.page_allocator.create(sm.Stream);
+    first.* = try sm.Stream.init(gpa, .{ .id = "first", .prompt = &shared.p1, .max_new = 6 });
+    try engine.addStream(first);
+    try engine.step();
+    try std.testing.expectEqual(@as(usize, 2), round_trace.held());
+    try stepUntil(&engine, first);
+    // the step that finished it swept it from live; its entry went in that step, while it was still live
+    try std.testing.expectEqual(@as(usize, 1), engine.live.items.len);
+    try std.testing.expectEqual(@as(usize, 1), round_trace.held());
+    first.deinit(gpa);
+    std.heap.page_allocator.destroy(first);
+    // a new stream looks for a free entry beside the long one: the first's memory is gone
+    var second = try sm.Stream.init(gpa, .{ .id = "second", .prompt = &shared.p1, .max_new = 6 });
+    defer second.deinit(gpa);
+    try engine.addStream(&second);
+    try engine.step();
+    try std.testing.expectEqual(@as(usize, 2), round_trace.held());
+    try stepUntil(&engine, &second);
+    try stepUntil(&engine, &long);
+    try std.testing.expectEqual(@as(usize, 0), engine.live.items.len);
+    try std.testing.expectEqual(@as(usize, 0), round_trace.held());
+}
+
+test "round trace: a stream released without finishing loses its entry at the next step (pointers compared only)" {
+    var fds: [2]c_int = undefined;
+    try std.testing.expectEqual(@as(c_int, 0), std.c.pipe(&fds));
+    defer _ = std.c.close(fds[0]);
+    defer _ = std.c.close(fds[1]);
+    var cfg = try shared.modelWith(true);
+    defer cfg.deinit(gpa);
+    var target: fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    var clock: fake.FixedClock = .{};
+    var engine = Engine.init(gpa, &cfg, target.backend(), clock.clock());
+    defer engine.deinit();
+    round_trace.open(fds[1], 4, null);
+    defer round_trace.close();
+    var long = try sm.Stream.init(gpa, .{ .id = "long", .prompt = &shared.p1, .max_new = 30 });
+    defer long.deinit(gpa);
+    try engine.addStream(&long);
+    const gone = try std.heap.page_allocator.create(sm.Stream);
+    gone.* = try sm.Stream.init(gpa, .{ .id = "gone", .prompt = &shared.p1, .max_new = 30 });
+    try engine.addStream(gone);
+    try engine.step();
+    try std.testing.expectEqual(@as(usize, 2), round_trace.held());
+    // taken out of live by its owner (a cancel's path) and freed while still unfinished
+    for (engine.live.items, 0..) |s, i| if (s == gone) {
+        _ = engine.live.orderedRemove(i);
+        break;
+    };
+    engine.release(gone);
+    gone.deinit(gpa);
+    std.heap.page_allocator.destroy(gone);
+    try engine.step();
+    try std.testing.expectEqual(@as(usize, 1), round_trace.held());
+    try stepUntil(&engine, &long);
+    try std.testing.expectEqual(@as(usize, 0), round_trace.held());
+}
diff --git a/zig/src/core/lanes/settle_fire_test.zig b/zig/src/core/lanes/settle_fire_test.zig
new file mode 100644
index 000000000..fe95c0f35
--- /dev/null
+++ b/zig/src/core/lanes/settle_fire_test.zig
@@ -0,0 +1,130 @@
+//! Runner fires settled at their trigger (RunnerHook.settled) on the fake target: a hold's tokens with no hold
+const std = @import("std");
+const Engine = @import("engine.zig").Engine;
+const sm = @import("stream.zig");
+const fake = @import("fake.zig");
+const hold = @import("hold.zig");
+const shared = @import("engine_test.zig");
+
+const gpa = std.testing.allocator;
+const fires = [_]usize{ 20, 47, 75 };
+const foreign = [_]u32{ 7, 8, 9 };
+
+/// A fire's result: the target's own next `echo` draws (one the drafts guess) or `foreign`'s tokens.
+const Owned = union(enum) { echo: usize, foreign };
+
+/// How a fire's result reaches the stream: settled at its trigger, or held and resumed after `ticks` host ticks.
+const Way = union(enum) { settled, held: u32 };
+
+/// Fires at the given emitted indices; `settled` answers at the trigger itself when the way is settled.
+const Hook = struct {
+    seen: usize = 0,
+    stream: *sm.Stream = undefined,
+    owned: Owned,
+    result: std.ArrayList(u32) = .empty,
+    at: ?usize = null, // a settled fire's emitted count at its trigger, until the round's end is seen
+
+    fn token(ptr: *anyopaque, _: u32, _: bool, can_hold: bool, _: bool) bool {
+        const h: *Hook = @ptrCast(@alignCast(ptr));
+        defer h.seen += 1;
+        return can_hold and std.mem.indexOfScalar(usize, &fires, h.seen) != null;
+    }
+
+    fn settled(ptr: *anyopaque) ?[]const u32 {
+        const h: *Hook = @ptrCast(@alignCast(ptr));
+        compute(h) catch return null;
+        h.at = h.stream.emitted().len;
+        return h.result.items;
+    }
+
+    /// The fire's result after everything the stream has (its trigger is in the context already).
+    fn compute(h: *Hook) !void {
+        h.result.clearRetainingCapacity();
+        switch (h.owned) {
+            .foreign => try h.result.appendSlice(gpa, &foreign),
+            .echo => |n| {
+                var history: std.ArrayList(u32) = .empty;
+                defer history.deinit(gpa);
+                try history.appendSlice(gpa, &shared.p1);
+                try history.appendSlice(gpa, h.stream.emitted());
+                for (0..n) |_| try history.append(gpa, fake.next(history.items, null, history.items.len));
+                try h.result.appendSlice(gpa, history.items[history.items.len - n ..]);
+            },
+        }
+    }
+};
+
+const Replay = struct { tokens: []u32, rounds: u64 = 0, holds: u64 = 0, paused: u64 = 0, cache_ok: bool = true, kept: u64 = 0 };
+
+fn replay(way: Way, owned: Owned) !Replay {
+    var cfg = try shared.modelWith(true);
+    defer cfg.deinit(gpa);
+    cfg.forced_drafts = true;
+    var target: fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    var clock: fake.FixedClock = .{};
+    var engine = Engine.init(gpa, &cfg, target.backend(), clock.clock());
+    defer engine.deinit();
+    var hook: Hook = .{ .owned = owned };
+    defer hook.result.deinit(gpa);
+    const settles = way == .settled;
+    var s = try sm.Stream.init(gpa, .{ .id = "s", .prompt = &shared.p1, .max_new = 100, .drafts = true, .runner = .{ .ptr = &hook, .token = Hook.token, .settled = if (settles) Hook.settled else null } });
+    defer s.deinit(gpa);
+    hook.stream = &s;
+    try engine.addStream(&s);
+    var r: Replay = .{ .tokens = &.{} };
+    var waited: u32 = 0;
+    const ticks: u32 = switch (way) {
+        .held => |n| n,
+        .settled => 1,
+    };
+    while (!s.finished and r.rounds < 400) {
+        if (s.awaiting) {
+            // a host tick: the last one of `ticks` resumes it, before the next round is planned
+            waited += 1;
+            if (waited >= ticks) {
+                try hook.compute();
+                try std.testing.expect(try hold.resumeAwaiting(&s, gpa, hook.result.items));
+                waited = 0;
+            } else r.paused += 1;
+        }
+        try engine.step();
+        r.rounds += 1;
+        // the result tokens a settled fire's own round kept (accepted past the trigger and the result's own)
+        if (hook.at) |at| r.kept += @min(s.emitted().len - at, hook.result.items.len);
+        hook.at = null;
+        if (s.awaiting) r.holds += 1;
+        // a hold or a settled cut: every kept token is in the target's cache but the pending one, none past it
+        if (s.awaiting or s.settle == .cut) {
+            const cached = target.lanes.getPtr(&s).?.history.items.len;
+            r.cache_ok = r.cache_ok and cached == shared.p1.len + s.emitted().len - 1;
+        }
+    }
+    try std.testing.expect(s.finished);
+    r.tokens = try gpa.dupe(u32, s.emitted());
+    return r;
+}
+
+test "settled fires: the same tokens as a hold, no hold, and the trigger round keeps the drafted result" {
+    for ([_]Owned{ .{ .echo = 2 }, .{ .echo = 4 }, .foreign }) |owned| {
+        const two = try replay(.{ .held = 2 }, owned);
+        defer gpa.free(two.tokens);
+        const one = try replay(.{ .held = 1 }, owned);
+        defer gpa.free(one.tokens);
+        const now = try replay(.settled, owned);
+        defer gpa.free(now.tokens);
+        std.debug.print("settled fires ({any}): rounds held 2 ticks {d}, 1 tick {d}, settled {d} (kept {d})\n", .{ owned, two.rounds, one.rounds, now.rounds, now.kept });
+        try std.testing.expectEqualSlices(u32, two.tokens, one.tokens);
+        try std.testing.expectEqualSlices(u32, one.tokens, now.tokens);
+        // a hold (the negative control) waits at every fire; a settled fire never holds
+        try std.testing.expectEqual(@as(u64, fires.len), one.holds);
+        try std.testing.expectEqual(@as(u64, 0), now.holds);
+        // two ticks pause the stream one round a fire; one tick none
+        try std.testing.expectEqual(@as(u64, fires.len), two.paused);
+        try std.testing.expectEqual(@as(u64, 0), one.paused);
+        try std.testing.expect(now.cache_ok and one.cache_ok and two.cache_ok);
+        try std.testing.expect(one.rounds < two.rounds);
+        // the fake's misses hash the draft position, so other rounds move with the cuts: only kept tokens are exact
+        if (owned == .echo) try std.testing.expect(now.kept > 0) else try std.testing.expectEqual(@as(u64, 0), now.kept);
+    }
+}
diff --git a/zig/src/core/lanes/windows.zig b/zig/src/core/lanes/windows.zig
index 47c9c82f5..a4452b3f3 100644
--- a/zig/src/core/lanes/windows.zig
+++ b/zig/src/core/lanes/windows.zig
@@ -73,6 +73,7 @@ pub fn plan(e: *Engine, s: *Stream, copied: ?Copy) !Plan {
         p.kind = .forced;
         p.forced = forced;
