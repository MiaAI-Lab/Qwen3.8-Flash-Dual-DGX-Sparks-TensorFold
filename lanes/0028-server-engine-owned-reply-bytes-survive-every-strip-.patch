diff --git a/zig/src/server/reply_owned.zig b/zig/src/server/reply_owned.zig
new file mode 100644
index 000000000..d1d50e554
--- /dev/null
+++ b/zig/src/server/reply_owned.zig
@@ -0,0 +1,119 @@
+//! Engine-owned bytes in a reply's content, which no strip may cut; strip points are the format's call openers.
+const std = @import("std");
+const json = @import("json");
+const reply_text = @import("reply_text.zig");
+const tool_parse = @import("tool_parse.zig");
+const Openers = reply_text.Openers;
+const Allocator = std.mem.Allocator;
+
+/// Owned bytes of a reply's text: [lo, hi) from the first owned byte to the last, before any call block.
+pub const Owned = struct {
+    lo: usize,
+    hi: usize,
+
+    pub fn join(x: ?Owned, y: ?Owned) ?Owned {
+        const p = x orelse return y;
+        const q = y orelse return p;
+        return .{ .lo = @min(p.lo, q.lo), .hi = @max(p.hi, q.hi) };
+    }
+
+    pub fn shift(x: ?Owned, by: usize) ?Owned {
+        const o = x orelse return null;
+        return .{ .lo = o.lo + by, .hi = o.hi + by };
+    }
+};
+
+/// Where `text`'s first call block starts, as the stream's openers `o` or the final parser reads it; null: none.
+pub fn callStart(a: Allocator, text: []const u8, o: Openers) Allocator.Error!?usize {
+    var first = try tool_parse.firstEnvelope(a, text);
+    for (o.calls, 0..) |c, which| {
+        var pos: usize = 0;
+        while (reply_text.findTag(text, pos, c[0])) |at| {
+            if (first != null and at >= first.?) break;
+            pos = at + c[0].len;
+            if (reply_text.payloadOf(text[pos..], o, which, true) == .call) {
+                first = at;
+                break;
+            }
+        }
+    }
+    return first;
+}
+
+/// The owned span of `content` (in `raw`, `pieces` its tokens' bytes) before its first call block: `records`' writes.
+pub fn of(a: Allocator, records: []const []const u8, base: usize, pieces: []const []const u8, raw: []const u8, content: []const u8, o: Openers) Allocator.Error!?Owned {
+    if (records.len == 0) return null; // each a cell write: {"field":"content","token":T,"landed":N}
+    const from = @intFromPtr(content.ptr) -% @intFromPtr(raw.ptr); // past raw.len: content is not raw's bytes
+    // each token's first byte in `raw`, which the token bytes must spell exactly (a lossy decode is no map)
+    const at = try a.alloc(usize, pieces.len + 1);
+    at[0] = 0;
+    for (pieces, 0..) |p, i| {
+        at[i + 1] = at[i] + p.len;
+        if (at[i + 1] > raw.len or !std.mem.eql(u8, raw[at[i]..at[i + 1]], p)) return null;
+    }
+    if (at[pieces.len] != raw.len) return null;
+    const limit = (try callStart(a, content, o)) orelse content.len;
+    var span: ?Owned = null;
+    for (records) |text| {
+        const r = switch (try json.parse(a, text)) {
+            .ok => |v| v,
+            .err => continue,
+        };
+        if (!std.mem.eql(u8, r.strField("field") orelse "", "content")) continue;
+        const token = std.math.cast(usize, (r.get("token") orelse continue).int64() orelse continue) orelse continue;
+        const landed = std.math.cast(usize, (r.get("landed") orelse continue).int64() orelse continue) orelse continue;
+        if (token < base or token - base >= pieces.len) continue; // another segment's write
+        const lo = at[token - base];
+        const hi = at[@min(token - base + landed, pieces.len)];
+        if (lo < from or hi - from > limit or hi == lo) continue; // outside the content, in or past a call, or no bytes
+        span = Owned.join(span, .{ .lo = lo - from, .hi = hi - from });
+    }
+    return span;
+}
+
+/// ``pyRstrip(s).len``, never below an owned byte (the engine's, so its span stays in the text the client gets).
+fn keptEnd(s: []const u8, owned: ?Owned) usize {
+    const o = owned orelse return reply_text.pyRstrip(s).len;
+    if (o.hi > s.len) return reply_text.pyRstrip(s).len; // a span past `s`: not its offsets
+    return @max(reply_text.pyRstrip(s).len, aligned(s, o).hi);
+}
+
+/// `o` widened to whole code points of `s`, so a trim never splits one (the bytes it adds are kept, not owned).
+fn aligned(s: []const u8, o: Owned) Owned {
+    var lo = o.lo;
+    var hi = o.hi;
+    while (lo > 0 and lo < s.len and s[lo] & 0xc0 == 0x80) lo -= 1;
+    while (hi < s.len and s[hi] & 0xc0 == 0x80) hi += 1;
+    return .{ .lo = lo, .hi = hi };
+}
+
+/// ``pyStrip(s)`` with the engine's owned bytes kept: `owned` is in `s`'s offsets (Owned.shift moves it).
+pub fn strip(s: []const u8, owned: ?Owned) []const u8 {
+    const o = owned orelse return reply_text.pyStrip(s);
+    if (o.hi > s.len) return reply_text.pyStrip(s);
+    const lead = s.len - reply_text.pyLstrip(s).len;
+    return s[@min(lead, aligned(s, o).lo)..keptEnd(s, o)];
+}
+
+/// ``pyRstrip(s)`` with the engine's owned bytes kept.
+pub fn rstrip(s: []const u8, owned: ?Owned) []const u8 {
+    return s[0..keptEnd(s, owned)];
+}
+
+/// ``reply_text.finishedProse`` that keeps the owned bytes, its strip points the openers `o` (none owned: as before).
+pub fn finishedProse(a: Allocator, text: []const u8, o: Openers, owned: ?Owned) Allocator.Error![]const u8 {
+    if (owned == null) return reply_text.finishedProse(a, text);
+    // final parsing has not yet decided whether to strip the reply's content
+    if (reply_text.pyLstrip(text).len != text.len) return text[0..0];
+    var out: std.ArrayList(u8) = .empty;
+    const prose = try reply_text.hideInto(a, &out, text, true, true, o);
+    return if (prose.len != text.len) prose[0..keptEnd(prose, owned)] else prose;
+}
+
+/// ``reply_text.cutProse`` that keeps the owned bytes, its strip points the openers `o` (none owned: as before).
+pub fn cutProse(a: Allocator, text: []const u8, o: Openers, owned: ?Owned) Allocator.Error![]const u8 {
+    if (owned == null) return reply_text.cutProse(a, text);
+    var out: std.ArrayList(u8) = .empty;
+    const prose = try reply_text.hideInto(a, &out, text, false, false, o);
+    return if (prose.len != text.len) prose[0..keptEnd(prose, owned)] else prose;
+}
diff --git a/zig/src/server/reply_owned_test.zig b/zig/src/server/reply_owned_test.zig
new file mode 100644
index 000000000..0d257df35
--- /dev/null
+++ b/zig/src/server/reply_owned_test.zig
@@ -0,0 +1,103 @@
+//! Owned bytes through each call format's strip points: Qwen's JSON and XML calls (Flash-Next) and DSML (DSV41).
+const std = @import("std");
+const json = @import("json");
+const reply_text = @import("reply_text.zig");
+const reply_owned = @import("reply_owned.zig");
+const tool_parse = @import("tool_parse.zig");
+const tool_stream = @import("tool_stream.zig");
+const Owned = reply_owned.Owned;
+const t = std.testing;
+
+const prose = "The value is 2^66 = 73786976294838206464 \n";
+const answer = "73786976294838206464 "; // the cell's write, its trailing blank the engine's too
+const qwen_json = "<tool_call>\n{\"name\": \"f\", \"arguments\": {\"x\": \"1\"}}\n</tool_call>";
+const qwen_xml = "<tool_call>\n<function=f>\n<parameter=x>\n1\n</parameter>\n</function>\n</tool_call>";
+const dsml = "<\u{ff5c}DSML\u{ff5c}tool_calls>\n<\u{ff5c}DSML\u{ff5c}invoke name=\"f\">\n<\u{ff5c}DSML\u{ff5c}parameter name=\"x\" " ++
+    "string=\"true\">1</\u{ff5c}DSML\u{ff5c}parameter>\n</\u{ff5c}DSML\u{ff5c}invoke>\n</\u{ff5c}DSML\u{ff5c}tool_calls>";
+const formats = [_][]const u8{ qwen_json, qwen_xml, dsml };
+const tools_json =
+    \\[{"type":"function","function":{"name":"f","parameters":{"type":"object","properties":{"x":{"type":"string"}}}}}]
+;
+
+fn span() Owned {
+    const lo = std.mem.indexOf(u8, prose, answer).?;
+    return .{ .lo = lo, .hi = lo + answer.len };
+}
+
+test "reply owned: every call format strips its prose up to the owned bytes, never into them" {
+    var arena: std.heap.ArenaAllocator = .init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const o = reply_text.shared_openers;
+    const kept = prose[0..span().hi];
+    inline for (formats) |call| {
+        const text = prose ++ call;
+        try t.expectEqual(@as(?usize, prose.len), try reply_owned.callStart(a, text, o));
+        try t.expectEqualStrings(kept, try reply_owned.finishedProse(a, text, o, span()));
+        try t.expectEqualStrings(kept, try reply_owned.cutProse(a, text[0 .. text.len - 5], o, span()));
+        // nothing owned: the strips as before, the trailing blank gone
+        try t.expectEqualStrings(try reply_text.finishedProse(a, text), try reply_owned.finishedProse(a, text, o, null));
+        try t.expectEqualStrings(try reply_text.cutProse(a, text), try reply_owned.cutProse(a, text, o, null));
+        try t.expectEqualStrings(kept[0 .. kept.len - 1], try reply_owned.finishedProse(a, text, o, null));
+        const tools = (try json.parse(a, tools_json)).ok.array;
+        const end = try tool_stream.endProseOwned(a, text, text, tools, "stop", true, o, span());
+        try t.expectEqualStrings(kept, end);
+        try t.expectEqualStrings(try tool_stream.endProse(a, text, text, tools, "stop", false), try tool_stream.endProseOwned(a, text, text, tools, "stop", false, o, null));
+    }
+}
+
+test "reply owned: the parser keeps owned bytes and gives them in the content's offsets, for each format" {
+    var arena: std.heap.ArenaAllocator = .init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const tools = (try json.parse(a, tools_json)).ok.array;
+    inline for (formats) |call| {
+        const text = "  " ++ prose ++ call;
+        const owned = Owned.shift(span(), 2);
+        const p = try tool_parse.parseOwned(a, text, tools, null, owned);
+        try t.expectEqual(@as(usize, 1), p.calls.?.len);
+        try t.expectEqualStrings(prose[0..span().hi], p.content);
+        try t.expectEqual(span(), p.owned.?);
+        const plain = try tool_parse.parse(a, text, tools, null);
+        try t.expectEqualStrings(std.mem.trimEnd(u8, prose, " \n"), plain.content);
+        try t.expectEqual(null, plain.owned);
+    }
+}
+
+test "reply owned: a strip never splits a code point; a span past the text is not its offsets" {
+    // the span ends inside U+3000 (a blank): the trim keeps the whole code point, not its first byte
+    try t.expectEqualStrings("ab\u{3000}", reply_owned.strip("ab\u{3000}", .{ .lo = 0, .hi = 3 }));
+    try t.expectEqualStrings("ab", reply_owned.strip("ab\u{3000}", null));
+    try t.expectEqualStrings(" ab", reply_owned.strip("  ab", .{ .lo = 1, .hi = 4 })); // an owned leading blank
+    try t.expectEqualStrings("ab", reply_owned.strip("ab  ", .{ .lo = 0, .hi = 40 }));
+    try t.expectEqual(Owned{ .lo = 1, .hi = 9 }, Owned.join(.{ .lo = 4, .hi = 9 }, .{ .lo = 1, .hi = 2 }).?);
+    try t.expectEqual(null, Owned.shift(null, 3));
+}
+
+fn record(a: std.mem.Allocator, field: []const u8, token: usize, landed: usize) ![]const u8 {
+    return std.fmt.allocPrint(a, "{{\"cell\":0,\"field\":\"{s}\",\"token\":{d},\"landed\":{d}}}", .{ field, token, landed });
+}
+
+test "reply owned: a cell write's tokens become its bytes in the content, before the format's first call" {
+    var arena: std.heap.ArenaAllocator = .init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const o = reply_text.shared_openers;
+    inline for (formats) |call| {
+        const pieces = [_][]const u8{ "plan", "</think>", "[2^66 = ", "73786976294838206464]", "\n", call };
+        const raw = try std.mem.concat(a, u8, &pieces);
+        const content = raw["plan</think>".len..];
+        const write = try record(a, "content", 7, 3);
+        try t.expectEqual(Owned{ .lo = 0, .hi = 30 }, (try reply_owned.of(a, &.{write}, 5, &pieces, raw, content, o)).?);
+        // another segment's write (base past it), a reasoning write, an empty one, one past the tokens: none
+        try t.expectEqual(null, try reply_owned.of(a, &.{write}, 8, &pieces, raw, content, o));
+        try t.expectEqual(null, try reply_owned.of(a, &.{try record(a, "reasoning", 7, 3)}, 5, &pieces, raw, content, o));
+        try t.expectEqual(null, try reply_owned.of(a, &.{try record(a, "content", 7, 0)}, 5, &pieces, raw, content, o));
+        try t.expectEqual(null, try reply_owned.of(a, &.{try record(a, "content", 12, 1)}, 5, &pieces, raw, content, o));
+        // a write in the call block owns nothing the prose keeps
+        try t.expectEqual(null, try reply_owned.of(a, &.{try record(a, "content", 10, 1)}, 5, &pieces, raw, content, o));
+        // content the server rewrote (not raw's bytes) owns nothing: offsets would not be its own
+        const copy = try a.dupe(u8, content);
+        try t.expectEqual(null, try reply_owned.of(a, &.{write}, 5, &pieces, raw, copy, o));
+    }
+}
