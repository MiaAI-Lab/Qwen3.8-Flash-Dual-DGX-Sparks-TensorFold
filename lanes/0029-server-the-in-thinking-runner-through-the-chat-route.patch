diff --git a/zig/src/server/runner_commit_ask.zig b/zig/src/server/runner_commit_ask.zig
new file mode 100644
index 000000000..2ff908b07
--- /dev/null
+++ b/zig/src/server/runner_commit_ask.zig
@@ -0,0 +1,104 @@
+//! PREFIX_COMMIT's request settings (Request.run_commit): the think close, the task's text and the end token.
+const std = @import("std");
+const json = @import("json");
+const Value = json.Value;
+const api = @import("engine_api");
+const turns = @import("compute_turns.zig");
+const Allocator = std.mem.Allocator;
+
+/// A request's answer-commit settings; empty (it never fires) without the knob, a think close or an EOS.
+pub fn of(a: Allocator, runner: ?*api.runner.Runner, close: []const u32, msgs: Value, tools: []const Value, r: *const api.Request) Allocator.Error!@TypeOf(r.run_commit) {
+    const rn = runner orelse return .{};
+    if (!rn.cfg.commit or !r.run_cells or close.len == 0 or r.eos.len == 0 or r.structure != null) return .{};
+    return .{ .close = close, .task = try lastUser(a, msgs), .eos = r.eos[0], .max_new = r.max_tokens, .answer_max = r.answer_max, .tools = client(tools) };
+}
+
+/// A tool the client runs (not the lane's built-in, whose hold at the commit's EOS finds no call and ends the reply).
+fn client(tools: []const Value) bool {
+    for (tools) |t| if (!turns.isBuiltIn(t)) return true;
+    return false;
+}
+
+/// The last user message's text: its content string, or its text parts joined ("": none).
+fn lastUser(a: Allocator, msgs: Value) Allocator.Error![]const u8 {
+    if (msgs != .array) return "";
+    var i = msgs.array.len;
+    const m = while (i > 0) {
+        i -= 1;
+        const role = msgs.array[i].get("role") orelse continue;
+        if (role == .string and std.mem.eql(u8, role.string, "user")) break msgs.array[i];
+    } else return "";
+    const c = m.get("content") orelse return "";
+    if (c == .string) return c.string;
+    if (c != .array) return "";
+    var buf: std.ArrayList(u8) = .empty;
+    for (c.array) |part| {
+        if (part != .object) continue;
+        const kind = part.get("type") orelse continue;
+        if (kind != .string or !std.mem.eql(u8, kind.string, "text")) continue;
+        const t = part.get("text") orelse continue;
+        if (t == .string) try buf.appendSlice(a, t.string);
+    }
+    return buf.items;
+}
+
+test "runner commit ask: the knob, the last user message's text and the settings that keep it off" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const first = try json.newObject(a);
+    try first.put(a, "role", .{ .string = "user" });
+    try first.put(a, "content", .{ .string = "What is 1 + 2?" });
+    const reply = try json.newObject(a);
+    try reply.put(a, "role", .{ .string = "assistant" });
+    try reply.put(a, "content", .{ .string = "3" });
+    const part = try json.newObject(a);
+    try part.put(a, "type", .{ .string = "text" });
+    try part.put(a, "text", .{ .string = "What is 47 * 83?" });
+    var parts = [_]Value{.{ .object = part }};
+    const last = try json.newObject(a);
+    try last.put(a, "role", .{ .string = "user" });
+    try last.put(a, "content", .{ .array = &parts });
+    var chat = [_]Value{ .{ .object = first }, .{ .object = reply }, .{ .object = last } };
+    try std.testing.expectEqualStrings("What is 47 * 83?", try lastUser(a, .{ .array = &chat }));
+    try std.testing.expectEqualStrings("What is 1 + 2?", try lastUser(a, .{ .array = chat[0..2] }));
+    try std.testing.expectEqualStrings("", try lastUser(a, .{ .array = chat[1..2] }));
+    var rn: api.runner.Runner = undefined;
+    rn.cfg = .{ .commit = true };
+    const close = [_]u32{ 10, 11, 12 };
+    const eos = [_]u32{7};
+    var r: api.Request = .{ .prompt = &.{}, .max_tokens = 100, .eos = &eos, .run_cells = true };
+    const on = try of(a, &rn, &close, .{ .array = &chat }, &.{}, &r);
+    try std.testing.expectEqualSlices(u32, &close, on.close);
+    try std.testing.expectEqual(@as(?u32, 7), on.eos);
+    try std.testing.expectEqual(@as(u32, 100), on.max_new);
+    try std.testing.expectEqualStrings("What is 47 * 83?", on.task);
+    const fun = try json.newObject(a);
+    try fun.put(a, "name", .{ .string = turns.name });
+    try fun.put(a, "description", .{ .string = turns.description });
+    const builtin = try json.newObject(a);
+    try builtin.put(a, "function", .{ .object = fun });
+    const theirs = try json.newObject(a);
+    try theirs.put(a, "name", .{ .string = turns.name }); // their own `python`: another description
+    const function = try json.newObject(a);
+    try function.put(a, "function", .{ .object = theirs });
+    var only = [_]Value{.{ .object = builtin }};
+    var both = [_]Value{ .{ .object = builtin }, .{ .object = function } };
+    // the built-in tool and its lane's hold keep it on; a client's tool turns it off
+    r.hold_eos = true;
+    const lane = try of(a, &rn, &close, .{ .array = &chat }, &only, &r);
+    try std.testing.expect(lane.close.len > 0 and !lane.tools);
+    try std.testing.expect((try of(a, &rn, &close, .{ .array = &chat }, &both, &r)).tools);
+    r.hold_eos = false;
+    // each of these leaves it empty: it never fires
+    try std.testing.expectEqual(@as(usize, 0), (try of(a, null, &close, .{ .array = &chat }, &.{}, &r)).close.len);
+    try std.testing.expectEqual(@as(usize, 0), (try of(a, &rn, &.{}, .{ .array = &chat }, &.{}, &r)).close.len);
+    r.eos = &.{};
+    try std.testing.expectEqual(@as(usize, 0), (try of(a, &rn, &close, .{ .array = &chat }, &.{}, &r)).close.len);
+    r.eos = &eos;
+    r.run_cells = false;
+    try std.testing.expectEqual(@as(usize, 0), (try of(a, &rn, &close, .{ .array = &chat }, &.{}, &r)).close.len);
+    r.run_cells = true;
+    rn.cfg.commit = false;
+    try std.testing.expectEqual(@as(usize, 0), (try of(a, &rn, &close, .{ .array = &chat }, &.{}, &r)).close.len);
+}
diff --git a/zig/src/server/runner_guide.zig b/zig/src/server/runner_guide.zig
new file mode 100644
index 000000000..17aafc234
--- /dev/null
+++ b/zig/src/server/runner_guide.zig
@@ -0,0 +1,273 @@
+//! PREFIX_GUIDE: RUNNER-GUIDE.md (T5) in a chat's system message, so the model asks for exact results early.
+const std = @import("std");
+const json = @import("json");
+const Value = json.Value;
+const TraceAsk = @import("engine_api").runner.TraceAsk;
+const validTraceFormat = @import("engine_api").runner.validTraceFormat;
+const maxTraceRepeat = @import("engine_api").runner.maxTraceRepeat;
+
+/// RUNNER-GUIDE.md without its final newline (76 tokens on DeepSeek V4.1).
+pub const text = "Exact computation is available. Write the full expression inline as `<expr> =`, or a Python fenced cell with `print(<expr>)` followed by a `Result:` header. The exact value will follow. Request the whole computation early; wait for the result instead of working digits, loops, carries or long division by hand. Unsupported requests leave your own continuation.";
+
+/// The trust guide AB3's tool-full arm sent as each request's "runner_guide" (512 bytes); the compute default's guide.
+pub const trust = "Think and compute in small chunks. As soon as a sub-computation is needed, write its complete expression as `<expr> =` and continue from the returned value. Do not finish a manual trace before requesting it. For a short integer program, use a Python fenced cell with print, then `Result:`. Unsupported cells leave your continuation. Verify the setup, program semantics and non-computational reasoning. Engine values after `=` or `Result:` are computed exactly; use as given; do not re-derive or re-check by hand.";
+
+/// The most a request's own "runner_guide" may hold.
+pub const max_request = 512;
+
+/// The server's default guide, read once at boot from PREFIX_GUIDE: "1" is `text`, any other value a file.
+pub const Set = struct {
+    default: []const u8 = "", // "": chats get no guide unless they ask
+    max_request_bytes: usize = max_request,
+
+    pub fn load(a: std.mem.Allocator, io: std.Io, knob: []const u8) !Set {
+        if (knob.len == 0) return .{};
+        if (std.mem.eql(u8, knob, "1")) return .{ .default = text };
+        const bytes = try std.Io.Dir.cwd().readFileAlloc(io, knob, a, .limited(64 << 10));
+        return .{ .default = trim(bytes) };
+    }
+
+    pub fn refusal(s: Set, a: std.mem.Allocator) std.mem.Allocator.Error![]const u8 {
+        return std.fmt.allocPrint(a, "runner_guide must be a string of at most {d} bytes", .{s.max_request_bytes});
+    }
+
+    pub fn describe(s: Set) void {
+        @import("log.zig").line("runner guide: default {d} bytes, request limit {d} bytes", .{ s.default.len, s.max_request_bytes });
+    }
+};
+
+/// Trailing whitespace off, so a file's final newline and a request's text read alike.
+fn trim(t: []const u8) []const u8 {
+    return std.mem.trimEnd(u8, t, " \t\r\n");
+}
+
+pub const Applied = struct {
+    messages: Value,
+    guide: ?[]const u8, // the text injected ("" none); null when the runner is off
+};
+
+/// `messages` with `asked` (a request's guide) or the default; "" adds nothing, nor does a null `set` (runner off).
+pub fn apply(a: std.mem.Allocator, set: ?*const Set, asked: ?Value, messages: Value) error{ BadGuide, OutOfMemory }!Applied {
+    const s = set orelse return .{ .messages = messages, .guide = null };
+    const chosen = if (asked) |v| switch (v) {
+        .null => s.default,
+        .string => |t| if (t.len <= s.max_request_bytes) trim(t) else return error.BadGuide,
+        else => return error.BadGuide,
+    } else s.default;
+    return .{ .messages = if (chosen.len > 0) try with(a, messages, chosen) else messages, .guide = chosen };
+}
+
+/// `messages` with `guide` after the first system message's text, or in a new system message before the rest.
+pub fn with(a: std.mem.Allocator, messages: Value, guide: []const u8) std.mem.Allocator.Error!Value {
+    if (messages != .array) return messages;
+    const out = try a.alloc(Value, messages.array.len + 1);
+    if (messages.array.len > 0) if (messages.array[0].strField("role")) |role| if (std.mem.eql(u8, role, "system")) {
+        if (messages.array[0].get("content")) |content| if (content == .string) {
+            const m = try json.newObject(a);
+            var it = messages.array[0].object.iterator();
+            while (it.next()) |e| try m.put(a, e.key_ptr.*, e.value_ptr.*);
+            try m.put(a, "content", .{ .string = try std.mem.concat(a, u8, &.{ content.string, "\n\n", guide }) });
+            out[0] = .{ .object = m };
+            @memcpy(out[1..messages.array.len], messages.array[1..]);
+            return .{ .array = out[0..messages.array.len] };
+        };
+    };
+    const m = try json.newObject(a);
+    try m.put(a, "role", .{ .string = "system" });
+    try m.put(a, "content", .{ .string = guide });
+    out[0] = .{ .object = m };
+    @memcpy(out[1..], messages.array);
+    return .{ .array = out };
+}
+
+/// A chat's "runner_trace" (false: none) and "runner_trace_format", "_check", "_repeat"; null: as booted.
+pub fn traceAsk(fields: Value) error{BadTrace}!TraceAsk {
+    var ask: TraceAsk = .{};
+    if (fields.get("runner_trace")) |v| switch (v) {
+        .null => {},
+        .bool => |on| ask.off = !on,
+        else => return error.BadTrace,
+    };
+    if (fields.get("runner_trace_format")) |v| switch (v) {
+        .null => {},
+        .string => |t| ask.format = if (validTraceFormat(t)) t else return error.BadTrace,
+        else => return error.BadTrace,
+    };
+    if (fields.get("runner_trace_check")) |v| switch (v) {
+        .null => {},
+        .bool => |on| ask.check = on,
+        else => return error.BadTrace,
+    };
+    if (fields.get("runner_trace_repeat")) |v| switch (v) {
+        .null => {},
+        .int => ask.repeat = std.math.cast(u8, v.int64() orelse return error.BadTrace) orelse return error.BadTrace,
+        else => return error.BadTrace,
+    };
+    if (ask.repeat > maxTraceRepeat) return error.BadTrace;
+    return ask;
+}
+
