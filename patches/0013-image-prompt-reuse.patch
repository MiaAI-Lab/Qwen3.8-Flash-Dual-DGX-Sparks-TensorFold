diff --git a/zig/src/core/lane_host_image_reuse_test.zig b/zig/src/core/lane_host_image_reuse_test.zig
new file mode 100644
index 0000000..8852816
--- /dev/null
+++ b/zig/src/core/lane_host_image_reuse_test.zig
@@ -0,0 +1,164 @@
+//! LaneHost prompt cache with picture rows: the key mixes each row with a hash of its features (the fake backend).
+//! A layout that cannot be keyed is neither looked up nor kept, so two pictures never share the plain prompt.
+const std = @import("std");
+const lanes = @import("lanes");
+const api = @import("engine_api.zig");
+const pc = @import("prompt_cache.zig");
+const LaneHost = api.LaneHost;
+const Id = api.Id;
+const Event = api.Event;
+const Request = api.Request;
+const Reason = api.Reason;
+const Media = api.Media;
+
+const prompt = [_]u32{ 3, 1, 4, 1, 5, 9, 2, 6, 5, 3 };
+const picture_row: u32 = 2;
+const width: u32 = 2;
+const red = [_]u8{ 0x11, 0x22, 0x33, 0x44 };
+const blue = [_]u8{ 0x55, 0x66, 0x77, 0x88 };
+
+fn mixed(token: u32, feat: []const u8) u32 {
+    return token ^ @as(u32, @truncate(std.hash.Wyhash.hash(0xC0FFEE, feat)));
+}
+
+const Snaps = struct {
+    fn bytes(_: *anyopaque, at: u32) u64 {
+        return 64 + 4 * @as(u64, at);
+    }
+    fn save(ptr: *anyopaque, owner: ?*anyopaque, at: u32) anyerror!pc.Saved {
+        const f: *lanes.fake.Fake = @ptrCast(@alignCast(ptr));
+        return f.save(@ptrCast(@alignCast(owner.?)), at);
+    }
+    fn restore(_: *anyopaque, _: ?*anyopaque, _: pc.Saved) anyerror!void {
+        return error.BackendRestores; // lane-core backends restore inside their own prompt pass
+    }
+    fn drop(ptr: *anyopaque, saved: pc.Saved) void {
+        const f: *lanes.fake.Fake = @ptrCast(@alignCast(ptr));
+        f.drop(saved);
+    }
+};
+
+const Box = struct {
+    mutex: std.Io.Mutex = .init,
+    tokens: std.ArrayList(u32) = .empty,
+    cached: ?u32 = null,
+    done: ?Reason = null,
+    fn event(ctx: *anyopaque, _: Id, e: *const Event) void {
+        const b: *@This() = @ptrCast(@alignCast(ctx));
+        b.mutex.lockUncancelable(std.testing.io);
+        defer b.mutex.unlock(std.testing.io);
+        switch (e.*) {
+            .prefilled => |c| b.cached = c,
+            .tokens => |t| b.tokens.appendSlice(std.testing.allocator, t) catch {},
+            .finished => |f| b.done = f.reason,
+        }
+    }
+    fn wait(b: *@This()) Reason {
+        while (true) {
+            b.mutex.lockUncancelable(std.testing.io);
+            const d = b.done;
+            b.mutex.unlock(std.testing.io);
+            if (d) |r| return r;
+            std.Io.sleep(std.testing.io, .fromMilliseconds(1), .awake) catch {};
+        }
+    }
+};
+
+fn media(rows: []const u32, features: []const u8, w: u32, follower_rows: u32) Media {
+    return .{ .rows = rows, .positions = &.{}, .delta = 0, .features = features, .width = w, .follower_rows = follower_rows };
+}
+
+/// One greedy request. `cached` is what the host reported for the prompt (0: nothing resumed).
+fn ask(host: *LaneHost, id: u64, m: ?*const Media, box: *Box) !Reason {
+    const req: Request = .{ .prompt = &prompt, .max_tokens = 6, .history_len = 8, .media = m };
+    try host.engine().submit(id, &req, .{ .ctx = box, .event = Box.event });
+    return box.wait();
+}
+
+fn freshReply(gpa: std.mem.Allocator, m: *const Media) ![]u32 {
+    var cfg = try lanes.Config.init(gpa, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, 8, 7);
+    defer cfg.deinit(gpa);
+    var target: lanes.fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    var clock: lanes.fake.FixedClock = .{};
+    var core = lanes.Engine.init(gpa, &cfg, target.backend(), clock.clock());
+    defer core.deinit();
+    var host = LaneHost.init(gpa, std.testing.io, &core, .{ .lanes = 1 });
+    try host.start();
+    defer host.stop();
+    var box: Box = .{};
+    defer box.tokens.deinit(gpa);
+    try std.testing.expectEqual(Reason.length, try ask(&host, 1, m, &box));
+    try std.testing.expectEqual(@as(?u32, 0), box.cached);
+    return try box.tokens.toOwnedSlice(gpa);
+}
+
+test "picture rows are part of the cache key, and a prompt that cannot be keyed is neither looked up nor kept" {
+    const gpa = std.testing.allocator;
+    var cfg = try lanes.Config.init(gpa, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, 8, 7);
+    defer cfg.deinit(gpa);
+    var target: lanes.fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    var clock: lanes.fake.FixedClock = .{};
+    var core = lanes.Engine.init(gpa, &cfg, target.backend(), clock.clock());
+    defer core.deinit();
+    var store = pc.Store.init(gpa, .{ .ptr = &target, .vtable = &.{ .bytes = Snaps.bytes, .save = Snaps.save, .restore = Snaps.restore, .drop = Snaps.drop } }, .{ .min_gap = 4, .min_prompt = 0 }, 1 << 20);
+    defer store.deinit();
+    var host = LaneHost.init(gpa, std.testing.io, &core, .{ .lanes = 1 });
+    host.cache = &store;
+    try host.start();
+    defer host.stop();
+
+    const row = [_]u32{picture_row};
+    const past = [_]u32{100};
+    const short = red[0..2];
+    const broken = [_]struct { m: Media }{
+        .{ .m = media(&row, &.{}, 0, 0) }, // width 0
+        .{ .m = media(&row, short, width, 0) }, // features shorter than the rows
+        .{ .m = media(&.{}, &.{}, width, 3) }, // rank 1's copy: no features of its own
+        .{ .m = media(&past, &red, width, 0) }, // a row past the prompt
+    };
+    for (broken, 0..) |b, i| {
+        var m = b.m;
+        var box: Box = .{};
+        defer box.tokens.deinit(gpa);
+        try std.testing.expectEqual(Reason.length, try ask(&host, 10 + @as(u64, @intCast(i)), &m, &box));
+        try std.testing.expectEqual(@as(?u32, 0), box.cached);
+    }
+    try std.testing.expectEqual(@as(usize, 0), store.entries.items.len);
+    try std.testing.expectEqual(@as(u64, 0), store.counts.misses);
+    try std.testing.expectEqual(@as(u64, 0), store.counts.kept);
+    try std.testing.expectEqual(@as(u64, 0), store.counts.hits);
+
+    var red_m = media(&row, &red, width, 0);
+    var cold: Box = .{};
+    defer cold.tokens.deinit(gpa);
+    try std.testing.expectEqual(Reason.length, try ask(&host, 1, &red_m, &cold));
+    try std.testing.expectEqual(@as(?u32, 0), cold.cached);
+    try std.testing.expectEqual(@as(usize, 1), store.entries.items.len);
+    try std.testing.expectEqual(mixed(prompt[picture_row], &red), store.entries.items[0].tokens[picture_row]);
+    try std.testing.expect(store.entries.items[0].tokens[picture_row] != prompt[picture_row]);
+    try std.testing.expectEqual(prompt[0], store.entries.items[0].tokens[0]); // a text row is not mixed
+
+    const alone = try freshReply(gpa, &red_m);
+    defer gpa.free(alone);
+    try std.testing.expectEqualSlices(u32, alone, cold.tokens.items); // the first pass is a fresh prefill
+
+    var again: Box = .{};
+    defer again.tokens.deinit(gpa);
+    try std.testing.expectEqual(Reason.length, try ask(&host, 2, &red_m, &again));
+    try std.testing.expectEqual(@as(?u32, 8), again.cached); // resumed through the picture
+    try std.testing.expectEqualSlices(u32, alone, again.tokens.items); // the resumed reply equals that fresh prefill
+    try std.testing.expectEqual(@as(usize, 1), store.entries.items.len);
+    try std.testing.expectEqual(@as(u64, 1), store.counts.hits);
+
+    var blue_m = media(&row, &blue, width, 0);
+    var other: Box = .{};
+    defer other.tokens.deinit(gpa);
+    try std.testing.expectEqual(Reason.length, try ask(&host, 3, &blue_m, &other));
+    try std.testing.expectEqual(@as(?u32, 0), other.cached); // a different picture does not resume the red rows
+    try std.testing.expectEqualSlices(u32, alone, other.tokens.items); // same tokens, its own prefill
+    try std.testing.expectEqual(@as(usize, 2), store.entries.items.len);
+    try std.testing.expectEqual(mixed(prompt[picture_row], &blue), store.entries.items[1].tokens[picture_row]);
+    try std.testing.expect(store.entries.items[0].tokens[picture_row] != store.entries.items[1].tokens[picture_row]);
+}
